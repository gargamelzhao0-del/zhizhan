    char request_id[40];
    char audio_session_id[48];
} acceptance_capture_request_t;

static const char *acceptance_capture_signal_name(
    const acceptance_capture_request_t *capture) {
    if (!capture) {
        return "processed";
    }
    if (capture->raw_hw_ref_pair) {
        return "raw_mic1_hw_ref_8k_interleaved";
    }
    if (capture->raw_fir_ref_pair) {
        return "raw_mic1_fir_ref_8k_interleaved";
    }
    return capture->raw_mic1 ? "raw_mic1" : "processed";
}

