#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
static nuwax_power_state_t ui_power_state_from_battery(
    nuwax_battery_power_state_t power_state)
{
    switch (power_state) {
    case NUWAX_BATTERY_POWER_UNKNOWN:
        return NUWAX_POWER_UNKNOWN;
    case NUWAX_BATTERY_POWER_BATTERY:
        return NUWAX_POWER_BATTERY;
    case NUWAX_BATTERY_POWER_CHARGING:
        return NUWAX_POWER_CHARGING;
    case NUWAX_BATTERY_POWER_LOW:
        return NUWAX_POWER_LOW;
    case NUWAX_BATTERY_POWER_EXTERNAL:
        return NUWAX_POWER_EXTERNAL;
    default:
        return NUWAX_POWER_UNKNOWN;
    }
}

static void battery_service_listener(
    const nuwax_battery_service_snapshot_t *snapshot,
    void *user_data)
{
    (void)user_data;
    if (!snapshot) {
        return;
    }
    /* Idempotent init also retries a transient LED allocation failure. The
     * indicator is independent of UI readiness and cannot block battery/OTA
     * admission if unavailable. Repeated samples do not restart the breath. */
    esp_err_t led_err = nuwax_led_status_init(NULL);
    if (led_err == ESP_OK) {
        led_err = nuwax_led_status_set_charging(
            snapshot->valid && !snapshot->stale && snapshot->power_valid &&
            !snapshot->power_stale && snapshot->charging && !snapshot->full);
    }
    if (led_err != ESP_OK) {
        ESP_LOGW(TAG, "charging LED update failed: %s", esp_err_to_name(led_err));
    }
    if (!ui_ready_snapshot()) {
        return;
    }
    const bool retain_stale_low = snapshot->valid && snapshot->stale &&
                                  snapshot->battery_present && snapshot->low;
    const bool fresh_voltage_alarm = snapshot->power_valid &&
                                    !snapshot->power_stale && snapshot->low;
    const bool ui_valid = fresh_voltage_alarm || (snapshot->valid &&
                          (!snapshot->stale || retain_stale_low));
    nuwax_app_shell_set_battery_state(
        ui_valid,
        ui_valid && !snapshot->stale && snapshot->soc_trusted,
        ui_valid ? ui_power_state_from_battery(snapshot->power_state)
                 : NUWAX_POWER_UNKNOWN,
        snapshot->display_percent,
        snapshot->voltage_mv,
        snapshot->current_ma);
    nuwax_state_bridge_refresh_power();
}

static esp_err_t start_battery_service_for_ui(void)
{
    if (nuwax_battery_service_is_running()) {
        return ESP_OK;
    }
    const nuwax_battery_service_config_t battery_config = {
        .sample_interval_ms = CONFIG_NUWAX_BATTERY_SAMPLE_INTERVAL_MS,
        .error_backoff_initial_ms = 5000,
        .error_backoff_max_ms = 60000,
        .low_enter_percent = CONFIG_NUWAX_BATTERY_LOW_ENTER_PERCENT,
        .low_exit_percent = CONFIG_NUWAX_BATTERY_LOW_EXIT_PERCENT,
        .hard_low_enter_mv = CONFIG_NUWAX_BATTERY_HARD_LOW_ENTER_MV,
        .hard_low_exit_mv = CONFIG_NUWAX_BATTERY_HARD_LOW_EXIT_MV,
        .estimated_low_enter_mv =
            CONFIG_NUWAX_BATTERY_ESTIMATED_LOW_ENTER_MV,
        .estimated_low_exit_mv =
            CONFIG_NUWAX_BATTERY_ESTIMATED_LOW_EXIT_MV,
        .design_capacity_mah = CONFIG_NUWAX_BATTERY_DESIGN_CAPACITY_MAH,
        .listener = battery_service_listener,
        .listener_user_data = NULL,
    };
    esp_err_t err = nuwax_battery_service_start(&battery_config);
#if CONFIG_NUWAX_OTA_ENABLE
    if (err == ESP_OK) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_BATTERY_SERVICE);
    }
#endif
    return err;
}
#endif

