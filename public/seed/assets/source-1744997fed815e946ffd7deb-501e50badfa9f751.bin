static bool session_dispatch_local_blocks_remote_idle(void *ctx) {
    (void)ctx;
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    const nuwax_app_state_t current_state =
        conversation_state_current();
    return current_state == NUWAX_APP_STATE_SLEEPING ||
           current_state == NUWAX_APP_STATE_LISTENING ||
           s_prelisten.pending ||
           s_prelisten.capture_active;
#else
    return false;
#endif
}

static bool session_dispatch_set_state(void *ctx, nuwax_app_state_t state) {
    (void)ctx;
    if (sleep_transaction_blocks_new_audio() &&
        state != NUWAX_APP_STATE_SLEEPING) {
        ESP_LOGW(TAG,
                 "remote transport state isolated while sleep lifecycle owns device requested=%s sleep_txn=%s",
                 nuwax_app_state_name(state),
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state));
        return false;
    }
    const bool capture_realtime =
        atomic_load_explicit(&s_conversation_capture_starting,
                             memory_order_acquire) ||
        atomic_load_explicit(&s_conversation_capture_runtime_active,
                             memory_order_acquire);
    if (capture_realtime) {
        set_state_deferred_ui(state);
        return conversation_state_current() == state;
    }
    set_state(state);
    return conversation_state_current() == state;
}

static bool session_dispatch_set_emotion_common(void *ctx,
                                                const char *emotion,
                                                bool has_duration_ms,
                                                uint32_t duration_ms) {
    (void)ctx;
    s_last_set_emotion_failure_reason = "emotion rejected";
    if (!emotion || emotion[0] == '\0' ||
        !nuwax_state_bridge_is_semantic_emotion_name_supported(emotion)) {
        s_last_set_emotion_failure_reason = "unsupported emotion";
        return false;
    }
    const nuwax_app_state_t current_state = conversation_state_current();
    const bool tts_skip_owner =
        s_tts_skip_emotion_window.active &&
        tts_skip_emotion_window_accepts();
    const bool tts_skip_window =
        tts_skip_owner &&
        (current_state == NUWAX_APP_STATE_THINKING ||
         current_state == NUWAX_APP_STATE_LISTENING);
    if ((app_state_blocks_semantic_emotion(current_state) &&
         current_state != NUWAX_APP_STATE_SLEEPING && !tts_skip_window) ||
        (tts_skip_owner && !tts_skip_window) ||
        exclusive_audio_mode_blocks_normal_audio() ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        ESP_LOGI(TAG,
                 "set_emotion suppressed by strong lifecycle state=%s emotion=%s",
                 nuwax_app_state_name(current_state),
                 emotion);
        s_last_set_emotion_failure_reason =
            tts_skip_window ? "emotion rejected by visual owner"
                            : "emotion rejected by local lifecycle";
        return false;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio()) {
        ESP_LOGI(TAG, "set_emotion suppressed during OTA emotion=%s", emotion);
        s_last_set_emotion_failure_reason = "emotion rejected during OTA";
        return false;
    }
#endif
    if (!tts_skip_window &&
        (s_visual_round.kind == NUWAX_VISUAL_ROUND_WAKE_GREETING ||
         nuwax_conversation_visual_round_is_interaction(&s_visual_round))) {
        ESP_LOGI(TAG,
                 "set_emotion suppressed by visual owner kind=%s emotion=%s",
                 visual_round_kind_name(s_visual_round.kind),
                 emotion);
        s_last_set_emotion_failure_reason = "emotion rejected by visual owner";
        return false;
    }
    if (!tts_skip_window &&
        s_visual_round.kind == NUWAX_VISUAL_ROUND_NORMAL &&
        !s_visual_round.first_pcm_seen) {
        const bool held = nuwax_conversation_visual_round_hold_emotion(
            &s_visual_round, emotion);
        ESP_LOGI(TAG,
                 "set_emotion deferred to first PCM emotion=%s held=%d",
                 emotion,
                 held ? 1 : 0);
        return held;
    }
    if (current_state == NUWAX_APP_STATE_SLEEPING) {
        /* Sleep activity expressions have a device-owned four-second visual
         * contract. Cloud duration metadata is intentionally ignored here;
         * the next command may replace/restart the lease, while wake cancels
         * it through the lifecycle-generation fence. */
        const bool accepted = apply_sleep_cloud_emotion_name(
            emotion, "device_command_sleep");
        if (!accepted) {
            s_last_set_emotion_failure_reason =
                conversation_state_current() == NUWAX_APP_STATE_SLEEPING
                    ? "emotion queue unavailable"
                    : "emotion rejected by local lifecycle";
        }
        return accepted;
    }
    if (tts_skip_window) {
        uint32_t lease_ms = has_duration_ms
                                ? duration_ms
                                : NUWAX_TTS_SKIP_EMOTION_DEFAULT_LEASE_MS;
        /* The visual hold is a hard two-second contract.  A shorter
         * cloud-provided lease must not expire the face before the follow-up
         * service releases it at the listening boundary. */
        if (lease_ms < NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS) {
            lease_ms = NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS;
        }
        const bool accepted = apply_semantic_emotion_name_leased(
            emotion, "device_command_tts_skip", lease_ms);
        if (accepted) {
            ESP_LOGI(TAG,
                     "set_emotion accepted for tts_skip round emotion=%s lease_ms=%lu",
                     emotion,
                     (unsigned long)lease_ms);
            note_tts_skip_emotion_accepted();
            return true;
        }
        s_last_set_emotion_failure_reason = "emotion queue unavailable";
        return false;
    }
    return apply_semantic_emotion_name(emotion, "device_command");
}

static bool session_dispatch_set_emotion_with_context(
    void *ctx,
    const char *emotion,
    bool has_duration_ms,
    uint32_t duration_ms,
    const char *request_id,
    const char *turn_id) {
    bool direct_post_end = false;
    const bool prebind =
        emotion && emotion[0] != '\0' &&
        nuwax_state_bridge_is_semantic_emotion_name_supported(emotion) &&
        tts_skip_prebind_owner_eligible(turn_id, &direct_post_end);
    if (prebind) {
        remember_tts_skip_prebound_emotion(emotion,
                                           has_duration_ms,
                                           duration_ms,
                                           request_id,
                                           turn_id,
                                           direct_post_end);
    }

    const bool accepted = session_dispatch_set_emotion_common(
        ctx, emotion, has_duration_ms, duration_ms);
    if (accepted || !prebind) {
        return accepted;
    }

    /* A valid same-turn emotion may arrive while LISTENING owns the face.
     * Keep its command ACK successful and defer the visual publish until the
     * matching tts_skip establishes the no-TTS owner.  Hardware/OTA failures
     * remain hard failures and do not leave a candidate behind. */
    const bool deferable =
        strcmp(s_last_set_emotion_failure_reason,
               "emotion rejected by local lifecycle") == 0 ||
        strcmp(s_last_set_emotion_failure_reason,
               "emotion rejected by visual owner") == 0;
    if (deferable) {
        s_last_set_emotion_failure_reason =
            "emotion deferred until tts_skip";
        ESP_LOGI(TAG,
                 "set_emotion deferred for possible tts_skip round emotion=%s turn=%s",
                 emotion ? emotion : "-",
                 turn_id ? turn_id : "-");
        return true;
    }
    clear_tts_skip_prebound_emotion("set_emotion_rejected");
    return false;
}

static bool session_dispatch_set_emotion(void *ctx,
                                         const char *emotion,
                                         bool has_duration_ms,
                                         uint32_t duration_ms) {
    return session_dispatch_set_emotion_common(ctx,
                                               emotion,
                                               has_duration_ms,
                                               duration_ms);
}

