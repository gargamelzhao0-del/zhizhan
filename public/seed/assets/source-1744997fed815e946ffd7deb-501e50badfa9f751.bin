            CONFIG_NUWAX_SPEECH_CONFIRMATION_RESET_SILENCE_MS,
};
#endif

static const nuwax_speech_confirmation_policy_t
    s_ordinary_weak_start_policy = {
        .window_ms = NUWAX_ORDINARY_WEAK_START_WINDOW_MS,
        .required_voiced_ms = NUWAX_ORDINARY_WEAK_START_REQUIRED_MS,
        .candidate_reset_silence_ms =
            NUWAX_ORDINARY_WEAK_START_RESET_SILENCE_MS,
    };

static bool ordinary_listen_speech_candidate_active(
    const nuwax_speech_confirmation_t *confirmation,
    bool confirmation_runtime_enabled,
    const nuwax_speech_confirmation_t *weak_start_confirmation,
    bool speech_confirmed,
    bool short_speech_candidate_active,
    uint32_t legacy_speech_frames,
    uint32_t frame_ms) {
    if (speech_confirmed || frame_ms == 0U) {
        return false;
    }
#if NUWAX_SHORT_SPEECH_ACTIVE
    if (short_speech_candidate_active) {
        return true;
    }
#else
    (void)short_speech_candidate_active;
#endif
#if NUWAX_SPEECH_CONFIRMATION_ACTIVE
    if (confirmation_runtime_enabled && confirmation) {
        const uint32_t candidate_span_ms =
            (uint32_t)confirmation->candidate_span_frames * frame_ms;
        return confirmation->candidate_active &&
               candidate_span_ms <=
                   (uint32_t)CONFIG_NUWAX_SPEECH_CONFIRMATION_WINDOW_MS;
    }
#else
    (void)confirmation;
    (void)confirmation_runtime_enabled;
#endif
    if (weak_start_confirmation &&
        weak_start_confirmation->candidate_active) {
        const uint32_t weak_candidate_span_ms =
            (uint32_t)weak_start_confirmation->candidate_span_frames *
            frame_ms;
        if (weak_candidate_span_ms <= NUWAX_ORDINARY_WEAK_START_WINDOW_MS) {
            return true;
        }
    }
    return legacy_speech_frames > 0U &&
           legacy_speech_frames * frame_ms <
               (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_MIN_SPEECH_MS;
}

