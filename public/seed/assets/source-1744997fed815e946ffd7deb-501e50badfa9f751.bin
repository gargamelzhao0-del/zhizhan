static const nuwax_session_dispatch_callbacks_t s_session_dispatch_callbacks = {
    .ctx = NULL,
    .set_active_turn_id = session_dispatch_set_active_turn_id,
    .queue_wifi_connect = session_dispatch_queue_wifi_connect,
    .request_wifi_scan = session_dispatch_request_wifi_scan,
    .request_ble_reprovision = session_dispatch_request_ble_reprovision,
    .request_sleep_transaction =
        session_dispatch_request_sleep_transaction,
    .cancel_auto_followup_capture = session_dispatch_cancel_auto_followup_capture,
    .speaker_has_pending = session_dispatch_speaker_has_pending,
    .speaker_playback_matches = session_dispatch_speaker_playback_matches,
    .active_turn_matches_playback =
        session_dispatch_active_turn_matches_playback,
    .speaker_cancel_matching_playback =
        session_dispatch_speaker_cancel_matching_playback,
    .speaker_cancel_now = session_dispatch_speaker_cancel_now,
    .speaker_request_fade_cancel = session_dispatch_speaker_request_fade_cancel,
    .preserve_capture_on_stop_playback = session_dispatch_preserve_capture_on_stop_playback,
    .local_blocks_remote_idle = session_dispatch_local_blocks_remote_idle,
    .set_state = session_dispatch_set_state,
    .set_emotion = session_dispatch_set_emotion,
    .set_emotion_with_context = session_dispatch_set_emotion_with_context,
    .set_emotion_failure_reason = session_dispatch_set_emotion_failure_reason,
    .set_conversation_status = session_dispatch_set_conversation_status,
    .return_to_listening_after_cancel = session_dispatch_return_to_listening_after_cancel,
    .show_status = session_dispatch_show_status,
    .apply_volume_percent = session_dispatch_apply_volume_percent,
#if defined(CONFIG_NUWAX_MUSIC_PLAYBACK_ENABLE) && \
    CONFIG_NUWAX_MUSIC_PLAYBACK_ENABLE
    .start_music = session_dispatch_start_music,
    .stop_music = session_dispatch_stop_music,
#endif
    .set_wake_word = session_dispatch_set_wake_word,
    .set_wake_words = session_dispatch_set_wake_words,
    .reset_wake_word = session_dispatch_reset_wake_word,
    .set_audio_cleaner_enabled = session_dispatch_set_audio_cleaner_enabled,
    .run_p3_ref_health = session_dispatch_run_p3_ref_health,
    .run_p3_softref_ab = session_dispatch_run_p3_softref_ab,
    .run_p3_hardref_ab = session_dispatch_run_p3_hardref_ab,
    .run_p3_nearend_candidate = session_dispatch_run_p3_nearend_candidate,
    .run_p3_interrupt_timing = session_dispatch_run_p3_interrupt_timing,
    .run_p5_fullduplex_overlap_probe = session_dispatch_run_p5_fullduplex_overlap_probe,
    .run_p5_during_playback_candidate = session_dispatch_run_p5_during_playback_candidate,
    .set_l3_interrupt_enabled = session_dispatch_run_set_l3_enabled,
};

static uint32_t acceptance_capture_duration_or_default(uint32_t duration_ms) {
    if (duration_ms == 0) {
        duration_ms = NUWAX_ACCEPTANCE_CAPTURE_DEFAULT_MS;
    }
    if (duration_ms < NUWAX_ACCEPTANCE_CAPTURE_MIN_MS) {
        duration_ms = NUWAX_ACCEPTANCE_CAPTURE_MIN_MS;
    }
    if (duration_ms > NUWAX_ACCEPTANCE_CAPTURE_MAX_MS) {
        duration_ms = NUWAX_ACCEPTANCE_CAPTURE_MAX_MS;
    }
    return duration_ms;
}

static bool handle_acceptance_capture_command(nuwax_ws_client_t *ws,
                                              const nuwax_session_command_t *command) {
    if (!command || strcmp(command->command, "set_acceptance_capture") != 0) {
        return false;
    }

    const bool disable = strcmp(command->mode, "off") == 0 ||
                         strcmp(command->mode, "disable") == 0 ||
                         strcmp(command->mode, "disabled") == 0;
    if (disable) {
        memset(&s_acceptance_capture_next, 0, sizeof(s_acceptance_capture_next));
        ESP_ERROR_CHECK_WITHOUT_ABORT(nuwax_session_send_command_ack(ws,
                                                                     command->request_id,
                                                                     command->command,
                                                                     true,
                                                                     "acceptance_capture=off"));
        ESP_LOGI(TAG, "acceptance playback capture disabled by command request=%s", command->request_id);
        return true;
    }

    const uint32_t seq = ++s_acceptance_capture_seq;
    acceptance_capture_request_t next = {0};
    next.armed = true;
    next.raw_mic1 = strcmp(command->mode, "raw") == 0 ||
                    strcmp(command->mode, "raw_mic1") == 0;
    next.raw_fir_ref_pair = strcmp(command->mode, "raw_ref") == 0 ||
                            strcmp(command->mode, "raw_fir_ref") == 0;
    next.raw_hw_ref_pair = strcmp(command->mode, "raw_hw_ref") == 0 ||
                           strcmp(command->mode, "raw_mic1_hw_ref") == 0;
    next.has_delay_samples = command->has_delay_samples;
    next.duration_ms =
        acceptance_capture_duration_or_default(command->has_duration_ms ? command->duration_ms : 0);
    next.delay_samples = command->has_delay_samples ? command->delay_samples : 0;
    if (command->audio_session_id[0] != '\0') {
        strlcpy(next.audio_session_id, command->audio_session_id, sizeof(next.audio_session_id));
    } else {
        snprintf(next.audio_session_id, sizeof(next.audio_session_id), "acceptance_%lu", (unsigned long)seq);
    }
    if (command->request_id[0] != '\0') {
        strlcpy(next.request_id, command->request_id, sizeof(next.request_id));
    } else {
        snprintf(next.request_id, sizeof(next.request_id), "acceptance_req_%lu", (unsigned long)seq);
    }
    s_acceptance_capture_next = next;

    char message[192];
    snprintf(message,
             sizeof(message),
             "acceptance_capture=armed signal=%s duration_ms=%lu delay_samples=%lu audio_session_id=%s",
             acceptance_capture_signal_name(&next),
             (unsigned long)next.duration_ms,
             (unsigned long)next.delay_samples,
             next.audio_session_id);
    ESP_ERROR_CHECK_WITHOUT_ABORT(nuwax_session_send_command_ack(ws,
                                                                 command->request_id,
                                                                 command->command,
                                                                 true,
                                                                 message));
    ESP_LOGI(TAG,
             "acceptance playback capture armed request=%s audio_session_id=%s signal=%s duration_ms=%lu delay_samples=%lu",
             next.request_id,
             next.audio_session_id,
             acceptance_capture_signal_name(&next),
             (unsigned long)next.duration_ms,
             (unsigned long)next.delay_samples);
    return true;
}

static void handle_session_command(nuwax_ws_client_t *ws,
                                   const nuwax_session_command_t *command,
                                   uint32_t event_ws_epoch) {
    bool normal_event_blocked = false;
    if (command && command->has_event &&
        is_normal_audio_event(command->event) &&
        sleep_lifecycle_blocks_normal_cloud_audio()) {
        normal_event_blocked = true;
        if (command->event == NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
            notification_rx_barrier_reject_normal_epoch(
                active_ws_epoch_snapshot(),
                command->turn_id,
                command->playback_id,
                "sleep_transaction_consumer_isolation");
        }
        ESP_LOGI(TAG,
                 "cloud conversation event isolated by sleep transaction event=%d epoch=%lu turn=%s",
                 (int)command->event,
                 (unsigned long)active_ws_epoch_snapshot(),
                 command->turn_id[0] ? command->turn_id : "-");
    }
    if (command && command->has_event && is_normal_audio_event(command->event) &&
        exclusive_audio_mode_blocks_normal_audio()) {
        /* A command can already be queued when an exclusive mode request wins the
         * state race.  Drop the event at the consumer boundary as well as at
         * the WebSocket callback boundary. */
        (void)preserve_filtered_text_response_emotion(
            command,
            "exclusive_mode_consumer");
        if (command->event == NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
            notification_rx_barrier_reject_normal_epoch(
                active_ws_epoch_snapshot(),
                command->turn_id,
                command->playback_id,
                "exclusive_mode_consumer_isolation");
        }
        ESP_LOGI(TAG,
                 "exclusive audio mode discarded queued normal session event=%d",
                 (int)command->event);
        return;
    }
    if (command && command->has_event && !normal_event_blocked) {
        handle_session_event(command, event_ws_epoch);
    }
    if (!command || !command->has_command) {
        if (command && command->has_mcp) {
            handle_mcp_message(ws, command->mcp_payload);
        }
        return;
    }
    if (strcmp(command->command, "prepare_notify_playback") == 0) {
        handle_prepare_notification_command(ws, command);
        return;
    }
    if (handle_acceptance_capture_command(ws, command)) {
        return;
    }
    nuwax_session_dispatch_command(ws, command, &s_session_dispatch_callbacks);
}

/* Owner-task only. A sleeping face alone does not prove that a cancelled
 * playback or a new interaction has finished releasing its resources. */
static bool diagnostic_persistence_idle(void) {
    const nuwax_app_state_t state = conversation_state_current();
    if (state != NUWAX_APP_STATE_SLEEPING && state != NUWAX_APP_STATE_IDLE) {
        return false;
    }
    if (nuwax_awake_session_state_is_active(&s_awake_session) ||
        s_turn_guard.active || s_playback_terminal_guard.active ||
        nuwax_conversation_visual_round_is_active(&s_visual_round) ||
        s_head_touch_agent_intent.state != NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE ||
        s_notification_transaction.active || s_sleep_transaction.active ||
        s_deferred_sleep_intent.active || s_prelisten.pending ||
        s_prelisten.capture_active || conversation_capture_busy_for_sleep() ||
        nuwax_audio_uplink_sender_busy() ||
        exclusive_audio_mode_blocks_normal_audio() ||
        local_power_transition_active() ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        atomic_load_explicit(&s_ws_text_callbacks_active,
                             memory_order_acquire) != 0U) {
        return false;
    }
    if ((s_session_commands && uxQueueMessagesWaiting(s_session_commands)) ||
        (s_session_critical_commands &&
         uxQueueMessagesWaiting(s_session_critical_commands)) ||
        (s_session_notification_commands &&
         uxQueueMessagesWaiting(s_session_notification_commands))) {
        return false;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending() ||
        (s_speaker_owner_events &&
         uxQueueMessagesWaiting(s_speaker_owner_events))) {
        return false;
    }
#endif
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active()) return false;
#endif
    return true;
}

static void service_idle_diagnostic_persistence(void) {
    if (!diagnostic_persistence_idle()) return;
    if (nuwax_lvgl_port_background_work_deferred()) return;
    const int64_t started_us = esp_timer_get_time();
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)nuwax_speaker_playback_service_volume_persistence(false);
#endif
    const int64_t volume_done_us = esp_timer_get_time();
    /* Re-admit after a potentially slow volume commit: new commands or UI
     * interaction must take priority over another optional Flash write. */
    if (diagnostic_persistence_idle() &&
        !nuwax_lvgl_port_background_work_deferred()) {
        nuwax_device_error_report_housekeeping();
    }
    const int64_t elapsed_us = esp_timer_get_time() - started_us;
    if (elapsed_us > 100000LL) {
        ESP_LOGW(TAG, "idle diagnostic persistence slow elapsed_ms=%lld volume_ms=%lld diagnostic_ms=%lld",
                 (long long)(elapsed_us / 1000LL),
                 (long long)((volume_done_us - started_us) / 1000LL),
                 (long long)((elapsed_us - (volume_done_us - started_us)) / 1000LL));
    }
}

static void drain_session_commands_limited(nuwax_ws_client_t *ws, uint32_t max_commands) {
    /* Converge cloud-ready to the sleep lifecycle before notification
     * admission, preserving active audio owners. */
    (void)reconcile_cloud_ready_sleep_state("before_command_consumption");
    const uint32_t command_budget =
        max_commands > NUWAX_SESSION_COMMAND_DRAIN_DEFAULT_MAX
            ? NUWAX_SESSION_COMMAND_DRAIN_DEFAULT_MAX
            : max_commands;
    const int64_t drain_started_us = esp_timer_get_time();
    uint32_t handled = 0;
    while (handled < max_commands && handled < command_budget) {
        /* A command handler may send an ACK and touch the UI.  Keep the
         * application watchdog independent of the number of queued messages. */
        app_task_watchdog_checkpoint();
        if (handled != 0U &&
            esp_timer_get_time() - drain_started_us >=
                NUWAX_SESSION_COMMAND_DRAIN_BUDGET_US) {
            break;
        }
        bool received = false;
        if (s_session_notification_commands &&
            xQueueReceive(s_session_notification_commands,
                          &s_session_command_work,
                          0) == pdTRUE) {
            received = true;
        } else if (s_session_critical_commands &&
                   xQueueReceive(s_session_critical_commands,
                          &s_session_command_work,
                          0) == pdTRUE) {
            received = true;
        } else if (s_session_commands &&
                   xQueueReceive(s_session_commands,
                                 &s_session_command_work,
                                 0) == pdTRUE) {
            received = true;
        }
        if (!received) {
            break;
        }
        const uint32_t current_epoch = nuwax_ws_connection_epoch(ws);
        const uint32_t active_epoch = active_ws_epoch_snapshot();
        if (s_session_command_work.ws_connection_epoch == 0U ||
            s_session_command_work.ws_connection_epoch != current_epoch ||
            current_epoch != active_epoch) {
            ESP_LOGI(TAG,
                     "stale session command ignored event_epoch=%lu ws_epoch=%lu active_epoch=%lu event=%d command=%s",
                     (unsigned long)s_session_command_work.ws_connection_epoch,
                     (unsigned long)current_epoch,
                     (unsigned long)active_epoch,
                     (int)s_session_command_work.command.event,
                     s_session_command_work.command.has_command
                         ? s_session_command_work.command.command
                         : "-");
        } else {
            handle_session_command(ws,
                                   &s_session_command_work.command,
                                   s_session_command_work.ws_connection_epoch);
        }
        memset(&s_session_command_work, 0, sizeof(s_session_command_work));
        handled++;
        app_task_watchdog_checkpoint();
        if (esp_timer_get_time() - drain_started_us >=
            NUWAX_SESSION_COMMAND_DRAIN_BUDGET_US) {
            break;
        }
    }
    service_tts_skip_followup();
#if CONFIG_NUWAX_SPEAKER_ENABLE
    /* Physical PCM/stop events must not wait behind Wi-Fi report ACK sends. */
    drain_speaker_owner_events();
#endif
    /* Completion may arrive after an earlier link-state observation. Always
     * reap it in the connected owner too; never run the blocking worker here. */
    if (atomic_load_explicit(&s_wifi_recovery_state, memory_order_acquire) ==
        WIFI_RECOVERY_DONE) {
        (void)recover_wifi_if_needed();
    }
    drain_wifi_status_reports(ws);
    drain_wifi_scan_results(ws);
    service_touch_cancel_recovery(ws);
    drain_playback_wake_events(ws);
    service_sleep_transaction();
    service_power_key_events(ws);
    service_notification_transaction();
    service_notification_rx_rejected_timeout(ws);
    service_head_touch_agent_intent(ws);
    check_conversation_turn_timeout(ws);
    service_pending_volume_report(ws);
    /* Diagnostics share the serialized WebSocket TX path with microphone
     * packets. This service only sends from RAM; Flash persistence is gated
     * separately below and never runs during playback or terminal drain. Reliable
     * meeting/monitoring streams are intentionally exempt so a long exclusive
     * session cannot starve diagnostic delivery indefinitely. */
    if (!nuwax_audio_uplink_sender_busy() ||
        exclusive_audio_mode_blocks_normal_audio()) {
        nuwax_device_error_report_service(ws);
    }
    service_idle_diagnostic_persistence();
}

static void drain_session_commands(nuwax_ws_client_t *ws) {
    drain_session_commands_limited(
        ws, NUWAX_SESSION_COMMAND_DRAIN_DEFAULT_MAX);
}

static void drain_shell_actions(nuwax_ws_client_t *ws) {
    if (!s_shell_actions) {
        return;
    }
    nuwax_app_shell_result_t action = {0};
    const int64_t drain_started_us = esp_timer_get_time();
    uint32_t handled = 0U;
    while (handled < NUWAX_SHELL_ACTION_DRAIN_MAX &&
           xQueueReceive(s_shell_actions, &action, 0) == pdTRUE) {
        app_task_watchdog_checkpoint();
        if (nuwax_shell_action_is_listen_control(action.action)) {
            handled++;
            continue;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_CANCEL &&
            exclusive_audio_mode_blocks_normal_audio()) {
            ESP_LOGI(TAG,
                     "exclusive audio mode dropped stale shell cancel action");
            handled++;
            continue;
        }
        handle_shell_action(ws, &action);
        handled++;
        app_task_watchdog_checkpoint();
        if (esp_timer_get_time() - drain_started_us >=
            NUWAX_SHELL_ACTION_DRAIN_BUDGET_US) {
            break;
        }
    }
}

static void clear_deferred_shell_listen_actions(const char *reason) {
    if (s_deferred_shell_listen_action_count == 0U) {
        return;
    }
    ESP_LOGI(TAG,
             "deferred shell listen actions cleared count=%u reason=%s",
             (unsigned)s_deferred_shell_listen_action_count,
             reason ? reason : "-");
    memset(s_deferred_shell_listen_actions,
           0,
           sizeof(s_deferred_shell_listen_actions));
    s_deferred_shell_listen_action_count = 0U;
}

static bool take_deferred_shell_listen_action(
    nuwax_app_shell_result_t *action) {
    if (!action || s_deferred_shell_listen_action_count == 0U) {
        return false;
    }
    const nuwax_app_shell_action_t deferred_action =
        s_deferred_shell_listen_actions[0];
    *action = (nuwax_app_shell_result_t){
        .action = deferred_action,
        .index = deferred_action == NUWAX_APP_SHELL_ACTION_STOP_LISTEN
                     ? -1
                     : 0,
    };
    s_deferred_shell_listen_action_count--;
    if (s_deferred_shell_listen_action_count > 0U) {
        memmove(&s_deferred_shell_listen_actions[0],
                &s_deferred_shell_listen_actions[1],
                (size_t)s_deferred_shell_listen_action_count *
                    sizeof(s_deferred_shell_listen_actions[0]));
    }
    s_deferred_shell_listen_actions[
        s_deferred_shell_listen_action_count] =
        NUWAX_APP_SHELL_ACTION_NONE;
    return true;
}

static bool drain_shell_actions_preserving_listen_control(nuwax_ws_client_t *ws) {
    if (!s_shell_actions) {
        return s_deferred_shell_listen_action_count > 0U;
    }
    nuwax_app_shell_result_t action = {0};
    const UBaseType_t queued_at_entry = uxQueueMessagesWaiting(s_shell_actions);
    const int64_t drain_started_us = esp_timer_get_time();
    for (UBaseType_t handled = 0U; handled < queued_at_entry; ++handled) {
        app_task_watchdog_checkpoint();
        if (handled != 0U &&
            esp_timer_get_time() - drain_started_us >=
                NUWAX_SHELL_ACTION_DRAIN_BUDGET_US) {
            break;
        }
        if (xQueueReceive(s_shell_actions, &action, 0) != pdTRUE) {
            break;
        }
        if (nuwax_shell_action_is_listen_control(action.action)) {
            const bool duplicate_edge =
                s_deferred_shell_listen_action_count > 0U &&
                s_deferred_shell_listen_actions[
                    s_deferred_shell_listen_action_count - 1U] ==
                    action.action;
            if (!duplicate_edge) {
                if (s_deferred_shell_listen_action_count >=
                    NUWAX_DEFERRED_SHELL_LISTEN_ACTION_CAPACITY) {
                    ESP_LOGW(TAG,
                             "deferred shell listen action overflow count=%u incoming=%d; dropping incomplete gesture",
                             (unsigned)s_deferred_shell_listen_action_count,
                             (int)action.action);
                    clear_deferred_shell_listen_actions(
                        "listen_action_overflow");
                }
                if (action.action == NUWAX_APP_SHELL_ACTION_START_LISTEN ||
                    s_deferred_shell_listen_action_count > 0U) {
                    s_deferred_shell_listen_actions[
                        s_deferred_shell_listen_action_count++] =
                        action.action;
                }
            }
            continue;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_CANCEL &&
            exclusive_audio_mode_blocks_normal_audio()) {
            ESP_LOGI(TAG,
                     "exclusive audio mode dropped stale shell cancel action");
            continue;
        }
        handle_shell_action(ws, &action);
        app_task_watchdog_checkpoint();
    }
    return s_deferred_shell_listen_action_count > 0U;
}

typedef struct {
    nuwax_audio_board_ref_t ref;
    nuwax_audio_board_lease_t lease;
} audio_diagnostic_owner_t;

static esp_err_t audio_diagnostic_teardown_retry(audio_diagnostic_owner_t *owner,
                                                  const char *reason)
{
    const unsigned teardown_attempts = 3U;
    esp_err_t teardown_err = ESP_OK;
    for (unsigned attempt = 1U; attempt <= teardown_attempts; ++attempt) {
        teardown_err = owner->ref.token
            ? nuwax_audio_board_deinit(&owner->ref)
            : nuwax_audio_board_retry_teardown();
        if (teardown_err == ESP_OK) {
            if (attempt > 1U) {
                ESP_LOGW(TAG,
                         "diagnostic audio teardown recovered reason=%s attempt=%u/%u",
                         reason ? reason : "-",
                         attempt,
                         teardown_attempts);
            }
            return ESP_OK;
        }
        ESP_LOGE(TAG,
                 "diagnostic audio teardown failed reason=%s attempt=%u/%u err=%s",
                 reason ? reason : "-",
                 attempt,
                 teardown_attempts,
                 esp_err_to_name(teardown_err));
        if (attempt < teardown_attempts) {
            vTaskDelay(pdMS_TO_TICKS(20U));
        }
    }
    return teardown_err;
}

static esp_err_t audio_diagnostic_begin(audio_diagnostic_owner_t *owner)
{
    void *rx = NULL;
    void *tx = NULL;
    ESP_RETURN_ON_ERROR(nuwax_audio_board_init(&owner->ref), TAG, "diagnostic board init failed");
    esp_err_t err = nuwax_audio_board_acquire_diagnostic(&rx, &tx, &owner->lease);
    if (err != ESP_OK) {
        const esp_err_t cleanup_err =
            audio_diagnostic_teardown_retry(owner, "acquire_failed");
        if (cleanup_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "diagnostic acquire cleanup failed: %s",
                     esp_err_to_name(cleanup_err));
        }
        return cleanup_err != ESP_OK ? cleanup_err : err;
    }
    ESP_LOGW(TAG,
             "exclusive audio diagnostic lease acquired generation=%lu token=%lu",
             (unsigned long)owner->lease.generation,
             (unsigned long)owner->lease.token);
    return ESP_OK;
}

static esp_err_t audio_diagnostic_end(audio_diagnostic_owner_t *owner)
{
    ESP_RETURN_ON_ERROR(nuwax_audio_board_release(&owner->lease),
                        TAG,
                        "diagnostic lease release failed");
    return audio_diagnostic_teardown_retry(owner, "diagnostic_end");
}

static esp_err_t run_p3_aec_ref_health_gate(const char *label, bool run_ref_probe)
{
    const char *gate = label ? label : "p3_aec_ref_gate";
    audio_diagnostic_owner_t diagnostic_lease = {0};
    ESP_RETURN_ON_ERROR(audio_diagnostic_begin(&diagnostic_lease),
                        TAG,
                        "AEC ref gate rejected while audio is owned");
    esp_err_t ref_err = ESP_OK;
    if (run_ref_probe) {
        nuwax_vocat_ref_probe_stats_t ref = {0};
        ref_err = nuwax_vocat_audio_board_ref_probe(&ref);
        ESP_LOGW(TAG, "%s REF slot probe result=%s ref_slot=%d delta=%d tone=[%d,%d,%d,%d] quiet=[%d,%d,%d,%d]",
                 gate, esp_err_to_name(ref_err), ref.ref_slot, ref.ref_delta,
                 ref.tone_rms[0], ref.tone_rms[1], ref.tone_rms[2], ref.tone_rms[3],
                 ref.quiet_rms[0], ref.quiet_rms[1], ref.quiet_rms[2], ref.quiet_rms[3]);
    }

    nuwax_aec_ref_health_t health = {0};
    esp_err_t health_err = nuwax_vocat_aec_ref_health_check(0.0f, 2000, &health);
    if (ref_err != ESP_OK || health_err != ESP_OK) {
        health.passed = false;
    }
    apply_hardware_ref_release_gate(&health);
    s_aec_ref_health = health;
    ESP_LOGW(TAG, "%s AEC ref health result=%s status=%d score=%.3f tone_amp=%.1f "
             "quiet_rms=%.1f corr=%.3f delay=%d clip_ratio=%.3f slot0_rms=%d passed=%d",
             gate, esp_err_to_name(health_err), health.status, (double)health.score,
             (double)health.slot2_tone_amplitude, (double)health.slot2_quiet_rms,
             (double)health.slot2_correlation, health.estimated_delay_samples,
             (double)health.slot2_clip_ratio, health.slot0_rms, health.passed);
    nuwax_diagnostics_log_aec_ref_health(TAG,
                                          health.status,
                                          health.score,
                                          health.slot2_tone_amplitude,
                                          health.slot2_quiet_rms,
                                          health.slot2_correlation,
                                          health.estimated_delay_samples,
                                          health.slot2_clip_ratio,
                                          health.slot0_rms,
                                          health.passed);
    if (health_err != ESP_OK || !health.passed) {
        ESP_LOGW(TAG, "%s AEC ref health NOT passed - hardware AEC/L3 unavailable; keep mono path or software reference fallback",
                 gate);
    }
    const esp_err_t cleanup_err = audio_diagnostic_end(&diagnostic_lease);
    esp_err_t result_err = ref_err != ESP_OK ? ref_err : health_err;
    if (result_err == ESP_OK && !health.passed) {
        result_err = ESP_ERR_INVALID_RESPONSE;
    }
    return cleanup_err != ESP_OK ? cleanup_err : result_err;
}

static float clamp_p3_ref_health_volume_db(float volume_db)
{
    if (volume_db < -24.0f) {
        return -24.0f;
    }
    if (volume_db > 0.0f) {
        return 0.0f;
    }
    return volume_db;
}

static uint32_t clamp_p3_ref_health_duration_ms(uint32_t duration_ms)
{
    if (duration_ms < 500U) {
        return 500U;
    }
    if (duration_ms > 10000U) {
        return 10000U;
    }
    return duration_ms;
}

static esp_err_t run_p3_aec_ref_health_manual(float volume_db,
                                              uint32_t duration_ms,
                                              bool run_ref_probe,
                                              bool *out_passed)
{
    if (out_passed) {
        *out_passed = false;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        ESP_LOGW(TAG, "P3-0 manual ref health rejected: speaker playback pending");
        return ESP_ERR_INVALID_STATE;
    }
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P3-0 manual ref health rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
#endif

    const float safe_volume_db = clamp_p3_ref_health_volume_db(volume_db);
    const uint32_t safe_duration_ms = clamp_p3_ref_health_duration_ms(duration_ms);
    ESP_LOGW(TAG,
             "P3-0 manual AEC ref health start volume_db=%.1f duration_ms=%lu run_ref_probe=%d",
             (double)safe_volume_db,
             (unsigned long)safe_duration_ms,
             run_ref_probe ? 1 : 0);

    audio_diagnostic_owner_t diagnostic_lease = {0};
    ESP_RETURN_ON_ERROR(audio_diagnostic_begin(&diagnostic_lease),
                        TAG,
                        "manual AEC ref health rejected while audio is owned");

    esp_err_t ref_err = ESP_OK;
    if (run_ref_probe) {
        nuwax_vocat_ref_probe_stats_t ref = {0};
        ref_err = nuwax_vocat_audio_board_ref_probe(&ref);
        ESP_LOGW(TAG, "P3-0 manual REF slot probe result=%s ref_slot=%d delta=%d tone=[%d,%d,%d,%d] quiet=[%d,%d,%d,%d]",
                 esp_err_to_name(ref_err), ref.ref_slot, ref.ref_delta,
                 ref.tone_rms[0], ref.tone_rms[1], ref.tone_rms[2], ref.tone_rms[3],
                 ref.quiet_rms[0], ref.quiet_rms[1], ref.quiet_rms[2], ref.quiet_rms[3]);
    }

    nuwax_aec_ref_health_t health = {0};
    esp_err_t health_err = nuwax_vocat_aec_ref_health_check(safe_volume_db, safe_duration_ms, &health);
    if (ref_err != ESP_OK || health_err != ESP_OK) {
        health.passed = false;
    }
    apply_hardware_ref_release_gate(&health);
    s_aec_ref_health = health;
    nuwax_diagnostics_log_aec_ref_health(TAG,
                                          health.status,
                                          health.score,
                                          health.slot2_tone_amplitude,
                                          health.slot2_quiet_rms,
                                          health.slot2_correlation,
                                          health.estimated_delay_samples,
                                          health.slot2_clip_ratio,
                                          health.slot0_rms,
                                          health.passed);
    ESP_LOGW(TAG,
             "P3-0 manual AEC ref health done err=%s passed=%d status=%d score=%.3f volume_db=%.1f duration_ms=%lu",
             esp_err_to_name(health_err),
             health.passed ? 1 : 0,
             health.status,
             (double)health.score,
             (double)safe_volume_db,
             (unsigned long)safe_duration_ms);
    const bool diagnostic_passed = ref_err == ESP_OK &&
                                   health_err == ESP_OK && health.passed;
    if (out_passed) {
        *out_passed = diagnostic_passed;
    }
    const esp_err_t cleanup_err = audio_diagnostic_end(&diagnostic_lease);
    esp_err_t result_err = ref_err != ESP_OK ? ref_err : health_err;
    if (result_err == ESP_OK && !diagnostic_passed) {
        result_err = ESP_ERR_INVALID_RESPONSE;
    }
    return cleanup_err != ESP_OK ? cleanup_err : result_err;
}

static esp_err_t run_p3_softref_ab_manual(uint32_t duration_ms,
                                          uint32_t delay_samples,
                                          bool *out_ready)
{
    if (out_ready) {
        *out_ready = false;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P3-0S softref AEC A/B rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!nuwax_speaker_playback_has_pending()) {
        ESP_LOGW(TAG,
                 "P3-0S softref AEC A/B running without active speaker playback; expect ready=0 unless ref ring still has recent nonzero data");
    }
#endif
    nuwax_p3_softref_aec_ab_result_t result = {0};
    esp_err_t err = nuwax_p3_softref_aec_ab_run(duration_ms, delay_samples, &result);
    if (out_ready) {
        *out_ready = result.diagnostic_ready;
    }
    return err;
}

static esp_err_t run_p3_hardref_ab_manual(uint32_t duration_ms,
                                          bool *out_ready)
{
    if (out_ready) {
        *out_ready = false;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
