static void session_dispatch_apply_volume_percent(void *ctx, int volume_percent, bool persist) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_apply_volume_percent(volume_percent, persist);
    s_current_volume_percent = nuwax_speaker_playback_get_volume_percent();
#else
    s_current_volume_percent = (uint8_t)(volume_percent < 0
                                             ? 0
                                             : (volume_percent > 100
                                                    ? 100
                                                    : volume_percent));
    nuwax_app_shell_set_volume_percent(s_current_volume_percent);
    ESP_LOGI(TAG,
             "remote speaker volume set to %u%% but speaker output is disabled",
             (unsigned)s_current_volume_percent);
#endif
}

static esp_err_t session_dispatch_set_wake_word(void *ctx,
                                                const char *wake_word,
                                                bool persist) {
    (void)ctx;
    if (!s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "remote wake word ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }
    const esp_err_t err =
        nuwax_wake_word_detector_set_command(wake_word, persist);
    xSemaphoreGive(s_wake_model_operation_mutex);
    nuwax_wake_word_status_t status = {0};
    nuwax_wake_word_detector_get_status(&status);
    if (err == ESP_OK) {
        ESP_LOGI(TAG,
                 "remote wake word applied command=%s persist=%d running=%d",
                 status.active_command,
                 persist ? 1 : 0,
                 nuwax_wake_word_detector_is_running() ? 1 : 0);
    } else {
        ESP_LOGE(TAG,
                 "remote wake word rejected requested=%s active=%s persist=%d err=%s",
                 wake_word ? wake_word : "-",
                 status.active_command[0] ? status.active_command : "-",
                 persist ? 1 : 0,
                 esp_err_to_name(err));
    }
    return err;
}

static esp_err_t session_dispatch_set_wake_words(
    void *ctx,
    const nuwax_wake_word_config_t *config,
    bool persist) {
    (void)ctx;
    if (!s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "remote wake words ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }
    const esp_err_t err =
        nuwax_wake_word_detector_set_config(config, persist);
    xSemaphoreGive(s_wake_model_operation_mutex);
    nuwax_wake_word_status_t status = {0};
    nuwax_wake_word_detector_get_status(&status);
    if (err == ESP_OK) {
        ESP_LOGI(TAG,
                 "remote wake words applied primary=%s variants=%u persist=%d running=%d",
                 status.active_command,
                 (unsigned)status.active_variant_count,
                 persist ? 1 : 0,
                 nuwax_wake_word_detector_is_running() ? 1 : 0);
    } else {
        ESP_LOGE(TAG,
                 "remote wake words rejected requested_primary=%s requested_variants=%u active=%s active_variants=%u persist=%d err=%s",
                 config && config->count > 0U ? config->variants[0] : "-",
                 (unsigned)(config ? config->count : 0U),
                 status.active_command[0] ? status.active_command : "-",
                 (unsigned)status.active_variant_count,
                 persist ? 1 : 0,
                 esp_err_to_name(err));
    }
    return err;
}

static esp_err_t session_dispatch_reset_wake_word(void *ctx) {
    (void)ctx;
    if (!s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "remote wake word reset ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }
    const esp_err_t err = nuwax_wake_word_detector_reset_to_default();
    xSemaphoreGive(s_wake_model_operation_mutex);
    nuwax_wake_word_status_t status = {0};
    nuwax_wake_word_detector_get_status(&status);
    if (err == ESP_OK) {
        ESP_LOGI(TAG,
                 "remote wake word reset primary=%s variants=%u running=%d",
                 status.active_command,
                 (unsigned)status.active_variant_count,
                 nuwax_wake_word_detector_is_running() ? 1 : 0);
    } else {
        ESP_LOGE(TAG,
                 "remote wake word reset failed active=%s variants=%u err=%s",
                 status.active_command[0] ? status.active_command : "-",
                 (unsigned)status.active_variant_count,
                 esp_err_to_name(err));
    }
    return err;
}

