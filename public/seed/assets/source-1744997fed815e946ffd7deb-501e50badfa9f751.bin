static const char *TAG = "NuwaxPartner6";

static bool s_app_task_wdt_registered;

static esp_err_t app_task_watchdog_register(void) {
    esp_err_t err = esp_task_wdt_status(NULL);
    if (err == ESP_ERR_NOT_FOUND) {
        err = esp_task_wdt_add(NULL);
    }
    if (err != ESP_OK) {
        return err;
    }
    s_app_task_wdt_registered = true;
    return esp_task_wdt_reset();
}

static void app_task_watchdog_checkpoint(void) {
    if (!s_app_task_wdt_registered) {
        return;
    }
    const esp_err_t err = esp_task_wdt_reset();
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "application task watchdog reset failed: %s",
                 esp_err_to_name(err));
    }
}

