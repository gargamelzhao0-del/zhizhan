static void refresh_saved_wifi_list_ui(void) {
    nuwax_wifi_saved_network_t saved[NUWAX_WIFI_MAX_SAVED_NETWORKS] = {0};
    char ssids[NUWAX_WIFI_MAX_SAVED_NETWORKS][33] = {0};
    int count = 0;
    esp_err_t err = nuwax_wifi_get_saved_networks(saved, NUWAX_WIFI_MAX_SAVED_NETWORKS, &count);
    if (err != ESP_OK && err != ESP_ERR_NVS_NOT_FOUND && err != ESP_ERR_NOT_FOUND) {
        ESP_LOGW(TAG, "load saved Wi-Fi list failed: %s", esp_err_to_name(err));
        count = 0;
    }
    for (int i = 0; i < count; i++) {
        strlcpy(ssids[i], saved[i].ssid, sizeof(ssids[i]));
    }
    nuwax_app_shell_set_saved_wifi_networks((const char (*)[33])ssids, count);
}

static void shell_dispatch_set_simulated_offline(void *ctx,
                                                   nuwax_ws_client_t *ws,
                                                   bool enabled) {
    (void)ctx;
#if NUWAX_TEST_NETWORK_ENABLED
    /* The test switch must never tear down an in-progress provisioning or
     * OTA transaction.  Both workflows own the transport and require their
     * control connection to remain available; reject the optimistic UI
     * update and let the drawer roll it back. */
    if (enabled && (nuwax_provision_main_is_active()
#if CONFIG_NUWAX_OTA_ENABLE
                    || nuwax_ota_device_is_active()
#endif
                    || atomic_load_explicit(&s_reprovision_quiesce_requested,
                                             memory_order_acquire))) {
        ESP_LOGW(TAG,
                 "simulated offline request rejected while provisioning/OTA owns cloud transport");
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_SIMULATED_OFFLINE);
        return;
    }
    const esp_err_t err = nuwax_wifi_set_simulated_offline(enabled);
    if (err != ESP_OK) {
        ESP_LOGW(TAG, "simulated offline change enabled=%d failed: %s",
                 enabled ? 1 : 0, esp_err_to_name(err));
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_SIMULATED_OFFLINE);
        return;
    }
    nuwax_app_shell_set_simulated_offline(enabled);
    if (enabled && ws && nuwax_ws_is_connected(ws)) {
        const uint32_t epoch = nuwax_ws_connection_epoch(ws);
        if (!nuwax_ws_force_close_if_epoch(ws, epoch)) {
            ESP_LOGW(TAG,
                     "simulated offline could not request WebSocket close epoch=%lu",
                     (unsigned long)epoch);
        } else {
            ESP_LOGI(TAG,
                     "simulated offline enabled; WebSocket close requested epoch=%lu",
                     (unsigned long)epoch);
        }
    }
#else
    (void)ws;
    (void)enabled;
    ESP_LOGW(TAG, "simulated offline control is disabled in this build");
    nuwax_app_shell_notify_action_rejected(
        NUWAX_APP_SHELL_ACTION_SET_SIMULATED_OFFLINE);
#endif
}

static uint32_t monotonic_ms(void) {
    return (uint32_t)(esp_timer_get_time() / 1000);
}

static bool cloud_http_status_is_transient(int http_status)
{
    return (http_status >= 500 && http_status <= 599) ||
           http_status == 408 || http_status == 425 || http_status == 429;
}

static const char *cloud_connect_failure_class(int http_status,
                                                esp_err_t result)
{
    if (http_status >= 500 && http_status <= 599) {
        return "transient_gateway_5xx";
    }
    if (http_status == 408 || http_status == 425 || http_status == 429) {
        return "transient_http";
    }
    if (http_status == 401 || http_status == 403) {
        return "auth_rejected";
    }
    if (http_status > 0) {
        return "http_rejected";
    }
    if (result == ESP_ERR_NO_MEM) {
        return "device_no_mem";
    }
    return "transport";
}

static void cloud_reconnect_backoff_reset(void)
{
    if (s_cloud_reconnect_failures != 0U) {
        ESP_LOGI(TAG,
                 "cloud reconnect backoff reset after authenticated application readiness previous_failures=%lu",
                 (unsigned long)s_cloud_reconnect_failures);
    }
    s_cloud_reconnect_failures = 0U;
}

static void delay_before_cloud_reconnect(const char *reason,
                                         int http_status,
                                         esp_err_t result)
{
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        return;
    }
    if (s_cloud_reconnect_failures < UINT32_MAX) {
        s_cloud_reconnect_failures++;
    }

    uint32_t delay_ms = (uint32_t)CONFIG_NUWAX_VOICE_RECONNECT_DELAY_MS;
    const uint32_t max_delay_ms =
        (uint32_t)CONFIG_NUWAX_VOICE_RECONNECT_BACKOFF_MAX_MS;
    const uint32_t shift = s_cloud_reconnect_failures > 0U
                               ? s_cloud_reconnect_failures - 1U
                               : 0U;
    for (uint32_t i = 0U; i < shift && delay_ms < max_delay_ms; ++i) {
        if (delay_ms > max_delay_ms / 2U) {
            delay_ms = max_delay_ms;
            break;
        }
        delay_ms *= 2U;
    }
    if (delay_ms > max_delay_ms) {
        delay_ms = max_delay_ms;
    }

    ESP_LOGW(TAG,
             "cloud reconnect scheduled class=%s reason=%s http_status=%d result=%s failure_count=%lu delay_ms=%lu",
             cloud_connect_failure_class(http_status, result),
             reason ? reason : "unknown",
             http_status,
             esp_err_to_name(result),
             (unsigned long)s_cloud_reconnect_failures,
             (unsigned long)delay_ms);
    /* Keep the long backoff cooperative with BLE reprovisioning and other
     * owner-side handoff requests. The old fixed delay was short enough to
     * hide this; a 60 s cap must not make a local control request wait 60 s. */
    uint32_t remaining_ms = delay_ms;
    while (remaining_ms > 0U) {
        app_task_watchdog_checkpoint();
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            break;
        }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        /* A disconnected meeting/monitoring owner already has a durable
         * offline lease. Do not spend the reconnect backoff before servicing
         * its capture retry; the real cloud disconnect path needs the same
         * bounded handoff latency as the simulator. */
        if (offline_mode_lease_pending()) {
            break;
        }
#endif
#if CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE
        if (nuwax_wifi_simulated_offline()) {
            break;
        }
#endif
        const uint32_t slice_ms = remaining_ms > 100U ? 100U : remaining_ms;
        vTaskDelay(pdMS_TO_TICKS(slice_ms));
        remaining_ms -= slice_ms;
    }
}

static QueueHandle_t create_queue_prefer_psram(const char *name,
                                               UBaseType_t depth,
                                               UBaseType_t item_size,
                                               bool *out_created_with_caps) {
    if (out_created_with_caps) {
        *out_created_with_caps = false;
    }
    QueueHandle_t queue = xQueueCreateWithCaps(depth, item_size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (queue) {
        if (out_created_with_caps) {
            *out_created_with_caps = true;
        }
        ESP_LOGI(TAG,
                 "queue allocated in PSRAM name=%s depth=%lu item=%lu",
                 name ? name : "-",
                 (unsigned long)depth,
                 (unsigned long)item_size);
        return queue;
    }
    queue = xQueueCreate(depth, item_size);
    if (queue) {
        ESP_LOGW(TAG,
                 "queue PSRAM allocation failed, using internal name=%s depth=%lu item=%lu",
                 name ? name : "-",
                 (unsigned long)depth,
                 (unsigned long)item_size);
    }
    return queue;
}

static void delete_owned_queue(QueueHandle_t *queue, bool *created_with_caps) {
    if (!queue || !*queue) {
        return;
    }
    if (created_with_caps && *created_with_caps) {
        vQueueDeleteWithCaps(*queue);
    } else {
        vQueueDelete(*queue);
    }
    *queue = NULL;
    if (created_with_caps) {
        *created_with_caps = false;
    }
}

static bool elapsed_ms(uint32_t now_ms, uint32_t deadline_ms) {
    return (int32_t)(now_ms - deadline_ms) >= 0;
}

static uint32_t conversation_listen_window_ms(void) {
    return CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS > 0
               ? (uint32_t)CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS
               : 60000u;
}

#if CONFIG_NUWAX_SPEAKER_ENABLE
static uint32_t update_normal_downlink_admission(bool allowed) {
    if (!allowed) {
        atomic_store_explicit(&s_normal_downlink_allowed,
                              false,
                              memory_order_release);
    }
    uint32_t epoch = (uint32_t)(atomic_fetch_add_explicit(
                                    &s_normal_downlink_epoch,
                                    1U,
                                    memory_order_acq_rel) +
                                1U);
    if (epoch == 0U) {
        epoch = 1U;
        atomic_store_explicit(&s_normal_downlink_epoch,
                              epoch,
                              memory_order_release);
    }
    nuwax_speaker_playback_set_downlink_admission(epoch, allowed);
    if (allowed) {
        atomic_store_explicit(&s_normal_downlink_allowed,
                              true,
                              memory_order_release);
    }
    return epoch;
}
#endif

static const char *visual_round_kind_name(nuwax_visual_round_kind_t kind) {
    switch (kind) {
        case NUWAX_VISUAL_ROUND_NORMAL: return "normal";
        case NUWAX_VISUAL_ROUND_WAKE_GREETING: return "wake_greeting";
        case NUWAX_VISUAL_ROUND_HEAD_TOUCH: return "head_touch";
        case NUWAX_VISUAL_ROUND_SHAKE: return "shake";
        case NUWAX_VISUAL_ROUND_NONE:
        default: return "none";
    }
}

static void clear_conversation_visual_round(const char *reason) {
    if (!nuwax_conversation_visual_round_is_active(&s_visual_round)) {
        return;
    }
    const nuwax_visual_round_kind_t kind = s_visual_round.kind;
    const uint32_t ws_epoch = s_visual_round.ws_epoch;
    const uint32_t speaker_generation = s_visual_round.speaker_generation;
    if (nuwax_conversation_visual_round_is_interaction(&s_visual_round)) {
        nuwax_state_bridge_cancel_touch();
    }
    nuwax_conversation_visual_round_clear(&s_visual_round);
    ESP_LOGI(TAG,
             "conversation visual round cleared kind=%s epoch=%lu speaker_generation=%lu reason=%s",
             visual_round_kind_name(kind),
             (unsigned long)ws_epoch,
             (unsigned long)speaker_generation,
             reason ? reason : "-");
}

static bool begin_conversation_visual_round(
    nuwax_visual_round_kind_t kind,
    const char *request_id,
    const char *reason) {
    if (nuwax_conversation_visual_round_is_active(&s_visual_round)) {
        ESP_LOGW(TAG,
                 "conversation visual round replacing residual owner old_kind=%s new_kind=%s reason=%s",
                 visual_round_kind_name(s_visual_round.kind),
                 visual_round_kind_name(kind),
                 reason ? reason : "-");
        clear_conversation_visual_round("visual_round_replaced");
    }
    const uint32_t ws_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (!nuwax_conversation_visual_round_begin(&s_visual_round,
                                                kind,
                                                ws_epoch,
                                                awake_generation,
                                                request_id)) {
        ESP_LOGE(TAG,
                 "conversation visual round start rejected kind=%s epoch=%lu awake_generation=%lu request=%s reason=%s",
                 visual_round_kind_name(kind),
                 (unsigned long)ws_epoch,
                 (unsigned long)awake_generation,
                 request_id && request_id[0] ? request_id : "-",
                 reason ? reason : "-");
        return false;
    }
    ESP_LOGI(TAG,
             "conversation visual round begun kind=%s epoch=%lu awake_generation=%lu request=%s reason=%s",
             visual_round_kind_name(kind),
             (unsigned long)ws_epoch,
             (unsigned long)awake_generation,
             request_id && request_id[0] ? request_id : "-",
             reason ? reason : "-");
    return true;
}

static bool visual_round_command_matches(
    const nuwax_session_command_t *command) {
    if (!command ||
        !nuwax_conversation_visual_round_context_matches(
            &s_visual_round,
            active_ws_epoch_snapshot(),
            nuwax_awake_session_state_generation(&s_awake_session))) {
        return false;
    }
    return s_visual_round.request_id[0] == '\0' ||
           nuwax_conversation_visual_round_request_matches(
               &s_visual_round, command->request_id);
}

static void clear_active_turn_guard(const char *reason) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    atomic_store_explicit(&s_pending_speaker_start_generation,
                          0U,
                          memory_order_release);
    /* Close the RX admission gate before inspecting or invalidating speaker
     * state. The WebSocket task may be on another core, so leaving this until
     * the end permits a late binary frame to enter the generation being
     * cleared. */
    const bool had_active_turn = s_turn_guard.active;
    const uint32_t guard_speaker_generation =
        s_turn_guard.speaker_generation;
    if (had_active_turn && guard_speaker_generation != 0U &&
        s_playback_terminal_guard.active &&
        s_playback_terminal_guard.speaker_generation ==
            guard_speaker_generation &&
        s_playback_terminal_guard.connection_epoch ==
            active_ws_epoch_snapshot() &&
        !s_playback_terminal_guard.physical_done &&
        !s_playback_terminal_guard.faulted) {
        const uint32_t terminal_epoch =
            s_playback_terminal_guard.connection_epoch;
        (void)nuwax_playback_terminal_guard_mark_fault(
            &s_playback_terminal_guard,
            terminal_epoch,
            guard_speaker_generation,
            monotonic_ms(),
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
        ESP_LOGW(TAG,
                 "turn owner cleared before physical playback terminal epoch=%lu generation=%lu reason=%s; bounded local recovery armed",
                 (unsigned long)terminal_epoch,
                 (unsigned long)guard_speaker_generation,
                 reason ? reason : "-");
    }
    (void)update_normal_downlink_admission(false);
    if (had_active_turn && guard_speaker_generation == 0U) {
        (void)nuwax_speaker_playback_abort_metadata_only_session(
            s_turn_guard.turn_id,
            s_turn_guard.playback_id,
            reason ? reason : "turn_clear");
    }
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    const uint32_t pending_start_generation =
        (speaker_stats.start_gate_pending ||
         speaker_stats.start_gate_authorized)
            ? speaker_stats.start_gate_generation
            : 0U;
    bool guard_start_rejected = false;
    if (had_active_turn) {
        guard_start_rejected =
            nuwax_speaker_playback_reject_start_generation(
            guard_speaker_generation,
            reason ? reason : "turn_clear");
    }
    if (pending_start_generation != 0U &&
        pending_start_generation != guard_speaker_generation) {
        (void)nuwax_speaker_playback_reject_start_generation(
            pending_start_generation,
            reason ? reason : "turn_clear_pending");
    }
    if (s_deferred_speaker_start_valid) {
        (void)nuwax_speaker_playback_reject_start_generation(
            s_deferred_speaker_start_event.speaker_generation,
            reason ? reason : "turn_clear_deferred");
        s_deferred_speaker_start_valid = false;
        memset(&s_deferred_speaker_start_event, 0,
               sizeof(s_deferred_speaker_start_event));
        s_deferred_speaker_start_epoch = 0U;
    }
    if (guard_speaker_generation != 0U && !guard_start_rejected) {
        (void)nuwax_speaker_playback_request_cancel_generation(
            guard_speaker_generation,
            reason ? reason : "turn_clear",
            0U);
    }
#endif
    if (s_turn_guard.active) {
        ESP_LOGI(TAG,
                 "conversation turn guard cleared epoch=%lu phase=%s request=%s turn=%s playback=%s reason=%s",
                 (unsigned long)s_turn_guard.epoch,
                 nuwax_turn_phase_name(s_turn_guard.phase),
                 s_turn_guard.request_id[0] ? s_turn_guard.request_id : "-",
                 s_turn_guard.turn_id[0] ? s_turn_guard.turn_id : "-",
                 s_turn_guard.playback_id[0] ? s_turn_guard.playback_id : "-",
                 reason ? reason : "-");
    }
    nuwax_turn_guard_clear(&s_turn_guard);
    s_active_turn_id[0] = '\0';
    clear_conversation_visual_round(reason ? reason : "turn_guard_clear");
}

static bool begin_active_turn_guard(const char *request_id,
                                    const char *turn_id,
                                    uint32_t timeout_ms,
                                    const char *reason) {
    /* A live guard owns the current cloud turn.  Replacing it in-place would
     * let late text/TTS events from the previous turn enter the new owner.
     * Callers that intentionally start a new turn must clear the old owner
     * first (awake-session and listen transitions already do so). */
    if (s_turn_guard.active) {
        ESP_LOGW(TAG,
                 "conversation turn guard start rejected while another turn is active epoch=%lu phase=%s request=%s reason=%s",
                 (unsigned long)s_turn_guard.epoch,
                 nuwax_turn_phase_name(s_turn_guard.phase),
                 s_turn_guard.request_id[0] ? s_turn_guard.request_id : "-",
                 reason ? reason : "-");
        return false;
    }
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        ESP_LOGW(TAG,
                 "conversation turn guard start rejected outside awake session reason=%s request=%s turn=%s",
                 reason ? reason : "-",
                 request_id && request_id[0] ? request_id : "-",
                 turn_id && turn_id[0] ? turn_id : "-");
        return false;
    }
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    const uint32_t epoch = nuwax_turn_guard_begin(&s_turn_guard,
                                                  awake_generation,
                                                  request_id,
                                                  turn_id,
                                                  monotonic_ms(),
                                                  timeout_ms);
    if (epoch == 0U) {
        return false;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(true);
#endif
    if (turn_id && turn_id[0]) {
        strlcpy(s_active_turn_id, turn_id, sizeof(s_active_turn_id));
    } else {
        s_active_turn_id[0] = '\0';
    }
    ESP_LOGI(TAG,
             "conversation turn guard begun epoch=%lu awake_generation=%lu request=%s turn=%s timeout_ms=%lu reason=%s",
             (unsigned long)epoch,
             (unsigned long)awake_generation,
             request_id && request_id[0] ? request_id : "-",
             turn_id && turn_id[0] ? turn_id : "-",
             (unsigned long)timeout_ms,
             reason ? reason : "-");
    return true;
}

static bool active_turn_event_matches(const nuwax_session_command_t *command,
                                      uint32_t allowed_phase_mask,
                                      const char *event_name) {
    const bool strict_playback_event =
        event_name &&
        (strcmp(event_name, "playback_begin") == 0 ||
         strcmp(event_name, "playback_end") == 0 ||
         (strcmp(event_name, "tts_result") == 0 && command &&
          command->ok &&
          (command->playback_start || command->playback_end)));
    if (strict_playback_event &&
        (!command || command->turn_id[0] == '\0' ||
         command->playback_id[0] == '\0')) {
        ESP_LOGW(TAG,
                 "unowned playback event rejected event=%s turn=%s playback=%s",
                 event_name ? event_name : "-",
                 command && command->turn_id[0] ? command->turn_id : "-",
                 command && command->playback_id[0]
                     ? command->playback_id
                     : "-");
        return false;
    }
    if (!command || !s_turn_guard.active ||
        (allowed_phase_mask & (1UL << (uint32_t)s_turn_guard.phase)) == 0U ||
        !nuwax_turn_guard_matches(
            &s_turn_guard,
            nuwax_awake_session_state_generation(&s_awake_session),
            command->request_id,
            command->turn_id,
            command->playback_id)) {
        ESP_LOGI(TAG,
                 "stale conversation event ignored event=%s guard_epoch=%lu guard_phase=%s request=%s/%s turn=%s/%s playback=%s/%s awake_generation=%lu/%lu",
                 event_name ? event_name : "-",
                 (unsigned long)s_turn_guard.epoch,
                 nuwax_turn_phase_name(s_turn_guard.phase),
                 command && command->request_id[0] ? command->request_id : "-",
                 s_turn_guard.request_id[0] ? s_turn_guard.request_id : "-",
                 command && command->turn_id[0] ? command->turn_id : "-",
                 s_turn_guard.turn_id[0] ? s_turn_guard.turn_id : "-",
                 command && command->playback_id[0] ? command->playback_id : "-",
                 s_turn_guard.playback_id[0] ? s_turn_guard.playback_id : "-",
                 (unsigned long)nuwax_awake_session_state_generation(
                     &s_awake_session),
                 (unsigned long)s_turn_guard.awake_generation);
        return false;
    }
    return nuwax_turn_guard_bind_ids(&s_turn_guard,
                                      command->request_id,
                                      command->turn_id,
                                      command->playback_id);
}

static bool ensure_active_turn_guard_for_cloud_output(
    const nuwax_session_command_t *command,
    const char *event_name,
    bool *out_bootstrapped) {
    if (out_bootstrapped) {
        *out_bootstrapped = false;
    }
    if (!command) {
        return false;
    }
    if (s_turn_guard.active) {
        return true;
    }
    if (s_head_touch_agent_intent.state >=
            NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
        s_head_touch_agent_intent.state <
            NUWAX_HEAD_TOUCH_AGENT_STATE_SENT) {
        ESP_LOGI(TAG,
                 "unowned cloud output rejected while interaction replacement drains old turn event=%s interaction_state=%s",
                 event_name ? event_name : "-",
                 nuwax_head_touch_agent_state_name(
                     s_head_touch_agent_intent.state));
        return false;
    }
    if (command->turn_id[0] == '\0') {
        ESP_LOGW(TAG,
                 "cloud output cannot establish turn without turn_id event=%s playback=%s",
                 event_name ? event_name : "-",
                 command->playback_id[0] ? command->playback_id : "-");
        return false;
    }

    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    const uint32_t ws_epoch = active_ws_epoch_snapshot();
    const bool capture_runtime_active = atomic_load_explicit(
        &s_conversation_capture_runtime_active, memory_order_acquire);
    if (!nuwax_listen_resume_state_can_bootstrap_cloud_turn(
            &s_listen_resume,
            awake_generation,
            ws_epoch,
            capture_runtime_active)) {
        ESP_LOGI(TAG,
                 "unowned cloud output rejected event=%s turn=%s playback=%s awake_generation=%lu bound_generation=%lu capture=%d post_end_wait=%d event_epoch=%lu bound_epoch=%lu",
                 event_name ? event_name : "-",
                 command->turn_id,
                 command->playback_id[0] ? command->playback_id : "-",
                 (unsigned long)awake_generation,
                 (unsigned long)s_listen_resume.awake_generation,
                 capture_runtime_active ? 1 : 0,
                 nuwax_listen_resume_state_is_waiting_post_end_asr(
                     &s_listen_resume)
                     ? 1
                     : 0,
                 (unsigned long)ws_epoch,
                 (unsigned long)nuwax_listen_resume_state_ws_epoch(
                     &s_listen_resume));
        return false;
    }
    if (!begin_active_turn_guard(command->request_id,
                                 command->turn_id,
                                 NUWAX_CONVERSATION_TEXT_TIMEOUT_MS,
                                 event_name ? event_name
                                            : "cloud_output_bootstrap")) {
        return false;
    }
    if (!begin_conversation_visual_round(
            NUWAX_VISUAL_ROUND_NORMAL,
            command->request_id,
            event_name ? event_name : "cloud_output_bootstrap")) {
        clear_active_turn_guard("cloud_output_visual_round_failed");
        return false;
    }
    if (out_bootstrapped) {
        *out_bootstrapped = true;
    }
    ESP_LOGI(TAG,
             "conversation turn bootstrapped from cloud output event=%s turn=%s playback=%s capture=%d epoch=%lu",
             event_name ? event_name : "-",
             command->turn_id,
             command->playback_id[0] ? command->playback_id : "-",
             capture_runtime_active ? 1 : 0,
             (unsigned long)ws_epoch);
    return true;
}

#if CONFIG_NUWAX_SPEAKER_ENABLE
static bool authorize_speaker_generation_for_active_turn(
    uint32_t speaker_generation,
    const char *reason) {
    if (!s_turn_guard.active || speaker_generation == 0U ||
        s_turn_guard.turn_id[0] == '\0' ||
        s_turn_guard.playback_id[0] == '\0' ||
        !nuwax_awake_session_state_generation_matches(
            &s_awake_session, s_turn_guard.awake_generation)) {
        return false;
    }
    if (!nuwax_turn_guard_bind_speaker_generation(
            &s_turn_guard, speaker_generation)) {
        ESP_LOGW(TAG,
                 "speaker generation binding rejected generation=%lu guard=%lu reason=%s",
                 (unsigned long)speaker_generation,
                 (unsigned long)s_turn_guard.speaker_generation,
                 reason ? reason : "-");
        return false;
    }
    const esp_err_t err = nuwax_speaker_playback_authorize_generation(
        speaker_generation,
        s_turn_guard.turn_id,
        s_turn_guard.playback_id);
    if (err != ESP_OK) {
        ESP_LOGW(TAG,
                 "speaker generation authorization pending/rejected generation=%lu turn=%s playback=%s err=%s reason=%s",
                 (unsigned long)speaker_generation,
                 s_turn_guard.turn_id,
                 s_turn_guard.playback_id,
                 esp_err_to_name(err),
                 reason ? reason : "-");
        return false;
    }
    const uint32_t connection_epoch = active_ws_epoch_snapshot();
    if (!nuwax_playback_terminal_guard_arm(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            s_turn_guard.turn_id,
            s_turn_guard.playback_id,
            monotonic_ms(),
            NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS)) {
        ESP_LOGE(TAG,
                 "playback terminal guard binding rejected epoch=%lu generation=%lu turn=%s playback=%s reason=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 s_turn_guard.turn_id,
                 s_turn_guard.playback_id,
                 reason ? reason : "-");
        return false;
    }
    return true;
}
#endif

static bool set_active_turn_phase(nuwax_turn_phase_t next_phase,
                                  uint32_t timeout_ms) {
    return nuwax_turn_guard_transition(&s_turn_guard,
                                       s_turn_guard.phase,
                                       next_phase,
                                       monotonic_ms(),
                                       timeout_ms);
}

static bool conversation_wait_text_deadline_owned_by_turn_guard(void) {
    return s_turn_guard.active &&
           s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TEXT &&
           s_turn_guard.turn_id[0] != '\0';
}

static void note_conversation_cloud_progress(nuwax_session_event_t event) {
    s_conversation_cloud_progress_epoch++;
    if (s_conversation_cloud_progress_epoch == 0U) {
        s_conversation_cloud_progress_epoch++;
    }
    s_conversation_cloud_progress_event = event;
    s_conversation_cloud_progress_closes_capture = false;
}

static void note_conversation_cloud_turn_bootstrap(
    nuwax_session_event_t event) {
    note_conversation_cloud_progress(event);
    s_conversation_cloud_progress_closes_capture = true;
}

static void clear_awake_session(const char *reason) {
    clear_head_touch_agent_intent(reason ? reason : "awake_session_clear");
    clear_touch_cancel_recovery(reason ? reason : "awake_session_clear");
    s_awake_resume_after_ws_reconnect = false;
    s_awake_disconnect_ms = 0U;
    clear_ws_reconnect_audio_recovery();
    s_post_playback_resume_pending = false;
    s_natural_playback_touch_protection_deadline_ms = 0U;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);
    nuwax_speaker_playback_reset_jitter_learning();
#endif
    clear_active_turn_guard(reason ? reason : "awake_session_clear");
    clear_last_listen_resume();
    s_consecutive_post_end_response_timeouts = 0U;
    if (nuwax_awake_session_state_is_active(&s_awake_session)) {
        ESP_LOGI(TAG,
                 "conversation awake session cleared reason=%s",
                 reason ? reason : "-");
    }
    nuwax_awake_session_state_clear(&s_awake_session);
}

static void begin_awake_session(const char *reason) {
    /* A deferred local idle request belongs to the awake generation that
     * created it. Never let it cross a new wake/touch conversation boundary. */
    if (s_sleep_request_pending && s_sleep_request_requires_idle_expiry) {
        clear_sleep_request();
    }
    clear_head_touch_agent_intent(reason ? reason : "awake_session_begin");
    clear_touch_cancel_recovery(reason ? reason : "awake_session_begin");
    /* An awake conversation owns the microphone lifecycle until it returns to
     * sleep. Prevent the independent wake supervisor from racing that handoff. */
    inhibit_sleep_wake_word_detector(reason ? reason : "awake_session_begin");
    s_awake_resume_after_ws_reconnect = false;
    s_awake_disconnect_ms = 0U;
    clear_ws_reconnect_audio_recovery();
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);
#endif
    clear_active_turn_guard(reason ? reason : "awake_session_begin");
    clear_last_listen_resume();
    s_consecutive_post_end_response_timeouts = 0U;
    nuwax_awake_session_state_begin(
        &s_awake_session,
        (uint32_t)CONFIG_NUWAX_CONVERSATION_AWAKE_IDLE_TIMEOUT_MS);
    ESP_LOGI(TAG,
             "conversation awake session begun paused reason=%s timeout_ms=%u generation=%lu",
             reason ? reason : "-",
             (unsigned)CONFIG_NUWAX_CONVERSATION_AWAKE_IDLE_TIMEOUT_MS,
              (unsigned long)nuwax_awake_session_state_generation(
                  &s_awake_session));
}

static bool preserve_awake_session_for_ws_reconnect(const char *reason) {
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        return false;
    }
    const uint32_t now_ms = monotonic_ms();
    if (nuwax_awake_session_state_is_expired(&s_awake_session, now_ms) ||
        nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms) == 0U) {
        return false;
    }
    pause_awake_waiting(reason ? reason : "ws_disconnect");
    clear_head_touch_agent_intent(reason ? reason : "ws_disconnect");
    clear_active_turn_guard(reason ? reason : "ws_disconnect");
    clear_last_listen_resume();
    clear_auto_followup(reason ? reason : "ws_disconnect");
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    portENTER_CRITICAL(&s_wake_stop_handoff_lock);
    s_during_playback_wake_stop_pending = false;
    s_during_playback_wake_stop_playback_started = false;
    portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
    s_post_playback_resume_pending = false;
    clear_ws_reconnect_audio_recovery();
    nuwax_prelisten_state_clear(&s_prelisten);
    s_awake_resume_after_ws_reconnect = true;
    s_awake_disconnect_ms = now_ms;
    ESP_LOGI(TAG,
             "conversation awake session preserved for WebSocket reconnect reason=%s remaining_ms=%lu generation=%lu grace_ms=%u",
             reason ? reason : "ws_disconnect",
             (unsigned long)nuwax_awake_session_state_remaining_ms(
                 &s_awake_session, now_ms),
             (unsigned long)nuwax_awake_session_state_generation(
                 &s_awake_session),
             (unsigned)NUWAX_AWAKE_WS_RESUME_GRACE_MS);
    return true;
}

static void pause_awake_waiting(const char *reason) {
    if (!nuwax_awake_session_state_is_waiting(&s_awake_session)) {
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    nuwax_awake_session_state_pause(&s_awake_session, now_ms);
    ESP_LOGI(TAG,
             "conversation awake idle timer paused reason=%s remaining_ms=%lu generation=%lu",
             reason ? reason : "-",
             (unsigned long)nuwax_awake_session_state_remaining_ms(
                 &s_awake_session, now_ms),
             (unsigned long)nuwax_awake_session_state_generation(
                 &s_awake_session));
}

static void reset_awake_wait_budget_paused(const char *reason) {
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        return;
    }
    /* Confirmed activity starts a fresh quiet interval. It also supersedes a
     * same-generation idle request that was waiting for the MIC owner. */
    if (s_sleep_request_pending && s_sleep_request_requires_idle_expiry) {
        clear_sleep_request();
    }
    const uint32_t now_ms = monotonic_ms();
    nuwax_awake_session_state_reset_paused(&s_awake_session);
    ESP_LOGI(TAG,
             "conversation awake idle budget reset paused reason=%s remaining_ms=%lu generation=%lu",
             reason ? reason : "-",
             (unsigned long)nuwax_awake_session_state_remaining_ms(
                 &s_awake_session, now_ms),
             (unsigned long)nuwax_awake_session_state_generation(
                 &s_awake_session));
}

static void resume_awake_waiting(const char *reason) {
    if (!nuwax_awake_session_state_is_active(&s_awake_session) ||
        nuwax_awake_session_state_is_waiting(&s_awake_session)) {
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    nuwax_awake_session_state_resume_waiting(&s_awake_session, now_ms);
    ESP_LOGI(TAG,
             "conversation awake idle timer running reason=%s remaining_ms=%lu generation=%lu",
             reason ? reason : "-",
             (unsigned long)nuwax_awake_session_state_remaining_ms(
                 &s_awake_session, now_ms),
             (unsigned long)nuwax_awake_session_state_generation(
                 &s_awake_session));
}

static void make_conversation_audio_session_id(char *out, size_t out_size) {
    if (!out || out_size == 0) {
        return;
    }
    uint32_t sequence = ++s_conversation_audio_session_seq;
    if (sequence == 0) {
        sequence = ++s_conversation_audio_session_seq;
    }
    snprintf(out,
             out_size,
             "conversation_%08lx_%08lx",
             (unsigned long)nuwax_awake_session_state_generation(
                 &s_awake_session),
             (unsigned long)sequence);
}

static uint32_t awake_session_listen_window_ms(uint32_t now_ms) {
    const uint32_t base_window_ms = conversation_listen_window_ms();
    if (!nuwax_awake_session_state_is_waiting(&s_awake_session)) {
        return base_window_ms;
    }
    const uint32_t remaining_ms =
        nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms);
    if (remaining_ms == 0 || remaining_ms > base_window_ms) {
        return base_window_ms;
    }
    return remaining_ms;
}

static int32_t metrics_delta_ms(uint32_t start_ms, uint32_t end_ms) {
    if (start_ms == 0 || end_ms == 0) {
        return -1;
    }
    if ((int32_t)(end_ms - start_ms) < 0) {
        return -1;
    }
    return (int32_t)(end_ms - start_ms);
}

static void wake_greeting_metrics_cancel(const char *reason) {
    if (!s_wake_greeting_metrics.active) {
        return;
    }
    ESP_LOGI(TAG,
             "wake greeting metrics cancelled seq=%lu reason=%s request=%s wake_word=%s",
             (unsigned long)s_wake_greeting_metrics.seq,
             reason ? reason : "-",
             s_wake_greeting_metrics.request_id[0] ? s_wake_greeting_metrics.request_id : "-",
             s_wake_greeting_metrics.wake_word[0] ? s_wake_greeting_metrics.wake_word : "-");
    s_wake_greeting_metrics.active = false;
}

static void wake_greeting_metrics_begin(const char *wake_word,
                                        uint32_t detected_ms) {
    if (s_wake_greeting_metrics.active) {
        wake_greeting_metrics_cancel("new_wake");
    }
    const uint32_t now_ms = monotonic_ms();
    const uint32_t next_seq = s_wake_greeting_metrics.seq + 1;
    memset(&s_wake_greeting_metrics, 0, sizeof(s_wake_greeting_metrics));
    s_wake_greeting_metrics.active = true;
    s_wake_greeting_metrics.seq = next_seq == 0 ? 1 : next_seq;
    s_wake_greeting_metrics.wake_detected_ms =
        detected_ms != 0U ? detected_ms : now_ms;
    strlcpy(s_wake_greeting_metrics.wake_word,
            wake_word && wake_word[0] ? wake_word : "-",
            sizeof(s_wake_greeting_metrics.wake_word));
    ESP_LOGI(TAG,
             "wake greeting metrics start seq=%lu wake_word=%s owner_dispatch_ms=%ld",
             (unsigned long)s_wake_greeting_metrics.seq,
             s_wake_greeting_metrics.wake_word,
             (long)metrics_delta_ms(
                 s_wake_greeting_metrics.wake_detected_ms, now_ms));
}

static bool wake_greeting_metrics_matches_request(const char *request_id) {
    if (!s_wake_greeting_metrics.active || !request_id || request_id[0] == '\0') {
        return false;
    }
    if (s_wake_greeting_metrics.request_id[0] == '\0') {
        return strncmp(request_id,
                       NUWAX_WAKE_WORD_GREETING_REQUEST_PREFIX,
                       strlen(NUWAX_WAKE_WORD_GREETING_REQUEST_PREFIX)) == 0;
    }
    return strcmp(request_id, s_wake_greeting_metrics.request_id) == 0;
}

static void wake_greeting_metrics_mark_sent(const char *request_id, esp_err_t result) {
    if (!s_wake_greeting_metrics.active) {
        return;
    }
    s_wake_greeting_metrics.greeting_sent_ms = monotonic_ms();
    strlcpy(s_wake_greeting_metrics.request_id,
            request_id && request_id[0] ? request_id : "-",
            sizeof(s_wake_greeting_metrics.request_id));
    ESP_LOGI(TAG,
             "wake greeting metrics sent seq=%lu request=%s result=%s wake_to_send_ms=%ld",
             (unsigned long)s_wake_greeting_metrics.seq,
             s_wake_greeting_metrics.request_id,
             esp_err_to_name(result),
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                    s_wake_greeting_metrics.greeting_sent_ms));
    if (result != ESP_OK) {
        s_wake_greeting_metrics.active = false;
    }
}

static void wake_greeting_metrics_mark_text_response(const char *request_id, bool ok, bool tts_pending) {
    if (!wake_greeting_metrics_matches_request(request_id)) {
        return;
    }
    if (s_wake_greeting_metrics.text_response_ms == 0) {
        s_wake_greeting_metrics.text_response_ms = monotonic_ms();
    }
    ESP_LOGI(TAG,
             "wake greeting metrics text_response seq=%lu request=%s ok=%d tts_pending=%d wake_to_text_ms=%ld send_to_text_ms=%ld",
             (unsigned long)s_wake_greeting_metrics.seq,
             request_id && request_id[0] ? request_id : "-",
             ok ? 1 : 0,
             tts_pending ? 1 : 0,
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                    s_wake_greeting_metrics.text_response_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.greeting_sent_ms,
                                    s_wake_greeting_metrics.text_response_ms));
    if (!ok || !tts_pending) {
        ESP_LOGI(TAG,
                 "wake greeting metrics done seq=%lu result=%s total_ms=%ld",
                 (unsigned long)s_wake_greeting_metrics.seq,
                 ok ? "text_only" : "text_error",
                 (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                        s_wake_greeting_metrics.text_response_ms));
        s_wake_greeting_metrics.active = false;
    }
}

static void wake_greeting_metrics_mark_tts_start(void) {
    if (!s_wake_greeting_metrics.active || s_wake_greeting_metrics.tts_start_ms != 0) {
        return;
    }
    s_wake_greeting_metrics.tts_start_ms = monotonic_ms();
    ESP_LOGI(TAG,
             "wake greeting metrics tts_start seq=%lu wake_to_tts_ms=%ld text_to_tts_ms=%ld",
             (unsigned long)s_wake_greeting_metrics.seq,
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                    s_wake_greeting_metrics.tts_start_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.text_response_ms,
                                    s_wake_greeting_metrics.tts_start_ms));
}

static void wake_greeting_metrics_mark_playback_done(uint32_t played_frames, uint32_t write_failures) {
    if (!s_wake_greeting_metrics.active) {
        return;
    }
    s_wake_greeting_metrics.playback_done_ms = monotonic_ms();
    ESP_LOGI(TAG,
             "wake greeting metrics done seq=%lu wake_to_send_ms=%ld send_to_text_ms=%ld text_to_tts_ms=%ld tts_playback_ms=%ld total_ms=%ld played_frames=%lu write_failures=%lu",
             (unsigned long)s_wake_greeting_metrics.seq,
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                    s_wake_greeting_metrics.greeting_sent_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.greeting_sent_ms,
                                    s_wake_greeting_metrics.text_response_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.text_response_ms,
                                    s_wake_greeting_metrics.tts_start_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.tts_start_ms,
                                    s_wake_greeting_metrics.playback_done_ms),
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                    s_wake_greeting_metrics.playback_done_ms),
             (unsigned long)played_frames,
             (unsigned long)write_failures);
    s_wake_greeting_metrics.active = false;
}

static void log_firmware_startup_info(void) {
    const esp_app_desc_t *desc = esp_app_get_description();
    const char *running_version =
        desc && desc->version[0] ? desc->version : "unknown";
    ESP_LOGI(TAG,
             "firmware version=%s project=%s idf=%s app_ver=%s build=%s %s",
             running_version,
             desc && desc->project_name[0] ? desc->project_name : "-",
             desc && desc->idf_ver[0] ? desc->idf_ver : "-",
             running_version,
             desc && desc->date[0] ? desc->date : "-",
             desc && desc->time[0] ? desc->time : "-");
}

static const char *wake_backend_name(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
#if CONFIG_NUWAX_WAKE_WORD_BACKEND_MULTINET
    return "multinet_custom";
#else
    return "wakenet";
#endif
#else
    return "disabled";
#endif
}

#include "conversation/runtime_metrics_storage.inc"

static void metrics_begin_prelisten(const char *mode, const char *reason) {
    const uint32_t now_ms = monotonic_ms();
    const uint64_t now_us = (uint64_t)esp_timer_get_time();
    const uint32_t next_seq = s_conversation_metrics.seq + 1;
    if (s_conversation_metrics.active) {
        ESP_LOGI(TAG,
                 "conversation metrics cancelled seq=%lu mode=%s reason=replaced_by_%s",
                 (unsigned long)s_conversation_metrics.seq,
                 s_conversation_metrics.mode,
                 reason ? reason : "new_round");
    }
    memset(&s_conversation_metrics, 0, sizeof(s_conversation_metrics));
    s_conversation_metrics.active = true;
    s_conversation_metrics.seq = next_seq == 0 ? 1 : next_seq;
    s_conversation_metrics.prelisten_start_ms = now_ms;
    strlcpy(s_conversation_metrics.mode, mode ? mode : "prelisten", sizeof(s_conversation_metrics.mode));
    s_conversation_runtime_metrics_ready = metrics_runtime_prepare(
        s_conversation_metrics.seq, now_us);
    ESP_LOGI(TAG,
             "conversation metrics start seq=%lu mode=%s reason=%s",
             (unsigned long)s_conversation_metrics.seq,
             s_conversation_metrics.mode,
             reason ? reason : "-");
}

static void metrics_cancel(const char *reason) {
    if (!s_conversation_metrics.active) {
        return;
    }
    ESP_LOGI(TAG,
             "conversation metrics cancelled seq=%lu mode=%s reason=%s uploaded_frames=%lu",
             (unsigned long)s_conversation_metrics.seq,
             s_conversation_metrics.mode,
             reason ? reason : "-",
             (unsigned long)s_conversation_metrics.uploaded_frames);
    s_conversation_metrics.active = false;
}

static void metrics_record_duration(nuwax_conversation_latency_id_t id,
                                    uint64_t started_us,
                                    uint64_t completed_us) {
    if (!s_conversation_runtime_metrics_ready || completed_us < started_us) {
        return;
    }
    (void)nuwax_conversation_metrics_record_duration(
        s_conversation_runtime_metrics, id, completed_us - started_us);
}

static void metrics_record_elapsed(nuwax_conversation_latency_id_t id,
                                   uint64_t elapsed_us) {
    if (!s_conversation_runtime_metrics_ready) {
        return;
    }
    (void)nuwax_conversation_metrics_record_duration(
        s_conversation_runtime_metrics, id, elapsed_us);
}

static void metrics_log_runtime_snapshot(const char *reason) {
    if (!s_conversation_runtime_metrics_ready) {
        return;
    }
    nuwax_conversation_metrics_snapshot_t snapshot = {0};
    if (!nuwax_conversation_metrics_snapshot(s_conversation_runtime_metrics,
                                             (uint64_t)esp_timer_get_time(),
                                             &snapshot)) {
        ESP_LOGW(TAG, "conversation runtime metrics snapshot failed reason=%s",
                 reason ? reason : "-");
        return;
    }
    const nuwax_conversation_latency_summary_t *dsp =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_PROCESS];
    const nuwax_conversation_latency_summary_t *aec =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_AEC];
    const nuwax_conversation_latency_summary_t *human =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_HUMAN_DETECTOR];
    const nuwax_conversation_latency_summary_t *cleaner =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_CLEANER];
    const nuwax_conversation_latency_summary_t *preroll =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_PREROLL];
    const nuwax_conversation_latency_summary_t *encode =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_ENCODE];
    const nuwax_conversation_latency_summary_t *enqueue =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_DSP_ENQUEUE];
    const nuwax_conversation_latency_summary_t *candidate_to_confirm =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_BARGE_CANDIDATE_TO_CONFIRM];
    const nuwax_conversation_latency_summary_t *onset_to_stop =
        &snapshot.latency[NUWAX_CONVERSATION_LATENCY_BARGE_ONSET_TO_LOCAL_STOP];
    ESP_LOGI(TAG,
             "conversation runtime metrics reason=%s round=%llu elapsed_ms=%llu dsp_us=%llu/%llu/%llu phase_p95_us=aec:%llu,human:%llu,cleaner:%llu,preroll:%llu,encode:%llu,enqueue:%llu barge_candidate_confirm_us=%llu/%llu/%llu barge_onset_stop_us=%llu/%llu/%llu capture_q=%lu/%lu uplink_q=%lu/%lu stale_capture=%llu sequence_gaps=%llu speaker_underruns=%llu aec_fallback=%llu aec=%s reasons=0x%lx rejected_timing=%lu",
             reason ? reason : "-",
             (unsigned long long)snapshot.round_id,
             (unsigned long long)(snapshot.round_elapsed_us / 1000ULL),
             (unsigned long long)dsp->p50_us,
             (unsigned long long)dsp->p95_us,
             (unsigned long long)dsp->p99_us,
             (unsigned long long)aec->p95_us,
             (unsigned long long)human->p95_us,
             (unsigned long long)cleaner->p95_us,
             (unsigned long long)preroll->p95_us,
             (unsigned long long)encode->p95_us,
             (unsigned long long)enqueue->p95_us,
             (unsigned long long)candidate_to_confirm->p50_us,
             (unsigned long long)candidate_to_confirm->p95_us,
             (unsigned long long)candidate_to_confirm->p99_us,
             (unsigned long long)onset_to_stop->p50_us,
             (unsigned long long)onset_to_stop->p95_us,
             (unsigned long long)onset_to_stop->p99_us,
             (unsigned long)snapshot.queues[NUWAX_CONVERSATION_QUEUE_CAPTURE].high_watermark,
             (unsigned long)snapshot.queues[NUWAX_CONVERSATION_QUEUE_CAPTURE].last_capacity,
             (unsigned long)snapshot.queues[NUWAX_CONVERSATION_QUEUE_UPLINK].high_watermark,
             (unsigned long)snapshot.queues[NUWAX_CONVERSATION_QUEUE_UPLINK].last_capacity,
             (unsigned long long)snapshot.events[NUWAX_CONVERSATION_EVENT_STALE_CAPTURE_FRAME],
             (unsigned long long)snapshot.events[NUWAX_CONVERSATION_EVENT_SEQUENCE_GAP],
             (unsigned long long)snapshot.events[NUWAX_CONVERSATION_EVENT_SPEAKER_UNDERRUN],
             (unsigned long long)snapshot.events[NUWAX_CONVERSATION_EVENT_AEC_FALLBACK],
             nuwax_aec_runtime_state_name(snapshot.aec.current_state),
             (unsigned long)snapshot.aec.current_reasons,
             (unsigned long)snapshot.rejected_timing_samples);
}

static esp_err_t conversation_live_aec_pool_init(void) {
    void *post_reprovision_guard = NULL;
    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (s_conversation_live_aec_pool_initialized) {
        const esp_err_t status = s_conversation_live_aec_pool_status;
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        return status;
    }
    if (s_conversation_live_aec_pool_initializing ||
        s_conversation_live_aec_pool_in_use) {
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        return ESP_ERR_INVALID_STATE;
    }
    s_conversation_live_aec_pool_initializing = true;
    post_reprovision_guard =
        s_conversation_live_aec_post_reprovision_guard;
    s_conversation_live_aec_post_reprovision_guard = NULL;
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);

    if (post_reprovision_guard) {
        heap_caps_free(post_reprovision_guard);
        ESP_LOGI(TAG,
                 "post-provision AEC contiguous guard claimed by first prepare internal=%u largest=%u",
                 (unsigned)heap_caps_get_free_size(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
    }

    nuwax_live_aec_init(&s_conversation_live_aec_pool);
    nuwax_live_aec_set_internal_software_ref_enabled(
        &s_conversation_live_aec_pool, false);

    const size_t frame_samples = nuwax_audio_uplink_samples_per_frame();
    const size_t before_internal =
        heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const size_t before_largest =
        heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const bool configured =
        nuwax_live_aec_is_enabled(&s_conversation_live_aec_pool);
    const bool prep_reserve_ok =
        !configured ||
        (before_internal >= NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_FREE_BYTES &&
         before_largest >= NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES);
    esp_err_t err = prep_reserve_ok
                        ? nuwax_live_aec_prepare(
                              &s_conversation_live_aec_pool, frame_samples)
                        : ESP_ERR_NO_MEM;
    if (err == ESP_OK && configured &&
        !s_conversation_live_aec_pool.initialized) {
        err = ESP_ERR_INVALID_STATE;
    }

    const size_t after_internal =
        heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const size_t after_largest =
        heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const size_t after_dma =
        heap_caps_get_free_size(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    const size_t after_dma_largest =
        heap_caps_get_largest_free_block(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    const bool reserve_ok =
        !configured ||
        (after_internal >= NUWAX_LIVE_AEC_POST_MIN_INTERNAL_FREE_BYTES &&
         after_largest >= NUWAX_LIVE_AEC_POST_MIN_INTERNAL_LARGEST_BYTES &&
         after_dma >= NUWAX_LIVE_AEC_POST_MIN_DMA_FREE_BYTES &&
         after_dma_largest >= NUWAX_LIVE_AEC_POST_MIN_DMA_LARGEST_BYTES);
    if (err == ESP_OK && !reserve_ok) {
        err = ESP_ERR_NO_MEM;
    }

    if (err != ESP_OK) {
        ESP_LOGE(TAG,
                 "deferred live AEC reservation failed err=%s configured=%d prep_reserve_ok=%d reserve_ok=%d internal=%u->%u largest=%u->%u dma=%u/%u; barge-in will fail closed",
                 esp_err_to_name(err),
                 configured ? 1 : 0,
                 prep_reserve_ok ? 1 : 0,
                 reserve_ok ? 1 : 0,
                 (unsigned)before_internal,
                 (unsigned)after_internal,
                 (unsigned)before_largest,
                 (unsigned)after_largest,
                 (unsigned)after_dma,
                 (unsigned)after_dma_largest);
        nuwax_live_aec_deinit(&s_conversation_live_aec_pool);
        memset(&s_conversation_live_aec_pool, 0,
               sizeof(s_conversation_live_aec_pool));
        portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
        s_conversation_live_aec_pool_initialized = false;
        s_conversation_live_aec_pool_initializing = false;
        s_conversation_live_aec_pool_available = false;
        s_conversation_live_aec_pool_status = err;
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        atomic_store_explicit(&s_conversation_live_aec_degraded, true,
                              memory_order_release);
        if (post_reprovision_guard) {
            atomic_store_explicit(
                &s_conversation_live_aec_post_reprovision_restart,
                true,
                memory_order_release);
        }
        return err;
    }

    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    s_conversation_live_aec_pool_initialized = true;
    s_conversation_live_aec_pool_initializing = false;
    s_conversation_live_aec_pool_available = true;
    s_conversation_live_aec_pool_status = ESP_OK;
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
    atomic_store_explicit(&s_conversation_live_aec_degraded, false,
                          memory_order_release);
    if (post_reprovision_guard) {
        atomic_store_explicit(
            &s_conversation_live_aec_post_reprovision_restart,
            false,
            memory_order_release);
    }
    ESP_LOGI(TAG,
             "deferred live AEC reserved configured=%d initialized=%d frame_samples=%u internal=%u->%u largest=%u->%u dma=%u/%u psram=%u",
             configured ? 1 : 0,
             s_conversation_live_aec_pool.initialized ? 1 : 0,
             (unsigned)frame_samples,
             (unsigned)before_internal,
             (unsigned)after_internal,
             (unsigned)before_largest,
             (unsigned)after_largest,
             (unsigned)after_dma,
             (unsigned)after_dma_largest,
             (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
    return ESP_OK;
}

static void restart_if_post_reprovision_aec_failed(const char *context)
{
    if (!atomic_exchange_explicit(
            &s_conversation_live_aec_post_reprovision_restart,
            false,
            memory_order_acq_rel)) {
        return;
    }
    ESP_LOGE(TAG,
             "post-provision AEC failed after consuming protected memory context=%s; preserving configuration and restarting through clean boot allocation order",
             context ? context : "-");
    set_state(NUWAX_APP_STATE_ERROR);
    nuwax_diagnostics_log_heap_label(
        TAG, "post_provision_aec_prepare_restart");
    vTaskDelay(pdMS_TO_TICKS(100));
    esp_restart();
    vTaskDelay(portMAX_DELAY);
}

static esp_err_t conversation_live_aec_pool_suspend(const char *reason) {
    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    const bool in_use = s_conversation_live_aec_pool_in_use;
    const bool initialized = s_conversation_live_aec_pool_initialized;
    const bool initializing = s_conversation_live_aec_pool_initializing;
    if (!in_use && !initializing) {
        s_conversation_live_aec_pool_initialized = false;
        s_conversation_live_aec_pool_initializing = initialized;
        s_conversation_live_aec_pool_available = false;
        s_conversation_live_aec_pool_status = ESP_ERR_INVALID_STATE;
    }
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (in_use || initializing) {
        ESP_LOGE(TAG,
                 "live AEC pool cannot suspend reason=%s in_use=%d initializing=%d",
                 reason ? reason : "-",
                 in_use ? 1 : 0, initializing ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
    if (initialized) {
        nuwax_live_aec_deinit(&s_conversation_live_aec_pool);
        memset(&s_conversation_live_aec_pool, 0,
               sizeof(s_conversation_live_aec_pool));
        portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
        s_conversation_live_aec_pool_initializing = false;
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        ESP_LOGI(TAG, "live AEC reservation released reason=%s",
                 reason ? reason : "-");
    }
    return ESP_OK;
}

static esp_err_t conversation_live_aec_pool_suspend_for_provisioning(void) {
    void *stale_guard = NULL;
    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    stale_guard = s_conversation_live_aec_post_reprovision_guard;
    s_conversation_live_aec_post_reprovision_guard = NULL;
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (stale_guard) {
        heap_caps_free(stale_guard);
        ESP_LOGI(TAG,
                 "previous post-provision AEC guard released for new BLE provisioning");
    }
    atomic_store_explicit(&s_conversation_live_aec_post_reprovision_restart,
                          false, memory_order_release);
    return conversation_live_aec_pool_suspend("ble_provisioning");
}

static void service_conversation_live_aec_pool_recovery(void) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        atomic_load_explicit(&s_conversation_capture_starting,
                             memory_order_acquire) ||
        atomic_load_explicit(&s_conversation_capture_runtime_active,
                             memory_order_acquire) ||
        !cloud_service_is_ready() ||
        !nuwax_awake_session_state_is_active(&s_awake_session)) {
        return;
    }

    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    const bool recovery_needed =
        !s_conversation_live_aec_pool_initialized &&
        !s_conversation_live_aec_pool_initializing &&
        !s_conversation_live_aec_pool_in_use;
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (!recovery_needed) {
        return;
    }

    const uint32_t now_ms = monotonic_ms();
    if (!elapsed_ms(now_ms, s_conversation_live_aec_pool_retry_ms)) {
        return;
    }
    s_conversation_live_aec_pool_retry_ms =
        now_ms + NUWAX_LIVE_AEC_RECOVERY_RETRY_MS;
    const esp_err_t err = conversation_live_aec_pool_init();
    if (err == ESP_OK) {
        ESP_LOGI(TAG, "conversation live AEC pool recovered by health service");
    } else {
        ESP_LOGW(TAG,
                 "conversation live AEC pool health retry failed: %s",
                 esp_err_to_name(err));
    }
#endif
}

static bool conversation_live_aec_pool_acquire(nuwax_live_aec_t *out) {
    if (!out) {
        return false;
    }
    bool acquired = false;
    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (s_conversation_live_aec_pool_initialized &&
        s_conversation_live_aec_pool_available &&
        !s_conversation_live_aec_pool_in_use) {
        s_conversation_live_aec_pool_in_use = true;
        acquired = true;
    }
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
    if (!acquired) {
        return false;
    }
    *out = s_conversation_live_aec_pool;
    memset(&s_conversation_live_aec_pool, 0,
           sizeof(s_conversation_live_aec_pool));
    return true;
}

static esp_err_t conversation_live_aec_restore_production_state(
    nuwax_live_aec_t *aec,
    size_t frame_samples,
    uint32_t production_delay_samples) {
    if (!aec || frame_samples == 0U) {
        return ESP_ERR_INVALID_ARG;
    }

    nuwax_live_aec_deinit(aec);
    nuwax_live_aec_init(aec);
    nuwax_live_aec_set_internal_software_ref_enabled(aec, false);
    aec->delay_samples = production_delay_samples;
    const bool configured = nuwax_live_aec_is_enabled(aec);
    esp_err_t err = nuwax_live_aec_prepare(aec, frame_samples);
    if (err == ESP_OK && configured && !aec->initialized) {
        err = ESP_ERR_INVALID_STATE;
    }
    const size_t after_internal =
        heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const size_t after_largest =
        heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    const size_t after_dma =
        heap_caps_get_free_size(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    const size_t after_dma_largest =
        heap_caps_get_largest_free_block(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
    const bool reserve_ok =
        !configured ||
        (after_internal >= NUWAX_LIVE_AEC_POST_MIN_INTERNAL_FREE_BYTES &&
         after_largest >= NUWAX_LIVE_AEC_POST_MIN_INTERNAL_LARGEST_BYTES &&
         after_dma >= NUWAX_LIVE_AEC_POST_MIN_DMA_FREE_BYTES &&
         after_dma_largest >= NUWAX_LIVE_AEC_POST_MIN_DMA_LARGEST_BYTES);
    if (err == ESP_OK && !reserve_ok) {
        err = ESP_ERR_NO_MEM;
    }
    if (err != ESP_OK) {
        ESP_LOGE(TAG,
                 "live AEC production rebuild failed after diagnostic capture err=%s reserve_ok=%d delay_samples=%lu frame_samples=%u internal=%u largest=%u dma=%u/%u",
                 esp_err_to_name(err),
                 reserve_ok ? 1 : 0,
                 (unsigned long)production_delay_samples,
                 (unsigned)frame_samples,
                 (unsigned)after_internal,
                 (unsigned)after_largest,
                 (unsigned)after_dma,
                 (unsigned)after_dma_largest);
        return err;
    }
    ESP_LOGI(TAG,
             "live AEC production state rebuilt after diagnostic capture configured=%d initialized=%d reserve_ok=%d delay_samples=%lu frame_samples=%u internal=%u largest=%u dma=%u/%u",
             configured ? 1 : 0,
             aec->initialized ? 1 : 0,
             reserve_ok ? 1 : 0,
             (unsigned long)aec->delay_samples,
             (unsigned)frame_samples,
             (unsigned)after_internal,
             (unsigned)after_largest,
             (unsigned)after_dma,
             (unsigned)after_dma_largest);
    return ESP_OK;
}

static void conversation_live_aec_pool_release(nuwax_live_aec_t *aec,
                                                 bool acquired,
                                                 esp_err_t reusable_status) {
    if (!aec) {
        return;
    }
    if (!acquired) {
        nuwax_live_aec_deinit(aec);
        return;
    }
    if (reusable_status != ESP_OK) {
        nuwax_live_aec_deinit(aec);
        portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
        memset(&s_conversation_live_aec_pool, 0,
               sizeof(s_conversation_live_aec_pool));
        s_conversation_live_aec_pool_initialized = false;
        s_conversation_live_aec_pool_initializing = false;
        s_conversation_live_aec_pool_available = false;
        s_conversation_live_aec_pool_status = reusable_status;
        s_conversation_live_aec_pool_in_use = false;
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        atomic_store_explicit(&s_conversation_live_aec_degraded, true,
                              memory_order_release);
        ESP_LOGE(TAG,
                 "conversation live AEC pool invalidated err=%s; next recovery may initialize it again",
                 esp_err_to_name(reusable_status));
        return;
    }
    if (!nuwax_awake_session_state_is_active(&s_awake_session) ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        nuwax_live_aec_deinit(aec);
        memset(aec, 0, sizeof(*aec));
        portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
        memset(&s_conversation_live_aec_pool, 0,
               sizeof(s_conversation_live_aec_pool));
        s_conversation_live_aec_pool_initialized = false;
        s_conversation_live_aec_pool_initializing = false;
        s_conversation_live_aec_pool_available = false;
        s_conversation_live_aec_pool_status = ESP_ERR_INVALID_STATE;
        s_conversation_live_aec_pool_in_use = false;
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        ESP_LOGI(TAG,
                 "conversation live AEC pool released after capture reason=%s",
                 atomic_load_explicit(&s_reprovision_quiesce_requested,
                                      memory_order_acquire)
                     ? "ble_provisioning"
                     : "sleep");
        return;
    }
    s_conversation_live_aec_pool = *aec;
    memset(aec, 0, sizeof(*aec));
    portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
    s_conversation_live_aec_pool_in_use = false;
    portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
}

static void metrics_mark_speech_detected(void) {
    if (s_conversation_metrics.active && s_conversation_metrics.speech_detected_ms == 0) {
        s_conversation_metrics.speech_detected_ms = monotonic_ms();
    }
}

static void metrics_mark_upload_start(void) {
    if (s_conversation_metrics.active && s_conversation_metrics.upload_start_ms == 0) {
        s_conversation_metrics.upload_start_ms = monotonic_ms();
    }
}

static void metrics_mark_upload_done(uint32_t uploaded_frames) {
    if (s_conversation_metrics.active) {
        s_conversation_metrics.upload_done_ms = monotonic_ms();
        s_conversation_metrics.uploaded_frames = uploaded_frames;
    }
}

static void metrics_mark_asr_partial(void) {
    if (s_conversation_metrics.active && s_conversation_metrics.asr_first_partial_ms == 0) {
        s_conversation_metrics.asr_first_partial_ms = monotonic_ms();
    }
}

static void metrics_mark_asr_final(void) {
    if (s_conversation_metrics.active && s_conversation_metrics.asr_final_ms == 0) {
        s_conversation_metrics.asr_final_ms = monotonic_ms();
    }
}

static void metrics_mark_asr_result(bool ok) {
    if (!s_conversation_metrics.active) {
        return;
    }
    s_conversation_metrics.asr_result_ms = monotonic_ms();
    if (!ok) {
        ESP_LOGI(TAG,
                 "conversation metrics no_asr seq=%lu mode=%s prelisten_to_upload_ms=%ld upload_to_result_ms=%ld frames=%lu",
                 (unsigned long)s_conversation_metrics.seq,
                 s_conversation_metrics.mode,
                 (long)metrics_delta_ms(s_conversation_metrics.prelisten_start_ms, s_conversation_metrics.upload_start_ms),
                 (long)metrics_delta_ms(s_conversation_metrics.upload_done_ms, s_conversation_metrics.asr_result_ms),
                 (unsigned long)s_conversation_metrics.uploaded_frames);
    }
}

static void metrics_mark_text_response(void) {
    if (s_conversation_metrics.active && s_conversation_metrics.text_response_ms == 0) {
        s_conversation_metrics.text_response_ms = monotonic_ms();
    }
}

static void metrics_mark_tts_start(uint32_t ws_epoch,
                                   uint32_t turn_epoch,
                                   uint32_t speaker_generation) {
    if (s_conversation_metrics.active && s_conversation_metrics.tts_start_ms == 0) {
        if (ws_epoch == 0U || turn_epoch == 0U || speaker_generation == 0U) {
            ESP_LOGW(TAG,
                     "conversation metrics TTS owner missing seq=%lu ws=%lu turn=%lu speaker=%lu",
                     (unsigned long)s_conversation_metrics.seq,
                     (unsigned long)ws_epoch,
                     (unsigned long)turn_epoch,
                     (unsigned long)speaker_generation);
            return;
        }
        if ((s_conversation_metrics.owner_ws_epoch != 0U &&
             s_conversation_metrics.owner_ws_epoch != ws_epoch) ||
            (s_conversation_metrics.owner_turn_epoch != 0U &&
             s_conversation_metrics.owner_turn_epoch != turn_epoch) ||
            (s_conversation_metrics.owner_speaker_generation != 0U &&
             s_conversation_metrics.owner_speaker_generation !=
                 speaker_generation)) {
            ESP_LOGW(TAG,
                     "conversation metrics stale TTS ignored seq=%lu owner=%lu/%lu/%lu event=%lu/%lu/%lu",
                     (unsigned long)s_conversation_metrics.seq,
                     (unsigned long)s_conversation_metrics.owner_ws_epoch,
                     (unsigned long)s_conversation_metrics.owner_turn_epoch,
                     (unsigned long)s_conversation_metrics
                         .owner_speaker_generation,
                     (unsigned long)ws_epoch,
                     (unsigned long)turn_epoch,
                     (unsigned long)speaker_generation);
            return;
        }
        s_conversation_metrics.owner_ws_epoch = ws_epoch;
        s_conversation_metrics.owner_turn_epoch = turn_epoch;
        s_conversation_metrics.owner_speaker_generation = speaker_generation;
        s_conversation_metrics.tts_start_ms = monotonic_ms();
        ESP_LOGI(TAG,
                 "conversation metrics tts_start seq=%lu mode=%s speech_to_tts_ms=%ld asr_final_to_tts_ms=%ld text_to_tts_ms=%ld",
                 (unsigned long)s_conversation_metrics.seq,
                 s_conversation_metrics.mode,
                 (long)metrics_delta_ms(s_conversation_metrics.speech_detected_ms, s_conversation_metrics.tts_start_ms),
                 (long)metrics_delta_ms(s_conversation_metrics.asr_final_ms, s_conversation_metrics.tts_start_ms),
                 (long)metrics_delta_ms(s_conversation_metrics.text_response_ms, s_conversation_metrics.tts_start_ms));
    }
}

static void metrics_mark_playback_done(uint32_t ws_epoch,
                                       uint32_t turn_epoch,
                                       uint32_t speaker_generation,
                                       uint32_t played_frames,
                                       uint32_t write_failures) {
    if (!s_conversation_metrics.active) {
        return;
    }
    if (s_conversation_metrics.tts_start_ms == 0U ||
        s_conversation_metrics.owner_ws_epoch != ws_epoch ||
        s_conversation_metrics.owner_turn_epoch != turn_epoch ||
        s_conversation_metrics.owner_speaker_generation !=
            speaker_generation) {
        ESP_LOGW(TAG,
                 "conversation metrics stale playback completion ignored seq=%lu owner=%lu/%lu/%lu event=%lu/%lu/%lu",
                 (unsigned long)s_conversation_metrics.seq,
                 (unsigned long)s_conversation_metrics.owner_ws_epoch,
                 (unsigned long)s_conversation_metrics.owner_turn_epoch,
                 (unsigned long)s_conversation_metrics
                     .owner_speaker_generation,
                 (unsigned long)ws_epoch,
                 (unsigned long)turn_epoch,
                 (unsigned long)speaker_generation);
        return;
    }
    s_conversation_metrics.playback_done_ms = monotonic_ms();
    s_conversation_metrics.played_frames = played_frames;
    s_conversation_metrics.playback_failures = write_failures;
    ESP_LOGI(TAG,
             "conversation metrics done seq=%lu mode=%s prelisten_to_speech_ms=%ld speech_to_upload_ms=%ld upload_audio_ms=%ld upload_to_asr_partial_ms=%ld upload_to_asr_final_ms=%ld asr_final_to_text_ms=%ld text_to_tts_ms=%ld tts_playback_ms=%ld total_ms=%ld uploaded_frames=%lu played_frames=%lu write_failures=%lu",
             (unsigned long)s_conversation_metrics.seq,
             s_conversation_metrics.mode,
             (long)metrics_delta_ms(s_conversation_metrics.prelisten_start_ms, s_conversation_metrics.speech_detected_ms),
             (long)metrics_delta_ms(s_conversation_metrics.speech_detected_ms, s_conversation_metrics.upload_start_ms),
             (long)metrics_delta_ms(s_conversation_metrics.upload_start_ms, s_conversation_metrics.upload_done_ms),
             (long)metrics_delta_ms(s_conversation_metrics.upload_done_ms, s_conversation_metrics.asr_first_partial_ms),
             (long)metrics_delta_ms(s_conversation_metrics.upload_done_ms, s_conversation_metrics.asr_final_ms),
             (long)metrics_delta_ms(s_conversation_metrics.asr_final_ms, s_conversation_metrics.text_response_ms),
             (long)metrics_delta_ms(s_conversation_metrics.text_response_ms, s_conversation_metrics.tts_start_ms),
             (long)metrics_delta_ms(s_conversation_metrics.tts_start_ms, s_conversation_metrics.playback_done_ms),
             (long)metrics_delta_ms(s_conversation_metrics.prelisten_start_ms, s_conversation_metrics.playback_done_ms),
             (unsigned long)s_conversation_metrics.uploaded_frames,
             (unsigned long)s_conversation_metrics.played_frames,
             (unsigned long)s_conversation_metrics.playback_failures);
    s_conversation_metrics.active = false;
}

static void conversation_state_snapshot(nuwax_app_state_t *state_out,
                                        uint32_t *generation_out,
                                        uint32_t *idle_since_ms_out) {
    portENTER_CRITICAL(&s_conversation_state_lock);
    if (state_out) {
        *state_out = nuwax_conversation_state_current(&s_conversation_state);
    }
    if (generation_out) {
        *generation_out = nuwax_conversation_state_generation(&s_conversation_state);
    }
    if (idle_since_ms_out) {
        *idle_since_ms_out = nuwax_conversation_state_idle_since_ms(&s_conversation_state);
    }
    portEXIT_CRITICAL(&s_conversation_state_lock);
}

static nuwax_app_state_t conversation_state_current(void) {
    nuwax_app_state_t state = NUWAX_APP_STATE_BOOTING;
    conversation_state_snapshot(&state, NULL, NULL);
    return state;
}

static esp_err_t initialize_v28_ui_with_retry(bool provisioning_face) {
    esp_err_t last_err = ESP_FAIL;
    ui_ready_store(false);

    for (uint32_t attempt = 1U;
         attempt <= NUWAX_UI_STARTUP_MAX_ATTEMPTS;
         attempt++) {
        if (!nuwax_lvgl_port_lock(NUWAX_UI_STARTUP_LOCK_TIMEOUT_MS)) {
            last_err = ESP_ERR_TIMEOUT;
            ESP_LOGW(TAG,
                     "V28 UI startup attempt=%lu/%lu LVGL lock timeout",
                     (unsigned long)attempt,
                     (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS);
        } else {
            esp_err_t ui_err = nuwax_app_create_with_provisioning_face(
                lv_screen_active(), provisioning_face);
            if (ui_err == ESP_OK) {
                esp_err_t shell_err = nuwax_app_shell_init();
                if (shell_err == ESP_OK) {
                    nuwax_app_state_t initial_ui_state =
                        NUWAX_APP_STATE_BOOTING;
                    uint32_t initial_ui_generation = 0U;
                    conversation_state_snapshot(&initial_ui_state,
                                                &initial_ui_generation,
                                                NULL);
                    nuwax_state_bridge_update(initial_ui_state);
                    portENTER_CRITICAL(&s_conversation_state_lock);
                    (void)nuwax_ui_sync_complete(&s_ui_state_sync,
                                                 initial_ui_state,
                                                 initial_ui_generation);
                    portEXIT_CRITICAL(&s_conversation_state_lock);
#if CONFIG_NUWAX_SPEAKER_ENABLE
                    nuwax_app_shell_set_volume_percent(
                        nuwax_speaker_playback_get_volume_percent());
#endif
                    /* The panel retains the boot logo until the complete UI
                     * and listeners are ready. Opening the output gate forces
                     * a full-screen repaint so no logo pixels remain. */
                    nuwax_lvgl_port_set_panel_output_enabled(true);
                    nuwax_lvgl_port_unlock();
                    ui_ready_store(true);
                    ESP_LOGI(TAG,
                             "V28 UI startup completed attempt=%lu/%lu",
                             (unsigned long)attempt,
                             (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS);
                    return ESP_OK;
                }

                last_err = shell_err;
                ESP_LOGE(TAG,
                         "V28 UI shell startup failed attempt=%lu/%lu: %s",
                         (unsigned long)attempt,
                         (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS,
                         esp_err_to_name(shell_err));
                esp_err_t cleanup_err = nuwax_app_deinit();
                if (cleanup_err != ESP_OK) {
                    ESP_LOGE(TAG,
                             "V28 UI shell rollback incomplete attempt=%lu/%lu: %s",
                             (unsigned long)attempt,
                             (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS,
                             esp_err_to_name(cleanup_err));
                    last_err = cleanup_err;
                }
            } else {
                last_err = ui_err;
                ESP_LOGW(TAG,
                         "V28 UI create failed attempt=%lu/%lu: %s",
                         (unsigned long)attempt,
                         (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS,
                         esp_err_to_name(ui_err));
            }
            nuwax_lvgl_port_unlock();
        }

        if (attempt < NUWAX_UI_STARTUP_MAX_ATTEMPTS) {
            const uint32_t retry_delay_ms =
                NUWAX_UI_STARTUP_RETRY_BASE_MS * attempt;
            vTaskDelay(pdMS_TO_TICKS(retry_delay_ms));
        }
    }

    ui_ready_store(false);
    ESP_LOGE(TAG,
             "V28 UI startup exhausted %lu attempts: %s",
             (unsigned long)NUWAX_UI_STARTUP_MAX_ATTEMPTS,
             esp_err_to_name(last_err));
    return last_err;
}

static nuwax_app_state_t head_touch_get_conversation_state(void *user_ctx) {
    (void)user_ctx;
    return conversation_state_current();
}

static bool head_touch_interaction_allowed(void *user_ctx) {
    (void)user_ctx;
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        return false;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio()) {
        return false;
    }
#endif
    return !exclusive_audio_mode_blocks_normal_audio();
}

static uint32_t conversation_state_generation(void) {
    uint32_t generation = 0;
    conversation_state_snapshot(NULL, &generation, NULL);
    return generation;
}

static bool set_state_logical(nuwax_app_state_t state,
                              uint32_t *generation_out,
                              bool log_change) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool speaker_guard_candidate =
        state == NUWAX_APP_STATE_IDLE ||
        state == NUWAX_APP_STATE_LISTENING ||
        state == NUWAX_APP_STATE_THINKING;
    const bool speaker_pending =
        speaker_guard_candidate && nuwax_speaker_playback_has_pending();
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    if (speaker_pending) {
        nuwax_speaker_playback_get_stats(&speaker_stats);
    }
#else
    const bool speaker_pending = false;
#endif

    uint32_t generation = 0;
    uint32_t now_ms = monotonic_ms();
    portENTER_CRITICAL(&s_conversation_state_lock);
    const nuwax_app_state_t current_state =
        nuwax_conversation_state_current(&s_conversation_state);
    if (speaker_pending && current_state == NUWAX_APP_STATE_SPEAKING) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        const uint32_t current_generation =
            nuwax_conversation_state_generation(&s_conversation_state);
        nuwax_deferred_state_submit(
            &s_deferred_speaker_state,
            state,
            current_generation,
            speaker_stats.submitted_generation,
            speaker_stats.submitted_connection_epoch);
#endif
        portEXIT_CRITICAL(&s_conversation_state_lock);
        ESP_LOGI(TAG,
                 "state defer requested=%s current=%s reason=speaker_active speaker_generation=%lu epoch=%lu",
                 nuwax_app_state_name(state),
                 nuwax_app_state_name(current_state),
#if CONFIG_NUWAX_SPEAKER_ENABLE
                 (unsigned long)speaker_stats.submitted_generation,
                 (unsigned long)speaker_stats.submitted_connection_epoch
#else
                 0UL,
                 0UL
#endif
        );
        return false;
    }
    const bool changed =
        nuwax_conversation_state_set(&s_conversation_state, state, now_ms, &generation);
    if (changed) {
        nuwax_deferred_state_clear(&s_deferred_speaker_state);
        nuwax_ui_sync_submit(&s_ui_state_sync, state, generation);
    } else if (state == NUWAX_APP_STATE_LISTENING &&
               current_state == NUWAX_APP_STATE_LISTENING) {
        /* LISTENING is also a visual generation boundary. Reassert it even
         * when the logical enum is unchanged so an already-copied old cloud
         * emotion and its deadline cannot survive into the next listen turn. */
        generation =
            nuwax_conversation_state_generation(&s_conversation_state);
        nuwax_ui_sync_submit(&s_ui_state_sync, state, generation);
    } else {
        if (!s_ui_state_sync.pending ||
            nuwax_conversation_state_current(&s_conversation_state) != state) {
            portEXIT_CRITICAL(&s_conversation_state_lock);
            return false;
        }
        generation = nuwax_conversation_state_generation(&s_conversation_state);
    }
    if (generation_out) {
        *generation_out = generation;
    }
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (changed && log_change) {
        ESP_LOGI(TAG, "state=%s", nuwax_app_state_name(state));
    }
    return true;
}

static bool invalidate_all_pending_semantic_emotions(const char *reason) {
    bool cancelled = false;
    uint32_t invalidated_through_revision = 0U;
    portENTER_CRITICAL(&s_emotion_ui_lock);
    cancelled = s_emotion_ui_sync.pending;
    /* Always advance the generation. A UI task may already have copied the
     * previous pending value even when pending is false by the time this owner
     * observes it. The bridge fence prevents that snapshot from publishing
     * after the new lifecycle boundary. */
    nuwax_emotion_ui_invalidate(&s_emotion_ui_sync);
    invalidated_through_revision = s_emotion_ui_sync.revision;
    portEXIT_CRITICAL(&s_emotion_ui_lock);
    nuwax_state_bridge_invalidate_semantic_revisions_through(
        invalidated_through_revision);
    if (cancelled) {
        ESP_LOGI(TAG,
                 "all pending semantic emotions invalidated revision=%lu reason=%s",
                 (unsigned long)invalidated_through_revision,
                 reason ? reason : "-");
    }
    return cancelled;
}

static bool app_state_blocks_semantic_emotion(nuwax_app_state_t state) {
    switch (state) {
        case NUWAX_APP_STATE_BOOTING:
        case NUWAX_APP_STATE_WIFI_CONNECTING:
        case NUWAX_APP_STATE_WS_CONNECTING:
        case NUWAX_APP_STATE_LISTENING:
        case NUWAX_APP_STATE_SLEEPING:
        case NUWAX_APP_STATE_ERROR:
            return true;
        case NUWAX_APP_STATE_IDLE:
        case NUWAX_APP_STATE_THINKING:
        case NUWAX_APP_STATE_SPEAKING:
            return false;
        default:
            return true;
    }
}

static void clear_tts_skip_emotion_window(const char *reason) {
    if (!s_tts_skip_emotion_window.active) {
        return;
    }
    ESP_LOGI(TAG,
             "tts_skip emotion window cleared reason=%s epoch=%lu",
             reason ? reason : "-",
             (unsigned long)s_tts_skip_emotion_window.ws_epoch);
    /* Only this window owns the no-TTS semantic lease. Clearing it at the
     * next user turn prevents the previous answer's face from leaking into
     * the new utterance. */
    nuwax_state_bridge_clear_semantic_emotion_if_owner(
        "device_command_tts_skip", 0U);
    memset(&s_tts_skip_emotion_window, 0,
           sizeof(s_tts_skip_emotion_window));
}

static void clear_tts_skip_prebound_emotion(const char *reason) {
    if (!s_tts_skip_prebound_emotion.active) {
        return;
    }
    ESP_LOGI(TAG,
             "tts_skip prebound emotion cleared reason=%s turn=%s",
             reason ? reason : "-",
             s_tts_skip_prebound_emotion.turn_id[0]
                 ? s_tts_skip_prebound_emotion.turn_id
                 : "-");
    memset(&s_tts_skip_prebound_emotion,
           0,
           sizeof(s_tts_skip_prebound_emotion));
}

static bool tts_skip_prebind_owner_eligible(const char *turn_id,
                                             bool *out_direct_post_end) {
    const bool has_turn_id = turn_id && turn_id[0] != '\0';
    if (s_tts_skip_emotion_window.active ||
        active_ws_epoch_snapshot() == 0U ||
        nuwax_awake_session_state_generation(&s_awake_session) == 0U ||
        s_sleep_transaction.active ||
        exclusive_audio_mode_blocks_normal_audio()) {
        return false;
    }
    const nuwax_app_state_t state = conversation_state_current();
    if (state != NUWAX_APP_STATE_THINKING &&
        state != NUWAX_APP_STATE_LISTENING) {
        return false;
    }

    const bool turn_guard_owner =
        s_turn_guard.active &&
        (s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TEXT ||
         s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TTS ||
         s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TTS_RETRY) &&
        s_turn_guard.turn_id[0] != '\0' &&
        (!has_turn_id || strcmp(s_turn_guard.turn_id, turn_id) == 0);
    const bool direct_post_end_owner =
        !s_turn_guard.active &&
        nuwax_listen_resume_state_can_bootstrap_cloud_turn(
            &s_listen_resume,
            nuwax_awake_session_state_generation(&s_awake_session),
            active_ws_epoch_snapshot(),
            atomic_load_explicit(&s_conversation_capture_runtime_active,
                                 memory_order_acquire));
    if (!turn_guard_owner && !direct_post_end_owner) {
        return false;
    }
    if (out_direct_post_end) {
        *out_direct_post_end = direct_post_end_owner;
    }
    return true;
}

static void remember_tts_skip_prebound_emotion(
    const char *emotion,
    bool has_duration_ms,
    uint32_t duration_ms,
    const char *request_id,
    const char *turn_id,
    bool direct_post_end) {
    if (!emotion || emotion[0] == '\0') {
        return;
    }
    const char *bound_turn_id =
        (turn_id && turn_id[0] != '\0')
            ? turn_id
            : (s_turn_guard.active ? s_turn_guard.turn_id : "");
    if ((!bound_turn_id || bound_turn_id[0] == '\0') && !direct_post_end) {
        return;
    }
    memset(&s_tts_skip_prebound_emotion,
           0,
           sizeof(s_tts_skip_prebound_emotion));
    s_tts_skip_prebound_emotion.active = true;
    s_tts_skip_prebound_emotion.has_duration_ms = has_duration_ms;
    s_tts_skip_prebound_emotion.direct_post_end = direct_post_end;
    s_tts_skip_prebound_emotion.ws_epoch = active_ws_epoch_snapshot();
    s_tts_skip_prebound_emotion.awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    s_tts_skip_prebound_emotion.turn_guard_epoch =
        s_turn_guard.active ? s_turn_guard.epoch : 0U;
    s_tts_skip_prebound_emotion.deadline_ms =
        monotonic_ms() + NUWAX_TTS_SKIP_EMOTION_WINDOW_MS;
    s_tts_skip_prebound_emotion.duration_ms = duration_ms;
    snprintf(s_tts_skip_prebound_emotion.request_id,
             sizeof(s_tts_skip_prebound_emotion.request_id),
             "%s",
             request_id ? request_id : "");
    snprintf(s_tts_skip_prebound_emotion.turn_id,
             sizeof(s_tts_skip_prebound_emotion.turn_id),
             "%s",
             bound_turn_id ? bound_turn_id : "");
    snprintf(s_tts_skip_prebound_emotion.emotion,
             sizeof(s_tts_skip_prebound_emotion.emotion),
             "%s",
             emotion);
    ESP_LOGI(TAG,
             "tts_skip prebound emotion stored emotion=%s turn=%s guard_epoch=%lu direct_post_end=%d window_ms=%u",
             emotion,
             bound_turn_id && bound_turn_id[0] ? bound_turn_id : "-",
             (unsigned long)s_tts_skip_prebound_emotion.turn_guard_epoch,
             direct_post_end ? 1 : 0,
             (unsigned)NUWAX_TTS_SKIP_EMOTION_WINDOW_MS);
}

static bool take_tts_skip_prebound_emotion(
    const nuwax_session_command_t *tts_skip,
    uint32_t ws_epoch,
    uint32_t awake_generation,
    bool direct_post_end,
    nuwax_tts_skip_prebound_emotion_t *out) {
    if (out) {
        memset(out, 0, sizeof(*out));
    }
    if (!s_tts_skip_prebound_emotion.active) {
        return false;
    }
    const uint32_t now_ms = monotonic_ms();
    if (s_tts_skip_prebound_emotion.ws_epoch != ws_epoch ||
        s_tts_skip_prebound_emotion.awake_generation != awake_generation ||
        elapsed_ms(now_ms, s_tts_skip_prebound_emotion.deadline_ms)) {
        clear_tts_skip_prebound_emotion("owner_or_deadline_mismatch");
        return false;
    }

    bool identity_match = false;
    if (tts_skip && tts_skip->turn_id[0] != '\0' &&
        s_tts_skip_prebound_emotion.turn_id[0] != '\0') {
        identity_match =
            strcmp(s_tts_skip_prebound_emotion.turn_id,
                   tts_skip->turn_id) == 0;
    } else if (s_tts_skip_prebound_emotion.turn_guard_epoch != 0U &&
               s_turn_guard.active &&
               s_tts_skip_prebound_emotion.turn_guard_epoch ==
                   s_turn_guard.epoch) {
        identity_match = true;
    } else if (s_tts_skip_prebound_emotion.direct_post_end &&
               direct_post_end) {
        identity_match = true;
    }
    if (!identity_match) {
        return false;
    }
    if (out) {
        *out = s_tts_skip_prebound_emotion;
    }
    memset(&s_tts_skip_prebound_emotion,
           0,
           sizeof(s_tts_skip_prebound_emotion));
    return true;
}

static void arm_tts_skip_emotion_window(uint32_t ws_epoch,
                                        uint32_t awake_generation) {
    if (ws_epoch == 0U || awake_generation == 0U) {
        clear_tts_skip_emotion_window("invalid_owner");
        return;
    }
    if (s_tts_skip_emotion_window.active) {
        clear_tts_skip_emotion_window("rearmed");
    }
    memset(&s_tts_skip_emotion_window, 0,
           sizeof(s_tts_skip_emotion_window));
    s_tts_skip_emotion_window.active = true;
    s_tts_skip_emotion_window.ws_epoch = ws_epoch;
    s_tts_skip_emotion_window.awake_generation = awake_generation;
    s_tts_skip_emotion_window.deadline_ms =
        monotonic_ms() + NUWAX_TTS_SKIP_EMOTION_WINDOW_MS;
    ESP_LOGI(TAG,
             "tts_skip emotion window armed epoch=%lu awake_generation=%lu window_ms=%u",
             (unsigned long)ws_epoch,
             (unsigned long)awake_generation,
             (unsigned)NUWAX_TTS_SKIP_EMOTION_WINDOW_MS);
}

static void arm_tts_skip_followup(bool capture_will_stop) {
    if (!s_tts_skip_emotion_window.active) {
        return;
    }
    s_tts_skip_emotion_window.followup_pending = true;
    s_tts_skip_emotion_window.emotion_accepted = false;
    s_tts_skip_emotion_window.capture_will_stop = capture_will_stop;
    s_tts_skip_emotion_window.visual_deadline_ms = 0U;
    ESP_LOGI(TAG,
             "tts_skip follow-up held for cloud emotion capture_will_stop=%d fallback_ms=%u",
             capture_will_stop ? 1 : 0,
             (unsigned)NUWAX_TTS_SKIP_EMOTION_WINDOW_MS);
}

static void note_tts_skip_emotion_accepted(void) {
    if (!s_tts_skip_emotion_window.active ||
        !s_tts_skip_emotion_window.followup_pending) {
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    if (active_ws_epoch_snapshot() != s_tts_skip_emotion_window.ws_epoch ||
        nuwax_awake_session_state_generation(&s_awake_session) !=
            s_tts_skip_emotion_window.awake_generation) {
        clear_tts_skip_emotion_window("emotion_owner_changed");
        return;
    }
    s_tts_skip_emotion_window.emotion_accepted = true;
    s_tts_skip_emotion_window.visual_deadline_ms =
        now_ms + NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS;
    ESP_LOGI(TAG,
             "tts_skip cloud emotion accepted; delaying listening hold_ms=%u",
             (unsigned)NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS);
}

static bool tts_skip_emotion_window_accepts(void) {
    if (!s_tts_skip_emotion_window.active) {
        return false;
    }
    const uint32_t now_ms = monotonic_ms();
    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (active_epoch != s_tts_skip_emotion_window.ws_epoch ||
        awake_generation != s_tts_skip_emotion_window.awake_generation ||
        elapsed_ms(now_ms, s_tts_skip_emotion_window.deadline_ms)) {
        clear_tts_skip_emotion_window("owner_or_deadline_mismatch");
        return false;
    }
    return true;
}

static void cancel_pending_semantic_emotion_for_state(
    nuwax_app_state_t state) {
    if (!app_state_blocks_semantic_emotion(state)) {
        return;
    }

    clear_tts_skip_emotion_window("lifecycle_transition");

    /* These states own the whole face, not only the current cloud turn.
     * Standalone set_emotion commands queued before the transition must not
     * override listening, sleep, connection, boot or error visuals. */
    (void)invalidate_all_pending_semantic_emotions(
        nuwax_app_state_name(state));
}

static void set_state_deferred_ui(nuwax_app_state_t state) {
    if (set_state_logical(state, NULL, true)) {
        cancel_pending_semantic_emotion_for_state(state);
        notify_ui_owner();
    }
}

static void set_state(nuwax_app_state_t state) {
    uint32_t generation = 0;
    if (!set_state_logical(state, &generation, true)) {
        return;
    }
    cancel_pending_semantic_emotion_for_state(state);
    if (ui_ready_snapshot()) {
        bool current = false;
        portENTER_CRITICAL(&s_conversation_state_lock);
        current = generation == nuwax_conversation_state_generation(&s_conversation_state) &&
                  state == nuwax_conversation_state_current(&s_conversation_state) &&
                  nuwax_ui_sync_matches(&s_ui_state_sync, state, generation);
        portEXIT_CRITICAL(&s_conversation_state_lock);
        if (current) {
            nuwax_state_bridge_update(state);
            portENTER_CRITICAL(&s_conversation_state_lock);
            (void)nuwax_ui_sync_complete(&s_ui_state_sync, state, generation);
            portEXIT_CRITICAL(&s_conversation_state_lock);
        } else {
            ESP_LOGI(TAG,
                     "state ui update skipped stale state=%s generation=%lu current_generation=%lu",
                     nuwax_app_state_name(state),
                     (unsigned long)generation,
                     (unsigned long)conversation_state_generation());
        }
    }
}

static bool cloud_waiting_question_has_liveness_owner(void) {
    return nuwax_listen_resume_state_is_waiting_post_end_asr(
               &s_listen_resume) ||
           (s_turn_guard.active && s_turn_guard.deadline_ms != 0U) ||
           nuwax_audio_terminal_recovery_pending();
}

static bool enter_cloud_waiting_question(const char *reason) {
    if (!cloud_waiting_question_has_liveness_owner()) {
        nuwax_state_bridge_clear_waiting_question();
        ESP_LOGE(TAG,
                 "cloud wait rejected without liveness owner reason=%s state=%s",
                 reason ? reason : "-",
                 nuwax_app_state_name(conversation_state_current()));
        return false;
    }
    nuwax_state_bridge_start_waiting_question();
    set_state(NUWAX_APP_STATE_THINKING);
    ESP_LOGI(TAG, "cloud wait entered visual=question reason=%s",
             reason ? reason : "-");
    return true;
}

static void observe_ws_owner_cleanup_result(nuwax_ws_client_t *ws,
                                            esp_err_t result,
                                            const char *context) {
    if (!ws) {
        return;
    }
    const bool resources_released =
        nuwax_ws_owner_resources_released(ws);
    const bool transport_connected = nuwax_ws_is_connected(ws);
    const uint32_t epoch = nuwax_ws_connection_epoch(ws);
    const bool heartbeat_healthy = transport_connected && epoch != 0U &&
        nuwax_ws_heartbeat_healthy_if_epoch(ws, epoch);
    const uint32_t failures_before =
        s_ws_owner_close_recovery.consecutive_failures;
    const bool restart_required =
        nuwax_ws_owner_close_recovery_observe(
            &s_ws_owner_close_recovery,
            resources_released,
            transport_connected,
            heartbeat_healthy);

    if (resources_released) {
        if (failures_before != 0U) {
            ESP_LOGI(TAG,
                     "WebSocket owner cleanup recovered context=%s previous_failures=%lu",
                     context ? context : "-",
                     (unsigned long)failures_before);
        }
        return;
    }
    if (transport_connected || heartbeat_healthy) {
        ESP_LOGW(TAG,
                 "WebSocket owner cleanup escalation suppressed for active transport context=%s result=%s connected=%d heartbeat_healthy=%d",
                 context ? context : "-",
                 esp_err_to_name(result),
                 transport_connected ? 1 : 0,
                 heartbeat_healthy ? 1 : 0);
        return;
    }

    ESP_LOGE(TAG,
             "WebSocket inactive owner resources retained context=%s stage=%d result=%s failures=%lu/%u lifecycle=%d rx_task=%p rx_running=%d rx_buffer=%p",
             context ? context : "-",
             (int)nuwax_ws_owner_close_failure_stage(ws),
             esp_err_to_name(result),
             (unsigned long)s_ws_owner_close_recovery.consecutive_failures,
             (unsigned)NUWAX_WS_OWNER_CLOSE_RESTART_FAILURES,
             (int)nuwax_ws_lifecycle_state(ws),
             ws->rx_task,
             atomic_load_explicit(&ws->rx_task_running,
                                  memory_order_acquire) ? 1 : 0,
             ws->rx_buffer);
    if (!restart_required) {
        return;
    }

    ESP_LOGE(TAG,
             "WebSocket owner cleanup failed repeatedly while transport is inactive; controlled restart prevents permanent reconnect livelock");
    set_state(NUWAX_APP_STATE_ERROR);
    nuwax_diagnostics_log_heap_label(TAG, "ws_owner_cleanup_restart");
    vTaskDelay(pdMS_TO_TICKS(100));
    esp_restart();
    vTaskDelay(portMAX_DELAY);
}

static void service_deferred_speaker_state(void) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    if (speaker_stats.pending) {
        return;
    }

    nuwax_deferred_state_pending_t snapshot = {0};
    nuwax_app_state_t current_state = NUWAX_APP_STATE_BOOTING;
    uint32_t current_generation = 0U;
    portENTER_CRITICAL(&s_conversation_state_lock);
    snapshot = s_deferred_speaker_state;
    if (snapshot.pending) {
        current_state =
            nuwax_conversation_state_current(&s_conversation_state);
        current_generation =
            nuwax_conversation_state_generation(&s_conversation_state);
        nuwax_deferred_state_clear(&s_deferred_speaker_state);
    }
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (!snapshot.pending) {
        return;
    }

    if (!nuwax_deferred_state_owner_matches(
            &snapshot,
            current_state,
            current_generation,
            speaker_stats.submitted_generation,
            speaker_stats.submitted_connection_epoch,
            active_ws_epoch_snapshot())) {
        ESP_LOGI(TAG,
                 "stale deferred state discarded requested=%s state=%s conversation_generation=%lu/%lu speaker_generation=%lu/%lu epoch=%lu/%lu",
                 nuwax_app_state_name(snapshot.state),
                 nuwax_app_state_name(current_state),
                 (unsigned long)snapshot.conversation_generation,
                 (unsigned long)current_generation,
                 (unsigned long)snapshot.speaker_generation,
                 (unsigned long)speaker_stats.submitted_generation,
                 (unsigned long)snapshot.connection_epoch,
                 (unsigned long)speaker_stats.submitted_connection_epoch);
        return;
    }

    ESP_LOGI(TAG,
             "applying deferred state requested=%s speaker_generation=%lu epoch=%lu",
             nuwax_app_state_name(snapshot.state),
             (unsigned long)snapshot.speaker_generation,
             (unsigned long)snapshot.connection_epoch);
    set_state(snapshot.state);
#endif
}

RTC_DATA_ATTR static uint32_t s_boot_failure_restart_streak;

static void __attribute__((noreturn)) boot_fail_controlled_restart(
    const char *reason) {
    set_state(NUWAX_APP_STATE_ERROR);
    if (s_boot_failure_restart_streak < UINT32_MAX) {
        s_boot_failure_restart_streak++;
    }
    uint32_t shift = s_boot_failure_restart_streak > 0U
                         ? s_boot_failure_restart_streak - 1U
                         : 0U;
    if (shift > NUWAX_BOOT_FAILURE_RESTART_MAX_SHIFT) {
        shift = NUWAX_BOOT_FAILURE_RESTART_MAX_SHIFT;
    }
    uint32_t delay_ms = NUWAX_BOOT_FAILURE_RESTART_BASE_MS << shift;
    if (delay_ms > NUWAX_BOOT_FAILURE_RESTART_MAX_MS) {
        delay_ms = NUWAX_BOOT_FAILURE_RESTART_MAX_MS;
    }
    ESP_LOGE(TAG,
             "boot supervisor controlled restart reason=%s streak=%lu delay_ms=%lu",
             reason ? reason : "unknown",
             (unsigned long)s_boot_failure_restart_streak,
             (unsigned long)delay_ms);
    nuwax_diagnostics_log_heap_label(TAG, "boot_supervisor_restart");
    vTaskDelay(pdMS_TO_TICKS(delay_ms));
    esp_restart();
    vTaskDelay(portMAX_DELAY);
}

/* Cloud transport retries must not overwrite the local sleep barrier. The
 * cloud icon still reports CONNECTING, while the conversation lifecycle
 * remains sleeping (or quiescing) until a valid local wake resets the
 * transaction. */
static void set_cloud_transport_connecting_state(const char *reason) {
    const nuwax_app_state_t current = conversation_state_current();
    const bool sleep_owned =
        s_sleep_transaction.active ||
        s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING ||
        current == NUWAX_APP_STATE_SLEEPING;
    const bool awake_reconnect_owned =
        s_awake_resume_after_ws_reconnect &&
        nuwax_awake_session_state_is_active(&s_awake_session);
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_CONNECTING);
    if (sleep_owned || awake_reconnect_owned) {
        ESP_LOGI(TAG,
                 "cloud transport connecting preserved conversation state=%s sleep_txn=%s active=%d awake_reconnect=%d reason=%s",
                 nuwax_app_state_name(current),
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 s_sleep_transaction.active ? 1 : 0,
                 awake_reconnect_owned ? 1 : 0,
                 reason ? reason : "-");
        return;
    }
    set_state(NUWAX_APP_STATE_WS_CONNECTING);
}

/* Network recovery changes status indicators, but it must not take ownership
 * of the local conversation lifecycle while a sleep transaction is active. */
static void set_wifi_transport_connecting_state(const char *reason) {
    const nuwax_app_state_t current = conversation_state_current();
    const bool sleep_owned =
        s_sleep_transaction.active ||
        s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING ||
        current == NUWAX_APP_STATE_SLEEPING;
    const bool awake_reconnect_owned =
        s_awake_resume_after_ws_reconnect &&
        nuwax_awake_session_state_is_active(&s_awake_session);
    nuwax_app_shell_set_wifi_connecting("RECOVER");
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_DISCONNECTED);
    if (sleep_owned || awake_reconnect_owned) {
        ESP_LOGI(TAG,
                 "Wi-Fi recovery preserved conversation state=%s sleep_txn=%s active=%d awake_reconnect=%d reason=%s",
                 nuwax_app_state_name(current),
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 s_sleep_transaction.active ? 1 : 0,
                 awake_reconnect_owned ? 1 : 0,
                 reason ? reason : "-");
        return;
    }
    set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
}

static void sync_pending_ui_state(void) {
    if (!ui_ready_snapshot()) {
        return;
    }
    nuwax_app_state_t state = NUWAX_APP_STATE_BOOTING;
    uint32_t generation = 0;
    portENTER_CRITICAL(&s_conversation_state_lock);
    const bool pending = s_ui_state_sync.pending;
    if (pending) {
        state = s_ui_state_sync.state;
        generation = s_ui_state_sync.generation;
    }
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (!pending) {
        return;
    }
    bool current = false;
    portENTER_CRITICAL(&s_conversation_state_lock);
    current = nuwax_ui_sync_matches(&s_ui_state_sync, state, generation) &&
              generation == nuwax_conversation_state_generation(&s_conversation_state) &&
              state == nuwax_conversation_state_current(&s_conversation_state);
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (current) {
        nuwax_state_bridge_update(state);
        portENTER_CRITICAL(&s_conversation_state_lock);
        (void)nuwax_ui_sync_complete(&s_ui_state_sync, state, generation);
        portEXIT_CRITICAL(&s_conversation_state_lock);
        ESP_LOGI(TAG, "state=%s deferred_ui=1", nuwax_app_state_name(state));
    }
}

/* Meeting and monitoring are controller-owned strong UI states. Publish them
 * from one task so callback and recovery paths cannot reorder mailbox writes.
 * Comparing both controller state and UI lifetime keeps the steady-state path
 * cheap while guaranteeing that a rebuilt UI receives the current mode. */
static void sync_exclusive_audio_mode_ui_state(void) {
    static uint32_t published_ui_generation = UINT32_MAX;
    static nuwax_meeting_state_t published_meeting =
        (nuwax_meeting_state_t)-1;
    static nuwax_monitoring_state_t published_monitoring =
        (nuwax_monitoring_state_t)-1;

    if (!ui_ready_snapshot()) {
        return;
    }

    const uint32_t ui_generation = (uint32_t)atomic_load_explicit(
        &s_ui_lifecycle_generation, memory_order_acquire);
    if (published_ui_generation != ui_generation) {
        published_ui_generation = ui_generation;
        published_meeting = (nuwax_meeting_state_t)-1;
        published_monitoring = (nuwax_monitoring_state_t)-1;
    }

    nuwax_meeting_state_t meeting =
        nuwax_meeting_mode_state(&s_meeting_mode);
    nuwax_monitoring_state_t monitoring =
        nuwax_monitoring_mode_state(&s_monitoring_mode);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    /* Controllers reset on disconnect; the lease is intent, not evidence of
     * recording. A scheduled reader can still fail MIC or storage admission.
     * Preserve the normal online controller states above, including no-card
     * operation, and project only the disconnected owner here. */
    if (meeting == NUWAX_MEETING_STATE_DISABLED &&
        monitoring == NUWAX_MONITORING_STATE_DISABLED &&
        (offline_mode_lease_pending() ||
        nuwax_meeting_mode_offline_resume_pending(&s_meeting_mode) ||
        nuwax_monitoring_mode_offline_resume_pending(&s_monitoring_mode) ||
        nuwax_offline_audio_capture_running())) {
        const bool monitoring_resume =
            nuwax_monitoring_mode_offline_resume_pending(&s_monitoring_mode);
        const bool meeting_resume =
            nuwax_meeting_mode_offline_resume_pending(&s_meeting_mode);
        const nuwax_offline_capture_health_t health =
            nuwax_offline_audio_capture_health();
        const bool recording = nuwax_offline_audio_capture_running() &&
            nuwax_offline_capture_health_is_recording(health);
        const bool starting = nuwax_offline_audio_capture_running() &&
            health == NUWAX_OFFLINE_CAPTURE_STARTING;
        const bool stopping = !offline_mode_lease_pending() &&
            !monitoring_resume && !meeting_resume;
        if (monitoring_resume || (!meeting_resume && offline_mode_kind() ==
            NUWAX_OFFLINE_AUDIO_MODE_MONITORING)) {
            monitoring = stopping ? NUWAX_MONITORING_STATE_STOPPING :
                recording ? NUWAX_MONITORING_STATE_ACTIVE :
                starting ? NUWAX_MONITORING_STATE_STARTING : NUWAX_MONITORING_STATE_ERROR;
            meeting = NUWAX_MEETING_STATE_DISABLED;
        } else {
            meeting = stopping ? NUWAX_MEETING_STATE_STOPPING :
                recording ? NUWAX_MEETING_STATE_ACTIVE :
                starting ? NUWAX_MEETING_STATE_STARTING : NUWAX_MEETING_STATE_ERROR;
            monitoring = NUWAX_MONITORING_STATE_DISABLED;
        }
    }
#endif
    if (published_meeting != meeting) {
        nuwax_app_shell_set_meeting_state((nuwax_meeting_ui_state_t)meeting);
        published_meeting = meeting;
        ESP_LOGI(TAG,
                 "meeting UI reconciled controller_state=%d ui_generation=%lu",
                 (int)meeting,
                 (unsigned long)ui_generation);
    }
    if (published_monitoring != monitoring) {
        nuwax_app_shell_set_monitoring_state(
            (nuwax_monitoring_ui_state_t)monitoring);
        published_monitoring = monitoring;
        ESP_LOGI(TAG,
                 "monitoring UI reconciled controller_state=%d ui_generation=%lu",
                 (int)monitoring,
                 (unsigned long)ui_generation);
    }
}

static void sync_pending_semantic_emotion(void) {
    if (!ui_ready_snapshot()) {
        return;
    }

    /* First-PCM and the shell can both publish. Do not block the audio owner,
     * and keep the claim until stale-owner rollback has finished. A later UI
     * tick will consume any replacement submitted while this claim is held. */
    static atomic_flag publishing = ATOMIC_FLAG_INIT;
    if (atomic_flag_test_and_set_explicit(&publishing, memory_order_acquire)) {
        return;
    }

    nuwax_emotion_ui_pending_t snapshot = {0};
    portENTER_CRITICAL(&s_emotion_ui_lock);
    snapshot = s_emotion_ui_sync;
    portEXIT_CRITICAL(&s_emotion_ui_lock);
    if (!snapshot.pending) {
        atomic_flag_clear_explicit(&publishing, memory_order_release);
        return;
    }

    bool current = false;
    portENTER_CRITICAL(&s_emotion_ui_lock);
    current = nuwax_emotion_ui_matches(&s_emotion_ui_sync,
                                       snapshot.revision);
    portEXIT_CRITICAL(&s_emotion_ui_lock);

    bool ok = false;
    bool still_current = false;
    if (current) {
        const bool refreshed = snapshot.finite_lease &&
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING &&
            nuwax_state_bridge_refresh_semantic_emotion_name_owned_lease(
                snapshot.emotion,
                snapshot.source,
                snapshot.revision,
                snapshot.duration_ms);
        ok = refreshed ||
            nuwax_state_bridge_set_semantic_emotion_name_owned_leased(
                snapshot.emotion,
                snapshot.source,
                snapshot.revision,
                snapshot.duration_ms,
                snapshot.finite_lease);
        portENTER_CRITICAL(&s_emotion_ui_lock);
        still_current = nuwax_emotion_ui_revision_current(&s_emotion_ui_sync,
                                                 snapshot.revision);
        if (ok && still_current) {
            (void)nuwax_emotion_ui_complete(&s_emotion_ui_sync,
                                            snapshot.revision);
        }
        portEXIT_CRITICAL(&s_emotion_ui_lock);
        if (ok && !still_current) {
            const bool rolled_back =
                nuwax_state_bridge_clear_semantic_emotion_if_owner(
                    snapshot.source, snapshot.revision);
            ESP_LOGI(TAG,
                     "stale semantic emotion publish rolled back source=%s emotion=%s revision=%lu cleared=%d",
                     snapshot.source[0] ? snapshot.source : "-",
                     snapshot.emotion,
                     (unsigned long)snapshot.revision,
                     rolled_back ? 1 : 0);
        }
    }

    if (current) {
        ESP_LOGI(TAG,
                 "semantic emotion applied source=%s emotion=%s revision=%lu ok=%d",
                 snapshot.source[0] ? snapshot.source : "-",
                 snapshot.emotion,
                 (unsigned long)snapshot.revision,
                 ok ? 1 : 0);
    }
    atomic_flag_clear_explicit(&publishing, memory_order_release);
}

static bool apply_semantic_emotion_name(const char *emotion, const char *source) {
    if (!emotion || emotion[0] == '\0') {
        return false;
    }
    if (!nuwax_state_bridge_is_semantic_emotion_name_supported(emotion)) {
        ESP_LOGW(TAG,
                 "semantic emotion rejected before queue emotion=%s source=%s",
                 emotion,
                 source ? source : "-");
        return false;
    }

    uint32_t revision = 0;
    portENTER_CRITICAL(&s_emotion_ui_lock);
    revision = nuwax_emotion_ui_submit(&s_emotion_ui_sync,
                                       emotion,
                                       source ? source : "-");
    portEXIT_CRITICAL(&s_emotion_ui_lock);
    ESP_LOGI(TAG,
             "semantic emotion queued source=%s emotion=%s revision=%lu ui_ready=%d",
             source ? source : "-",
             emotion,
             (unsigned long)revision,
             ui_ready_snapshot() ? 1 : 0);
    if (revision != 0U) {
        notify_ui_owner();
    }
    return revision != 0;
}

static bool apply_semantic_emotion_name_leased(const char *emotion,
                                                const char *source,
                                                uint32_t duration_ms) {
    if (!emotion || emotion[0] == '\0' || duration_ms == 0U ||
        !nuwax_state_bridge_is_semantic_emotion_name_supported(emotion)) {
        return false;
    }
    uint32_t revision = 0U;
    portENTER_CRITICAL(&s_emotion_ui_lock);
    revision = nuwax_emotion_ui_submit_leased(&s_emotion_ui_sync,
                                              emotion,
                                              source ? source : "-",
                                              duration_ms,
                                              true);
    portEXIT_CRITICAL(&s_emotion_ui_lock);
    ESP_LOGI(TAG,
             "leased semantic emotion queued source=%s emotion=%s duration_ms=%lu revision=%lu ui_ready=%d",
             source ? source : "-",
             emotion,
             (unsigned long)duration_ms,
             (unsigned long)revision,
             ui_ready_snapshot() ? 1 : 0);
    if (revision != 0U) {
        notify_ui_owner();
    }
    return revision != 0U;
}

/* Sleep remains the lifecycle owner while a cloud activity expression is
 * shown. Bind the finite lease to the exact sleep generation so a concurrent
 * wake transition cannot leak the expression into the listening lifecycle. */
static bool apply_sleep_cloud_emotion_name(const char *emotion,
                                           const char *source) {
    if (!emotion || emotion[0] == '\0' ||
        !nuwax_state_bridge_is_semantic_emotion_name_supported(emotion)) {
        return false;
    }

    uint32_t sleep_generation = 0U;
    portENTER_CRITICAL(&s_conversation_state_lock);
    const bool sleeping =
        nuwax_conversation_state_current(&s_conversation_state) ==
        NUWAX_APP_STATE_SLEEPING;
    if (sleeping) {
        sleep_generation =
            nuwax_conversation_state_generation(&s_conversation_state);
    }
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (!sleeping) {
        return false;
    }

    const char *owner_source = source ? source : "device_command_sleep";
    uint32_t revision = 0U;
    portENTER_CRITICAL(&s_emotion_ui_lock);
    revision = nuwax_emotion_ui_submit_leased(
        &s_emotion_ui_sync,
        emotion,
        owner_source,
        NUWAX_SLEEP_CLOUD_EMOTION_HOLD_MS,
        true);
    portEXIT_CRITICAL(&s_emotion_ui_lock);
    if (revision == 0U) {
        return false;
    }

    portENTER_CRITICAL(&s_conversation_state_lock);
    const bool sleep_owner_current =
        nuwax_conversation_state_current(&s_conversation_state) ==
            NUWAX_APP_STATE_SLEEPING &&
        nuwax_conversation_state_generation(&s_conversation_state) ==
            sleep_generation;
    portEXIT_CRITICAL(&s_conversation_state_lock);
    if (!sleep_owner_current) {
        uint32_t invalidated_through_revision = revision;
        portENTER_CRITICAL(&s_emotion_ui_lock);
        if (nuwax_emotion_ui_matches(&s_emotion_ui_sync, revision)) {
            nuwax_emotion_ui_invalidate(&s_emotion_ui_sync);
            invalidated_through_revision = s_emotion_ui_sync.revision;
        }
        portEXIT_CRITICAL(&s_emotion_ui_lock);
        nuwax_state_bridge_invalidate_semantic_revisions_through(
            invalidated_through_revision);
        const bool rolled_back =
            nuwax_state_bridge_clear_semantic_emotion_if_owner(
                owner_source, revision);
        ESP_LOGI(TAG,
                 "sleep cloud emotion canceled by lifecycle transition emotion=%s revision=%lu sleep_generation=%lu current_state=%s current_generation=%lu rolled_back=%d",
                 emotion,
                 (unsigned long)revision,
                 (unsigned long)sleep_generation,
                 nuwax_app_state_name(conversation_state_current()),
                 (unsigned long)conversation_state_generation(),
                 rolled_back ? 1 : 0);
        return false;
    }

    ESP_LOGI(TAG,
             "sleep cloud emotion queued emotion=%s source=%s hold_ms=%u state_generation=%lu revision=%lu",
             emotion,
             owner_source,
             (unsigned)NUWAX_SLEEP_CLOUD_EMOTION_HOLD_MS,
             (unsigned long)sleep_generation,
             (unsigned long)revision);
    notify_ui_owner();
    return true;
}

static bool phase_equals_local(const char *a, const char *b) {
    if (!a || !b) {
        return false;
    }
    while (*a && *b) {
        char ca = *a;
        char cb = *b;
        if (ca >= 'A' && ca <= 'Z') {
            ca = (char)(ca - 'A' + 'a');
        }
        if (cb >= 'A' && cb <= 'Z') {
            cb = (char)(cb - 'A' + 'a');
        }
        if (ca != cb) {
            return false;
        }
        ++a;
        ++b;
    }
    return *a == '\0' && *b == '\0';
}

static bool conversation_phase_deferred_by_speaker(const char *phase) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!phase || !nuwax_speaker_playback_has_pending()) {
        return false;
    }
    return phase_equals_local(phase, "listening") ||
           phase_equals_local(phase, "recognizing") ||
           phase_equals_local(phase, "thinking") ||
           phase_equals_local(phase, "final") ||
           phase_equals_local(phase, "answer") ||
           phase_equals_local(phase, "response");
#else
    (void)phase;
    return false;
#endif
}

static void set_conversation_status_guarded(const char *title,
                                            const char *phase,
                                            const char *text,
                                            bool show_now) {
    if (conversation_phase_deferred_by_speaker(phase)) {
        ESP_LOGI(TAG,
                 "conversation phase defer phase=%s reason=speaker_active",
                 phase ? phase : "-");
        return;
    }
    nuwax_app_shell_set_conversation_status(title, phase, text, show_now);
}

static void clear_auto_followup(const char *reason) {
    if (s_prelisten.pending) {
        ESP_LOGI(TAG, "conversation auto follow-up cleared reason=%s", reason ? reason : "-");
    }
    nuwax_prelisten_state_clear(&s_prelisten);
}

static void cancel_auto_followup_capture(const char *reason) {
    const bool was_pending = s_prelisten.pending;
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGI(TAG,
                 "conversation prelisten cancel requested reason=%s pending=%d active=%d",
                 reason ? reason : "-",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
    }
    nuwax_prelisten_state_request_cancel(&s_prelisten);
    if (was_pending) {
        ESP_LOGI(TAG, "conversation auto follow-up cleared reason=%s", reason ? reason : "cancel");
    }
}

static void clear_last_listen_resume(void) {
    nuwax_listen_resume_state_clear(&s_listen_resume);
}

static void notify_wake_supervisor(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (s_wake_supervisor_task) {
        xTaskNotifyGive(s_wake_supervisor_task);
    }
#endif
}

static void wake_word_detected_callback(
    const nuwax_wake_word_result_t *result,
    void *user_ctx);

static esp_err_t init_wake_model_serialized(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    volatile uint8_t stack_probe = 0U;
    if (!esp_ptr_in_dram((const void *)&stack_probe)) {
        /* esp_srmodel_init() maps the model partition and freezes the external
         * memory cache. ESP-IDF requires the active stack to remain accessible
         * while the cache is frozen, so a PSRAM-stack caller must fail before
         * entering the model loader instead of triggering a system assert. */
        ESP_LOGE(TAG,
                 "wake model init rejected: current task stack is not internal DRAM probe=%p",
                 (const void *)&stack_probe);
        return ESP_ERR_INVALID_STATE;
    }
    if (!s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "wake model init ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }
    const esp_err_t result = nuwax_wake_word_detector_init(
        wake_word_detected_callback, NULL);
    xSemaphoreGive(s_wake_model_operation_mutex);
    return result;
#else
    return ESP_OK;
#endif
}

static esp_err_t start_wake_model_serialized(
    const nuwax_wake_arm_context_t *context) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!context || !s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_ARG;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "wake model start ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }

    esp_err_t result = ESP_ERR_NOT_FINISHED;
    if (!atomic_load_explicit(&s_reprovision_quiesce_requested,
                              memory_order_acquire)) {
        /* Model construction belongs to app_main's internal-DRAM stack. This
         * helper can run on the PSRAM-backed supervisor stack and therefore
         * must only start an already constructed detector. The lifecycle lock
         * still prevents provisioning deinit from racing detector start. */
        result = nuwax_wake_word_detector_start_with_context(context);
    }
    xSemaphoreGive(s_wake_model_operation_mutex);
    return result;
#else
    (void)context;
    return ESP_OK;
#endif
}

static esp_err_t deinit_wake_model_serialized(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!s_wake_model_operation_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(
            s_wake_model_operation_mutex,
            pdMS_TO_TICKS(NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS)) !=
        pdTRUE) {
        ESP_LOGE(TAG,
                 "wake model deinit ownership timed out timeout_ms=%u",
                 (unsigned)NUWAX_WAKE_MODEL_OPERATION_LOCK_TIMEOUT_MS);
        return ESP_ERR_TIMEOUT;
    }
    nuwax_wake_word_detector_deinit();
    const bool still_running = nuwax_wake_word_detector_is_running();
    xSemaphoreGive(s_wake_model_operation_mutex);
    if (still_running) {
        ESP_LOGE(TAG,
                 "wake model deinit returned while detector task still owns resources");
        return ESP_ERR_INVALID_STATE;
    }
    return ESP_OK;
#else
    return ESP_OK;
#endif
}

static esp_err_t request_wake_model_restore(uint32_t timeout_ms) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!atomic_load_explicit(&s_cloud_owner_ready, memory_order_acquire) ||
        !s_wake_model_restore_mutex ||
        timeout_ms == 0U) {
        return ESP_ERR_INVALID_STATE;
    }

    const uint32_t started_ms = monotonic_ms();
    const uint32_t deadline_ms = started_ms + timeout_ms;
    if (xSemaphoreTake(s_wake_model_restore_mutex,
                       pdMS_TO_TICKS(timeout_ms)) != pdTRUE) {
        ESP_LOGE(TAG,
                 "wake model restore request serialization timed out timeout_ms=%lu",
                 (unsigned long)timeout_ms);
        return ESP_ERR_TIMEOUT;
    }

    uint_fast32_t generation = atomic_load_explicit(
        &s_wake_model_restore_requested, memory_order_acquire);
    const uint_fast32_t completed = atomic_load_explicit(
        &s_wake_model_restore_completed, memory_order_acquire);
    if (generation == completed) {
        generation++;
        if (generation == 0U) {
            generation = 1U;
        }
        atomic_store_explicit(&s_wake_model_restore_result,
                              ESP_ERR_NOT_FINISHED,
                              memory_order_relaxed);
        atomic_store_explicit(&s_wake_model_restore_requested,
                              generation,
                              memory_order_release);
    } else {
        ESP_LOGW(TAG,
                 "wake model restore joining in-flight generation=%lu",
                 (unsigned long)generation);
    }

    while ((uint_fast32_t)atomic_load_explicit(
               &s_wake_model_restore_completed, memory_order_acquire) !=
           generation) {
        if (elapsed_ms(monotonic_ms(), deadline_ms)) {
            ESP_LOGE(TAG,
                     "wake model restore timed out generation=%lu timeout_ms=%lu",
                     (unsigned long)generation,
                     (unsigned long)timeout_ms);
            xSemaphoreGive(s_wake_model_restore_mutex);
            return ESP_ERR_TIMEOUT;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    const esp_err_t result = (esp_err_t)atomic_load_explicit(
        &s_wake_model_restore_result, memory_order_acquire);
    xSemaphoreGive(s_wake_model_restore_mutex);
    return result;
#else
    (void)timeout_ms;
    return ESP_OK;
#endif
}

static bool queue_wake_model_restore_nonblocking(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!s_wake_model_restore_mutex ||
        xSemaphoreTake(s_wake_model_restore_mutex, 0) != pdTRUE) {
        return false;
    }

    uint_fast32_t requested = atomic_load_explicit(
        &s_wake_model_restore_requested, memory_order_acquire);
    const uint_fast32_t completed = atomic_load_explicit(
        &s_wake_model_restore_completed, memory_order_acquire);
    bool scheduled = false;
    if (requested == completed) {
        requested++;
        if (requested == 0U) {
            requested = 1U;
        }
        atomic_store_explicit(&s_wake_model_restore_result,
                              ESP_ERR_NOT_FINISHED,
                              memory_order_relaxed);
        atomic_store_explicit(&s_wake_model_restore_requested,
                              requested,
                              memory_order_release);
        scheduled = true;
    }
    xSemaphoreGive(s_wake_model_restore_mutex);
    if (scheduled) {
        ESP_LOGW(TAG,
                 "wake model restore queued generation=%lu reason=%s owner=app_main_internal_stack",
                 (unsigned long)requested,
                 reason ? reason : "-");
    }
    return scheduled || requested != completed;
#else
    (void)reason;
    return false;
#endif
}

static bool service_wake_model_restore_owner(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    const uint_fast32_t requested = atomic_load_explicit(
        &s_wake_model_restore_requested, memory_order_acquire);
    const uint_fast32_t completed = atomic_load_explicit(
        &s_wake_model_restore_completed, memory_order_acquire);
    if (requested == 0U || requested == completed) {
        return false;
    }

    /* This service is owned exclusively by app_main, whose configured 16 KB
     * stack is internal DRAM. Check both ownership and memory placement before
     * any ESP-SR Flash mapping operation. */
    const TaskHandle_t expected_owner = atomic_load_explicit(
        &s_conversation_owner_task, memory_order_acquire);
    const bool owner_ok = expected_owner != NULL &&
                          expected_owner == xTaskGetCurrentTaskHandle();
    esp_err_t restore_result = ESP_ERR_INVALID_STATE;
    if (owner_ok) {
        restore_result = init_wake_model_serialized();
    } else {
        ESP_LOGE(TAG,
                 "wake model restore rejected: caller is not app_main owner expected=%p actual=%p",
                 expected_owner,
                 xTaskGetCurrentTaskHandle());
    }
    const UBaseType_t stack_min_free = uxTaskGetStackHighWaterMark(NULL);
    atomic_store_explicit(&s_wake_model_restore_result,
                          restore_result,
                          memory_order_release);
    atomic_store_explicit(&s_wake_model_restore_completed,
                          requested,
                          memory_order_release);
    ESP_LOGI(TAG,
             "wake model restore completed generation=%lu result=%s owner=app_main stack_min_free=%u configured=%u",
             (unsigned long)requested,
             esp_err_to_name(restore_result),
             (unsigned)stack_min_free,
             (unsigned)CONFIG_ESP_MAIN_TASK_STACK_SIZE);
    notify_wake_supervisor();
    return true;
#else
    return false;
#endif
}

static uint32_t next_wake_detector_token_locked(void) {
    s_wake_detector_next_token++;
    if (s_wake_detector_next_token == 0U) {
        s_wake_detector_next_token = 1U;
    }
    return s_wake_detector_next_token;
}

static nuwax_wake_arm_context_t wake_detector_request_snapshot(
    int64_t *first_pcm_us) {
    nuwax_wake_arm_context_t request = {0};
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    request = s_wake_detector_request;
    if (first_pcm_us) {
        *first_pcm_us = s_wake_interrupt_first_pcm_us;
    }
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    return request;
}

static bool wake_detector_request_is_playback(void) {
    const nuwax_wake_arm_context_t request =
        wake_detector_request_snapshot(NULL);
    return atomic_load_explicit(&s_wake_detector_desired,
                                memory_order_acquire) &&
           request.mode == NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT;
}

static void __attribute__((unused)) request_playback_wake_word_detector(
    uint32_t ws_epoch,
    uint32_t speaker_generation,
    const char *turn_id,
    const char *playback_id,
    const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
    if (s_deferred_sleep_intent.active) {
        ESP_LOGI(TAG,
                 "playback wake detector suppressed by sleep-after-playback intent token=%lu generation=%lu",
                 (unsigned long)s_deferred_sleep_intent.token,
                 (unsigned long)speaker_generation);
        return;
    }
    if (ws_epoch == 0U || speaker_generation == 0U ||
        !turn_id || !turn_id[0] || !playback_id || !playback_id[0] ||
        exclusive_audio_mode_blocks_normal_audio() ||
        ota_blocks_wake_detector()) {
        return;
    }
    bool changed = false;
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    const bool same =
        atomic_load_explicit(&s_wake_detector_desired,
                             memory_order_relaxed) &&
        s_wake_detector_request.mode ==
            NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT &&
        s_wake_detector_request.ws_epoch == ws_epoch &&
        s_wake_detector_request.speaker_generation == speaker_generation &&
        s_wake_detector_request.playback_owner ==
            NUWAX_WAKE_PLAYBACK_OWNER_CONVERSATION &&
        strcmp(s_wake_detector_request.turn_id, turn_id) == 0 &&
        strcmp(s_wake_detector_request.playback_id, playback_id) == 0;
    if (!same) {
        memset(&s_wake_detector_request, 0,
               sizeof(s_wake_detector_request));
        s_wake_detector_request.mode =
            NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT;
        s_wake_detector_request.mode_token =
            next_wake_detector_token_locked();
        s_wake_detector_request.ws_epoch = ws_epoch;
        s_wake_detector_request.speaker_generation = speaker_generation;
        s_wake_detector_request.playback_owner =
            NUWAX_WAKE_PLAYBACK_OWNER_CONVERSATION;
        strlcpy(s_wake_detector_request.turn_id,
                turn_id,
                sizeof(s_wake_detector_request.turn_id));
        strlcpy(s_wake_detector_request.playback_id,
                playback_id,
                sizeof(s_wake_detector_request.playback_id));
        s_wake_interrupt_first_pcm_us = 0;
        changed = true;
    }
    const uint32_t token = s_wake_detector_request.mode_token;
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    atomic_store_explicit(&s_wake_detector_desired, true,
                          memory_order_release);
    if (changed) {
        atomic_store_explicit(&s_wake_detector_request_ms,
                              monotonic_ms(),
                              memory_order_release);
        if (nuwax_wake_word_detector_is_running()) {
            nuwax_wake_word_detector_request_stop();
        }
        ESP_LOGI(TAG,
                 "playback wake detector requested token=%lu ws_epoch=%lu generation=%lu turn=%s playback=%s reason=%s shadow=%d",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 (unsigned long)speaker_generation,
                 turn_id,
                 playback_id,
                 reason ? reason : "-",
                 CONFIG_NUWAX_WAKE_WORD_INTERRUPT_SHADOW_ONLY ? 1 : 0);
    }
    notify_wake_supervisor();
#else
    (void)ws_epoch;
    (void)speaker_generation;
    (void)turn_id;
    (void)playback_id;
    (void)reason;
#endif
}

static void request_notification_playback_wake_word_detector(
    uint32_t ws_epoch,
    uint32_t speaker_generation,
    const char *notify_id,
    const char *playback_id,
    const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
    if (ws_epoch == 0U || speaker_generation == 0U || !notify_id ||
        !notify_id[0] || !playback_id || !playback_id[0] ||
        exclusive_audio_mode_blocks_normal_audio() ||
        ota_blocks_wake_detector()) {
        return;
    }
    bool changed = false;
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    const bool same =
        atomic_load_explicit(&s_wake_detector_desired,
                             memory_order_relaxed) &&
        s_wake_detector_request.mode ==
            NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT &&
        s_wake_detector_request.playback_owner ==
            NUWAX_WAKE_PLAYBACK_OWNER_NOTIFICATION &&
        s_wake_detector_request.ws_epoch == ws_epoch &&
        s_wake_detector_request.speaker_generation == speaker_generation &&
        strcmp(s_wake_detector_request.notify_id, notify_id) == 0 &&
        strcmp(s_wake_detector_request.playback_id, playback_id) == 0;
    if (!same) {
        memset(&s_wake_detector_request,
               0,
               sizeof(s_wake_detector_request));
        s_wake_detector_request.mode =
            NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT;
        s_wake_detector_request.mode_token =
            next_wake_detector_token_locked();
        s_wake_detector_request.ws_epoch = ws_epoch;
        s_wake_detector_request.speaker_generation = speaker_generation;
        s_wake_detector_request.playback_owner =
            NUWAX_WAKE_PLAYBACK_OWNER_NOTIFICATION;
        strlcpy(s_wake_detector_request.notify_id,
                notify_id,
                sizeof(s_wake_detector_request.notify_id));
        strlcpy(s_wake_detector_request.playback_id,
                playback_id,
                sizeof(s_wake_detector_request.playback_id));
        s_wake_interrupt_first_pcm_us = 0;
        changed = true;
    }
    const uint32_t token = s_wake_detector_request.mode_token;
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    atomic_store_explicit(&s_wake_detector_desired,
                          true,
                          memory_order_release);
    if (changed) {
        atomic_store_explicit(&s_wake_detector_request_ms,
                              monotonic_ms(),
                              memory_order_release);
        if (nuwax_wake_word_detector_is_running()) {
            nuwax_wake_word_detector_request_stop();
        }
        ESP_LOGI(TAG,
                 "notification wake detector requested token=%lu epoch=%lu generation=%lu notify=%s playback=%s reason=%s",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 (unsigned long)speaker_generation,
                 notify_id,
                 playback_id,
                 reason ? reason : "-");
    }
    notify_wake_supervisor();
#else
    (void)ws_epoch;
    (void)speaker_generation;
    (void)notify_id;
    (void)playback_id;
    (void)reason;
#endif
}

static bool __attribute__((unused)) arm_playback_wake_word_detector(
    uint32_t ws_epoch,
    uint32_t speaker_generation,
    int64_t first_pcm_us) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
    if (s_deferred_sleep_intent.active) {
        return false;
    }
    bool armed = false;
    uint32_t token = 0U;
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    if (first_pcm_us > 0 &&
        s_wake_detector_request.mode ==
            NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT &&
        s_wake_detector_request.ws_epoch == ws_epoch &&
        s_wake_detector_request.speaker_generation == speaker_generation) {
        s_wake_interrupt_first_pcm_us = first_pcm_us;
        token = s_wake_detector_request.mode_token;
        armed = true;
    }
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    if (armed) {
        ESP_LOGI(TAG,
                 "playback wake detector armed token=%lu ws_epoch=%lu generation=%lu first_pcm_us=%lld",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 (unsigned long)speaker_generation,
                 (long long)first_pcm_us);
    }
    return armed;
#else
    (void)ws_epoch;
    (void)speaker_generation;
    (void)first_pcm_us;
    return false;
#endif
}

static void request_sleep_wake_word_detector(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (ota_blocks_wake_detector()) {
        return;
    }
    bool changed = false;
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    const bool same =
        atomic_load_explicit(&s_wake_detector_desired,
                             memory_order_relaxed) &&
        s_wake_detector_request.mode == NUWAX_WAKE_MODE_SLEEP;
    if (!same) {
        memset(&s_wake_detector_request, 0,
               sizeof(s_wake_detector_request));
        s_wake_detector_request.mode = NUWAX_WAKE_MODE_SLEEP;
        s_wake_detector_request.mode_token =
            next_wake_detector_token_locked();
        /* Sleep detection is local. The hit callback binds its event to the
         * currently authenticated connection; a queued old hit is still
         * rejected at consumption after a reconnect. Do not restart I2S just
         * because the transport changed from offline to online. Playback
         * interrupt requests remain bound to epoch + speaker generation. */
        s_wake_detector_request.ws_epoch = 0U;
        s_wake_interrupt_first_pcm_us = 0;
        changed = true;
    }
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    atomic_store_explicit(&s_wake_detector_desired, true,
                          memory_order_release);
    if (changed) {
        atomic_store_explicit(&s_wake_detector_request_ms,
                              monotonic_ms(),
                              memory_order_release);
        if (nuwax_wake_word_detector_is_running()) {
            nuwax_wake_word_detector_request_stop();
        }
        ESP_LOGI(TAG,
                 "wake detector requested reason=%s",
                 reason ? reason : "-");
    }
    notify_wake_supervisor();
#else
    (void)reason;
#endif
}

static void service_ota_wake_detector_recovery(void)
{
#if CONFIG_NUWAX_OTA_ENABLE && CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!atomic_load_explicit(&s_ota_wake_restore_pending,
                              memory_order_acquire)) {
        return;
    }
    /* Keep the marker until the OTA controller has released its audio
     * interlock. Successful OTA reboots, while every non-reboot terminal
     * result converges here without depending on an incidental wait-loop. */
    if (nuwax_ota_device_is_active()) {
        return;
    }
    if (s_power_shutdown_requested ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        exclusive_audio_mode_blocks_normal_audio() ||
        nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        /* A stronger owner has taken the microphone lifecycle. It will
         * perform its own wake handoff; do not resurrect the OTA snapshot
         * after that owner releases. */
        if (s_power_shutdown_requested ||
            atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            atomic_store_explicit(&s_ota_wake_restore_pending, false,
                                  memory_order_release);
        }
        return;
    }

    const nuwax_app_state_t state = conversation_state_current();
    if (state == NUWAX_APP_STATE_LISTENING ||
        state == NUWAX_APP_STATE_THINKING ||
        state == NUWAX_APP_STATE_SPEAKING) {
        /* A new conversation owner superseded the OTA snapshot. */
        atomic_store_explicit(&s_ota_wake_restore_pending, false,
                              memory_order_release);
        return;
    }

    if (state == NUWAX_APP_STATE_WS_CONNECTING &&
        cloud_service_is_ready()) {
        /* Cloud-ready recovery must converge the connecting lifecycle before
         * the ordinary sleep recovery path can own wake admission. */
        request_sleeping_conversation_state("ota_failed_wake_restore");
    } else {
        request_sleep_wake_word_detector("ota_failed_wake_restore");
    }
    atomic_store_explicit(&s_ota_wake_restore_pending, false,
                          memory_order_release);
    ESP_LOGI(TAG,
             "wake detector restored after non-reboot OTA result state=%s",
             nuwax_app_state_name(state));
#endif
}

static void inhibit_sleep_wake_word_detector(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    const bool was_desired = atomic_exchange_explicit(
        &s_wake_detector_desired, false, memory_order_acq_rel);
    portENTER_CRITICAL(&s_wake_detector_request_lock);
    memset(&s_wake_detector_request, 0, sizeof(s_wake_detector_request));
    s_wake_detector_request.mode = NUWAX_WAKE_MODE_OFF;
    s_wake_detector_request.mode_token = next_wake_detector_token_locked();
    s_wake_interrupt_first_pcm_us = 0;
    portEXIT_CRITICAL(&s_wake_detector_request_lock);
    if (was_desired) {
        ESP_LOGI(TAG,
                 "wake detector inhibited reason=%s",
                 reason ? reason : "-");
    }
    notify_wake_supervisor();
#else
    (void)reason;
#endif
}

static bool wait_for_sleep_wake_word_ready(uint32_t timeout_ms) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    const uint32_t deadline_ms = monotonic_ms() + timeout_ms;
    while (!nuwax_wake_word_detector_is_ready() &&
           atomic_load_explicit(&s_wake_detector_desired,
                                memory_order_acquire) &&
           !elapsed_ms(monotonic_ms(), deadline_ms)) {
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    return nuwax_wake_word_detector_is_ready();
#else
    (void)timeout_ms;
    return true;
#endif
}

static void wake_word_detected_callback(
    const nuwax_wake_word_result_t *result,
    void *user_ctx) {
    (void)user_ctx;
    if (!result) {
        return;
    }
    if (ota_blocks_wake_detector()) {
        inhibit_sleep_wake_word_detector("ota_audio_block");
        nuwax_wake_word_detector_request_stop();
        return;
    }
    /* Final hits stop the detector in the worker. Probe events deliberately do
     * not: they only lower the bound playback volume and let MultiNet continue
     * until it produces a confirmed, generation-checked hit. */
    const bool playback_interrupt =
        result->arm.mode == NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT;
    if (!playback_interrupt) {
        inhibit_sleep_wake_word_detector("wake_word_detected");
    }
    if (!cloud_service_is_ready()) {
        ESP_LOGI(TAG,
                 "wake word ignored while cloud unavailable word=%s; rearming detector",
                 result->wake_word[0] ? result->wake_word : "-");
        if (playback_interrupt) {
            inhibit_sleep_wake_word_detector(
                "offline_playback_wake_drop");
            nuwax_wake_word_detector_request_stop();
        } else {
            request_sleep_wake_word_detector("offline_wake_rearm");
        }
        return;
    }
    const uint32_t connection_epoch = active_ws_epoch_snapshot();
    if (connection_epoch == 0U) {
        ESP_LOGI(TAG,
                 "wake word ignored without an active WebSocket epoch; rearming detector");
        if (playback_interrupt) {
            inhibit_sleep_wake_word_detector(
                "playback_wake_without_ws_epoch");
            nuwax_wake_word_detector_request_stop();
        } else {
            request_sleep_wake_word_detector("wake_without_ws_epoch");
        }
        return;
    }

    wake_word_event_t event = *result;
    if (!playback_interrupt) {
        event.arm.ws_epoch = connection_epoch;
    }
    bool queued = s_wake_word_events &&
                  xQueueSend(s_wake_word_events, &event, 0) == pdTRUE;
    /* A probe is advisory. Never evict a queued final wake or sleep event just
     * to make room for a temporary volume change. */
    if (!queued && s_wake_word_events && !result->probe_requested) {
        wake_word_event_t dropped = {0};
        if (xQueueReceive(s_wake_word_events, &dropped, 0) == pdTRUE) {
            queued = xQueueSend(s_wake_word_events, &event, 0) == pdTRUE;
        }
    }
    if (!queued) {
        ESP_LOGW(TAG,
                 "wake word event queue unavailable probe=%d; rearming detector=%d",
                 result->probe_requested ? 1 : 0,
                 result->probe_requested ? 0 : 1);
        if (playback_interrupt) {
            if (!result->probe_requested) {
                notify_wake_supervisor();
            }
        } else {
            request_sleep_wake_word_detector("wake_event_queue_failed");
        }
    } else {
        notify_conversation_owner();
    }
}

static bool start_sleep_wake_word_detector(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    const nuwax_wake_arm_context_t request =
        wake_detector_request_snapshot(NULL);
    if (!atomic_load_explicit(&s_wake_detector_desired,
                              memory_order_acquire) ||
        request.mode == NUWAX_WAKE_MODE_OFF ||
        request.mode_token == 0U ||
        conversation_capture_busy_for_sleep() ||
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        nuwax_offline_audio_capture_running() ||
#endif
        ota_blocks_wake_detector()) {
        return false;
    }
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        ESP_LOGI(TAG,
                 "wake word detector start suppressed reason=%s BLE provisioning=1",
                 reason ? reason : "-");
        return false;
    }
    if (meeting_or_monitoring_mode_blocks_sleep()) {
        ESP_LOGI(TAG,
                 "wake word detector start suppressed reason=%s exclusive_audio_mode=1",
                 reason ? reason : "-");
        return false;
    }
    if (!s_wake_word_events) {
        return false;
    }
    if (uxQueueMessagesWaiting(s_wake_word_events) > 0U) {
        /* The worker exits after detection. Do not restart it over an event
         * that has not yet been consumed by the conversation owner. */
        return false;
    }
    if (nuwax_wake_word_detector_is_ready()) {
        return true;
    }
    if (!nuwax_wake_word_detector_is_running()) {
        const esp_err_t err = start_wake_model_serialized(&request);
        if (err != ESP_OK) {
            if (err == ESP_ERR_NOT_FINISHED) {
                /* Flash persistence and teardown intentionally stop inference.
                 * The supervisor retries after the owner releases its guard. */
                return false;
            }
            ESP_LOGW(TAG,
                     "wake word detector start failed reason=%s err=%s",
                     reason ? reason : "-",
                     esp_err_to_name(err));
            if (err == ESP_ERR_INVALID_STATE) {
                (void)queue_wake_model_restore_nonblocking(
                    "wake_detector_model_unavailable");
            }
            return false;
        }
        ESP_LOGI(TAG,
                 "wake word detector task started; waiting for microphone mode=%d token=%lu reason=%s",
                 (int)request.mode,
                 (unsigned long)request.mode_token,
                 reason ? reason : "-");
    }

    const uint32_t deadline_ms = monotonic_ms() + 1500U;
    while (!elapsed_ms(monotonic_ms(), deadline_ms)) {
        if (nuwax_wake_word_detector_is_ready()) {
            ESP_LOGI(TAG, "wake word detector ready reason=%s", reason ? reason : "-");
            return true;
        }
        if (!nuwax_wake_word_detector_is_running()) {
            break;
        }
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    ESP_LOGW(TAG, "wake word detector not ready after start reason=%s running=%d",
             reason ? reason : "-",
             nuwax_wake_word_detector_is_running() ? 1 : 0);
    return false;
#else
    (void)reason;
    return true;
#endif
}

static void ensure_sleep_wake_word_detector(void) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        conversation_state_current() != NUWAX_APP_STATE_SLEEPING ||
        /* The owner is awake before deferred feedback reaches the UI. Do not
         * let sleep-health re-arm MultiNet during greeting admission. */
        nuwax_awake_session_state_is_active(&s_awake_session) ||
        s_turn_guard.active ||
        nuwax_notification_blocks_conversation(
            &s_notification_transaction) ||
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        nuwax_offline_audio_capture_running() ||
#endif
        meeting_or_monitoring_mode_blocks_sleep() ||
        ota_blocks_wake_detector()) {
        return;
    }
    if (s_wake_word_events && uxQueueMessagesWaiting(s_wake_word_events) > 0U) {
        return;
    }
    request_sleep_wake_word_detector("sleep_health");
#endif
}

static bool conversation_capture_busy_for_sleep(void) {
    return atomic_load_explicit(&s_conversation_capture_starting,
                                memory_order_acquire) ||
           atomic_load_explicit(&s_conversation_capture_runtime_active,
                                memory_order_acquire);
}

static bool sleep_transaction_blocks_new_audio(void) {
    return s_sleep_request_pending ||
           nuwax_sleep_transaction_blocks_audio(&s_sleep_transaction);
}

static bool sleep_lifecycle_blocks_normal_cloud_audio(void) {
    if (sleep_transaction_blocks_new_audio()) {
        return true;
    }
    /* Greeting admission can precede the deferred visual state update. Only
     * a sleeping device with no awake owner quarantines normal output;
     * notification events use their separate owner. */
    return conversation_state_current() == NUWAX_APP_STATE_SLEEPING &&
           !nuwax_awake_session_state_is_active(&s_awake_session);
}

static bool local_power_transition_active(void) {
    /* The cancellable low-battery reminder only reserves the power gate.
     * Preserve ordinary playback/capture completion until shutdown is accepted;
     * suppressing those callbacks early can strand a charger-cancelled dialog. */
    return s_power_shutdown_requested || s_sleep_request_local_power ||
           (s_sleep_transaction.active &&
            s_sleep_transaction.local_request);
}

static bool sleep_lifecycle_blocks_new_capture(void) {
    return s_deferred_sleep_intent.active ||
           nuwax_notification_blocks_conversation(
               &s_notification_transaction) ||
           sleep_transaction_blocks_new_audio();
}

/* ESP_ERR_INVALID_STATE is also used for real initialization failures. Only
 * classify it as an intentional source handoff when the matching lifecycle
 * fence is still present; unrelated audio errors must retain the normal
 * recovery path. */
static bool normal_audio_source_sleep_preempted(esp_err_t err) {
    if (err != ESP_ERR_INVALID_STATE) {
        return false;
    }
    return !exclusive_audio_mode_blocks_normal_audio() &&
           (s_power_shutdown_requested ||
           s_deferred_sleep_intent.active ||
           sleep_transaction_blocks_new_audio() ||
           conversation_state_current() == NUWAX_APP_STATE_SLEEPING);
}

static bool normal_audio_source_notification_preempted(esp_err_t err) {
    return err == ESP_ERR_INVALID_STATE &&
           nuwax_notification_blocks_conversation(
               &s_notification_transaction);
}

static bool remote_sleep_reply_is_in_progress(const char *turn_id) {
    bool speaker_pending = false;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    speaker_pending = nuwax_speaker_playback_has_pending();
#endif
    const nuwax_app_state_t state = conversation_state_current();
    const bool capture_finishing =
        conversation_capture_busy_for_sleep() || s_prelisten.capture_active;
    const bool reply_in_progress =
        s_turn_guard.active || s_playback_terminal_guard.active ||
        speaker_pending || state == NUWAX_APP_STATE_THINKING ||
        state == NUWAX_APP_STATE_SPEAKING || capture_finishing;
    if (!reply_in_progress || !turn_id || turn_id[0] == '\0') {
        return reply_in_progress;
    }

    if (s_turn_guard.active && s_turn_guard.turn_id[0] != '\0') {
        return strcmp(s_turn_guard.turn_id, turn_id) == 0;
    }
    if (s_playback_terminal_guard.active &&
        s_playback_terminal_guard.turn_id[0] != '\0') {
        return strcmp(s_playback_terminal_guard.turn_id, turn_id) == 0;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (speaker_pending) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.active_turn_id[0] != '\0') {
            return strcmp(stats.active_turn_id, turn_id) == 0;
        }
    }
#endif
    if (capture_finishing) {
        return true;
    }
    /* A scoped command must not be attached to an owner whose turn cannot be
     * proven. It still executes through the immediate transaction path. */
    return false;
}

typedef enum {
    REMOTE_SLEEP_SCOPE_ALLOWED = 0,
    REMOTE_SLEEP_SCOPE_OWNER_UNBOUND,
    REMOTE_SLEEP_SCOPE_CONFLICT,
} remote_sleep_scope_result_t;

static remote_sleep_scope_result_t remote_sleep_scope_current_owner(
    const char *turn_id) {
    if (!turn_id || turn_id[0] == '\0') {
        return REMOTE_SLEEP_SCOPE_ALLOWED;
    }
    if (s_turn_guard.active && s_turn_guard.turn_id[0] != '\0') {
        return strcmp(s_turn_guard.turn_id, turn_id) == 0
                   ? REMOTE_SLEEP_SCOPE_ALLOWED
                   : REMOTE_SLEEP_SCOPE_CONFLICT;
    }
    if (s_playback_terminal_guard.active &&
        s_playback_terminal_guard.turn_id[0] != '\0') {
        return strcmp(s_playback_terminal_guard.turn_id, turn_id) == 0
                   ? REMOTE_SLEEP_SCOPE_ALLOWED
                   : REMOTE_SLEEP_SCOPE_CONFLICT;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.active_turn_id[0] != '\0') {
            return strcmp(stats.active_turn_id, turn_id) == 0
                       ? REMOTE_SLEEP_SCOPE_ALLOWED
                       : REMOTE_SLEEP_SCOPE_CONFLICT;
        }
    }
#endif
    const nuwax_app_state_t state = conversation_state_current();
    const bool unscoped_owner_in_flight =
        conversation_capture_busy_for_sleep() || s_prelisten.capture_active ||
        state == NUWAX_APP_STATE_THINKING ||
        state == NUWAX_APP_STATE_SPEAKING;
    return unscoped_owner_in_flight ? REMOTE_SLEEP_SCOPE_OWNER_UNBOUND
                                    : REMOTE_SLEEP_SCOPE_ALLOWED;
}

static void service_offline_wake_word_detector(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        conversation_capture_busy_for_sleep() ||
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        nuwax_offline_audio_capture_running() ||
#endif
        meeting_or_monitoring_mode_blocks_sleep() ||
        ota_blocks_wake_detector() ||
        nuwax_awake_session_state_is_active(&s_awake_session)) {
        return;
    }
    if (s_wake_word_events &&
        uxQueueMessagesWaiting(s_wake_word_events) > 0U) {
        return;
    }
    request_sleep_wake_word_detector(reason ? reason : "offline_health");
#else
    (void)reason;
#endif
}

static void wake_word_supervisor_task(void *arg) {
    (void)arg;
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    uint32_t next_attempt_ms = 0U;
    uint32_t ready_since_ms = 0U;
    bool ready_announced = false;
    uint32_t not_ready_since_ms = 0U;
    for (;;) {
        (void)ulTaskNotifyTake(pdTRUE,
                               pdMS_TO_TICKS(NUWAX_WAKE_SUPERVISOR_POLL_MS));
        if (!atomic_load_explicit(&s_wake_detector_desired,
                                  memory_order_acquire)) {
            ready_announced = false;
            ready_since_ms = 0U;
            not_ready_since_ms = 0U;
            continue;
        }
        if (nuwax_wake_word_detector_flash_paused() ||
            atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire) ||
            conversation_capture_busy_for_sleep() ||
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            nuwax_offline_audio_capture_running() ||
#endif
            meeting_or_monitoring_mode_blocks_sleep() ||
            ota_blocks_wake_detector() ||
            (s_wake_word_events &&
             uxQueueMessagesWaiting(s_wake_word_events) > 0U)) {
            ready_announced = false;
            not_ready_since_ms = 0U;
            ready_since_ms = 0U;
            continue;
        }

        const uint32_t now_ms = monotonic_ms();
        const uint32_t requested_ms = (uint32_t)atomic_load_explicit(
            &s_wake_detector_request_ms, memory_order_acquire);
        const bool detector_ready = nuwax_wake_word_detector_is_ready();
        if (detector_ready) {
            not_ready_since_ms = 0U;
            const uint32_t last_feed_ms =
                nuwax_wake_word_detector_last_feed_ms();
            /* The detector and supervisor publish timestamps from different
             * tasks. A feed may be one tick newer than this snapshot; do not
             * let unsigned subtraction turn that benign race into 4.29e9 ms
             * of apparent staleness. The signed comparison remains valid over
             * the uint32 millisecond wrap because the stale threshold is
             * orders of magnitude below INT32_MAX. */
            const uint32_t feed_age_ms =
                last_feed_ms != 0U &&
                        elapsed_ms(now_ms, last_feed_ms)
                    ? (uint32_t)(now_ms - last_feed_ms)
                    : 0U;
            const uint32_t ready_age_ms =
                ready_since_ms != 0U &&
                        elapsed_ms(now_ms, ready_since_ms)
                    ? (uint32_t)(now_ms - ready_since_ms)
                    : 0U;
            if (!ready_announced) {
                ready_since_ms = now_ms;
            }
            const bool first_frame_stale =
                last_feed_ms == 0U && ready_since_ms != 0U &&
                ready_age_ms >=
                    NUWAX_WAKE_SUPERVISOR_DATA_STALE_MS;
            const bool feed_stale =
                last_feed_ms != 0U &&
                feed_age_ms >=
                    NUWAX_WAKE_SUPERVISOR_DATA_STALE_MS;
            if (first_frame_stale || feed_stale) {
                ESP_LOGW(TAG,
                         "wake detector data stale ready=1 first_frame_stale=%d last_feed_ms=%lu age_ms=%lu threshold_ms=%u; requesting bounded stop",
                         first_frame_stale ? 1 : 0,
                         (unsigned long)last_feed_ms,
                         last_feed_ms != 0U
                             ? (unsigned long)feed_age_ms
                             : (unsigned long)ready_age_ms,
                         (unsigned)NUWAX_WAKE_SUPERVISOR_DATA_STALE_MS);
                const esp_err_t stop_err =
                    nuwax_wake_word_detector_stop_with_timeout(
                        NUWAX_WAKE_WORD_STOP_TIMEOUT_MS);
                if (stop_err != ESP_OK) {
                    ESP_LOGE(TAG,
                             "wake detector stale-data stop did not converge err=%s; controlled restart preserves MIC ownership",
                             esp_err_to_name(stop_err));
                    set_state(NUWAX_APP_STATE_ERROR);
                    nuwax_diagnostics_log_heap_label(
                        TAG, "wake_detector_stale_data_restart");
                    vTaskDelay(pdMS_TO_TICKS(100));
                    esp_restart();
                    vTaskDelay(portMAX_DELAY);
                }
                atomic_store_explicit(&s_wake_detector_request_ms,
                                      monotonic_ms(),
                                      memory_order_release);
                next_attempt_ms = monotonic_ms() +
                                  NUWAX_WAKE_SUPERVISOR_RETRY_MS;
                ready_announced = false;
                ready_since_ms = 0U;
                continue;
            }
            if (!ready_announced) {
                ESP_LOGI(TAG,
                         "wake detector supervised ready latency_ms=%lu",
                         (unsigned long)(monotonic_ms() - requested_ms));
                ready_announced = true;
            }
            continue;
        }

        const bool detector_running = nuwax_wake_word_detector_is_running();
        if (not_ready_since_ms == 0U) not_ready_since_ms = now_ms;
        if (detector_running &&
            (uint32_t)(now_ms - not_ready_since_ms) >=
                NUWAX_WAKE_SUPERVISOR_READY_TIMEOUT_MS) {
            ESP_LOGE(TAG,
                     "wake detector remained running without readiness elapsed_ms=%lu timeout_ms=%u; requesting bounded stop",
                     (unsigned long)(now_ms - not_ready_since_ms),
                     (unsigned)NUWAX_WAKE_SUPERVISOR_READY_TIMEOUT_MS);
            const esp_err_t stop_err =
                nuwax_wake_word_detector_stop_with_timeout(
                    NUWAX_WAKE_WORD_STOP_TIMEOUT_MS);
            if (stop_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "wake detector startup did not converge after bounded stop err=%s; controlled restart preserves MIC ownership",
                         esp_err_to_name(stop_err));
                set_state(NUWAX_APP_STATE_ERROR);
                nuwax_diagnostics_log_heap_label(
                    TAG, "wake_detector_start_forced_restart");
                vTaskDelay(pdMS_TO_TICKS(100));
                esp_restart();
                vTaskDelay(portMAX_DELAY);
            }
            atomic_store_explicit(&s_wake_detector_request_ms,
                                  monotonic_ms(),
                                  memory_order_release);
            next_attempt_ms = monotonic_ms() +
                              NUWAX_WAKE_SUPERVISOR_RETRY_MS;
            ready_announced = false;
            not_ready_since_ms = 0U;
            continue;
        }
        if (ready_announced) {
            atomic_store_explicit(&s_wake_detector_request_ms,
                                  now_ms,
                                  memory_order_release);
            ESP_LOGW(TAG,
                     "wake detector lost readiness while still requested; recovering");
        }
        ready_announced = false;
        ready_since_ms = 0U;
        if (!elapsed_ms(now_ms, next_attempt_ms)) {
            continue;
        }
        if (!detector_running) {
            not_ready_since_ms = now_ms;
            atomic_store_explicit(&s_wake_detector_request_ms,
                                  now_ms,
                                  memory_order_release);
        }
        const bool ready = start_sleep_wake_word_detector("wake_supervisor");
        next_attempt_ms = monotonic_ms() +
                          (ready ? NUWAX_WAKE_SUPERVISOR_POLL_MS
                                 : NUWAX_WAKE_SUPERVISOR_RETRY_MS);
    }
#else
    vTaskDelete(NULL);
#endif
}

static void remember_sleep_request(const char *reason) {
    s_sleep_request_pending = true;
    s_sleep_request_awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    s_sleep_request_requires_idle_expiry =
        reason && strcmp(reason, "awake_idle_timeout") == 0;
    strlcpy(s_sleep_request_reason,
            reason && reason[0] ? reason : "sleep",
            sizeof(s_sleep_request_reason));
}

static void clear_sleep_request(void) {
    s_sleep_request_pending = false;
    s_sleep_request_awake_generation = 0U;
    s_sleep_request_requires_idle_expiry = false;
    s_sleep_request_reason[0] = '\0';
    s_sleep_request_local_power = false;
    s_sleep_request_speaker_generation = 0U;
    s_sleep_request_speaker_epoch = 0U;
    s_sleep_request_speaker_cancel_armed = false;
}

static bool commit_sleeping_conversation_state(const char *reason);

#if CONFIG_NUWAX_SPEAKER_ENABLE
static uint32_t sleep_transaction_current_speaker_generation(
    uint32_t ws_epoch) {
    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    if (!nuwax_speaker_playback_has_pending()) {
        return 0U;
    }
    if (stats.submitted_generation != 0U &&
        stats.submitted_connection_epoch == ws_epoch) {
        return stats.submitted_generation;
    }
    if (stats.playback_generation != 0U &&
        stats.playback_connection_epoch == ws_epoch) {
        return stats.playback_generation;
    }
    if (stats.start_gate_generation != 0U &&
        stats.start_gate_connection_epoch == ws_epoch) {
        return stats.start_gate_generation;
    }
    /* Keep the generation even when its recorded epoch is stale. A remote
     * transaction will intentionally refuse that completion, but issuing the
     * generation-bound cancel still prevents old audio from continuing while
     * the 2 s fault path closes the stale connection. A local power-key
     * transaction may have no WebSocket epoch at all and accepts the same
     * generation's physical completion without fabricating a cloud close. */
    if (stats.submitted_generation != 0U) {
        ESP_LOGW(TAG,
                 "pending speaker generation belongs to stale epoch transaction_epoch=%lu speaker_epoch=%lu generation=%lu",
                 (unsigned long)ws_epoch,
                 (unsigned long)stats.submitted_connection_epoch,
                 (unsigned long)stats.submitted_generation);
        return stats.submitted_generation;
    }
    ESP_LOGE(TAG,
             "pending speaker has no current WebSocket binding transaction_epoch=%lu submitted=%lu/%lu playback=%lu/%lu gate=%lu/%lu",
             (unsigned long)ws_epoch,
             (unsigned long)stats.submitted_connection_epoch,
             (unsigned long)stats.submitted_generation,
             (unsigned long)stats.playback_connection_epoch,
             (unsigned long)stats.playback_generation,
             (unsigned long)stats.start_gate_connection_epoch,
             (unsigned long)stats.start_gate_generation);
    return 0U;
}
#endif

/* Arm a local power-key sleep without starting the short sleep transaction
 * while another owner still has the audio path.  The capture owner may need
 * to finish a bounded WebSocket terminal exchange; that work must not be
 * measured against the two-second sleep convergence deadline. */
static void remember_local_power_sleep_request(nuwax_ws_client_t *ws,
                                               const char *reason) {
    if (!s_sleep_request_pending || !s_sleep_request_local_power) {
        remember_sleep_request(reason ? reason : "power_key_sleep");
        s_sleep_request_local_power = true;
        s_sleep_request_speaker_generation = 0U;
        s_sleep_request_speaker_epoch = 0U;
        s_sleep_request_speaker_cancel_armed = false;
    }

    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    s_post_playback_resume_pending = false;
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    inhibit_sleep_wake_word_detector(reason ? reason : "power_key_sleep");
    if (nuwax_wake_word_detector_is_running()) {
        nuwax_wake_word_detector_request_stop();
    }
#endif

#if CONFIG_NUWAX_SPEAKER_ENABLE
    /* Local sleep has priority. Fence late binary first, then retire only the
     * exact metadata owner. A concurrent START retains physical cancellation;
     * historical submitted_generation is never used to cancel metadata alone. */
    (void)update_normal_downlink_admission(false);
    if (nuwax_speaker_playback_abort_metadata_only_session(
            s_turn_guard.turn_id, s_turn_guard.playback_id,
            "power_key_sleep_metadata_only")) {
        clear_active_turn_guard("power_key_sleep_metadata_only");
    }
    const bool speaker_pending = nuwax_speaker_playback_has_pending();
    if (!speaker_pending) {
        /* The generation-bound cancellation has already reached the physical
         * terminal.  Drop the tracking fields so a later, unrelated playback
         * cannot be mistaken for the old request. */
        s_sleep_request_speaker_generation = 0U;
        s_sleep_request_speaker_epoch = 0U;
        s_sleep_request_speaker_cancel_armed = false;
    } else if (!s_sleep_request_speaker_cancel_armed) {
        const uint32_t ws_epoch =
            ws && nuwax_ws_is_connected(ws)
                ? nuwax_ws_connection_epoch(ws)
                : active_ws_epoch_snapshot();
        const uint32_t generation =
            sleep_transaction_current_speaker_generation(ws_epoch);
        if (generation != 0U &&
            generation != s_sleep_request_speaker_generation) {
            if (s_sleep_request_speaker_generation != 0U) {
                ESP_LOGW(TAG,
                         "local power sleep speaker generation advanced old=%lu new=%lu; rebinding cancellation",
                         (unsigned long)s_sleep_request_speaker_generation,
                         (unsigned long)generation);
            }
            s_sleep_request_speaker_epoch = ws_epoch;
            s_sleep_request_speaker_generation = generation;
            s_sleep_request_speaker_cancel_armed = false;
        }
    }
    if (s_sleep_request_speaker_generation != 0U &&
        !s_sleep_request_speaker_cancel_armed) {
        nuwax_speaker_cancel_request_result_t cancel = {0};
        const bool accepted =
            nuwax_speaker_playback_request_cancel_generation_ex(
                s_sleep_request_speaker_generation,
                reason ? reason : "power_key_sleep",
                NUWAX_SLEEP_TRANSACTION_SPEAKER_FADE_MS,
                &cancel);
        /* COMPLETED/FAILED are terminal observations for this generation;
         * keep the arm bit set so a busy main loop cannot issue duplicate
         * cancellation requests.  REJECTED deliberately remains unarmed so
         * the next owner pass can retry or rebind if the speaker generation
         * advanced between the snapshot and this request. */
        s_sleep_request_speaker_cancel_armed =
            accepted || cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED ||
            cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_FAILED;
        if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_FAILED ||
            (accepted &&
             cancel.status != NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED)) {
            /* Reuse the existing bounded speaker recovery watchdog for every
             * accepted non-terminal local cancellation and terminal failure.
             * A transient REJECTED result remains unarmed and is retried from
             * a fresh owner snapshot on the next pass. A normal stop clears
             * this observation quickly; a lost terminal or physical-stop
             * failure is reset locally after three seconds without reconnecting
             * or resuming the cancelled conversation. */
            s_speaker_fault_recovery_epoch =
                cancel.connection_epoch != 0U
                    ? cancel.connection_epoch
                    : s_sleep_request_speaker_epoch;
            s_speaker_fault_recovery_generation =
                cancel.playback_generation != 0U
                    ? cancel.playback_generation
                    : s_sleep_request_speaker_generation;
        }
        ESP_LOGI(TAG,
                 "local power sleep speaker cancel deferred generation=%lu epoch=%lu status=%d accepted=%d",
                 (unsigned long)s_sleep_request_speaker_generation,
                 (unsigned long)s_sleep_request_speaker_epoch,
                 (int)cancel.status,
                 accepted ? 1 : 0);
    }
#else
    (void)ws;
#endif
    cancel_auto_followup_capture(reason ? reason : "power_key_sleep");
}

static bool requeue_local_power_sleep_after_timeout(const char *reason) {
    if (!s_sleep_transaction.active) {
        return false;
    }
    const uint32_t token = s_sleep_transaction.token;
    nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
    if (!nuwax_sleep_transaction_abort(&s_sleep_transaction, token)) {
        /* Keep the transaction alive for one more service pass if an owner
         * changed it concurrently.  Crucially, do not escalate a local key
         * request to the generic WebSocket-close/restart recovery path. */
        s_sleep_transaction.deadline_ms = monotonic_ms() + 1000U;
        ESP_LOGW(TAG,
                 "local power sleep timeout could not requeue token=%lu; extending bounded wait",
                 (unsigned long)token);
        return true;
    }
    remember_local_power_sleep_request(
        ws, reason ? reason : "power_key_sleep_retry");
    ESP_LOGW(TAG,
             "local power sleep transaction requeued after convergence timeout token=%lu reason=%s",
             (unsigned long)token,
             reason ? reason : "power_key_sleep_retry");
    return true;
}

static bool service_deferred_remote_sleep_intent(const char *reason,
                                                 bool force) {
    if (!s_deferred_sleep_intent.active) {
        return false;
    }

    const uint32_t now_ms = monotonic_ms();
    const nuwax_app_state_t state = conversation_state_current();
    const bool turn_active =
        nuwax_deferred_sleep_turn_owner_active(
            s_turn_guard.active,
            state,
            conversation_capture_busy_for_sleep(),
            s_prelisten.capture_active);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool speaker_pending = nuwax_speaker_playback_has_pending();
#else
    const bool speaker_pending = false;
#endif
    const bool terminal_active = s_playback_terminal_guard.active;
    const bool deadline_expired =
        (int32_t)(now_ms - s_deferred_sleep_intent.deadline_ms) >= 0;
    if (!force &&
        !nuwax_deferred_sleep_intent_ready_to_execute(
            &s_deferred_sleep_intent,
            now_ms,
            turn_active,
            speaker_pending,
            terminal_active)) {
        return false;
    }

    const nuwax_deferred_sleep_intent_t intent = s_deferred_sleep_intent;
    ESP_LOGW(TAG,
             "sleep-after-playback %s token=%lu epoch=%lu request=%s turn=%s owner_turn=%d speaker=%d terminal=%d reason=%s",
             deadline_expired ? "timeout fallback" : "reply terminal reached",
             (unsigned long)intent.token,
             (unsigned long)intent.ws_epoch,
             intent.request_id,
             intent.turn_id[0] ? intent.turn_id : "-",
             turn_active ? 1 : 0,
             speaker_pending ? 1 : 0,
             terminal_active ? 1 : 0,
             reason ? reason : "-");

    const nuwax_sleep_request_result_t result =
        begin_remote_sleep_transaction_bound(intent.ws_epoch,
                                             intent.request_id,
                                             intent.command,
                                             intent.turn_id);
    const bool ownership_transferred =
        result == NUWAX_SLEEP_REQUEST_STARTED ||
        result == NUWAX_SLEEP_REQUEST_DUPLICATE_ACTIVE ||
        result == NUWAX_SLEEP_REQUEST_DUPLICATE_COMMITTED ||
        result == NUWAX_SLEEP_REQUEST_ALREADY_SLEEPING;
    if (!ownership_transferred) {
        ESP_LOGE(TAG,
                 "sleep-after-playback transfer deferred token=%lu result=%d transaction_state=%s",
                 (unsigned long)intent.token,
                 (int)result,
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state));
        return false;
    }

    if ((result == NUWAX_SLEEP_REQUEST_DUPLICATE_COMMITTED ||
         result == NUWAX_SLEEP_REQUEST_ALREADY_SLEEPING) &&
        intent.ws_epoch == active_ws_epoch_snapshot()) {
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (ws && nuwax_ws_is_connected(ws)) {
            ESP_ERROR_CHECK_WITHOUT_ABORT(
                nuwax_session_send_command_ack_until_if_epoch(
                    ws,
                    intent.request_id,
                    intent.command,
                    true,
                    "sleeping",
                    esp_timer_get_time() +
                        NUWAX_SLEEP_TRANSACTION_ACK_TIMEOUT_US,
                    intent.ws_epoch));
        }
    }

    if (!nuwax_deferred_sleep_intent_consume(
            &s_deferred_sleep_intent, intent.token)) {
        ESP_LOGE(TAG,
                 "sleep-after-playback ownership transferred but intent token changed expected=%lu actual=%lu",
                 (unsigned long)intent.token,
                 (unsigned long)s_deferred_sleep_intent.token);
        return false;
    }
    ESP_LOGI(TAG,
             "sleep-after-playback intent transferred token=%lu epoch=%lu result=%d",
             (unsigned long)intent.token,
             (unsigned long)intent.ws_epoch,
             (int)result);
    return true;
}

static void service_sleep_transaction(void) {
    if (!s_sleep_transaction.active) {
        if (s_sleep_request_pending && s_sleep_request_local_power) {
            service_pending_sleep_request();
            if (s_sleep_request_pending) {
                return;
            }
        }
        (void)service_deferred_remote_sleep_intent(
            "deferred_sleep_health", false);
        if (!s_sleep_transaction.active) {
            return;
        }
    }

    const uint32_t token = s_sleep_transaction.token;
    const bool local_request = s_sleep_transaction.local_request;

    /* A notification can be admitted after a local key request was snapshotted
     * but before its speaker barrier becomes ready. Never publish SLEEPING
     * underneath that owner: return the local intent to the pending gate and
     * let the notification cancellation/terminal path release the hardware. */
    if (local_request &&
        nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (nuwax_sleep_transaction_abort(&s_sleep_transaction, token)) {
            remember_local_power_sleep_request(
                ws, "power_key_sleep_notification_barrier");
            if (ws) {
                cancel_active_notification(
                    ws, "power_key_sleep_notification_barrier");
            }
            ESP_LOGI(TAG,
                     "local power sleep transaction deferred behind active notification token=%lu",
                     (unsigned long)token);
        }
        return;
    }
    if (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_REQUESTED) {
        (void)nuwax_sleep_transaction_begin_quiescing(
            &s_sleep_transaction, token);
    }

    if (!conversation_capture_busy_for_sleep() &&
        !s_sleep_transaction.capture_released) {
        (void)nuwax_sleep_transaction_mark_capture_released(
            &s_sleep_transaction, token);
    }
    if (local_request && s_sleep_transaction.ws_epoch == 0U &&
        !s_sleep_transaction.protocol_closed) {
        /* A local power-key transaction has no cloud protocol to close. Keep
         * the barrier explicit so an offline short press cannot enter the
         * recovery/restart path waiting for a nonexistent WebSocket. */
        (void)nuwax_sleep_transaction_mark_protocol_closed(
            &s_sleep_transaction, token, 0U);
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!s_sleep_transaction.speaker_stopped &&
        s_sleep_transaction.speaker_generation != 0U) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        const bool completion_epoch_matches =
            (local_request && s_sleep_transaction.ws_epoch == 0U) ||
            stats.completed_stop_connection_epoch ==
                s_sleep_transaction.ws_epoch;
        if (stats.completed_stop_result == ESP_OK &&
            completion_epoch_matches &&
            stats.completed_stop_generation ==
                s_sleep_transaction.speaker_generation) {
            (void)nuwax_sleep_transaction_mark_speaker_stopped(
                &s_sleep_transaction,
                token,
                s_sleep_transaction.ws_epoch,
                stats.completed_stop_generation);
            ESP_LOGI(TAG,
                     "sleep transaction observed speaker quiescence token=%lu epoch=%lu generation=%lu",
                     (unsigned long)token,
                     (unsigned long)stats.completed_stop_connection_epoch,
                     (unsigned long)stats.completed_stop_generation);
        } else if (((local_request && s_sleep_transaction.ws_epoch == 0U) ||
                    stats.failed_stop_connection_epoch ==
                        s_sleep_transaction.ws_epoch) &&
                   stats.failed_stop_generation ==
                       s_sleep_transaction.speaker_generation) {
            s_speaker_fault_recovery_epoch =
                stats.failed_stop_connection_epoch;
            s_speaker_fault_recovery_generation =
                stats.failed_stop_generation;
            ESP_LOGE(TAG,
                     "sleep transaction speaker physical stop failed token=%lu epoch=%lu generation=%lu err=%s",
                     (unsigned long)token,
                     (unsigned long)stats.failed_stop_connection_epoch,
                     (unsigned long)stats.failed_stop_generation,
                     esp_err_to_name(stats.failed_stop_result));
        }
    }
#endif

    const uint32_t now_ms = monotonic_ms();
    if (local_request &&
        (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_QUIESCING ||
         s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_RECOVERING) &&
        !nuwax_sleep_transaction_ready_to_commit(&s_sleep_transaction) &&
        nuwax_sleep_transaction_deadline_expired(&s_sleep_transaction,
                                                 now_ms)) {
        /* A physical key request is local UI intent. A delayed MIC/uplink or
         * speaker teardown must never turn that intent into a process reset;
         * return it to the non-blocking pending gate and let the real owner
         * completion drive the next attempt. */
        if (requeue_local_power_sleep_after_timeout(
                "power_key_sleep_convergence_retry")) {
            return;
        }
    }
    if (!nuwax_sleep_transaction_ready_to_commit(&s_sleep_transaction) &&
        nuwax_audio_terminal_recovery_pending() &&
        (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_QUIESCING ||
         s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_RECOVERING) &&
        nuwax_sleep_transaction_deadline_expired(&s_sleep_transaction,
                                                 now_ms)) {
        /* Terminal recovery owns a separate bounded deadline. Do not let the
         * shorter sleep watchdog restart the device while that same serialized
         * audio close is still making progress on a healthy connection. */
        s_sleep_transaction.deadline_ms = now_ms + 1000U;
        ESP_LOGW(TAG,
                 "sleep transaction waiting for bounded audio terminal recovery token=%lu epoch=%lu state=%s",
                 (unsigned long)token,
                 (unsigned long)s_sleep_transaction.ws_epoch,
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state));
    }
    if (!nuwax_sleep_transaction_ready_to_commit(&s_sleep_transaction) &&
        s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_QUIESCING &&
        nuwax_sleep_transaction_deadline_expired(&s_sleep_transaction,
                                                 now_ms)) {
        ESP_LOGE(TAG,
                 "sleep transaction convergence timeout token=%lu epoch=%lu generation=%lu capture_released=%d speaker_stopped=%d protocol_closed=%d; closing bound WebSocket without deleting audio tasks",
                 (unsigned long)token,
                 (unsigned long)s_sleep_transaction.ws_epoch,
                 (unsigned long)s_sleep_transaction.speaker_generation,
                 s_sleep_transaction.capture_released ? 1 : 0,
                 s_sleep_transaction.speaker_stopped ? 1 : 0,
                 s_sleep_transaction.protocol_closed ? 1 : 0);
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (ws && s_sleep_transaction.ws_epoch != 0U &&
            nuwax_ws_request_close_if_epoch(
                ws, s_sleep_transaction.ws_epoch)) {
            (void)nuwax_sleep_transaction_mark_protocol_closed(
                &s_sleep_transaction,
                token,
                s_sleep_transaction.ws_epoch);
        }
        (void)nuwax_sleep_transaction_begin_recovery_after_timeout(
            &s_sleep_transaction,
            token,
            now_ms,
            NUWAX_SLEEP_TRANSACTION_RECOVERY_TIMEOUT_MS);
    }

    if (!nuwax_sleep_transaction_ready_to_commit(&s_sleep_transaction) &&
        s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_RECOVERING &&
        nuwax_sleep_transaction_deadline_expired(&s_sleep_transaction,
                                                 now_ms)) {
        ESP_LOGE(TAG,
                 "sleep transaction recovery failed token=%lu epoch=%lu generation=%lu capture_released=%d speaker_stopped=%d protocol_closed=%d; controlled restart preserves resource ownership invariants",
                 (unsigned long)token,
                 (unsigned long)s_sleep_transaction.ws_epoch,
                 (unsigned long)s_sleep_transaction.speaker_generation,
                 s_sleep_transaction.capture_released ? 1 : 0,
                 s_sleep_transaction.speaker_stopped ? 1 : 0,
                 s_sleep_transaction.protocol_closed ? 1 : 0);
        esp_restart();
        vTaskDelay(portMAX_DELAY);
        return;
    }

    if (!nuwax_sleep_transaction_ready_to_commit(&s_sleep_transaction) ||
        !nuwax_sleep_transaction_begin_committing(&s_sleep_transaction,
                                                  token)) {
        return;
    }

    char request_id[sizeof(s_sleep_transaction.request_id)] = {0};
    char command[sizeof(s_sleep_transaction.command)] = {0};
    const uint32_t ws_epoch = s_sleep_transaction.ws_epoch;
    strlcpy(request_id,
            s_sleep_transaction.request_id,
            sizeof(request_id));
    strlcpy(command, s_sleep_transaction.command, sizeof(command));

    if (!commit_sleeping_conversation_state(
            local_request ? "power_key_sleep" : "remote_sleep_transaction")) {
        /* The STARTING callback normally cancels the transaction first. This
         * token-bound fallback closes the race where an exclusive mode obtains
         * audio ownership between the ready check and the local commit. A
         * physical key request is local intent, so preserve it for a later
         * retry instead of silently dropping it with the aborted transaction. */
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        const bool aborted =
            nuwax_sleep_transaction_abort(&s_sleep_transaction, token);
        if (local_request && aborted) {
            remember_local_power_sleep_request(
                ws, "power_key_sleep_commit_retry");
            ESP_LOGI(TAG,
                     "local power sleep commit superseded; request requeued token=%lu",
                     (unsigned long)token);
            return;
        }
        if (!aborted) {
            ESP_LOGI(TAG,
                     "sleep commit was superseded by another owner token=%lu state=%s",
                     (unsigned long)token,
                     nuwax_sleep_transaction_state_name(
                         s_sleep_transaction.state));
            return;
        }
        if (ws && nuwax_ws_is_connected(ws) &&
            nuwax_ws_connection_epoch(ws) == ws_epoch) {
            ESP_ERROR_CHECK_WITHOUT_ABORT(
                nuwax_session_send_command_ack_until_if_epoch(
                    ws,
                    request_id,
                    command,
                    false,
                    "superseded by exclusive audio mode",
                    esp_timer_get_time() +
                        NUWAX_SLEEP_TRANSACTION_ACK_TIMEOUT_US,
                    ws_epoch));
        }
        return;
    }
    if (!nuwax_sleep_transaction_commit_sleeping(&s_sleep_transaction,
                                                 token)) {
        ESP_LOGE(TAG,
                 "sleep transaction local commit invariant failed token=%lu",
                 (unsigned long)token);
        return;
    }

    nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
    if (!local_request && ws && nuwax_ws_is_connected(ws) &&
        nuwax_ws_connection_epoch(ws) == ws_epoch) {
        const esp_err_t ack_err =
            nuwax_session_send_command_ack_until_if_epoch(
                ws,
                request_id,
                command,
                true,
                "sleeping",
                esp_timer_get_time() +
                    NUWAX_SLEEP_TRANSACTION_ACK_TIMEOUT_US,
                ws_epoch);
        if (ack_err == ESP_OK) {
            (void)nuwax_sleep_transaction_mark_ack_sent(
                &s_sleep_transaction, token, ws_epoch);
        } else {
            ESP_LOGW(TAG,
                     "sleep transaction committed locally but ACK was not delivered token=%lu epoch=%lu request=%s err=%s",
                     (unsigned long)token,
                     (unsigned long)ws_epoch,
                     request_id,
                     esp_err_to_name(ack_err));
        }
    } else if (!local_request) {
        ESP_LOGW(TAG,
                 "sleep transaction committed locally without stale ACK token=%lu request_epoch=%lu active_epoch=%lu request=%s",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 (unsigned long)active_ws_epoch_snapshot(),
                 request_id);
    }
    ESP_LOGI(TAG,
             "sleep transaction committed token=%lu epoch=%lu request=%s command=%s ack_sent=%d",
             (unsigned long)token,
             (unsigned long)ws_epoch,
             request_id,
             command,
             s_sleep_transaction.ack_sent ? 1 : 0);
}

static nuwax_sleep_request_result_t begin_remote_sleep_transaction_bound(
    uint32_t ws_epoch,
    const char *request_id,
    const char *command,
    const char *turn_id) {
    if (ws_epoch == 0U) {
        return NUWAX_SLEEP_REQUEST_INVALID;
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    const uint32_t speaker_generation =
        sleep_transaction_current_speaker_generation(ws_epoch);
#else
    const uint32_t speaker_generation = 0U;
#endif
    const nuwax_sleep_request_result_t result =
        nuwax_sleep_transaction_request(
            &s_sleep_transaction,
            monotonic_ms(),
            NUWAX_SLEEP_TRANSACTION_TIMEOUT_MS,
            ws_epoch,
            speaker_generation,
            request_id,
            command,
            turn_id,
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING);
    if (result != NUWAX_SLEEP_REQUEST_STARTED) {
        ESP_LOGI(TAG,
                 "sleep transaction request result=%d state=%s epoch=%lu request=%s",
                 (int)result,
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 (unsigned long)ws_epoch,
                 request_id ? request_id : "-");
        return result;
    }

    const uint32_t token = s_sleep_transaction.token;
    (void)nuwax_sleep_transaction_begin_quiescing(
        &s_sleep_transaction, token);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
#endif
    cancel_auto_followup_capture("remote_sleep_transaction");
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    s_post_playback_resume_pending = false;

    if (!conversation_capture_busy_for_sleep()) {
        (void)nuwax_sleep_transaction_mark_capture_released(
            &s_sleep_transaction, token);
        (void)nuwax_sleep_transaction_mark_protocol_closed(
            &s_sleep_transaction, token, ws_epoch);
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (speaker_generation != 0U) {
        nuwax_speaker_cancel_request_result_t cancel = {0};
        (void)nuwax_speaker_playback_request_cancel_generation_ex(
            speaker_generation,
            "remote_sleep_transaction",
            NUWAX_SLEEP_TRANSACTION_SPEAKER_FADE_MS,
            &cancel);
        if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
            cancel.connection_epoch == ws_epoch &&
            cancel.playback_generation == speaker_generation &&
            cancel.completed_stop_result == ESP_OK) {
            (void)nuwax_sleep_transaction_mark_speaker_stopped(
                &s_sleep_transaction,
                token,
                cancel.connection_epoch,
                cancel.playback_generation);
        } else if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_FAILED) {
            s_speaker_fault_recovery_epoch = cancel.connection_epoch;
            s_speaker_fault_recovery_generation =
                cancel.playback_generation;
        }
    }
#endif

    ESP_LOGI(TAG,
             "sleep transaction requested token=%lu epoch=%lu speaker_generation=%lu request=%s turn=%s capture_busy=%d",
             (unsigned long)token,
             (unsigned long)ws_epoch,
             (unsigned long)speaker_generation,
             request_id,
             turn_id && turn_id[0] ? turn_id : "-",
             conversation_capture_busy_for_sleep() ? 1 : 0);
    service_sleep_transaction();
    return result;
}

static nuwax_sleep_request_result_t begin_local_power_sleep_transaction(
    nuwax_ws_client_t *ws,
    const char *reason) {
    if (s_sleep_request_pending && s_sleep_request_local_power) {
        service_pending_sleep_request();
        if (s_sleep_request_pending) {
            return NUWAX_SLEEP_REQUEST_STARTED;
        }
    }
    const uint32_t ws_epoch =
        ws && nuwax_ws_is_connected(ws) ? nuwax_ws_connection_epoch(ws) : 0U;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const uint32_t speaker_generation =
        sleep_transaction_current_speaker_generation(ws_epoch);
    /* Keep the generation snapshot and pending decision from diverging at the
     * natural-terminal edge. The speaker can publish its completion snapshot
     * between two independent calls; a non-zero generation still represents
     * an owner that the sleep barrier must wait for. */
    const bool speaker_pending =
        speaker_generation != 0U || nuwax_speaker_playback_has_pending();
#else
    const uint32_t speaker_generation = 0U;
    const bool speaker_pending = false;
#endif
    const bool capture_busy = conversation_capture_busy_for_sleep();
    const bool notification_active =
        nuwax_notification_blocks_conversation(
            &s_notification_transaction);

    /* Do not start the two-second transactional deadline while a capture,
     * notification, or speaker owner still needs to release hardware.  The
     * local key request is retained in the non-resetting pending slot and is
     * committed once those owners report quiescence. */
    if (capture_busy || notification_active || speaker_pending) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        (void)update_normal_downlink_admission(false);
#endif
        remember_local_power_sleep_request(ws, reason);
        if (notification_active && ws) {
            cancel_active_notification(ws, "power_key_sleep_pending");
        }
        ESP_LOGI(TAG,
                 "local power sleep deferred capture_busy=%d notification=%d speaker_pending=%d speaker_generation=%lu",
                 capture_busy ? 1 : 0,
                 notification_active ? 1 : 0,
                 speaker_pending ? 1 : 0,
                 (unsigned long)speaker_generation);
        return NUWAX_SLEEP_REQUEST_STARTED;
    }
    const nuwax_sleep_request_result_t result =
        nuwax_sleep_transaction_request_local(
            &s_sleep_transaction,
            monotonic_ms(),
            NUWAX_SLEEP_TRANSACTION_TIMEOUT_MS,
            speaker_generation,
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING);
    if (result != NUWAX_SLEEP_REQUEST_STARTED) {
        ESP_LOGI(TAG,
                 "local power sleep request result=%d state=%s reason=%s",
                 (int)result,
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 reason ? reason : "-");
        return result;
    }

    const uint32_t token = s_sleep_transaction.token;
    (void)nuwax_sleep_transaction_begin_quiescing(
        &s_sleep_transaction, token);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
#endif
    cancel_auto_followup_capture(reason ? reason : "power_key_sleep");
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    s_post_playback_resume_pending = false;

    if (!conversation_capture_busy_for_sleep()) {
        (void)nuwax_sleep_transaction_mark_capture_released(
            &s_sleep_transaction, token);
        (void)nuwax_sleep_transaction_mark_protocol_closed(
            &s_sleep_transaction, token, ws_epoch);
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (speaker_generation != 0U) {
        nuwax_speaker_cancel_request_result_t cancel = {0};
        (void)nuwax_speaker_playback_request_cancel_generation_ex(
            speaker_generation,
            reason ? reason : "power_key_sleep",
            NUWAX_SLEEP_TRANSACTION_SPEAKER_FADE_MS,
            &cancel);
        if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
            cancel.completed_stop_result == ESP_OK) {
            (void)nuwax_sleep_transaction_mark_speaker_stopped(
                &s_sleep_transaction,
                token,
                ws_epoch,
                speaker_generation);
        } else if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_FAILED) {
            s_speaker_fault_recovery_epoch = cancel.connection_epoch;
            s_speaker_fault_recovery_generation =
                cancel.playback_generation;
        }
    }
#endif
    ESP_LOGI(TAG,
             "local power sleep transaction requested token=%lu epoch=%lu speaker_generation=%lu reason=%s capture_busy=%d",
             (unsigned long)token,
             (unsigned long)ws_epoch,
             (unsigned long)speaker_generation,
             reason ? reason : "-",
             conversation_capture_busy_for_sleep() ? 1 : 0);
    service_sleep_transaction();
    return result;
}

static nuwax_sleep_request_result_t request_remote_sleep_transaction(
    nuwax_ws_client_t *ws,
    const char *request_id,
    const char *command,
    const char *turn_id) {
    if (!ws) {
        return NUWAX_SLEEP_REQUEST_INVALID;
    }
    const uint32_t ws_epoch = nuwax_ws_connection_epoch(ws);
    if (ws_epoch == 0U || ws_epoch != active_ws_epoch_snapshot()) {
        return NUWAX_SLEEP_REQUEST_INVALID;
    }

    if (s_sleep_transaction.active ||
        s_sleep_transaction.state != NUWAX_SLEEP_TRANSACTION_IDLE) {
        return begin_remote_sleep_transaction_bound(ws_epoch,
                                                    request_id,
                                                    command,
                                                    turn_id);
    }

    if (s_deferred_sleep_intent.active) {
        return nuwax_deferred_sleep_intent_request(
            &s_deferred_sleep_intent,
            monotonic_ms(),
            NUWAX_SLEEP_AFTER_PLAYBACK_START_TIMEOUT_MS,
            ws_epoch,
            request_id,
            command,
            turn_id,
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING);
    }

    const remote_sleep_scope_result_t scope_result =
        remote_sleep_scope_current_owner(turn_id);
    if (scope_result == REMOTE_SLEEP_SCOPE_CONFLICT) {
        ESP_LOGW(TAG,
                 "stale sleep command rejected request=%s turn=%s active_turn=%s terminal_turn=%s state=%s",
                 request_id ? request_id : "-",
                 turn_id && turn_id[0] ? turn_id : "-",
                 s_turn_guard.active && s_turn_guard.turn_id[0]
                     ? s_turn_guard.turn_id
                     : "-",
                 s_playback_terminal_guard.active &&
                         s_playback_terminal_guard.turn_id[0]
                     ? s_playback_terminal_guard.turn_id
                     : "-",
                 nuwax_app_state_name(conversation_state_current()));
        return NUWAX_SLEEP_REQUEST_STALE_SCOPE;
    }
    if (scope_result == REMOTE_SLEEP_SCOPE_OWNER_UNBOUND) {
        ESP_LOGI(TAG,
                 "scoped sleep accepted while current capture owner is not yet turn-bound request=%s turn=%s state=%s",
                 request_id ? request_id : "-",
                 turn_id && turn_id[0] ? turn_id : "-",
                 nuwax_app_state_name(conversation_state_current()));
    }

    if (!remote_sleep_reply_is_in_progress(turn_id)) {
        return begin_remote_sleep_transaction_bound(ws_epoch,
                                                    request_id,
                                                    command,
                                                    turn_id);
    }

    const nuwax_sleep_request_result_t result =
        nuwax_deferred_sleep_intent_request(
            &s_deferred_sleep_intent,
            monotonic_ms(),
            NUWAX_SLEEP_AFTER_PLAYBACK_START_TIMEOUT_MS,
            ws_epoch,
            request_id,
            command,
            turn_id,
            false);
    if (result != NUWAX_SLEEP_REQUEST_STARTED) {
        return result;
    }

    cancel_auto_followup_capture("sleep_after_playback_intent");
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    s_post_playback_resume_pending = false;
    portENTER_CRITICAL(&s_wake_stop_handoff_lock);
    s_during_playback_wake_stop_pending = false;
    s_during_playback_wake_stop_playback_started = false;
    portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    inhibit_sleep_wake_word_detector("sleep_after_playback_intent");
    if (nuwax_wake_word_detector_is_running()) {
        nuwax_wake_word_detector_request_stop();
    }
#endif
    ESP_LOGI(TAG,
             "sleep-after-playback intent retained token=%lu epoch=%lu request=%s turn=%s deadline_ms=%lu capture_busy=%d speaker_pending=%d",
             (unsigned long)s_deferred_sleep_intent.token,
             (unsigned long)ws_epoch,
             request_id,
             turn_id && turn_id[0] ? turn_id : "-",
             (unsigned long)s_deferred_sleep_intent.deadline_ms,
             conversation_capture_busy_for_sleep() ? 1 : 0,
#if CONFIG_NUWAX_SPEAKER_ENABLE
             nuwax_speaker_playback_has_pending() ? 1 : 0
#else
             0
#endif
    );
    return result;
}

static void service_pending_sleep_request(void) {
    if (!s_sleep_request_pending) {
        return;
    }
    if (meeting_or_monitoring_mode_blocks_sleep()) {
        ESP_LOGI(TAG,
                 "deferred sleep discarded while exclusive audio mode owns lifecycle reason=%s meeting=%d monitoring=%d",
                 s_sleep_request_reason[0] ? s_sleep_request_reason : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
        clear_sleep_request();
        return;
    }
    if (conversation_capture_busy_for_sleep()) {
        return;
    }

    if (s_sleep_request_local_power) {
        /* A local key request may arrive while a notification still owns the
         * downlink.  Cancel that owner first; letting both transactions
         * commit independently can re-arm wake capture underneath the other
         * transaction and produce a false timeout. */
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (nuwax_notification_blocks_conversation(
                &s_notification_transaction)) {
            if (ws) {
                cancel_active_notification(ws, "power_key_sleep_pending");
            }
            return;
        }

#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (nuwax_speaker_playback_has_pending()) {
            /* Keep cancellation asynchronous.  The speaker task owns the
             * physical I2S stop, while this owner only observes its
             * generation-bound completion. */
            remember_local_power_sleep_request(
                ws, s_sleep_request_reason[0]
                         ? s_sleep_request_reason
                         : "power_key_sleep");
            return;
        }
#endif
        /* Capture is already released and the speaker has no pending owner;
         * this is the first point at which it is safe to enter the normal
         * sleep commit path. */
    }
    if (s_sleep_request_requires_idle_expiry &&
        nuwax_listen_resume_state_holds_idle_expiry_boundary(
            &s_listen_resume)) {
        ESP_LOGI(TAG,
                 "redundant deferred idle sleep transferred to post-END watchdog generation=%lu session=%s",
                 (unsigned long)s_sleep_request_awake_generation,
                 s_listen_resume.audio_session_id[0]
                     ? s_listen_resume.audio_session_id
                     : "-");
        clear_sleep_request();
        return;
    }
    const uint32_t current_awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (s_sleep_request_requires_idle_expiry &&
        !nuwax_awake_session_state_can_commit_deferred_idle_sleep(
            &s_awake_session,
            s_sleep_request_awake_generation,
            monotonic_ms(),
            conversation_state_current() == NUWAX_APP_STATE_LISTENING,
            s_turn_guard.active,
#if CONFIG_NUWAX_SPEAKER_ENABLE
            nuwax_speaker_playback_has_pending(),
#else
            false,
#endif
            false
            )) {
        ESP_LOGW(TAG,
                 "deferred local sleep request discarded without idle authority request_generation=%lu current_generation=%lu reason=%s",
                 (unsigned long)s_sleep_request_awake_generation,
                 (unsigned long)current_awake_generation,
                 s_sleep_request_reason[0] ? s_sleep_request_reason : "-");
        clear_sleep_request();
        return;
    }
    char reason[sizeof(s_sleep_request_reason)] = {0};
    strlcpy(reason,
            s_sleep_request_reason[0] ? s_sleep_request_reason : "sleep",
            sizeof(reason));
    /* commit_sleeping_conversation_state() owns the successful transition and
     * clears the request only after its admission checks pass.  Do not clear
     * here first: an exclusive mode can become active between the checks above
     * and the commit, in which case the local power intent must remain queued. */
    if (!commit_sleeping_conversation_state(reason)) {
        ESP_LOGI(TAG,
                 "deferred sleep commit remained pending after admission race reason=%s",
                 reason);
    }
}

static void request_sleeping_conversation_state(const char *reason) {
    /* A network ownership transfer is not a conversation sleep transition. */
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        return;
    }
    if (meeting_or_monitoring_mode_blocks_sleep()) {
        /* If the cloud-bound controllers are already DISABLED, the only
         * remaining blocker is a transient offline/replay owner.  Preserve
         * the intent so it can be committed when that owner releases. */
        if (exclusive_audio_controllers_released()) {
            s_exclusive_audio_sleep_reconcile_pending = true;
        }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        clear_sleep_request();
        ESP_LOGI(TAG,
                 "sleep request deferred while exclusive audio mode owns lifecycle reason=%s meeting=%d monitoring=%d offline_lease=%d capture=%d archive=%d replay=%d",
                 reason ? reason : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode),
                 offline_mode_lease_pending() ? 1 : 0,
                 nuwax_offline_audio_capture_running() ? 1 : 0,
                 nuwax_offline_audio_is_active() ? 1 : 0,
                 nuwax_offline_audio_replay_running() ? 1 : 0);
#else
        clear_sleep_request();
        ESP_LOGI(TAG,
                 "sleep request deferred while exclusive audio mode owns lifecycle reason=%s meeting=%d monitoring=%d",
                 reason ? reason : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
#endif
        return;
    }
    if (reason && strcmp(reason, "awake_idle_timeout") == 0 &&
        nuwax_listen_resume_state_holds_idle_expiry_boundary(
            &s_listen_resume)) {
        ESP_LOGI(TAG,
                 "awake idle sleep deferred to post-END watchdog session=%s generation=%lu",
                 s_listen_resume.audio_session_id[0]
                     ? s_listen_resume.audio_session_id
                     : "-",
                 (unsigned long)s_listen_resume.awake_generation);
        return;
    }
    if (s_deferred_sleep_intent.active) {
        (void)service_deferred_remote_sleep_intent(
            reason ? reason : "local_sleep_join", false);
        ESP_LOGI(TAG,
                 "local sleep request joined sleep-after-playback intent token=%lu active=%d reason=%s",
                 (unsigned long)s_deferred_sleep_intent.token,
                 s_deferred_sleep_intent.active ? 1 : 0,
                 reason ? reason : "-");
        return;
    }
    if (s_sleep_transaction.active) {
        /* A semantic remote request owns the lifecycle until its three
         * quiescence conditions converge. Internal timeout paths must not
         * bypass that transaction or publish a second sleeping transition. */
        service_sleep_transaction();
        ESP_LOGI(TAG,
                 "local sleep request joined active remote transaction token=%lu state=%s reason=%s",
                 (unsigned long)s_sleep_transaction.token,
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 reason ? reason : "-");
        return;
    }
    if (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING) {
        if (nuwax_sleep_transaction_requires_local_sleep_reconcile(
                &s_sleep_transaction,
                conversation_state_current() == NUWAX_APP_STATE_SLEEPING)) {
            ESP_LOGW(TAG,
                     "reconciling local sleeping state after transport recovery reason=%s transaction_epoch=%lu active_epoch=%lu",
                     reason ? reason : "-",
                     (unsigned long)s_sleep_transaction.ws_epoch,
                     (unsigned long)active_ws_epoch_snapshot());
            commit_sleeping_conversation_state(
                reason ? reason : "sleep_state_reconcile");
        }
        return;
    }
    if (conversation_capture_busy_for_sleep()) {
        remember_sleep_request(reason);
        cancel_auto_followup_capture(reason ? reason : "sleep");
        ESP_LOGI(TAG,
                 "conversation sleep deferred until capture owner releases reason=%s starting=%d active=%d",
                 reason ? reason : "-",
                 atomic_load_explicit(&s_conversation_capture_starting,
                                      memory_order_acquire) ? 1 : 0,
                 atomic_load_explicit(&s_conversation_capture_runtime_active,
                                      memory_order_acquire) ? 1 : 0);
        return;
    }
    if (s_sleep_request_pending) {
        service_pending_sleep_request();
        return;
    }
    commit_sleeping_conversation_state(reason);
}

#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
static bool set_low_battery_warning(bool visible)
{
    if (s_low_battery_warning_visible == visible) return true;
    if (!ui_ready_snapshot() || !nuwax_lvgl_port_lock(20U)) return false;
    const esp_err_t err = nuwax_low_battery_warning_show(visible);
    nuwax_lvgl_port_unlock();
    if (err != ESP_OK) return false;
    s_low_battery_warning_visible = visible;
    return true;
}

/* Application-owner only. The battery task publishes measurements; it never
 * powers off, stops audio, or takes ownership of LVGL's lifecycle. */
static bool service_low_battery_sampler_restart(void)
{
    if (!s_low_battery_sampler_restart_pending) return true;
    if (s_low_battery_sampler_stopping) {
        if (nuwax_battery_service_stop(0U) != ESP_OK) return false;
        s_low_battery_sampler_stopping = false;
    }
    if (start_battery_service_for_ui() != ESP_OK) return false;
    s_low_battery_sampler_restart_pending = false;
    return true;
}

static void service_low_battery_shutdown(void)
{
    if (!service_low_battery_sampler_restart()) return;
    if (s_power_shutdown_requested) return;
    nuwax_battery_service_snapshot_t sample = {0};
    (void)nuwax_battery_service_get_snapshot(&sample);
    const uint64_t now = (uint64_t)esp_timer_get_time() / 1000U;
    const bool was_warning = s_low_battery_policy.warning;
    const nuwax_low_battery_shutdown_action_t action =
        nuwax_low_battery_shutdown_update(&s_low_battery_policy, &sample, now,
                                         nuwax_power_ctrl_shutdown_is_inhibited());
    if (action == NUWAX_LOW_BATTERY_IDLE) {
        if (was_warning) {
            nuwax_power_ctrl_abort_shutdown();
            ESP_LOGI(TAG, "low battery warning cancelled soc=%u current=%d charging=%d valid=%d",
                     sample.percent, sample.current_ma, sample.charging, sample.valid);
        }
        (void)set_low_battery_warning(false);
        return;
    }
    if (!was_warning) {
        if (!nuwax_power_ctrl_prepare_shutdown()) {
            s_low_battery_policy = (nuwax_low_battery_shutdown_policy_t){0};
            return;
        }
        ESP_LOGW(TAG, "low battery warning revision=low-battery-v1 soc=%u display=%u current=%d voltage=%u notice_ms=%u",
                 sample.percent, sample.display_percent, sample.current_ma,
                 sample.voltage_mv, NUWAX_LOW_BATTERY_WARNING_MS);
    }
    const bool reminder_was_visible = s_low_battery_warning_visible;
    const bool reminder_shown = set_low_battery_warning(true);
    if (!reminder_shown && ui_ready_snapshot()) {
        /* A contended UI must not consume the user's five-second reminder. */
        s_low_battery_policy.warning_since_ms = now;
        return;
    }
    if (reminder_shown && !reminder_was_visible) {
        s_low_battery_policy.warning_since_ms = now;
        return;
    }
    if (action == NUWAX_LOW_BATTERY_COMMIT) {
        s_low_battery_shutdown_owned = true;
        s_power_shutdown_requested = true;
        s_power_shutdown_mode_stop_requested = false;
        ESP_LOGW(TAG, "low battery shutdown confirmed by fresh sample; draining audio and SD before power-off");
    }
}

static bool low_battery_confirm_before_power_off(bool rearm_wake)
{
    if (!s_low_battery_shutdown_owned) return true;
    nuwax_battery_service_snapshot_t sample = {0};
    (void)nuwax_battery_service_get_snapshot(&sample);
    if (nuwax_low_battery_shutdown_required(
            &sample, (uint64_t)esp_timer_get_time() / 1000U)) return true;
    /* stop(0) is asynchronous. A late charger/stale-sample cancellation must
     * reap that task before reopening normal operation, then restart sampling.
     * Otherwise is_running() may report a task that is already stopping. */
    if (s_low_battery_sampler_stopping) {
        if (nuwax_battery_service_stop(0U) != ESP_OK) return false;
        s_low_battery_sampler_stopping = false;
        s_low_battery_sampler_restart_pending = true;
    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (nuwax_offline_audio_cancel_shutdown() != ESP_OK) return false;
#endif
    nuwax_power_ctrl_abort_shutdown();
    s_power_shutdown_requested = false;
    s_power_shutdown_mode_stop_requested = false;
    s_low_battery_shutdown_owned = false;
    s_low_battery_policy = (nuwax_low_battery_shutdown_policy_t){0};
    (void)service_low_battery_sampler_restart();
    (void)set_low_battery_warning(false);
    if (rearm_wake && conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        request_sleep_wake_word_detector("low_battery_shutdown_cancelled");
    }
    ESP_LOGI(TAG, "low battery shutdown cancelled after safe drain soc=%u current=%d valid=%d; normal operation restored",
             sample.percent, sample.current_ma, sample.valid);
    return false;
}

static void service_boot_low_battery_gate(void)
{
    /* The UI and gauge now exist, but Wi-Fi, microphone capture and normal
     * business have not started. A genuine empty-cell boot ends here. */
    const uint64_t started = (uint64_t)esp_timer_get_time() / 1000U;
    ESP_LOGI(TAG, "low battery boot gate threshold=1%% notice_ms=%u charging_bypass=measured sample_wait_ms=5000",
             NUWAX_LOW_BATTERY_WARNING_MS);
    for (;;) {
        nuwax_battery_service_snapshot_t sample = {0};
        (void)nuwax_battery_service_get_snapshot(&sample);
        const uint64_t now = (uint64_t)esp_timer_get_time() / 1000U;
        /* Do not prevent a pending OTA image from completing its existing
         * local/cloud health validation. Runtime resumes this guard after
         * that owner's interlock is released; never force-cut a Flash write. */
        const uint32_t inhibitors = nuwax_power_ctrl_shutdown_inhibit_owners();
        if (inhibitors == NUWAX_POWER_INHIBIT_BATTERY_PROFILE && now-started < 5000U) {
            vTaskDelay(pdMS_TO_TICKS(20));
            continue;
        }
        if (inhibitors != 0U) {
            ESP_LOGI(TAG, "low battery boot gate deferred to protected owner mask=0x%lx",
                     (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
            return;
        }
        service_low_battery_shutdown();
        if (s_power_shutdown_requested && s_low_battery_shutdown_owned) {
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            if (nuwax_offline_audio_prepare_shutdown() != ESP_OK) {
                vTaskDelay(pdMS_TO_TICKS(20));
                continue;
            }
#endif
            if (!low_battery_confirm_before_power_off(false)) {
                if (!s_power_shutdown_requested) return;
                vTaskDelay(pdMS_TO_TICKS(20));
                continue;
            }
            s_low_battery_sampler_stopping = true;
            if (nuwax_battery_service_stop(0U) == ESP_OK) {
                if (!nuwax_power_ctrl_commit_shutdown(false)) {
                    s_low_battery_sampler_restart_pending = true;
                    (void)service_low_battery_sampler_restart();
                }
            }
            vTaskDelay(pdMS_TO_TICKS(20));
            continue;
        }
        if (!s_low_battery_policy.warning &&
            (nuwax_low_battery_sample_fresh(&sample, now) || now-started >= 5000U)) {
            return;
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
}
#endif

static void service_power_key_events(nuwax_ws_client_t *ws) {
    const uint32_t events = (uint32_t)atomic_exchange_explicit(
        &s_power_key_events, 0U, memory_order_acq_rel);
    const bool long_press_event =
        (events & NUWAX_POWER_EVENT_LONG_MASK) != 0U;

    /* A long-press notification and its release can be coalesced with a
     * pending short event in the atomic mailbox. Long press owns that sample;
     * never start a normal sleep transaction from the same physical gesture. */
    if (long_press_event) {
        const nuwax_app_state_t state = conversation_state_current();
        #if CONFIG_NUWAX_OTA_ENABLE
        const bool ota_busy = nuwax_ota_device_is_active();
        #else
        const bool ota_busy = false;
        #endif
        if (ota_busy || !nuwax_power_ctrl_prepare_shutdown()) {
            ESP_LOGW(TAG,
                     "power key long press rejected while protected operation is active ota=%d inhibit=0x%lx",
                     ota_busy ? 1 : 0,
                     (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
            s_power_shutdown_requested = false;
        } else {
            ESP_LOGI(TAG,
                     "power key long press accepted state=%s; waiting for quiescence (release not required)",
                     nuwax_app_state_name(state));
            s_power_shutdown_requested = true;
            s_power_shutdown_mode_stop_requested = false;
#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
            /* A deliberate power-key request supersedes automatic recovery. */
            s_low_battery_shutdown_owned = false;
#endif
        }
    }

    if ((events & NUWAX_POWER_EVENT_SHORT_MASK) && !long_press_event) {
        const nuwax_app_state_t state = conversation_state_current();
        #if CONFIG_NUWAX_OTA_ENABLE
        const bool ota_busy = nuwax_ota_device_is_active();
        #else
        const bool ota_busy = false;
        #endif
        const bool protected_operation =
            ota_busy || nuwax_power_ctrl_shutdown_is_inhibited();
        const bool dialogue_state =
            power_key_short_press_dialogue_state(state);
        /* A mode can be pending before its controller claims the audio owner.
         * Treat both pending and active exclusive modes as non-dialogue so a
         * short press cannot race a meeting/monitoring handoff into sleep. */
        const bool exclusive_mode =
            exclusive_audio_owner_active() ||
            exclusive_audio_mode_blocks_normal_audio();
        if (!protected_operation && !s_power_shutdown_requested &&
            dialogue_state && !exclusive_mode) {
            (void)begin_local_power_sleep_transaction(
                ws, "power_key_short_press");
        } else {
            ESP_LOGI(TAG,
                     "power key short press ignored state=%s dialogue=%d shutdown=%d exclusive=%d protected=%d",
                     nuwax_app_state_name(state),
                     dialogue_state ? 1 : 0,
                     s_power_shutdown_requested ? 1 : 0,
                     exclusive_mode ? 1 : 0,
                     protected_operation ? 1 : 0);
        }
    }

    if (events & NUWAX_POWER_EVENT_RELEASE_MASK) {
        if (s_power_shutdown_requested) {
            ESP_LOGI(TAG,
                     "power key long release observed after shutdown request");
        }
    }

#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
    service_low_battery_shutdown();
#endif
    if (!s_power_shutdown_requested) {
        return;
    }

#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    /* Close archive/replay admission immediately. Recording owners still
     * receive their ordinary stop below; the barrier is polled, never waited
     * synchronously on the application/UI owner. */
    (void)nuwax_offline_audio_prepare_shutdown();
#endif

    if (meeting_or_monitoring_mode_blocks_sleep() ||
        exclusive_audio_owner_active()) {
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        if (offline_mode_lease_pending() ||
            nuwax_offline_audio_capture_running() ||
            nuwax_offline_audio_is_active()) {
            (void)nuwax_offline_audio_request_stop(false);
            if (!nuwax_offline_audio_capture_running() &&
                !nuwax_offline_audio_is_active()) {
                offline_mode_lease_store(false);
            }
            /* Physical long-press shutdown is allowed to supersede an
             * offline archive owner, but only after the owner has received a
             * stop request and released its MIC/file resources. */
            if (nuwax_offline_audio_capture_running() ||
                nuwax_offline_audio_is_active()) {
                return;
            }
        }
#endif
        if (!s_power_shutdown_mode_stop_requested && ws) {
            const esp_err_t meeting_stop =
                nuwax_meeting_mode_request_handoff_stop(
                    &s_meeting_mode, ws, "power_key_shutdown");
            const esp_err_t monitoring_stop =
                nuwax_monitoring_mode_request_handoff_stop(
                    &s_monitoring_mode, ws, "power_key_shutdown");
            s_power_shutdown_mode_stop_requested =
                meeting_stop == ESP_OK || monitoring_stop == ESP_OK;
        }
        return;
    }

    if (s_sleep_request_pending) {
        /* A local power request may be waiting for the capture/speaker owner
         * to release.  Do not create a second transaction while that pending
         * request is converging, especially for a long press whose shutdown
         * bit is already latched. */
        service_pending_sleep_request();
        if (s_sleep_request_pending) {
            return;
        }
    }

    if (s_sleep_transaction.active || s_deferred_sleep_intent.active) {
        /* A remote or deferred sleep owner already holds the lifecycle. Let
         * its token-bound barriers converge before the physical rail can be
         * released by this independent long-press request. */
        service_sleep_transaction();
        return;
    }

    if (conversation_state_current() != NUWAX_APP_STATE_SLEEPING &&
        s_sleep_transaction.state != NUWAX_SLEEP_TRANSACTION_SLEEPING) {
        (void)begin_local_power_sleep_transaction(
            ws, "power_key_shutdown_quiesce");
        return;
    }

    /* Software sleep owns the wake-word microphone. Stop that owner before
     * the hardware power latch is released; otherwise the detector can still
     * touch I2S during the final rail-collapse quiet interval. */
    if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        stop_sleep_wake_word_detector("power_key_shutdown");
    }

    if (conversation_capture_busy_for_sleep() ||
        s_prelisten.capture_active) {
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        return;
    }
#endif
    if (nuwax_power_ctrl_shutdown_is_inhibited()) {
        ESP_LOGW(TAG,
                 "power key shutdown deferred because a protected owner appeared after acceptance owners=0x%lx",
                 (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
        s_power_shutdown_requested = false;
        return;
    }

#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (nuwax_offline_audio_prepare_shutdown() != ESP_OK) return;
#endif
#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
    if (!low_battery_confirm_before_power_off(true)) return;
    if (s_low_battery_shutdown_owned) s_low_battery_sampler_stopping = true;
    if (nuwax_battery_service_stop(0U) != ESP_OK) return;
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!nuwax_speaker_playback_service_volume_persistence(true)) {
        ESP_LOGW(TAG, "shutdown volume save pending after bounded attempt");
    }
#endif
    if (nuwax_power_ctrl_commit_shutdown(false)) {
        s_power_shutdown_requested = false;
        s_power_shutdown_mode_stop_requested = false;
#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
    } else if (s_low_battery_shutdown_owned) {
        s_low_battery_sampler_restart_pending = true;
        (void)service_low_battery_sampler_restart();
#endif
    }
}

static bool commit_sleeping_conversation_state(const char *reason) {
    if (meeting_or_monitoring_mode_blocks_sleep()) {
        ESP_LOGW(TAG,
                 "sleep commit blocked by exclusive audio mode reason=%s meeting=%d monitoring=%d",
                 reason ? reason : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
        return false;
    }
    s_exclusive_audio_sleep_reconcile_pending = false;
    clear_deferred_shell_listen_actions(reason ? reason : "sleep");
    clear_sleep_request();
    clear_awake_session(reason ? reason : "sleep");
    clear_last_listen_resume();
    clear_auto_followup(reason ? reason : "sleep");
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    portENTER_CRITICAL(&s_wake_stop_handoff_lock);
    s_during_playback_wake_stop_pending = false;
    s_during_playback_wake_stop_playback_started = false;
    portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
    s_post_playback_resume_pending = false;
    if (s_prelisten.pending || s_prelisten.capture_active) {
        cancel_auto_followup_capture(reason ? reason : "sleep");
    } else {
        nuwax_prelisten_state_clear_cancel(&s_prelisten);
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_release_idle_output(reason ? reason : "sleep");
#endif
    const esp_err_t aec_suspend_err =
        conversation_live_aec_pool_suspend("sleep");
    if (aec_suspend_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "sleep could not release idle live AEC reservation: %s",
                 esp_err_to_name(aec_suspend_err));
    }
    nuwax_app_shell_close_overlays();
    const uint32_t wake_arm_started_ms = monotonic_ms();
    bool wake_ready = false;
    if (s_power_shutdown_requested) {
        /* A long physical press is already committed to hardware shutdown.
         * Do not start the wake detector only to stop it again in the next
         * service pass; that creates an avoidable I2S ownership race at the
         * exact moment the power rail is about to be released. */
        inhibit_sleep_wake_word_detector("power_key_shutdown_pending");
        wake_ready = true;
        ESP_LOGI(TAG,
                 "conversation sleep wake detector skipped for pending hardware shutdown reason=%s",
                 reason ? reason : "sleep");
    } else {
        request_sleep_wake_word_detector(reason ? reason : "sleep");
        wake_ready = wait_for_sleep_wake_word_ready(
            NUWAX_WAKE_READY_WAIT_MS);
    }
    set_conversation_status_guarded("SLEEP", "WAKE", "hold to wake", true);
    set_state(NUWAX_APP_STATE_SLEEPING);
    if (!wake_ready) {
        ESP_LOGW(TAG,
                 "conversation sleep committed after bounded wake arm timeout timeout_ms=%u; wake supervisor will retry reason=%s",
                 (unsigned)NUWAX_WAKE_READY_WAIT_MS,
                 reason ? reason : "-");
    } else {
        ESP_LOGI(TAG,
                 "conversation sleep wake detector ready before state publish latency_ms=%lu reason=%s",
                 (unsigned long)(monotonic_ms() - wake_arm_started_ms),
                 reason ? reason : "-");
    }
    ESP_LOGI(TAG, "conversation sleep state reason=%s", reason ? reason : "-");
    return true;
}

static void enter_sleeping_conversation_state(const char *reason) {
    request_sleeping_conversation_state(reason);
}

static void stop_sleep_wake_word_detector(const char *reason) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    inhibit_sleep_wake_word_detector(reason ? reason : "stop");
    if (nuwax_wake_word_detector_is_running()) {
        ESP_LOGI(TAG, "wake word detector stopping reason=%s", reason ? reason : "-");
        const esp_err_t stop_err =
            nuwax_wake_word_detector_stop_with_timeout(
                NUWAX_WAKE_WORD_STOP_TIMEOUT_MS);
        if (stop_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "wake detector ownership did not converge reason=%s err=%s; controlled restart prevents concurrent MIC owners",
                     reason ? reason : "-",
                     esp_err_to_name(stop_err));
            set_state(NUWAX_APP_STATE_ERROR);
            nuwax_diagnostics_log_heap_label(
                TAG, "wake_detector_stop_forced_restart");
            vTaskDelay(pdMS_TO_TICKS(100));
            esp_restart();
            vTaskDelay(portMAX_DELAY);
        }
    }
#else
    (void)reason;
#endif
}

#if CONFIG_NUWAX_MUSIC_URL_TEST_ENABLE
static bool music_url_test_product_idle(bool require_speaker_idle) {
    if (!cloud_service_is_ready() ||
        conversation_state_current() != NUWAX_APP_STATE_SLEEPING ||
        s_power_shutdown_requested || s_sleep_request_pending ||
        s_sleep_transaction.active || s_deferred_sleep_intent.active ||
        s_turn_guard.active ||
        nuwax_awake_session_state_is_active(&s_awake_session) ||
        s_prelisten.pending || s_prelisten.capture_active ||
        atomic_load_explicit(&s_conversation_capture_runtime_active,
                             memory_order_acquire) ||
        nuwax_audio_uplink_sender_busy() ||
        nuwax_audio_terminal_recovery_pending() ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        nuwax_provision_main_is_active() ||
        exclusive_audio_mode_blocks_normal_audio() ||
        nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        return false;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active() || nuwax_ota_device_blocks_audio()) {
        return false;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (require_speaker_idle && nuwax_speaker_playback_has_pending()) {
        return false;
    }
#else
    (void)require_speaker_idle;
#endif
    return true;
}

/* Called only by app_main. This preserves the existing ownership rule: the
 * HTTP worker can stream bytes, but only the conversation owner may pause or
 * restore wake capture and admit the one-shot test. */
static bool service_music_url_test(bool allow_start) {
    const bool cloud_ready = cloud_service_is_ready();
    const uint32_t now_ms = monotonic_ms();
    nuwax_music_url_test_observe_cloud_ready(cloud_ready, now_ms);

    esp_err_t terminal_result = ESP_ERR_INVALID_STATE;
    if (nuwax_music_url_test_take_terminal(&terminal_result)) {
        ESP_LOGI(TAG,
                 "music URL test completed result=%s restoring_wake=%d",
                 esp_err_to_name(terminal_result),
                 s_music_url_test_wake_inhibited ? 1 : 0);
        if (s_music_url_test_wake_inhibited) {
            s_music_url_test_wake_inhibited = false;
            request_sleep_wake_word_detector("music_url_test_complete");
        }
    }

    if (nuwax_music_url_test_active()) {
        bool preempt = !music_url_test_product_idle(false);
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.pending &&
            stats.active_owner != NUWAX_SPEAKER_PLAYBACK_OWNER_URL_TEST) {
            preempt = true;
        }
        if (preempt) {
            nuwax_music_url_test_request_stop("product_activity");
            if (s_music_url_test_wake_inhibited) {
                s_music_url_test_wake_inhibited = false;
                request_sleep_wake_word_detector(
                    "music_url_test_preempted");
            }
            return false;
        }
        return true;
    }

    if (!allow_start ||
        !nuwax_music_url_test_delay_elapsed(now_ms) ||
        !music_url_test_product_idle(true)) {
        return false;
    }

    stop_sleep_wake_word_detector("music_url_test_start");
    s_music_url_test_wake_inhibited = true;
    /* Recheck after the bounded detector stop. A cloud command may have won
     * while MIC ownership was converging. */
    if (!music_url_test_product_idle(true)) {
        s_music_url_test_wake_inhibited = false;
        request_sleep_wake_word_detector("music_url_test_admission_lost");
        return false;
    }

    const esp_err_t start_err = nuwax_music_url_test_start();
    if (start_err != ESP_OK) {
        ESP_LOGW(TAG, "music URL test start failed: %s",
                 esp_err_to_name(start_err));
        s_music_url_test_wake_inhibited = false;
        request_sleep_wake_word_detector("music_url_test_start_failed");
        return false;
    }
    ESP_LOGI(TAG,
             "music URL test admitted after cloud-ready delay; product state remains sleeping");
    return true;
}
#else
static bool service_music_url_test(bool allow_start) {
    (void)allow_start;
    return false;
}
#endif

static void start_prelisten_window(const char *mode, uint32_t window_ms, uint32_t ready_delay_ms) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    clear_tts_skip_emotion_window("prelisten_window_start");
    if (sleep_lifecycle_blocks_new_capture()) {
        ESP_LOGI(TAG,
                 "prelisten window blocked by sleep lifecycle mode=%s state=%s deferred_token=%lu",
                 mode ? mode : "-",
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 (unsigned long)s_deferred_sleep_intent.token);
        return;
    }
    if ((!mode || strcmp(mode, "during_playback") != 0) &&
        nuwax_playback_terminal_guard_waiting(
            &s_playback_terminal_guard)) {
        return;
    }
    if (!mode || strcmp(mode, "during_playback") != 0) {
        clear_active_turn_guard("new_listen_window");
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_release_idle_output("prelisten_window");
#endif
    stop_sleep_wake_word_detector("prelisten_window");
    const uint32_t now_ms = monotonic_ms();
    nuwax_prelisten_state_start_window(&s_prelisten, mode, now_ms, window_ms, ready_delay_ms);
    set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
    set_state(NUWAX_APP_STATE_LISTENING);
    ESP_LOGI(TAG,
             "conversation prelisten pending mode=%s window_ms=%lu grace_ms=%lu",
             nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
             (unsigned long)(window_ms == 0 ? 1 : window_ms),
             (unsigned long)ready_delay_ms);
#else
    (void)mode;
    (void)window_ms;
    (void)ready_delay_ms;
#endif
}

static void arm_during_playback_capture(const char *reason,
                                        bool playback_started) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_BARGE_IN_ENABLE
    if (sleep_lifecycle_blocks_new_capture()) {
        return;
    }
    if (s_prelisten.pending || s_prelisten.capture_active) {
        return;
    }
    if (nuwax_wake_word_detector_is_running()) {
        inhibit_sleep_wake_word_detector(
            reason ? reason : "during_playback_capture");
        portENTER_CRITICAL(&s_wake_stop_handoff_lock);
        s_during_playback_wake_stop_pending = true;
        s_during_playback_wake_stop_playback_started |= playback_started;
        portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
        nuwax_wake_word_detector_request_stop();
        ESP_LOGI(TAG,
                 "conversation during-playback capture waiting for asynchronous wake detector stop reason=%s",
                 reason ? reason : "-");
        return;
    }
    portENTER_CRITICAL(&s_wake_stop_handoff_lock);
    s_during_playback_wake_stop_pending = false;
    s_during_playback_wake_stop_playback_started = false;
    portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
    const bool shell_active = nuwax_app_shell_blocks_auto_followup();
    if (shell_active) {
        ESP_LOGI(TAG,
                 "during-playback barge-in capture overrides menu block reason=%s menu_active=1",
                 reason ? reason : "-");
    }
    const uint32_t now_ms = monotonic_ms();
    const uint32_t window_ms = awake_session_listen_window_ms(now_ms);
    nuwax_prelisten_state_start_capture(&s_prelisten,
                                        "during_playback",
                                        now_ms,
                                        window_ms,
                                        false);
    metrics_begin_prelisten(nuwax_prelisten_state_mode_or(&s_prelisten, "during_playback"),
                            reason ? reason : "during_playback");
    ESP_LOGI(TAG,
             "conversation during-playback capture armed window_ms=%lu reason=%s",
             (unsigned long)window_ms,
             reason ? reason : "-");
#else
    (void)reason;
    (void)playback_started;
#endif
}

static void complete_during_playback_wake_stop(void) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_BARGE_IN_ENABLE
    if (nuwax_wake_word_detector_is_running()) {
        return;
    }
    bool claimed = false;
    bool playback_started = false;
    portENTER_CRITICAL(&s_wake_stop_handoff_lock);
    if (s_during_playback_wake_stop_pending) {
        claimed = true;
        playback_started = s_during_playback_wake_stop_playback_started;
        s_during_playback_wake_stop_pending = false;
        s_during_playback_wake_stop_playback_started = false;
    }
    portEXIT_CRITICAL(&s_wake_stop_handoff_lock);
    if (!claimed) {
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool playback_pending = nuwax_speaker_playback_has_pending();
#else
    const bool playback_pending = false;
#endif
    if (!exclusive_audio_mode_blocks_normal_audio() &&
        (playback_started || playback_pending)) {
        arm_during_playback_capture("tts_wake_stop_complete", true);
    }
#endif
}

static void request_during_playback_capture(const char *reason, bool playback_started) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_BARGE_IN_ENABLE
    if (sleep_lifecycle_blocks_new_capture()) {
        return;
    }
    if (s_during_playback_handoff_pending) {
        if (playback_started) {
            s_during_playback_handoff_playback_started = true;
        }
        return;
    }
    if (s_prelisten.capture_active) {
        if (nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback")) {
            return;
        }
        s_during_playback_handoff_pending = true;
        s_during_playback_handoff_playback_started = playback_started;
        const bool seamless_awake_handoff =
            nuwax_awake_session_state_is_active(&s_awake_session);
        s_during_playback_handoff_seamless = seamless_awake_handoff;
        if (!seamless_awake_handoff) {
            cancel_auto_followup_capture("tts_start_handoff");
        }
        ESP_LOGI(TAG,
                 "conversation capture handoff requested from continuous uplink to during-playback prelisten reason=%s playback_started=%d seamless=%d",
                 reason ? reason : "-",
                 playback_started ? 1 : 0,
                 seamless_awake_handoff ? 1 : 0);
        return;
    }
    if (s_prelisten.pending) {
        clear_auto_followup("tts_start_replace_pending");
    }
    arm_during_playback_capture(reason, playback_started);
#elif CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    (void)playback_started;
    if (s_prelisten.pending || s_prelisten.capture_active) {
        cancel_auto_followup_capture(
            reason ? reason : "tts_start_voice_barge_disabled");
    }
#else
    (void)reason;
    (void)playback_started;
#endif
}

static void complete_during_playback_capture_handoff(void) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_BARGE_IN_ENABLE
    if (!s_during_playback_handoff_pending) {
        return;
    }
    const bool playback_started = s_during_playback_handoff_playback_started;
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
    nuwax_prelisten_state_clear_cancel(&s_prelisten);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool playback_pending = nuwax_speaker_playback_has_pending();
#else
    const bool playback_pending = false;
#endif
    if (!exclusive_audio_mode_blocks_normal_audio() &&
        (playback_started || playback_pending)) {
        ESP_LOGI(TAG,
                 "conversation capture handoff completed; arming during-playback prelisten playback_started=%d playback_pending=%d",
                 playback_started ? 1 : 0,
                 playback_pending ? 1 : 0);
        arm_during_playback_capture("tts_start_handoff_complete",
                                    playback_started || playback_pending);
    } else {
        ESP_LOGI(TAG,
                 "conversation capture handoff completed without rearm playback_started=%d playback_pending=%d exclusive_audio_mode=%d",
                 playback_started ? 1 : 0,
                 playback_pending ? 1 : 0,
                 exclusive_audio_mode_blocks_normal_audio() ? 1 : 0);
    }
#endif
}

static void start_prelisten_capture_now(const char *mode, uint32_t window_ms, const char *reason) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    clear_tts_skip_emotion_window("prelisten_capture_start");
    if (sleep_lifecycle_blocks_new_capture()) {
        ESP_LOGI(TAG,
                 "prelisten capture blocked by sleep lifecycle mode=%s reason=%s state=%s deferred_token=%lu",
                 mode ? mode : "-",
                 reason ? reason : "-",
                 nuwax_sleep_transaction_state_name(
                     s_sleep_transaction.state),
                 (unsigned long)s_deferred_sleep_intent.token);
        return;
    }
    if ((!mode || strcmp(mode, "during_playback") != 0) &&
        nuwax_playback_terminal_guard_waiting(
            &s_playback_terminal_guard)) {
        return;
    }
    if (!mode || strcmp(mode, "during_playback") != 0) {
        clear_active_turn_guard(reason ? reason : "new_listen_capture");
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_release_idle_output(reason ? reason : "capture_now");
#endif
    stop_sleep_wake_word_detector(reason ? reason : "capture_now");
    clear_last_listen_resume();
    clear_auto_followup(reason ? reason : "capture_now");
    nuwax_prelisten_state_start_capture(&s_prelisten,
                                        mode,
                                        monotonic_ms(),
                                        window_ms,
                                        false);
    metrics_begin_prelisten(nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                            reason ? reason : "capture_now");
    set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
    set_state(NUWAX_APP_STATE_LISTENING);
    ESP_LOGI(TAG,
             "conversation prelisten capture mode=%s window_ms=%lu",
             nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
             (unsigned long)(window_ms == 0 ? 1 : window_ms));
#else
    (void)mode;
    (void)window_ms;
    (void)reason;
#endif
}

static uint32_t activate_pending_prelisten_capture(uint32_t now_ms, const char *reason) {
    if (sleep_lifecycle_blocks_new_capture()) {
        clear_auto_followup("sleep_lifecycle");
        return 0U;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_release_idle_output(reason ? reason : "prelisten_start");
#endif
    stop_sleep_wake_word_detector(reason ? reason : "prelisten_start");
    if (s_prelisten.pending) {
        ESP_LOGI(TAG, "conversation auto follow-up cleared reason=%s", reason ? reason : "started");
    }
    const uint32_t remaining_ms = nuwax_prelisten_state_activate_pending(&s_prelisten, now_ms);
    metrics_begin_prelisten(nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                            reason ? reason : "started");
    ESP_LOGI(TAG,
             "conversation prelisten start mode=%s remaining_ms=%lu",
             nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
             (unsigned long)remaining_ms);
    return remaining_ms;
}

static void complete_post_playback_resume(void) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (!s_post_playback_resume_pending) {
        return;
    }
    if (local_power_transition_active()) {
        s_post_playback_resume_pending = false;
        ESP_LOGI(TAG,
                 "post-playback resume suppressed while local power sleep converges");
        return;
    }
    s_post_playback_resume_pending = false;
    nuwax_prelisten_state_clear_cancel(&s_prelisten);

    if (exclusive_audio_mode_blocks_normal_audio()) {
        ESP_LOGI(TAG,
                 "post-playback resume cancelled because exclusive audio mode owns capture");
        return;
    }
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        /* Playback has already reported its physical stop.  Start the
         * bounded ring immediately; only local VAD admission is delayed by
         * the normal warm-up.  Keeping the old pending window here created a
         * silent 350 ms no-capture hole after a valid response. */
        start_prelisten_capture_now(
            "auto_followup",
            (uint32_t)CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS,
            "post_playback_fallback");
        ESP_LOGI(TAG,
                 "post-playback resume started fallback auto-followup capture immediately");
        return;
    }

    reset_awake_wait_budget_paused("natural_playback_complete");
    const uint32_t now_ms = monotonic_ms();
    const uint32_t remaining_ms =
        nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms);
    if (remaining_ms == 0) {
        enter_sleeping_conversation_state("awake_timeout_after_playback");
        return;
    }
    if (nuwax_app_shell_blocks_auto_followup()) {
        set_state(NUWAX_APP_STATE_IDLE);
        ESP_LOGI(TAG,
                 "post-playback resume deferred by menu remaining_ms=%lu",
                 (unsigned long)remaining_ms);
        return;
    }

    const uint32_t window_ms = awake_session_listen_window_ms(now_ms);
    ESP_LOGI(TAG,
             "post-playback resume starting normal awake-session capture remaining_ms=%lu window_ms=%lu",
             (unsigned long)remaining_ms,
             (unsigned long)window_ms);
    start_prelisten_capture_now("awake_session",
                                window_ms,
                                "natural_playback_complete");
#endif
}

static bool schedule_auto_followup_after_playback(void) {
    if (local_power_transition_active()) {
        s_post_playback_resume_pending = false;
        ESP_LOGI(TAG,
                 "post-playback listening suppressed while local power sleep converges");
        return true;
    }
    if (s_deferred_sleep_intent.active) {
        const uint32_t token = s_deferred_sleep_intent.token;
        const bool transferred = service_deferred_remote_sleep_intent(
            "natural_playback_complete", false);
        ESP_LOGI(TAG,
                 "sleep-after-playback blocked next listening token=%lu transferred=%d",
                 (unsigned long)token,
                 transferred ? 1 : 0);
        return true;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (wake_detector_request_is_playback() ||
        nuwax_wake_word_detector_is_running()) {
        stop_sleep_wake_word_detector("natural_playback_complete");
    }
    if (CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS <= 0) {
        return false;
    }
    reset_awake_wait_budget_paused("playback_complete");
    if (s_prelisten.capture_active &&
        nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback")) {
        s_post_playback_resume_pending = true;
        s_during_playback_handoff_pending = false;
        s_during_playback_handoff_playback_started = false;
        s_during_playback_handoff_seamless = false;
        set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
        set_state(NUWAX_APP_STATE_LISTENING);
        ESP_LOGI(TAG,
                 "post-playback in-place phase transition requested; capture remains owned until acoustic tail clears");
        return true;
    }
    if (s_during_playback_handoff_pending) {
        const nuwax_capture_playback_complete_action_t action =
            nuwax_capture_phase_resolve_early_playback_complete(
                true,
                s_during_playback_handoff_seamless,
                s_prelisten.capture_active,
                atomic_load_explicit(&s_prelisten.cancel_capture,
                                     memory_order_acquire),
                nuwax_awake_session_state_is_active(&s_awake_session));
        if (action ==
            NUWAX_CAPTURE_PLAYBACK_COMPLETE_KEEP_AWAKE_OWNER) {
            /* A zero-length or rejected playback can complete before the
             * continuous awake owner consumes the forward handoff flag. */
            s_during_playback_handoff_pending = false;
            s_during_playback_handoff_playback_started = false;
            s_during_playback_handoff_seamless = false;
            reset_awake_wait_budget_paused(
                "playback_completed_before_seamless_handoff");
            ESP_LOGI(TAG,
                     "playback completed before seamless phase switch; keeping verified active awake capture");
            return true;
        }

        /* A cancelled non-awake owner may still be unwinding even though
         * prelisten.capture_active was cleared by request_cancel(). Keep the
         * handoff until that owner reaches cleanup, then complete_handoff()
         * clears the cancel flag and post_playback_resume starts one new
         * owner. Starting it here could overlap the old MIC task. */
        s_post_playback_resume_pending = true;
        ESP_LOGI(TAG,
                 "playback completed before cancel/rearm handoff cleanup; post-playback resume deferred to capture owner");
        return true;
    }
    if (s_prelisten.capture_active &&
        nuwax_awake_session_state_is_active(&s_awake_session)) {
        ESP_LOGI(TAG,
                 "auto follow-up kept existing continuous conversation stream mode=%s",
                 nuwax_prelisten_state_mode_or(&s_prelisten, "awake_session"));
        set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
        set_state(NUWAX_APP_STATE_LISTENING);
        return true;
    }
    if (!s_shell_actions || nuwax_app_shell_blocks_auto_followup()) {
        return false;
    }
    const uint32_t now_ms = monotonic_ms();
    uint32_t window_ms = (uint32_t)CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS;
    if (nuwax_awake_session_state_is_active(&s_awake_session)) {
        const uint32_t remaining_ms =
            nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms);
        if (remaining_ms == 0) {
            enter_sleeping_conversation_state("awake_timeout_after_playback");
            return true;
        }
        if (remaining_ms < window_ms) {
            window_ms = remaining_ms;
        }
    }
    /* The speaker owner calls this after its generation-bound physical stop.
     * Capture immediately so the ring contains the user's onset; the local
     * VAD warm-up and preroll validation still prevent the just-finished TTS
     * tail from being admitted as speech. */
    start_prelisten_capture_now("auto_followup",
                                window_ms,
                                "playback_complete");
    return true;
#else
    return false;
#endif
}

static bool schedule_auto_followup_after_cloud_output(
    bool capture_will_stop,
    const char *reason) {
    if (local_power_transition_active()) {
        s_post_playback_resume_pending = false;
        ESP_LOGI(TAG,
                 "post-response listening suppressed while local power sleep converges reason=%s",
                 reason ? reason : "cloud_output");
        return true;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (capture_will_stop &&
        CONFIG_NUWAX_CONVERSATION_AUTO_FOLLOWUP_MS > 0 &&
        !s_deferred_sleep_intent.active) {
        s_post_playback_resume_pending = true;
        ESP_LOGI(TAG,
                 "post-response listening deferred until accepted capture releases MIC reason=%s",
                 reason ? reason : "cloud_output");
        return true;
    }
#else
    (void)capture_will_stop;
    (void)reason;
#endif
    return schedule_auto_followup_after_playback();
}

static void service_tts_skip_followup(void) {
    if (!s_tts_skip_emotion_window.active ||
        !s_tts_skip_emotion_window.followup_pending) {
        return;
    }

    const uint32_t now_ms = monotonic_ms();
    if (active_ws_epoch_snapshot() != s_tts_skip_emotion_window.ws_epoch ||
        nuwax_awake_session_state_generation(&s_awake_session) !=
            s_tts_skip_emotion_window.awake_generation) {
        clear_tts_skip_emotion_window("followup_owner_changed");
        return;
    }

    const bool hold_complete =
        s_tts_skip_emotion_window.emotion_accepted
            ? elapsed_ms(now_ms,
                         s_tts_skip_emotion_window.visual_deadline_ms)
            : elapsed_ms(now_ms, s_tts_skip_emotion_window.deadline_ms);
    if (!hold_complete) {
        return;
    }

    const bool capture_will_stop =
        s_tts_skip_emotion_window.capture_will_stop;
    const bool had_emotion = s_tts_skip_emotion_window.emotion_accepted;
    const char *reason = had_emotion
                             ? "tts_skip_emotion_hold_complete"
                             : "tts_skip_emotion_timeout";
    s_tts_skip_emotion_window.followup_pending = false;
    clear_tts_skip_emotion_window(reason);
    ESP_LOGI(TAG,
             "tts_skip visual hold complete; starting new listening round emotion=%d",
             had_emotion ? 1 : 0);
    if (!schedule_auto_followup_after_cloud_output(capture_will_stop,
                                                   reason)) {
        set_state(NUWAX_APP_STATE_IDLE);
    }
}

static void return_to_listening_after_cancel(const char *reason) {
    if (local_power_transition_active()) {
        /* A local power-key sleep owns the post-cancel lifecycle.  A late
         * speaker callback must not re-arm microphone capture underneath it. */
        ESP_LOGI(TAG,
                 "listening handoff suppressed while local power sleep converges reason=%s",
                 reason ? reason : "-");
        return;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (wake_detector_request_is_playback() ||
        nuwax_wake_word_detector_is_running()) {
        stop_sleep_wake_word_detector(
            reason ? reason : "cancel_followup");
    }
    clear_last_listen_resume();
    start_prelisten_window(reason ? reason : "cancel_followup",
                           awake_session_listen_window_ms(monotonic_ms()),
                           0);
#else
    (void)reason;
    set_state(NUWAX_APP_STATE_IDLE);
#endif
}

static nuwax_notification_rx_state_t notification_rx_barrier_snapshot(
    uint32_t ws_epoch) {
    nuwax_notification_rx_state_t state = NUWAX_NOTIFICATION_RX_IDLE;
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    state = nuwax_notification_rx_barrier_state_for_epoch(
        &s_notification_rx_barrier, ws_epoch);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    return state;
}

static void service_notification_rx_rejected_timeout(nuwax_ws_client_t *ws) {
    if (!ws || !nuwax_ws_is_connected(ws)) {
        return;
    }
    const uint32_t ws_epoch = nuwax_ws_connection_epoch(ws);
    const uint32_t now_ms = monotonic_ms();
    bool timed_out = false;
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    timed_out = nuwax_notification_rx_barrier_take_rejected_timeout(
        &s_notification_rx_barrier, ws_epoch, now_ms);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    if (!timed_out) {
        return;
    }

    ESP_LOGE(TAG,
             "rejected binary stream did not reach END before quarantine deadline epoch=%lu; rebuilding WebSocket to restore an unambiguous stream boundary",
             (unsigned long)ws_epoch);
    const bool close_admitted = nuwax_ws_close_if_epoch(
        ws, ws_epoch, NUWAX_WS_CLOSE_CAUSE_TRANSPORT_INTEGRITY);
    if (!close_admitted && nuwax_ws_connection_epoch(ws) == ws_epoch) {
        ESP_LOGE(TAG,
                 "transport-integrity close was not admitted for rejected binary stream epoch=%lu; quarantine remains active",
                 (unsigned long)ws_epoch);
    }
}

static bool notification_rx_barrier_arm_epoch(uint32_t ws_epoch,
                                              const char *notify_id,
                                              const char *playback_id) {
    bool armed = false;
    const uint32_t now_ms = monotonic_ms();
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    armed = nuwax_notification_rx_barrier_arm(
        &s_notification_rx_barrier,
        ws_epoch,
        now_ms,
        NUWAX_NOTIFICATION_RX_BARRIER_WAIT_MS,
        notify_id,
        playback_id);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    return armed;
}

static bool notification_rx_barrier_admit_epoch(uint32_t ws_epoch,
                                                const char *notify_id,
                                                const char *playback_id) {
    bool admitted = false;
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    admitted = nuwax_notification_rx_barrier_admit(
        &s_notification_rx_barrier,
        ws_epoch,
        notify_id,
        playback_id);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    return admitted;
}

static bool notification_rx_barrier_arm_normal_epoch(
    uint32_t ws_epoch,
    const char *turn_id,
    const char *playback_id) {
    bool armed = false;
    const uint32_t now_ms = monotonic_ms();
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    armed = nuwax_notification_rx_barrier_arm_normal(
        &s_notification_rx_barrier,
        ws_epoch,
        now_ms,
        NUWAX_NOTIFICATION_RX_BARRIER_WAIT_MS,
        turn_id,
        playback_id);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    return armed;
}

static bool notification_rx_barrier_admit_normal_epoch(
    uint32_t ws_epoch,
    const char *turn_id,
    const char *playback_id) {
    bool admitted = false;
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    admitted = nuwax_notification_rx_barrier_admit_normal(
        &s_notification_rx_barrier,
        ws_epoch,
        turn_id,
        playback_id);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    return admitted;
}

static void notification_rx_barrier_reject_normal_epoch(
    uint32_t ws_epoch,
    const char *turn_id,
    const char *playback_id,
    const char *reason) {
    bool rejected = false;
    const uint32_t now_ms = monotonic_ms();
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    rejected = nuwax_notification_rx_barrier_reject_normal(
        &s_notification_rx_barrier,
        ws_epoch,
        now_ms,
        NUWAX_NOTIFICATION_RX_REJECT_DRAIN_MS,
        turn_id,
        playback_id);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    if (rejected) {
        ESP_LOGW(TAG,
                 "normal playback takeover rejected epoch=%lu turn=%s playback=%s reason=%s",
                 (unsigned long)ws_epoch,
                 turn_id ? turn_id : "-",
                 playback_id ? playback_id : "-",
                 reason ? reason : "-");
    }
}

static void notification_rx_barrier_reject_epoch(uint32_t ws_epoch,
                                                 const char *reason) {
    bool rejected = false;
    const uint32_t now_ms = monotonic_ms();
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    rejected = nuwax_notification_rx_barrier_reject(
        &s_notification_rx_barrier,
        ws_epoch,
        now_ms,
        NUWAX_NOTIFICATION_RX_REJECT_DRAIN_MS);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    if (rejected) {
        ESP_LOGW(TAG,
                 "notification RX barrier rejected epoch=%lu reason=%s; binary will be drained without entering normal TTS",
                 (unsigned long)ws_epoch,
                 reason ? reason : "-");
    }
}

static void notification_rx_barrier_reset_epoch(uint32_t ws_epoch) {
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    (void)nuwax_notification_rx_barrier_reset_if_epoch(
        &s_notification_rx_barrier, ws_epoch);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
}

static esp_err_t send_notification_event_ack(
    nuwax_ws_client_t *ws,
    const char *ack_type,
    const char *request_id,
    const char *notify_id,
    const char *playback_id,
    bool ok,
    const char *message,
    uint32_t ws_epoch) {
    if (!ws || ws_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != ws_epoch) {
        return ESP_ERR_INVALID_STATE;
    }
    return nuwax_session_send_notify_playback_ack_until_if_epoch(
        ws,
        ack_type,
        request_id,
        notify_id,
        playback_id,
        ok,
        message,
        esp_timer_get_time() + NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
        ws_epoch);
}

static void notification_restore_sleep_or_listen(bool origin_sleeping,
                                                  const char *reason) {
    if (local_power_transition_active()) {
        /* A physical power request wins over the notification's former awake
         * origin.  Do not construct a fresh awake session after cancellation,
         * failure, or a terminal race; advance only the retained sleep owner. */
        ESP_LOGI(TAG,
                 "notification terminal handoff retained local power transition reason=%s",
                 reason ? reason : "notification_terminal");
        if (s_sleep_request_pending) {
            service_pending_sleep_request();
        } else if (s_sleep_transaction.active &&
                   s_sleep_transaction.local_request) {
            service_sleep_transaction();
        }
        return;
    }
    if (origin_sleeping) {
        commit_sleeping_conversation_state(
            reason ? reason : "notification_recovery_sleep");
        return;
    }
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        begin_awake_session(reason ? reason : "notification_recovery");
    }
    reset_awake_wait_budget_paused(
        reason ? reason : "notification_recovery");
    return_to_listening_after_cancel(
        reason ? reason : "notification_recovery");
}

static void reset_notification_transaction_runtime(void) {
    nuwax_notification_reset(&s_notification_transaction);
    s_notification_expected_frames = 0U;
    s_notification_expected_bytes = 0U;
    s_notification_end_frames = 0U;
    s_notification_end_bytes = 0U;
    s_notification_end_reason[0] = '\0';
    s_notification_cancel_reason[0] = '\0';
}

static void finish_notification_to_listening(const char *reason) {
    const bool origin_sleeping = s_notification_transaction.origin_sleeping;
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    if (s_notification_transaction.binary_end_seen) {
        notification_rx_barrier_reset_epoch(ws_epoch);
    } else {
        notification_rx_barrier_reject_epoch(
            ws_epoch, reason ? reason : "notification_finished_without_end");
    }
    if (local_power_transition_active()) {
        reset_notification_transaction_runtime();
        notification_restore_sleep_or_listen(
            origin_sleeping,
            reason ? reason : "notification_power_transition");
        return;
    }
    if (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING ||
        s_sleep_transaction.active) {
        nuwax_sleep_transaction_reset_for_wake(&s_sleep_transaction);
    }
    clear_sleep_request();
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        begin_awake_session(origin_sleeping
                                ? "notification_wake_complete"
                                : "notification_complete");
    }
    reset_awake_wait_budget_paused(
        reason ? reason : "notification_complete");
    return_to_listening_after_cancel(
        reason ? reason : "notification_complete");
}

/* Natural notification completion must preserve the lifecycle that owned the
 * notification before local quiescence.  A sleeping notification temporarily
 * stops the wake detector, but it must not be treated as an awake conversation
 * merely because its first PCM frame is rendered as SPEAKING. */
static void finish_notification_to_origin(const char *reason) {
    const bool origin_sleeping = s_notification_transaction.origin_sleeping;
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    const bool awake_takeover =
        !origin_sleeping ||
        nuwax_awake_session_state_is_active(&s_awake_session) ||
        s_prelisten.capture_active ||
        s_turn_guard.active;

    if (!s_notification_transaction.binary_end_seen) {
        notification_rx_barrier_reject_epoch(
            ws_epoch, reason ? reason : "notification_finished_without_end");
    } else {
        notification_rx_barrier_reset_epoch(ws_epoch);
    }
    reset_notification_transaction_runtime();

    if (local_power_transition_active()) {
        notification_restore_sleep_or_listen(
            origin_sleeping,
            reason ? reason : "notification_complete_power_transition");
        return;
    }
    if (awake_takeover) {
        /* This covers ordinary awake notifications and any explicit user wake
         * that won while the notification transaction was converging. */
        clear_sleep_request();
        if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
            begin_awake_session(reason ? reason : "notification_complete");
        }
        reset_awake_wait_budget_paused(
            reason ? reason : "notification_complete");
        return_to_listening_after_cancel(
            reason ? reason : "notification_complete");
        return;
    }

    /* Keep the ACK/terminal barrier ordering above, then restore the sleeping
     * lifecycle.  This clears the transient notification state, releases any
     * awake resources, and re-arms the sleep wake-word detector atomically. */
    if (!commit_sleeping_conversation_state(
            reason ? reason : "notification_complete_restore_sleep")) {
        /* Meeting/monitoring owns the lifecycle if it appeared during the
         * notification.  Do not force SLEEPING over that exclusive owner. */
        ESP_LOGI(TAG,
                 "notification origin sleep restore deferred to exclusive audio owner reason=%s",
                 reason ? reason : "notification_complete_restore_sleep");
    }
}

static bool notification_cancel_is_user_wake(const char *reason) {
    return reason &&
           (strstr(reason, "touch") != NULL ||
            strstr(reason, "wake_word") != NULL);
}

static void finish_notification_cancellation(const char *reason) {
    const bool origin_sleeping = s_notification_transaction.origin_sleeping;
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    if (notification_cancel_is_user_wake(reason)) {
        finish_notification_to_listening(
            reason ? reason : "notification_user_cancelled");
        return;
    }
    if (s_notification_transaction.binary_end_seen) {
        notification_rx_barrier_reset_epoch(ws_epoch);
    } else {
        notification_rx_barrier_reject_epoch(
            ws_epoch, reason ? reason : "notification_cancelled_without_end");
    }
    reset_notification_transaction_runtime();
    notification_restore_sleep_or_listen(
        origin_sleeping, reason ? reason : "notification_cancelled");
}

static void notification_fail_and_recover(const char *reason,
                                          const char *ack_type) {
    const uint32_t token = s_notification_transaction.token;
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    const bool origin_sleeping =
        s_notification_transaction.origin_sleeping;
    notification_rx_barrier_reject_epoch(
        ws_epoch, reason ? reason : "notification_failure");
    uint32_t active_epoch = 0U;
    nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);

#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
    if (s_notification_transaction.speaker_generation != 0U) {
        (void)nuwax_speaker_playback_request_cancel_generation(
            s_notification_transaction.speaker_generation,
            reason ? reason : "notification_failure",
            0U);
    }
    (void)nuwax_speaker_playback_reject_start_generation(
        s_notification_transaction.speaker_generation,
        reason ? reason : "notification_failure");
    if (s_notification_transaction.notify_id[0] &&
        s_notification_transaction.playback_id[0]) {
        nuwax_speaker_playback_note_notification_end(
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            reason ? reason : "notification_failure");
        (void)nuwax_speaker_playback_abort_notification_metadata_only_session(
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            reason ? reason : "notification_failure");
    }
#endif

    if (ws && active_epoch == ws_epoch && ack_type &&
        s_notification_transaction.begin_request_id[0] &&
        s_notification_transaction.playback_id[0]) {
        (void)send_notification_event_ack(
            ws,
            ack_type,
            strcmp(ack_type, "notify_playback_end_ack") == 0
                ? s_notification_transaction.end_request_id
                : s_notification_transaction.begin_request_id,
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            false,
            reason ? reason : "notification failed",
            ws_epoch);
    }
    ESP_LOGE(TAG,
             "notification transaction failed token=%lu epoch=%lu state=%s notify=%s playback=%s reason=%s",
             (unsigned long)token,
             (unsigned long)ws_epoch,
             nuwax_notification_state_name(
                 s_notification_transaction.state),
             s_notification_transaction.notify_id[0]
                 ? s_notification_transaction.notify_id
                 : "-",
             s_notification_transaction.playback_id[0]
                 ? s_notification_transaction.playback_id
                 : "-",
             reason ? reason : "-");
    reset_notification_transaction_runtime();
    notification_restore_sleep_or_listen(origin_sleeping, reason);
}

static void notification_begin_local_quiesce(const char *reason) {
    const uint32_t token = s_notification_transaction.token;
    /* The control center deliberately freezes the face while it is open.
     * Close it asynchronously before notification audio becomes audible so
     * the notification expression can advance without blocking this owner. */
    nuwax_app_shell_request_close_overlays();
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
#endif
    clear_auto_followup(reason ? reason : "notification_prepare");
    cancel_auto_followup_capture(
        reason ? reason : "notification_prepare");
    s_post_playback_resume_pending = false;
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    inhibit_sleep_wake_word_detector(
        reason ? reason : "notification_prepare");
    if (nuwax_wake_word_detector_is_running()) {
        nuwax_wake_word_detector_request_stop();
    }
#endif
    if (!conversation_capture_busy_for_sleep() &&
        !s_prelisten.capture_active) {
        (void)nuwax_notification_mark_capture_released(
            &s_notification_transaction, token);
    }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!nuwax_wake_word_detector_is_running()) {
        (void)nuwax_notification_mark_wake_detector_released(
            &s_notification_transaction, token);
    }
#else
    (void)nuwax_notification_mark_wake_detector_released(
        &s_notification_transaction, token);
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const uint32_t previous_generation =
        s_notification_transaction.previous_speaker_generation;
    if (previous_generation != 0U) {
        nuwax_speaker_cancel_request_result_t cancel = {0};
        if (nuwax_speaker_playback_request_cancel_generation_ex(
                previous_generation,
                reason ? reason : "notification_previous_playback",
                15U,
                &cancel) &&
            cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
            cancel.completed_stop_result == ESP_OK) {
            (void)nuwax_notification_mark_previous_speaker_stopped(
                &s_notification_transaction,
                token,
                s_notification_transaction.ws_epoch,
                previous_generation);
        }
    }
#endif
}

static void handle_prepare_notification_command(
    nuwax_ws_client_t *ws,
    const nuwax_session_command_t *command) {
    if (!ws || !command || command->notify_id[0] == '\0') {
        return;
    }
    const uint32_t ws_epoch = nuwax_ws_connection_epoch(ws);
    const nuwax_app_state_t local_state = conversation_state_current();
    const bool local_sleeping = local_state == NUWAX_APP_STATE_SLEEPING;
    const bool safe_awake_no_turn =
        (local_state == NUWAX_APP_STATE_IDLE ||
         local_state == NUWAX_APP_STATE_LISTENING) &&
        !s_turn_guard.active
#if CONFIG_NUWAX_SPEAKER_ENABLE
        && !s_playback_terminal_guard.active
#endif
        ;
    const bool prepare_state_allowed =
        local_sleeping || safe_awake_no_turn;
    if (local_power_transition_active() ||
        exclusive_audio_mode_blocks_normal_audio()
#if CONFIG_NUWAX_OTA_ENABLE
        || nuwax_ota_device_blocks_audio()
#endif
        || s_deferred_sleep_intent.active || !prepare_state_allowed) {
        const char *reject_reason =
            local_power_transition_active()
                ? "local power transition is active"
                : !prepare_state_allowed
                ? "prepare requires sleeping or idle/listening without active turn"
                : "exclusive audio owner is active";
        ESP_LOGW(TAG,
                 "notification prepare rejected request=%s notify=%s state=%s local_sleeping=%d safe_awake=%d deferred_sleep=%d reason=%s",
                 command->request_id,
                 command->notify_id,
                 nuwax_app_state_name(local_state),
                 local_sleeping ? 1 : 0,
                 safe_awake_no_turn ? 1 : 0,
                 s_deferred_sleep_intent.active ? 1 : 0,
                 reject_reason);
        const esp_err_t ack_err =
            nuwax_session_send_command_ack_until_if_epoch(
            ws,
            command->request_id,
            command->command,
            false,
            reject_reason,
            esp_timer_get_time() + NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
            ws_epoch);
        if (ack_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "notification prepare rejection ACK deferred request=%s epoch=%lu err=%s",
                     command->request_id,
                     (unsigned long)ws_epoch,
                     esp_err_to_name(ack_err));
        }
        return;
    }

    const uint32_t previous_generation =
        sleep_transaction_current_speaker_generation(ws_epoch);
    const nuwax_notification_request_result_t result =
        nuwax_notification_request_prepare(
            &s_notification_transaction,
            monotonic_ms(),
            NUWAX_NOTIFICATION_PREPARE_TIMEOUT_MS,
            ws_epoch,
            previous_generation,
            command->request_id,
            command->notify_id,
            local_sleeping);
    if (result == NUWAX_NOTIFICATION_REQUEST_DUPLICATE) {
        if (s_notification_transaction.prepare_ack_sent) {
            (void)nuwax_session_send_command_ack_until_if_epoch(
                ws,
                command->request_id,
                command->command,
                true,
                "ready",
                esp_timer_get_time() +
                    NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
                ws_epoch);
        } else {
            service_notification_transaction();
        }
        return;
    }
    if (result != NUWAX_NOTIFICATION_REQUEST_STARTED) {
        (void)nuwax_session_send_command_ack_until_if_epoch(
            ws,
            command->request_id,
            command->command,
            false,
            result == NUWAX_NOTIFICATION_REQUEST_BUSY
                ? "notification transaction busy"
                : "notification prepare conflict",
            esp_timer_get_time() + NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
            ws_epoch);
        return;
    }
    s_notification_expected_frames = 0U;
    s_notification_expected_bytes = 0U;
    s_notification_end_frames = 0U;
    s_notification_end_bytes = 0U;
    s_notification_end_reason[0] = '\0';
    s_notification_cancel_reason[0] = '\0';

    if (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING ||
        s_sleep_transaction.active) {
        nuwax_sleep_transaction_reset_for_wake(&s_sleep_transaction);
    }
    clear_sleep_request();
    notification_begin_local_quiesce("prepare_notify_playback");
    ESP_LOGI(TAG,
             "notification prepare accepted token=%lu epoch=%lu notify=%s previous_generation=%lu origin_sleeping=%d",
             (unsigned long)s_notification_transaction.token,
             (unsigned long)ws_epoch,
             command->notify_id,
             (unsigned long)previous_generation,
             local_sleeping ? 1 : 0);
    service_notification_transaction();
}

static void handle_notification_event(
    const nuwax_session_command_t *command) {
    if (!command ||
        (command->event != NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN &&
         command->event != NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_END)) {
        return;
    }
    uint32_t ws_epoch = 0U;
    nuwax_ws_client_t *ws = active_ws_snapshot(&ws_epoch);
    if (!ws || ws_epoch == 0U) {
        return;
    }
    if (local_power_transition_active() ||
        exclusive_audio_mode_blocks_normal_audio()
#if CONFIG_NUWAX_OTA_ENABLE
        || nuwax_ota_device_blocks_audio()
#endif
        || s_deferred_sleep_intent.active ||
        (sleep_transaction_blocks_new_audio() &&
         !s_notification_transaction.active)
    ) {
        const char *ack_type =
            command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN
                ? "notify_playback_begin_ack"
                : "notify_playback_end_ack";
        (void)send_notification_event_ack(ws,
                                          ack_type,
                                          command->request_id,
                                          command->notify_id,
                                          command->playback_id,
                                          false,
                                          local_power_transition_active()
                                              ? "local power transition is active"
                                              : "exclusive audio owner is active",
                                          ws_epoch);
        if (command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN) {
            notification_rx_barrier_reject_epoch(
                ws_epoch, "exclusive_audio_owner");
        }
        return;
    }

    if (command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN) {
        const bool local_sleeping =
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING;
        const uint32_t previous_generation =
            s_notification_transaction.active
                ? s_notification_transaction.previous_speaker_generation
                : sleep_transaction_current_speaker_generation(ws_epoch);
        const nuwax_notification_request_result_t result =
            nuwax_notification_request_begin(
                &s_notification_transaction,
                monotonic_ms(),
                NUWAX_NOTIFICATION_BEGIN_TIMEOUT_MS,
                ws_epoch,
                previous_generation,
                command->request_id,
                command->notify_id,
                command->playback_id,
                local_sleeping);
        const uint32_t requested_frames =
            command->tts_frames > 0 ? (uint32_t)command->tts_frames : 0U;
        const uint32_t requested_bytes =
            command->playback_bytes > 0
                ? (uint32_t)command->playback_bytes
                : 0U;
        if (result == NUWAX_NOTIFICATION_REQUEST_DUPLICATE) {
            if (!s_notification_transaction.active ||
                s_notification_transaction.state ==
                    NUWAX_NOTIFICATION_STATE_COMPLETE) {
                (void)send_notification_event_ack(
                    ws,
                    "notify_playback_begin_ack",
                    command->request_id,
                    command->notify_id,
                    command->playback_id,
                    false,
                    "notification playback already completed",
                    ws_epoch);
                notification_rx_barrier_reject_epoch(
                    ws_epoch, "notification_already_completed");
                return;
            }
            if (requested_frames != s_notification_expected_frames ||
                requested_bytes != s_notification_expected_bytes) {
                (void)send_notification_event_ack(
                    ws,
                    "notify_playback_begin_ack",
                    command->request_id,
                    command->notify_id,
                    command->playback_id,
                    false,
                    "duplicate notification begin payload conflict",
                    ws_epoch);
                notification_rx_barrier_reject_epoch(
                    ws_epoch, "notification_begin_duplicate_conflict");
                return;
            }
            if (s_notification_transaction.begin_ack_sent) {
                const esp_err_t duplicate_ack_err =
                    send_notification_event_ack(
                    ws,
                    "notify_playback_begin_ack",
                    command->request_id,
                    command->notify_id,
                    command->playback_id,
                    true,
                    "ready",
                    ws_epoch);
                if (duplicate_ack_err != ESP_OK ||
                    !notification_rx_barrier_admit_epoch(
                        ws_epoch,
                        command->notify_id,
                        command->playback_id)) {
                    notification_fail_and_recover(
                        "duplicate begin ACK failed",
                        "notify_playback_begin_ack");
                }
            } else {
                service_notification_transaction();
            }
            return;
        }
        if (result != NUWAX_NOTIFICATION_REQUEST_STARTED) {
            const char *message =
                result == NUWAX_NOTIFICATION_REQUEST_NOT_PREPARED
                    ? "sleeping notification was not prepared"
                : result == NUWAX_NOTIFICATION_REQUEST_NOT_READY
                    ? "notification preparation is still in progress"
                    : "notification begin conflict or busy";
            (void)send_notification_event_ack(
                ws,
                "notify_playback_begin_ack",
                command->request_id,
                command->notify_id,
                command->playback_id,
                false,
                message,
                ws_epoch);
            notification_rx_barrier_reject_epoch(
                ws_epoch, "notification_begin_rejected");
            return;
        }
        s_notification_expected_frames = requested_frames;
        s_notification_expected_bytes = requested_bytes;
        s_notification_end_frames = 0U;
        s_notification_end_bytes = 0U;
        s_notification_end_reason[0] = '\0';
        notification_begin_local_quiesce("notify_playback_begin");
        ESP_LOGI(TAG,
                 "notification begin accepted token=%lu epoch=%lu notify=%s playback=%s previous_generation=%lu origin_sleeping=%d",
                 (unsigned long)s_notification_transaction.token,
                 (unsigned long)ws_epoch,
                 command->notify_id,
                 command->playback_id,
                 (unsigned long)previous_generation,
                 s_notification_transaction.origin_sleeping ? 1 : 0);
        service_notification_transaction();
        return;
    }

    const uint32_t reported_frames =
        command->tts_frames > 0 ? (uint32_t)command->tts_frames : 0U;
    const uint32_t reported_bytes =
        command->playback_bytes > 0
            ? (uint32_t)command->playback_bytes
            : 0U;
    const char *reported_reason =
        command->playback_reason[0] ? command->playback_reason : "";
    if ((s_notification_expected_frames != 0U && reported_frames != 0U &&
         reported_frames != s_notification_expected_frames) ||
        (s_notification_expected_bytes != 0U && reported_bytes != 0U &&
         reported_bytes != s_notification_expected_bytes)) {
        (void)send_notification_event_ack(
            ws,
            "notify_playback_end_ack",
            command->request_id,
            command->notify_id,
            command->playback_id,
            false,
            "notification end totals conflict with begin",
            ws_epoch);
        return;
    }
    const nuwax_notification_request_result_t result =
        nuwax_notification_request_end(
            &s_notification_transaction,
            monotonic_ms(),
            NUWAX_NOTIFICATION_TERMINAL_TIMEOUT_MS,
            ws_epoch,
            command->request_id,
            command->notify_id,
            command->playback_id);
    if (result == NUWAX_NOTIFICATION_REQUEST_DUPLICATE) {
        if (reported_frames != s_notification_end_frames ||
            reported_bytes != s_notification_end_bytes ||
            strcmp(reported_reason, s_notification_end_reason) != 0) {
            (void)send_notification_event_ack(
                ws,
                "notify_playback_end_ack",
                command->request_id,
                command->notify_id,
                command->playback_id,
                false,
                "duplicate notification end payload conflict",
                ws_epoch);
            return;
        }
        if (s_notification_transaction.end_ack_sent) {
            (void)send_notification_event_ack(
                ws,
                "notify_playback_end_ack",
                command->request_id,
                command->notify_id,
                command->playback_id,
                true,
                "completed",
                ws_epoch);
        } else {
            service_notification_transaction();
        }
        return;
    }
    if (result != NUWAX_NOTIFICATION_REQUEST_STARTED) {
        (void)send_notification_event_ack(
            ws,
            "notify_playback_end_ack",
            command->request_id,
            command->notify_id,
            command->playback_id,
            false,
            "notification end does not match active playback",
            ws_epoch);
        return;
    }
    s_notification_end_frames = reported_frames;
    s_notification_end_bytes = reported_bytes;
    strlcpy(s_notification_end_reason,
            reported_reason,
            sizeof(s_notification_end_reason));
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
    nuwax_speaker_playback_note_notification_end(
        command->notify_id,
        command->playback_id,
        command->playback_reason[0] ? command->playback_reason
                                    : "completed");
#endif
    ESP_LOGI(TAG,
             "notification logical END accepted token=%lu notify=%s playback=%s frames=%d bytes=%d",
             (unsigned long)s_notification_transaction.token,
             command->notify_id,
             command->playback_id,
             command->tts_frames,
             command->playback_bytes);
    service_notification_transaction();
}

static void cancel_active_notification(nuwax_ws_client_t *ws,
                                       const char *reason) {
    if (!s_notification_transaction.active ||
        s_notification_transaction.state ==
            NUWAX_NOTIFICATION_STATE_CANCELLING) {
        return;
    }
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    if (!ws || nuwax_ws_connection_epoch(ws) != ws_epoch) {
        return;
    }
    notification_rx_barrier_reject_epoch(
        ws_epoch, reason ? reason : "notification_cancel");
    strlcpy(s_notification_cancel_reason,
            reason && reason[0] ? reason : "cancelled",
            sizeof(s_notification_cancel_reason));
#if CONFIG_NUWAX_SPEAKER_ENABLE
    (void)update_normal_downlink_admission(false);
#endif
    cancel_auto_followup_capture("notification_cancel");
    inhibit_sleep_wake_word_detector("notification_cancel");
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (nuwax_wake_word_detector_is_running()) {
        nuwax_wake_word_detector_request_stop();
    }
#endif
    const uint32_t token = s_notification_transaction.token;
    if (!nuwax_notification_request_cancel(
            &s_notification_transaction,
            token,
            ws_epoch,
            monotonic_ms(),
            NUWAX_NOTIFICATION_CANCEL_TIMEOUT_MS)) {
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const uint32_t generation =
        s_notification_transaction.speaker_generation;
    if (generation != 0U) {
        if (!nuwax_speaker_playback_request_cancel_generation(
                generation,
                s_notification_cancel_reason,
                15U)) {
            (void)nuwax_speaker_playback_reject_start_generation(
                generation,
                s_notification_cancel_reason);
        }
    } else if (s_notification_transaction.notify_id[0] &&
               s_notification_transaction.playback_id[0]) {
        (void)nuwax_speaker_playback_abort_notification_metadata_only_session(
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            s_notification_cancel_reason);
    }
#endif
    ESP_LOGI(TAG,
             "notification cancel requested token=%lu epoch=%lu generation=%lu notify=%s playback=%s reason=%s",
             (unsigned long)token,
             (unsigned long)ws_epoch,
             (unsigned long)s_notification_transaction.speaker_generation,
             s_notification_transaction.notify_id,
             s_notification_transaction.playback_id,
             s_notification_cancel_reason);
    service_notification_transaction();
}

static void service_notification_transaction(void) {
    if (!s_notification_transaction.active) {
        return;
    }
    const uint32_t token = s_notification_transaction.token;
    const uint32_t ws_epoch = s_notification_transaction.ws_epoch;
    uint32_t active_epoch = 0U;
    nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
    if (!ws || !nuwax_ws_is_connected(ws) || active_epoch != ws_epoch) {
        ESP_LOGW(TAG,
                 "notification transaction invalidated by WebSocket boundary token=%lu expected_epoch=%lu active_epoch=%lu",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 (unsigned long)active_epoch);
        notification_fail_and_recover("notification WebSocket boundary",
                                      NULL);
        return;
    }

    if (!conversation_capture_busy_for_sleep() &&
        !s_prelisten.capture_active) {
        (void)nuwax_notification_mark_capture_released(
            &s_notification_transaction, token);
    }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!nuwax_wake_word_detector_is_running()) {
        (void)nuwax_notification_mark_wake_detector_released(
            &s_notification_transaction, token);
    }
#else
    (void)nuwax_notification_mark_wake_detector_released(
        &s_notification_transaction, token);
#endif

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (s_notification_transaction.speaker_generation != 0U &&
        !s_notification_transaction.physical_done) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.completed_stop_connection_epoch == ws_epoch &&
            stats.completed_stop_generation ==
                s_notification_transaction.speaker_generation &&
            stats.completed_stop_result == ESP_OK) {
            (void)nuwax_notification_mark_physical_done(
                &s_notification_transaction,
                token,
                ws_epoch,
                s_notification_transaction.speaker_generation);
        } else if (stats.failed_stop_connection_epoch == ws_epoch &&
                   stats.failed_stop_generation ==
                       s_notification_transaction.speaker_generation) {
            ESP_LOGE(TAG,
                     "notification physical speaker stop failed epoch=%lu generation=%lu result=%s",
                     (unsigned long)ws_epoch,
                     (unsigned long)s_notification_transaction
                         .speaker_generation,
                     esp_err_to_name(stats.failed_stop_result));
            (void)nuwax_ws_request_close_if_epoch(ws, ws_epoch);
            notification_fail_and_recover(
                "notification physical speaker stop failed", NULL);
            return;
        }
    }
    if (!s_notification_transaction.previous_speaker_stopped &&
        s_notification_transaction.previous_speaker_generation != 0U) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.completed_stop_connection_epoch == ws_epoch &&
            stats.completed_stop_generation ==
                s_notification_transaction.previous_speaker_generation &&
            stats.completed_stop_result == ESP_OK) {
            (void)nuwax_notification_mark_previous_speaker_stopped(
                &s_notification_transaction,
                token,
                ws_epoch,
                s_notification_transaction.previous_speaker_generation);
        } else if (stats.failed_stop_connection_epoch == ws_epoch &&
                   stats.failed_stop_generation ==
                       s_notification_transaction
                           .previous_speaker_generation) {
            notification_fail_and_recover("previous speaker stop failed",
                                          "notify_playback_begin_ack");
            return;
        }
    }
#endif

    if (s_notification_transaction.state ==
            NUWAX_NOTIFICATION_STATE_PREPARING &&
        nuwax_notification_prepare_ready(&s_notification_transaction)) {
        if (!nuwax_notification_mark_prepare_ready(
                &s_notification_transaction, token)) {
            return;
        }
        const esp_err_t ack_err =
            nuwax_session_send_command_ack_until_if_epoch(
                ws,
                s_notification_transaction.prepare_request_id,
                "prepare_notify_playback",
                true,
                "ready",
                esp_timer_get_time() +
                    NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
                ws_epoch);
        if (ack_err != ESP_OK ||
            !nuwax_notification_mark_prepare_ack_sent(
                &s_notification_transaction,
                token,
                ws_epoch,
                monotonic_ms(),
                NUWAX_NOTIFICATION_BEGIN_TIMEOUT_MS)) {
            notification_fail_and_recover("prepare ACK failed", NULL);
            return;
        }
        ESP_LOGI(TAG,
                 "notification prepare committed token=%lu epoch=%lu notify=%s",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 s_notification_transaction.notify_id);
        return;
    }

    if (s_notification_transaction.state ==
            NUWAX_NOTIFICATION_STATE_BEGIN_PENDING &&
        nuwax_notification_begin_ready(&s_notification_transaction)) {
        clear_active_turn_guard("notification_takeover");
#if CONFIG_NUWAX_SPEAKER_ENABLE
        nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);
#endif
        /* Publish the latest cloud expression before fencing stale mailbox
         * copies. Keep the active finite lease through THINKING/SPEAKING so a
         * sleep-origin notification can use the expression sent for it. */
        sync_pending_semantic_emotion();
        (void)invalidate_all_pending_semantic_emotions(
            "notification_takeover_pending_fence");
        nuwax_state_bridge_clear_waiting_question();
        nuwax_state_bridge_cancel_touch();
        /* Publish BUFFERING before installing the new speaker metadata.
         * Once playback_session_active is set, the generic UI guard would
         * correctly defer non-SPEAKING states until physical completion. */
        set_state(NUWAX_APP_STATE_THINKING);
#if CONFIG_NUWAX_SPEAKER_ENABLE
        nuwax_speaker_playback_note_notification_begin(
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            s_notification_expected_frames,
            s_notification_expected_bytes);
#endif
        if (!nuwax_notification_mark_streaming(
                &s_notification_transaction, token, ws_epoch)) {
            notification_fail_and_recover("notification start commit failed",
                                          "notify_playback_begin_ack");
            return;
        }
        (void)nuwax_notification_refresh_stream_deadline(
            &s_notification_transaction,
            token,
            ws_epoch,
            monotonic_ms(),
            NUWAX_NOTIFICATION_STREAM_IDLE_TIMEOUT_MS);
#if CONFIG_NUWAX_SPEAKER_ENABLE
        (void)update_normal_downlink_admission(true);
#endif
        if (!notification_rx_barrier_admit_epoch(
                ws_epoch,
                s_notification_transaction.notify_id,
                s_notification_transaction.playback_id)) {
            notification_fail_and_recover(
                "notification RX ownership commit failed",
                "notify_playback_begin_ack");
            return;
        }
        const esp_err_t ack_err = send_notification_event_ack(
            ws,
            "notify_playback_begin_ack",
            s_notification_transaction.begin_request_id,
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            true,
            "ready",
            ws_epoch);
        if (ack_err != ESP_OK ||
            !nuwax_notification_mark_begin_ack_sent(
                &s_notification_transaction, token, ws_epoch)) {
            notification_fail_and_recover("begin ACK failed",
                                          "notify_playback_begin_ack");
            return;
        }
        set_conversation_status_guarded(
            "NOTICE", "BUFFERING", "notification", true);
        ESP_LOGI(TAG,
                 "notification stream admitted token=%lu epoch=%lu notify=%s playback=%s",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 s_notification_transaction.notify_id,
                 s_notification_transaction.playback_id);
        return;
    }

    if (nuwax_notification_ready_to_complete(
            &s_notification_transaction)) {
        const esp_err_t ack_err = send_notification_event_ack(
            ws,
            "notify_playback_end_ack",
            s_notification_transaction.end_request_id,
            s_notification_transaction.notify_id,
            s_notification_transaction.playback_id,
            true,
            "completed",
            ws_epoch);
        if (ack_err != ESP_OK ||
            !nuwax_notification_mark_end_ack_sent(
                &s_notification_transaction, token, ws_epoch) ||
            !nuwax_notification_complete(
                &s_notification_transaction, token)) {
            notification_fail_and_recover("end ACK failed",
                                          "notify_playback_end_ack");
            return;
        }
        ESP_LOGI(TAG,
                 "notification completed token=%lu epoch=%lu notify=%s playback=%s origin_sleeping=%d; restoring origin",
                 (unsigned long)token,
                 (unsigned long)ws_epoch,
                 s_notification_transaction.notify_id,
                 s_notification_transaction.playback_id,
                 s_notification_transaction.origin_sleeping ? 1 : 0);
        finish_notification_to_origin("notification_complete");
        return;
    }

    if (nuwax_notification_cancel_ready(&s_notification_transaction)) {
        char request_id[40] = {0};
        snprintf(request_id,
                 sizeof(request_id),
                 "notify_cancel_%lu",
                 (unsigned long)++s_notification_cancel_sequence);
        esp_err_t notify_err = ESP_OK;
        if (s_notification_transaction.playback_id[0]) {
            notify_err =
                nuwax_session_send_notify_playback_cancelled_until_if_epoch(
                    ws,
                    request_id,
                    s_notification_transaction.notify_id,
                    s_notification_transaction.playback_id,
                    s_notification_cancel_reason[0]
                        ? s_notification_cancel_reason
                        : "cancelled",
                    esp_timer_get_time() +
                        NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
                    ws_epoch);
        }
        if (notify_err != ESP_OK ||
            !nuwax_notification_mark_cancel_notified(
                &s_notification_transaction, token, ws_epoch)) {
            notification_fail_and_recover("cancel notification failed",
                                          NULL);
            return;
        }
#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (s_notification_transaction.playback_id[0]) {
            nuwax_speaker_playback_note_notification_end(
                s_notification_transaction.notify_id,
                s_notification_transaction.playback_id,
                s_notification_cancel_reason);
        }
#endif
        if (!nuwax_notification_complete(
                &s_notification_transaction, token)) {
            return;
        }
        ESP_LOGI(TAG,
                 "notification cancellation completed token=%lu notify=%s playback=%s reason=%s",
                 (unsigned long)token,
                 s_notification_transaction.notify_id,
                 s_notification_transaction.playback_id,
                 s_notification_cancel_reason[0]
                     ? s_notification_cancel_reason
                     : "notification_cancelled");
        finish_notification_cancellation(
            s_notification_cancel_reason[0]
                ? s_notification_cancel_reason
                : "notification_cancelled");
        return;
    }

    if (!nuwax_notification_deadline_expired(
            &s_notification_transaction, monotonic_ms())) {
        return;
    }
    switch (s_notification_transaction.state) {
        case NUWAX_NOTIFICATION_STATE_PREPARING:
        case NUWAX_NOTIFICATION_STATE_READY:
            notification_fail_and_recover("notification prepare timeout",
                                          NULL);
            break;
        case NUWAX_NOTIFICATION_STATE_BEGIN_PENDING:
            notification_fail_and_recover("notification begin timeout",
                                          "notify_playback_begin_ack");
            break;
        case NUWAX_NOTIFICATION_STATE_STREAMING:
        case NUWAX_NOTIFICATION_STATE_DRAINING:
            cancel_active_notification(ws,
                                       "notification stream timeout");
            break;
        case NUWAX_NOTIFICATION_STATE_CANCELLING:
            ESP_LOGE(TAG,
                     "notification cancel barrier timed out token=%lu epoch=%lu; closing bound WebSocket",
                     (unsigned long)token,
                     (unsigned long)ws_epoch);
            (void)nuwax_ws_request_close_if_epoch(ws, ws_epoch);
            notification_fail_and_recover(
                "notification cancel barrier timeout", NULL);
            break;
        case NUWAX_NOTIFICATION_STATE_IDLE:
        case NUWAX_NOTIFICATION_STATE_COMPLETE:
        default:
            break;
    }
}

static void recover_normal_conversation_after_playback_abort(
    const char *reason) {
    if (local_power_transition_active()) {
        ESP_LOGI(TAG,
                 "playback recovery handoff suppressed while local power sleep converges reason=%s",
                 reason ? reason : "-");
        return;
    }
    if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        return;
    }
    if (nuwax_awake_session_state_is_active(&s_awake_session)) {
        reset_awake_wait_budget_paused(
            reason ? reason : "playback_abort");
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (nuwax_capture_phase_cancel_recovery_needs_resume(
            s_prelisten.capture_active,
            nuwax_prelisten_state_mode_is(&s_prelisten,
                                            "during_playback"),
            nuwax_prelisten_state_mode_is(&s_prelisten, "barge_in"))) {
        s_post_playback_resume_pending = true;
        set_state(NUWAX_APP_STATE_LISTENING);
        ESP_LOGI(TAG,
                 "speaker fault recovery kept active %s capture and requested post-playback resume reason=%s",
                 nuwax_prelisten_state_mode_or(&s_prelisten,
                                                "during_playback"),
                 reason ? reason : "-");
        return;
    }
#endif
    return_to_listening_after_cancel(reason ? reason : "playback_abort");
}

static bool resume_awake_conversation_after_inactivity(const char *reason) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        return false;
    }

    const uint32_t now_ms = monotonic_ms();
    const uint32_t remaining_ms =
        nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms);
    if (remaining_ms == 0) {
        ESP_LOGI(TAG,
                 "conversation awake session expired reason=%s",
                 reason ? reason : "-");
        return false;
    }
    if (exclusive_audio_mode_blocks_normal_audio()) {
        return true;
    }
    if (s_prelisten.capture_active) {
        resume_awake_waiting(reason ? reason : "resume_active_capture");
        return true;
    }
    if (s_prelisten.pending) {
        return true;
    }
    if (nuwax_app_shell_blocks_auto_followup()) {
        set_state(NUWAX_APP_STATE_IDLE);
        ESP_LOGI(TAG,
                 "conversation awake resume deferred by menu reason=%s remaining_ms=%lu",
                 reason ? reason : "-",
                 (unsigned long)remaining_ms);
        return true;
    }

    clear_last_listen_resume();
    const uint32_t window_ms = awake_session_listen_window_ms(now_ms);
    ESP_LOGI(TAG,
             "conversation awake session continues reason=%s remaining_ms=%lu window_ms=%lu",
             reason ? reason : "-",
             (unsigned long)remaining_ms,
             (unsigned long)window_ms);
    start_prelisten_window("awake_session", window_ms, 0);
    return true;
#else
    (void)reason;
    return false;
#endif
}

/* Queue presence is deliberately broader than ownership: a stale/no-op mode
 * event may still be waiting while both mode controllers remain DISABLED.
 * It must preempt the normal source long enough to be consumed, but it must
 * not permanently suppress reconnect recovery. */
static bool exclusive_audio_owner_active(void) {
    return atomic_load_explicit(&s_reprovision_quiesce_requested,
                                memory_order_acquire) ||
           nuwax_meeting_mode_state(&s_meeting_mode) !=
               NUWAX_MEETING_STATE_DISABLED ||
           nuwax_monitoring_mode_state(&s_monitoring_mode) !=
               NUWAX_MONITORING_STATE_DISABLED;
}

static void clear_ws_reconnect_audio_recovery(void) {
    memset(&s_ws_audio_recovery, 0, sizeof(s_ws_audio_recovery));
}

static bool arm_ws_reconnect_audio_recovery(nuwax_ws_client_t *ws,
                                            const char *reason) {
    if (!ws || !nuwax_ws_is_connected(ws) ||
        !nuwax_awake_session_state_is_active(&s_awake_session)) {
        clear_ws_reconnect_audio_recovery();
        return false;
    }
    const uint32_t ws_epoch = nuwax_ws_connection_epoch(ws);
    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (ws_epoch == 0U || ws_epoch != active_epoch ||
        awake_generation == 0U) {
        clear_ws_reconnect_audio_recovery();
        ESP_LOGE(TAG,
                 "WebSocket reconnect audio recovery arm rejected reason=%s ws_epoch=%lu active_epoch=%lu awake_generation=%lu",
                 reason ? reason : "-",
                 (unsigned long)ws_epoch,
                 (unsigned long)active_epoch,
                 (unsigned long)awake_generation);
        return false;
    }
    s_ws_audio_recovery.pending = true;
    s_ws_audio_recovery.ws_epoch = ws_epoch;
    s_ws_audio_recovery.awake_generation = awake_generation;
    s_ws_audio_recovery.deadline_ms =
        monotonic_ms() + NUWAX_WS_RECONNECT_AUDIO_RECOVERY_TIMEOUT_MS;
    ESP_LOGI(TAG,
             "WebSocket reconnect audio recovery armed reason=%s epoch=%lu awake_generation=%lu deadline_ms=%lu",
             reason ? reason : "-",
             (unsigned long)ws_epoch,
             (unsigned long)awake_generation,
             (unsigned long)s_ws_audio_recovery.deadline_ms);
    return true;
}

static nuwax_ws_recovery_result_t
recover_awake_conversation_after_ws_reconnect(nuwax_ws_client_t *ws,
                                               const char *reason) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    const uint32_t now_ms = monotonic_ms();
    const uint32_t ws_epoch = ws ? nuwax_ws_connection_epoch(ws) : 0U;
    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (!s_ws_audio_recovery.pending || !ws ||
        !nuwax_ws_is_connected(ws) || ws_epoch == 0U ||
        ws_epoch != active_epoch || ws_epoch != s_ws_audio_recovery.ws_epoch ||
        awake_generation != s_ws_audio_recovery.awake_generation ||
        !nuwax_awake_session_state_is_active(&s_awake_session) ||
        nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms) ==
            0U) {
        ESP_LOGE(TAG,
                 "WebSocket reconnect audio recovery context mismatch reason=%s pending=%d ws_epoch=%lu active_epoch=%lu bound_epoch=%lu awake_generation=%lu bound_generation=%lu awake_active=%d",
                 reason ? reason : "-",
                 s_ws_audio_recovery.pending ? 1 : 0,
                 (unsigned long)ws_epoch,
                 (unsigned long)active_epoch,
                 (unsigned long)s_ws_audio_recovery.ws_epoch,
                 (unsigned long)awake_generation,
                 (unsigned long)s_ws_audio_recovery.awake_generation,
                 nuwax_awake_session_state_is_active(&s_awake_session) ? 1 : 0);
        return NUWAX_WS_RECOVERY_FALLBACK_SLEEP;
    }
    if (exclusive_audio_owner_active()) {
        ESP_LOGI(TAG,
                 "WebSocket reconnect recovery transferred to exclusive audio owner reason=%s meeting_state=%d monitoring_state=%d",
                 reason ? reason : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
        clear_awake_session("ws_reconnect_handoff_to_exclusive");
        return NUWAX_WS_RECOVERY_TRANSFERRED_TO_OWNER;
    }
    if (exclusive_audio_mode_blocks_normal_audio()) {
        return NUWAX_WS_RECOVERY_WAIT_MODE_QUEUE;
    }
    if (nuwax_app_shell_blocks_auto_followup()) {
        clear_ws_reconnect_audio_recovery();
        set_state(NUWAX_APP_STATE_IDLE);
        ESP_LOGI(TAG,
                 "WebSocket reconnect recovery deferred by menu reason=%s remaining_ms=%lu",
                 reason ? reason : "-",
                 (unsigned long)nuwax_awake_session_state_remaining_ms(
                     &s_awake_session, now_ms));
        return NUWAX_WS_RECOVERY_MENU_BLOCKED;
    }

    /* A disconnect may race a speaker stop or capture cleanup. Never trust a
     * pending/capture flag that was owned by the old connection epoch. */
    nuwax_prelisten_state_clear(&s_prelisten);
    clear_last_listen_resume();
    s_post_playback_resume_pending = false;
    s_during_playback_handoff_pending = false;
    s_during_playback_handoff_playback_started = false;
    s_during_playback_handoff_seamless = false;

    const uint32_t window_ms = awake_session_listen_window_ms(now_ms);
    start_prelisten_window("awake_session", window_ms, 0U);
    if (!s_prelisten.pending && !s_prelisten.capture_active) {
        ESP_LOGE(TAG,
                 "WebSocket reconnect recovery failed to arm awake capture reason=%s",
                 reason ? reason : "-");
        return NUWAX_WS_RECOVERY_FALLBACK_SLEEP;
    }
    if (conversation_state_current() != NUWAX_APP_STATE_LISTENING) {
        ESP_LOGE(TAG,
                 "WebSocket reconnect recovery armed capture without LISTENING state reason=%s state=%s",
                 reason ? reason : "-",
                 nuwax_app_state_name(conversation_state_current()));
        return NUWAX_WS_RECOVERY_FALLBACK_SLEEP;
    }
    clear_ws_reconnect_audio_recovery();
    ESP_LOGI(TAG,
             "WebSocket reconnect recovery converged target=awake_prelisten reason=%s window_ms=%lu state=%s",
             reason ? reason : "-",
             (unsigned long)window_ms,
             nuwax_app_state_name(conversation_state_current()));
    return NUWAX_WS_RECOVERY_CONVERGED;
#else
    (void)ws;
    (void)reason;
    return NUWAX_WS_RECOVERY_FALLBACK_SLEEP;
#endif
}

static void service_pending_ws_reconnect_audio_recovery(
    nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (!s_ws_audio_recovery.pending || !ws ||
        !nuwax_ws_is_connected(ws)) {
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    const nuwax_ws_recovery_result_t result =
        recover_awake_conversation_after_ws_reconnect(
            ws, "ws_reconnect_deferred_retry");
    if (result == NUWAX_WS_RECOVERY_FALLBACK_SLEEP) {
        clear_ws_reconnect_audio_recovery();
        enter_sleeping_conversation_state("ws_reconnect_recovery_expired");
        return;
    }
    if (result == NUWAX_WS_RECOVERY_WAIT_MODE_QUEUE &&
        elapsed_ms(now_ms, s_ws_audio_recovery.deadline_ms)) {
        const uint32_t epoch = nuwax_ws_connection_epoch(ws);
        ESP_LOGW(TAG,
                 "WebSocket reconnect audio recovery timed out while queued controls remained; rejecting pending controls and restoring wake-ready sleeping state epoch=%lu",
                 (unsigned long)epoch);
        const esp_err_t monitoring_abort =
            nuwax_monitoring_mode_abort_pending_controls(
                &s_monitoring_mode, ws, epoch, "device_recovery_timeout");
        const esp_err_t meeting_abort =
            nuwax_meeting_mode_abort_pending_controls(
                &s_meeting_mode, ws, epoch, "device_recovery_timeout");
        if (monitoring_abort != ESP_OK || meeting_abort != ESP_OK) {
            ESP_LOGE(TAG,
                     "WebSocket reconnect pending-control abort incomplete monitoring=%s meeting=%s",
                     esp_err_to_name(monitoring_abort),
                     esp_err_to_name(meeting_abort));
        }
        clear_ws_reconnect_audio_recovery();
        enter_sleeping_conversation_state("ws_reconnect_recovery_timeout");
    }
#else
    (void)ws;
#endif
}

static bool publish_listening_after_current_asr_failure(const char *reason) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool playback_owner_active =
        nuwax_speaker_playback_has_pending() ||
        nuwax_playback_terminal_guard_waiting(&s_playback_terminal_guard);
#else
    const bool playback_owner_active = false;
#endif
    const bool during_playback_capture =
        s_during_playback_handoff_pending ||
        (s_prelisten.capture_active &&
         nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback"));
    const bool awake_owner_active =
        nuwax_awake_session_state_is_active(&s_awake_session);
    const bool exclusive_owner_active =
        exclusive_audio_mode_blocks_normal_audio();
    const bool sleep_owner_active = sleep_lifecycle_blocks_new_capture();
    const bool turn_owner_active = s_turn_guard.active;
    const bool interaction_owner_active =
        s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE;
    if (!awake_owner_active ||
        playback_owner_active || during_playback_capture ||
        exclusive_owner_active || sleep_owner_active || turn_owner_active ||
        interaction_owner_active) {
        ESP_LOGI(TAG,
                 "ASR failure listening transition isolated reason=%s awake=%d playback=%d during_playback=%d exclusive=%d sleep=%d turn=%d interaction=%d",
                 reason ? reason : "-",
                 awake_owner_active ? 1 : 0,
                 playback_owner_active ? 1 : 0,
                 during_playback_capture ? 1 : 0,
                 exclusive_owner_active ? 1 : 0,
                 sleep_owner_active ? 1 : 0,
                 turn_owner_active ? 1 : 0,
                 interaction_owner_active ? 1 : 0);
        return false;
    }

    /* End the failed cloud-wait visual before capture recovery. LISTENING also
     * fences semantic emotions and timers owned by the failed round. */
    nuwax_state_bridge_clear_waiting_question();
    set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
    set_state(NUWAX_APP_STATE_LISTENING);
    ESP_LOGI(TAG, "ASR failure returned to listening reason=%s",
             reason ? reason : "-");
    return conversation_state_current() == NUWAX_APP_STATE_LISTENING;
#else
    (void)reason;
    return false;
#endif
}

static bool resume_prelisten_after_no_speech(void) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool playback_guard_active = nuwax_speaker_playback_has_pending();
#else
    const bool playback_guard_active = false;
#endif
    const bool during_playback_capture_active =
        s_prelisten.capture_active &&
        nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback");
    if (playback_guard_active ||
        s_during_playback_handoff_pending ||
        during_playback_capture_active) {
        ESP_LOGI(TAG,
                 "ASR no-speech playback guard; keep during-playback capture pending=%d handoff=%d active=%d",
                 playback_guard_active ? 1 : 0,
                 s_during_playback_handoff_pending ? 1 : 0,
                 during_playback_capture_active ? 1 : 0);
        clear_last_listen_resume();
        request_during_playback_capture("asr_no_speech_playback_guard",
                                        playback_guard_active);
        return true;
    }

    if (!nuwax_listen_resume_state_has_no_speech(&s_listen_resume)) {
        if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
            ESP_LOGI(TAG,
                     "stale ASR no-speech ignored outside an awake session");
            clear_last_listen_resume();
            return true;
        }
        if (!publish_listening_after_current_asr_failure(
                "asr_no_speech_no_resume_state")) {
            return true;
        }
        return resume_awake_conversation_after_inactivity(
            "asr_no_resume_state");
    }

    if (!publish_listening_after_current_asr_failure("asr_no_speech")) {
        return true;
    }

    const uint32_t now_ms = monotonic_ms();
    const uint32_t deadline_ms = nuwax_listen_resume_state_deadline_ms(&s_listen_resume);
    if (elapsed_ms(now_ms, deadline_ms)) {
        ESP_LOGI(TAG,
                 "ASR no-speech resume skipped; listen window expired mode=%s",
                 nuwax_listen_resume_state_mode_or(&s_listen_resume, "-"));
        clear_last_listen_resume();
        return resume_awake_conversation_after_inactivity("asr_listen_window_expired");
    }

    uint32_t remaining_ms = deadline_ms - now_ms;
    if (remaining_ms <= NUWAX_CONVERSATION_NO_SPEECH_RESUME_GRACE_MS) {
        ESP_LOGI(TAG,
                 "ASR no-speech resume skipped; remaining_ms=%lu too short",
                 (unsigned long)remaining_ms);
        clear_last_listen_resume();
        return resume_awake_conversation_after_inactivity("asr_listen_window_short");
    }

    char mode[NUWAX_LISTEN_RESUME_MODE_MAX_LEN] = {0};
    strlcpy(mode,
            nuwax_listen_resume_state_mode_or(&s_listen_resume, "auto_followup"),
            sizeof(mode));
    clear_last_listen_resume();
    ESP_LOGI(TAG,
             "ASR no-speech ignored; resume listening mode=%s remaining_ms=%lu grace_ms=%u",
             mode,
             (unsigned long)remaining_ms,
             (unsigned)NUWAX_CONVERSATION_NO_SPEECH_RESUME_GRACE_MS);
    start_prelisten_window(
        mode, remaining_ms,
        NUWAX_CONVERSATION_NO_SPEECH_RESUME_GRACE_MS);
    return true;
#else
    return false;
#endif
}

static bool awake_idle_sleep_admitted(uint32_t now_ms) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    /* At the 60-second boundary END/listen-stop may already be committed
     * while the matching cloud response is still queued. Keep the awake
     * owner until that bounded response window converges. */
    if (nuwax_listen_resume_state_holds_idle_expiry_boundary(
            &s_listen_resume)) {
        return false;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const bool playback_active = nuwax_speaker_playback_has_pending();
#else
    const bool playback_active = false;
#endif
    return nuwax_awake_session_state_can_enter_idle_sleep(
        &s_awake_session,
        now_ms,
        conversation_state_current() == NUWAX_APP_STATE_LISTENING,
        s_turn_guard.active,
        playback_active,
        false);
}

static void maybe_enter_idle_sleep(void) {
    const uint32_t now_ms = monotonic_ms();
    if (nuwax_awake_session_state_is_active(&s_awake_session)) {
        if (awake_idle_sleep_admitted(now_ms)) {
            if (sleep_transaction_blocks_new_audio()) {
                return;
            }
            enter_sleeping_conversation_state("awake_idle_timeout");
            return;
        }
        if (!nuwax_awake_session_state_is_waiting(&s_awake_session)) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
            if (conversation_state_current() == NUWAX_APP_STATE_IDLE &&
                !s_prelisten.pending && !s_prelisten.capture_active &&
                !exclusive_audio_mode_blocks_normal_audio() &&
                !nuwax_app_shell_blocks_auto_followup()) {
                ESP_LOGI(TAG,
                         "conversation awake paused session resuming after idle/menu handoff remaining_ms=%lu",
                         (unsigned long)nuwax_awake_session_state_remaining_ms(
                             &s_awake_session, now_ms));
                start_prelisten_window("awake_session",
                                       awake_session_listen_window_ms(now_ms),
                                       0);
            }
#endif
            return;
        }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
        if (!s_prelisten.pending && !s_prelisten.capture_active &&
            !exclusive_audio_mode_blocks_normal_audio() &&
            !nuwax_app_shell_blocks_auto_followup()) {
            const uint32_t remaining_ms =
                nuwax_awake_session_state_remaining_ms(&s_awake_session, now_ms);
            const uint32_t window_ms = awake_session_listen_window_ms(now_ms);
            ESP_LOGI(TAG,
                     "conversation awake session maintaining listen remaining_ms=%lu window_ms=%lu",
                     (unsigned long)remaining_ms,
                     (unsigned long)window_ms);
            start_prelisten_window("awake_session", window_ms, 0);
        }
#endif
        return;
    }
    /* Ordinary IDLE is intentionally not an automatic sleep state.  The
     * only local inactivity deadline is the rolling awake-session budget
     * above, which is started by a wake/touch/speech event and expires only
     * while the normal conversation path is LISTENING. */
    (void)now_ms;
}

static bool is_no_speech_asr_error(const char *error) {
    return error && (strcmp(error, "no_speech") == 0 ||
                     strstr(error, "no transcript") != NULL ||
                     strstr(error, "no speech") != NULL);
}

#if CONFIG_NUWAX_SPEAKER_ENABLE
static bool speaker_owner_event_loss_is_critical(
    nuwax_speaker_owner_event_type_t type) {
    return type == NUWAX_SPEAKER_OWNER_EVENT_TTS_START ||
           type == NUWAX_SPEAKER_OWNER_EVENT_FIRST_PCM_WRITTEN ||
           type == NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_DONE ||
           type == NUWAX_SPEAKER_OWNER_EVENT_STREAM_END ||
           type == NUWAX_SPEAKER_OWNER_EVENT_CANCEL_RECOVERY ||
           type == NUWAX_SPEAKER_OWNER_EVENT_START_GATE_TIMEOUT ||
           type == NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_FAULT;
}

static void mark_speaker_owner_event_overflow(uint32_t ws_connection_epoch,
                                              uint32_t speaker_generation) {
    if (ws_connection_epoch == 0U || speaker_generation == 0U) {
        ESP_LOGE(TAG,
                 "speaker owner overflow missing source binding epoch=%lu generation=%lu; refusing to attribute it to the active turn",
                 (unsigned long)ws_connection_epoch,
                 (unsigned long)speaker_generation);
        return;
    }
    portENTER_CRITICAL(&s_speaker_owner_overflow_lock);
    if (s_speaker_owner_event_overflow_epoch == 0U ||
        ws_connection_epoch > s_speaker_owner_event_overflow_epoch ||
        (ws_connection_epoch == s_speaker_owner_event_overflow_epoch &&
         speaker_generation >= s_speaker_owner_event_overflow_generation)) {
        s_speaker_owner_event_overflow_epoch = ws_connection_epoch;
        s_speaker_owner_event_overflow_generation = speaker_generation;
    }
    portEXIT_CRITICAL(&s_speaker_owner_overflow_lock);
}

static bool enqueue_speaker_owner_event(nuwax_speaker_owner_event_t event) {
    if (event.event_timestamp_us == 0) {
        event.event_timestamp_us = esp_timer_get_time();
    }
    if (event.type != NUWAX_SPEAKER_OWNER_EVENT_VOLUME &&
        event.ws_connection_epoch == 0U) {
        ESP_LOGE(TAG,
                 "speaker owner event missing source WebSocket epoch type=%d generation=%lu; dropping invariant violation",
                 (int)event.type,
                 (unsigned long)event.speaker_generation);
        return false;
    }
    if (s_speaker_owner_events &&
        xQueueSend(s_speaker_owner_events, &event, 0) == pdTRUE) {
        notify_conversation_owner();
        return true;
    }
    if (speaker_owner_event_loss_is_critical(event.type)) {
        mark_speaker_owner_event_overflow(event.ws_connection_epoch,
                                          event.speaker_generation);
        ESP_LOGE(TAG,
                 "critical speaker owner event queue overflow type=%d generation=%lu ws_epoch=%lu",
                 (int)event.type,
                 (unsigned long)event.speaker_generation,
                 (unsigned long)event.ws_connection_epoch);
    } else {
        ESP_LOGW(TAG,
                 "coalescible speaker owner event dropped under queue pressure type=%d generation=%lu ws_epoch=%lu",
                 (int)event.type,
                 (unsigned long)event.speaker_generation,
                 (unsigned long)event.ws_connection_epoch);
    }
    return false;
}

static nuwax_app_state_t speaker_callback_get_state(void) {
    return conversation_state_current();
}

static void speaker_callback_on_start_pending(uint32_t ws_connection_epoch,
                                               uint32_t generation) {
    atomic_store_explicit(&s_pending_speaker_start_generation,
                          generation,
                          memory_order_release);
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_TTS_START,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
    });
}

static void speaker_callback_on_first_pcm_written(
    uint32_t ws_connection_epoch,
    uint32_t generation,
    int64_t timestamp_us) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_FIRST_PCM_WRITTEN,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
        .event_timestamp_us = timestamp_us,
    });
}

static void speaker_callback_on_start_gate_timeout(uint32_t ws_connection_epoch,
                                                   uint32_t generation) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_START_GATE_TIMEOUT,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
    });
}

static void clear_pending_speaker_start_if(uint32_t generation) {
    if (generation == 0U) {
        return;
    }
    uint_fast32_t expected = generation;
    (void)atomic_compare_exchange_strong_explicit(
        &s_pending_speaker_start_generation,
        &expected,
        0U,
        memory_order_acq_rel,
        memory_order_acquire);
}

static void speaker_callback_on_playback_fault(uint32_t ws_connection_epoch,
                                               uint32_t generation,
                                               esp_err_t result) {
    atomic_store_explicit(&s_reported_speaker_fault_generation,
                          generation,
                          memory_order_release);
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_FAULT,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
        .fault_result = result,
    });
}

static void report_current_speaker_ingress_fault(uint32_t ws_connection_epoch,
                                                 esp_err_t result,
                                                 const char *reason) {
    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    uint32_t generation = 0U;
    if ((stats.start_gate_pending || stats.start_gate_authorized) &&
        stats.start_gate_connection_epoch == ws_connection_epoch) {
        generation = stats.start_gate_generation;
    } else if (stats.playback_active &&
               stats.playback_connection_epoch == ws_connection_epoch) {
        generation = stats.playback_generation;
    } else if (stats.rx_stream_active &&
               stats.submitted_connection_epoch == ws_connection_epoch) {
        generation = stats.submitted_generation;
    }
    if (generation == 0U) {
        ESP_LOGW(TAG,
                 "unowned speaker ingress fault dropped result=%s reason=%s; current turn retained",
                 esp_err_to_name(result),
                 reason ? reason : "-");
        return;
    }
    ESP_LOGE(TAG,
             "speaker ingress fault attributed generation=%lu result=%s reason=%s",
             (unsigned long)generation,
             esp_err_to_name(result),
             reason ? reason : "-");
    (void)nuwax_device_error_report_enqueue(
        "error", "speaker", reason && reason[0] ? reason : "ingress_fault",
        result, nuwax_app_state_name(conversation_state_current()), generation,
        NULL);
    speaker_callback_on_playback_fault(ws_connection_epoch,
                                       generation,
                                       result);
}

static void speaker_callback_on_playback_done(uint32_t ws_connection_epoch,
                                              uint32_t generation,
                                              uint32_t played_frames,
                                              uint32_t write_failures) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_DONE,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
        .played_frames = played_frames,
        .write_failures = write_failures,
    });
}

static void speaker_callback_on_stream_end(uint32_t ws_connection_epoch,
                                           uint32_t generation) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_STREAM_END,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
    });
}

static void speaker_callback_on_playback_progress(uint32_t ws_connection_epoch,
                                                  uint32_t generation,
                                                  uint32_t played_frames,
                                                  uint64_t played_bytes,
                                                  uint32_t progress_ms) {
    (void)ws_connection_epoch;
    (void)generation;
    (void)played_frames;
    (void)played_bytes;
    (void)progress_ms;
    /* Consuming already-buffered PCM does not prove that the cloud is still
     * sending audio. Only accepted ingress may refresh the idle deadline. */
}

static void speaker_callback_on_ingress_progress(uint32_t ws_connection_epoch,
                                                 uint32_t generation) {
    if (ws_connection_epoch == 0U || generation == 0U) {
        return;
    }
    /* Collapse accepted PCM ingress into a latest-wins slot so a sustained
     * stream cannot consume queue capacity reserved for lifecycle edges. */
    portENTER_CRITICAL(&s_speaker_ingress_lock);
    s_speaker_ingress_pending = true;
    s_speaker_ingress_epoch = ws_connection_epoch;
    s_speaker_ingress_generation = generation;
    portEXIT_CRITICAL(&s_speaker_ingress_lock);
}

static bool speaker_callback_schedule_auto_followup(
    uint32_t ws_connection_epoch,
    uint32_t generation) {
    (void)ws_connection_epoch;
    (void)generation;
    /* PLAYBACK_DONE is already queued to the sole conversation owner. */
    return true;
}

static void speaker_callback_set_state(uint32_t ws_connection_epoch,
                                       uint32_t generation,
                                       nuwax_app_state_t state) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_STATE,
        .state = state,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
    });
}

static void speaker_callback_return_to_listening_after_cancel(
    uint32_t ws_connection_epoch,
    uint32_t generation,
    const char *reason) {
    (void)reason;
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_CANCEL_RECOVERY,
        .ws_connection_epoch = ws_connection_epoch,
        .speaker_generation = generation,
    });
}

static void speaker_callback_on_volume_changed(uint8_t volume_percent) {
    (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
        .type = NUWAX_SPEAKER_OWNER_EVENT_VOLUME,
        .volume_percent = volume_percent,
    });
}

static bool finalize_playback_terminal_if_ready(const char *reason) {
    if (!nuwax_playback_terminal_guard_ready(&s_playback_terminal_guard)) {
        return false;
    }

    const bool faulted = s_playback_terminal_guard.faulted;
    const bool natural_completion =
        !faulted && s_playback_terminal_guard.logical_end_completed;
    const uint32_t connection_epoch =
        s_playback_terminal_guard.connection_epoch;
    const uint32_t generation = s_playback_terminal_guard.speaker_generation;
    const bool interaction_completion =
        nuwax_conversation_visual_round_is_interaction(&s_visual_round) &&
        nuwax_conversation_visual_round_speaker_matches(
            &s_visual_round, connection_epoch, generation);
    const bool local_power_sleep_owner = local_power_transition_active();
    char turn_id[sizeof(s_playback_terminal_guard.turn_id)] = {0};
    char playback_id[sizeof(s_playback_terminal_guard.playback_id)] = {0};
    strlcpy(turn_id,
            s_playback_terminal_guard.turn_id,
            sizeof(turn_id));
    strlcpy(playback_id,
            s_playback_terminal_guard.playback_id,
            sizeof(playback_id));
    nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);

    if (natural_completion) {
        s_natural_playback_touch_protection_deadline_ms =
            monotonic_ms() + NUWAX_NATURAL_PLAYBACK_TOUCH_PROTECTION_MS;
        ESP_LOGI(TAG,
                 "natural playback touch protection armed window_ms=%u",
                 (unsigned)NUWAX_NATURAL_PLAYBACK_TOUCH_PROTECTION_MS);
    }

    if (s_speaker_fault_recovery_epoch == connection_epoch &&
        s_speaker_fault_recovery_generation == generation) {
        s_speaker_fault_recovery_epoch = 0U;
        s_speaker_fault_recovery_generation = 0U;
    }
    const bool listening_owner_available =
        !local_power_sleep_owner &&
        !s_deferred_sleep_intent.active &&
        !exclusive_audio_mode_blocks_normal_audio() &&
        nuwax_awake_session_state_is_active(&s_awake_session);
    if (listening_owner_available) {
        /* Publish the lifecycle boundary before retiring the visual owner.
         * This prevents an interaction clear or semantic clear from briefly
         * exposing the SPEAKING fallback face between two owner callbacks. */
        set_conversation_status_guarded("VOICE", "LISTENING", "listening", true);
        set_state(NUWAX_APP_STATE_LISTENING);
    }
    if (nuwax_turn_guard_speaker_generation_matches(&s_turn_guard, generation)) {
        clear_active_turn_guard(faulted
                                    ? "speaker_fault_terminal_complete"
                                    : "speaker_playback_terminal_complete");
    }
    if (interaction_completion && listening_owner_available &&
        conversation_state_current() == NUWAX_APP_STATE_LISTENING) {
        /* Clearing the interaction visual owner is a second asynchronous UI
         * revision. Reassert LISTENING afterwards so the newest mailbox value
         * always carries listening+listening and no stale pinned face can win
         * the final publish race. set_state() performs an immediate bridge
         * update when the UI is live, even when the logical enum is unchanged. */
        set_conversation_status_guarded(
            "VOICE", "LISTENING", "listening", true);
        set_state(NUWAX_APP_STATE_LISTENING);
        ESP_LOGI(TAG,
                 "interaction playback completion published listening lifecycle epoch=%lu generation=%lu",
                 (unsigned long)connection_epoch,
                 (unsigned long)generation);
    }

    ESP_LOGI(TAG,
             "playback terminal barrier released epoch=%lu generation=%lu turn=%s playback=%s faulted=%d reason=%s",
             (unsigned long)connection_epoch,
             (unsigned long)generation,
             turn_id[0] ? turn_id : "-",
             playback_id[0] ? playback_id : "-",
             faulted ? 1 : 0,
             reason ? reason : "-");
    if (local_power_sleep_owner ||
        conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        return true;
    }
    if (faulted) {
        recover_normal_conversation_after_playback_abort(
            reason ? reason : "speaker_fault_terminal_complete");
    } else if (!schedule_auto_followup_after_playback()) {
        set_state(NUWAX_APP_STATE_IDLE);
    }
    return true;
}

static bool send_playback_fault_cancel(const char *reason) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!s_playback_terminal_guard.active ||
        !s_playback_terminal_guard.faulted) {
        return false;
    }
    if (s_playback_terminal_guard.cancel_sent) {
        return true;
    }

    const uint32_t connection_epoch =
        s_playback_terminal_guard.connection_epoch;
    const uint32_t speaker_generation =
        s_playback_terminal_guard.speaker_generation;
    uint32_t active_epoch = 0U;
    nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
    if (!ws || active_epoch != connection_epoch ||
        !nuwax_ws_is_connected(ws)) {
        ESP_LOGE(TAG,
                 "playback fault cancel has no matching WebSocket epoch=%lu active_epoch=%lu generation=%lu",
                 (unsigned long)connection_epoch,
                 (unsigned long)active_epoch,
                 (unsigned long)speaker_generation);
        return false;
    }

    char request_id[NUWAX_PLAYBACK_CANCEL_REQUEST_ID_MAX_LEN] = {0};
    snprintf(request_id,
             sizeof(request_id),
             "fault_cancel_%lu",
             (unsigned long)++s_cancel_turn_request_seq);
    const int64_t deadline_us =
        esp_timer_get_time() +
        (int64_t)NUWAX_PLAYBACK_TIMEOUT_CANCEL_SEND_MS * 1000LL;
    const esp_err_t send_err =
        nuwax_session_send_cancel_turn_until_if_epoch(
            ws,
            request_id,
            s_playback_terminal_guard.turn_id,
            reason ? reason : "speaker_playback_fault",
            deadline_us,
            connection_epoch);
    if (send_err != ESP_OK ||
        !nuwax_playback_terminal_guard_mark_cancel_sent(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            request_id,
            monotonic_ms(),
            NUWAX_PLAYBACK_FAULT_CANCEL_ACK_TIMEOUT_MS)) {
        ESP_LOGW(TAG,
                 "playback fault cancel_turn not committed epoch=%lu generation=%lu request=%s err=%s; old generation remains quarantined and WebSocket is retained",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 request_id,
                 esp_err_to_name(send_err));
        return true;
    }

    ESP_LOGI(TAG,
             "playback fault cancel_turn sent epoch=%lu generation=%lu request=%s turn=%s playback=%s ack_timeout_ms=%u",
             (unsigned long)connection_epoch,
             (unsigned long)speaker_generation,
             request_id,
             s_playback_terminal_guard.turn_id,
             s_playback_terminal_guard.playback_id,
             (unsigned)NUWAX_PLAYBACK_FAULT_CANCEL_ACK_TIMEOUT_MS);
    return true;
#else
    (void)reason;
    return false;
#endif
}

static bool begin_playback_terminal_local_recovery(const char *reason) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!s_playback_terminal_guard.active) {
        return false;
    }

    const uint32_t connection_epoch =
        s_playback_terminal_guard.connection_epoch;
    const uint32_t speaker_generation =
        s_playback_terminal_guard.speaker_generation;
    const uint32_t now_ms = monotonic_ms();
    if (!nuwax_playback_terminal_guard_mark_fault(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            now_ms,
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
        return false;
    }

    (void)update_normal_downlink_admission(false);
    (void)send_playback_fault_cancel(
        reason ? reason : "playback_terminal_local_recovery");
    s_speaker_fault_recovery_epoch = connection_epoch;
    s_speaker_fault_recovery_generation = speaker_generation;
    if (s_turn_guard.active &&
        s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING) {
        (void)set_active_turn_phase(
            NUWAX_TURN_PHASE_DRAINING,
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
    }

    nuwax_speaker_cancel_request_result_t cancel = {0};
    const bool cancel_accepted =
        nuwax_speaker_playback_request_scoped_stop_generation_ex(
            connection_epoch,
            speaker_generation,
            false,
            reason ? reason : "playback_terminal_local_recovery",
            0U,
            &cancel);
    const bool completed =
        cancel_accepted &&
        cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
        cancel.connection_epoch == connection_epoch &&
        cancel.completed_stop_result == ESP_OK;
    if (completed) {
        (void)nuwax_playback_terminal_guard_mark_physical_done(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            false,
            monotonic_ms(),
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
        (void)nuwax_playback_terminal_guard_commit_local_recovery(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation);
        s_speaker_fault_recovery_epoch = 0U;
        s_speaker_fault_recovery_generation = 0U;
        ESP_LOGW(TAG,
                 "orphan playback terminal recovered from completed speaker stop epoch=%lu generation=%lu reason=%s; WebSocket retained",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 reason ? reason : "-");
        (void)finalize_playback_terminal_if_ready(
            "orphan_playback_completed_stop");
        return true;
    }
    if (cancel_accepted &&
        cancel.status != NUWAX_SPEAKER_CANCEL_REQUEST_FAILED) {
        ESP_LOGW(TAG,
                 "orphan playback terminal local stop pending epoch=%lu generation=%lu status=%d reason=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 (int)cancel.status,
                 reason ? reason : "-");
        return true;
    }

    const esp_err_t reset_err = nuwax_speaker_playback_reset_runtime();
    if (reset_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "orphan playback terminal speaker reset failed epoch=%lu generation=%lu err=%s reason=%s; recovery remains armed and WebSocket retained",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 esp_err_to_name(reset_err),
                 reason ? reason : "-");
        return true;
    }

    (void)nuwax_playback_terminal_guard_mark_physical_done(
        &s_playback_terminal_guard,
        connection_epoch,
        speaker_generation,
        false,
        monotonic_ms(),
        NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
    (void)nuwax_playback_terminal_guard_commit_local_recovery(
        &s_playback_terminal_guard,
        connection_epoch,
        speaker_generation);
    s_speaker_fault_recovery_epoch = 0U;
    s_speaker_fault_recovery_generation = 0U;
    ESP_LOGW(TAG,
             "orphan playback terminal recovered by bounded speaker reset epoch=%lu generation=%lu reason=%s; WebSocket retained",
             (unsigned long)connection_epoch,
             (unsigned long)speaker_generation,
             reason ? reason : "-");
    (void)finalize_playback_terminal_if_ready(
        "orphan_playback_runtime_reset");
    return true;
#else
    (void)reason;
    return false;
#endif
}

static bool playback_reason_is_completed(const char *reason) {
    return reason &&
           (strcmp(reason, "completed") == 0 || strcmp(reason, "complete") == 0);
}

static bool playback_reason_allows_metadata_retry(const char *reason) {
    return reason &&
           (strcmp(reason, "error") == 0 || strcmp(reason, "failed") == 0);
}

static bool arm_metadata_playback_retry(
    const nuwax_session_command_t *command,
    const char *source) {
    if (!command || !s_turn_guard.active ||
        !nuwax_awake_session_state_generation_matches(
            &s_awake_session, s_turn_guard.awake_generation) ||
        s_turn_guard.speaker_generation != 0U ||
        s_playback_terminal_guard.active || command->turn_id[0] == '\0' ||
        command->playback_id[0] == '\0' ||
        strcmp(command->turn_id, s_turn_guard.turn_id) != 0 ||
        strcmp(command->playback_id, s_turn_guard.playback_id) != 0) {
        return false;
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    const uint_fast32_t pending_start_generation = atomic_load_explicit(
        &s_pending_speaker_start_generation, memory_order_acquire);
    if (speaker_stats.playback_active || speaker_stats.start_gate_pending ||
        speaker_stats.start_gate_authorized || speaker_stats.rx_stream_active ||
        speaker_stats.queue_waiting > 0U || speaker_stats.stop_in_progress ||
        pending_start_generation != 0U || s_deferred_speaker_start_valid) {
        ESP_LOGW(TAG,
                 "metadata-only TTS retry denied because PCM/START already owns the speaker path turn=%s playback=%s start=%lu stream=%d queue=%lu stop=%d source=%s",
                 command->turn_id,
                 command->playback_id,
                 (unsigned long)pending_start_generation,
                 speaker_stats.rx_stream_active ? 1 : 0,
                 (unsigned long)speaker_stats.queue_waiting,
                 speaker_stats.stop_in_progress ? 1 : 0,
                 source ? source : "-");
        return false;
    }
#endif

    const uint8_t retry_before = s_turn_guard.metadata_retry_count;
    if (!nuwax_turn_guard_retire_metadata_playback(
            &s_turn_guard,
            monotonic_ms(),
            NUWAX_TTS_METADATA_RETRY_GRACE_MS,
            NUWAX_TTS_METADATA_MAX_RETRIES)) {
        ESP_LOGW(TAG,
                 "metadata-only TTS retry rejected turn=%s playback=%s retries=%u/%u source=%s",
                 command->turn_id,
                 command->playback_id,
                 (unsigned)retry_before,
                 (unsigned)NUWAX_TTS_METADATA_MAX_RETRIES,
                 source ? source : "-");
        return false;
    }

    pause_awake_waiting("tts_metadata_retry");
    set_conversation_status_guarded("NUWAX",
                                    "THINKING",
                                    "thinking",
                                    true);
    ESP_LOGW(TAG,
             "metadata-only TTS playback retired; waiting for bounded same-turn retry turn=%s playback=%s retry=%u/%u grace_ms=%u source=%s",
             command->turn_id,
             command->playback_id,
             (unsigned)s_turn_guard.metadata_retry_count,
             (unsigned)NUWAX_TTS_METADATA_MAX_RETRIES,
             (unsigned)NUWAX_TTS_METADATA_RETRY_GRACE_MS,
             source ? source : "-");
    return true;
}

static bool join_cloud_playback_logical_end(
    const nuwax_session_command_t *command,
    const char *source) {
    if (!command) {
        return false;
    }
    if (!nuwax_playback_terminal_guard_mark_logical_end(
            &s_playback_terminal_guard,
            active_ws_epoch_snapshot(),
            command->turn_id,
            command->playback_id,
            playback_reason_is_completed(command->playback_reason))) {
        /* A cloud END can legitimately arrive for a playback_begin that
         * never produced a binary START. There is no physical terminal
         * barrier to join in that metadata-only case; consume the END and
         * return directly to the awake-session listener. */
        if (!s_playback_terminal_guard.active &&
            s_turn_guard.active &&
            s_turn_guard.speaker_generation == 0U) {
            nuwax_speaker_playback_note_playback_end(
                command->turn_id,
                command->playback_id,
                command->playback_reason);
            if (playback_reason_allows_metadata_retry(
                    command->playback_reason) &&
                arm_metadata_playback_retry(command,
                                             "cloud_playback_end_error")) {
                return true;
            }
            clear_active_turn_guard(
                source ? source : "metadata_only_playback_end");
            set_conversation_status_guarded("VOICE",
                                            "LISTENING",
                                            "listening",
                                            true);
            if (!schedule_auto_followup_after_playback()) {
                set_state(NUWAX_APP_STATE_IDLE);
            }
            ESP_LOGI(TAG,
                     "metadata-only playback END accepted turn=%s playback=%s source=%s; listening resumed",
                     command->turn_id,
                     command->playback_id,
                     source ? source : "-");
            return true;
        }
        ESP_LOGW(TAG,
                 "%s did not match terminal barrier turn=%s playback=%s guard_turn=%s guard_playback=%s",
                 source ? source : "playback_end",
                 command && command->turn_id[0] ? command->turn_id : "-",
                 command && command->playback_id[0]
                     ? command->playback_id
                     : "-",
                 s_playback_terminal_guard.turn_id[0]
                     ? s_playback_terminal_guard.turn_id
                     : "-",
                 s_playback_terminal_guard.playback_id[0]
                     ? s_playback_terminal_guard.playback_id
                     : "-");
        return false;
    }

    nuwax_speaker_playback_note_playback_end(command->turn_id,
                                             command->playback_id,
                                             command->playback_reason);
    if (s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING) {
        (void)set_active_turn_phase(
            NUWAX_TURN_PHASE_DRAINING,
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
    }
    (void)finalize_playback_terminal_if_ready(source);
    return true;
}

static bool release_playback_terminal_after_committed_barge(
    uint32_t connection_epoch,
    uint32_t speaker_generation,
    const char *turn_id,
    const char *playback_id,
    const char *reason) {
    if (s_playback_terminal_guard.active &&
        !nuwax_playback_terminal_guard_release_committed_interrupt(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            turn_id,
            playback_id)) {
        ESP_LOGE(TAG,
                 "committed barge could not release playback terminal barrier epoch=%lu generation=%lu turn=%s playback=%s guard_epoch=%lu guard_generation=%lu guard_turn=%s guard_playback=%s; reconnecting",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 turn_id && turn_id[0] ? turn_id : "-",
                 playback_id && playback_id[0] ? playback_id : "-",
                 (unsigned long)s_playback_terminal_guard.connection_epoch,
                 (unsigned long)s_playback_terminal_guard.speaker_generation,
                 s_playback_terminal_guard.turn_id[0]
                     ? s_playback_terminal_guard.turn_id
                     : "-",
                 s_playback_terminal_guard.playback_id[0]
                     ? s_playback_terminal_guard.playback_id
                     : "-");
        nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
        if (active_ws) {
            (void)nuwax_ws_request_close_if_epoch(active_ws, connection_epoch);
        }
        return false;
    }

    if (s_speaker_fault_recovery_epoch == connection_epoch &&
        s_speaker_fault_recovery_generation == speaker_generation) {
        s_speaker_fault_recovery_epoch = 0U;
        s_speaker_fault_recovery_generation = 0U;
    }
    if (nuwax_turn_guard_speaker_generation_matches(&s_turn_guard,
                                                     speaker_generation)) {
        clear_active_turn_guard(reason ? reason : "barge_listen_committed");
    }
    ESP_LOGI(TAG,
             "committed barge released old playback ownership epoch=%lu generation=%lu turn=%s playback=%s reason=%s",
             (unsigned long)connection_epoch,
             (unsigned long)speaker_generation,
             turn_id && turn_id[0] ? turn_id : "-",
             playback_id && playback_id[0] ? playback_id : "-",
             reason ? reason : "-");
    return true;
}

static void quarantine_playback_terminal_after_failed_barge(
    uint32_t connection_epoch,
    uint32_t speaker_generation,
    bool physical_stop_observed,
    const char *reason) {
    if (!s_playback_terminal_guard.active) {
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    if (!nuwax_playback_terminal_guard_mark_fault(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            now_ms,
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
        ESP_LOGW(TAG,
                 "failed barge could not bind old playback terminal guard epoch=%lu generation=%lu guard_epoch=%lu guard_generation=%lu reason=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 (unsigned long)s_playback_terminal_guard.connection_epoch,
                 (unsigned long)s_playback_terminal_guard.speaker_generation,
                 reason ? reason : "-");
        return;
    }
    if (physical_stop_observed &&
        !s_playback_terminal_guard.physical_done) {
        (void)nuwax_playback_terminal_guard_mark_physical_done(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation,
            false,
            now_ms,
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
    }
    if (!s_playback_terminal_guard.physical_done) {
        ESP_LOGW(TAG,
                 "failed barge retained old playback guard until physical stop epoch=%lu generation=%lu reason=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 reason ? reason : "-");
        return;
    }
    if (!nuwax_playback_terminal_guard_commit_local_recovery(
            &s_playback_terminal_guard,
            connection_epoch,
            speaker_generation)) {
        ESP_LOGW(TAG,
                 "failed barge old playback local quarantine rejected epoch=%lu generation=%lu reason=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)speaker_generation,
                 reason ? reason : "-");
        return;
    }
    ESP_LOGW(TAG,
             "failed barge quarantined old playback locally epoch=%lu generation=%lu reason=%s; WebSocket retained",
             (unsigned long)connection_epoch,
             (unsigned long)speaker_generation,
             reason ? reason : "-");
    (void)finalize_playback_terminal_if_ready(
        reason ? reason : "barge_transaction_failed");
}

static void defer_speaker_start_event(nuwax_speaker_owner_event_t event,
                                      const char *reason) {
    if (s_deferred_speaker_start_valid &&
        s_deferred_speaker_start_event.speaker_generation !=
            event.speaker_generation) {
        (void)nuwax_speaker_playback_reject_start_generation(
            s_deferred_speaker_start_event.speaker_generation,
            "superseded_deferred_start");
    }
    s_deferred_speaker_start_event = event;
    s_deferred_speaker_start_valid = true;
    s_deferred_speaker_start_epoch = s_turn_guard.epoch;
    ESP_LOGI(TAG,
             "speaker START deferred generation=%lu epoch=%lu reason=%s",
             (unsigned long)event.speaker_generation,
             (unsigned long)s_turn_guard.epoch,
             reason ? reason : "-");
}

static bool during_playback_capture_runtime_ready(void) {
#if CONFIG_NUWAX_BARGE_IN_ENABLE
    return s_during_playback_capture_runtime_ready &&
           s_prelisten.capture_active &&
           nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback");
#else
    /* Do not overlap TTS with a previous auto-followup capture when voice
     * barge-in is disabled. Touch cancel has its own product feature gate. */
    return !atomic_load_explicit(&s_conversation_capture_starting,
                                 memory_order_acquire) &&
           !atomic_load_explicit(&s_conversation_capture_runtime_active,
                                 memory_order_acquire);
#endif
}

static void service_speaker_fault_recovery_watchdog(void) {
    const uint32_t recovery_epoch = s_speaker_fault_recovery_epoch;
    const uint32_t recovery_generation =
        s_speaker_fault_recovery_generation;
    if (recovery_epoch == 0U || recovery_generation == 0U) {
        s_speaker_fault_watch_epoch = 0U;
        s_speaker_fault_watch_generation = 0U;
        s_speaker_fault_watch_started_ms = 0U;
        return;
    }
    const uint32_t now_ms = monotonic_ms();
    if (s_speaker_fault_watch_epoch != recovery_epoch ||
        s_speaker_fault_watch_generation != recovery_generation) {
        s_speaker_fault_watch_epoch = recovery_epoch;
        s_speaker_fault_watch_generation = recovery_generation;
        s_speaker_fault_watch_started_ms = now_ms;
    }

    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    const bool stop_completed =
        stats.completed_stop_connection_epoch == recovery_epoch &&
        stats.completed_stop_generation == recovery_generation &&
        stats.completed_stop_result == ESP_OK;
    if (stop_completed) {
        s_speaker_fault_recovery_epoch = 0U;
        s_speaker_fault_recovery_generation = 0U;
        const bool local_power_sleep_owner =
            local_power_transition_active();
        if (s_playback_terminal_guard.active &&
            s_playback_terminal_guard.connection_epoch == recovery_epoch &&
            s_playback_terminal_guard.speaker_generation ==
                recovery_generation) {
            (void)nuwax_playback_terminal_guard_mark_physical_done(
                &s_playback_terminal_guard,
                recovery_epoch,
                recovery_generation,
                stats.rx_end_accepted,
                now_ms,
                NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
            if (s_playback_terminal_guard.faulted) {
                (void)nuwax_playback_terminal_guard_commit_local_recovery(
                    &s_playback_terminal_guard,
                    recovery_epoch,
                    recovery_generation);
            }
            (void)finalize_playback_terminal_if_ready(
                "speaker_fault_watchdog_physical_stop");
        } else if (!local_power_sleep_owner &&
                   conversation_state_current() !=
                       NUWAX_APP_STATE_SLEEPING) {
            recover_normal_conversation_after_playback_abort(
                "speaker_fault_watchdog_recovered");
        }
        ESP_LOGW(TAG,
                 "speaker fault watchdog recovered lost owner event epoch=%lu generation=%lu",
                 (unsigned long)recovery_epoch,
                 (unsigned long)recovery_generation);
        return;
    }

    const bool stop_failed =
        stats.failed_stop_connection_epoch == recovery_epoch &&
        stats.failed_stop_generation == recovery_generation;
    const bool expired = elapsed_ms(
        now_ms,
        s_speaker_fault_watch_started_ms +
            NUWAX_SPEAKER_FAULT_RECOVERY_WATCHDOG_MS);
    if (!stop_failed && !expired) {
        return;
    }
    ESP_LOGE(TAG,
             "speaker fault recovery watchdog did not observe stop epoch=%lu generation=%lu stop_failed=%d elapsed_ms=%lu; attempting bounded local runtime reset with WebSocket retained",
             (unsigned long)recovery_epoch,
             (unsigned long)recovery_generation,
             stop_failed ? 1 : 0,
             (unsigned long)(now_ms - s_speaker_fault_watch_started_ms));
    const esp_err_t reset_err = nuwax_speaker_playback_reset_runtime();
    if (reset_err != ESP_OK) {
        s_speaker_fault_watch_started_ms = monotonic_ms();
        ESP_LOGE(TAG,
                 "speaker fault recovery runtime reset failed epoch=%lu generation=%lu err=%s; retry remains armed and WebSocket retained",
                 (unsigned long)recovery_epoch,
                 (unsigned long)recovery_generation,
                 esp_err_to_name(reset_err));
        return;
    }

    s_speaker_fault_recovery_epoch = 0U;
    s_speaker_fault_recovery_generation = 0U;
    const bool local_power_sleep_owner = local_power_transition_active();
    if (s_playback_terminal_guard.active &&
        s_playback_terminal_guard.connection_epoch == recovery_epoch &&
        s_playback_terminal_guard.speaker_generation == recovery_generation) {
        (void)nuwax_playback_terminal_guard_mark_physical_done(
            &s_playback_terminal_guard,
            recovery_epoch,
            recovery_generation,
            false,
            monotonic_ms(),
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
        (void)nuwax_playback_terminal_guard_commit_local_recovery(
            &s_playback_terminal_guard,
            recovery_epoch,
            recovery_generation);
        ESP_LOGW(TAG,
                 "speaker fault recovery converged by runtime reset epoch=%lu generation=%lu; old playback quarantined and WebSocket retained",
                 (unsigned long)recovery_epoch,
                 (unsigned long)recovery_generation);
        (void)finalize_playback_terminal_if_ready(
            "speaker_fault_watchdog_runtime_reset");
    } else if (!local_power_sleep_owner &&
               conversation_state_current() != NUWAX_APP_STATE_SLEEPING) {
        recover_normal_conversation_after_playback_abort(
            "speaker_fault_watchdog_runtime_reset");
    }
}

static void drain_speaker_owner_events(void) {
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    bool speaker_stats_valid = false;
    if (s_speaker_owner_events) {
        nuwax_speaker_playback_get_stats(&speaker_stats);
        speaker_stats_valid = true;
        const uint32_t reported_generation = (uint32_t)atomic_load_explicit(
            &s_reported_speaker_fault_generation,
            memory_order_acquire);
        if (speaker_stats.stop_fault_active &&
            speaker_stats.failed_stop_generation != 0U &&
            speaker_stats.failed_stop_generation != reported_generation) {
            atomic_store_explicit(&s_reported_speaker_fault_generation,
                                  speaker_stats.failed_stop_generation,
                                  memory_order_release);
            (void)enqueue_speaker_owner_event((nuwax_speaker_owner_event_t){
                .type = NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_FAULT,
                .ws_connection_epoch =
                    speaker_stats.failed_stop_connection_epoch,
                .speaker_generation = speaker_stats.failed_stop_generation,
                .fault_result = speaker_stats.failed_stop_result,
            });
        }
    }
    uint32_t overflow_epoch = 0U;
    uint32_t overflow_generation = 0U;
    portENTER_CRITICAL(&s_speaker_owner_overflow_lock);
    overflow_epoch = s_speaker_owner_event_overflow_epoch;
    overflow_generation = s_speaker_owner_event_overflow_generation;
    s_speaker_owner_event_overflow_epoch = 0U;
    s_speaker_owner_event_overflow_generation = 0U;
    portEXIT_CRITICAL(&s_speaker_owner_overflow_lock);
    if (overflow_epoch != 0U) {
        const uint32_t active_epoch = active_ws_epoch_snapshot();
        if (sleep_transaction_blocks_new_audio()) {
            ESP_LOGI(TAG,
                     "speaker owner overflow ignored during sleep isolation generation=%lu epoch=%lu",
                     (unsigned long)overflow_generation,
                     (unsigned long)overflow_epoch);
        } else if (overflow_epoch != active_epoch) {
            ESP_LOGI(TAG,
                     "stale speaker owner overflow ignored generation=%lu event_epoch=%lu active_epoch=%lu",
                     (unsigned long)overflow_generation,
                     (unsigned long)overflow_epoch,
                     (unsigned long)active_epoch);
        } else if (s_notification_transaction.active &&
                   s_notification_transaction.ws_epoch == overflow_epoch &&
                   (s_notification_transaction.speaker_generation == 0U ||
                    s_notification_transaction.speaker_generation ==
                        overflow_generation)) {
            ESP_LOGE(TAG,
                     "critical speaker owner event loss invalidated notification epoch=%lu generation=%lu",
                     (unsigned long)overflow_epoch,
                     (unsigned long)overflow_generation);
            uint32_t ignored_epoch = 0U;
            nuwax_ws_client_t *ws = active_ws_snapshot(&ignored_epoch);
            cancel_active_notification(ws,
                                       "notification owner event loss");
        } else {
            const uint32_t pending_start_generation =
                (uint32_t)atomic_load_explicit(
                    &s_pending_speaker_start_generation,
                    memory_order_acquire);
            const bool overflow_matches_current =
                nuwax_speaker_owner_loss_matches_turn(
                    overflow_generation,
                    s_turn_guard.active,
                    s_turn_guard.speaker_generation,
                    pending_start_generation);
            if (!overflow_matches_current) {
                ESP_LOGW(TAG,
                         "stale speaker owner overflow ignored generation=%lu guard_generation=%lu pending_generation=%lu; retaining newer turn",
                         (unsigned long)overflow_generation,
                         (unsigned long)s_turn_guard.speaker_generation,
                         (unsigned long)pending_start_generation);
            } else {
                ESP_LOGE(TAG,
                         "critical speaker owner event loss generation=%lu made the matching turn uncertain; aborting playback while retaining WebSocket epoch=%lu",
                         (unsigned long)overflow_generation,
                         (unsigned long)overflow_epoch);
                clear_active_turn_guard("speaker_owner_event_overflow");
                s_speaker_fault_recovery_epoch = overflow_epoch;
                s_speaker_fault_recovery_generation = overflow_generation;
                if (!nuwax_speaker_playback_request_cancel_generation(
                        overflow_generation,
                        "speaker_owner_event_overflow",
                        0U)) {
                    s_speaker_fault_recovery_epoch = 0U;
                    s_speaker_fault_recovery_generation = 0U;
                    recover_normal_conversation_after_playback_abort(
                        "speaker_owner_event_overflow_unarmed");
                }
            }
        }
    }
    bool ingress_pending = false;
    uint32_t ingress_epoch = 0U;
    uint32_t ingress_generation = 0U;
    portENTER_CRITICAL(&s_speaker_ingress_lock);
    ingress_pending = s_speaker_ingress_pending;
    ingress_epoch = s_speaker_ingress_epoch;
    ingress_generation = s_speaker_ingress_generation;
    s_speaker_ingress_pending = false;
    s_speaker_ingress_epoch = 0U;
    s_speaker_ingress_generation = 0U;
    portEXIT_CRITICAL(&s_speaker_ingress_lock);
    if (ingress_pending &&
        ingress_epoch == active_ws_epoch_snapshot() &&
        s_playback_terminal_guard.active &&
        ingress_epoch == s_playback_terminal_guard.connection_epoch &&
        ingress_generation ==
            s_playback_terminal_guard.speaker_generation) {
        (void)nuwax_playback_terminal_guard_refresh_progress(
            &s_playback_terminal_guard,
            ingress_epoch,
            ingress_generation,
            monotonic_ms(),
            NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS);
    }
    if (ingress_pending &&
        ingress_epoch == active_ws_epoch_snapshot() &&
        s_turn_guard.active &&
        s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING &&
        nuwax_turn_guard_speaker_generation_matches(
            &s_turn_guard, ingress_generation)) {
        (void)set_active_turn_phase(NUWAX_TURN_PHASE_PLAYING,
                                    NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS);
    }
    if (ingress_pending && s_deferred_sleep_intent.active &&
        ingress_epoch == s_deferred_sleep_intent.ws_epoch) {
        (void)nuwax_deferred_sleep_intent_extend(
            &s_deferred_sleep_intent,
            s_deferred_sleep_intent.token,
            monotonic_ms(),
            NUWAX_SLEEP_AFTER_PLAYBACK_STALL_TIMEOUT_MS);
    }
    if (ingress_pending && s_notification_transaction.active &&
        ingress_epoch == s_notification_transaction.ws_epoch &&
        (s_notification_transaction.speaker_generation == 0U ||
         ingress_generation ==
             s_notification_transaction.speaker_generation)) {
        (void)nuwax_notification_refresh_stream_deadline(
            &s_notification_transaction,
            s_notification_transaction.token,
            ingress_epoch,
            monotonic_ms(),
            NUWAX_NOTIFICATION_STREAM_IDLE_TIMEOUT_MS);
    }
    if (!s_speaker_owner_events) {
        return;
    }

    nuwax_speaker_owner_event_t event = {0};
    while (xQueueReceive(s_speaker_owner_events, &event, 0) == pdTRUE) {
        const int64_t owner_delay_us =
            esp_timer_get_time() - event.event_timestamp_us;
        if (event.event_timestamp_us > 0 && owner_delay_us > 250000LL) {
            ESP_LOGW(TAG,
                     "speaker owner event delayed type=%d epoch=%lu generation=%lu queue_ms=%lld",
                     (int)event.type,
                     (unsigned long)event.ws_connection_epoch,
                     (unsigned long)event.speaker_generation,
                     (long long)(owner_delay_us / 1000LL));
        }
        const uint32_t active_epoch = active_ws_epoch_snapshot();
        if (event.type != NUWAX_SPEAKER_OWNER_EVENT_VOLUME &&
            (event.ws_connection_epoch == 0U ||
             event.ws_connection_epoch != active_epoch)) {
            ESP_LOGI(TAG,
                     "stale speaker owner event ignored type=%d generation=%lu event_epoch=%lu active_epoch=%lu",
                     (int)event.type,
                     (unsigned long)event.speaker_generation,
                     (unsigned long)event.ws_connection_epoch,
                     (unsigned long)active_epoch);
            continue;
        }
        if (event.type != NUWAX_SPEAKER_OWNER_EVENT_VOLUME &&
            sleep_transaction_blocks_new_audio()) {
            if (event.type == NUWAX_SPEAKER_OWNER_EVENT_TTS_START &&
                event.speaker_generation != 0U) {
                clear_pending_speaker_start_if(event.speaker_generation);
                (void)nuwax_speaker_playback_reject_start_generation(
                    event.speaker_generation,
                    "sleep_transaction_isolation");
            }
            ESP_LOGI(TAG,
                     "speaker owner event isolated by sleep transaction type=%d epoch=%lu generation=%lu state=%s",
                     (int)event.type,
                     (unsigned long)event.ws_connection_epoch,
                     (unsigned long)event.speaker_generation,
                     nuwax_sleep_transaction_state_name(
                         s_sleep_transaction.state));
            service_sleep_transaction();
            continue;
        }
        switch (event.type) {
            case NUWAX_SPEAKER_OWNER_EVENT_TTS_START:
                /* The speaker task has already accepted the START packet,
                 * but it cannot write I2S until this owner validates the
                 * matching JSON metadata. Keep the event deferred whenever
                 * metadata has not reached the owner yet. */
                {
                nuwax_speaker_playback_stats_t start_stats = {0};
                nuwax_speaker_playback_get_stats(&start_stats);
                const uint_fast32_t pending_start_generation =
                    atomic_load_explicit(
                        &s_pending_speaker_start_generation,
                        memory_order_acquire);
                const bool speaker_start_is_current =
                    pending_start_generation == event.speaker_generation &&
                    start_stats.start_gate_generation ==
                        event.speaker_generation &&
                    (start_stats.start_gate_pending ||
                     start_stats.start_gate_authorized);
                if (s_notification_transaction.active &&
                    s_notification_transaction.ws_epoch ==
                        event.ws_connection_epoch &&
                    (s_notification_transaction.state ==
                         NUWAX_NOTIFICATION_STATE_STREAMING ||
                     s_notification_transaction.state ==
                         NUWAX_NOTIFICATION_STATE_DRAINING) &&
                    speaker_start_is_current) {
                    const uint32_t token =
                        s_notification_transaction.token;
                    if (!nuwax_notification_bind_speaker_generation(
                            &s_notification_transaction,
                            token,
                            event.ws_connection_epoch,
                            event.speaker_generation) ||
                        nuwax_speaker_playback_authorize_notification_generation(
                            event.speaker_generation,
                            s_notification_transaction.notify_id,
                            s_notification_transaction.playback_id) !=
                            ESP_OK) {
                        clear_pending_speaker_start_if(
                            event.speaker_generation);
                        (void)nuwax_speaker_playback_reject_start_generation(
                            event.speaker_generation,
                            "notification_start_authorization_failed");
                        uint32_t ignored_epoch = 0U;
                        nuwax_ws_client_t *ws =
                            active_ws_snapshot(&ignored_epoch);
                        cancel_active_notification(
                            ws,
                            "notification start authorization failed");
                        break;
                    }
                    clear_pending_speaker_start_if(
                        event.speaker_generation);
                    (void)nuwax_notification_refresh_stream_deadline(
                        &s_notification_transaction,
                        token,
                        event.ws_connection_epoch,
                        monotonic_ms(),
                        NUWAX_NOTIFICATION_STREAM_IDLE_TIMEOUT_MS);
                    request_notification_playback_wake_word_detector(
                        event.ws_connection_epoch,
                        event.speaker_generation,
                        s_notification_transaction.notify_id,
                        s_notification_transaction.playback_id,
                        "notification_start_authorized");
                    ESP_LOGI(TAG,
                             "notification speaker START authorized token=%lu epoch=%lu generation=%lu notify=%s playback=%s",
                             (unsigned long)token,
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             s_notification_transaction.notify_id,
                             s_notification_transaction.playback_id);
                    break;
                }
                if (event.speaker_generation == 0U ||
                    !speaker_start_is_current ||
                    !s_turn_guard.active ||
                    !nuwax_awake_session_state_generation_matches(
                        &s_awake_session,
                        s_turn_guard.awake_generation) ||
                    (s_turn_guard.phase != NUWAX_TURN_PHASE_WAIT_TEXT &&
                     s_turn_guard.phase != NUWAX_TURN_PHASE_WAIT_TTS &&
                     s_turn_guard.phase != NUWAX_TURN_PHASE_WAIT_TTS_RETRY &&
                     s_turn_guard.phase != NUWAX_TURN_PHASE_PLAYING)) {
                    ESP_LOGW(TAG,
                             "stale speaker START rejected generation=%lu pending_generation=%lu gate_generation=%lu guard_generation=%lu phase=%s",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)pending_start_generation,
                             (unsigned long)start_stats.start_gate_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                    clear_pending_speaker_start_if(event.speaker_generation);
                    (void)nuwax_speaker_playback_reject_start_generation(
                        event.speaker_generation,
                        "stale_turn_start");
                    break;
                }

                const bool metadata_ready =
                    s_turn_guard.turn_id[0] != '\0' &&
                    s_turn_guard.playback_id[0] != '\0';
                if (s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TEXT ||
                    !metadata_ready) {
                    defer_speaker_start_event(event, "cloud_turn_metadata");
                    break;
                }
                request_during_playback_capture("tts_start_gate", false);
                if (!during_playback_capture_runtime_ready()) {
                    defer_speaker_start_event(event,
                                              "capture_runtime_not_ready");
                    break;
                }
                if (!authorize_speaker_generation_for_active_turn(
                        event.speaker_generation,
                        "tts_start")) {
                    ESP_LOGW(TAG,
                             "speaker START authorization failed generation=%lu guard_generation=%lu phase=%s; reconnecting",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                    clear_pending_speaker_start_if(event.speaker_generation);
                    (void)nuwax_speaker_playback_reject_start_generation(
                        event.speaker_generation,
                        "start_authorization_failed");
                    clear_active_turn_guard("start_authorization_failed");
                    recover_normal_conversation_after_playback_abort(
                        "speaker_start_authorization_failed");
                    break;
                }
                clear_pending_speaker_start_if(event.speaker_generation);
                s_post_playback_resume_pending = false;
                (void)set_active_turn_phase(
                    NUWAX_TURN_PHASE_PLAYING,
                    NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS);
                pause_awake_waiting("tts_start");
                metrics_mark_tts_start(event.ws_connection_epoch,
                                       s_turn_guard.epoch,
                                       event.speaker_generation);
                wake_greeting_metrics_mark_tts_start();
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE && \
    !CONFIG_NUWAX_BARGE_IN_ENABLE
                request_playback_wake_word_detector(
                    event.ws_connection_epoch,
                    event.speaker_generation,
                    s_turn_guard.turn_id,
                    s_turn_guard.playback_id,
                    "tts_start_authorized");
#elif CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
                if (wake_detector_request_is_playback() ||
                    nuwax_wake_word_detector_is_running()) {
                    stop_sleep_wake_word_detector(
                        "tts_start_barge_in_capture_owner");
                }
                ESP_LOGI(TAG,
                         "playback wake detector suppressed epoch=%lu generation=%lu reason=tts_start_barge_in_capture_owner",
                         (unsigned long)event.ws_connection_epoch,
                         (unsigned long)event.speaker_generation);
#else
                if (wake_detector_request_is_playback() ||
                    nuwax_wake_word_detector_is_running()) {
                    stop_sleep_wake_word_detector(
                        "tts_start_playback_wake_disabled");
                }
                ESP_LOGI(TAG,
                         "playback wake detector suppressed epoch=%lu generation=%lu reason=tts_start_playback_wake_disabled",
                         (unsigned long)event.ws_connection_epoch,
                         (unsigned long)event.speaker_generation);
#endif
                break;
                }
            case NUWAX_SPEAKER_OWNER_EVENT_FIRST_PCM_WRITTEN:
                if (s_notification_transaction.active &&
                    s_notification_transaction.ws_epoch ==
                        event.ws_connection_epoch &&
                    s_notification_transaction.speaker_generation ==
                        event.speaker_generation) {
                    set_state_deferred_ui(NUWAX_APP_STATE_SPEAKING);
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
                    (void)arm_playback_wake_word_detector(
                        event.ws_connection_epoch,
                        event.speaker_generation,
                        event.event_timestamp_us);
#endif
                } else if (s_turn_guard.active &&
                    s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING &&
                    nuwax_turn_guard_speaker_generation_matches(
                        &s_turn_guard, event.speaker_generation)) {
                    const uint32_t awake_generation =
                        nuwax_awake_session_state_generation(&s_awake_session);
                    const bool visual_bound =
                        nuwax_conversation_visual_round_note_first_pcm(
                            &s_visual_round,
                            event.ws_connection_epoch,
                            awake_generation,
                            event.speaker_generation);
                    const nuwax_visual_round_kind_t kind =
                        visual_bound ? s_visual_round.kind
                                     : NUWAX_VISUAL_ROUND_NONE;
                    if (kind == NUWAX_VISUAL_ROUND_NORMAL) {
                        char emotion[NUWAX_VISUAL_ROUND_EMOTION_CAPACITY] = {0};
                        if (nuwax_conversation_visual_round_take_emotion(
                                &s_visual_round,
                                emotion,
                                sizeof(emotion))) {
                            (void)apply_semantic_emotion_name(
                                emotion, "text_response_pcm");
                            sync_pending_semantic_emotion();
                        }
                        set_state_deferred_ui(NUWAX_APP_STATE_SPEAKING);
                    } else if (kind == NUWAX_VISUAL_ROUND_WAKE_GREETING) {
                        set_conversation_status_guarded(
                            "VOICE", "LISTENING", "listening", true);
                        set_state_deferred_ui(NUWAX_APP_STATE_LISTENING);
                    } else {
                        /* Special interactions remain visually pinned while
                         * their reply plays. Unknown legacy owners keep the
                         * established first-PCM SPEAKING behavior. */
                        set_state_deferred_ui(NUWAX_APP_STATE_SPEAKING);
                    }
                    ESP_LOGI(TAG,
                             "first PCM visual owner kind=%s bound=%d epoch=%lu generation=%lu",
                             visual_round_kind_name(kind),
                             visual_bound ? 1 : 0,
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                } else {
                    ESP_LOGI(TAG,
                             "stale first PCM speaking transition ignored generation=%lu guard_generation=%lu phase=%s",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                }
                if ((s_notification_transaction.active &&
                     s_notification_transaction.ws_epoch ==
                         event.ws_connection_epoch &&
                     s_notification_transaction.speaker_generation ==
                         event.speaker_generation) ||
                    (s_turn_guard.active &&
                     s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING &&
                     nuwax_turn_guard_speaker_generation_matches(
                         &s_turn_guard, event.speaker_generation))) {
                    nuwax_state_bridge_note_playback_pcm_started(
                        event.ws_connection_epoch,
                        event.speaker_generation);
                }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE && \
    !CONFIG_NUWAX_BARGE_IN_ENABLE
                if (!arm_playback_wake_word_detector(
                        event.ws_connection_epoch,
                        event.speaker_generation,
                        event.event_timestamp_us)) {
                    ESP_LOGI(TAG,
                             "stale first PCM wake arm ignored epoch=%lu generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                }
#endif
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_PROGRESS:
                /* Speaker output progress only consumes buffered audio and
                 * must not extend the cloud-ingress idle deadline. */
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_DONE:
                nuwax_state_bridge_note_playback_stopped(
                    event.ws_connection_epoch,
                    event.speaker_generation);
                if (s_notification_transaction.active &&
                    s_notification_transaction.ws_epoch ==
                        event.ws_connection_epoch &&
                    s_notification_transaction.speaker_generation ==
                        event.speaker_generation) {
                    (void)nuwax_notification_mark_physical_done(
                        &s_notification_transaction,
                        s_notification_transaction.token,
                        event.ws_connection_epoch,
                        event.speaker_generation);
                    service_notification_transaction();
                    break;
                }
                if (nuwax_touch_cancel_recovery_mark_physical_stop(
                        &s_touch_cancel_recovery,
                        event.ws_connection_epoch,
                        event.speaker_generation)) {
                    ESP_LOGI(TAG,
                             "touch cancel joined natural playback completion epoch=%lu generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                    break;
                }
                const bool terminal_matches =
                    s_playback_terminal_guard.active &&
                    s_playback_terminal_guard.connection_epoch ==
                        event.ws_connection_epoch &&
                    s_playback_terminal_guard.speaker_generation ==
                        event.speaker_generation;
                const bool turn_matches =
                    nuwax_turn_guard_speaker_generation_matches(
                        &s_turn_guard, event.speaker_generation) &&
                    (s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING ||
                     s_turn_guard.phase == NUWAX_TURN_PHASE_DRAINING);
                if (!terminal_matches) {
                    ESP_LOGI(TAG,
                             "stale speaker completion ignored generation=%lu guard_generation=%lu terminal_generation=%lu phase=%s",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             (unsigned long)s_playback_terminal_guard
                                 .speaker_generation,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                    break;
                }
                if (!nuwax_playback_terminal_guard_mark_physical_done(
                        &s_playback_terminal_guard,
                        event.ws_connection_epoch,
                        event.speaker_generation,
                        true,
                        monotonic_ms(),
                        NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
                    ESP_LOGE(TAG,
                             "speaker completion missing terminal ownership epoch=%lu generation=%lu; reconnecting",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                    nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
                    if (active_ws) {
                        (void)nuwax_ws_request_close_if_epoch(
                            active_ws, event.ws_connection_epoch);
                    }
                    break;
                }
                if (turn_matches) {
                    metrics_mark_playback_done(event.ws_connection_epoch,
                                               s_turn_guard.epoch,
                                               event.speaker_generation,
                                               event.played_frames,
                                               event.write_failures);
                    wake_greeting_metrics_mark_playback_done(
                        event.played_frames,
                        event.write_failures);
                } else {
                    ESP_LOGW(TAG,
                             "late speaker completion joined terminal barrier after turn owner changed epoch=%lu generation=%lu guard_generation=%lu phase=%s",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                }
                if (turn_matches &&
                    s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING) {
                    (void)set_active_turn_phase(
                        NUWAX_TURN_PHASE_DRAINING,
                        NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
                }
                (void)finalize_playback_terminal_if_ready(
                    "speaker_playback_done");
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_STREAM_END:
                if (s_notification_transaction.active &&
                    s_notification_transaction.ws_epoch ==
                        event.ws_connection_epoch &&
                    s_notification_transaction.speaker_generation ==
                        event.speaker_generation) {
                    (void)nuwax_notification_mark_binary_end(
                        &s_notification_transaction,
                        s_notification_transaction.token,
                        event.ws_connection_epoch,
                        event.speaker_generation);
                    service_notification_transaction();
                    break;
                }
                if (!nuwax_playback_terminal_guard_mark_stream_end(
                        &s_playback_terminal_guard,
                        event.ws_connection_epoch,
                        event.speaker_generation)) {
                    ESP_LOGI(TAG,
                             "stale speaker stream END ignored epoch=%lu generation=%lu guard_epoch=%lu guard_generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_playback_terminal_guard
                                 .connection_epoch,
                             (unsigned long)s_playback_terminal_guard
                                 .speaker_generation);
                    break;
                }
                ESP_LOGI(TAG,
                         "speaker binary stream END joined terminal barrier epoch=%lu generation=%lu",
                         (unsigned long)event.ws_connection_epoch,
                         (unsigned long)event.speaker_generation);
                (void)finalize_playback_terminal_if_ready(
                    "speaker_binary_stream_end");
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_STATE:
                if (event.state == NUWAX_APP_STATE_SPEAKING &&
                    s_notification_transaction.active &&
                    s_notification_transaction.ws_epoch ==
                        event.ws_connection_epoch &&
                    s_notification_transaction.speaker_generation ==
                        event.speaker_generation) {
                    set_state_deferred_ui(event.state);
                } else if (event.state == NUWAX_APP_STATE_SPEAKING &&
                    s_visual_round.kind ==
                        NUWAX_VISUAL_ROUND_WAKE_GREETING &&
                    nuwax_conversation_visual_round_speaker_matches(
                        &s_visual_round,
                        event.ws_connection_epoch,
                        event.speaker_generation)) {
                    ESP_LOGI(TAG,
                             "wake greeting speaker state suppressed; LISTENING remains owner epoch=%lu generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                } else if (event.state == NUWAX_APP_STATE_SPEAKING &&
                    nuwax_turn_guard_speaker_generation_matches(
                        &s_turn_guard,
                        event.speaker_generation)) {
                    set_state_deferred_ui(event.state);
                } else {
                    ESP_LOGI(TAG,
                             "stale speaker state event ignored state=%d generation=%lu guard_generation=%lu",
                             (int)event.state,
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation);
                }
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_CANCEL_RECOVERY:
                if (s_notification_transaction.active &&
                    event.ws_connection_epoch ==
                        s_notification_transaction.ws_epoch &&
                    event.speaker_generation ==
                        s_notification_transaction.speaker_generation) {
                    (void)nuwax_notification_mark_physical_done(
                        &s_notification_transaction,
                        s_notification_transaction.token,
                        event.ws_connection_epoch,
                        event.speaker_generation);
                    service_notification_transaction();
                    break;
                }
                if (nuwax_touch_cancel_recovery_mark_physical_stop(
                        &s_touch_cancel_recovery,
                        event.ws_connection_epoch,
                        event.speaker_generation)) {
                    ESP_LOGI(TAG,
                             "touch cancel physical stop confirmed epoch=%lu generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                    break;
                }
                if (s_wake_interrupt_cancel.active &&
                    event.ws_connection_epoch ==
                        s_wake_interrupt_cancel.ws_epoch &&
                    event.speaker_generation ==
                        s_wake_interrupt_cancel.speaker_generation) {
                    s_wake_interrupt_cancel.physical_stop_done = true;
                    ESP_LOGI(TAG,
                             "wake interrupt physical stop confirmed epoch=%lu generation=%lu",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                    break;
                }
                if (s_playback_terminal_guard.active &&
                    event.ws_connection_epoch ==
                        s_playback_terminal_guard.connection_epoch &&
                    event.speaker_generation ==
                        s_playback_terminal_guard.speaker_generation) {
                    if (!nuwax_playback_terminal_guard_mark_physical_done(
                            &s_playback_terminal_guard,
                            event.ws_connection_epoch,
                            event.speaker_generation,
                            false,
                            monotonic_ms(),
                            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
                        ESP_LOGE(TAG,
                                 "speaker fault stop missing terminal ownership epoch=%lu generation=%lu; reconnecting",
                                 (unsigned long)event.ws_connection_epoch,
                                 (unsigned long)event.speaker_generation);
                        nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
                        if (active_ws) {
                            (void)nuwax_ws_request_close_if_epoch(
                                active_ws, event.ws_connection_epoch);
                        }
                        break;
                    }
                    ESP_LOGI(TAG,
                             "speaker physical stop joined terminal barrier epoch=%lu generation=%lu faulted=%d; normal listen remains held until playback terminal or committed interrupt",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             s_playback_terminal_guard.faulted ? 1 : 0);
                    (void)finalize_playback_terminal_if_ready(
                        s_playback_terminal_guard.faulted
                            ? "speaker_playback_fault_stop"
                            : "speaker_cancel_physical_stop");
                    break;
                }
                if (!s_turn_guard.active ||
                    !nuwax_awake_session_state_generation_matches(
                        &s_awake_session,
                        s_turn_guard.awake_generation) ||
                    !nuwax_turn_guard_speaker_generation_matches(
                        &s_turn_guard,
                        event.speaker_generation) ||
                    (s_turn_guard.phase != NUWAX_TURN_PHASE_PLAYING &&
                     s_turn_guard.phase != NUWAX_TURN_PHASE_DRAINING)) {
                    ESP_LOGI(TAG,
                             "stale speaker cancel recovery ignored generation=%lu guard_generation=%lu guard_active=%d phase=%s",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             s_turn_guard.active ? 1 : 0,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                    break;
                }
                clear_active_turn_guard("speaker_cancel_recovery_without_terminal");
                const bool local_power_sleep_owner =
                    local_power_transition_active();
                if (!local_power_sleep_owner &&
                    conversation_state_current() != NUWAX_APP_STATE_SLEEPING) {
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
                    if (nuwax_capture_phase_cancel_recovery_needs_resume(
                            s_prelisten.capture_active,
                            nuwax_prelisten_state_mode_is(
                                &s_prelisten,
                                "during_playback"),
                            nuwax_prelisten_state_mode_is(&s_prelisten,
                                                          "barge_in"))) {
                        s_post_playback_resume_pending = true;
                        reset_awake_wait_budget_paused(
                            "speaker_cancel_recovery");
                        set_state(NUWAX_APP_STATE_LISTENING);
                        ESP_LOGI(TAG,
                                 "speaker cancel recovery kept active %s capture and requested post-playback resume",
                                 nuwax_prelisten_state_mode_or(
                                     &s_prelisten,
                                     "during_playback"));
                    } else
#endif
                    {
                        return_to_listening_after_cancel("cancel_followup");
                    }
                }
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_START_GATE_TIMEOUT:
                {
                if (s_notification_transaction.active &&
                    event.ws_connection_epoch ==
                        s_notification_transaction.ws_epoch &&
                    (s_notification_transaction.speaker_generation == 0U ||
                     event.speaker_generation ==
                         s_notification_transaction.speaker_generation)) {
                    clear_pending_speaker_start_if(
                        event.speaker_generation);
                    (void)nuwax_speaker_playback_reject_start_generation(
                        event.speaker_generation,
                        "notification_start_gate_timeout");
                    uint32_t ignored_epoch = 0U;
                    nuwax_ws_client_t *ws =
                        active_ws_snapshot(&ignored_epoch);
                    cancel_active_notification(
                        ws, "notification start gate timeout");
                    break;
                }
                const uint_fast32_t pending_start_generation =
                    atomic_load_explicit(&s_pending_speaker_start_generation,
                                         memory_order_acquire);
                const bool timeout_generation_current =
                    event.speaker_generation != 0U &&
                    pending_start_generation == event.speaker_generation &&
                    s_turn_guard.active &&
                    nuwax_awake_session_state_generation_matches(
                        &s_awake_session,
                        s_turn_guard.awake_generation) &&
                    (s_turn_guard.speaker_generation == 0U ||
                     s_turn_guard.speaker_generation == event.speaker_generation) &&
                    (s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TEXT ||
                     s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TTS ||
                     s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TTS_RETRY);
                if (!timeout_generation_current) {
                    ESP_LOGI(TAG,
                             "stale speaker START gate timeout ignored generation=%lu pending_generation=%lu guard_generation=%lu guard_active=%d phase=%s",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)pending_start_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             s_turn_guard.active ? 1 : 0,
                             nuwax_turn_phase_name(s_turn_guard.phase));
                    clear_pending_speaker_start_if(event.speaker_generation);
                    break;
                }
                clear_pending_speaker_start_if(event.speaker_generation);
                ESP_LOGE(TAG,
                         "speaker START gate timeout generation=%lu; aborting current turn while retaining WebSocket",
                         (unsigned long)event.speaker_generation);
                (void)nuwax_speaker_playback_reject_start_generation(
                    event.speaker_generation,
                    "start_gate_timeout");
                clear_active_turn_guard("start_gate_timeout");
                recover_normal_conversation_after_playback_abort(
                    "speaker_start_gate_timeout");
                break;
                }
            case NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_FAULT:
                if (s_notification_transaction.active &&
                    event.ws_connection_epoch ==
                        s_notification_transaction.ws_epoch &&
                    event.speaker_generation ==
                        s_notification_transaction.speaker_generation) {
                    ESP_LOGE(TAG,
                             "notification playback fault epoch=%lu generation=%lu result=%s",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             esp_err_to_name(event.fault_result));
                    uint32_t ignored_epoch = 0U;
                    nuwax_ws_client_t *ws =
                        active_ws_snapshot(&ignored_epoch);
                    cancel_active_notification(
                        ws, "notification playback fault");
                    break;
                }
                const bool fault_terminal_matches =
                    s_playback_terminal_guard.active &&
                    s_playback_terminal_guard.connection_epoch ==
                        event.ws_connection_epoch &&
                    s_playback_terminal_guard.speaker_generation ==
                        event.speaker_generation;
                const bool fault_turn_matches =
                    s_turn_guard.active &&
                    nuwax_awake_session_state_generation_matches(
                        &s_awake_session,
                        s_turn_guard.awake_generation) &&
                    nuwax_turn_guard_speaker_generation_matches(
                        &s_turn_guard, event.speaker_generation) &&
                    (s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING ||
                     s_turn_guard.phase == NUWAX_TURN_PHASE_DRAINING);
                if (!fault_terminal_matches) {
                    ESP_LOGE(TAG,
                             "stale speaker playback fault generation=%lu guard_generation=%lu terminal_generation=%lu guard_active=%d phase=%s result=%s; retaining WebSocket and newer turn",
                             (unsigned long)event.speaker_generation,
                             (unsigned long)s_turn_guard.speaker_generation,
                             (unsigned long)s_playback_terminal_guard
                                 .speaker_generation,
                             s_turn_guard.active ? 1 : 0,
                             nuwax_turn_phase_name(s_turn_guard.phase),
                             esp_err_to_name(event.fault_result));
                    break;
                }
                if (!fault_turn_matches) {
                    ESP_LOGW(TAG,
                             "late speaker playback fault joined terminal barrier after turn owner changed epoch=%lu generation=%lu result=%s",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation,
                             esp_err_to_name(event.fault_result));
                }
                ESP_LOGE(TAG,
                         "speaker playback fault generation=%lu result=%s; holding normal listen until old playback terminates",
                         (unsigned long)event.speaker_generation,
                         esp_err_to_name(event.fault_result));
                if (!nuwax_playback_terminal_guard_mark_fault(
                        &s_playback_terminal_guard,
                        event.ws_connection_epoch,
                        event.speaker_generation,
                        monotonic_ms(),
                        NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
                    ESP_LOGE(TAG,
                             "speaker playback fault could not bind terminal barrier epoch=%lu generation=%lu; reconnecting",
                             (unsigned long)event.ws_connection_epoch,
                             (unsigned long)event.speaker_generation);
                    nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
                    if (active_ws) {
                        (void)nuwax_ws_request_close_if_epoch(
                            active_ws, event.ws_connection_epoch);
                    }
                    break;
                }
                /* Fence late PCM before asking the cloud to terminate this
                 * exact turn. A matching ACK can now converge the barrier on
                 * this WebSocket; missing ACK/END still falls back to a
                 * bounded reconnect. */
                (void)update_normal_downlink_admission(false);
                if (!send_playback_fault_cancel("speaker_playback_fault")) {
                    break;
                }
                s_speaker_fault_recovery_epoch =
                    event.ws_connection_epoch;
                s_speaker_fault_recovery_generation =
                    event.speaker_generation;
                if (fault_turn_matches &&
                    s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING) {
                    (void)set_active_turn_phase(
                        NUWAX_TURN_PHASE_DRAINING,
                        NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
                }
                request_during_playback_capture(
                    "speaker_playback_fault_terminal_wait", true);
                break;
            case NUWAX_SPEAKER_OWNER_EVENT_VOLUME:
                nuwax_app_shell_set_volume_percent(event.volume_percent);
                break;
            default:
                break;
        }
    }

    if (s_deferred_speaker_start_valid &&
        sleep_transaction_blocks_new_audio()) {
        const uint32_t generation =
            s_deferred_speaker_start_event.speaker_generation;
        s_deferred_speaker_start_valid = false;
        memset(&s_deferred_speaker_start_event, 0,
               sizeof(s_deferred_speaker_start_event));
        s_deferred_speaker_start_epoch = 0U;
        clear_pending_speaker_start_if(generation);
        if (generation != 0U) {
            (void)nuwax_speaker_playback_reject_start_generation(
                generation, "sleep_transaction_deferred_start");
        }
    } else if (s_deferred_speaker_start_valid) {
        const nuwax_speaker_owner_event_t deferred =
            s_deferred_speaker_start_event;
        if (!s_turn_guard.active ||
            s_turn_guard.epoch != s_deferred_speaker_start_epoch ||
            !nuwax_awake_session_state_generation_matches(
                &s_awake_session,
                s_turn_guard.awake_generation)) {
            s_deferred_speaker_start_valid = false;
            memset(&s_deferred_speaker_start_event, 0,
                 sizeof(s_deferred_speaker_start_event));
            s_deferred_speaker_start_epoch = 0U;
            clear_pending_speaker_start_if(deferred.speaker_generation);
            if (deferred.speaker_generation != 0U) {
                if (!nuwax_speaker_playback_reject_start_generation(
                        deferred.speaker_generation,
                        "stale_deferred_start")) {
                    (void)nuwax_speaker_playback_request_cancel_generation(
                        deferred.speaker_generation,
                        "stale_deferred_start",
                        0U);
                }
            }
        } else {
            request_during_playback_capture("deferred_tts_start_gate", false);
            if (during_playback_capture_runtime_ready() &&
                s_turn_guard.phase != NUWAX_TURN_PHASE_WAIT_TEXT &&
                   s_turn_guard.turn_id[0] != '\0' &&
                   s_turn_guard.playback_id[0] != '\0' &&
                   authorize_speaker_generation_for_active_turn(
                        deferred.speaker_generation,
                        "deferred_tts_start")) {
                s_deferred_speaker_start_valid = false;
                memset(&s_deferred_speaker_start_event, 0,
                       sizeof(s_deferred_speaker_start_event));
                s_deferred_speaker_start_epoch = 0U;
                if (xQueueSendToFront(s_speaker_owner_events, &deferred, 0) !=
                    pdTRUE) {
                    ESP_LOGE(TAG,
                             "failed to replay deferred speaker START generation=%lu",
                             (unsigned long)deferred.speaker_generation);
                    (void)enqueue_speaker_owner_event(
                        (nuwax_speaker_owner_event_t){
                            .type = NUWAX_SPEAKER_OWNER_EVENT_PLAYBACK_FAULT,
                            .ws_connection_epoch =
                                deferred.ws_connection_epoch,
                            .speaker_generation = deferred.speaker_generation,
                            .fault_result = ESP_ERR_NO_MEM,
                        });
                }
            }
        }
    }
    /* Consume the direct lifecycle edge before consulting durable statistics.
     * The speaker publishes PLAYBACK_DONE before updating its durable terminal
     * snapshot; checking the snapshot first made normal queue delivery look
     * like a recovery and could finalize the guard ahead of its queued edge. */
    if (speaker_stats_valid && s_playback_terminal_guard.active &&
        !s_playback_terminal_guard.physical_done &&
        speaker_stats.completed_stop_result == ESP_OK &&
        speaker_stats.completed_stop_connection_epoch ==
            s_playback_terminal_guard.connection_epoch &&
        speaker_stats.completed_stop_generation ==
            s_playback_terminal_guard.speaker_generation) {
        const uint32_t terminal_epoch =
            s_playback_terminal_guard.connection_epoch;
        const uint32_t terminal_generation =
            s_playback_terminal_guard.speaker_generation;
        if (nuwax_playback_terminal_guard_mark_physical_done(
                &s_playback_terminal_guard,
                terminal_epoch,
                terminal_generation,
                speaker_stats.rx_end_accepted,
                monotonic_ms(),
                NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
            if (s_playback_terminal_guard.faulted) {
                (void)nuwax_playback_terminal_guard_commit_local_recovery(
                    &s_playback_terminal_guard,
                    terminal_epoch,
                    terminal_generation);
            }
            ESP_LOGW(TAG,
                     "speaker completion recovered from durable stats epoch=%lu generation=%lu stream_end=%d",
                     (unsigned long)terminal_epoch,
                     (unsigned long)terminal_generation,
                     speaker_stats.rx_end_accepted ? 1 : 0);
            (void)finalize_playback_terminal_if_ready(
                "speaker_completion_stats_recovery");
        }
    }
    service_deferred_speaker_state();
    service_speaker_fault_recovery_watchdog();
}
#endif

static bool recover_post_end_cloud_response_timeout(nuwax_ws_client_t *ws,
                                                     uint32_t now_ms) {
    if (!nuwax_listen_resume_state_is_waiting_post_end_asr(
            &s_listen_resume)) {
        return false;
    }

    const uint32_t expected_ws_epoch =
        nuwax_listen_resume_state_ws_epoch(&s_listen_resume);
    if (!ws || !nuwax_ws_is_connected(ws) ||
        nuwax_ws_connection_epoch(ws) != expected_ws_epoch) {
        nuwax_listen_resume_state_disarm_post_end_asr(&s_listen_resume);
        return false;
    }
    if (!nuwax_listen_resume_state_post_end_asr_expired(
            &s_listen_resume, now_ms)) {
        return false;
    }

    /* Linearize the timeout against WebSocket text callback admission. A
     * callback that entered before this point is allowed to finish queueing,
     * and a completed callback leaves its envelope in one of these queues.
     * The next owner pass drains that work before reconsidering the timeout. */
    bool arrived_cloud_work = false;
    uint32_t active_callbacks = 0U;
    uint32_t notification_queued = 0U;
    uint32_t critical_queued = 0U;
    uint32_t progress_queued = 0U;
    portENTER_CRITICAL(&s_post_end_boundary_lock);
    active_callbacks = (uint32_t)atomic_load_explicit(
        &s_ws_text_callbacks_active, memory_order_acquire);
    critical_queued = s_session_critical_commands
                          ? (uint32_t)uxQueueMessagesWaiting(
                                s_session_critical_commands)
                          : 0U;
    notification_queued = s_session_notification_commands
                              ? (uint32_t)uxQueueMessagesWaiting(
                                    s_session_notification_commands)
                              : 0U;
    progress_queued = s_session_commands
                          ? (uint32_t)uxQueueMessagesWaiting(
                                s_session_commands)
                          : 0U;
    arrived_cloud_work = active_callbacks != 0U || notification_queued != 0U ||
                         critical_queued != 0U || progress_queued != 0U;
    portEXIT_CRITICAL(&s_post_end_boundary_lock);
    if (arrived_cloud_work) {
        ESP_LOGI(TAG,
                 "post-END timeout deferred for arrived cloud work callbacks=%lu notification=%lu critical=%lu progress=%lu",
                 (unsigned long)active_callbacks,
                 (unsigned long)notification_queued,
                 (unsigned long)critical_queued,
                 (unsigned long)progress_queued);
        return false;
    }

    char audio_session_id[NUWAX_LISTEN_RESUME_AUDIO_SESSION_ID_MAX_LEN] = {0};
    strlcpy(audio_session_id,
            s_listen_resume.audio_session_id,
            sizeof(audio_session_id));
    const uint32_t expected_awake_generation =
        s_listen_resume.awake_generation;
    const bool idle_expiry_pending =
        nuwax_listen_resume_state_is_idle_expiry_pending(&s_listen_resume);
    clear_last_listen_resume();

    if (idle_expiry_pending) {
        if (!nuwax_awake_session_state_generation_matches(
                &s_awake_session, expected_awake_generation)) {
            ESP_LOGW(TAG,
                     "stale awake-boundary post-END timeout ignored expected_generation=%lu current_generation=%lu session=%s",
                     (unsigned long)expected_awake_generation,
                     (unsigned long)nuwax_awake_session_state_generation(
                         &s_awake_session),
                     audio_session_id[0] ? audio_session_id : "-");
            return true;
        }
        /* This is normal convergence of the already-expired 60-second idle
         * budget, not a business-channel failure. Keep the healthy WebSocket
         * connected and do not count it toward reconnect recovery. */
        ESP_LOGI(TAG,
                 "awake idle boundary received no cloud turn before post-END deadline; entering sleep session=%s epoch=%lu generation=%lu",
                 audio_session_id[0] ? audio_session_id : "-",
                 (unsigned long)expected_ws_epoch,
                 (unsigned long)expected_awake_generation);
        enter_sleeping_conversation_state(
            "awake_idle_timeout_post_end_expired");
        return true;
    }

    s_consecutive_post_end_response_timeouts++;

    ESP_LOGE(TAG,
             "post-END cloud response timeout session=%s ws_epoch=%lu awake_generation=%lu consecutive=%lu; recovering conversation",
             audio_session_id[0] ? audio_session_id : "-",
             (unsigned long)expected_ws_epoch,
             (unsigned long)expected_awake_generation,
             (unsigned long)s_consecutive_post_end_response_timeouts);

    if (s_consecutive_post_end_response_timeouts >=
        NUWAX_POST_END_ASR_RECONNECT_THRESHOLD) {
        ESP_LOGE(TAG,
                 "post-END cloud response timed out for %u consecutive rounds; rebuilding stalled business channel",
                 (unsigned)NUWAX_POST_END_ASR_RECONNECT_THRESHOLD);
        const bool close_queued =
            nuwax_ws_close_if_epoch(ws, expected_ws_epoch,
                                    NUWAX_WS_CLOSE_CAUSE_BUSINESS_STALLED);
        if (close_queued) {
            return true;
        }
        ESP_LOGW(TAG,
                 "post-END stalled-business close was not admitted; resuming local conversation expected_epoch=%lu current_epoch=%lu",
                 (unsigned long)expected_ws_epoch,
                 (unsigned long)nuwax_ws_connection_epoch(ws));
    }

    if (!nuwax_awake_session_state_is_active(&s_awake_session)) {
        enter_sleeping_conversation_state("post_end_response_timeout_stale");
        return true;
    }
    if (nuwax_awake_session_state_generation(&s_awake_session) !=
        expected_awake_generation) {
        ESP_LOGW(TAG,
                 "stale post-END timeout ignored expected_generation=%lu current_generation=%lu session=%s",
                 (unsigned long)expected_awake_generation,
                 (unsigned long)nuwax_awake_session_state_generation(
                     &s_awake_session),
                 audio_session_id[0] ? audio_session_id : "-");
        return true;
    }

    reset_awake_wait_budget_paused("post_end_response_timeout");
    if (!resume_awake_conversation_after_inactivity(
            "post_end_response_timeout")) {
        enter_sleeping_conversation_state("post_end_response_timeout");
    }
    return true;
}

static void check_conversation_turn_timeout(nuwax_ws_client_t *ws) {
    const uint32_t now_ms = monotonic_ms();
    if (recover_post_end_cloud_response_timeout(ws, now_ms)) {
        return;
    }
    if (nuwax_playback_terminal_guard_ready(&s_playback_terminal_guard)) {
        (void)finalize_playback_terminal_if_ready(
            "terminal_barrier_poll");
        return;
    }
    if (nuwax_playback_terminal_guard_deadline_expired(
            &s_playback_terminal_guard, now_ms)) {
        const uint32_t terminal_epoch =
            s_playback_terminal_guard.connection_epoch;
        const uint32_t terminal_generation =
            s_playback_terminal_guard.speaker_generation;
        if (!s_playback_terminal_guard.physical_done) {
            ESP_LOGE(TAG,
                     "playback terminal liveness expired without physical stop epoch=%lu generation=%lu; starting bounded local speaker recovery and retaining WebSocket",
                     (unsigned long)terminal_epoch,
                     (unsigned long)terminal_generation);
            (void)begin_playback_terminal_local_recovery(
                "playback_terminal_liveness_timeout");
            return;
        }
        if (!nuwax_playback_terminal_guard_commit_local_recovery(
                &s_playback_terminal_guard,
                terminal_epoch,
                terminal_generation)) {
            ESP_LOGE(TAG,
                     "playback terminal local quarantine binding failed epoch=%lu generation=%lu; retaining WebSocket and retrying barrier",
                     (unsigned long)terminal_epoch,
                     (unsigned long)terminal_generation);
            return;
        }
        ESP_LOGW(TAG,
                 "playback terminal cloud grace expired epoch=%lu generation=%lu turn=%s playback=%s stream_end=%d logical_end=%d cancel_sent=%d cancel_ack=%d; old generation quarantined locally and WebSocket retained",
                 (unsigned long)terminal_epoch,
                 (unsigned long)terminal_generation,
                 s_playback_terminal_guard.turn_id[0]
                     ? s_playback_terminal_guard.turn_id
                     : "-",
                 s_playback_terminal_guard.playback_id[0]
                     ? s_playback_terminal_guard.playback_id
                     : "-",
                 s_playback_terminal_guard.stream_end_seen ? 1 : 0,
                 s_playback_terminal_guard.logical_end_seen ? 1 : 0,
                 s_playback_terminal_guard.cancel_sent ? 1 : 0,
                 s_playback_terminal_guard.cancel_ack_seen ? 1 : 0);
        (void)finalize_playback_terminal_if_ready(
            "playback_terminal_local_quarantine");
        return;
    }
    bool first_pcm_timeout = false;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (s_turn_guard.active && s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING &&
        s_turn_guard.speaker_generation == 0U) {
        /* Uses the original playback_begin timestamp (duplicate metadata does
         * not renew it), with a locked START/readiness/physical-owner check. */
        first_pcm_timeout = nuwax_speaker_playback_expire_metadata_only_session(
            s_turn_guard.turn_id, s_turn_guard.playback_id,
            NUWAX_CONVERSATION_FIRST_PCM_TIMEOUT_MS);
    }
#endif
    if (!first_pcm_timeout &&
        !nuwax_turn_guard_deadline_expired(&s_turn_guard, now_ms)) {
        return;
    }

    /* Before first PCM the logical state may still be SLEEPING, although
     * the awake owner has already stopped the wake detector. Generic abort
     * recovery deliberately ignores SLEEPING and would strand that owner.
     * Retire this connection instead of accepting late greeting metadata
     * into a newly opened microphone turn on the same epoch. */
    const uint32_t greeting_ws_epoch = ws ? nuwax_ws_connection_epoch(ws) : 0U;
    if (nuwax_wake_greeting_needs_epoch_recovery(
            &s_visual_round, &s_turn_guard, greeting_ws_epoch,
            nuwax_awake_session_state_generation(&s_awake_session)) &&
        greeting_ws_epoch == active_ws_epoch_snapshot() &&
        nuwax_awake_session_state_is_active(&s_awake_session) &&
        nuwax_ws_is_connected(ws) && !local_power_transition_active() &&
        !sleep_lifecycle_blocks_new_capture() &&
        !exclusive_audio_mode_blocks_normal_audio() &&
        !nuwax_notification_blocks_conversation(&s_notification_transaction)) {
        /* Keep the bound, expired guard for the next owner tick during OTA;
         * do not tear down a transport which OTA currently owns. */
        if (ota_blocks_wake_detector()) {
            return;
        }
        const uint32_t greeting_turn_epoch = s_turn_guard.epoch;
        (void)update_normal_downlink_admission(false);
        if (nuwax_ws_close_if_epoch(ws, greeting_ws_epoch,
                                    NUWAX_WS_CLOSE_CAUSE_WAKE_GREETING_TIMEOUT)) {
            ESP_LOGW(TAG,
                     "unresolved wake greeting retired epoch=%lu turn_epoch=%lu request=%s; reconnect will restore awake owner",
                     (unsigned long)greeting_ws_epoch,
                     (unsigned long)greeting_turn_epoch, s_turn_guard.request_id);
            wake_greeting_metrics_cancel("wake_greeting_timeout");
            clear_active_turn_guard("wake_greeting_timeout");
#if CONFIG_NUWAX_SPEAKER_ENABLE
            nuwax_speaker_playback_request_fade_cancel("wake_greeting_timeout", 0U);
#endif
        }
        /* A stale close never opens capture; let the current owner converge. */
        return;
    }

    const uint32_t epoch = s_turn_guard.epoch;
    const uint32_t speaker_generation = s_turn_guard.speaker_generation;
    const nuwax_turn_phase_t phase = s_turn_guard.phase;
    const uint32_t phase_elapsed_ms =
        now_ms - s_turn_guard.phase_started_ms;
    const bool playback_ingress_idle_timeout =
        phase == NUWAX_TURN_PHASE_PLAYING;
    const bool metadata_retry_timeout =
        phase == NUWAX_TURN_PHASE_WAIT_TTS_RETRY;
    const char *timeout_reason =
        playback_ingress_idle_timeout
            ? (first_pcm_timeout ? "tts_first_pcm_timeout" : "tts_no_audio_timeout")
            : (metadata_retry_timeout ? "tts_metadata_retry_timeout"
                                      : "cloud_phase_timeout");
    char request_id[sizeof(s_turn_guard.request_id)] = {0};
    char turn_id[sizeof(s_turn_guard.turn_id)] = {0};
    char playback_id[sizeof(s_turn_guard.playback_id)] = {0};
    strlcpy(request_id, s_turn_guard.request_id, sizeof(request_id));
    strlcpy(turn_id, s_turn_guard.turn_id, sizeof(turn_id));
    strlcpy(playback_id, s_turn_guard.playback_id, sizeof(playback_id));

    ESP_LOGE(TAG,
             "conversation timeout reason=%s epoch=%lu phase=%s phase_elapsed_ms=%lu ingress_idle_limit_ms=%lu request=%s turn=%s playback=%s speaker_generation=%lu; aborting current turn while retaining WebSocket",
             timeout_reason,
             (unsigned long)epoch,
             nuwax_turn_phase_name(phase),
             (unsigned long)phase_elapsed_ms,
             (unsigned long)
                 NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS,
             request_id[0] ? request_id : "-",
             turn_id[0] ? turn_id : "-",
             playback_id[0] ? playback_id : "-",
             (unsigned long)speaker_generation);
    clear_last_listen_resume();
    wake_greeting_metrics_cancel(timeout_reason);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const uint32_t connection_epoch =
        ws ? nuwax_ws_connection_epoch(ws) : 0U;
    char cancel_request_id[NUWAX_PLAYBACK_CANCEL_REQUEST_ID_MAX_LEN] = {0};
    bool cancel_sent = false;
    bool cancel_send_failed = false;
    if (playback_ingress_idle_timeout) {
        /* The first-PCM or ingress-idle budget expired. Close admission first
         * so late audio cannot enter the next listen owner. */
        (void)update_normal_downlink_admission(false);
        snprintf(cancel_request_id,
                 sizeof(cancel_request_id),
                 "timeout_cancel_%lu",
                 (unsigned long)++s_cancel_turn_request_seq);
        const int64_t cancel_deadline_us =
            esp_timer_get_time() +
            (int64_t)NUWAX_PLAYBACK_TIMEOUT_CANCEL_SEND_MS * 1000LL;
        const esp_err_t cancel_err =
            connection_epoch != 0U && turn_id[0] != '\0'
                ? nuwax_session_send_cancel_turn_until_if_epoch(
                      ws,
                      cancel_request_id,
                      turn_id,
                      timeout_reason,
                      cancel_deadline_us,
                      connection_epoch)
                : ESP_ERR_INVALID_STATE;
        if (cancel_err != ESP_OK) {
            cancel_send_failed = true;
            ESP_LOGW(TAG,
                     "playback ingress idle timeout cancel_turn failed epoch=%lu generation=%lu err=%s; local recovery continues and WebSocket is retained",
                     (unsigned long)connection_epoch,
                     (unsigned long)speaker_generation,
                     esp_err_to_name(cancel_err));
        } else {
            cancel_sent = true;
            ESP_LOGI(TAG,
                     "playback ingress idle timeout cancel_turn sent request=%s epoch=%lu generation=%lu turn=%s reason=%s",
                     cancel_request_id,
                     (unsigned long)connection_epoch,
                     (unsigned long)speaker_generation,
                     turn_id,
                     timeout_reason);
        }
    }
    if (speaker_generation != 0U) {
        if (!nuwax_playback_terminal_guard_mark_fault(
                &s_playback_terminal_guard,
                connection_epoch,
                speaker_generation,
                now_ms,
                NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS)) {
            ESP_LOGE(TAG,
                     "conversation timeout could not bind playback terminal barrier reason=%s epoch=%lu generation=%lu; reconnecting",
                     timeout_reason,
                     (unsigned long)connection_epoch,
                     (unsigned long)speaker_generation);
            if (ws) {
                (void)nuwax_ws_request_close_if_epoch(ws, connection_epoch);
            }
            return;
        }
        if (cancel_sent) {
            if (!nuwax_playback_terminal_guard_mark_cancel_sent(
                    &s_playback_terminal_guard,
                    connection_epoch,
                    speaker_generation,
                    cancel_request_id,
                    now_ms,
                    NUWAX_PLAYBACK_FAULT_CANCEL_ACK_TIMEOUT_MS)) {
                ESP_LOGW(TAG,
                         "conversation timeout cancel transaction could not bind epoch=%lu generation=%lu request=%s; local terminal quarantine remains armed and WebSocket is retained",
                         (unsigned long)connection_epoch,
                         (unsigned long)speaker_generation,
                         cancel_request_id);
            }
        } else if (!cancel_send_failed) {
            (void)send_playback_fault_cancel(timeout_reason);
        }
        if (s_turn_guard.phase != NUWAX_TURN_PHASE_DRAINING) {
            (void)set_active_turn_phase(
                NUWAX_TURN_PHASE_DRAINING,
                NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
        }
        s_speaker_fault_recovery_epoch = connection_epoch;
        s_speaker_fault_recovery_generation = speaker_generation;
        (void)nuwax_speaker_playback_request_cancel_generation(
            speaker_generation,
            timeout_reason,
            0U);
    } else {
        clear_active_turn_guard(timeout_reason);
        nuwax_speaker_playback_request_fade_cancel(timeout_reason, 0U);
        recover_normal_conversation_after_playback_abort(
            timeout_reason);
    }
#else
    clear_active_turn_guard(timeout_reason);
    recover_normal_conversation_after_playback_abort(timeout_reason);
#endif
    set_conversation_status_guarded(playback_ingress_idle_timeout
                                        ? "TTS IDLE TIMEOUT"
                                        : (metadata_retry_timeout
                                               ? "TTS RETRY TIMEOUT"
                                               : "CLOUD TIMEOUT"),
                                    "LISTENING",
                                    "listening",
                                    true);
}

static int64_t now_ms_i64(void) {
    return esp_timer_get_time() / 1000;
}

static void reset_application_keepalive(nuwax_ws_client_t *ws) {
    const int64_t now_ms = now_ms_i64();
    s_ws_application_keepalive_epoch =
        ws ? nuwax_ws_connection_epoch(ws) : 0U;
    s_ws_application_keepalive_last_sent_ms = 0;
    s_ws_application_keepalive_next_attempt_ms = now_ms;
    portENTER_CRITICAL(&s_ws_activity_lock);
    s_ws_last_application_activity_ms = now_ms;
    s_ws_application_delay_last_log_ms = 0;
    portEXIT_CRITICAL(&s_ws_activity_lock);
}

static void note_application_keepalive_sent(nuwax_ws_client_t *ws,
                                            int64_t sent_ms) {
    if (!ws) {
        return;
    }
    s_ws_application_keepalive_epoch = nuwax_ws_connection_epoch(ws);
    s_ws_application_keepalive_last_sent_ms = sent_ms;
    s_ws_application_keepalive_next_attempt_ms =
        sent_ms + NUWAX_WS_APPLICATION_KEEPALIVE_INTERVAL_MS;
}

static esp_err_t service_application_keepalive(nuwax_ws_client_t *ws,
                                               const char *context) {
    if (!ws || !nuwax_ws_is_connected(ws)) {
        return ESP_ERR_INVALID_STATE;
    }
    service_notification_rx_rejected_timeout(ws);
    if (!nuwax_ws_is_connected(ws)) {
        return ESP_ERR_INVALID_STATE;
    }
    const uint32_t epoch = nuwax_ws_connection_epoch(ws);
    const int64_t now_ms = now_ms_i64();
    if (epoch == 0U) {
        return ESP_ERR_INVALID_STATE;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    /* The initial report is sent before audio starts. Keep later retries out
     * of capture/playback and exclusive-mode timing paths. */
    if (context != NULL && strcmp(context, "idle_wait") == 0) {
        const esp_err_t firmware_report_err = nuwax_firmware_report_service(
            ws, epoch, (uint32_t)now_ms);
        if (firmware_report_err != ESP_OK &&
            firmware_report_err != ESP_ERR_INVALID_STATE &&
            firmware_report_err != ESP_ERR_NOT_FINISHED) {
            ESP_LOGW(TAG,
                     "boot firmware report service deferred context=%s epoch=%lu err=%s",
                     context, (unsigned long)epoch,
                     esp_err_to_name(firmware_report_err));
        }
    }
#endif
    const esp_err_t activity_err = ws_check_activity_timeout(now_ms);
    if (activity_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "cloud application liveness failed context=%s epoch=%lu; closing stale session",
                 context ? context : "-",
                 (unsigned long)epoch);
        (void)nuwax_ws_close_if_epoch(
            ws, epoch, NUWAX_WS_CLOSE_CAUSE_HEARTBEAT_EXPIRED);
        return activity_err;
    }
    if (s_ws_application_keepalive_epoch != epoch) {
        reset_application_keepalive(ws);
    }
    if (now_ms < s_ws_application_keepalive_next_attempt_ms) {
        return ESP_OK;
    }

    /* Application ping is advisory. Do not contend with an in-flight audio
     * frame or control transaction for the single WebSocket lifecycle lock.
     * The WebSocket protocol ping runs independently in the RX task, while a
     * later service pass retries this application-level ping. This keeps a
     * short binary send from turning into a visible capture/playback stall. */
    const nuwax_ws_tx_diagnostics_t tx = nuwax_ws_tx_diagnostics(ws);
    if (tx.stage != NUWAX_WS_TX_STAGE_IDLE) {
        s_ws_application_keepalive_next_attempt_ms =
            now_ms + NUWAX_WS_APPLICATION_KEEPALIVE_RETRY_MS;
        ESP_LOGD(TAG,
                 "application keepalive deferred while WebSocket TX is busy context=%s epoch=%lu stage=%d stage_age_ms=%lu retry_ms=%u",
                 context ? context : "-",
                 (unsigned long)epoch,
                 (int)tx.stage,
                 (unsigned long)tx.stage_age_ms,
                 (unsigned)NUWAX_WS_APPLICATION_KEEPALIVE_RETRY_MS);
        return ESP_OK;
    }

    const int64_t deadline_us =
        esp_timer_get_time() +
        (int64_t)NUWAX_WS_APPLICATION_KEEPALIVE_SEND_BUDGET_MS * 1000LL;
    const esp_err_t err = nuwax_session_send_ping_until_if_epoch(ws,
                                                                 now_ms,
                                                                 deadline_us,
                                                                 epoch);
    if (err == ESP_OK) {
        const int64_t previous_ms =
            s_ws_application_keepalive_last_sent_ms;
        note_application_keepalive_sent(ws, now_ms);
        ESP_LOGI(TAG,
                 "application keepalive sent context=%s epoch=%lu previous_age_ms=%lld",
                 context ? context : "-",
                 (unsigned long)epoch,
                 previous_ms > 0 ? (long long)(now_ms - previous_ms) : -1LL);
        return ESP_OK;
    }

    s_ws_application_keepalive_next_attempt_ms =
        now_ms + NUWAX_WS_APPLICATION_KEEPALIVE_RETRY_MS;
    ESP_LOGW(TAG,
             "application keepalive deferred context=%s epoch=%lu err=%s retry_ms=%u",
             context ? context : "-",
             (unsigned long)epoch,
             esp_err_to_name(err),
             (unsigned)NUWAX_WS_APPLICATION_KEEPALIVE_RETRY_MS);
    return err;
}

static esp_err_t service_idle_wait_application_keepalive(
    nuwax_ws_client_t *ws) {
    const uint32_t expected_epoch =
        ws ? nuwax_ws_connection_epoch(ws) : 0U;
    const esp_err_t err =
        service_application_keepalive(ws, "idle_wait");
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (err == ESP_OK) service_offline_audio_replay(ws);
#endif
    if (err == ESP_OK) {
        return ESP_OK;
    }
    if (nuwax_ws_keepalive_timeout_is_transient(
            err == ESP_ERR_TIMEOUT,
            ws && nuwax_ws_is_connected(ws),
            ws && expected_epoch != 0U &&
                nuwax_ws_connection_epoch(ws) == expected_epoch,
            ws && expected_epoch != 0U &&
                nuwax_ws_heartbeat_healthy_if_epoch(
                    ws, expected_epoch))) {
        return ESP_OK;
    }
    return err;
}

static void store_cloud_connection_state(bool transport_connected,
                                         bool service_ready,
                                         bool authenticated) {
    portENTER_CRITICAL(&s_cloud_auth_lock);
    s_cloud_transport_connected = transport_connected;
    s_cloud_service_ready = transport_connected && service_ready;
    s_cloud_authenticated = transport_connected && authenticated;
    if (!transport_connected) {
        s_cloud_connection_epoch = 0U;
    }
    portEXIT_CRITICAL(&s_cloud_auth_lock);
#if CONFIG_NUWAX_OTA_ENABLE
    /* This helper is currently used for disconnected/reset snapshots. A
     * positive binding is published only by the handshake callback, where the
     * actual WebSocket epoch is available. */
    nuwax_ota_device_set_cloud_authenticated(false, 0U);
#endif
}

static void mark_cloud_disconnected(void) {
    bool auth_failed = false;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    auth_failed = s_cloud_auth_failed_latched;
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    store_cloud_connection_state(false, false, false);
    nuwax_app_shell_set_cloud_state(auth_failed ? NUWAX_CLOUD_AUTHFAIL
                                                : NUWAX_CLOUD_DISCONNECTED);
}

static void mark_cloud_auth_failed(void) {
    portENTER_CRITICAL(&s_cloud_auth_lock);
    s_cloud_transport_connected = true;
    s_cloud_service_ready = false;
    s_cloud_authenticated = false;
    s_cloud_auth_failed_latched = true;
    portEXIT_CRITICAL(&s_cloud_auth_lock);
#if CONFIG_NUWAX_OTA_ENABLE
    nuwax_ota_device_set_cloud_authenticated(false, 0U);
#endif
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_AUTHFAIL);
}

static bool mark_cloud_auth_failed_if_epoch(uint32_t connection_epoch)
{
    bool accepted = false;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    if (nuwax_cloud_epoch_is_current(s_cloud_connection_epoch,
                                     connection_epoch)) {
        s_cloud_service_ready = false;
        s_cloud_authenticated = false;
        s_cloud_auth_failed_latched = true;
        accepted = true;
    }
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    if (!accepted) {
        return false;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    nuwax_ota_device_set_cloud_authenticated(false, 0U);
#endif
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_AUTHFAIL);
    return true;
}

static bool mark_cloud_provision_required_if_epoch(uint32_t connection_epoch)
{
    bool accepted = false;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    accepted = nuwax_cloud_epoch_record_provision_required(
        s_cloud_connection_epoch,
        connection_epoch,
        &s_cloud_provision_required_epoch);
    if (accepted) {
        s_cloud_service_ready = false;
        s_cloud_authenticated = false;
        s_cloud_auth_failed_latched = true;
    }
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    if (!accepted) {
        return false;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    nuwax_ota_device_set_cloud_authenticated(false, 0U);
#endif
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_AUTHFAIL);
    return true;
}

static uint32_t cloud_provision_required_epoch(void)
{
    uint32_t epoch = 0U;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    epoch = s_cloud_provision_required_epoch;
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    return epoch;
}

static bool consume_cloud_provision_required(uint32_t expected_epoch)
{
    bool consumed = false;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    consumed = nuwax_cloud_epoch_consume_provision_required(
        expected_epoch, &s_cloud_provision_required_epoch);
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    return consumed;
}

/* The frozen formal-cloud contract validates X-Bridge-Token before returning
 * HTTP 101. This callback runs synchronously before the RX task is started, so
 * even an immediately delivered OTA command observes verified credentials. */
static void on_ws_handshake_authenticated(void *user_ctx) {
    nuwax_ws_client_t *ws = (nuwax_ws_client_t *)user_ctx;
    if (!ws) {
        ESP_LOGE(TAG, "authenticated handshake has no WebSocket owner");
        return;
    }
    const uint32_t connection_epoch = nuwax_ws_connection_epoch(ws);
    if (connection_epoch == 0U) {
        ESP_LOGE(TAG, "authenticated handshake has no WebSocket epoch");
        return;
    }
    portENTER_CRITICAL(&s_cloud_auth_lock);
    s_cloud_transport_connected = true;
    s_cloud_service_ready = false;
    s_cloud_authenticated = true;
    s_cloud_auth_failed_latched = false;
    s_cloud_connection_epoch = connection_epoch;
    portEXIT_CRITICAL(&s_cloud_auth_lock);
#if CONFIG_NUWAX_OTA_ENABLE
    nuwax_ota_device_set_cloud_authenticated(true, connection_epoch);
#endif
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_CONNECTING);
    ESP_LOGI(TAG,
             "cloud transport authenticated by WebSocket 101; awaiting application activity");
}

static bool cloud_service_is_ready(void) {
    bool ready;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    ready = s_cloud_transport_connected && s_cloud_service_ready &&
            s_cloud_authenticated;
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    return ready;
}

/* Cloud-ready closes the connecting phase. Converge to the sleeping
 * lifecycle before consuming commands, without stealing an active awake,
 * audio, exclusive-mode, or notification owner. */
static bool reconcile_cloud_ready_sleep_state(const char *reason) {
    if (conversation_state_current() != NUWAX_APP_STATE_WS_CONNECTING ||
        !cloud_service_is_ready() ||
        s_awake_resume_after_ws_reconnect ||
        nuwax_awake_session_state_is_active(&s_awake_session) ||
        s_turn_guard.active || s_prelisten.pending ||
        s_prelisten.capture_active || conversation_capture_busy_for_sleep() ||
        nuwax_notification_blocks_conversation(
            &s_notification_transaction) ||
        meeting_or_monitoring_mode_blocks_sleep() ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)
#if CONFIG_NUWAX_OTA_ENABLE
        || nuwax_ota_device_blocks_audio()
#endif
    ) {
        return false;
    }

    ESP_LOGW(TAG,
             "cloud-ready lifecycle still WS_CONNECTING; converging to SLEEPING before command consumption reason=%s",
             reason ? reason : "cloud_ready_reconcile");
    request_sleeping_conversation_state(
        reason ? reason : "cloud_ready_reconcile");
    return conversation_state_current() == NUWAX_APP_STATE_SLEEPING;
}

static void schedule_volume_report(uint8_t volume_percent,
                                   bool from_device_ui) {
    uint32_t next_sequence = s_volume_report.sequence + 1U;
    if (next_sequence == 0U) {
        next_sequence = 1U;
    }
    s_volume_report.pending = true;
    s_volume_report.from_device_ui = from_device_ui;
    s_volume_report.volume_percent = volume_percent > 100U
                                         ? 100U
                                         : volume_percent;
    s_volume_report.sequence = next_sequence;
    s_volume_report.next_attempt_ms = 0U;
}

static void schedule_current_volume_snapshot(void) {
    if (s_volume_report.pending) {
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    s_current_volume_percent = nuwax_speaker_playback_get_volume_percent();
#endif
    schedule_volume_report(s_current_volume_percent, false);
}

static void service_pending_volume_report(nuwax_ws_client_t *ws) {
    if (!s_volume_report.pending || !ws || !nuwax_ws_is_connected(ws) ||
        !cloud_service_is_ready()) {
        return;
    }

    const uint32_t now_ms = monotonic_ms();
    if (s_volume_report.next_attempt_ms != 0U &&
        !elapsed_ms(now_ms, s_volume_report.next_attempt_ms)) {
        return;
    }

    if (s_volume_report_boot_nonce == 0U) {
        s_volume_report_boot_nonce = esp_random();
        if (s_volume_report_boot_nonce == 0U) {
            s_volume_report_boot_nonce = 1U;
        }
    }
    const uint32_t report_sequence = s_volume_report.sequence;
    const uint8_t volume_percent = s_volume_report.volume_percent;
    const char *source = s_volume_report.from_device_ui
                             ? "device_ui"
                             : "device_sync";
    char event_id[40];
    snprintf(event_id,
             sizeof(event_id),
             "volume_%08lx_%08lx",
             (unsigned long)s_volume_report_boot_nonce,
             (unsigned long)report_sequence);

    const uint32_t ws_epoch = nuwax_ws_connection_epoch(ws);
    const esp_err_t err = nuwax_session_send_volume_changed_until_if_epoch(
        ws,
        event_id,
        volume_percent,
        source,
        esp_timer_get_time() +
            (int64_t)NUWAX_VOLUME_REPORT_SEND_BUDGET_MS * 1000LL,
        ws_epoch);
    if (err == ESP_OK) {
        if (s_volume_report.pending &&
            s_volume_report.sequence == report_sequence) {
            s_volume_report.pending = false;
            s_volume_report.next_attempt_ms = 0U;
        }
        ESP_LOGI(TAG,
                 "volume change reported event=%s volume=%u source=%s epoch=%lu",
                 event_id,
                 (unsigned)volume_percent,
                 source,
                 (unsigned long)ws_epoch);
        return;
    }

    if (s_volume_report.pending &&
        s_volume_report.sequence == report_sequence) {
        s_volume_report.next_attempt_ms = now_ms + NUWAX_VOLUME_REPORT_RETRY_MS;
    }
    ESP_LOGW(TAG,
             "volume change report deferred event=%s volume=%u source=%s epoch=%lu err=%s retry_ms=%u",
             event_id,
             (unsigned)volume_percent,
             source,
             (unsigned long)ws_epoch,
             esp_err_to_name(err),
             (unsigned)NUWAX_VOLUME_REPORT_RETRY_MS);
}

static const char *cloud_message_kind_name(nuwax_cloud_message_kind_t kind)
{
    switch (kind) {
    case NUWAX_CLOUD_MESSAGE_HELLO_OK:
        return "hello_ok";
    case NUWAX_CLOUD_MESSAGE_PONG:
        return "pong";
    case NUWAX_CLOUD_MESSAGE_DEVICE_COMMAND:
        return "device_command";
    case NUWAX_CLOUD_MESSAGE_AUTH_REJECTED:
        return "auth_rejected";
    case NUWAX_CLOUD_MESSAGE_PROVISION_REQUIRED:
        return "provision_required";
    case NUWAX_CLOUD_MESSAGE_HELLO_REJECTED:
        return "hello_rejected";
    case NUWAX_CLOUD_MESSAGE_NONE:
    default:
        return "none";
    }
}

static bool cloud_message_is_positive(nuwax_cloud_message_kind_t kind)
{
    return kind == NUWAX_CLOUD_MESSAGE_HELLO_OK ||
           kind == NUWAX_CLOUD_MESSAGE_PONG ||
           kind == NUWAX_CLOUD_MESSAGE_DEVICE_COMMAND;
}

static void note_positive_cloud_activity(nuwax_cloud_message_kind_t kind,
                                         uint32_t connection_epoch)
{
    if (!cloud_message_is_positive(kind)) {
        return;
    }
    bool accepted = false;
    bool already_ready = false;
    portENTER_CRITICAL(&s_cloud_auth_lock);
    if (s_cloud_transport_connected && s_cloud_authenticated &&
        nuwax_cloud_epoch_accepts_positive(
            s_cloud_connection_epoch,
            connection_epoch,
            s_cloud_provision_required_epoch)) {
        if (s_cloud_service_ready) {
            already_ready = true;
        } else {
            s_cloud_service_ready = true;
            accepted = true;
        }
    }
    portEXIT_CRITICAL(&s_cloud_auth_lock);
    if (already_ready) {
        return;
    }
    if (!accepted) {
        ESP_LOGW(TAG,
                 "positive cloud activity ignored outside current authenticated epoch kind=%s message_epoch=%lu",
                 cloud_message_kind_name(kind),
                 (unsigned long)connection_epoch);
        return;
    }
    nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_CONNECTED);
    ESP_LOGI(TAG, "cloud service ready kind=%s",
             cloud_message_kind_name(kind));
#if CONFIG_NUWAX_OTA_ENABLE
    esp_err_t ota_health_err =
        nuwax_ota_device_cloud_ready(connection_epoch);
    if (ota_health_err != ESP_OK) {
        ESP_LOGE(TAG, "OTA cloud activity health notification failed: %s",
                 esp_err_to_name(ota_health_err));
    }
#endif
}

static void ws_mark_rx_activity(void) {
    portENTER_CRITICAL(&s_ws_activity_lock);
    s_ws_last_rx_activity_ms = now_ms_i64();
    portEXIT_CRITICAL(&s_ws_activity_lock);
}

static void ws_mark_application_activity(void) {
    portENTER_CRITICAL(&s_ws_activity_lock);
    s_ws_last_application_activity_ms = now_ms_i64();
    s_ws_application_delay_last_log_ms = 0;
    portEXIT_CRITICAL(&s_ws_activity_lock);
}

static esp_err_t ws_check_activity_timeout(int64_t now_ms) {
    int64_t last_application_activity_ms = 0;
    int64_t last_transport_activity_ms = 0;
    int64_t application_delay_last_log_ms = 0;
    portENTER_CRITICAL(&s_ws_activity_lock);
    last_application_activity_ms = s_ws_last_application_activity_ms;
    last_transport_activity_ms = s_ws_last_rx_activity_ms;
    application_delay_last_log_ms = s_ws_application_delay_last_log_ms;
    portEXIT_CRITICAL(&s_ws_activity_lock);
    if (last_application_activity_ms > 0 &&
        now_ms - last_application_activity_ms >
            NUWAX_WS_APPLICATION_ACTIVITY_TIMEOUT_MS &&
        (application_delay_last_log_ms == 0 ||
         now_ms - application_delay_last_log_ms >=
             NUWAX_WS_APPLICATION_KEEPALIVE_INTERVAL_MS)) {
        portENTER_CRITICAL(&s_ws_activity_lock);
        s_ws_application_delay_last_log_ms = now_ms;
        portEXIT_CRITICAL(&s_ws_activity_lock);
        ESP_LOGW(TAG,
                 "cloud application activity delayed last_app_age_ms=%lld threshold_ms=%d; transport heartbeat remains authoritative and WebSocket is retained",
                 (long long)(now_ms - last_application_activity_ms),
                 NUWAX_WS_APPLICATION_ACTIVITY_TIMEOUT_MS);
    }
    if (last_transport_activity_ms > 0 &&
        now_ms - last_transport_activity_ms > NUWAX_WS_ACTIVITY_TIMEOUT_MS) {
        ESP_LOGW(TAG,
                 "WebSocket transport activity timeout last_rx_age_ms=%lld threshold_ms=%d; reconnecting",
                 (long long)(now_ms - last_transport_activity_ms),
                 NUWAX_WS_ACTIVITY_TIMEOUT_MS);
        return ESP_ERR_INVALID_STATE;
    }
    return ESP_OK;
}

static esp_err_t wait_for_cloud_service_ready(nuwax_ws_client_t *ws) {
    if (!ws) {
        return ESP_ERR_INVALID_ARG;
    }
    int64_t last_ping_ms = now_ms_i64();
    ESP_LOGI(TAG,
             "waiting for authenticated cloud application activity before audio resume");
    while (nuwax_ws_is_connected(ws) && !cloud_service_is_ready()) {
        app_task_watchdog_checkpoint();
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            ESP_LOGI(TAG, "cloud-ready wait preempted by BLE reprovision");
            return ESP_ERR_INVALID_STATE;
        }
        const int64_t now_ms = now_ms_i64();
        const esp_err_t activity_err = ws_check_activity_timeout(now_ms);
        if (activity_err != ESP_OK) {
            if (!nuwax_ws_is_connected(ws)) {
                return activity_err;
            }
            ESP_LOGW(TAG,
                     "cloud-ready transport activity is stale but RX owner still holds the connection; waiting for transport verdict");
            vTaskDelay(pdMS_TO_TICKS(50));
            continue;
        }
        if (now_ms - last_ping_ms >= NUWAX_WS_READY_PING_INTERVAL_MS) {
            const esp_err_t ping_err = nuwax_session_send_ping(ws, now_ms);
            if (ping_err != ESP_OK) {
                ESP_LOGW(TAG, "cloud-ready application ping failed: %s",
                         esp_err_to_name(ping_err));
                if (!nuwax_ws_is_connected(ws)) {
                    return ping_err;
                }
                last_ping_ms = now_ms;
                vTaskDelay(pdMS_TO_TICKS(50));
                continue;
            }
            note_application_keepalive_sent(ws, now_ms);
            last_ping_ms = now_ms;
        }
        vTaskDelay(pdMS_TO_TICKS(50));
    }
    if (!nuwax_ws_is_connected(ws)) {
        return ESP_ERR_INVALID_STATE;
    }
    ESP_LOGI(TAG, "authenticated cloud application ready; audio may resume");
    (void)reconcile_cloud_ready_sleep_state("cloud_ready_received");
    return ESP_OK;
}

static void on_ws_rx_activity(void *user_ctx) {
    (void)user_ctx;
    ws_mark_rx_activity();
}

static bool queue_p3_softref_ab_fast(const nuwax_session_command_t *command,
                                     uint32_t ws_connection_epoch) {
    if (!command ||
        !command->has_command ||
        strcmp(command->command, "p3_softref_ab") != 0 ||
        !s_p3_softref_ab_requests) {
        return false;
    }

    p3_softref_ab_request_t request = {0};
    request.ws_connection_epoch = ws_connection_epoch;
    strlcpy(request.request_id,
            command->request_id[0] ? command->request_id : "p3softref_fast",
            sizeof(request.request_id));
    request.duration_ms = command->has_duration_ms ? command->duration_ms : 1000U;
    if (command->has_delay_samples) {
        request.delay_samples = command->delay_samples;
    } else if (command->has_delay_ms) {
        request.delay_samples = (uint32_t)(((uint64_t)CONFIG_NUWAX_VOICE_OUTPUT_SAMPLE_RATE *
                                            (uint64_t)command->delay_ms) /
                                           1000ULL);
    } else {
        request.delay_samples = 240U;
    }

    if (xQueueSend(s_p3_softref_ab_requests, &request, 0) == pdTRUE) {
        ESP_LOGI(TAG,
                 "P3-0S fast A/B queued request=%s duration_ms=%lu delay_samples=%lu",
                 request.request_id,
                 (unsigned long)request.duration_ms,
                 (unsigned long)request.delay_samples);
        return true;
    }

    p3_softref_ab_request_t dropped = {0};
    if (xQueueReceive(s_p3_softref_ab_requests, &dropped, 0) == pdTRUE &&
        xQueueSend(s_p3_softref_ab_requests, &request, 0) == pdTRUE) {
        ESP_LOGW(TAG,
                 "P3-0S fast A/B queue full, dropped request=%s incoming=%s",
                 dropped.request_id,
                 request.request_id);
        return true;
    }

    ESP_LOGW(TAG, "P3-0S fast A/B queue full, fallback to session queue request=%s", request.request_id);
    return false;
}

static bool queue_p5_during_playback_candidate_fast(
    const nuwax_session_command_t *command,
    uint32_t ws_connection_epoch) {
    if (!command ||
        !command->has_command ||
        strcmp(command->command, "p5_during_playback_candidate") != 0 ||
        !s_p5_during_playback_candidate_requests) {
        return false;
    }

    p5_during_playback_candidate_request_t request = {0};
    request.ws_connection_epoch = ws_connection_epoch;
    strlcpy(request.mode,
            command->mode[0] ? command->mode : "record_only",
            sizeof(request.mode));
    strlcpy(request.request_id,
            command->request_id[0] ? command->request_id : "p5cand_fast",
            sizeof(request.request_id));
    strlcpy(request.audio_session_id,
            command->audio_session_id,
            sizeof(request.audio_session_id));
    request.duration_ms = command->has_duration_ms ? command->duration_ms : 5000U;
    if (command->has_delay_samples) {
        request.delay_samples = command->delay_samples;
    } else if (command->has_delay_ms) {
        request.delay_samples = (uint32_t)(((uint64_t)CONFIG_NUWAX_VOICE_OUTPUT_SAMPLE_RATE *
                                            (uint64_t)command->delay_ms) /
                                           1000ULL);
    } else {
        request.delay_samples = NUWAX_P5_DURING_PLAYBACK_DEFAULT_DELAY_SAMPLES;
    }

    if (xQueueSend(s_p5_during_playback_candidate_requests, &request, 0) == pdTRUE) {
        ESP_LOGI(TAG,
                 "P5-3 fast candidate queued mode=%s request=%s audio_session_id=%s duration_ms=%lu delay_samples=%lu",
                 request.mode,
                 request.request_id,
                 request.audio_session_id[0] ? request.audio_session_id : "-",
                 (unsigned long)request.duration_ms,
                 (unsigned long)request.delay_samples);
        return true;
    }

    p5_during_playback_candidate_request_t dropped = {0};
    if (xQueueReceive(s_p5_during_playback_candidate_requests, &dropped, 0) == pdTRUE &&
        xQueueSend(s_p5_during_playback_candidate_requests, &request, 0) == pdTRUE) {
        ESP_LOGW(TAG,
                 "P5-3 fast candidate queue full, dropped request=%s incoming=%s",
                 dropped.request_id,
                 request.request_id);
        return true;
    }

    ESP_LOGE(TAG, "P5-3 fast candidate queue full, dropped incoming request=%s", request.request_id);
    return true;
}

/* An exclusive audio mode owns the microphone and uplink from the moment its
 * command is queued until teardown completes. Ordinary conversation data
 * must not cross either side of that ownership boundary. */
static bool meeting_or_monitoring_mode_blocks_sleep(void) {
    bool blocked = nuwax_meeting_mode_has_audio_claim(&s_meeting_mode) ||
                   nuwax_monitoring_mode_has_audio_claim(&s_monitoring_mode);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    blocked = blocked || offline_mode_lease_pending() ||
              nuwax_offline_audio_capture_running();
#endif
    return blocked;
}

static bool power_key_short_press_dialogue_state(nuwax_app_state_t state) {
    switch (state) {
        case NUWAX_APP_STATE_IDLE:
        case NUWAX_APP_STATE_LISTENING:
        case NUWAX_APP_STATE_THINKING:
        case NUWAX_APP_STATE_SPEAKING:
            return true;
        case NUWAX_APP_STATE_BOOTING:
        case NUWAX_APP_STATE_WIFI_CONNECTING:
        case NUWAX_APP_STATE_WS_CONNECTING:
        case NUWAX_APP_STATE_SLEEPING:
        case NUWAX_APP_STATE_ERROR:
        default:
            return false;
    }
}

static bool exclusive_audio_mode_blocks_normal_audio(void) {
    bool blocked = atomic_load_explicit(&s_reprovision_quiesce_requested,
                                        memory_order_acquire) ||
                   nuwax_meeting_mode_has_pending(&s_meeting_mode) ||
                   nuwax_monitoring_mode_has_pending(&s_monitoring_mode);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    /* Offline SD capture owns I2S RX even though the cloud mode controllers
     * are reset to DISABLED after a disconnect.  Keep ordinary conversation
     * fenced until the MIC is released and the mode lease is re-admitted.
     * Background FILE/tail persistence has no microphone ownership. */
    blocked = blocked || offline_mode_lease_pending() ||
              nuwax_offline_audio_capture_running();
#endif
    return blocked;
}

static bool exclusive_audio_controllers_released(void) {
    return nuwax_meeting_mode_state(&s_meeting_mode) ==
               NUWAX_MEETING_STATE_DISABLED &&
           nuwax_monitoring_mode_state(&s_monitoring_mode) ==
               NUWAX_MONITORING_STATE_DISABLED &&
           !nuwax_meeting_mode_has_pending(&s_meeting_mode) &&
           !nuwax_monitoring_mode_has_pending(&s_monitoring_mode);
}

/* Retry the end-of-exclusive-mode sleep transition after a deferred owner
 * (most notably the SD archive writer) releases the shared audio path.  This
 * is deliberately a one-shot latch: a new mode or another lifecycle owner
 * clears/blocks it, so it cannot force SLEEPING over a later conversation. */
static void service_exclusive_audio_sleep_reconcile(void) {
    if (!s_exclusive_audio_sleep_reconcile_pending) {
        return;
    }
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        return;
    }
    if (!exclusive_audio_controllers_released()) {
        /* A queued controller event may still be draining after the first
         * DISABLED callback. Keep the latch until that queue is quiescent;
         * a subsequent STARTING/takeover explicitly clears it. */
        return;
    }
    if (meeting_or_monitoring_mode_blocks_sleep() ||
        conversation_capture_busy_for_sleep() || s_prelisten.capture_active ||
        s_turn_guard.active ||
        nuwax_notification_blocks_conversation(&s_notification_transaction)) {
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        return;
    }
#endif
    if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        s_exclusive_audio_sleep_reconcile_pending = false;
        return;
    }
    /* Give already-queued local interactions and replacement transactions
     * priority over the deferred mode-end cleanup.  The latch will be
     * serviced again after the owner drains these queues. */
    if ((s_wake_word_events &&
         uxQueueMessagesWaiting(s_wake_word_events) > 0U) ||
        s_head_touch_agent_intent.state != NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE ||
        (s_shell_actions && uxQueueMessagesWaiting(s_shell_actions) > 0U)) {
        return;
    }

    s_exclusive_audio_sleep_reconcile_pending = false;
    ESP_LOGI(TAG,
             "exclusive audio owners released; reconciling sleeping state");
    if (!commit_sleeping_conversation_state("exclusive_audio_released")) {
        /* A last-moment owner race keeps the latch for the next service pass.
         * The commit routine itself remains the final admission authority. */
        s_exclusive_audio_sleep_reconcile_pending = true;
    }
}

#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
static void reset_offline_capture_retry_state(void)
{
    s_offline_capture_retry_next_ms = 0U;
    s_offline_capture_retry_backoff_ms = 0U;
    s_offline_capture_retry_attempts = 0U;
}

static nuwax_audio_mode_identity_t *offline_mode_identity(void)
{
    return offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING
        ? &s_monitoring_mode.identity : &s_meeting_mode.identity;
}

static bool service_offline_duration_limit(void)
{
    if (!offline_mode_lease_pending()) {
        return false;
    }
    const bool monitoring =
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING;
    const bool waiting = !nuwax_offline_audio_capture_running() ||
        !nuwax_offline_capture_health_is_recording(nuwax_offline_audio_capture_health());
    const bool wait_expired = waiting && nuwax_offline_wait_expired(
        monotonic_ms(), atomic_load_explicit(&s_offline_wait_started_ms, memory_order_acquire),
        monitoring ? CONFIG_NUWAX_MONITORING_OFFLINE_MAX_HOURS : CONFIG_NUWAX_MEETING_OFFLINE_MAX_HOURS);
    if (!nuwax_offline_audio_limit_reached() && !wait_expired) {
        return false;
    }
    offline_mode_lease_store(false);
    (void)nuwax_offline_audio_request_stop(false);
    s_offline_mode_resume_session[0] = '\0';
    nuwax_audio_mode_identity_clear(offline_mode_identity());
    s_offline_mode_capture_started = false;
    reset_offline_capture_retry_state();
    atomic_store_explicit(&s_offline_mode_cancel_to_sleep, true, memory_order_release);
    ESP_LOGI(TAG,
             "offline %s %s limit reached; automatic resume cancelled",
             monitoring ? "monitoring" : "meeting", wait_expired ? "waiting" : "capture");
    return true;
}

static void service_offline_capture_retry_disconnected(void)
{
#if CONFIG_NUWAX_SD_SESSION_ENABLE
    nuwax_sd_session_network(false);
    nuwax_meeting_mode_service_sd(&s_meeting_mode, NULL);
    nuwax_monitoring_mode_service_sd(&s_monitoring_mode, NULL);
    if (s_meeting_mode.sd_local || s_monitoring_mode.sd_local) return;
#endif
    if (service_offline_duration_limit()) {
        return;
    }
    if (!offline_mode_lease_pending() ||
        nuwax_offline_audio_capture_running() ||
        s_offline_mode_resume_session[0] == '\0' ||
        atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        return;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active()) {
        return;
    }
#endif

    const uint32_t now = monotonic_ms();
    if (s_offline_capture_retry_next_ms != 0U &&
        !elapsed_ms(now, s_offline_capture_retry_next_ms)) {
        return;
    }

    /* A previous reader may have stopped after consuming frames (for example
     * after card failure). Carry its cursor into the retry as well. */
    if (s_offline_mode_capture_started) {
        offline_mode_identity()->next_capture_sequence =
            nuwax_offline_audio_next_capture_sequence();
        s_offline_mode_capture_started = false;
    }
    /* Mount/scan/fsync belong to the storage supervisor. The connection
     * owner must remain available for stop, network and power controls. */
    const esp_err_t err = nuwax_offline_audio_start_capture_continuation(
            offline_mode_kind(),
            s_offline_mode_resume_session,
            CONFIG_NUWAX_VOICE_SAMPLE_RATE,
            CONFIG_NUWAX_VOICE_CHANNELS,
            CONFIG_NUWAX_VOICE_FRAME_DURATION_MS,
            offline_mode_identity()->next_capture_sequence);
    if (err == ESP_OK) {
        /* A local/cloud stop can arrive during task allocation. Revalidate
         * before publishing success; the reader also checks its stop epoch. */
        if (!offline_mode_lease_pending() || !offline_mode_identity()->resuming ||
            atomic_load_explicit(&s_reprovision_quiesce_requested, memory_order_acquire)) {
            (void)nuwax_offline_audio_request_stop(false);
            return;
        }
        const uint32_t attempt = s_offline_capture_retry_attempts;
        s_offline_mode_capture_started = true;
        atomic_store_explicit(&s_offline_mode_capture_failed, false,
                              memory_order_release);
        reset_offline_capture_retry_state();
        ESP_LOGI(TAG,
                 "offline capture retry succeeded mode=%s attempt=%lu session=%s",
                 offline_mode_kind() ==
                         NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                     ? "monitoring"
                     : "meeting",
                 (unsigned long)attempt,
                 s_offline_mode_resume_session);
        return;
    }

    atomic_store_explicit(&s_offline_mode_capture_failed, true,
                          memory_order_release);
    nuwax_offline_audio_supervisor_wake();
    if (s_offline_capture_retry_attempts < UINT32_MAX) {
        s_offline_capture_retry_attempts++;
    }
    if (s_offline_capture_retry_backoff_ms == 0U) {
        s_offline_capture_retry_backoff_ms =
            NUWAX_OFFLINE_CAPTURE_RETRY_INITIAL_MS;
    } else if (s_offline_capture_retry_backoff_ms <
               NUWAX_OFFLINE_CAPTURE_RETRY_MAX_MS / 2U) {
        s_offline_capture_retry_backoff_ms *= 2U;
    } else {
        s_offline_capture_retry_backoff_ms =
            NUWAX_OFFLINE_CAPTURE_RETRY_MAX_MS;
    }
    s_offline_capture_retry_next_ms =
        now + s_offline_capture_retry_backoff_ms;
    const nuwax_audio_runtime_memory_t memory =
        exclusive_audio_memory_snapshot();
    char detail[NUWAX_DEVICE_ERROR_RESULT_BYTES];
    snprintf(detail,
             sizeof(detail),
             "%s;attempt=%lu;retry_ms=%lu;internal=%u;largest=%u;dma=%u",
             esp_err_to_name(err),
             (unsigned long)s_offline_capture_retry_attempts,
             (unsigned long)s_offline_capture_retry_backoff_ms,
             (unsigned)memory.internal_free,
             (unsigned)memory.internal_largest,
             (unsigned)memory.dma_largest);
    /* At most the initial two attempts are reported (disconnect may already
     * count as attempt one). A card absent for hours must not keep writing
     * diagnostic NVS; subsequent retries remain visible in serial logs. */
    if (s_offline_capture_retry_attempts <= 2U) {
        (void)nuwax_device_warning_report_enqueue_detail(
            "audio", "offline_capture_retry", err, detail,
            offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                ? "monitoring" : "meeting", 0U, s_offline_mode_resume_session);
    }
    ESP_LOGW(TAG,
             "offline capture retry deferred mode=%s attempt=%lu err=%s next_ms=%lu internal=%u largest=%u dma=%u",
             offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                 ? "monitoring"
                 : "meeting",
             (unsigned long)s_offline_capture_retry_attempts,
             esp_err_to_name(err),
             (unsigned long)s_offline_capture_retry_next_ms,
             (unsigned)memory.internal_free,
             (unsigned)memory.internal_largest,
             (unsigned)memory.dma_largest);
}

static bool offline_replay_control_busy(void)
{
    return offline_mode_lease_pending() ||
           nuwax_meeting_mode_has_pending(&s_meeting_mode) ||
           (nuwax_monitoring_mode_has_pending(&s_monitoring_mode) && !nuwax_sd_session_monitoring()) ||
           reprovision_request_pending() ||
           nuwax_notification_blocks_conversation(&s_notification_transaction) ||
           s_prelisten.capture_active || nuwax_audio_uplink_sender_busy();
}

/* Called on every idle-wait tick as well as the outer connection loop.
 * Deadlines and ready files are level-triggered; no retry flag is required. */
static void service_offline_audio_replay(nuwax_ws_client_t *ws)
{
    if (!ws || !nuwax_ws_is_connected(ws)) return;
    nuwax_sd_session_network(true);
    if (offline_replay_control_busy()) return;
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active()) return;
#endif
    const uint32_t epoch = nuwax_ws_connection_epoch(ws);
    /* Recovery can scan a large directory for seconds. Its supervisor owns
     * that work; never perform it on the connection/keepalive task. */
    const bool replay_epoch_new = s_offline_replay_attempt_epoch != epoch;
    if (replay_epoch_new) {
        nuwax_offline_audio_supervisor_wake();
    }

    /* Replay is a bounded background service, not a once-per-epoch gate. A
     * transient admission failure or ACK timeout must be retried in place
     * while the same healthy WebSocket remains connected. */
    if (replay_epoch_new) {
        s_offline_replay_attempt_epoch = epoch;
        s_offline_replay_next_attempt_ms = 0U;
        s_offline_replay_backoff_ms = 0U;
    }
    const uint32_t replay_now_ms = monotonic_ms();
    if (nuwax_offline_audio_replay_retry_pending() &&
        !nuwax_offline_audio_storage_busy() &&
        !nuwax_offline_audio_replay_running() &&
        nuwax_offline_audio_replay_retry_required()) {
        /* A start racing with media recovery also raises this edge. Consume
         * it without cancelling backoff, otherwise every poll retries. */
        ESP_LOGI(TAG,
                 "offline archive replay retry pending; preserving backoff epoch=%lu",
                 (unsigned long)epoch);
    }
    if (nuwax_offline_audio_has_ready() &&
        !nuwax_offline_audio_storage_busy() &&
        !nuwax_offline_audio_replay_running() &&
        (s_offline_replay_next_attempt_ms == 0U ||
         elapsed_ms(replay_now_ms, s_offline_replay_next_attempt_ms))) {
        esp_err_t replay_err = ESP_OK;
#if CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE
        replay_err = nuwax_offline_audio_replay_test_start();
#elif CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_FORMAL_ENABLE
        /* Production replay is intentionally asynchronous.  The connection
         * owner must remain responsive while a large SD archive waits for
         * per-chunk persistence ACKs. */
        replay_err = nuwax_offline_audio_replay_formal_start(ws, epoch);
#else
        replay_err = ESP_ERR_NOT_SUPPORTED;
        ESP_LOGI(TAG,
                 "offline archive replay disabled; ready archives retained");
#endif
        if (replay_err == ESP_OK) {
            s_offline_replay_backoff_ms = nuwax_sd_session_monitoring() ? 100U : 5000U;
            s_offline_replay_next_attempt_ms = replay_now_ms +
                                               s_offline_replay_backoff_ms;
        } else if (replay_err == ESP_ERR_NOT_SUPPORTED) {
            /* A disabled replay route must not close the normal connection. */
            s_offline_replay_next_attempt_ms = replay_now_ms + 1000U;
        } else {
            if (s_offline_replay_backoff_ms == 0U) {
                s_offline_replay_backoff_ms = 1000U;
            } else if (s_offline_replay_backoff_ms < 30000U / 2U) {
                s_offline_replay_backoff_ms *= 2U;
            } else {
                s_offline_replay_backoff_ms = 30000U;
            }
            s_offline_replay_next_attempt_ms = replay_now_ms +
                                               s_offline_replay_backoff_ms;
            ESP_LOGW(TAG,
                     "offline archive replay deferred epoch=%lu err=%s",
                     (unsigned long)epoch, esp_err_to_name(replay_err));
        }
    }

}

static esp_err_t service_offline_audio_handoff(nuwax_ws_client_t *ws)
{
    if (!ws || !nuwax_ws_is_connected(ws)) {
        return ESP_ERR_INVALID_STATE;
    }
#if CONFIG_NUWAX_SD_SESSION_ENABLE
    if (nuwax_sd_session_active()) {
        nuwax_sd_session_network(true);
        service_offline_audio_replay(ws);
        return ESP_OK;
    }
#endif
    (void)service_offline_duration_limit();
    const uint32_t epoch = nuwax_ws_connection_epoch(ws);
    const bool cancel_to_sleep = atomic_load_explicit(
        &s_offline_mode_cancel_to_sleep, memory_order_acquire);
    const bool capture_pending =
        offline_mode_lease_pending() ||
        nuwax_offline_audio_capture_running() ||
        nuwax_offline_audio_is_active();
    if (!capture_pending && !nuwax_offline_audio_has_ready() &&
        !cancel_to_sleep) {
        return ESP_OK;
    }

    if (nuwax_offline_audio_capture_running() &&
        (!offline_mode_lease_pending() || !offline_mode_identity()->resuming || cancel_to_sleep)) {
        const esp_err_t stop_err = nuwax_offline_audio_request_stop(false);
        const bool owner_still_active = nuwax_offline_audio_capture_running();
        if (owner_still_active) {
            ESP_LOGW(TAG,
                     "offline audio handoff waiting for SD owner stop err=%s capture=%d active=%d",
                     esp_err_to_name(stop_err),
                     nuwax_offline_audio_capture_running() ? 1 : 0,
                     nuwax_offline_audio_is_active() ? 1 : 0);
            return stop_err == ESP_OK ? ESP_ERR_NOT_FINISHED : stop_err;
        }
        if (stop_err != ESP_OK) {
            /* Degraded archives remain replayable and must not permanently
             * fence conversation or mode restoration after the physical MIC
             * and FILE owners have converged. */
            atomic_store_explicit(&s_offline_mode_capture_failed, true,
                                  memory_order_release);
            ESP_LOGW(TAG,
                     "offline audio owner stopped with degraded archive err=%s; continuing reconnect handoff",
                     esp_err_to_name(stop_err));
        }
    }

    if (s_offline_mode_capture_started && !nuwax_offline_audio_capture_running()) {
        offline_mode_identity()->next_capture_sequence =
            nuwax_offline_audio_next_capture_sequence();
        s_offline_mode_capture_started = false;
    }

    service_offline_audio_replay(ws);

    /* Replay owns only the archive sink and a bounded transport budget. It
     * must never gate re-admission of a live meeting/monitoring capture. The
     * realtime uplink has priority; replay yields whenever new frames arrive. */
    if (nuwax_offline_audio_replay_running()) {
        ESP_LOGD(TAG, "offline archive replay running in background; realtime mode may resume");
    }

    if (!offline_mode_lease_pending()) {
        if (atomic_exchange_explicit(&s_offline_mode_cancel_to_sleep, false,
                                     memory_order_acq_rel)) {
            atomic_store_explicit(&s_offline_mode_capture_failed, false,
                                  memory_order_release);
            reset_offline_capture_retry_state();
            s_offline_mode_restore_request_epoch = 0U;
            s_offline_mode_restore_next_attempt_ms = 0U;
            s_offline_mode_restore_started_ms = 0U;
            enter_sleeping_conversation_state("offline_mode_cancelled");
        }
        return ESP_OK;
    }
    if (!offline_mode_identity()->resuming) {
        /* An explicit rejection/stop ended the user's recovery intent. */
        offline_mode_lease_store(false);
        s_offline_mode_restore_started_ms = 0U;
        s_offline_mode_restore_request_epoch = 0U;
        s_offline_mode_restore_next_attempt_ms = 0U;
        return ESP_OK;
    }
    const bool controller_claimed =
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING
            ? (nuwax_monitoring_mode_state(&s_monitoring_mode) !=
                   NUWAX_MONITORING_STATE_DISABLED ||
               nuwax_monitoring_mode_has_pending(&s_monitoring_mode))
            : (nuwax_meeting_mode_state(&s_meeting_mode) !=
                   NUWAX_MEETING_STATE_DISABLED ||
               nuwax_meeting_mode_has_pending(&s_meeting_mode));
    if (controller_claimed) {
        /* STARTING or queued commands are not successful MIC ownership.
         * The ACTIVE callback commits the lease. Let the controller run. */
        return ESP_ERR_NOT_FINISHED;
    }
    const uint32_t restore_now_ms = monotonic_ms();
    if (s_offline_mode_restore_request_epoch != epoch) {
        s_offline_mode_restore_request_epoch = epoch;
        s_offline_mode_restore_next_attempt_ms = 0U;
        s_offline_mode_restore_started_ms = restore_now_ms;
    }
    if (s_offline_mode_restore_started_ms != 0U &&
        elapsed_ms(restore_now_ms,
                   s_offline_mode_restore_started_ms +
                       NUWAX_OFFLINE_MODE_RESTORE_TIMEOUT_MS)) {
        const nuwax_audio_runtime_memory_t memory =
            exclusive_audio_memory_snapshot();
        const nuwax_audio_runtime_memory_state_t memory_state =
            nuwax_audio_runtime_memory_classify(memory);
        ESP_LOGE(TAG,
                 "offline mode lease restore timed out mode=%s epoch=%lu timeout_ms=%u memory_state=%d internal=%u largest=%u dma_largest=%u",
                 offline_mode_kind() ==
                         NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                     ? "monitoring"
                     : "meeting",
                 (unsigned long)epoch,
                 (unsigned)NUWAX_OFFLINE_MODE_RESTORE_TIMEOUT_MS,
                 (int)memory_state,
                 (unsigned)memory.internal_free,
                 (unsigned)memory.internal_largest,
                 (unsigned)memory.dma_largest);
        if (memory_state == NUWAX_AUDIO_RUNTIME_MEMORY_CRITICAL) {
            (void)nuwax_device_error_report_enqueue(
                "error", "audio", "exclusive_restore_memory_critical",
                ESP_ERR_NO_MEM, NULL, 0U, NULL);
            nuwax_diagnostics_log_heap_label(
                TAG, "exclusive_restore_memory_critical");
            vTaskDelay(pdMS_TO_TICKS(100));
            esp_restart();
            vTaskDelay(portMAX_DELAY);
        }
        offline_mode_lease_store(false);
        atomic_store_explicit(&s_offline_mode_cancel_to_sleep, false,
                              memory_order_release);
        atomic_store_explicit(&s_offline_mode_capture_failed, false,
                              memory_order_release);
        reset_offline_capture_retry_state();
        s_offline_mode_restore_request_epoch = 0U;
        s_offline_mode_restore_next_attempt_ms = 0U;
        s_offline_mode_restore_started_ms = 0U;
        enter_sleeping_conversation_state("offline_mode_restore_timeout");
        nuwax_audio_mode_identity_clear(offline_mode_identity());
        return ESP_ERR_TIMEOUT;
    }
    if (s_offline_mode_restore_request_epoch == epoch &&
        s_offline_mode_restore_next_attempt_ms != 0U &&
        !elapsed_ms(restore_now_ms,
                    s_offline_mode_restore_next_attempt_ms)) {
        return ESP_ERR_NOT_FINISHED;
    }
    const nuwax_audio_runtime_memory_t restore_memory =
        exclusive_audio_memory_snapshot();
    if (nuwax_audio_runtime_memory_classify(restore_memory) !=
        NUWAX_AUDIO_RUNTIME_MEMORY_READY) {
        s_offline_mode_restore_next_attempt_ms =
            restore_now_ms + NUWAX_OFFLINE_MODE_RESTORE_RETRY_MS;
        ESP_LOGW(TAG,
                 "offline mode lease restore waiting for audio memory mode=%s epoch=%lu internal=%u largest=%u dma_largest=%u",
                 offline_mode_kind() ==
                         NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                     ? "monitoring"
                     : "meeting",
                 (unsigned long)epoch,
                 (unsigned)restore_memory.internal_free,
                 (unsigned)restore_memory.internal_largest,
                 (unsigned)restore_memory.dma_largest);
        (void)nuwax_device_warning_report_enqueue(
            "audio", "exclusive_restore_memory_deferred", ESP_ERR_NO_MEM,
            NULL, 0U, NULL);
        return ESP_ERR_NOT_FINISHED;
    }
    esp_err_t restore_err;
    if (offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING) {
        restore_err = nuwax_monitoring_mode_request_ui(
            &s_monitoring_mode, ws, true);
    } else {
        restore_err = nuwax_meeting_mode_request_ui(
            &s_meeting_mode, ws, true);
    }
    s_offline_mode_restore_request_epoch = epoch;
    s_offline_mode_restore_next_attempt_ms =
        restore_now_ms + NUWAX_OFFLINE_MODE_RESTORE_RETRY_MS;
    const bool claimed_after_request =
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING
            ? (nuwax_monitoring_mode_state(&s_monitoring_mode) !=
                   NUWAX_MONITORING_STATE_DISABLED ||
               nuwax_monitoring_mode_has_pending(&s_monitoring_mode))
            : (nuwax_meeting_mode_state(&s_meeting_mode) !=
                   NUWAX_MEETING_STATE_DISABLED ||
               nuwax_meeting_mode_has_pending(&s_meeting_mode));
    if (restore_err == ESP_OK && claimed_after_request) {
        ESP_LOGI(TAG,
                 "offline mode restore awaiting capture mode=%s epoch=%lu",
                 offline_mode_kind() ==
                         NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                     ? "monitoring"
                     : "meeting",
                 (unsigned long)epoch);
    } else if (restore_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "offline mode lease restore deferred mode=%s err=%s",
                 offline_mode_kind() ==
                         NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                     ? "monitoring"
                     : "meeting",
                 esp_err_to_name(restore_err));
    }
    return restore_err == ESP_OK ? ESP_ERR_NOT_FINISHED : restore_err;
}
#endif

static bool is_normal_audio_event(nuwax_session_event_t event) {
    switch (event) {
        case NUWAX_SESSION_EVENT_AUDIO_PROGRESS:
        case NUWAX_SESSION_EVENT_ASR_PARTIAL:
        case NUWAX_SESSION_EVENT_ASR_FINAL:
        case NUWAX_SESSION_EVENT_ASR_RESULT:
        case NUWAX_SESSION_EVENT_TEXT_RESPONSE:
        case NUWAX_SESSION_EVENT_TTS_RESULT:
        case NUWAX_SESSION_EVENT_TTS_SKIP:
        case NUWAX_SESSION_EVENT_PLAYBACK_BEGIN:
        case NUWAX_SESSION_EVENT_PLAYBACK_END:
            return true;
        case NUWAX_SESSION_EVENT_NONE:
        default:
            return false;
    }
}

static bool session_command_is_notification_control(
    const nuwax_session_command_t *command) {
    if (!command) {
        return false;
    }
    if (command->has_event &&
        (command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN ||
         command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_END)) {
        return true;
    }
    if (!command->has_command) {
        return false;
    }
    /* stop_playback is the first half of the awake notification handoff and
     * must share the same urgent FIFO as prepare/begin/end. */
    return strcmp(command->command, "stop_playback") == 0 ||
           strcmp(command->command, "prepare_notify_playback") == 0;
}

static bool preserve_filtered_text_response_emotion(
    const nuwax_session_command_t *command,
    const char *source) {
    if (!command || !command->has_event ||
        command->event != NUWAX_SESSION_EVENT_TEXT_RESPONSE ||
        !command->ok || command->emotion[0] == '\0') {
        return false;
    }
    const bool accepted = apply_semantic_emotion_name(
        command->emotion,
        source ? source : "filtered_text_response");
    ESP_LOGI(TAG,
             "preserved semantic emotion from filtered text response emotion=%s source=%s accepted=%d",
             command->emotion,
             source ? source : "-",
             accepted ? 1 : 0);
    return accepted;
}

static void discard_session_queue_at_audio_mode_boundary(const char *reason) {
    if (!s_session_commands) {
        return;
    }
    uint32_t dropped = 0;
    uint32_t preserved_emotions = 0;
    nuwax_session_command_envelope_t stale = {0};
    while (xQueueReceive(s_session_commands, &stale, 0) == pdTRUE) {
        nuwax_session_command_t *command = &stale.command;
        dropped++;
        if (command->has_command &&
            strcmp(command->command, "set_emotion") == 0 &&
            command->emotion[0] != '\0') {
            const bool accepted =
                apply_semantic_emotion_name(command->emotion,
                                            "mode_boundary");
            if (accepted) {
                preserved_emotions++;
            }
            uint32_t active_epoch = 0U;
            nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
            if (ws && active_epoch == stale.ws_connection_epoch &&
                command->request_id[0] != '\0') {
                ESP_ERROR_CHECK_WITHOUT_ABORT(
                    nuwax_session_send_command_ack(ws,
                                                   command->request_id,
                                                   command->command,
                                                   accepted,
                                                   accepted
                                                       ? command->emotion
                                                       : "unsupported emotion"));
            }
        } else if (preserve_filtered_text_response_emotion(
                       command,
                       "mode_boundary_text_response")) {
            preserved_emotions++;
        }
        memset(&stale, 0, sizeof(stale));
    }
    if (dropped > 0U) {
        ESP_LOGI(TAG,
                 "audio mode boundary discarded queued session messages=%lu preserved_emotions=%lu reason=%s",
                 (unsigned long)dropped,
                 (unsigned long)preserved_emotions,
                 reason ? reason : "boundary");
    }
}

/* A queue item produced by an old WebSocket must never be consumed after the
 * persistent client object has been rebound to a new connection.  Epoch
 * checks at the consumer are the primary guard; this boundary purge also
 * removes items that were already waiting when RX teardown began. */
static void discard_connection_bound_queues(const char *reason) {
    clear_tts_skip_prebound_emotion("ws_boundary");
    uint32_t session_dropped = 0U;
    uint32_t notification_dropped = 0U;
    uint32_t critical_dropped = 0U;
    uint32_t p3_dropped = 0U;
    uint32_t p5_dropped = 0U;
    portENTER_CRITICAL(&s_notification_rx_barrier_lock);
    nuwax_notification_rx_barrier_reset(&s_notification_rx_barrier);
    portEXIT_CRITICAL(&s_notification_rx_barrier_lock);
    if (s_notification_transaction.active) {
        const bool origin_sleeping =
            s_notification_transaction.origin_sleeping;
        ESP_LOGW(TAG,
                 "discarding notification transaction at connection boundary token=%lu epoch=%lu notify=%s playback=%s reason=%s",
                 (unsigned long)s_notification_transaction.token,
                 (unsigned long)s_notification_transaction.ws_epoch,
                 s_notification_transaction.notify_id[0]
                     ? s_notification_transaction.notify_id
                     : "-",
                 s_notification_transaction.playback_id[0]
                     ? s_notification_transaction.playback_id
                     : "-",
                 reason ? reason : "boundary");
        reset_notification_transaction_runtime();
        notification_restore_sleep_or_listen(
            origin_sleeping,
            reason ? reason : "notification_connection_boundary");
    }
    if (s_session_commands) {
        session_dropped = (uint32_t)uxQueueMessagesWaiting(s_session_commands);
        (void)xQueueReset(s_session_commands);
    }
    if (s_session_notification_commands) {
        notification_dropped = (uint32_t)uxQueueMessagesWaiting(
            s_session_notification_commands);
        (void)xQueueReset(s_session_notification_commands);
    }
    if (s_session_critical_commands) {
        critical_dropped = (uint32_t)uxQueueMessagesWaiting(
            s_session_critical_commands);
        (void)xQueueReset(s_session_critical_commands);
    }
    if (s_p3_softref_ab_requests) {
        p3_dropped = (uint32_t)uxQueueMessagesWaiting(s_p3_softref_ab_requests);
        (void)xQueueReset(s_p3_softref_ab_requests);
    }
    if (s_p5_during_playback_candidate_requests) {
        p5_dropped = (uint32_t)uxQueueMessagesWaiting(
            s_p5_during_playback_candidate_requests);
        (void)xQueueReset(s_p5_during_playback_candidate_requests);
    }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    inhibit_sleep_wake_word_detector(
        reason ? reason : "connection_boundary");
    nuwax_wake_word_detector_request_stop();
    if (s_wake_word_events) {
        (void)xQueueReset(s_wake_word_events);
    }
#endif
    clear_wake_interrupt_cancel(
        reason ? reason : "connection_boundary");
    clear_touch_cancel_recovery(
        reason ? reason : "connection_boundary");
#if CONFIG_NUWAX_SPEAKER_ENABLE
    uint32_t speaker_dropped = 0U;
    if (s_speaker_owner_events) {
        speaker_dropped = (uint32_t)uxQueueMessagesWaiting(
            s_speaker_owner_events);
        (void)xQueueReset(s_speaker_owner_events);
    }
    portENTER_CRITICAL(&s_speaker_owner_overflow_lock);
    s_speaker_owner_event_overflow_epoch = 0U;
    s_speaker_owner_event_overflow_generation = 0U;
    portEXIT_CRITICAL(&s_speaker_owner_overflow_lock);
    portENTER_CRITICAL(&s_speaker_ingress_lock);
    s_speaker_ingress_pending = false;
    s_speaker_ingress_epoch = 0U;
    s_speaker_ingress_generation = 0U;
    portEXIT_CRITICAL(&s_speaker_ingress_lock);
    atomic_store_explicit(&s_pending_speaker_start_generation,
                          0U,
                          memory_order_release);
    atomic_store_explicit(&s_reported_speaker_fault_generation,
                          0U,
                          memory_order_release);
    s_deferred_speaker_start_valid = false;
    memset(&s_deferred_speaker_start_event,
           0,
           sizeof(s_deferred_speaker_start_event));
    s_deferred_speaker_start_epoch = 0U;
    nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);
#endif
    memset(&s_acceptance_capture_next, 0, sizeof(s_acceptance_capture_next));
    if (session_dropped || notification_dropped || critical_dropped ||
        p3_dropped || p5_dropped
#if CONFIG_NUWAX_SPEAKER_ENABLE
        || speaker_dropped
#endif
    ) {
        ESP_LOGI(TAG,
                 "discarded connection-bound queues reason=%s progress=%lu notification=%lu critical=%lu p3=%lu p5=%lu"
#if CONFIG_NUWAX_SPEAKER_ENABLE
                 " speaker=%lu"
#endif
                 ,
                 reason ? reason : "boundary",
                 (unsigned long)session_dropped,
                 (unsigned long)notification_dropped,
                 (unsigned long)critical_dropped,
                 (unsigned long)p3_dropped,
                 (unsigned long)p5_dropped
#if CONFIG_NUWAX_SPEAKER_ENABLE
                 ,
                 (unsigned long)speaker_dropped
#endif
        );
    }
}

#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
static bool cancel_offline_mode_lease(nuwax_offline_audio_mode_t mode,
                                      bool return_to_sleep,
                                      const char *reason)
{
    if (!offline_mode_lease_pending() ||
        offline_mode_kind() != mode) {
        return false;
    }
    bool expected = true;
    if (!atomic_compare_exchange_strong_explicit(
            &s_offline_mode_resume_pending, &expected, false,
            memory_order_acq_rel, memory_order_acquire)) {
        return false;
    }
    if (return_to_sleep) {
        atomic_store_explicit(&s_offline_mode_cancel_to_sleep, true,
                              memory_order_release);
    }
    atomic_store_explicit(&s_offline_mode_capture_failed, false,
                          memory_order_release);
    reset_offline_capture_retry_state();
    (void)nuwax_offline_audio_request_stop(false);
    nuwax_audio_mode_identity_clear(offline_mode_identity());
    s_offline_mode_capture_started = false;
    ESP_LOGI(TAG,
             "offline mode lease cancelled mode=%s return_to_sleep=%d reason=%s",
             mode == NUWAX_OFFLINE_AUDIO_MODE_MONITORING ? "monitoring"
                                                         : "meeting",
             return_to_sleep ? 1 : 0,
             reason ? reason : "cloud_control");
    return true;
}
#endif

static bool prepare_exclusive_audio_cloud_handoff(
    nuwax_ws_client_t *ws,
    const char *payload,
    int len) {
    nuwax_monitoring_protocol_event_t monitoring = {0};
    if (nuwax_monitoring_protocol_parse(payload, len, &monitoring)) {
        if (monitoring.type != NUWAX_MONITORING_PROTOCOL_EVENT_SET_COMMAND) {
            return true;
        }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        if (!monitoring.enabled) {
            (void)cancel_offline_mode_lease(
                NUWAX_OFFLINE_AUDIO_MODE_MONITORING, true,
                "cloud_monitoring_disable");
            return true;
        }
        (void)cancel_offline_mode_lease(
            NUWAX_OFFLINE_AUDIO_MODE_MEETING, false,
            "superseded_by_monitoring");
#else
        if (!monitoring.enabled) {
            return true;
        }
#endif
        const esp_err_t handoff_err =
            nuwax_meeting_mode_request_handoff_stop(
                &s_meeting_mode, ws, "superseded_by_monitoring");
        if (handoff_err == ESP_OK) {
            return true;
        }
        ESP_LOGE(TAG,
                 "monitoring enable could not stop meeting owner request=%s err=%s",
                 monitoring.request_id,
                 esp_err_to_name(handoff_err));
        if (monitoring.request_id[0]) {
            (void)nuwax_monitoring_protocol_send_command_ack(
                ws,
                monitoring.request_id,
                true,
                false,
                "mode_handoff_failed");
        }
        return false;
    }

    nuwax_meeting_protocol_event_t meeting = {0};
    if (!nuwax_meeting_protocol_parse(payload, len, &meeting) ||
        meeting.type != NUWAX_MEETING_PROTOCOL_EVENT_SET_COMMAND) {
        return true;
    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (strcmp(meeting.state, "enabled") != 0) {
        (void)cancel_offline_mode_lease(
            NUWAX_OFFLINE_AUDIO_MODE_MEETING, true,
            "cloud_meeting_disable");
        return true;
    }
    (void)cancel_offline_mode_lease(
        NUWAX_OFFLINE_AUDIO_MODE_MONITORING, false,
        "superseded_by_meeting");
#else
    if (strcmp(meeting.state, "enabled") != 0) {
        return true;
    }
#endif
    const esp_err_t handoff_err =
        nuwax_monitoring_mode_request_handoff_stop(
            &s_monitoring_mode, ws, "superseded_by_meeting");
    if (handoff_err == ESP_OK) {
        return true;
    }
    ESP_LOGE(TAG,
             "meeting enable could not stop monitoring owner request=%s err=%s",
             meeting.request_id,
             esp_err_to_name(handoff_err));
    if (meeting.request_id[0]) {
        (void)nuwax_meeting_protocol_send_command_ack(
            ws,
            meeting.request_id,
            true,
            false,
            "mode_handoff_failed");
    }
    return false;
}

static __attribute__((noinline)) void on_ws_text_non_ota(
    const char *payload, int len, nuwax_ws_client_t *ws,
    uint32_t ws_connection_epoch);

static void on_ws_text(const char *payload, int len, void *user_ctx) {
    /* Budget before OTA and all ordinary parsers; no liveness refresh or
     * connection teardown for an over-budget text frame. */
    if (len <= 0 || !nuwax_json_resource_admit(payload, (size_t)len)) {
        ESP_LOGW(TAG, "inbound JSON resource budget rejected revision=json-resources-v1 bytes=%d", len);
        return;
    }
    nuwax_ws_client_t *ws = (nuwax_ws_client_t *)user_ctx;
    const uint32_t ws_connection_epoch =
        ws != NULL ? nuwax_ws_connection_epoch(ws) : 0U;
    if (!ws || ws_connection_epoch == 0U) {
        ESP_LOGE(TAG, "WebSocket text callback has no connection binding");
        return;
    }
    portENTER_CRITICAL(&s_post_end_boundary_lock);
    atomic_fetch_add_explicit(&s_ws_text_callbacks_active,
                              1U,
                              memory_order_release);
    portEXIT_CRITICAL(&s_post_end_boundary_lock);
#if CONFIG_NUWAX_OTA_ENABLE
    /* OTA v1 intentionally omits the ordinary device-command request_id.
     * Its dedicated parser enforces the complete, closed OTA envelope. */
    if (nuwax_ota_device_handle_text(payload, len,
                                     ws_connection_epoch)) {
        ws_mark_application_activity();
        portENTER_CRITICAL(&s_post_end_boundary_lock);
        atomic_fetch_sub_explicit(&s_ws_text_callbacks_active,
                                  1U,
                                  memory_order_release);
        portEXIT_CRITICAL(&s_post_end_boundary_lock);
        return;
    }
#endif
    on_ws_text_non_ota(payload, len, ws, ws_connection_epoch);
    portENTER_CRITICAL(&s_post_end_boundary_lock);
    atomic_fetch_sub_explicit(&s_ws_text_callbacks_active,
                              1U,
                              memory_order_release);
    portEXIT_CRITICAL(&s_post_end_boundary_lock);
}

/* Keep the ordinary session command envelope out of the lightweight OTA
 * dispatch frame. Some OTA replies synchronously traverse the TLS send path. */
static __attribute__((noinline)) void on_ws_text_non_ota(
    const char *payload, int len, nuwax_ws_client_t *ws,
    uint32_t ws_connection_epoch) {
    if (!nuwax_session_validate_text_frame(payload, len)) {
        ESP_LOGE(TAG,
                 "invalid inbound WebSocket text dropped bytes=%d epoch=%lu; transport retained and application liveness not refreshed",
                 len,
                 (unsigned long)ws_connection_epoch);
        return;
    }
    const nuwax_cloud_message_kind_t cloud_message =
        nuwax_session_classify_cloud_message(payload, len);
    if (cloud_message == NUWAX_CLOUD_MESSAGE_PROVISION_REQUIRED) {
        nuwax_session_handle_text(payload, len, NULL);
        if (!mark_cloud_provision_required_if_epoch(ws_connection_epoch)) {
            ESP_LOGW(TAG,
                     "stale cloud provisioning rejection ignored epoch=%lu active_epoch=%lu",
                     (unsigned long)ws_connection_epoch,
                     (unsigned long)nuwax_ws_connection_epoch(ws));
            return;
        }
        ESP_LOGE(TAG,
                 "cloud reports device binding missing epoch=%lu; connection owner will start one BLE rebind transaction",
                 (unsigned long)ws_connection_epoch);
        (void)nuwax_ws_close_if_epoch(
            ws, ws_connection_epoch, NUWAX_WS_CLOSE_CAUSE_AUTH_REJECTED);
        return;
    }
    if (cloud_message == NUWAX_CLOUD_MESSAGE_HELLO_REJECTED ||
        cloud_message == NUWAX_CLOUD_MESSAGE_AUTH_REJECTED) {
        nuwax_session_handle_text(payload, len, NULL);
        if (!mark_cloud_auth_failed_if_epoch(ws_connection_epoch)) {
            ESP_LOGW(TAG,
                     "stale cloud authentication rejection ignored kind=%s epoch=%lu active_epoch=%lu",
                     cloud_message_kind_name(cloud_message),
                     (unsigned long)ws_connection_epoch,
                     (unsigned long)nuwax_ws_connection_epoch(ws));
            return;
        }
        ESP_LOGE(TAG,
                 "cloud rejected application authentication kind=%s epoch=%lu",
                 cloud_message_kind_name(cloud_message),
                 (unsigned long)ws_connection_epoch);
        if (cloud_message == NUWAX_CLOUD_MESSAGE_AUTH_REJECTED) {
            (void)mark_cloud_provision_required_if_epoch(ws_connection_epoch);
        }
        (void)nuwax_ws_close_if_epoch(
            ws, ws_connection_epoch, NUWAX_WS_CLOSE_CAUSE_AUTH_REJECTED);
        return;
    }
    if (cloud_message == NUWAX_CLOUD_MESSAGE_PONG) {
        nuwax_ws_note_heartbeat_if_epoch(ws, ws_connection_epoch);
    }
    if (cloud_message_is_positive(cloud_message)) {
        ws_mark_application_activity();
    }
    note_positive_cloud_activity(cloud_message, ws_connection_epoch);
    if (cloud_message == NUWAX_CLOUD_MESSAGE_HELLO_OK) {
        return;
    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (nuwax_offline_audio_handle_protocol_text(payload, len,
                                                 ws_connection_epoch)) {
        ws_mark_application_activity();
        return;
    }
#endif
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_firmware_report_handle_text(payload, len,
                                          ws_connection_epoch)) {
        ws_mark_application_activity();
        return;
    }
#endif
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active() &&
        ota_reject_continuous_audio_control(payload, len)) {
        return;
    }
#endif
    if (!prepare_exclusive_audio_cloud_handoff(ws, payload, len)) {
        return;
    }
    if (nuwax_device_error_report_handle_ack(payload, len,
                                             ws_connection_epoch)) {
        ws_mark_application_activity();
        return;
    }
    if (nuwax_monitoring_mode_handle_protocol_text(&s_monitoring_mode,
                                                   ws,
                                                   payload,
                                                   len)) {
        ws_mark_application_activity();
        return;
    }
    if (nuwax_meeting_mode_handle_protocol_text(&s_meeting_mode,
                                                ws,
                                                payload,
                                                len)) {
        ws_mark_application_activity();
        return;
    }
    nuwax_session_command_t command = {0};
    nuwax_session_handle_text(payload, len, &command);
    if (command.has_event &&
        command.event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN) {
        if (!notification_rx_barrier_arm_epoch(ws_connection_epoch,
                                               command.notify_id,
                                               command.playback_id)) {
            ESP_LOGW(TAG,
                     "notification BEGIN conflicts with RX ordering barrier epoch=%lu notify=%s playback=%s; rejecting stream while retaining WebSocket",
                     (unsigned long)ws_connection_epoch,
                     command.notify_id[0] ? command.notify_id : "-",
                     command.playback_id[0] ? command.playback_id : "-");
            (void)send_notification_event_ack(
                ws,
                "notify_playback_begin_ack",
                command.request_id,
                command.notify_id,
                command.playback_id,
                false,
                 "notification stream overlap",
                 ws_connection_epoch);
            notification_rx_barrier_reject_epoch(
                ws_connection_epoch, "notification_stream_overlap");
            return;
        }
        ESP_LOGI(TAG,
                 "notification BEGIN RX barrier armed epoch=%lu notify=%s playback=%s",
                 (unsigned long)ws_connection_epoch,
                 command.notify_id[0] ? command.notify_id : "-",
                 command.playback_id[0] ? command.playback_id : "-");
    }
    if (command.has_command || command.has_mcp || command.has_event ||
        command.has_pong) {
        ws_mark_application_activity();
    }
    if (command.has_pong) {
        ws_mark_rx_activity();
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio() &&
        (command.has_command || command.has_mcp || command.has_event)) {
        if (command.has_event &&
            (command.event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN ||
             command.event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_END)) {
            (void)send_notification_event_ack(
                ws,
                command.event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN
                    ? "notify_playback_begin_ack"
                    : "notify_playback_end_ack",
                command.request_id,
                command.notify_id,
                command.playback_id,
                false,
                "OTA active",
                ws_connection_epoch);
            if (command.event ==
                NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN) {
                notification_rx_barrier_reject_epoch(
                    ws_connection_epoch, "ota_audio_isolation");
            }
        } else if (command.has_command &&
                   strcmp(command.command,
                          "prepare_notify_playback") == 0) {
            (void)nuwax_session_send_command_ack_until_if_epoch(
                ws,
                command.request_id,
                command.command,
                false,
                "OTA active",
                esp_timer_get_time() +
                    NUWAX_NOTIFICATION_ACK_SEND_TIMEOUT_US,
                ws_connection_epoch);
        }
        ESP_LOGI(TAG, "OTA quarantined normal cloud command/event");
        return;
    }
#endif
    if (exclusive_audio_mode_blocks_normal_audio() && command.has_event &&
        is_normal_audio_event(command.event)) {
        (void)preserve_filtered_text_response_emotion(
            &command,
            "exclusive_mode_rx");
        ESP_LOGI(TAG,
                 "exclusive audio mode quarantined normal session event=%d",
                 (int)command.event);
        return;
    }
    if (command.has_event &&
        command.event == NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
        if (!notification_rx_barrier_arm_normal_epoch(
                ws_connection_epoch,
                command.turn_id,
                command.playback_id)) {
            ESP_LOGW(TAG,
                     "normal playback BEGIN overlaps an unresolved audio stream epoch=%lu turn=%s playback=%s; quarantining ambiguous stream while retaining WebSocket",
                     (unsigned long)ws_connection_epoch,
                     command.turn_id[0] ? command.turn_id : "-",
                     command.playback_id[0] ? command.playback_id : "-");
            notification_rx_barrier_reject_epoch(
                ws_connection_epoch, "normal_notification_stream_overlap");
            /* Preserve the rejected BEGIN identity for owner-thread cleanup.
             * Dropping it here leaves an interaction pinned until 30s expiry. */
            command.rx_playback_rejected = true;
        }
    }
    if (queue_p3_softref_ab_fast(&command, ws_connection_epoch)) {
        return;
    }
    if (queue_p5_during_playback_candidate_fast(&command,
                                                 ws_connection_epoch)) {
        return;
    }
    if ((command.has_command || command.has_mcp || command.has_event) &&
        s_session_commands && s_session_critical_commands &&
        s_session_notification_commands) {
        const bool is_low_priority_progress =
            command.has_event &&
            (command.event == NUWAX_SESSION_EVENT_AUDIO_PROGRESS ||
             command.event == NUWAX_SESSION_EVENT_ASR_PARTIAL);
        const bool is_notification_control =
            session_command_is_notification_control(&command);
        QueueHandle_t target_queue = is_notification_control
                                         ? s_session_notification_commands
                                         : is_low_priority_progress
                                               ? s_session_commands
                                               : s_session_critical_commands;
        const nuwax_session_command_envelope_t envelope = {
            .ws_connection_epoch = ws_connection_epoch,
            .command = command,
        };
        if (xQueueSend(target_queue, &envelope, 0) != pdTRUE) {
            if (command.has_event &&
                command.event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN) {
                notification_rx_barrier_reject_epoch(
                    ws_connection_epoch, "notification_begin_queue_full");
            } else if (command.has_event &&
                       command.event ==
                           NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
                notification_rx_barrier_reject_normal_epoch(
                    ws_connection_epoch,
                    command.turn_id,
                    command.playback_id,
                    "normal_playback_begin_queue_full");
            }
            if (command.has_command &&
                strcmp(command.command, "set_emotion") == 0 &&
                command.emotion[0] != '\0') {
                const bool sleeping =
                    conversation_state_current() == NUWAX_APP_STATE_SLEEPING;
                const bool accepted = sleeping
                                          ? apply_sleep_cloud_emotion_name(
                                                command.emotion,
                                                "queue_full_sleep")
                                          : apply_semantic_emotion_name(
                                                command.emotion,
                                                "session_queue_full");
                ESP_LOGW(TAG,
                         "session queue full but semantic emotion was preserved emotion=%s sleep_lease=%d accepted=%d",
                         command.emotion,
                         sleeping ? 1 : 0,
                         accepted ? 1 : 0);
            }
            if (is_low_priority_progress) {
                static uint32_t dropped_progress_events;
                dropped_progress_events++;
                if (dropped_progress_events == 1U ||
                    (dropped_progress_events % 50U) == 0U) {
                    ESP_LOGW(TAG,
                             "session progress queue full, dropped event=%d count=%lu",
                             (int)command.event,
                             (unsigned long)dropped_progress_events);
                }
            } else {
                ESP_LOGE(TAG,
                         "%s session queue full event=%d command=%s; closing bound epoch so transaction can be retried",
                         is_notification_control ? "notification" : "critical",
                         (int)command.event,
                         command.has_command ? command.command : "-");
                (void)nuwax_ws_request_close_if_epoch(ws,
                                                      ws_connection_epoch);
            }
        } else {
            notify_conversation_owner();
        }
    }
}

static bool notification_binary_batch_has_end(const uint8_t *payload,
                                              size_t payload_len) {
    if (!payload || payload_len == 0U) {
        return false;
    }
    size_t offset = 0U;
    while (offset < payload_len) {
        uint8_t codec = 0U;
        uint8_t flags = 0U;
        size_t frame_len = 0U;
        if (nuwax_audio_frame_peek(&payload[offset],
                                   payload_len - offset,
                                   &codec,
                                   &flags,
                                   &frame_len) != ESP_OK ||
            frame_len == 0U) {
            return false;
        }
        if ((flags & NUWAX_AUDIO_FLAG_END) != 0U) {
            return true;
        }
        offset += frame_len;
    }
    return false;
}

static nuwax_notification_rx_state_t wait_notification_rx_barrier(
    uint32_t ws_connection_epoch) {
    nuwax_notification_rx_state_t state =
        notification_rx_barrier_snapshot(ws_connection_epoch);
    if (state != NUWAX_NOTIFICATION_RX_PENDING &&
        state != NUWAX_NOTIFICATION_RX_NORMAL_PENDING) {
        return state;
    }

    const uint32_t started_ms = monotonic_ms();
    /* WebSocket callbacks preserve wire order, but text commands are handed
     * to the application owner while binary audio normally enters the speaker
     * immediately. Backpressure this one RX callback until the owner commits
     * or rejects BEGIN so BEGIN followed immediately by audio stays ordered. */
    ESP_LOGI(TAG,
             "playback binary waiting for ordered BEGIN commit epoch=%lu barrier_state=%d timeout_ms=%u",
             (unsigned long)ws_connection_epoch,
             (int)state,
             (unsigned)NUWAX_NOTIFICATION_RX_BARRIER_WAIT_MS);
    while ((state == NUWAX_NOTIFICATION_RX_PENDING ||
            state == NUWAX_NOTIFICATION_RX_NORMAL_PENDING) &&
           !elapsed_ms(monotonic_ms(),
                       started_ms + NUWAX_NOTIFICATION_RX_BARRIER_WAIT_MS)) {
        vTaskDelay(1U);
        state = notification_rx_barrier_snapshot(ws_connection_epoch);
    }
    if (state == NUWAX_NOTIFICATION_RX_PENDING ||
        state == NUWAX_NOTIFICATION_RX_NORMAL_PENDING) {
        notification_rx_barrier_reject_epoch(
            ws_connection_epoch, "playback_begin_commit_timeout");
        state = NUWAX_NOTIFICATION_RX_REJECTED;
    }
    ESP_LOGI(TAG,
             "playback binary BEGIN barrier resolved epoch=%lu state=%d waited_ms=%lu",
             (unsigned long)ws_connection_epoch,
             (int)state,
             (unsigned long)(monotonic_ms() - started_ms));
    return state;
}

static void on_ws_binary(const uint8_t *payload, int len, void *user_ctx) {
    nuwax_ws_client_t *ws = (nuwax_ws_client_t *)user_ctx;
    const uint32_t ws_connection_epoch = nuwax_ws_connection_epoch(ws);
    if (!payload || len <= 0) {
        return;
    }
    if (!ws || ws_connection_epoch == 0U) {
        ESP_LOGE(TAG, "WebSocket binary callback has no connection binding");
        return;
    }
    const nuwax_notification_rx_state_t notification_rx_state =
        wait_notification_rx_barrier(ws_connection_epoch);
    if (notification_rx_state == NUWAX_NOTIFICATION_RX_REJECTED) {
        static uint32_t rejected_notification_binary_epoch;
        static uint32_t rejected_notification_binary_batches;
        if (rejected_notification_binary_epoch != ws_connection_epoch) {
            rejected_notification_binary_epoch = ws_connection_epoch;
            rejected_notification_binary_batches = 0U;
        }
        rejected_notification_binary_batches++;
        const bool end_seen = notification_binary_batch_has_end(
            payload, (size_t)len);
        if (rejected_notification_binary_batches == 1U || end_seen ||
            (rejected_notification_binary_batches % 50U) == 0U) {
            ESP_LOGW(TAG,
                     "rejected notification binary drained epoch=%lu bytes=%d batches=%lu end=%d",
                     (unsigned long)ws_connection_epoch,
                     len,
                     (unsigned long)rejected_notification_binary_batches,
                     end_seen ? 1 : 0);
        }
        if (end_seen) {
            notification_rx_barrier_reset_epoch(ws_connection_epoch);
            rejected_notification_binary_epoch = 0U;
            rejected_notification_binary_batches = 0U;
        }
        return;
    }

#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio()) {
        return;
    }
#endif

    /* Do not let a delayed normal TTS packet create a new speaker generation
     * after an exclusive mode has taken ownership. The local fade/cancel request
     * handles audio already in the output queue; this gate handles packets
     * that arrive after the cancel request. */
    if (exclusive_audio_mode_blocks_normal_audio()) {
        static uint32_t blocked_binary_frames;
        blocked_binary_frames++;
        if (blocked_binary_frames == 1U || (blocked_binary_frames % 50U) == 0U) {
            ESP_LOGI(TAG,
                     "exclusive audio mode dropped normal playback binary bytes=%d count=%lu",
                     len,
                     (unsigned long)blocked_binary_frames);
        }
        return;
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!atomic_load_explicit(&s_normal_downlink_allowed,
                              memory_order_acquire)) {
        static uint32_t unowned_binary_epoch;
        static uint32_t unowned_binary_frames;
        const uint32_t closed_admission_epoch = (uint32_t)
            atomic_load_explicit(&s_normal_downlink_epoch,
                                 memory_order_acquire);
        if (unowned_binary_epoch != closed_admission_epoch) {
            unowned_binary_epoch = closed_admission_epoch;
            unowned_binary_frames = 0U;
        }
        unowned_binary_frames++;
        if (unowned_binary_frames == 1U) {
            ESP_LOGW(TAG,
                     "late normal playback binary dropped after admission closed bytes=%d admission_epoch=%lu",
                     len,
                     (unsigned long)closed_admission_epoch);
        } else if ((unowned_binary_frames % 256U) == 0U) {
            ESP_LOGI(TAG,
                     "late normal playback binary still draining admission_epoch=%lu dropped=%lu",
                     (unsigned long)closed_admission_epoch,
                     (unsigned long)unowned_binary_frames);
        }
        return;
    }
    const uint_fast32_t binary_batch_epoch =
        atomic_load_explicit(&s_normal_downlink_epoch, memory_order_acquire);
    const uint32_t binary_batch_admission_deadline_ms =
        monotonic_ms() + NUWAX_SPEAKER_BINARY_BATCH_ADMISSION_BUDGET_MS;
#endif

    size_t offset = 0;
    uint32_t parsed_frames = 0;
    const size_t total_len = (size_t)len;
    while (offset < total_len) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (!atomic_load_explicit(&s_normal_downlink_allowed,
                                  memory_order_acquire) ||
            atomic_load_explicit(&s_normal_downlink_epoch,
                                 memory_order_acquire) != binary_batch_epoch) {
            ESP_LOGI(TAG,
                     "normal playback binary batch invalidated during parse offset=%u bytes=%d",
                     (unsigned)offset,
                     len);
            return;
        }
#endif
        uint8_t codec = 0;
        uint8_t flags = 0;
        size_t frame_len = 0;
        esp_err_t err = nuwax_audio_frame_peek(&payload[offset],
                                               total_len - offset,
                                               &codec,
                                               &flags,
                                               &frame_len);
        if (err != ESP_OK || frame_len == 0) {
            ESP_LOGE(TAG,
                     "RX binary bytes=%d offset=%u parsed=%lu malformed audio frame=%s; aborting current playback while retaining WebSocket",
                     len,
                     (unsigned)offset,
                     (unsigned long)parsed_frames,
                     esp_err_to_name(err));
#if CONFIG_NUWAX_SPEAKER_ENABLE
            report_current_speaker_ingress_fault(ws_connection_epoch,
                                                 err,
                                                 "malformed_binary");
#endif
            return;
        }

        if (codec != NUWAX_AUDIO_CODEC_PCM16) {
            ESP_LOGE(TAG,
                     "RX audio unsupported codec=%u offset=%u frame_len=%u flags=0x%02x; aborting current playback while retaining WebSocket",
                     (unsigned)codec,
                     (unsigned)offset,
                     (unsigned)frame_len,
                     flags);
#if CONFIG_NUWAX_SPEAKER_ENABLE
            report_current_speaker_ingress_fault(ws_connection_epoch,
                                                 ESP_ERR_NOT_SUPPORTED,
                                                 "unsupported_codec");
#endif
            return;
        }

        const int16_t *samples = NULL;
        size_t sample_count = 0;
        uint32_t sequence = 0;
        uint16_t sample_rate = 0;
        uint8_t channels = 0;
        err = nuwax_audio_frame_parse_pcm16(&payload[offset],
                                            frame_len,
                                            &samples,
                                            &sample_count,
                                            &sequence,
                                            &sample_rate,
                                            &channels);
        if (err != ESP_OK) {
            ESP_LOGE(TAG,
                     "RX audio parse failed offset=%u frame_len=%u flags=0x%02x err=%s; aborting current playback while retaining WebSocket",
                     (unsigned)offset,
                     (unsigned)frame_len,
                     flags,
                     esp_err_to_name(err));
#if CONFIG_NUWAX_SPEAKER_ENABLE
            report_current_speaker_ingress_fault(ws_connection_epoch,
                                                 err,
                                                 "pcm_parse");
#endif
            return;
        }

#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (!atomic_load_explicit(&s_normal_downlink_allowed,
                                  memory_order_acquire) ||
            atomic_load_explicit(&s_normal_downlink_epoch,
                                 memory_order_acquire) != binary_batch_epoch) {
            ESP_LOGI(TAG,
                     "normal playback binary frame invalidated before enqueue seq=%u",
                     (unsigned)sequence);
            return;
        }
        const uint32_t admission_now_ms = monotonic_ms();
        const uint32_t admission_timeout_ms =
            elapsed_ms(admission_now_ms,
                       binary_batch_admission_deadline_ms)
                ? 0U
                : binary_batch_admission_deadline_ms - admission_now_ms;
        err = nuwax_speaker_playback_handle_audio_frame_admitted_with_timeout(
            ws_connection_epoch,
            (uint32_t)binary_batch_epoch,
            sequence,
            flags,
            sample_rate,
            channels,
            samples,
            sample_count,
            admission_timeout_ms);
        if (err == ESP_ERR_NOT_FOUND) {
            ESP_LOGW(TAG,
                     "orphan playback tail dropped seq=%u flags=0x%02x; current conversation turn retained",
                     (unsigned)sequence,
                     flags);
            offset += frame_len;
            parsed_frames++;
            continue;
        }
        if (err != ESP_OK) {
            ESP_LOGE(TAG,
                     "speaker enqueue failed seq=%u flags=0x%02x err=%s; generation-bound recovery retained WebSocket",
                     (unsigned)sequence,
                     flags,
                     esp_err_to_name(err));
            /* Stream protocol faults are published by speaker_playback with
             * their immutable generation. Failures before generation binding
             * are stale/unowned and must not invalidate a newer ASR turn. */
            report_current_speaker_ingress_fault(ws_connection_epoch,
                                                 err,
                                                 "speaker_enqueue");
            return;
        }
#endif
        if ((flags & (NUWAX_AUDIO_FLAG_START | NUWAX_AUDIO_FLAG_END)) != 0 ||
            (sequence % 50) == 0) {
            ESP_LOGI(TAG,
                     "RX audio seq=%u flags=0x%02x samples=%u sample_rate=%u channels=%u batch_index=%lu",
                     (unsigned)sequence,
                     flags,
                     (unsigned)sample_count,
                     sample_rate,
                     channels,
                     (unsigned long)parsed_frames);
        }
        offset += frame_len;
        parsed_frames++;
    }
    if (parsed_frames > 0U) {
        ws_mark_application_activity();
    }
}

static void shell_task(void *arg) {
    (void)arg;
    atomic_store_explicit(&s_ui_owner_task, xTaskGetCurrentTaskHandle(),
                          memory_order_release);
    uint32_t last_status_bar_ms = 0;
    while (true) {
        uint32_t now_ms = (uint32_t)(esp_timer_get_time() / 1000);
        service_reprovision_watchdog(now_ms);
        sync_pending_ui_state();
        sync_exclusive_audio_mode_ui_state();
        sync_pending_semantic_emotion();
        nuwax_app_shell_update(now_ms);
        if (nuwax_app_shell_is_menu_active()) {
            ui_owner_wait_ms(80U);
        } else {
            if (last_status_bar_ms == 0 || (uint32_t)(now_ms - last_status_bar_ms) >= NUWAX_STATUS_BAR_UI_INTERVAL_MS) {
                nuwax_app_shell_render_status_bar();
                last_status_bar_ms = now_ms;
            }
            nuwax_app_state_t state = conversation_state_current();
            uint32_t interval_ms =
                (state == NUWAX_APP_STATE_WIFI_CONNECTING || state == NUWAX_APP_STATE_WS_CONNECTING)
                    ? NUWAX_CONNECTING_UI_INTERVAL_MS
                    : NUWAX_FACE_UI_INTERVAL_MS;
            ui_owner_wait_ms(interval_ms);
        }
    }
}

static bool create_app_task(TaskFunction_t task,
                            const char *name,
                            uint32_t stack_bytes,
                            UBaseType_t priority,
                            TaskHandle_t *handle) {
    /* FreeRTOS requires the static TCB to stay in internal RAM; only the stack may live in PSRAM. */
    StaticTask_t *tcb = heap_caps_malloc(sizeof(StaticTask_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    StackType_t *stack = heap_caps_malloc(stack_bytes, MALLOC_CAP_SPIRAM);
    if (!tcb || !stack) {
        ESP_LOGE(TAG, "failed to alloc PSRAM for task name=%s", name);
        if (tcb) free(tcb);
        if (stack) free(stack);
        boot_fail_controlled_restart(name);
    }
    TaskHandle_t h = xTaskCreateStatic(task, name, stack_bytes, NULL, priority, stack, tcb);
    if (!h) {
        ESP_LOGE(TAG, "failed to create task name=%s", name);
        free(tcb); free(stack);
        boot_fail_controlled_restart(name);
    }
    if (handle) *handle = h;
    return true;
}

static bool create_app_task_internal(TaskFunction_t task,
                                     const char *name,
                                     uint32_t stack_bytes,
                                     UBaseType_t priority,
                                     TaskHandle_t *handle) {
    StaticTask_t *tcb = heap_caps_malloc(sizeof(StaticTask_t),
                                         MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    StackType_t *stack = heap_caps_malloc(stack_bytes,
                                          MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    if (!tcb || !stack) {
        ESP_LOGE(TAG, "failed to alloc internal RAM for task name=%s", name);
        if (tcb) free(tcb);
        if (stack) free(stack);
        boot_fail_controlled_restart(name);
    }
    TaskHandle_t h = xTaskCreateStatic(task, name, stack_bytes, NULL,
                                      priority, stack, tcb);
    if (!h) {
        ESP_LOGE(TAG, "failed to create internal-RAM task name=%s", name);
        free(tcb);
        free(stack);
        boot_fail_controlled_restart(name);
    }
    if (handle) *handle = h;
    return true;
}

static bool create_app_task_pinned(TaskFunction_t task,
                                   const char *name,
                                   uint32_t stack_bytes,
                                   UBaseType_t priority,
                                   BaseType_t core_id) {
    StaticTask_t *tcb = heap_caps_malloc(sizeof(StaticTask_t), MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    StackType_t *stack = heap_caps_malloc(stack_bytes, MALLOC_CAP_SPIRAM);
    if (!tcb || !stack) {
        ESP_LOGE(TAG, "failed to alloc PSRAM for task name=%s", name);
        if (tcb) free(tcb);
        if (stack) free(stack);
        boot_fail_controlled_restart(name);
    }
    TaskHandle_t h = xTaskCreateStaticPinnedToCore(task, name, stack_bytes, NULL, priority, stack, tcb, core_id);
    if (!h) {
        ESP_LOGE(TAG, "failed to create task name=%s", name);
        free(tcb); free(stack);
        boot_fail_controlled_restart(name);
    }
    return true;
}

static void set_wifi_result_from_current_link(const char *result_ssid,
                                              bool ok,
                                              const char *message) {
    nuwax_app_shell_set_wifi_result(result_ssid, ok, message);

    char actual_ssid[33] = {0};
    char actual_ip[16] = {0};
    if (nuwax_wifi_is_connected()) {
        (void)nuwax_wifi_get_status(actual_ssid, sizeof(actual_ssid),
                                    actual_ip, sizeof(actual_ip));
        if (!actual_ssid[0] && result_ssid && result_ssid[0]) {
            strlcpy(actual_ssid, result_ssid, sizeof(actual_ssid));
        }
        nuwax_app_shell_set_wifi_status(actual_ssid, actual_ip);
    } else {
        nuwax_app_shell_set_wifi_status("", "");
    }
}

static void wifi_scan_task(void *arg) {
    (void)arg;

    while (true) {
        ulTaskNotifyTake(pdTRUE, portMAX_DELAY);
        atomic_store_explicit(&s_wifi_scan_in_progress, true,
                              memory_order_release);
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            ESP_LOGI(TAG, "Wi-Fi scan discarded: BLE provisioning owns STA");
            atomic_store_explicit(&s_wifi_scan_in_progress, false,
                                  memory_order_release);
            portENTER_CRITICAL(&s_wifi_scan_request_lock);
            s_wifi_scan_request_active = false;
            s_wifi_scan_request_epoch = 0U;
            s_wifi_scan_request_id[0] = '\0';
            portEXIT_CRITICAL(&s_wifi_scan_request_lock);
            continue;
        }
        nuwax_app_shell_set_wifi_scan_busy();
        memset(&s_wifi_scan_work_report, 0, sizeof(s_wifi_scan_work_report));
        portENTER_CRITICAL(&s_wifi_scan_request_lock);
        s_wifi_scan_work_report.ws_connection_epoch =
            s_wifi_scan_request_epoch;
        strlcpy(s_wifi_scan_work_report.request_id,
                s_wifi_scan_request_id,
                sizeof(s_wifi_scan_work_report.request_id));
        portEXIT_CRITICAL(&s_wifi_scan_request_lock);
        int count = 0;
        esp_err_t err = nuwax_wifi_scan(s_wifi_scan_work_results, NUWAX_WIFI_MAX_SCAN_RESULTS, &count);
        atomic_store_explicit(&s_wifi_scan_in_progress, false,
                              memory_order_release);
        if (err != ESP_OK) {
            ESP_LOGW(TAG, "wifi scan failed: %s", esp_err_to_name(err));
            set_wifi_result_from_current_link("SCAN", false,
                                              esp_err_to_name(err));
            s_wifi_scan_work_report.ok = false;
            strlcpy(s_wifi_scan_work_report.message, esp_err_to_name(err), sizeof(s_wifi_scan_work_report.message));
            if (s_wifi_scan_results) {
                xQueueOverwrite(s_wifi_scan_results, &s_wifi_scan_work_report);
            }
            continue;
        }

        char ssids[NUWAX_WIFI_MAX_SCAN_RESULTS][33] = {0};
        int8_t rssis[NUWAX_WIFI_MAX_SCAN_RESULTS] = {0};
        uint8_t authmodes[NUWAX_WIFI_MAX_SCAN_RESULTS] = {0};
        for (int i = 0; i < count; i++) {
            strlcpy(ssids[i], s_wifi_scan_work_results[i].ssid, sizeof(ssids[i]));
            rssis[i] = s_wifi_scan_work_results[i].rssi;
            authmodes[i] = s_wifi_scan_work_results[i].authmode;
        }
        nuwax_app_shell_set_wifi_networks(ssids, rssis, authmodes, count);
        s_wifi_scan_work_report.ok = true;
        s_wifi_scan_work_report.count = count;
        strlcpy(s_wifi_scan_work_report.message, "ok", sizeof(s_wifi_scan_work_report.message));
        for (int i = 0; i < count; i++) {
            strlcpy(s_wifi_scan_work_report.ssids[i], ssids[i], sizeof(s_wifi_scan_work_report.ssids[i]));
            s_wifi_scan_work_report.rssis[i] = rssis[i];
            s_wifi_scan_work_report.authmodes[i] = authmodes[i];
        }
        if (s_wifi_scan_results) {
            xQueueOverwrite(s_wifi_scan_results, &s_wifi_scan_work_report);
        }
    }
}

static bool request_wifi_scan(uint32_t ws_epoch, const char *request_id) {
    if (request_id && request_id[0] != '\0' && ws_epoch == 0U) {
        ESP_LOGW(TAG,
                 "remote Wi-Fi scan rejected without WebSocket epoch request=%s",
                 request_id);
        return false;
    }
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        ESP_LOGI(TAG, "Wi-Fi scan ignored while BLE provisioning is active");
        return false;
    }
    if (!s_wifi_scan_task) {
        ESP_LOGW(TAG, "Wi-Fi scan task is not ready");
        return false;
    }
    bool accepted = false;
    portENTER_CRITICAL(&s_wifi_scan_request_lock);
    if (!s_wifi_scan_request_active) {
        s_wifi_scan_request_active = true;
        s_wifi_scan_request_epoch = ws_epoch;
        strlcpy(s_wifi_scan_request_id,
                request_id ? request_id : "",
                sizeof(s_wifi_scan_request_id));
        accepted = true;
    }
    portEXIT_CRITICAL(&s_wifi_scan_request_lock);
    if (!accepted) {
        ESP_LOGI(TAG,
                 "Wi-Fi scan request rejected busy request=%s",
                 request_id && request_id[0] ? request_id : "local");
        return false;
    }
    ESP_LOGI(TAG,
             "Wi-Fi scan requested request=%s epoch=%lu",
             request_id && request_id[0] ? request_id : "local",
             (unsigned long)ws_epoch);
    xTaskNotifyGive(s_wifi_scan_task);
    return true;
}

static void request_pc_status(nuwax_ws_client_t *ws) {
    if (!ws || !nuwax_ws_is_connected(ws)) {
        return;
    }
    char request_id[40];
    snprintf(request_id, sizeof(request_id), "pcstat_%lu", (unsigned long)++s_pc_status_request_seq);
    ESP_LOGI(TAG, "Sending pc_status_request id=%s", request_id);
    esp_err_t err = nuwax_session_send_pc_status_request(ws, request_id);
    if (err != ESP_OK) {
        ESP_LOGW(TAG, "PC status request failed: %s", esp_err_to_name(err));
    }
}

static bool request_cancel_turn(nuwax_ws_client_t *ws, const char *reason) {
    if (s_notification_transaction.active) {
        cancel_active_notification(ws,
                                   reason ? reason
                                          : "notification_touch_interrupt");
        return true;
    }
    if (s_touch_cancel_recovery.active) {
        ESP_LOGI(TAG,
                 "duplicate touch cancel ignored while recovery is active epoch=%lu generation=%lu turn=%s playback=%s",
                 (unsigned long)s_touch_cancel_recovery.ws_epoch,
                 (unsigned long)s_touch_cancel_recovery.speaker_generation,
                 s_touch_cancel_recovery.turn_id,
                 s_touch_cancel_recovery.playback_id);
        return false;
    }

    const uint32_t ws_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    char turn_to_cancel[sizeof(s_active_turn_id)] = {0};
    char playback_to_cancel[sizeof(s_turn_guard.playback_id)] = {0};
    strlcpy(turn_to_cancel, s_active_turn_id, sizeof(turn_to_cancel));
    if (turn_to_cancel[0] == '\0' && s_turn_guard.turn_id[0] != '\0') {
        strlcpy(turn_to_cancel,
                s_turn_guard.turn_id,
                sizeof(turn_to_cancel));
    }
    strlcpy(playback_to_cancel,
            s_turn_guard.playback_id,
            sizeof(playback_to_cancel));
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    uint32_t speaker_generation = nuwax_speaker_live_cancel_generation(
        s_turn_guard.speaker_generation,
        speaker_stats.playback_active,
        speaker_stats.playback_session_active,
        speaker_stats.playback_generation,
        speaker_stats.start_gate_pending ||
            speaker_stats.start_gate_authorized,
        speaker_stats.start_gate_generation,
        speaker_stats.rx_stream_active,
        speaker_stats.queue_waiting,
        speaker_stats.submitted_generation);
    const bool pending_start_gate =
        speaker_generation != 0U &&
        speaker_generation == speaker_stats.start_gate_generation &&
        (speaker_stats.start_gate_pending ||
         speaker_stats.start_gate_authorized) &&
        !speaker_stats.playback_active;
    if (turn_to_cancel[0] == '\0' &&
        speaker_stats.active_turn_id[0] != '\0') {
        strlcpy(turn_to_cancel,
                speaker_stats.active_turn_id,
                sizeof(turn_to_cancel));
    }
    if (playback_to_cancel[0] == '\0' &&
        speaker_stats.active_playback_id[0] != '\0') {
        strlcpy(playback_to_cancel,
                speaker_stats.active_playback_id,
                sizeof(playback_to_cancel));
    }
    nuwax_speaker_cancel_request_result_t cancel = {0};
    bool cancel_accepted = false;
    bool physical_stop_done = false;
    uint32_t speaker_epoch = 0U;
#endif
    /* A during-playback/barge-in capture may still own MIC/I2S here. Keep
     * that real owner visible so the physical-stop handoff can resume it in
     * place; only an unstarted follow-up window is safe to discard. */
    if (s_prelisten.pending && !s_prelisten.capture_active) {
        clear_auto_followup("cancel_turn");
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (pending_start_gate) {
        cancel_accepted = nuwax_speaker_playback_reject_start_generation(
            speaker_generation, "touch_cancel_start_gate");
        if (cancel_accepted) {
            physical_stop_done = true;
            speaker_epoch = speaker_stats.start_gate_connection_epoch;
        }
    } else if (speaker_generation != 0U) {
        cancel_accepted =
            nuwax_speaker_playback_request_cancel_generation_ex(
                speaker_generation,
                "touch_cancel",
                0U,
                &cancel);
        if (cancel_accepted) {
            speaker_epoch = cancel.connection_epoch;
            physical_stop_done =
                cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
                cancel.completed_stop_result == ESP_OK;
        }
        if (!cancel_accepted) {
            nuwax_speaker_playback_stats_t retry_stats = {0};
            nuwax_speaker_playback_get_stats(&retry_stats);
            const uint32_t retry_generation =
                nuwax_speaker_live_cancel_generation(
                    0U,
                    retry_stats.playback_active,
                    retry_stats.playback_session_active,
                    retry_stats.playback_generation,
                    retry_stats.start_gate_pending ||
                        retry_stats.start_gate_authorized,
                    retry_stats.start_gate_generation,
                    retry_stats.rx_stream_active,
                    retry_stats.queue_waiting,
                    retry_stats.submitted_generation);
            if (retry_generation != 0U &&
                retry_generation != speaker_generation) {
                cancel_accepted =
                    nuwax_speaker_playback_request_cancel_generation_ex(
                        retry_generation,
                        "touch_cancel_retry",
                        0U,
                        &cancel);
                if (cancel_accepted) {
                    speaker_generation = retry_generation;
                    speaker_epoch = cancel.connection_epoch;
                    physical_stop_done =
                        cancel.status ==
                            NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
                        cancel.completed_stop_result == ESP_OK;
                    if (turn_to_cancel[0] == '\0' &&
                        retry_stats.active_turn_id[0] != '\0') {
                        strlcpy(turn_to_cancel,
                                retry_stats.active_turn_id,
                                sizeof(turn_to_cancel));
                    }
                    if (playback_to_cancel[0] == '\0' &&
                        retry_stats.active_playback_id[0] != '\0') {
                        strlcpy(playback_to_cancel,
                                retry_stats.active_playback_id,
                                sizeof(playback_to_cancel));
                    }
                }
            }
            if (!cancel_accepted && retry_stats.pending) {
                ESP_LOGW(TAG,
                         "touch cancel could not bind live speaker generation initial=%lu retry=%lu active=%d session=%d gate=%d queued=%lu",
                         (unsigned long)speaker_generation,
                         (unsigned long)retry_generation,
                         retry_stats.playback_active ? 1 : 0,
                         retry_stats.playback_session_active ? 1 : 0,
                         (retry_stats.start_gate_pending ||
                          retry_stats.start_gate_authorized)
                             ? 1
                             : 0,
                         (unsigned long)retry_stats.queue_waiting);
            }
        }
    }
#endif
    if (!ws || !nuwax_ws_is_connected(ws) || ws_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != ws_epoch) {
        ESP_LOGW(TAG,
                 "cancel_turn cannot be committed because WebSocket is unavailable; waiting for reconnect boundary");
        return false;
    }
    char request_id[40];
    snprintf(request_id, sizeof(request_id), "cancel_%lu", (unsigned long)++s_cancel_turn_request_seq);
    ESP_LOGI(TAG,
             "Sending cancel_turn id=%s turn=%s reason=%s",
             request_id,
             turn_to_cancel[0] ? turn_to_cancel : "-",
             reason ? reason : "device_cancel");
    const esp_err_t err = nuwax_session_send_cancel_turn_until_if_epoch(
        ws,
        request_id,
        turn_to_cancel,
        reason ? reason : "device_cancel",
        esp_timer_get_time() +
            (int64_t)NUWAX_TOUCH_CANCEL_SEND_TIMEOUT_MS * 1000LL,
        ws_epoch);
    if (err != ESP_OK) {
        ESP_LOGE(TAG,
                 "cancel_turn send failed: %s; reconnecting instead of starting a conflicting listen",
                 esp_err_to_name(err));
        (void)nuwax_ws_request_close_if_epoch(ws, ws_epoch);
        return false;
    }

    const bool cloud_wait_handoff =
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
        s_head_touch_agent_intent.source ==
            NUWAX_HEAD_TOUCH_AGENT_SOURCE_CLOUD_WAIT &&
        s_head_touch_agent_intent.ws_epoch == ws_epoch;
    uint32_t cancel_ack_deadline_ms =
        monotonic_ms() + NUWAX_TOUCH_CANCEL_RECOVERY_TIMEOUT_MS;
    if (cancel_ack_deadline_ms == 0U) {
        cancel_ack_deadline_ms = 1U;
    }
    if (cloud_wait_handoff &&
        !nuwax_head_touch_agent_intent_bind_cancel_ack(
            &s_head_touch_agent_intent,
            ws_epoch,
            request_id,
            turn_to_cancel,
            cancel_ack_deadline_ms)) {
        ESP_LOGE(TAG,
                 "cloud-wait interaction could not bind cancel ACK request=%s turn=%s epoch=%lu; closing owner epoch",
                 request_id,
                 turn_to_cancel[0] ? turn_to_cancel : "-",
                 (unsigned long)ws_epoch);
        clear_active_turn_guard("cancel_turn_unbound_cloud_wait");
        (void)nuwax_ws_request_close_if_epoch(ws, ws_epoch);
        return false;
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    bool speaker_pending = nuwax_speaker_playback_has_pending();
    if (speaker_generation != 0U && cancel_accepted &&
        speaker_epoch == ws_epoch && turn_to_cancel[0] != '\0' &&
        playback_to_cancel[0] != '\0' && awake_generation != 0U) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
        inhibit_sleep_wake_word_detector("touch_cancel_recovery");
        nuwax_wake_word_detector_request_stop();
#endif
        const bool detector_released =
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
            !nuwax_wake_word_detector_is_running();
#else
            true;
#endif
        if (!nuwax_touch_cancel_recovery_arm(
                &s_touch_cancel_recovery,
                ws_epoch,
                awake_generation,
                speaker_generation,
                monotonic_ms() + NUWAX_TOUCH_CANCEL_RECOVERY_TIMEOUT_MS,
                request_id,
                turn_to_cancel,
                playback_to_cancel,
                physical_stop_done,
                detector_released)) {
            ESP_LOGE(TAG,
                     "touch cancel recovery could not bind owner epoch=%lu awake_generation=%lu speaker_generation=%lu turn=%s playback=%s; failing closed",
                     (unsigned long)ws_epoch,
                     (unsigned long)awake_generation,
                     (unsigned long)speaker_generation,
                     turn_to_cancel,
                     playback_to_cancel);
            set_state(NUWAX_APP_STATE_ERROR);
            return false;
        }
        s_touch_cancel_recovery.head_touch_agent_handoff =
            s_head_touch_agent_intent.state ==
                NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
            s_head_touch_agent_intent.source ==
                NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK &&
            s_head_touch_agent_intent.ws_epoch == ws_epoch &&
            s_head_touch_agent_intent.speaker_generation ==
                speaker_generation;
        ESP_LOGI(TAG,
                 "touch cancel recovery armed epoch=%lu awake_generation=%lu speaker_generation=%lu physical=%d detector_released=%d request=%s turn=%s playback=%s",
                 (unsigned long)ws_epoch,
                 (unsigned long)awake_generation,
                 (unsigned long)speaker_generation,
                 physical_stop_done ? 1 : 0,
                 detector_released ? 1 : 0,
                 request_id,
                 turn_to_cancel,
                 playback_to_cancel);
    } else if (speaker_pending) {
        ESP_LOGW(TAG,
                 "touch cancel has pending speaker work without a safe transaction owner generation=%lu accepted=%d speaker_epoch=%lu ws_epoch=%lu turn=%s playback=%s; resetting local speaker runtime",
                 (unsigned long)speaker_generation,
                 cancel_accepted ? 1 : 0,
                 (unsigned long)speaker_epoch,
                 (unsigned long)ws_epoch,
                 turn_to_cancel[0] ? turn_to_cancel : "-",
                 playback_to_cancel[0] ? playback_to_cancel : "-");
        const esp_err_t reset_err =
            nuwax_speaker_playback_reset_runtime();
        speaker_pending = nuwax_speaker_playback_has_pending();
        if (reset_err != ESP_OK || speaker_pending) {
            ESP_LOGE(TAG,
                     "touch cancel local speaker reset failed err=%s pending=%d; WebSocket retained and listening remains blocked",
                     esp_err_to_name(reset_err),
                     speaker_pending ? 1 : 0);
            set_state(NUWAX_APP_STATE_ERROR);
            return false;
        }
    }
#endif
    nuwax_playback_terminal_guard_clear(&s_playback_terminal_guard);
    clear_active_turn_guard("cancel_turn_committed");
    set_conversation_status_guarded("VOICE", "CANCEL", "turn cancelled", true);
    if (s_touch_cancel_recovery.active) {
        ESP_LOGI(TAG,
                 "touch cancel listening held for physical stop epoch=%lu generation=%lu",
                 (unsigned long)s_touch_cancel_recovery.ws_epoch,
                 (unsigned long)s_touch_cancel_recovery.speaker_generation);
        return true;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        ESP_LOGE(TAG,
                 "touch cancel listening blocked because speaker remains pending after local convergence; WebSocket retained");
        set_state(NUWAX_APP_STATE_ERROR);
        return false;
    }
#endif
    if (s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
        (s_head_touch_agent_intent.source ==
             NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK ||
         s_head_touch_agent_intent.source ==
             NUWAX_HEAD_TOUCH_AGENT_SOURCE_CLOUD_WAIT) &&
        s_head_touch_agent_intent.ws_epoch == ws_epoch) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (s_head_touch_agent_intent.source ==
            NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK) {
            (void)nuwax_head_touch_agent_intent_mark_speaker_released(
                &s_head_touch_agent_intent,
                ws_epoch,
                s_head_touch_agent_intent.speaker_generation);
        }
#endif
        ESP_LOGI(TAG,
                 "head touch agent retained cancel handoff without reopening listening token=%lu",
                 (unsigned long)s_head_touch_agent_intent.token);
        return true;
    }
    return_to_listening_after_cancel("cancel_followup");
    return true;
}

static bool head_touch_agent_is_blocked(void) {
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire) ||
        sleep_lifecycle_blocks_new_capture() ||
        exclusive_audio_mode_blocks_normal_audio()) {
        return true;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio()) {
        return true;
    }
#endif
    return false;
}

static bool begin_head_touch_agent_quiesce(nuwax_ws_client_t *ws) {
    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING) {
        return false;
    }
    s_post_playback_resume_pending = false;
    if (s_head_touch_agent_intent.source ==
        NUWAX_HEAD_TOUCH_AGENT_SOURCE_CLOUD_WAIT) {
        if (!request_cancel_turn(
                ws,
                s_head_touch_agent_intent.interaction ==
                        NUWAX_AGENT_INTERACTION_SHAKE
                    ? "shake_agent"
                    : "head_touch_agent")) {
            clear_head_touch_agent_intent(
                "cloud_wait_cancel_not_committed");
            return false;
        }
        return s_head_touch_agent_intent.state ==
               NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING;
    }
    if (s_head_touch_agent_intent.source ==
        NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        const uint32_t live_generation =
            nuwax_speaker_live_cancel_generation(
                0U,
                stats.playback_active,
                stats.playback_session_active,
                stats.playback_generation,
                stats.start_gate_pending || stats.start_gate_authorized,
                stats.start_gate_generation,
                stats.rx_stream_active,
                stats.queue_waiting,
                stats.submitted_generation);
        if (live_generation != 0U &&
            live_generation !=
                s_head_touch_agent_intent.speaker_generation) {
            ESP_LOGI(TAG,
                     "head touch agent will not cancel newer speaker owner token=%lu bound_generation=%lu live_generation=%lu",
                     (unsigned long)s_head_touch_agent_intent.token,
                     (unsigned long)s_head_touch_agent_intent
                         .speaker_generation,
                     (unsigned long)live_generation);
            clear_head_touch_agent_intent("newer_speaker_owner_won");
            return false;
        }
        if (live_generation == 0U) {
            if (nuwax_speaker_playback_has_pending()) {
                clear_head_touch_agent_intent(
                    "speaker_owner_uncertain_at_quiesce");
                return false;
            }
            (void)nuwax_head_touch_agent_intent_mark_speaker_released(
                &s_head_touch_agent_intent,
                s_head_touch_agent_intent.ws_epoch,
                s_head_touch_agent_intent.speaker_generation);
            ESP_LOGI(TAG,
                     "head touch agent observed natural playback completion token=%lu generation=%lu",
                     (unsigned long)s_head_touch_agent_intent.token,
                     (unsigned long)s_head_touch_agent_intent
                         .speaker_generation);
            return true;
        }
        if (!request_cancel_turn(
                ws,
                s_head_touch_agent_intent.interaction ==
                        NUWAX_AGENT_INTERACTION_SHAKE
                    ? "shake_agent"
                    : "head_touch_agent")) {
            clear_head_touch_agent_intent(
                "playback_cancel_not_committed");
            return false;
        }
#else
        clear_head_touch_agent_intent("speaker_disabled");
        return false;
#endif
    }
    return s_head_touch_agent_intent.state ==
           NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING;
}

static void request_head_touch_agent(nuwax_ws_client_t *ws) {
    request_agent_interaction(ws, NUWAX_AGENT_INTERACTION_HEAD_TOUCH);
    if (s_head_touch_agent_intent.interaction !=
            NUWAX_AGENT_INTERACTION_HEAD_TOUCH ||
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE ||
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_CANCELLED) {
        nuwax_shake_detector_release_head_touch();
    }
}

static void request_shake_agent(nuwax_ws_client_t *ws) {
    request_agent_interaction(ws, NUWAX_AGENT_INTERACTION_SHAKE);
    if (s_head_touch_agent_intent.interaction !=
            NUWAX_AGENT_INTERACTION_SHAKE ||
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE ||
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_CANCELLED) {
        nuwax_shake_detector_release_shake();
    }
}

static void request_agent_interaction(nuwax_ws_client_t *ws,
                                      nuwax_agent_interaction_t interaction) {
    const bool is_shake = interaction == NUWAX_AGENT_INTERACTION_SHAKE;
    const char *agent_label = is_shake ? "shake" : "head touch";
    const uint32_t quiet_guard_ms =
        is_shake ? NUWAX_SHAKE_AGENT_QUIET_GUARD_MS
                 : NUWAX_HEAD_TOUCH_AGENT_QUIET_GUARD_MS;
    if (s_notification_transaction.active) {
        if (is_shake) {
            ESP_LOGI(TAG, "shake agent ignored during notification playback");
        } else {
            cancel_active_notification(ws, "notification_touch_interrupt");
        }
        return;
    }
    if (!is_shake && natural_playback_touch_protection_active()) {
        ESP_LOGI(TAG,
                 "head touch agent consumed locally during natural playback protection; cloud text suppressed");
        return;
    }
    if (!ws || !nuwax_ws_is_connected(ws)) {
        ESP_LOGI(TAG, "%s agent ignored without connected WebSocket", agent_label);
        return;
    }
    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_CANCELLED) {
        clear_head_touch_agent_intent("cancelled_before_new_press");
    }
    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
        ESP_LOGI(TAG,
                 "duplicate head touch agent request ignored token=%lu state=%s",
                 (unsigned long)s_head_touch_agent_intent.token,
                 nuwax_head_touch_agent_state_name(
                     s_head_touch_agent_intent.state));
        return;
    }
    if (is_shake && conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        if (s_deferred_sleep_intent.active ||
            (s_sleep_transaction.active &&
             s_sleep_transaction.state != NUWAX_SLEEP_TRANSACTION_SLEEPING)) {
            ESP_LOGI(TAG, "shake agent deferred/rejected while sleep transaction is quiescing");
            return;
        }
        if (s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING) {
            nuwax_sleep_transaction_reset_for_wake(&s_sleep_transaction);
        }
    }
    if (head_touch_agent_is_blocked() || s_touch_cancel_recovery.active) {
        ESP_LOGI(TAG,
                 "%s agent request rejected by active lifecycle owner blocked=%d cancel_recovery=%d",
                 agent_label,
                 head_touch_agent_is_blocked() ? 1 : 0,
                 s_touch_cancel_recovery.active ? 1 : 0);
        return;
    }

    /* A sleeping device has no awake generation yet. Shake is allowed to
     * create that generation, but only after the same sleep/OTA fences used by
     * normal wake actions have been checked above. */
    if (is_shake && conversation_state_current() == NUWAX_APP_STATE_SLEEPING &&
        !nuwax_awake_session_state_is_active(&s_awake_session)) {
        begin_awake_session("shake_agent");
    }

    const uint32_t ws_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (ws_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != ws_epoch || awake_generation == 0U ||
        !nuwax_awake_session_state_is_active(&s_awake_session)) {
        ESP_LOGI(TAG,
                 "head touch agent request rejected without connected awake owner epoch=%lu awake_generation=%lu",
                 (unsigned long)ws_epoch,
                 (unsigned long)awake_generation);
        return;
    }

    const bool capture_runtime =
        atomic_load_explicit(&s_conversation_capture_runtime_active,
                             memory_order_acquire) ||
        s_prelisten.capture_active;
    nuwax_head_touch_agent_source_t source =
        NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE;
    const char *owned_audio_session_id = NULL;
    uint32_t speaker_generation = 0U;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    speaker_generation = nuwax_speaker_live_cancel_generation(
        s_turn_guard.speaker_generation,
        speaker_stats.playback_active,
        speaker_stats.playback_session_active,
        speaker_stats.playback_generation,
        speaker_stats.start_gate_pending ||
            speaker_stats.start_gate_authorized,
        speaker_stats.start_gate_generation,
        speaker_stats.rx_stream_active,
        speaker_stats.queue_waiting,
        speaker_stats.submitted_generation);
    const bool conversation_speaker_owner =
        speaker_generation != 0U &&
        speaker_stats.active_owner !=
            NUWAX_SPEAKER_PLAYBACK_OWNER_NOTIFICATION &&
        (speaker_stats.active_owner ==
             NUWAX_SPEAKER_PLAYBACK_OWNER_CONVERSATION ||
         (s_turn_guard.active &&
          (s_turn_guard.speaker_generation == 0U ||
           s_turn_guard.speaker_generation == speaker_generation)));
    if (conversation_speaker_owner) {
        source = NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK;
    }
#endif

    const bool playback_capture =
        nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback") ||
        nuwax_prelisten_state_mode_is(&s_prelisten, "barge_in");
    if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE && capture_runtime &&
        !playback_capture && s_listen_resume.audio_session_id[0] != '\0' &&
        s_listen_resume.awake_generation == awake_generation) {
        source = NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING;
    }
    if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE &&
        conversation_state_current() == NUWAX_APP_STATE_THINKING &&
        nuwax_listen_resume_state_is_waiting_post_end_asr(
            &s_listen_resume) &&
        s_listen_resume.awake_generation == awake_generation &&
        s_listen_resume.audio_session_id[0] != '\0') {
        /* The microphone transaction is already closed, but its ASR verdict
         * still owns user-input priority. Keep the interaction pending until
         * that exact audio session reports speech/no-speech or times out. */
        source = NUWAX_HEAD_TOUCH_AGENT_SOURCE_POST_END_ASR;
        owned_audio_session_id = s_listen_resume.audio_session_id;
    }
    if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE &&
        conversation_state_current() == NUWAX_APP_STATE_THINKING &&
        s_turn_guard.active) {
        source = NUWAX_HEAD_TOUCH_AGENT_SOURCE_CLOUD_WAIT;
    }
    if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE && is_shake &&
        (conversation_state_current() == NUWAX_APP_STATE_SLEEPING ||
         conversation_state_current() == NUWAX_APP_STATE_LISTENING)) {
        source = NUWAX_HEAD_TOUCH_AGENT_SOURCE_SLEEPING;
    }
    if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_NONE) {
        ESP_LOGI(TAG,
                 "%s agent request ignored without normal conversation owner state=%s capture=%d mode=%s turn_active=%d",
                 agent_label,
                 nuwax_app_state_name(conversation_state_current()),
                 capture_runtime ? 1 : 0,
                 nuwax_prelisten_state_mode_or(&s_prelisten, "-"),
                 s_turn_guard.active ? 1 : 0);
        return;
    }

    const bool capture_required =
        source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING || capture_runtime;
    /* LISTENING proves that local capture owns the microphone, but it does not
     * prove that a cloud listen transaction has started. The capture loop
     * promotes this barrier only after listen START and audio upload commit. */
    const bool terminal_required = false;
    if (!nuwax_head_touch_agent_intent_arm_kind(
            &s_head_touch_agent_intent,
            interaction,
            source,
            ws_epoch,
            awake_generation,
            speaker_generation,
            capture_required,
            terminal_required,
            owned_audio_session_id,
            monotonic_ms(),
            quiet_guard_ms)) {
        ESP_LOGE(TAG,
                 "%s agent request could not arm source=%s epoch=%lu awake_generation=%lu speaker_generation=%lu capture=%d terminal=%d",
                 agent_label,
                 nuwax_head_touch_agent_source_name(source),
                 (unsigned long)ws_epoch,
                 (unsigned long)awake_generation,
                 (unsigned long)speaker_generation,
                 capture_required ? 1 : 0,
                 terminal_required ? 1 : 0);
        return;
    }
    if (is_shake) {
        if (source != NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING) {
            nuwax_state_bridge_trigger_shake();
        }
        if (source == NUWAX_HEAD_TOUCH_AGENT_SOURCE_SLEEPING) {
            /* begin_awake_session() inhibits new wake-detector work, but the
             * detector that owned the sleeping microphone may still be
             * running. Release it before waiting for the cloud response and
             * leave SLEEPING so the idle loop cannot re-arm it. */
            stop_sleep_wake_word_detector("shake_agent");
            set_state(NUWAX_APP_STATE_THINKING);
        }
    }
    pause_awake_waiting("head_touch_agent_arbitration");
    ESP_LOGI(TAG,
             "%s agent armed token=%lu source=%s epoch=%lu awake_generation=%lu speaker_generation=%lu capture=%d terminal=%d audio_session=%s quiet_guard_ms=%u",
             agent_label,
             (unsigned long)s_head_touch_agent_intent.token,
             nuwax_head_touch_agent_source_name(source),
             (unsigned long)ws_epoch,
             (unsigned long)awake_generation,
             (unsigned long)speaker_generation,
                 capture_required ? 1 : 0,
                 terminal_required ? 1 : 0,
                 owned_audio_session_id ? owned_audio_session_id : "-",
                 (unsigned)quiet_guard_ms);

    if (!capture_required &&
        source != NUWAX_HEAD_TOUCH_AGENT_SOURCE_POST_END_ASR &&
        nuwax_head_touch_agent_intent_begin_quiesce(
            &s_head_touch_agent_intent)) {
        (void)begin_head_touch_agent_quiesce(ws);
    }
}

static void request_status_app(nuwax_ws_client_t *ws, const char *app) {
    if (!ws || !nuwax_ws_is_connected(ws)) {
        return;
    }
    char request_id[40];
    snprintf(request_id, sizeof(request_id), "app_%lu", (unsigned long)++s_status_app_request_seq);
    ESP_LOGI(TAG, "Sending status_app_request id=%s app=%s", request_id, app ? app : "");
    esp_err_t err = nuwax_session_send_status_app_request(ws, request_id, app);
    if (err != ESP_OK) {
        ESP_LOGW(TAG, "Status app request failed: %s", esp_err_to_name(err));
    }
}

static void queue_wifi_status_report_for_request(const char *request_id,
                                                 const char *phase,
                                                 const char *ssid,
                                                 const char *ip,
                                                 bool ok,
                                                 const char *message) {
    if (!s_wifi_status_reports) {
        return;
    }
    wifi_status_report_t report = {0};
    report.ok = ok;
    strlcpy(report.request_id,
            request_id ? request_id : "",
            sizeof(report.request_id));
    strlcpy(report.phase, phase ? phase : "", sizeof(report.phase));
    strlcpy(report.ssid, ssid ? ssid : "", sizeof(report.ssid));
    strlcpy(report.ip, ip ? ip : "", sizeof(report.ip));
    strlcpy(report.message, message ? message : "", sizeof(report.message));
    xQueueOverwrite(s_wifi_status_reports, &report);
}

static void queue_wifi_status_report(const char *phase,
                                     const char *ssid,
                                     const char *ip,
                                     bool ok,
                                     const char *message) {
    queue_wifi_status_report_for_request(NULL,
                                         phase,
                                         ssid,
                                         ip,
                                         ok,
                                         message);
}

static bool begin_wifi_connect_operation(const char *reason, TickType_t wait_ticks) {
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        ESP_LOGI(TAG, "Wi-Fi connect blocked by BLE provisioning: %s",
                 reason ? reason : "operation");
        return false;
    }
    if (s_wifi_connect_mutex && xSemaphoreTake(s_wifi_connect_mutex, wait_ticks) != pdTRUE) {
        ESP_LOGI(TAG, "Wi-Fi connect busy, skip %s", reason ? reason : "operation");
        return false;
    }
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        if (s_wifi_connect_mutex) {
            xSemaphoreGive(s_wifi_connect_mutex);
        }
        return false;
    }
    atomic_store_explicit(&s_wifi_connect_in_progress, true,
                          memory_order_release);
    return true;
}

static void end_wifi_connect_operation(void) {
    atomic_store_explicit(&s_wifi_connect_in_progress, false,
                          memory_order_release);
    if (s_wifi_connect_mutex) {
        xSemaphoreGive(s_wifi_connect_mutex);
    }
}

/* Single-slot mailbox: main publishes requests and consumes results; the
 * existing Wi-Fi worker alone executes recovery. Release/acquire state changes
 * protect the payload. A provisioning/user-connect cancellation invalidates
 * results without freeing storage still owned by the worker. */
enum { WIFI_RECOVERY_IDLE, WIFI_RECOVERY_PENDING, WIFI_RECOVERY_RUNNING,
       WIFI_RECOVERY_DONE };
static atomic_int s_wifi_recovery_state;
static atomic_uint s_wifi_recovery_epoch;
static unsigned s_wifi_recovery_request_epoch;
static esp_err_t s_wifi_recovery_result;
static int64_t s_wifi_recovery_next_ms; /* main owner only */
static unsigned s_wifi_recovery_failures; /* main owner only */

static void cancel_background_wifi_recovery(void) {
    atomic_fetch_add_explicit(&s_wifi_recovery_epoch, 1U, memory_order_acq_rel);
    int expected = WIFI_RECOVERY_PENDING;
    (void)atomic_compare_exchange_strong_explicit(
        &s_wifi_recovery_state, &expected, WIFI_RECOVERY_IDLE,
        memory_order_acq_rel, memory_order_acquire);
}

/* Called only by wifi_connect_task, with no explicit request waiting. Never
 * invoke this from main: the driver operation may wait for authentication/DHCP. */
static void service_background_wifi_recovery(void) {
    int expected = WIFI_RECOVERY_PENDING;
    if (!atomic_compare_exchange_strong_explicit(
            &s_wifi_recovery_state, &expected, WIFI_RECOVERY_RUNNING,
            memory_order_acq_rel, memory_order_acquire)) return;
    esp_err_t err = ESP_ERR_INVALID_STATE;
    const int64_t started_us = esp_timer_get_time();
    if (s_wifi_recovery_request_epoch == atomic_load_explicit(
            &s_wifi_recovery_epoch, memory_order_acquire) &&
        !nuwax_wifi_provisioning_active() && !nuwax_wifi_simulated_offline() &&
        begin_wifi_connect_operation("background_recovery", 0)) {
        err = nuwax_wifi_recover();
        end_wifi_connect_operation();
    }
    ESP_LOGI(TAG, "Wi-Fi background recovery finished elapsed_ms=%lu err=%s",
             (unsigned long)((esp_timer_get_time() - started_us) / 1000),
             esp_err_to_name(err));
    s_wifi_recovery_result = err;
    atomic_store_explicit(&s_wifi_recovery_state, WIFI_RECOVERY_DONE,
                          memory_order_release);
}

static bool recover_wifi_if_needed(void) {
    app_task_watchdog_checkpoint();
    const bool fenced = atomic_load_explicit(&s_reprovision_quiesce_requested,
                                             memory_order_acquire) ||
                        nuwax_wifi_provisioning_active() ||
                        nuwax_wifi_simulated_offline();
    const bool connected = nuwax_wifi_is_connected();
    const int64_t now_ms = esp_timer_get_time() / 1000;
    if (atomic_load_explicit(&s_wifi_recovery_state, memory_order_acquire) ==
        WIFI_RECOVERY_DONE) {
        const esp_err_t err = s_wifi_recovery_result;
        const bool current = s_wifi_recovery_request_epoch ==
            atomic_load_explicit(&s_wifi_recovery_epoch, memory_order_acquire);
        atomic_store_explicit(&s_wifi_recovery_state, WIFI_RECOVERY_IDLE,
                              memory_order_release);
        if (current && !fenced && connected) {
            char ssid[33] = {0}, ip[16] = {0};
            nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));
            nuwax_app_shell_set_wifi_status(ssid, ip);
            set_wifi_result_from_current_link(ssid, true, ip);
            queue_wifi_status_report("connected", ssid, ip, true, "recovered");
            ESP_LOGI(TAG, "Wi-Fi recovered ssid=%s ip=%s", ssid, ip);
        } else if (current && !fenced && err != ESP_ERR_INVALID_STATE && err != ESP_OK) {
            if (s_wifi_recovery_failures < 5U) ++s_wifi_recovery_failures;
            uint32_t delay_ms = 3000U << (s_wifi_recovery_failures - 1U);
            if (delay_ms > 30000U) delay_ms = 30000U;
            s_wifi_recovery_next_ms = now_ms + delay_ms;
            ESP_LOGW(TAG, "Wi-Fi recovery deferred err=%s failures=%u delay_ms=%lu",
                     esp_err_to_name(err), s_wifi_recovery_failures,
                     (unsigned long)delay_ms);
            set_wifi_result_from_current_link("RECOVER", false, esp_err_to_name(err));
            queue_wifi_status_report("failed", "RECOVER", "", false, esp_err_to_name(err));
        } else {
            s_wifi_recovery_next_ms = now_ms + 500;
        }
    }
    if (fenced || connected) {
        /* GOT_IP precedes the worker's release-store of DONE. Do not leave
         * this owner loop before consuming completion and publishing the
         * connected UI/report. This is a nonblocking poll, not a radio wait. */
        const int recovery = atomic_load_explicit(
            &s_wifi_recovery_state, memory_order_acquire);
        if (!fenced && connected &&
            (recovery == WIFI_RECOVERY_RUNNING || recovery == WIFI_RECOVERY_DONE)) {
            return false;
        }
        int expected = WIFI_RECOVERY_PENDING;
        const bool cancelled_pending = atomic_compare_exchange_strong_explicit(
            &s_wifi_recovery_state, &expected, WIFI_RECOVERY_IDLE,
            memory_order_acq_rel, memory_order_acquire);
        if (!fenced && connected && !cancelled_pending &&
            (expected == WIFI_RECOVERY_RUNNING || expected == WIFI_RECOVERY_DONE)) {
            return false; /* Worker won PENDING -> RUNNING after our snapshot. */
        }
        if (cancelled_pending && connected && !fenced) {
            char ssid[33] = {0}, ip[16] = {0};
            nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));
            nuwax_app_shell_set_wifi_status(ssid, ip);
            queue_wifi_status_report("connected", ssid, ip, true, "link already recovered");
        }
        if (connected) {
            s_wifi_recovery_failures = 0U;
            s_wifi_recovery_next_ms = 0;
        }
        return connected && !fenced;
    }
    if (now_ms < s_wifi_recovery_next_ms ||
        atomic_load_explicit(&s_wifi_recovery_state, memory_order_acquire) != WIFI_RECOVERY_IDLE ||
        atomic_load_explicit(&s_wifi_connect_in_progress, memory_order_acquire) ||
        !s_wifi_connect_requests || uxQueueMessagesWaiting(s_wifi_connect_requests)) return false;
    s_wifi_recovery_request_epoch = atomic_load_explicit(
        &s_wifi_recovery_epoch, memory_order_acquire);
    nuwax_app_shell_set_bridge_status(false);
    set_wifi_transport_connecting_state("background_recovery");
    queue_wifi_status_report("connecting", "RECOVER", "", false, "recovering");
    atomic_store_explicit(&s_wifi_recovery_state, WIFI_RECOVERY_PENDING,
                          memory_order_release);
    ESP_LOGI(TAG, "Wi-Fi recovery queued; main remains responsive");
    return false;
}

static void drain_wifi_status_reports(nuwax_ws_client_t *ws) {
    if (!s_wifi_status_reports || !ws || !nuwax_ws_is_connected(ws)) {
        return;
    }
    wifi_status_report_t report = {0};
    while (xQueuePeek(s_wifi_status_reports, &report, 0) == pdTRUE) {
        ESP_LOGI(TAG,
                 "Sending wifi_status phase=%s ok=%d ssid=%s ip=%s message=%s",
                 report.phase,
                 report.ok ? 1 : 0,
                 report.ssid,
                 report.ip,
                 report.message);
        esp_err_t err = nuwax_session_send_wifi_status(ws,
                                                       report.request_id,
                                                       report.phase,
                                                       report.ssid,
                                                       report.ip,
                                                       report.ok,
                                                       report.message);
        if (err != ESP_OK) {
            ESP_LOGW(TAG, "Wi-Fi status send failed: %s", esp_err_to_name(err));
            break;
        }
        (void)xQueueReceive(s_wifi_status_reports, &report, 0);
    }
}

static void drain_wifi_scan_results(nuwax_ws_client_t *ws) {
    if (!s_wifi_scan_results || !ws || !nuwax_ws_is_connected(ws)) {
        return;
    }
    wifi_scan_report_t report = {0};
    while (xQueuePeek(s_wifi_scan_results, &report, 0) == pdTRUE) {
        const uint32_t active_epoch = nuwax_ws_connection_epoch(ws);
        if (report.ws_connection_epoch != 0U &&
            report.ws_connection_epoch != active_epoch) {
            ESP_LOGW(TAG,
                     "discarding stale Wi-Fi scan result request=%s request_epoch=%lu active_epoch=%lu",
                     report.request_id[0] ? report.request_id : "-",
                     (unsigned long)report.ws_connection_epoch,
                     (unsigned long)active_epoch);
            (void)xQueueReceive(s_wifi_scan_results, &report, 0);
            portENTER_CRITICAL(&s_wifi_scan_request_lock);
            if (s_wifi_scan_request_active &&
                s_wifi_scan_request_epoch == report.ws_connection_epoch &&
                strcmp(s_wifi_scan_request_id, report.request_id) == 0) {
                s_wifi_scan_request_active = false;
                s_wifi_scan_request_epoch = 0U;
                s_wifi_scan_request_id[0] = '\0';
            }
            portEXIT_CRITICAL(&s_wifi_scan_request_lock);
            continue;
        }
        ESP_LOGI(TAG, "Sending wifi_scan_result ok=%d count=%d message=%s",
                 report.ok ? 1 : 0,
                 report.count,
                 report.message);
        const uint32_t send_epoch = report.ws_connection_epoch != 0U
                                        ? report.ws_connection_epoch
                                        : active_epoch;
        esp_err_t err =
            nuwax_session_send_wifi_scan_result_until_if_epoch(
                ws,
                report.request_id,
                report.ok,
                report.message,
                report.ssids,
                report.rssis,
                report.authmodes,
                report.count,
                esp_timer_get_time() + NUWAX_ASYNC_WS_CONTROL_SEND_TIMEOUT_US,
                send_epoch);
        if (err != ESP_OK) {
            ESP_LOGW(TAG, "Wi-Fi scan result send failed: %s", esp_err_to_name(err));
            break;
        }
        (void)xQueueReceive(s_wifi_scan_results, &report, 0);
        portENTER_CRITICAL(&s_wifi_scan_request_lock);
        if (s_wifi_scan_request_active &&
            s_wifi_scan_request_epoch == report.ws_connection_epoch &&
            strcmp(s_wifi_scan_request_id, report.request_id) == 0) {
            s_wifi_scan_request_active = false;
            s_wifi_scan_request_epoch = 0U;
            s_wifi_scan_request_id[0] = '\0';
        }
        portEXIT_CRITICAL(&s_wifi_scan_request_lock);
    }
}

static void shell_dispatch_clear_auto_followup(void *ctx, const char *reason) {
    (void)ctx;
    clear_auto_followup(reason);
}

static bool exclusive_audio_playback_active(void *ctx) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    return nuwax_speaker_playback_has_pending();
#else
    return false;
#endif
}

static void exclusive_audio_fade_and_cancel_playback(void *ctx,
                                                     uint32_t fade_ms,
                                                     const char *reason) {
    (void)ctx;
    clear_auto_followup(reason ? reason : "exclusive_audio_mode");
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_request_fade_cancel(
        reason ? reason : "exclusive_audio_mode", fade_ms);
#else
    (void)fade_ms;
    (void)reason;
#endif
}

static void exclusive_audio_poll_controls(void *ctx, nuwax_ws_client_t *ws) {
    (void)ctx;
    app_task_watchdog_checkpoint();
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        /* Owner-side transport loss releases the mode MIC and seals its SD
         * archive through the normal cleanup path. Never start another replay. */
        (void)nuwax_ws_force_close_if_epoch(ws, nuwax_ws_connection_epoch(ws));
        return;
    }
    drain_shell_actions(ws);
    (void)service_application_keepalive(ws, "exclusive_audio");
#if CONFIG_NUWAX_SD_SESSION_ENABLE
    service_offline_audio_replay(ws);
#endif
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE && CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_FORMAL_ENABLE
    /* Scheduling only: no filesystem or network I/O on the capture owner.
     * Long meetings must not hide newly sealed segments from the worker. */
    (void)nuwax_offline_audio_replay_formal_start(
        ws, nuwax_ws_connection_epoch(ws));
#endif
}

#if CONFIG_NUWAX_OTA_ENABLE
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
#define NUWAX_OTA_BOOT_MIC_RETRY_MS 500U

static esp_err_t ota_validate_boot_mic_input(char *detail,
                                              size_t detail_size)
{
    if (detail == NULL || detail_size == 0U) {
        return ESP_ERR_INVALID_ARG;
    }
    if (ota_boot_health_has(OTA_BOOT_HEALTH_MIC_INPUT)) {
        strlcpy(detail, "microphone input already validated", detail_size);
        return ESP_OK;
    }

    const uint32_t now_ms = monotonic_ms();
    const uint32_t retry_after_ms = (uint32_t)atomic_load_explicit(
        &s_ota_boot_mic_retry_after_ms, memory_order_acquire);
    if (retry_after_ms != 0U &&
        (int32_t)(now_ms - retry_after_ms) < 0) {
        snprintf(detail, detail_size,
                 "waiting to retry microphone input validation in %lums",
                 (unsigned long)(retry_after_ms - now_ms));
        return ESP_ERR_NOT_FINISHED;
    }
    atomic_store_explicit(&s_ota_boot_mic_retry_after_ms,
                          now_ms + NUWAX_OTA_BOOT_MIC_RETRY_MS,
                          memory_order_release);

    int mic_rms = 0;
    int mic_peak = 0;
    const esp_err_t err =
        nuwax_mic_input_capture_selftest(0, &mic_rms, &mic_peak);
    if (err == ESP_OK && mic_peak > 0) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_MIC_INPUT);
        atomic_store_explicit(&s_ota_boot_mic_retry_after_ms, 0U,
                              memory_order_release);
        snprintf(detail, detail_size,
                 "microphone input passed rms=%d peak=%d",
                 mic_rms, mic_peak);
        ESP_LOGI(TAG, "OTA boot mic health passed rms=%d peak=%d",
                 mic_rms, mic_peak);
        return ESP_OK;
    }

    if (err == ESP_OK || err == ESP_ERR_INVALID_STATE ||
        err == ESP_ERR_TIMEOUT || err == ESP_ERR_NOT_FINISHED) {
        snprintf(detail, detail_size,
                 "microphone input validation pending err=%s rms=%d peak=%d",
                 esp_err_to_name(err), mic_rms, mic_peak);
        return ESP_ERR_NOT_FINISHED;
    }

    snprintf(detail, detail_size,
             "microphone input validation failed err=%s rms=%d peak=%d",
             esp_err_to_name(err), mic_rms, mic_peak);
    return err;
}
#endif

static esp_err_t ota_check_boot_health(void *ctx, char *detail,
                                       size_t detail_size)
{
    (void)ctx;
    if (detail == NULL || detail_size == 0U) {
        return ESP_ERR_INVALID_ARG;
    }

#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_SPEAKER_MANAGER)) {
        strlcpy(detail, "speaker manager initialization failed", detail_size);
        return ESP_FAIL;
    }
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_SPEAKER_OUTPUT) ||
        !nuwax_speaker_playback_output_ready()) {
        strlcpy(detail, "speaker codec or I2S output is not ready", detail_size);
        return ESP_FAIL;
    }
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_MIC_INPUT)) {
        const esp_err_t mic_err =
            ota_validate_boot_mic_input(detail, detail_size);
        if (mic_err != ESP_OK) {
            return mic_err;
        }
    }
#if CONFIG_NUWAX_LIVE_AEC_ENABLE
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_LIVE_AEC)) {
        strlcpy(detail, "live AEC reservation failed", detail_size);
        return ESP_FAIL;
    }
#endif
#endif
#if CONFIG_NUWAX_DISPLAY_ENABLE
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_DISPLAY)) {
        strlcpy(detail, "display initialization failed", detail_size);
        return ESP_FAIL;
    }
#endif
#if CONFIG_NUWAX_TOUCH_ENABLE
    nuwax_touch_status_t touch = {0};
    esp_err_t touch_err = nuwax_touch_get_status(&touch);
    esp_err_t producer_err = ESP_OK;
    if (touch_err != ESP_OK || !touch.initialized || !touch.controller_ready ||
        !touch.event_producer_ready) {
        producer_err = nuwax_touch_start_log_task();
        touch_err = nuwax_touch_get_status(&touch);
    }
    if (touch_err != ESP_OK || producer_err != ESP_OK || !touch.initialized ||
        !touch.controller_ready || !touch.event_producer_ready) {
        snprintf(detail, detail_size,
                 "waiting for touch path status=%s producer=%s initialized=%d ready=%d events=%d",
                 esp_err_to_name(touch_err), esp_err_to_name(producer_err),
                 touch.initialized ? 1 : 0, touch.controller_ready ? 1 : 0,
                 touch.event_producer_ready ? 1 : 0);
        return ESP_ERR_NOT_FINISHED;
    }
    if (touch.i2c_address != 0x15U && touch.i2c_address != 0x2aU &&
        touch.i2c_address != 0x2dU) {
        snprintf(detail, detail_size,
                 "touch controller has invalid address=0x%02x",
                 touch.i2c_address);
        return ESP_FAIL;
    }
#endif
#if CONFIG_NUWAX_UI_USE_LVGL
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_LVGL)) {
        strlcpy(detail, "LVGL initialization failed", detail_size);
        return ESP_FAIL;
    }
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_APP_SHELL)) {
        strlcpy(detail, "application UI shell initialization failed", detail_size);
        return ESP_FAIL;
    }
#endif
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_RUNTIME_TASKS)) {
        strlcpy(detail, "required application tasks are not ready", detail_size);
        return ESP_FAIL;
    }

#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE
    if (!ota_boot_health_has(OTA_BOOT_HEALTH_BATTERY_SERVICE) ||
        !nuwax_battery_service_is_running()) {
        strlcpy(detail, "battery service failed to start", detail_size);
        return ESP_FAIL;
    }
    nuwax_battery_service_snapshot_t battery = {0};
    esp_err_t battery_err = nuwax_battery_service_get_snapshot(&battery);
    const nuwax_ota_power_result_t power_result = nuwax_ota_boot_power_evaluate(
        battery_err == ESP_OK && battery.power_valid,
        battery.power_stale, battery.hard_low_voltage);
    if (power_result == NUWAX_OTA_POWER_UNKNOWN) {
        snprintf(detail, detail_size,
                 "waiting for valid power sample err=%s available=%d stale=%d present=%d valid=%d",
                 esp_err_to_name(battery_err), battery.sample_available ? 1 : 0,
                 battery.stale ? 1 : 0, battery.battery_present ? 1 : 0,
                 battery.valid ? 1 : 0);
        return ESP_ERR_NOT_FINISHED;
    }
    if (power_result == NUWAX_OTA_POWER_LOW) {
        snprintf(detail, detail_size,
                 "waiting for physical power recovery: %umV", battery.voltage_mv);
        return ESP_ERR_NOT_FINISHED;
    }
#endif

    strlcpy(detail, "positive cloud activity and local hardware health passed",
            detail_size);
    return ESP_OK;
}

static esp_err_t ota_send_json(void *ctx, const char *json)
{
    (void)ctx;
    if (!json || !s_ws_pointer_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(s_ws_pointer_mutex, pdMS_TO_TICKS(2000)) != pdTRUE) {
        return ESP_ERR_TIMEOUT;
    }
    nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
    esp_err_t err = ws && nuwax_ws_is_connected(ws)
                        ? nuwax_ws_send_text(ws, json)
                        : ESP_ERR_INVALID_STATE;
    xSemaphoreGive(s_ws_pointer_mutex);
    return err;
}

static void ota_show_local_progress(void *ctx, const char *phase,
                                    int percent, const char *detail)
{
    (void)ctx;
    const int bounded_percent = percent < 0 ? 0 : percent > 100 ? 100
                                                                  : percent;
    nuwax_app_shell_set_ota_progress(
        nuwax_ota_ui_progress_active(phase), bounded_percent);
    if (phase != NULL && strcmp(phase, "idle") == 0) {
        return;
    }
    char progress_line[48] = {0};
    char phase_line[48] = {0};
    char detail_line[48] = {0};
    snprintf(progress_line, sizeof(progress_line), "Progress: %d%%",
             bounded_percent);
    snprintf(phase_line, sizeof(phase_line), "Phase: %.39s",
             phase != NULL ? phase : "unknown");
    snprintf(detail_line, sizeof(detail_line), "%.47s",
             detail != NULL && detail[0] != '\0' ? detail : "please wait");
    nuwax_app_shell_set_status_card("FIRMWARE UPDATE", progress_line,
                                    phase_line, detail_line);
}

static esp_err_t ota_request_cloud_reconnect(void *ctx)
{
    (void)ctx;
    if (!s_ws_pointer_mutex) {
        return ESP_ERR_INVALID_STATE;
    }
    if (xSemaphoreTake(s_ws_pointer_mutex, pdMS_TO_TICKS(2000)) != pdTRUE) {
        return ESP_ERR_TIMEOUT;
    }
    uint32_t ws_epoch = 0U;
    nuwax_ws_client_t *ws = active_ws_snapshot(&ws_epoch);
    bool close_queued = false;
    if (ws != NULL) {
        ESP_LOGW(TAG, "forcing WebSocket reconnect for OTA state refresh");
        close_queued = nuwax_ws_close_if_epoch(
            ws, ws_epoch, NUWAX_WS_CLOSE_CAUSE_OTA_STATE_REFRESH);
    }
    xSemaphoreGive(s_ws_pointer_mutex);
    return close_queued ? ESP_OK : ESP_ERR_INVALID_STATE;
}

static bool ota_reject_continuous_audio_control(const char *payload, int len)
{
    nuwax_meeting_protocol_event_t meeting = {0};
    if (nuwax_meeting_protocol_parse(payload, len, &meeting)) {
        if (meeting.type == NUWAX_MEETING_PROTOCOL_EVENT_SET_COMMAND) {
            esp_err_t ack_err = ESP_ERR_INVALID_STATE;
            if (s_ws_pointer_mutex &&
                xSemaphoreTake(s_ws_pointer_mutex, pdMS_TO_TICKS(2000)) == pdTRUE) {
                nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
                if (ws && nuwax_ws_is_connected(ws)) {
                    ack_err = nuwax_meeting_protocol_send_command_ack(
                        ws, meeting.request_id,
                        strcmp(meeting.state, "enabled") == 0,
                        false, "ota_busy");
                }
                xSemaphoreGive(s_ws_pointer_mutex);
            }
            ESP_LOGW(TAG,
                     "meeting command rejected during OTA request_id=%s ack=%s",
                     meeting.request_id, esp_err_to_name(ack_err));
        }
        return true;
    }

    nuwax_monitoring_protocol_event_t monitoring = {0};
    if (!nuwax_monitoring_protocol_parse(payload, len, &monitoring)) {
        return false;
    }
    if (monitoring.type != NUWAX_MONITORING_PROTOCOL_EVENT_SET_COMMAND) {
        return false;
    }
    esp_err_t ack_err = ESP_ERR_INVALID_STATE;
    if (s_ws_pointer_mutex &&
        xSemaphoreTake(s_ws_pointer_mutex, pdMS_TO_TICKS(2000)) == pdTRUE) {
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (ws && nuwax_ws_is_connected(ws)) {
            ack_err = nuwax_monitoring_protocol_send_command_ack(
                ws, monitoring.request_id, monitoring.enabled,
                false, "ota_busy");
        }
        xSemaphoreGive(s_ws_pointer_mutex);
    }
    ESP_LOGW(TAG,
             "monitoring command rejected during OTA request_id=%s ack=%s",
             monitoring.request_id, esp_err_to_name(ack_err));
    return true;
}

static const char *reprovision_phase_name(nuwax_reprovision_phase_t phase)
{
    switch (phase) {
        case NUWAX_REPROVISION_PHASE_IDLE: return "idle";
        case NUWAX_REPROVISION_PHASE_RESERVED: return "reserved";
        case NUWAX_REPROVISION_PHASE_WAIT_READY: return "wait_ready";
        case NUWAX_REPROVISION_PHASE_AUDIO_QUIESCE: return "audio_quiesce";
        case NUWAX_REPROVISION_PHASE_CLOUD_PARK: return "cloud_park";
        case NUWAX_REPROVISION_PHASE_WIFI_HANDOFF: return "wifi_handoff";
        case NUWAX_REPROVISION_PHASE_BLE_START: return "ble_start";
        case NUWAX_REPROVISION_PHASE_BLE_WAIT: return "ble_wait";
        case NUWAX_REPROVISION_PHASE_CLEANUP: return "cleanup";
        case NUWAX_REPROVISION_PHASE_RESTORE: return "restore";
        default: return "invalid";
    }
}

static uint32_t reprovision_phase_watchdog_ms(
    nuwax_reprovision_phase_t phase)
{
    switch (phase) {
        case NUWAX_REPROVISION_PHASE_RESERVED:
        case NUWAX_REPROVISION_PHASE_AUDIO_QUIESCE:
            return NUWAX_REPROVISION_WATCHDOG_RESERVED_MS;
        case NUWAX_REPROVISION_PHASE_WAIT_READY:
            return NUWAX_REPROVISION_WATCHDOG_WAIT_READY_MS;
        case NUWAX_REPROVISION_PHASE_CLOUD_PARK:
            return NUWAX_REPROVISION_WATCHDOG_CLOUD_MS;
        case NUWAX_REPROVISION_PHASE_WIFI_HANDOFF:
            return NUWAX_REPROVISION_WATCHDOG_HANDOFF_MS;
        case NUWAX_REPROVISION_PHASE_BLE_START:
            return NUWAX_REPROVISION_WATCHDOG_BLE_START_MS;
        case NUWAX_REPROVISION_PHASE_BLE_WAIT:
            /* BLE_WAIT has no coarse outer phase deadline. The provisioning
             * supervisor enforces the APP-activity deadline and its heartbeat
             * is checked here so a healthy wait is never mistaken for a stall. */
            return 0U;
        case NUWAX_REPROVISION_PHASE_CLEANUP:
            return NUWAX_REPROVISION_WATCHDOG_CLEANUP_MS;
        case NUWAX_REPROVISION_PHASE_RESTORE:
            return NUWAX_REPROVISION_WATCHDOG_RESTORE_MS;
        case NUWAX_REPROVISION_PHASE_IDLE:
        default:
            return 0U;
    }
}

static nuwax_reprovision_snapshot_t reprovision_snapshot(void)
{
    nuwax_reprovision_snapshot_t snapshot = {0};
    portENTER_CRITICAL(&s_flash_ops_lock);
    snapshot.requested = s_reprovision_requested;
    snapshot.phase = s_reprovision_phase;
    snapshot.generation = s_reprovision_generation;
    snapshot.transaction_started_ms = s_reprovision_transaction_started_ms;
    snapshot.phase_started_ms = s_reprovision_phase_started_ms;
    portEXIT_CRITICAL(&s_flash_ops_lock);
    return snapshot;
}

static void set_reprovision_phase(nuwax_reprovision_phase_t phase)
{
    const uint32_t now = monotonic_ms();
    uint32_t generation = 0U;
    nuwax_reprovision_phase_t previous = NUWAX_REPROVISION_PHASE_IDLE;
    bool changed = false;
    portENTER_CRITICAL(&s_flash_ops_lock);
    if (s_reprovision_requested && s_reprovision_phase != phase) {
        previous = s_reprovision_phase;
        s_reprovision_phase = phase;
        s_reprovision_phase_started_ms = now;
        generation = s_reprovision_generation;
        changed = true;
    }
    portEXIT_CRITICAL(&s_flash_ops_lock);
    if (changed) {
        ESP_LOGI(TAG,
                 "BLE reprovision phase generation=%lu %s -> %s owners=0x%08lx",
                 (unsigned long)generation,
                 reprovision_phase_name(previous),
                 reprovision_phase_name(phase),
                 (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
    }
}

static nuwax_reprovision_orphan_result_t
recover_orphaned_reprovision_owner(const char *source)
{
    bool orphaned = false;
    bool wifi_owner_orphaned = false;
    bool quiesce_orphaned = false;
    uint32_t owners_before = 0U;
    uint32_t generation = 0U;
    nuwax_reprovision_phase_t phase = NUWAX_REPROVISION_PHASE_IDLE;
    portENTER_CRITICAL(&s_flash_ops_lock);
    owners_before = nuwax_power_ctrl_shutdown_inhibit_owners();
    quiesce_orphaned = atomic_load_explicit(
        &s_reprovision_quiesce_requested, memory_order_acquire);
    wifi_owner_orphaned = nuwax_wifi_provisioning_active();
    if (!s_reprovision_requested &&
        ((owners_before & NUWAX_POWER_INHIBIT_REPROVISION) != 0U ||
         s_reprovision_phase != NUWAX_REPROVISION_PHASE_IDLE ||
         quiesce_orphaned || wifi_owner_orphaned)) {
        orphaned = true;
        generation = s_reprovision_generation;
        phase = s_reprovision_phase;
        if (s_reprovision_orphan_recovery_active) {
            portEXIT_CRITICAL(&s_flash_ops_lock);
            return NUWAX_REPROVISION_ORPHAN_RETRY_REQUIRED;
        }
        /* Re-establish isolation before touching any orphaned owner. This is
         * intentionally done even if the quiesce bit was the missing part of
         * the invariant, so a failed Wi-Fi/power release cannot resume cloud
         * or audio work in a half-recovered state. */
        atomic_store_explicit(&s_reprovision_quiesce_requested, true,
                              memory_order_release);
        s_reprovision_orphan_recovery_active = true;
    } else if (!s_reprovision_orphan_recovery_active) {
        s_reprovision_orphan_release_failures = 0U;
    }
    portEXIT_CRITICAL(&s_flash_ops_lock);
    if (!orphaned) {
        return NUWAX_REPROVISION_ORPHAN_NONE;
    }

    esp_err_t wifi_release_err = ESP_OK;
    if (wifi_owner_orphaned) {
        if (nuwax_wifi_provisioning_owner_active()) {
            wifi_release_err = nuwax_wifi_set_provisioning_active(false);
        } else if (!nuwax_wifi_cancel_provisioning_handoff()) {
            wifi_release_err = ESP_ERR_INVALID_STATE;
        }
    }
    bool power_released = false;
    if (wifi_release_err == ESP_OK) {
        power_released = nuwax_power_ctrl_release_shutdown_inhibit(
            NUWAX_POWER_INHIBIT_REPROVISION);
    }

    uint32_t release_failures = 0U;
    bool recovered = false;
    portENTER_CRITICAL(&s_flash_ops_lock);
    if (wifi_release_err == ESP_OK && power_released &&
        !s_reprovision_requested) {
        s_reprovision_phase = NUWAX_REPROVISION_PHASE_IDLE;
        s_reprovision_transaction_started_ms = 0U;
        s_reprovision_phase_started_ms = 0U;
        atomic_store_explicit(&s_reprovision_quiesce_requested, false,
                              memory_order_release);
        s_reprovision_orphan_release_failures = 0U;
        recovered = true;
    } else {
        s_reprovision_orphan_release_failures++;
        release_failures = s_reprovision_orphan_release_failures;
    }
    s_reprovision_orphan_recovery_active = false;
    portEXIT_CRITICAL(&s_flash_ops_lock);

    if (!recovered) {
        ESP_LOGE(TAG,
                 "orphan BLE reprovision release retained isolation source=%s generation=%lu phase=%s wifi_release=%s power_release=%d failure=%lu/%u",
                 source ? source : "-", (unsigned long)generation,
                 reprovision_phase_name(phase),
                 esp_err_to_name(wifi_release_err), power_released ? 1 : 0,
                 (unsigned long)release_failures,
                 (unsigned)NUWAX_REPROVISION_ORPHAN_RELEASE_RESTART_FAILURES);
        return NUWAX_REPROVISION_ORPHAN_RETRY_REQUIRED;
    }

    ESP_LOGE(TAG,
             "orphan BLE reprovision state recovered source=%s generation=%lu phase=%s owners_before=0x%08lx quiesce=%d wifi_owner=%d owners_now=0x%08lx",
             source ? source : "-", (unsigned long)generation,
             reprovision_phase_name(phase), (unsigned long)owners_before,
             quiesce_orphaned ? 1 : 0, wifi_owner_orphaned ? 1 : 0,
             (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
    return NUWAX_REPROVISION_ORPHAN_RECOVERED;
}

static void service_reprovision_watchdog(uint32_t now_ms)
{
    if ((uint32_t)(now_ms - s_reprovision_watchdog_last_poll_ms) <
        NUWAX_REPROVISION_WATCHDOG_POLL_MS) {
        return;
    }
    s_reprovision_watchdog_last_poll_ms = now_ms;

    const nuwax_reprovision_snapshot_t snapshot = reprovision_snapshot();
    if (!snapshot.requested) {
        const nuwax_reprovision_orphan_result_t orphan_result =
            recover_orphaned_reprovision_owner("watchdog_idle");
        uint32_t orphan_failures = 0U;
        portENTER_CRITICAL(&s_flash_ops_lock);
        orphan_failures = s_reprovision_orphan_release_failures;
        portEXIT_CRITICAL(&s_flash_ops_lock);
        if (orphan_result != NUWAX_REPROVISION_ORPHAN_RETRY_REQUIRED ||
            orphan_failures <
                NUWAX_REPROVISION_ORPHAN_RELEASE_RESTART_FAILURES) {
            return;
        }
#if CONFIG_NUWAX_OTA_ENABLE
        if (nuwax_ota_device_is_active()) {
            ESP_LOGE(TAG,
                     "orphan BLE reprovision restart deferred because OTA is active failures=%lu",
                     (unsigned long)orphan_failures);
            return;
        }
#endif
        ESP_LOGE(TAG,
                 "orphan BLE reprovision owner could not be released after %lu attempts; forcing controlled restart while isolation remains active",
                 (unsigned long)orphan_failures);
        nuwax_diagnostics_log_heap_label(TAG,
                                         "reprovision_orphan_restart");
        vTaskDelay(pdMS_TO_TICKS(100));
        esp_restart();
        return;
    }

    const uint32_t phase_elapsed =
        (uint32_t)(now_ms - snapshot.phase_started_ms);
    const uint32_t phase_limit =
        reprovision_phase_watchdog_ms(snapshot.phase);
    const bool phase_expired = phase_limit > 0U && phase_elapsed >= phase_limit;
    int64_t heartbeat_us = 0;
    int64_t heartbeat_age_ms = 0;
    bool supervisor_stalled = false;
    if (snapshot.phase == NUWAX_REPROVISION_PHASE_BLE_WAIT &&
        phase_elapsed >= NUWAX_REPROVISION_WATCHDOG_HEARTBEAT_MS) {
        heartbeat_us = nuwax_provision_main_supervisor_heartbeat_us();
        const int64_t watchdog_now_us = esp_timer_get_time();
        heartbeat_age_ms = heartbeat_us <= 0
            ? (int64_t)phase_elapsed
            : (watchdog_now_us - heartbeat_us) / 1000;
        supervisor_stalled = nuwax_provision_supervisor_stalled(
            heartbeat_us,
            watchdog_now_us,
            NUWAX_REPROVISION_WATCHDOG_HEARTBEAT_MS);
    }
    if (!phase_expired && !supervisor_stalled) {
        return;
    }

#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active()) {
        ESP_LOGE(TAG,
                 "BLE reprovision watchdog deferred because OTA is active generation=%lu phase=%s",
                 (unsigned long)snapshot.generation,
                 reprovision_phase_name(snapshot.phase));
        return;
    }
#endif
    ESP_LOGE(TAG,
             "BLE reprovision watchdog forcing controlled restart generation=%lu phase=%s phase_elapsed_ms=%lu phase_limit_ms=%lu heartbeat_us=%lld heartbeat_age_ms=%lld supervisor_stalled=%d owners=0x%08lx",
             (unsigned long)snapshot.generation,
             reprovision_phase_name(snapshot.phase),
             (unsigned long)phase_elapsed, (unsigned long)phase_limit,
             (long long)heartbeat_us,
             (long long)heartbeat_age_ms,
             supervisor_stalled ? 1 : 0,
             (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
    nuwax_diagnostics_log_heap_label(TAG, "reprovision_watchdog_restart");
    vTaskDelay(pdMS_TO_TICKS(100));
    esp_restart();
}

static bool reprovision_request_pending(void)
{
    bool pending = false;
    portENTER_CRITICAL(&s_flash_ops_lock);
    pending = s_reprovision_requested;
    portEXIT_CRITICAL(&s_flash_ops_lock);
    return pending;
}

static bool reprovision_audio_mode_busy(void)
{
    bool busy = nuwax_meeting_mode_state(&s_meeting_mode) !=
               NUWAX_MEETING_STATE_DISABLED ||
           nuwax_meeting_mode_has_pending(&s_meeting_mode) ||
           nuwax_monitoring_mode_state(&s_monitoring_mode) !=
               NUWAX_MONITORING_STATE_DISABLED ||
           nuwax_monitoring_mode_has_pending(&s_monitoring_mode);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    busy = busy || offline_mode_lease_pending() ||
           nuwax_offline_audio_capture_running() ||
           nuwax_offline_audio_is_active() ||
           nuwax_offline_audio_replay_running();
#endif
    return busy;
}

static const char *reprovision_hard_busy_reason(bool include_power_gate)
{
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_is_active()) {
        return "OTA active";
    }
#endif
    if (nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        return "notification playback active";
    }
    if (include_power_gate) {
        const uint32_t owners =
            nuwax_power_ctrl_shutdown_inhibit_owners();
        if ((owners & NUWAX_POWER_INHIBIT_REPROVISION) != 0U) {
            return "BLE provisioning owner active";
        }
        if (owners != 0U) {
            return "power or OTA boot transition active";
        }
    }
    return NULL;
}

static const char *reprovision_transient_busy_reason(void)
{
#if !CONFIG_NUWAX_P1_HW_DIAG_MODE && !CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE && \
    !CONFIG_NUWAX_HW_ACCEPTANCE_MODE
    if (!atomic_load_explicit(&s_cloud_owner_ready, memory_order_acquire)) {
        return "network runtime is still starting";
    }
#endif
    if (atomic_load_explicit(&s_wifi_connect_in_progress,
                             memory_order_acquire) ||
        atomic_load_explicit(&s_wifi_scan_in_progress,
                             memory_order_acquire)) {
        return "Wi-Fi operation active";
    }
    return NULL;
}

static esp_err_t wait_for_reprovision_transient_busy(void)
{
    const uint32_t started_ms = monotonic_ms();
    const uint32_t deadline = started_ms + NUWAX_REPROVISION_READY_WAIT_MS;
    const char *reason = reprovision_transient_busy_reason();
    const bool waited = reason != NULL;
    if (reason) {
        ESP_LOGW(TAG,
                 "BLE reprovision waiting for transient owner reason=%s timeout_ms=%u",
                 reason, (unsigned)NUWAX_REPROVISION_READY_WAIT_MS);
    }
    while (reason && !elapsed_ms(monotonic_ms(), deadline)) {
        vTaskDelay(pdMS_TO_TICKS(NUWAX_REPROVISION_READY_POLL_MS));
        reason = reprovision_transient_busy_reason();
    }
    if (reason) {
        ESP_LOGE(TAG,
                 "BLE reprovision transient owner did not release reason=%s elapsed_ms=%lu",
                 reason, (unsigned long)(monotonic_ms() - started_ms));
        return ESP_ERR_TIMEOUT;
    }
    if (waited) {
        ESP_LOGI(TAG,
                 "BLE reprovision transient owner released elapsed_ms=%lu",
                 (unsigned long)(monotonic_ms() - started_ms));
    }
    return ESP_OK;
}

static esp_err_t release_reprovision_wifi_interlock(void)
{
    if (!nuwax_wifi_provisioning_active()) {
        return ESP_OK;
    }
    if (!nuwax_wifi_provisioning_owner_active() &&
        nuwax_wifi_cancel_provisioning_handoff()) {
        return ESP_OK;
    }
    return nuwax_wifi_set_provisioning_active(false);
}

static void clear_reprovision_reservation(bool release_power_gate)
{
    const nuwax_reprovision_snapshot_t snapshot = reprovision_snapshot();
    const esp_err_t wifi_release_err = release_reprovision_wifi_interlock();
    if (wifi_release_err != ESP_OK) {
        /* Keep the reservation and quiesce fence intact. The shell watchdog
         * will perform a controlled restart if the serialized Wi-Fi owner
         * cannot be released, rather than resuming cloud work in half-state. */
        ESP_LOGE(TAG,
                 "BLE reprovision reservation retained: Wi-Fi owner release failed generation=%lu phase=%s error=%s",
                 (unsigned long)snapshot.generation,
                 reprovision_phase_name(snapshot.phase),
                 esp_err_to_name(wifi_release_err));
        return;
    }
    portENTER_CRITICAL(&s_flash_ops_lock);
    atomic_store_explicit(&s_reprovision_quiesce_requested,
                          false,
                          memory_order_release);
    s_reprovision_requested = false;
    s_reprovision_phase = NUWAX_REPROVISION_PHASE_IDLE;
    s_reprovision_transaction_started_ms = 0U;
    s_reprovision_phase_started_ms = 0U;
    if (release_power_gate) {
        (void)nuwax_power_ctrl_release_shutdown_inhibit(
            NUWAX_POWER_INHIBIT_REPROVISION);
    }
    portEXIT_CRITICAL(&s_flash_ops_lock);
    ESP_LOGI(TAG,
             "BLE reprovision reservation cleared generation=%lu last_phase=%s release_owner=%d owners_now=0x%08lx",
             (unsigned long)snapshot.generation,
             reprovision_phase_name(snapshot.phase),
             release_power_gate ? 1 : 0,
             (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
}

static esp_err_t wait_for_cloud_owner_to_park_for_reprovision(void)
{
    const uint32_t deadline = monotonic_ms() +
                              NUWAX_REPROVISION_CLOUD_QUIESCE_TIMEOUT_MS;
    while (!elapsed_ms(monotonic_ms(), deadline)) {
        uint32_t ws_epoch = 0U;
        nuwax_ws_client_t *ws = active_ws_snapshot(&ws_epoch);
        if (ws && nuwax_ws_is_connected(ws)) {
            (void)nuwax_ws_force_close_if_epoch(ws, ws_epoch);
        }
        if (atomic_load_explicit(&s_cloud_owner_parked,
                                 memory_order_acquire)) {
            ESP_LOGI(TAG, "cloud owner parked for BLE provisioning");
            return ESP_OK;
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    ESP_LOGE(TAG,
             "cloud owner did not park within %u ms active_ws=%d",
             (unsigned)NUWAX_REPROVISION_CLOUD_QUIESCE_TIMEOUT_MS,
             active_ws_snapshot(NULL) ? 1 : 0);
    return ESP_ERR_TIMEOUT;
}

#if CONFIG_NUWAX_PROVISION_RUNTIME_REBOOT_ENABLE
/* Runtime reprovisioning must cross a clean boot boundary before BLE is
 * initialized.  The verified rollback record is the durable transaction
 * boundary; the low-memory marker makes the next boot select the provisioning
 * allocation profile before audio/UI owners are recreated. */
static esp_err_t prepare_runtime_reprovision_boot(void)
{
    esp_err_t err = nuwax_provision_main_reset_wifi_credentials();
    if (err == ESP_ERR_NVS_NOT_ENOUGH_SPACE) {
        /* Diagnostics are best-effort.  Release their persisted snapshot and
         * retry so the rollback record remains the first-class transaction. */
        const esp_err_t release_err =
            nuwax_device_error_report_release_persisted_storage();
        if (release_err == ESP_OK) {
            err = nuwax_provision_main_reset_wifi_credentials();
        } else {
            ESP_LOGW(TAG,
                     "runtime reprovision rollback retry unavailable err=%s",
                     esp_err_to_name(release_err));
        }
    }
    if (err != ESP_OK) {
        ESP_LOGE(TAG,
                 "runtime reprovision reboot refused: rollback record was not persisted err=%s",
                 esp_err_to_name(err));
        return err;
    }

    /* The durable rollback record itself also forces the provisioning boot
     * profile.  Keep the explicit marker for interrupted/diagnostic boots;
     * failure to write this advisory marker must not discard the durable
     * rollback transaction. */
    const esp_err_t profile_err =
        nuwax_provision_main_request_low_memory_boot_profile();
    if (profile_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "runtime reprovision low-memory boot marker deferred err=%s; durable rollback still selects provisioning",
                 esp_err_to_name(profile_err));
    }
    return ESP_OK;
}
#endif

static esp_err_t restore_audio_after_runtime_provisioning(void)
{
    esp_err_t result = ESP_OK;
    void *aec_contiguous_guard = NULL;
    atomic_store_explicit(&s_conversation_live_aec_post_reprovision_restart,
                          false, memory_order_release);
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_LIVE_AEC_ENABLE
    /* BLE and its security session leave a sufficiently large block, but
     * reconstructing MultiNet fragments that last block before AEC can claim
     * it. Keep one exact AEC-admission block allocated across model restore,
     * TLS reconnect and sleep. The first normal AEC prepare claims it only
     * after wake capture has released its transient resources. */
    aec_contiguous_guard = heap_caps_malloc(
        NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES,
        MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
    if (!aec_contiguous_guard) {
        ESP_LOGE(TAG,
                 "post-provision AEC contiguous guard allocation failed bytes=%u internal=%u largest=%u",
                 (unsigned)NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES,
                 (unsigned)heap_caps_get_free_size(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
    } else {
        ESP_LOGI(TAG,
                 "post-provision AEC contiguous guard reserved bytes=%u internal=%u largest=%u",
                 (unsigned)NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES,
                 (unsigned)heap_caps_get_free_size(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(
                     MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
    }
#endif
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    esp_err_t wake_err = ESP_ERR_INVALID_STATE;
    for (unsigned attempt = 1U;
         attempt <= NUWAX_REPROVISION_AUDIO_RESTORE_ATTEMPTS;
         ++attempt) {
        wake_err = request_wake_model_restore(
            NUWAX_REPROVISION_WAKE_MODEL_RESTORE_TIMEOUT_MS);
        if (wake_err == ESP_OK) {
            break;
        }
        ESP_LOGW(TAG,
                 "restore wake detector attempt=%u/%u failed: %s",
                 attempt,
                 (unsigned)NUWAX_REPROVISION_AUDIO_RESTORE_ATTEMPTS,
                 esp_err_to_name(wake_err));
        if (wake_err == ESP_ERR_TIMEOUT) {
            /* Model creation is synchronous and cannot be cancelled safely.
             * Do not enqueue another generation over a still-running create. */
            break;
        }
        if (attempt < NUWAX_REPROVISION_AUDIO_RESTORE_ATTEMPTS) {
            vTaskDelay(pdMS_TO_TICKS(
                NUWAX_REPROVISION_AUDIO_RESTORE_RETRY_MS * attempt));
        }
    }
    if (wake_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "restore wake detector after BLE provisioning failed: %s",
                 esp_err_to_name(wake_err));
        if (result == ESP_OK) {
            result = wake_err;
        }
    }
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC && CONFIG_NUWAX_LIVE_AEC_ENABLE
    if (result == ESP_OK && aec_contiguous_guard) {
        bool published = false;
        portENTER_CRITICAL(&s_conversation_live_aec_pool_lock);
        if (!s_conversation_live_aec_post_reprovision_guard) {
            s_conversation_live_aec_post_reprovision_guard =
                aec_contiguous_guard;
            published = true;
        }
        portEXIT_CRITICAL(&s_conversation_live_aec_pool_lock);
        if (published) {
            aec_contiguous_guard = NULL;
            ESP_LOGI(TAG,
                     "post-provision AEC contiguous guard retained until first prepare bytes=%u",
                     (unsigned)NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES);
        } else {
            ESP_LOGE(TAG,
                     "post-provision AEC contiguous guard publish collided with an existing guard");
            result = ESP_ERR_INVALID_STATE;
        }
    } else if (result == ESP_OK) {
        result = ESP_ERR_NO_MEM;
    }
    if (aec_contiguous_guard) {
        heap_caps_free(aec_contiguous_guard);
        aec_contiguous_guard = NULL;
    }
#else
    (void)aec_contiguous_guard;
#endif
    if (result != ESP_OK) {
        atomic_store_explicit(&s_conversation_live_aec_degraded, true,
                              memory_order_release);
    }
    return result;
}

static esp_err_t run_runtime_ble_reprovision(void)
{
    set_reprovision_phase(NUWAX_REPROVISION_PHASE_CLOUD_PARK);
    esp_err_t result = wait_for_cloud_owner_to_park_for_reprovision();
    bool wifi_mutex_owned = false;
    bool audio_resources_suspended = false;
#if CONFIG_NUWAX_UI_USE_LVGL
    bool ui_memory_migrated = false;
#endif
    bool rollback_record_saved = false;
    bool rollback_attempted = false;
    bool rollback_succeeded = false;
    bool rollback_failed = false;
    bool provision_completed = false;
    bool provision_cancelled = false;

    if (result != ESP_OK) {
        goto cleanup;
    }
#if CONFIG_NUWAX_PROVISION_RUNTIME_REBOOT_ENABLE
    result = prepare_runtime_reprovision_boot();
    if (result != ESP_OK) {
        goto cleanup;
    }
    ESP_LOGW(TAG,
             "runtime BLE reprovision prepared durable rollback; rebooting into clean BLE provisioning profile");
    /* Let the already-published provisioning visual reach the display before
     * the clean boot boundary. No LVGL calls or display locks in this worker. */
    vTaskDelay(pdMS_TO_TICKS(350));
    esp_restart();
    vTaskDelay(portMAX_DELAY);
    return ESP_ERR_INVALID_STATE;
#endif
    set_reprovision_phase(NUWAX_REPROVISION_PHASE_WIFI_HANDOFF);
#if CONFIG_NUWAX_UI_USE_LVGL
    result = nuwax_lvgl_port_set_runtime_provisioning_memory(true);
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "release LVGL internal draw buffer for BLE provisioning failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    ui_memory_migrated = true;
    nuwax_diagnostics_log_heap_label(TAG,
                                     "runtime_provision_ui_memory_released");
#endif
    if (!s_wifi_connect_mutex ||
        xSemaphoreTake(s_wifi_connect_mutex,
                       pdMS_TO_TICKS(NUWAX_REPROVISION_WIFI_QUIESCE_TIMEOUT_MS)) !=
            pdTRUE) {
        ESP_LOGE(TAG, "BLE provisioning could not acquire Wi-Fi owner lock");
        result = ESP_ERR_TIMEOUT;
        goto cleanup;
    }
    wifi_mutex_owned = true;
    result = nuwax_wifi_set_provisioning_active(true);
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "BLE provisioning could not claim Wi-Fi manager ownership: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    if (s_wifi_connect_requests) {
        xQueueReset(s_wifi_connect_requests);
    }
    cancel_background_wifi_recovery();

    result = nuwax_provision_main_reset_wifi_credentials();
    if (result == ESP_ERR_NVS_NOT_ENOUGH_SPACE) {
        /* Error reports are diagnostic only.  Releasing their persisted
         * snapshot gives the Wi-Fi/cloud transaction first claim on the
         * shared NVS partition, without erasing user credentials. */
        const esp_err_t release_err =
            nuwax_device_error_report_release_persisted_storage();
        if (release_err == ESP_OK) {
            result = nuwax_provision_main_reset_wifi_credentials();
        } else {
            ESP_LOGW(TAG,
                     "diagnostic NVS release unavailable err=%s; current Wi-Fi will be retained",
                     esp_err_to_name(release_err));
        }
        if (result == ESP_ERR_NVS_NOT_ENOUGH_SPACE) {
            /* Keep the error: do not disconnect the verified network or start
             * BLE when a reset could lose its only rollback snapshot. */
            nuwax_provision_main_discard_volatile_rollback();
        }
    }
    if (result != ESP_OK) {
        ESP_LOGE(TAG, "save Wi-Fi reprovision state failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    rollback_record_saved = true;
    const esp_err_t disconnect_err = esp_wifi_disconnect();
    if (disconnect_err != ESP_OK &&
        disconnect_err != ESP_ERR_WIFI_NOT_CONNECT) {
        ESP_LOGE(TAG, "disconnect old Wi-Fi before BLE provisioning failed: %s",
                 esp_err_to_name(disconnect_err));
        result = disconnect_err;
        goto cleanup;
    }
    const uint32_t disconnect_deadline = monotonic_ms() + 2000U;
    while (nuwax_wifi_is_connected() &&
           !elapsed_ms(monotonic_ms(), disconnect_deadline)) {
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    if (nuwax_wifi_is_connected()) {
        ESP_LOGE(TAG,
                 "old Wi-Fi remained connected before BLE provisioning");
        result = ESP_ERR_TIMEOUT;
        goto cleanup;
    }

#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    result = deinit_wake_model_serialized();
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "release wake model for BLE provisioning failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    audio_resources_suspended = true;
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    result = conversation_live_aec_pool_suspend_for_provisioning();
    if (result != ESP_OK) {
        goto cleanup;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    /* release_idle_output() intentionally keeps the codec and shared I2S DMA
     * resident for normal low-latency playback. Runtime BLE provisioning is
     * the exceptional owner that needs those internal/DMA blocks returned. */
    result = nuwax_speaker_playback_deinit_output();
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "release speaker/audio-board resources for BLE provisioning failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
#endif
    audio_resources_suspended = true;
    nuwax_diagnostics_log_heap_label(TAG, "runtime_provision_resources_released");

    set_reprovision_phase(NUWAX_REPROVISION_PHASE_BLE_START);
    result = nuwax_provision_main_stop();
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "stop previous provisioning manager before runtime init failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    nuwax_provision_main_set_restart_on_unrecoverable(false);
    result = nuwax_provision_main_init();
    if (result != ESP_OK) {
        ESP_LOGE(TAG, "runtime BLE provisioning init failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
    result = nuwax_provision_main_start("runtime_reprovision");
    if (result != ESP_OK) {
        ESP_LOGE(TAG, "runtime BLE provisioning start failed: %s",
                 esp_err_to_name(result));
        goto cleanup;
    }
    nuwax_app_shell_set_provisioning_active(true);
    nuwax_app_shell_schedule_provisioning_qr(0U);
    set_reprovision_phase(NUWAX_REPROVISION_PHASE_BLE_WAIT);
    ESP_LOGW(TAG,
             "runtime BLE provisioning active service=%s focused_wait_ms=%lu inactivity_timeout_ms=%u mode=activity_bounded",
             nuwax_provision_main_service_name(),
             (unsigned long)NUWAX_REPROVISION_FOCUSED_WAIT_MS,
             (unsigned)CONFIG_NUWAX_PROVISION_RUNTIME_IDLE_TIMEOUT_MS);
    const nuwax_provision_outcome_t outcome =
        nuwax_provision_main_run_runtime_rebind(
            NUWAX_REPROVISION_FOCUSED_WAIT_MS);
    provision_completed = outcome == NUWAX_PROVISION_OUTCOME_SUCCESS;
    provision_cancelled = outcome == NUWAX_PROVISION_OUTCOME_STOPPED;
    if (!provision_completed) {
        ESP_LOGE(TAG, "runtime BLE provisioning ended outcome=%d reason=%s",
                 (int)outcome, nuwax_provision_main_last_reason());
        result = ESP_FAIL;
    } else {
        ESP_LOGI(TAG, "runtime BLE provisioning completed outcome=%d reason=%s",
                 (int)outcome, nuwax_provision_main_last_reason());
        result = ESP_OK;
    }

cleanup:
    set_reprovision_phase(NUWAX_REPROVISION_PHASE_CLEANUP);
    const esp_err_t provision_stop_err = nuwax_provision_main_stop();
    nuwax_app_shell_set_provisioning_active(false);
    if (provision_stop_err != ESP_OK) {
        ESP_LOGE(TAG, "runtime BLE provisioning stop failed: %s",
                 esp_err_to_name(provision_stop_err));
        if (result == ESP_OK) {
            result = provision_stop_err;
        }
    }
    nuwax_provision_main_set_restart_on_unrecoverable(true);
    nuwax_diagnostics_log_heap_label(TAG, "runtime_provision_ble_released");
    esp_err_t audio_restore_err = ESP_OK;
    if (audio_resources_suspended) {
        set_reprovision_phase(NUWAX_REPROVISION_PHASE_RESTORE);
        /* Restore wake while BLE/TLS are absent and protect one contiguous
         * AEC-admission block until the first post-reconnect capture. */
        audio_restore_err = restore_audio_after_runtime_provisioning();
        nuwax_diagnostics_log_heap_label(
            TAG,
            audio_restore_err == ESP_OK
                ? "runtime_provision_audio_restored"
                : "runtime_provision_audio_restore_failed");
    }
    if (!provision_completed && rollback_record_saved &&
        nuwax_provision_main_is_reprovisioning()) {
        rollback_attempted = true;
        const esp_err_t rollback_err =
            rollback_wifi_credentials_guarded();
        if (rollback_err == ESP_OK) {
            rollback_succeeded = true;
            if (provision_cancelled) {
                result = ESP_OK;
            }
            ESP_LOGW(TAG,
                     "runtime BLE provisioning failed; previous Wi-Fi restored");
        } else {
            ESP_LOGE(TAG, "runtime BLE provisioning rollback failed: %s",
                     esp_err_to_name(rollback_err));
            rollback_failed = true;
            result = rollback_err;
        }
    }
    if (audio_restore_err != ESP_OK && result == ESP_OK) {
        result = audio_restore_err;
    }
    if (audio_restore_err == ESP_ERR_TIMEOUT) {
        /* MultiNet construction is synchronous and may still own its transient
         * heap. Keep cloud, Wi-Fi and power isolation intact instead of racing
         * TLS against that unfinished allocation. The provisioning result (or
         * rollback) is already durable, so a controlled restart is the only
         * bounded recovery that cannot create a second model instance. */
        ESP_LOGE(TAG,
                 "wake model restore exceeded its bounded deadline; restarting while BLE reprovision isolation remains active");
        set_state(NUWAX_APP_STATE_ERROR);
        nuwax_diagnostics_log_heap_label(
            TAG, "runtime_provision_wake_restore_restart");
        vTaskDelay(pdMS_TO_TICKS(100));
        esp_restart();
        vTaskDelay(portMAX_DELAY);
    }
    if (wifi_mutex_owned) {
        xSemaphoreGive(s_wifi_connect_mutex);
    }
    if (rollback_failed) {
        /* A failed rollback means the active Wi-Fi credentials are not known
         * to be usable. Release only the serialized Wi-Fi owner; retain the
         * reprovision quiesce fence and power inhibit so cloud/audio tasks
         * cannot resume against a half-restored network. The watchdog will
         * reboot from this isolated state if the owner cannot be repaired. */
        const nuwax_reprovision_snapshot_t failed_snapshot =
            reprovision_snapshot();
        const esp_err_t interlock_err = release_reprovision_wifi_interlock();
        if (interlock_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "BLE reprovision rollback failure retained Wi-Fi isolation release_err=%s",
                     esp_err_to_name(interlock_err));
        }
        set_reprovision_phase(NUWAX_REPROVISION_PHASE_RESTORE);
        set_state(NUWAX_APP_STATE_ERROR);
        nuwax_app_shell_set_provisioning_active(false);
        set_cloud_transport_connecting_state(
            "ble_reprovision_rollback_failed");
        set_wifi_result_from_current_link(
            "BLE", false, "Provisioning failed; Wi-Fi recovery pending");
        ESP_LOGE(TAG,
                 "runtime BLE reprovision rollback failed; retaining isolation and waiting for controlled watchdog restart generation=%lu",
                 (unsigned long)failed_snapshot.generation);
    }
    if (provision_completed) {
        char ssid[33] = {0};
        char ip[16] = {0};
        (void)nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));
        set_wifi_result_from_current_link(
            ssid[0] ? ssid : "BLE", true,
            result == ESP_OK
                ? (ip[0] ? ip : "provisioned")
                : "Wi-Fi provisioned; audio recovery failed");
        refresh_saved_wifi_list_ui();
    } else {
        const char *failure_text = provision_cancelled && rollback_succeeded
            ? "Provisioning canceled; Wi-Fi restored"
            : (rollback_succeeded
            ? "Provisioning failed; Wi-Fi restored"
            : (rollback_attempted
                   ? "Provisioning failed; previous Wi-Fi unavailable"
                   : (nuwax_wifi_is_connected()
                           ? "Provisioning canceled; Wi-Fi retained"
                           : "Provisioning failed; Wi-Fi recovery pending")));
        set_wifi_result_from_current_link(
            "BLE", provision_cancelled && rollback_succeeded, failure_text);
    }
#if CONFIG_NUWAX_UI_USE_LVGL
    if (ui_memory_migrated) {
        const esp_err_t ui_restore_err =
            nuwax_lvgl_port_set_runtime_provisioning_memory(false);
        if (ui_restore_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "LVGL remains on the functional PSRAM draw buffer after BLE provisioning: %s",
                     esp_err_to_name(ui_restore_err));
        }
        nuwax_diagnostics_log_heap_label(
            TAG,
            ui_restore_err == ESP_OK
                ? "runtime_provision_ui_memory_restored"
                : "runtime_provision_ui_memory_retained_psram");
    }
#endif
    if (!rollback_failed) {
        clear_reprovision_reservation(true);
    }
    if (audio_restore_err != ESP_OK) {
        /* Provisioning/rollback is already durable and all transient owners
         * are released. Never resume normal capture with raw uplink and
         * fail-closed barge-in after an audio restore failure; reboot into the
         * deterministic boot allocation order without erasing Wi-Fi or cloud
         * credentials. */
        ESP_LOGE(TAG,
                 "post-provision audio remains degraded err=%s; preserving committed configuration and restarting through clean boot allocation order",
                 esp_err_to_name(audio_restore_err));
        set_state(NUWAX_APP_STATE_ERROR);
        nuwax_diagnostics_log_heap_label(
            TAG, "runtime_provision_audio_degraded_restart");
        vTaskDelay(pdMS_TO_TICKS(100));
        esp_restart();
        vTaskDelay(portMAX_DELAY);
    }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!atomic_load_explicit(&s_reprovision_quiesce_requested,
                              memory_order_acquire)) {
        request_sleep_wake_word_detector("ble_reprovision_complete");
        if (!wait_for_sleep_wake_word_ready(NUWAX_WAKE_READY_WAIT_MS)) {
            ESP_LOGW(TAG,
                     "wake detector recovery remains pending after BLE reprovision; supervisor will retry");
        }
    }
#endif
    return result;
}

static bool ota_continuous_audio_busy(void *ctx)
{
    (void)ctx;
    const bool reprovision_busy = reprovision_request_pending();
    const bool notification_busy = nuwax_notification_blocks_conversation(
        &s_notification_transaction);
    const bool meeting_busy = nuwax_meeting_mode_blocks_ota(&s_meeting_mode);
    const bool monitoring_busy =
        nuwax_monitoring_mode_blocks_ota(&s_monitoring_mode);
    const bool offline_busy =
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        offline_mode_lease_pending() ||
        nuwax_offline_audio_capture_running() ||
        nuwax_offline_audio_is_active() ||
        nuwax_offline_audio_replay_blocks_ota();
#else
        false;
#endif
    const bool busy = nuwax_power_ctrl_shutdown_preparing() ||
                      reprovision_busy || notification_busy || meeting_busy ||
                      monitoring_busy || offline_busy;
    if (busy) {
        ESP_LOGW(TAG,
                 "OTA admission blocked reprovision=%d notification=%d meeting_state=%d meeting_pending=%d meeting_blocks=%d monitoring_state=%d monitoring_pending=%d monitoring_blocks=%d",
                 reprovision_busy ? 1 : 0,
                 notification_busy ? 1 : 0,
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 nuwax_meeting_mode_has_pending(&s_meeting_mode) ? 1 : 0,
                 meeting_busy ? 1 : 0,
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode),
                 nuwax_monitoring_mode_has_pending(&s_monitoring_mode) ? 1 : 0,
                 monitoring_busy ? 1 : 0);
    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (offline_busy) {
        ESP_LOGW(TAG,
                 "OTA admission blocked by offline audio owner lease=%d capture=%d archive=%d replay=%d",
                 offline_mode_lease_pending() ? 1 : 0,
                 nuwax_offline_audio_capture_running() ? 1 : 0,
                 nuwax_offline_audio_is_active() ? 1 : 0,
                 nuwax_offline_audio_replay_blocks_ota() ? 1 : 0);
    }
#endif
    return busy;
}

static esp_err_t ota_prepare_audio(void *ctx)
{
    (void)ctx;
    if (ota_continuous_audio_busy(NULL)) {
        return ESP_ERR_INVALID_STATE;
    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    const esp_err_t replay_err = nuwax_offline_audio_replay_prepare_ota(2500U);
    if (replay_err != ESP_OK) {
        ESP_LOGW(TAG, "OTA replay transport quiesce failed: %s", esp_err_to_name(replay_err));
        return replay_err;
    }
#endif
    const nuwax_app_state_t state_before_ota = conversation_state_current();
    if (state_before_ota == NUWAX_APP_STATE_SLEEPING ||
        state_before_ota == NUWAX_APP_STATE_WS_CONNECTING) {
        atomic_store_explicit(&s_ota_wake_restore_pending, true,
                              memory_order_release);
        ESP_LOGI(TAG,
                 "OTA wake recovery armed state=%s",
                 nuwax_app_state_name(state_before_ota));
    }
    stop_sleep_wake_word_detector("ota_update");
    if (s_prelisten.capture_active) {
        cancel_auto_followup_capture("ota_update");
    } else {
        clear_auto_followup("ota_update");
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_request_fade_cancel("ota_update", 200);
#endif
    if (s_session_commands) {
        xQueueReset(s_session_commands);
    }
    if (s_session_notification_commands) {
        xQueueReset(s_session_notification_commands);
    }
    if (s_session_critical_commands) {
        xQueueReset(s_session_critical_commands);
    }
    const uint32_t deadline = monotonic_ms() + 1500U;
    unsigned idle_checks = 0;
    while ((int32_t)(monotonic_ms() - deadline) < 0) {
        bool playback_busy = false;
#if CONFIG_NUWAX_SPEAKER_ENABLE
        playback_busy = nuwax_speaker_playback_has_pending();
#endif
        if (!s_prelisten.capture_active && !playback_busy) {
            if (++idle_checks >= 2U) {
                ESP_LOGW(TAG, "OTA audio paths are idle");
                return ESP_OK;
            }
        } else {
            idle_checks = 0;
        }
        vTaskDelay(pdMS_TO_TICKS(20));
    }
    ESP_LOGE(TAG, "OTA audio quiesce timed out capture=%d playback=%d",
             s_prelisten.capture_active ? 1 : 0,
#if CONFIG_NUWAX_SPEAKER_ENABLE
             nuwax_speaker_playback_has_pending() ? 1 : 0
#else
             0
#endif
    );
    return ESP_ERR_TIMEOUT;
}
#endif

/* Runtime BLE reprovisioning may restore the previous Wi-Fi configuration
 * after the wake model has already been brought back. Keep every rollback
 * NVS operation behind the same Flash/cache fence used by the detector. */
static esp_err_t rollback_wifi_credentials_guarded(void)
{
    const esp_err_t guard_err =
        nuwax_wake_word_detector_begin_flash_operation(500U);
    if (guard_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "Wi-Fi rollback deferred while wake detector is active: %s",
                 esp_err_to_name(guard_err));
        return guard_err;
    }
    const esp_err_t result =
        nuwax_provision_main_rollback_wifi_credentials();
    nuwax_wake_word_detector_end_flash_operation();
    return result;
}

static esp_err_t exclusive_audio_acquire_mic(void *ctx, nuwax_mic_input_t *mic,
                                               nuwax_mic_owner_t owner)
{
    (void)ctx;
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (nuwax_offline_audio_capture_running()) {
        if (!offline_mode_lease_pending() || !offline_mode_identity()->resuming)
            return ESP_ERR_INVALID_STATE;
        const nuwax_mic_owner_t expected = offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MEETING
            ? NUWAX_MIC_OWNER_MEETING_CAPTURE : NUWAX_MIC_OWNER_MONITORING_CAPTURE;
        if (owner != expected) return ESP_ERR_INVALID_STATE;
        const esp_err_t err = nuwax_offline_audio_take_capture_input(mic, 1000U);
        if (err != ESP_OK) return err;
        offline_mode_identity()->next_capture_sequence = nuwax_offline_audio_next_capture_sequence();
        s_offline_mode_capture_started = false;
        ESP_LOGI(TAG, "offline MIC transferred without DMA reset next_sequence=%lu",
                 (unsigned long)offline_mode_identity()->next_capture_sequence);
        return ESP_OK;
    }
#endif
    return nuwax_mic_input_init_with_owner(mic, owner);
}

static bool meeting_can_start(void *ctx) {
    (void)ctx;
    return !reprovision_request_pending() &&
           !nuwax_notification_blocks_conversation(
               &s_notification_transaction);
}

static bool monitoring_can_start(void *ctx) {
    (void)ctx;
    return !reprovision_request_pending() &&
           !nuwax_notification_blocks_conversation(
               &s_notification_transaction);
}

static void begin_exclusive_audio_takeover(const char *owner) {
    const char *mode = owner && owner[0] ? owner : "exclusive_audio";
    s_exclusive_audio_sleep_reconcile_pending = false;
    clear_deferred_shell_listen_actions(mode);
    const nuwax_deferred_sleep_intent_t deferred_sleep =
        s_deferred_sleep_intent;
    if (deferred_sleep.active) {
        const char *result = strcmp(mode, "meeting") == 0
                                 ? "superseded_by_meeting"
                                 : "superseded_by_monitoring";
        if (!nuwax_deferred_sleep_intent_consume(
                &s_deferred_sleep_intent, deferred_sleep.token)) {
            ESP_LOGE(TAG,
                     "exclusive audio takeover could not consume deferred sleep owner=%s expected_token=%lu actual_token=%lu",
                     mode,
                     (unsigned long)deferred_sleep.token,
                     (unsigned long)s_deferred_sleep_intent.token);
        } else {
            uint32_t active_epoch = 0U;
            nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
            if (deferred_sleep.request_id[0] &&
                deferred_sleep.command[0] && ws &&
                nuwax_ws_is_connected(ws) &&
                active_epoch == deferred_sleep.ws_epoch) {
                const esp_err_t ack_err = nuwax_session_send_command_ack(
                    ws,
                    deferred_sleep.request_id,
                    deferred_sleep.command,
                    false,
                    result);
                if (ack_err != ESP_OK) {
                    ESP_LOGW(TAG,
                             "superseded deferred sleep ACK failed owner=%s request=%s err=%s",
                             mode,
                             deferred_sleep.request_id,
                             esp_err_to_name(ack_err));
                }
            }
            ESP_LOGI(TAG,
                     "exclusive audio takeover consumed deferred sleep owner=%s token=%lu request=%s result=%s",
                     mode,
                     (unsigned long)deferred_sleep.token,
                     deferred_sleep.request_id[0]
                         ? deferred_sleep.request_id
                         : "-",
                     result);
        }
    }
    const bool transaction_active = s_sleep_transaction.active;
    const bool transaction_sleeping =
        s_sleep_transaction.state == NUWAX_SLEEP_TRANSACTION_SLEEPING;
    char request_id[sizeof(s_sleep_transaction.request_id)] = {0};
    char command[sizeof(s_sleep_transaction.command)] = {0};
    const uint32_t request_epoch = s_sleep_transaction.ws_epoch;

    if (transaction_active) {
        strlcpy(request_id,
                s_sleep_transaction.request_id,
                sizeof(request_id));
        strlcpy(command, s_sleep_transaction.command, sizeof(command));
    }
    if (transaction_active || transaction_sleeping) {
        nuwax_sleep_transaction_reset_for_wake(&s_sleep_transaction);
        ESP_LOGI(TAG,
                 "exclusive audio takeover reset sleep transaction owner=%s active=%d sleeping=%d request=%s epoch=%lu",
                 mode,
                 transaction_active ? 1 : 0,
                 transaction_sleeping ? 1 : 0,
                 request_id[0] ? request_id : "-",
                 (unsigned long)request_epoch);
    }
    clear_sleep_request();

    if (transaction_active && request_id[0] && command[0]) {
        uint32_t active_epoch = 0U;
        nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
        const char *result = strcmp(mode, "meeting") == 0
                                 ? "superseded_by_meeting"
                                 : "superseded_by_monitoring";
        if (ws && nuwax_ws_is_connected(ws) && active_epoch == request_epoch) {
            const esp_err_t ack_err = nuwax_session_send_command_ack(
                ws, request_id, command, false, result);
            if (ack_err != ESP_OK) {
                ESP_LOGW(TAG,
                         "superseded sleep transaction ACK failed owner=%s request=%s err=%s",
                         mode,
                         request_id,
                         esp_err_to_name(ack_err));
            }
        } else {
            ESP_LOGW(TAG,
                     "superseded sleep transaction had no matching live connection owner=%s request=%s request_epoch=%lu active_epoch=%lu",
                     mode,
                     request_id,
                     (unsigned long)request_epoch,
                     (unsigned long)active_epoch);
        }
    }
}

static void meeting_state_changed(void *ctx,
                                  nuwax_meeting_state_t state,
                                  const char *reason) {
    (void)ctx;
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (state == NUWAX_MEETING_STATE_ACTIVE && offline_mode_lease_pending() &&
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MEETING) {
        offline_mode_lease_store(false);
        s_meeting_mode.identity.resuming = false;
        s_offline_mode_restore_request_epoch = 0U;
        s_offline_mode_restore_started_ms = 0U;
        s_offline_mode_restore_next_attempt_ms = 0U;
        atomic_store_explicit(&s_offline_mode_capture_failed, false, memory_order_release);
        reset_offline_capture_retry_state();
        ESP_LOGI(TAG, "offline meeting restore committed after capture started");
    }
#endif
    ESP_LOGI(TAG,
             "meeting UI state=%d reason=%s offline_resume_pending=%d offline_lease=%d capture=%d archive=%d",
             (int)state,
             reason ? reason : "-",
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
             nuwax_meeting_mode_offline_resume_pending(&s_meeting_mode) ? 1 : 0,
             offline_mode_lease_pending() ? 1 : 0,
             nuwax_offline_audio_capture_running() ? 1 : 0,
             nuwax_offline_audio_is_active() ? 1 : 0
#else
             0, 0, 0, 0
#endif
             );
    if (state == NUWAX_MEETING_STATE_STARTING) {
        begin_exclusive_audio_takeover("meeting");
        clear_awake_session("meeting_start");
        /* The wake-word task is another MIC owner.  Stop it before the
         * meeting capture attempts to acquire the shared I2S RX channel. */
        stop_sleep_wake_word_detector("meeting_mode");
        if (s_prelisten.capture_active) {
            cancel_auto_followup_capture("meeting_mode");
        } else if (s_prelisten.pending) {
            clear_auto_followup("meeting_mode");
        }
    }
    if (state == NUWAX_MEETING_STATE_STARTING ||
        state == NUWAX_MEETING_STATE_DISABLED) {
        /* Messages queued before the mode transition belong to the ordinary
         * conversation and must not be replayed across the meeting boundary.
         * New non-audio commands can be sent again by the cloud after the
         * boundary if they are still needed. */
        discard_session_queue_at_audio_mode_boundary(
            state == NUWAX_MEETING_STATE_STARTING ? "meeting_start" : "meeting_end");
    }
    if (state == NUWAX_MEETING_STATE_STARTING ||
        state == NUWAX_MEETING_STATE_ACTIVE ||
        state == NUWAX_MEETING_STATE_STOPPING) {
        set_state(NUWAX_APP_STATE_LISTENING);
    } else if (state == NUWAX_MEETING_STATE_ERROR) {
        set_state(NUWAX_APP_STATE_ERROR);
    }
    /* shell_task reconciles the controller state into the UI mailbox. Keeping
     * one publisher prevents callback/shell ordering from restoring stale UI. */
    nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
    if (state == NUWAX_MEETING_STATE_DISABLED) {
        const bool monitoring_released =
            nuwax_monitoring_mode_state(&s_monitoring_mode) ==
                NUWAX_MONITORING_STATE_DISABLED &&
            !nuwax_monitoring_mode_has_pending(&s_monitoring_mode);
        if (monitoring_released) {
            s_exclusive_audio_sleep_reconcile_pending = true;
            if (active_ws && nuwax_ws_is_connected(active_ws)) {
                service_exclusive_audio_sleep_reconcile();
            }
        } else {
            /* Keep the latch for the final controller-release callback. */
            s_exclusive_audio_sleep_reconcile_pending = true;
        }
    }
}

static void monitoring_state_changed(void *ctx,
                                     nuwax_monitoring_state_t state,
                                     const char *reason) {
    (void)ctx;
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (state == NUWAX_MONITORING_STATE_ACTIVE && offline_mode_lease_pending() &&
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MONITORING) {
        offline_mode_lease_store(false);
        s_monitoring_mode.identity.resuming = false;
        s_offline_mode_restore_request_epoch = 0U;
        s_offline_mode_restore_started_ms = 0U;
        s_offline_mode_restore_next_attempt_ms = 0U;
        atomic_store_explicit(&s_offline_mode_capture_failed, false, memory_order_release);
        reset_offline_capture_retry_state();
        ESP_LOGI(TAG, "offline monitoring restore committed after capture started");
    }
#endif
    ESP_LOGI(TAG,
             "monitoring state=%d reason=%s",
             (int)state,
             reason ? reason : "-");
    if (state == NUWAX_MONITORING_STATE_STARTING) {
        begin_exclusive_audio_takeover("monitoring");
        clear_awake_session("monitoring_start");
        stop_sleep_wake_word_detector("monitoring_mode");
        if (s_prelisten.capture_active) {
            cancel_auto_followup_capture("monitoring_mode");
        }
        clear_auto_followup("monitoring_mode");
    }
    if (state == NUWAX_MONITORING_STATE_STARTING ||
        state == NUWAX_MONITORING_STATE_DISABLED) {
        discard_session_queue_at_audio_mode_boundary(
            state == NUWAX_MONITORING_STATE_STARTING
                ? "monitoring_start"
                : "monitoring_end");
    }
    if (state == NUWAX_MONITORING_STATE_STARTING ||
        state == NUWAX_MONITORING_STATE_ACTIVE ||
        state == NUWAX_MONITORING_STATE_STOPPING) {
        set_state(NUWAX_APP_STATE_LISTENING);
    } else if (state == NUWAX_MONITORING_STATE_ERROR) {
        set_state(NUWAX_APP_STATE_ERROR);
    }
    /* shell_task reconciles the controller state into the UI mailbox. */
    nuwax_ws_client_t *active_ws = active_ws_snapshot(NULL);
    if (state == NUWAX_MONITORING_STATE_DISABLED) {
        const bool meeting_released =
            nuwax_meeting_mode_state(&s_meeting_mode) ==
                NUWAX_MEETING_STATE_DISABLED &&
            !nuwax_meeting_mode_has_pending(&s_meeting_mode);
        if (meeting_released) {
            s_exclusive_audio_sleep_reconcile_pending = true;
            if (active_ws && nuwax_ws_is_connected(active_ws)) {
                service_exclusive_audio_sleep_reconcile();
            }
        } else {
            /* Keep the latch for the final controller-release callback. */
            s_exclusive_audio_sleep_reconcile_pending = true;
        }
    }
}

static void shell_dispatch_set_meeting_mode(void *ctx,
                                             nuwax_ws_client_t *ws,
                                             bool enabled) {
    (void)ctx;
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (!enabled &&
        offline_mode_kind() == NUWAX_OFFLINE_AUDIO_MODE_MEETING &&
        (offline_mode_lease_pending() ||
         nuwax_offline_audio_capture_running() ||
         nuwax_offline_audio_is_active())) {
        /* A local privacy stop must terminate disconnected SD capture as well;
         * the asynchronous request avoids blocking the UI/shell task on card
         * I/O.  Clearing the lease prevents automatic meeting re-admission on
         * the next cloud epoch. */
        (void)cancel_offline_mode_lease(
            NUWAX_OFFLINE_AUDIO_MODE_MEETING, true, "local_meeting_disable");
        ESP_LOGI(TAG, "offline meeting capture stop requested by local UI");
    }
#endif
    if (enabled && nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) {
        ESP_LOGW(TAG,
                 "meeting mode request rejected while monitoring owns audio");
        if (ui_ready_snapshot()) {
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_ERROR);
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_DISABLED);
        }
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_MEETING_MODE);
        return;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (enabled && nuwax_ota_device_is_active()) {
        ESP_LOGW(TAG, "meeting mode request rejected: OTA is active");
        if (ui_ready_snapshot()) {
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_ERROR);
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_DISABLED);
        }
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_MEETING_MODE);
        return;
    }
#endif
    /* Disabling is a local privacy action and must still stop capture when
     * the bridge has already gone away.  Enabling still requires a live
     * bridge because cloud authorization is the start gate. */
    if (enabled && (!ws || !nuwax_ws_is_connected(ws)) && !nuwax_sd_session_available()) {
        ESP_LOGW(TAG, "meeting mode request ignored: WebSocket is not connected");
        if (ui_ready_snapshot()) {
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_ERROR);
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_DISABLED);
        }
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_MEETING_MODE);
        return;
    }
    esp_err_t err = nuwax_meeting_mode_request_ui(&s_meeting_mode, ws, enabled);
    if (err != ESP_OK) {
        ESP_LOGW(TAG,
                 "meeting UI request enabled=%d failed: %s",
                 enabled ? 1 : 0,
                 esp_err_to_name(err));
        if (enabled && ui_ready_snapshot()) {
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_ERROR);
            nuwax_app_shell_set_meeting_state(NUWAX_MEETING_UI_DISABLED);
        }
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_SET_MEETING_MODE);
    }
}

