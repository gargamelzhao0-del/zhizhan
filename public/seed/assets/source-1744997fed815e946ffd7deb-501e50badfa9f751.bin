/* P3-0: cached AEC reference health result.  Set once at boot (or on
 * explicit re-check) and read by the audio path to decide whether to
 * enable hardware AEC or fall back.  The struct is zero-initialized
 * (status=NO_SIGNAL, passed=false) until the first health check runs. */
static nuwax_aec_ref_health_t s_aec_ref_health;
static volatile bool s_hw_ref_health_passed;

static void apply_hardware_ref_release_gate(nuwax_aec_ref_health_t *health)
{
    const bool runtime_passed = health && health->passed;
    const bool production_proven =
        CONFIG_NUWAX_VOCAT_MIC3_REFERENCE_PRODUCTION_PROVEN != 0;
    const bool released = CONFIG_NUWAX_VOCAT_SLOT2_AEC_REF_ENABLE != 0 &&
                          production_proven && runtime_passed;
    if (runtime_passed && !production_proven) {
        ESP_LOGE(TAG,
                 "hardware ref runtime health passed but product release is blocked: MIC3->slot2 production evidence missing");
    }
    if (health) {
        health->passed = released;
    }
    s_hw_ref_health_passed = released;
    nuwax_audio_board_set_hardware_ref_health(
        !production_proven ? NUWAX_HARDWARE_REF_HEALTH_BLOCKED_UNPROVEN :
        (released ? NUWAX_HARDWARE_REF_HEALTH_PASSED :
                    NUWAX_HARDWARE_REF_HEALTH_FAILED));
}

#if CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE
/*
 * P3-0 / P3-1 AFE MR prototype (feature flag, default OFF).
 * When enabled:
 *   1. The capture loop acquires multi-channel TDM frames instead of
 *      the downmixed mono path.
 *   2. slot0 (MIC1 primary) + slot2 (MIC3 = playback reference) are
 *      interleaved into "MR" format and fed into esp-sr AFE.
 *   3. AFE output (echo-removed mono) replaces raw mic samples for
 *      VAD / Opus / ASR uplink.
 *
 * Guard: if ref_health_check didn't pass (s_aec_ref_health.passed == false),
 * AFE is NOT enabled — we fall through to the plain mono path silently so
 * that bad reference data doesn't degrade ASR accuracy.
 */
static bool s_afe_mr_enabled = false;
static void *s_afe_handle = NULL;  /* esp-sr AFE handle, if active */
#endif

