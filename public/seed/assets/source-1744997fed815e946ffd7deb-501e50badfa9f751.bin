    NUWAX_REPROVISION_PHASE_IDLE = 0,
    NUWAX_REPROVISION_PHASE_RESERVED,
    NUWAX_REPROVISION_PHASE_WAIT_READY,
    NUWAX_REPROVISION_PHASE_AUDIO_QUIESCE,
    NUWAX_REPROVISION_PHASE_CLOUD_PARK,
    NUWAX_REPROVISION_PHASE_WIFI_HANDOFF,
    NUWAX_REPROVISION_PHASE_BLE_START,
    NUWAX_REPROVISION_PHASE_BLE_WAIT,
    NUWAX_REPROVISION_PHASE_CLEANUP,
    NUWAX_REPROVISION_PHASE_RESTORE,
} nuwax_reprovision_phase_t;

typedef enum {
