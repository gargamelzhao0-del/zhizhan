/* These are residual-health floors, not backend allocation sizes. Runtime
 * reprovisioning on production hardware returns 15872-byte heap blocks, and
 * a completed AFE allocation has been observed with 11264 bytes remaining.
 * Keep one allocator quantum below those proven states while preserving the
 * stronger total-internal and DMA checks. */
#define NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_FREE_BYTES 49152U
#define NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES 15360U
#define NUWAX_LIVE_AEC_POST_MIN_INTERNAL_FREE_BYTES 24576U
#define NUWAX_LIVE_AEC_POST_MIN_INTERNAL_LARGEST_BYTES 10240U
#define NUWAX_LIVE_AEC_POST_MIN_DMA_FREE_BYTES 16384U
#define NUWAX_LIVE_AEC_POST_MIN_DMA_LARGEST_BYTES 8192U
#define NUWAX_LIVE_AEC_RECOVERY_RETRY_MS 5000U

