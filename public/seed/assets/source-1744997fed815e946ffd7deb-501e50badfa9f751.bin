static esp_err_t run_p3_nearend_candidate_manual(uint32_t duration_ms,
                                                 uint32_t delay_samples,
                                                 bool *out_candidate)
{
    if (out_candidate) {
        *out_candidate = false;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P3-1 nearend candidate rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!nuwax_speaker_playback_has_pending()) {
        ESP_LOGW(TAG,
                 "P3-1 nearend candidate running without active speaker playback; record_only result should not be treated as interruption evidence");
    }
#endif
    nuwax_p3_nearend_candidate_result_t result = {0};
    esp_err_t err = nuwax_p3_nearend_candidate_run(duration_ms, delay_samples, &result);
    if (out_candidate) {
        *out_candidate = result.candidate;
    }
    return err;
}

static const char *p3_interrupt_mode_or_default(const char *mode)
{
    return (mode && mode[0] != '\0') ? mode : "record_only";
}

static bool p3_interrupt_mode_is_valid(const char *mode)
{
    const char *m = p3_interrupt_mode_or_default(mode);
    return strcmp(m, "record_only") == 0 ||
           strcmp(m, "manual_cancel") == 0 ||
           strcmp(m, "gray_cancel") == 0;
}

static bool p3_interrupt_mode_allows_cancel(const char *mode)
{
    const char *m = p3_interrupt_mode_or_default(mode);
    return strcmp(m, "manual_cancel") == 0 ||
           strcmp(m, "gray_cancel") == 0;
}

static int32_t p3_interrupt_delta_ms(uint32_t start_ms, uint32_t end_ms)
{
    if (start_ms == 0 || end_ms == 0) {
        return -1;
    }
    return (int32_t)(end_ms - start_ms);
}

static void log_p3_interrupt_timing(esp_err_t err,
                                    const char *mode,
                                    const char *request_id,
                                    const char *action,
                                    bool enabled,
                                    bool cancel_allowed,
                                    bool cancel_sent,
                                    uint32_t near_end_candidate_ts,
                                    uint32_t interrupt_pending_ts,
                                    uint32_t local_mute_ts,
                                    uint32_t cancel_turn_sent_ts,
                                    uint32_t stale_drop_effective_ts,
                                    const nuwax_p3_nearend_candidate_result_t *result)
{
    const nuwax_p3_nearend_candidate_result_t zero = {0};
    const nuwax_p3_nearend_candidate_result_t *r = result ? result : &zero;
    ESP_LOGW(TAG,
             "P3-2-INTERRUPT-TIMING err=%s mode=%s enabled=%d action=%s request=%s turn=%s "
             "candidate=%d cancel_allowed=%d cancel_sent=%d duration_ms=%lu delay_samples=%lu "
             "near_end_candidate_ts=%lu interrupt_pending_ts=%lu local_mute_ts=%lu "
             "cancel_turn_sent_ts=%lu stale_drop_effective_ts=%lu stale_drop_window_armed=%d "
             "candidate_to_pending_ms=%ld candidate_to_mute_ms=%ld candidate_to_cancel_ms=%ld "
             "ready=%d gate_ok=%d quality_gate_ok=%d strong_nearend_ok=%d "
             "mic_ok=%d energy_ok=%d active_ref_ratio=%.3f "
             "active_mic_rms=%.1f active_ref_rms=%.1f active_out_rms=%.1f "
             "active_out_to_ref_db=%.2f data_ok=%d quality_ok=%d resource_ok=%d "
             "ref_underrun_ratio=%.3f read_timeouts=%lu",
             esp_err_to_name(err),
             p3_interrupt_mode_or_default(mode),
             enabled ? 1 : 0,
             action ? action : "-",
             request_id && request_id[0] ? request_id : "-",
             s_active_turn_id[0] ? s_active_turn_id : "-",
             r->candidate ? 1 : 0,
             cancel_allowed ? 1 : 0,
             cancel_sent ? 1 : 0,
             (unsigned long)r->duration_ms,
             (unsigned long)r->delay_samples,
             (unsigned long)near_end_candidate_ts,
             (unsigned long)interrupt_pending_ts,
             (unsigned long)local_mute_ts,
             (unsigned long)cancel_turn_sent_ts,
             (unsigned long)stale_drop_effective_ts,
             stale_drop_effective_ts != 0 ? 1 : 0,
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, interrupt_pending_ts),
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, local_mute_ts),
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, cancel_turn_sent_ts),
             r->ready ? 1 : 0,
             r->gate_ok ? 1 : 0,
             r->quality_gate_ok ? 1 : 0,
             r->strong_nearend_ok ? 1 : 0,
             r->mic_ok ? 1 : 0,
             r->energy_ok ? 1 : 0,
             (double)r->aec.active_ref_ratio,
             (double)r->aec.active_mic_rms,
             (double)r->aec.active_ref_rms,
             (double)r->aec.active_out_rms,
             (double)r->active_out_to_ref_db,
             r->aec.data_plane_ok ? 1 : 0,
             r->aec.quality_ok ? 1 : 0,
             r->aec.resource_ok ? 1 : 0,
             (double)r->aec.ref_underrun_ratio,
             (unsigned long)r->aec.read_timeouts);
}

static esp_err_t run_p3_interrupt_timing_manual(nuwax_ws_client_t *ws,
                                                const char *mode,
                                                const char *request_id,
                                                uint32_t duration_ms,
                                                uint32_t delay_samples,
                                                bool *out_candidate,
                                                bool *out_cancel_sent)
{
    const char *safe_mode = p3_interrupt_mode_or_default(mode);
    const bool enabled = CONFIG_NUWAX_P3_INTERRUPT_TIMING_ENABLE ? true : false;
    bool candidate = false;
    bool cancel_sent = false;
    bool cancel_allowed = p3_interrupt_mode_allows_cancel(safe_mode);
    const char *action = "record_only";
    esp_err_t err = ESP_OK;
    uint32_t near_end_candidate_ts = 0;
    uint32_t interrupt_pending_ts = 0;
    uint32_t local_mute_ts = 0;
    uint32_t cancel_turn_sent_ts = 0;
    uint32_t stale_drop_effective_ts = 0;
    nuwax_p3_nearend_candidate_result_t result = {
        .duration_ms = duration_ms,
        .delay_samples = delay_samples,
    };

    if (!p3_interrupt_mode_is_valid(safe_mode)) {
        err = ESP_ERR_INVALID_ARG;
        action = "invalid_mode";
        goto finish;
    }

#if !CONFIG_NUWAX_P3_INTERRUPT_TIMING_ENABLE
    err = ESP_ERR_NOT_SUPPORTED;
    action = "disabled";
    goto finish;
#else
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P3-2 interrupt timing rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        err = ESP_ERR_INVALID_STATE;
        action = "rejected_prelisten";
        goto finish;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!nuwax_speaker_playback_has_pending()) {
        ESP_LOGW(TAG,
                 "P3-2 interrupt timing running without active speaker playback; cancel modes are diagnostic-only");
    }
#endif

    err = nuwax_p3_nearend_candidate_run(duration_ms, delay_samples, &result);
    near_end_candidate_ts = monotonic_ms();
    candidate = result.candidate;

    if (err != ESP_OK) {
        action = "candidate_error";
        goto finish;
    }
    if (!candidate) {
        action = "candidate_rejected";
        goto finish;
    }
    if (!cancel_allowed) {
        action = "record_only";
        goto finish;
    }

    interrupt_pending_ts = monotonic_ms();
    clear_auto_followup("p3_interrupt_timing");
#if CONFIG_NUWAX_SPEAKER_ENABLE
    local_mute_ts = monotonic_ms();
    nuwax_speaker_playback_cancel_now("p3_interrupt_timing");
    stale_drop_effective_ts = monotonic_ms();
#endif

    if (!ws || !nuwax_ws_is_connected(ws)) {
        err = ESP_ERR_INVALID_STATE;
        action = "cancel_ws_unavailable";
        goto finish;
    }

    char cancel_request_id[40];
    snprintf(cancel_request_id, sizeof(cancel_request_id), "p3int_%lu", (unsigned long)++s_cancel_turn_request_seq);
    ESP_LOGI(TAG,
             "P3-2 sending cancel_turn id=%s turn=%s mode=%s reason=p3_interrupt_timing",
             cancel_request_id,
             s_active_turn_id[0] ? s_active_turn_id : "-",
             safe_mode);
    err = nuwax_session_send_cancel_turn(ws,
                                         cancel_request_id,
                                         s_active_turn_id,
                                         "p3_interrupt_timing");
    if (err != ESP_OK) {
        action = "cancel_send_failed";
        goto finish;
    }
    cancel_turn_sent_ts = monotonic_ms();
    cancel_sent = true;
    action = safe_mode;
    set_conversation_status_guarded("VOICE", "CANCEL", "p3 interrupt timing", true);
    return_to_listening_after_cancel("p3_interrupt_timing");
#endif

finish:
    if (out_candidate) {
        *out_candidate = candidate;
    }
    if (out_cancel_sent) {
        *out_cancel_sent = cancel_sent;
    }
    log_p3_interrupt_timing(err,
                            safe_mode,
                            request_id,
                            action,
                            enabled,
                            cancel_allowed,
                            cancel_sent,
                            near_end_candidate_ts,
                            interrupt_pending_ts,
                            local_mute_ts,
                            cancel_turn_sent_ts,
                            stale_drop_effective_ts,
                            &result);
    return err;
}

static esp_err_t run_p5_fullduplex_overlap_probe_manual(nuwax_ws_client_t *ws,
                                                        uint32_t expected_ws_epoch,
                                                        const char *request_id,
                                                        const char *audio_session_id,
                                                        uint32_t duration_ms,
                                                        bool *out_passed)
{
    if (out_passed) {
        *out_passed = false;
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P5-1 full-duplex overlap rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
#endif
    nuwax_p5_fullduplex_overlap_probe_result_t result = {0};
    esp_err_t err = nuwax_p5_fullduplex_overlap_probe_run_ex_if_epoch(
        ws,
        expected_ws_epoch,
        request_id,
        audio_session_id,
        duration_ms,
        0U,
        false,
        &result);
    if (out_passed) {
        *out_passed = result.passed;
    }
    return err;
}

static uint32_t p5_candidate_duration_ms(uint32_t overlap_duration_ms)
{
    if (overlap_duration_ms < 1200U) {
        return overlap_duration_ms;
    }
    return 1200U;
}

#define NUWAX_P6_GRAY_CANCEL_FADE_MS 220U

static const char *p5_during_playback_mode_or_default(const char *mode)
{
    return (mode && mode[0] != '\0') ? mode : "record_only";
}

static bool p5_during_playback_mode_is_valid(const char *mode)
{
    const char *m = p5_during_playback_mode_or_default(mode);
    return strcmp(m, "record_only") == 0 ||
           strcmp(m, "shadow_record") == 0 ||
           strcmp(m, "gray_cancel") == 0 ||
           strcmp(m, "gray_confirm") == 0;
}

#if CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
static bool p5_during_playback_mode_requests_cancel(const char *mode)
{
    const char *m = p5_during_playback_mode_or_default(mode);
    return strcmp(m, "gray_cancel") == 0;
}

static bool p5_during_playback_mode_requests_gray_confirm(const char *mode)
{
    const char *m = p5_during_playback_mode_or_default(mode);
    return strcmp(m, "gray_confirm") == 0;
}
#endif

static const char *p6_record_observation_category(const nuwax_p3_nearend_candidate_result_t *candidate)
{
    if (!candidate) {
        return "no_result";
    }
    if (candidate->p6_cancel_candidate) {
        return "cancel_candidate";
    }
    if (candidate->candidate) {
        return "candidate";
    }
    if (candidate->p6_low_ref_nearend_ok) {
        return "low_ref_nearend_candidate";
    }
    if (candidate->p6_low_ref_normal_voice_ok) {
        return "low_ref_normal_voice_candidate";
    }
    if (candidate->p6_normal_voice_ok) {
        return "normal_voice_candidate";
    }
    if (candidate->p6_high_ref_strong_voice_ok) {
        return "high_ref_strong_voice_candidate";
    }
    if (candidate->p6_high_ref_voice_ok) {
        return "high_ref_voice_candidate";
    }
    if (candidate->p6_mid_ref_strong_voice_ok) {
        return "mid_ref_strong_voice_candidate";
    }
    if (candidate->nearend_observed && (!candidate->aec.quality_ok || !candidate->gate_ok)) {
        return "nearend_observed_quality_rejected";
    }
    if (candidate->nearend_observed) {
        return "nearend_observed_candidate_rejected";
    }
    return "no_nearend";
}

static void log_p5_during_playback_candidate(esp_err_t err,
                                             esp_err_t overlap_err,
                                             esp_err_t candidate_err,
                                             const char *mode,
                                             const char *request_id,
                                             const nuwax_p5_fullduplex_overlap_probe_result_t *overlap,
                                             const nuwax_p3_nearend_candidate_result_t *candidate,
                                             bool cancel_allowed,
                                             bool cancel_sent,
                                             uint32_t near_end_candidate_ts,
                                             uint32_t interrupt_pending_ts,
                                             uint32_t local_mute_ts,
                                             uint32_t cancel_turn_sent_ts,
                                             uint32_t stale_drop_effective_ts,
                                             bool passed)
{
    const nuwax_p5_fullduplex_overlap_probe_result_t overlap_zero = {0};
    const nuwax_p3_nearend_candidate_result_t candidate_zero = {0};
    const nuwax_p5_fullduplex_overlap_probe_result_t *o = overlap ? overlap : &overlap_zero;
    const nuwax_p3_nearend_candidate_result_t *c = candidate ? candidate : &candidate_zero;
    ESP_LOGW(TAG,
             "P5-3-DURING-PLAYBACK-CANDIDATE err=%s overlap_err=%s candidate_err=%s "
             "request=%s playback_id=%s audio_session_id=%s "
             "overlap_passed=%d capture_frames=%lu upload_frames=%lu queued_frames=%lu "
             "queue_drops=%lu write_failures=%lu read_timeouts=%lu overlap_ms=%lu "
             "ref_rms=%.1f mic_rms=%.1f heap_internal_min=%u dma_largest=%u "
             "mic2_rms=%.1f dual_mic_ready=%d dual_mic_voice_ok=%d "
             "dual_mic_corr=%.3f dual_mic_abs_corr=%.3f dual_mic_level_delta_db=%.2f "
             "dual_mic_diff_rms=%.1f dual_mic_diff_ratio=%.3f "
             "live_cancel_candidate=%d live_candidate_elapsed_ms=%lu "
             "mode=%s record_only=%d candidate=%d cancel_allowed=%d cancel_sent=%d "
             "candidate_duration_ms=%lu delay_samples=%lu "
             "near_end_candidate_ts=%lu interrupt_pending_ts=%lu local_mute_ts=%lu "
             "cancel_turn_sent_ts=%lu stale_drop_effective_ts=%lu stale_drop_window_armed=%d "
             "candidate_to_pending_ms=%ld candidate_to_mute_ms=%ld candidate_to_cancel_ms=%ld "
             "ready=%d gate_ok=%d quality_gate_ok=%d strong_nearend_ok=%d "
             "mic_ok=%d energy_ok=%d nearend_observed=%d "
             "p6_low_ref_nearend_ok=%d p6_low_ref_normal_voice_ok=%d p6_high_ref_voice_ok=%d "
             "p6_high_ref_strong_voice_ok=%d p6_mid_ref_strong_voice_ok=%d p6_normal_voice_ok=%d "
             "p6_record_candidate=%d p6_cancel_candidate=%d p6_observation=%s "
             "active_ref_ratio=%.3f "
             "active_mic_rms=%.1f active_ref_rms=%.1f active_out_rms=%.1f "
             "active_out_to_ref_db=%.2f active_erle_db=%.2f data_ok=%d quality_ok=%d "
             "active_mic2_rms=%.1f active_dual_mic_voice_ok=%d "
             "active_dual_mic_corr=%.3f active_dual_mic_abs_corr=%.3f "
             "active_dual_mic_level_delta_db=%.2f active_dual_mic_diff_rms=%.1f "
             "active_dual_mic_diff_ratio=%.3f "
             "resource_ok=%d ref_underrun_ratio=%.3f candidate_read_timeouts=%lu result=%s",
             esp_err_to_name(err),
             esp_err_to_name(overlap_err),
             esp_err_to_name(candidate_err),
             request_id && request_id[0] ? request_id : "-",
             o->playback_id[0] ? o->playback_id : "-",
             o->audio_session_id[0] ? o->audio_session_id : "-",
             o->passed ? 1 : 0,
             (unsigned long)o->capture_frames,
             (unsigned long)o->upload_frames,
             (unsigned long)o->queued_frames,
             (unsigned long)o->queue_drops,
             (unsigned long)o->write_failures,
             (unsigned long)o->read_timeouts,
             (unsigned long)o->overlap_ms,
             (double)o->ref_rms,
             (double)o->mic_rms,
             (unsigned)o->heap_internal_min,
             (unsigned)o->dma_largest,
             (double)o->mic2_rms,
             o->dual_mic_ready ? 1 : 0,
             o->dual_mic_voice_ok ? 1 : 0,
             (double)o->dual_mic_corr,
             (double)o->dual_mic_abs_corr,
             (double)o->dual_mic_level_delta_db,
             (double)o->dual_mic_diff_rms,
             (double)o->dual_mic_diff_ratio,
             o->live_cancel_candidate ? 1 : 0,
             (unsigned long)o->live_candidate_elapsed_ms,
             p5_during_playback_mode_or_default(mode),
             cancel_allowed ? 0 : 1,
             c->candidate ? 1 : 0,
             cancel_allowed ? 1 : 0,
             cancel_sent ? 1 : 0,
             (unsigned long)c->duration_ms,
             (unsigned long)c->delay_samples,
             (unsigned long)near_end_candidate_ts,
             (unsigned long)interrupt_pending_ts,
             (unsigned long)local_mute_ts,
             (unsigned long)cancel_turn_sent_ts,
             (unsigned long)stale_drop_effective_ts,
             stale_drop_effective_ts != 0 ? 1 : 0,
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, interrupt_pending_ts),
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, local_mute_ts),
             (long)p3_interrupt_delta_ms(near_end_candidate_ts, cancel_turn_sent_ts),
             c->ready ? 1 : 0,
             c->gate_ok ? 1 : 0,
             c->quality_gate_ok ? 1 : 0,
             c->strong_nearend_ok ? 1 : 0,
             c->mic_ok ? 1 : 0,
             c->energy_ok ? 1 : 0,
             c->nearend_observed ? 1 : 0,
             c->p6_low_ref_nearend_ok ? 1 : 0,
             c->p6_low_ref_normal_voice_ok ? 1 : 0,
             c->p6_high_ref_voice_ok ? 1 : 0,
             c->p6_high_ref_strong_voice_ok ? 1 : 0,
             c->p6_mid_ref_strong_voice_ok ? 1 : 0,
             c->p6_normal_voice_ok ? 1 : 0,
             c->p6_record_candidate ? 1 : 0,
             c->p6_cancel_candidate ? 1 : 0,
             p6_record_observation_category(c),
             (double)c->aec.active_ref_ratio,
             (double)c->aec.active_mic_rms,
             (double)c->aec.active_ref_rms,
             (double)c->aec.active_out_rms,
             (double)c->active_out_to_ref_db,
             (double)c->aec.active_erle_db,
             c->aec.data_plane_ok ? 1 : 0,
             c->aec.quality_ok ? 1 : 0,
             (double)c->aec.active_mic2_rms,
             c->aec.active_dual_mic_voice_ok ? 1 : 0,
             (double)c->aec.active_dual_mic_corr,
             (double)c->aec.active_dual_mic_abs_corr,
             (double)c->aec.active_dual_mic_level_delta_db,
             (double)c->aec.active_dual_mic_diff_rms,
             (double)c->aec.active_dual_mic_diff_ratio,
             c->aec.resource_ok ? 1 : 0,
             (double)c->aec.ref_underrun_ratio,
             (unsigned long)c->aec.read_timeouts,
             passed ? "pass" : "warn");
}

static esp_err_t run_p5_during_playback_candidate_manual(nuwax_ws_client_t *ws,
                                                         uint32_t expected_ws_epoch,
                                                         const char *mode,
                                                         const char *request_id,
                                                         const char *audio_session_id,
                                                         uint32_t duration_ms,
                                                         uint32_t delay_samples,
                                                         bool *out_candidate,
                                                         bool *out_cancel_sent,
                                                         bool *out_passed)
{
    const char *safe_mode = p5_during_playback_mode_or_default(mode);
    if (out_candidate) {
        *out_candidate = false;
    }
    if (out_cancel_sent) {
        *out_cancel_sent = false;
    }
    if (out_passed) {
        *out_passed = false;
    }

    if (!p5_during_playback_mode_is_valid(safe_mode)) {
        nuwax_p5_fullduplex_overlap_probe_result_t overlap = {0};
        nuwax_p3_nearend_candidate_result_t candidate = {
            .duration_ms = p5_candidate_duration_ms(duration_ms),
            .delay_samples = delay_samples,
        };
        log_p5_during_playback_candidate(ESP_ERR_INVALID_ARG,
                                         ESP_ERR_INVALID_ARG,
                                         ESP_ERR_INVALID_ARG,
                                         safe_mode,
                                         request_id,
                                         &overlap,
                                         &candidate,
                                         false,
                                         false,
                                         0,
                                         0,
                                         0,
                                         0,
                                         0,
                                         false);
        return ESP_ERR_INVALID_ARG;
    }

#if !CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
    nuwax_p5_fullduplex_overlap_probe_result_t overlap = {0};
    nuwax_p3_nearend_candidate_result_t candidate = {
        .duration_ms = p5_candidate_duration_ms(duration_ms),
        .delay_samples = delay_samples,
    };
    log_p5_during_playback_candidate(ESP_ERR_NOT_SUPPORTED,
                                     ESP_ERR_NOT_SUPPORTED,
                                     ESP_ERR_NOT_SUPPORTED,
                                     safe_mode,
                                     request_id,
                                     &overlap,
                                     &candidate,
                                     false,
                                     false,
                                     0,
                                     0,
                                     0,
                                     0,
                                     0,
                                     false);
    return ESP_ERR_NOT_SUPPORTED;
#else
    bool cancel_sent = false;
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGI(TAG,
                 "P5-3 during-playback candidate cancelling prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        cancel_auto_followup_capture("p5_candidate");
        vTaskDelay(pdMS_TO_TICKS(NUWAX_P5_CANDIDATE_PRELISTEN_CANCEL_SETTLE_MS));
    }
    if (s_prelisten.pending || s_prelisten.capture_active) {
        ESP_LOGW(TAG,
                 "P5-3 during-playback candidate rejected: prelisten pending=%d active=%d",
                 s_prelisten.pending ? 1 : 0,
                 s_prelisten.capture_active ? 1 : 0);
        return ESP_ERR_INVALID_STATE;
    }
#endif
    nuwax_p5_fullduplex_overlap_probe_result_t overlap = {0};
    nuwax_p3_nearend_candidate_result_t candidate = {0};
    uint32_t near_end_candidate_ts = 0;
    uint32_t interrupt_pending_ts = 0;
    uint32_t local_mute_ts = 0;
    uint32_t cancel_turn_sent_ts = 0;
    uint32_t stale_drop_effective_ts = 0;
    const bool cancel_requested = p5_during_playback_mode_requests_cancel(safe_mode);
    const bool gray_confirm_requested = p5_during_playback_mode_requests_gray_confirm(safe_mode);
    const bool cancel_allowed = cancel_requested && (CONFIG_NUWAX_P6_GRAY_CANCEL_ENABLE ? true : false);
    esp_err_t overlap_err =
        nuwax_p5_fullduplex_overlap_probe_run_ex_if_epoch(
            ws,
            expected_ws_epoch,
            request_id,
            audio_session_id,
            duration_ms,
            delay_samples,
            cancel_allowed,
            &overlap);
    esp_err_t candidate_err = ESP_OK;
    if (overlap_err == ESP_OK) {
        if (overlap.live_cancel_candidate) {
            candidate = overlap.live_candidate;
            candidate_err = ESP_OK;
            near_end_candidate_ts = overlap.live_candidate_ts ? overlap.live_candidate_ts : monotonic_ms();
        } else {
            candidate_err = nuwax_p3_nearend_candidate_run(p5_candidate_duration_ms(duration_ms),
                                                           delay_samples,
                                                           &candidate);
            near_end_candidate_ts = monotonic_ms();
        }
    } else {
        candidate.duration_ms = p5_candidate_duration_ms(duration_ms);
        candidate.delay_samples = delay_samples;
        candidate_err = ESP_ERR_INVALID_STATE;
    }

    /* P6-GRAYCONFIRM-003-2: gray_confirm 模式评估(纯状态机,不发 cancel_turn,不 fade,不改旧 gray_cancel) */
    nuwax_p6_gray_confirm_result_t gray_confirm_result = {0};
    if (gray_confirm_requested && CONFIG_NUWAX_P6_GRAY_CONFIRM_ENABLE) {
        nuwax_p6_gray_confirm_input_t gc_input = {
            .p6_record_candidate = candidate.p6_record_candidate,
            .data_ok = candidate.aec.data_plane_ok,
            .resource_ok = candidate.aec.resource_ok,
            .read_timeouts_ok = (candidate.aec.read_timeouts == 0),
            .confirmation_received = false,
            .confirmation_success = false,
            .timeout = false,
        };
        gray_confirm_result = nuwax_p6_gray_confirm_evaluate(&gc_input);
        ESP_LOGW(TAG,
                 "P6-GRAY-CONFIRM mode=gray_confirm request=%s audio_session_id=%s "
                 "gray_kind=%s gray_candidate=%d confirmed_cancel=%d rejected_gray=%d "
                 "gray_reason=%s p6_record_candidate=%d data_ok=%d resource_ok=%d read_timeouts_ok=%d "
                 "cancel_sent=0 gray_confirm_enabled=1",
                 request_id && request_id[0] ? request_id : "-",
                 audio_session_id && audio_session_id[0] ? audio_session_id : "-",
                 nuwax_p6_gray_confirm_kind_name(gray_confirm_result.kind),
                 gray_confirm_result.gray_candidate ? 1 : 0,
                 gray_confirm_result.confirmed_cancel ? 1 : 0,
                 gray_confirm_result.rejected_gray ? 1 : 0,
                 gray_confirm_result.reason ? gray_confirm_result.reason : "-",
                 candidate.p6_record_candidate ? 1 : 0,
                 candidate.aec.data_plane_ok ? 1 : 0,
                 candidate.aec.resource_ok ? 1 : 0,
                 (candidate.aec.read_timeouts == 0) ? 1 : 0);
    } else if (gray_confirm_requested) {
        ESP_LOGW(TAG,
                 "P6-GRAY-CONFIRM mode=gray_confirm request=%s audio_session_id=%s "
                 "gray_kind=none gray_candidate=0 confirmed_cancel=0 rejected_gray=0 "
                 "gray_reason=feature_disabled p6_record_candidate=%d data_ok=%d resource_ok=%d read_timeouts_ok=%d "
                 "cancel_sent=0 gray_confirm_enabled=0",
                 request_id && request_id[0] ? request_id : "-",
                 audio_session_id && audio_session_id[0] ? audio_session_id : "-",
                 candidate.p6_record_candidate ? 1 : 0,
                 candidate.aec.data_plane_ok ? 1 : 0,
                 candidate.aec.resource_ok ? 1 : 0,
                 (candidate.aec.read_timeouts == 0) ? 1 : 0);
    }

    const bool passed = overlap.passed &&
                        candidate_err == ESP_OK &&
                        candidate.aec.data_plane_ok &&
                        candidate.aec.resource_ok &&
                        candidate.aec.read_timeouts == 0;
    const bool cancel_gate_passed = overlap.passed &&
                                    candidate_err == ESP_OK &&
                                    candidate.aec.data_plane_ok &&
                                    candidate.aec.read_timeouts == 0 &&
                                    candidate.p6_cancel_candidate;
    esp_err_t err = (overlap_err != ESP_OK) ? overlap_err : candidate_err;
    if (cancel_requested && !cancel_allowed) {
        ESP_LOGW(TAG, "P6 gray cancel requested but CONFIG_NUWAX_P6_GRAY_CANCEL_ENABLE is disabled");
    }
    if (cancel_gate_passed && cancel_allowed) {
        interrupt_pending_ts = monotonic_ms();
        clear_auto_followup("p6_gray_cancel");
#if CONFIG_NUWAX_SPEAKER_ENABLE
        local_mute_ts = monotonic_ms();
        nuwax_speaker_playback_fade_cancel("p6_gray_cancel", NUWAX_P6_GRAY_CANCEL_FADE_MS);
        stale_drop_effective_ts = monotonic_ms();
#endif
        if (!ws || expected_ws_epoch == 0U ||
            nuwax_ws_connection_epoch(ws) != expected_ws_epoch ||
            !nuwax_ws_is_connected(ws)) {
            err = ESP_ERR_INVALID_STATE;
        } else {
            char cancel_request_id[40];
            snprintf(cancel_request_id, sizeof(cancel_request_id), "p6gray_%lu", (unsigned long)++s_cancel_turn_request_seq);
            ESP_LOGI(TAG,
                     "P6 gray sending cancel_turn id=%s turn=%s request=%s reason=p6_gray_cancel",
                     cancel_request_id,
                     s_active_turn_id[0] ? s_active_turn_id : "-",
                     request_id && request_id[0] ? request_id : "-");
            esp_err_t cancel_err =
                nuwax_session_send_cancel_turn_until_if_epoch(
                    ws,
                    cancel_request_id,
                    s_active_turn_id,
                    "p6_gray_cancel",
                    esp_timer_get_time() +
                        NUWAX_ASYNC_WS_CONTROL_SEND_TIMEOUT_US,
                    expected_ws_epoch);
            if (cancel_err == ESP_OK) {
                cancel_turn_sent_ts = monotonic_ms();
                cancel_sent = true;
                set_conversation_status_guarded("VOICE", "CANCEL", "p6 gray cancel", true);
                return_to_listening_after_cancel("p6_gray_cancel");
            } else {
                err = cancel_err;
            }
        }
    }

    if (out_candidate) {
        *out_candidate = candidate.p6_record_candidate;
    }
    if (out_cancel_sent) {
        *out_cancel_sent = cancel_sent;
    }
    if (out_passed) {
        *out_passed = passed;
    }
    log_p5_during_playback_candidate(err,
                                     overlap_err,
                                     candidate_err,
                                     safe_mode,
                                     request_id,
                                     &overlap,
                                     &candidate,
                                     cancel_allowed,
                                     cancel_sent,
                                     near_end_candidate_ts,
                                     interrupt_pending_ts,
                                     local_mute_ts,
                                     cancel_turn_sent_ts,
                                     stale_drop_effective_ts,
                                     passed);
    return err;
#endif
}

void app_main(void) {
    atomic_store_explicit(&s_conversation_owner_task,
                          xTaskGetCurrentTaskHandle(),
                          memory_order_release);
#if CONFIG_NUWAX_OTA_ENABLE
    /* Reserve SW3 until the OTA controller has inspected the running image. */
    if (!nuwax_ota_device_inhibit_shutdown_during_boot()) {
        ESP_LOGE(TAG, "failed to reserve SW3 during OTA boot-state inspection");
    }
#endif
    /* Assert the V2.0 PG2 latch before display/audio startup can release SW3. */
    esp_err_t ret = nuwax_power_ctrl_init();
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "power control initialization failed: %s",
                 esp_err_to_name(ret));
        esp_restart();
        vTaskDelay(portMAX_DELAY);
    }
    esp_err_t four_g_power_err = nuwax_4g_power_set(false);
    if (four_g_power_err != ESP_OK) {
        ESP_LOGW(TAG, "optional 4G rail could not be forced off: %s",
                 esp_err_to_name(four_g_power_err));
    }
    set_state(NUWAX_APP_STATE_BOOTING);
    log_firmware_startup_info();
    ESP_LOGI(TAG, "network recovery revision=20260922-network-recovery-v1");
    ESP_LOGI(TAG, "cloud resume revision=20260923-cloud-resume-v1 local_wake=epoch_independent settle_delay_ms=0");
    ESP_LOGI(TAG, "link convergence revision=20260923-link-convergence-v1");
    ESP_LOGI(TAG, "formal cloud OTA test image active version=%s",
             esp_app_get_description()->version);
    ESP_LOGI(TAG, "cloud OTA payload build marker revision=20260808_01 version=%s",
             esp_app_get_description()->version);
    ESP_LOGI(TAG, "OTA verification marker firmware_type=NuwaxAIPartner_V2 version=%s",
             esp_app_get_description()->version);
    ESP_LOGI(TAG,
             "OTA audio isolation and retryable boot mic validation enabled");
    ESP_LOGI(TAG, "OTA v1 request_id-free command dispatch enabled");
    nuwax_board_log_banner();
#if CONFIG_NUWAX_SD_CARD_BOOT_SELFTEST_ENABLE
    /* This is deliberately a one-shot product-compatible probe. The regular
     * firmware never mounts the card, and the test releases the SD host before
     * Wi-Fi, audio and UI services start. */
    nuwax_sd_card_info_t sd_info = {0};
    esp_err_t sd_selftest_err = nuwax_sd_card_mount(&sd_info);
    if (sd_selftest_err == ESP_OK) {
        sd_selftest_err = nuwax_sd_card_read_write_selftest();
    }
    const esp_err_t sd_unmount_err = nuwax_sd_card_unmount();
    if (sd_selftest_err == ESP_OK && sd_unmount_err != ESP_OK) {
        sd_selftest_err = sd_unmount_err;
    }
    ESP_LOGW(TAG,
             "SD boot selftest result=%s mounted=%d capacity=%llu sector=%u max_freq=%ukHz",
             esp_err_to_name(sd_selftest_err),
             sd_info.mounted ? 1 : 0,
             (unsigned long long)sd_info.capacity_bytes,
             (unsigned)sd_info.sector_size,
             (unsigned)sd_info.max_frequency_khz);
#endif
/* OFFLINE_AUDIO_ROUND_20260825_BEGIN */
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    const esp_err_t offline_audio_init_err = nuwax_offline_audio_init();
#if CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE
    const char *offline_replay_route = "test_gateway";
#elif CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_FORMAL_ENABLE
    const char *offline_replay_route = "formal_cloud";
#else
    const char *offline_replay_route = "disabled";
#endif
    ESP_LOGI(TAG, "offline replay route=%s test_panel=%d simulated_network=%d",
             offline_replay_route, NUWAX_TEST_PANEL_ENABLED, NUWAX_TEST_NETWORK_ENABLED);
    const esp_err_t sd_supervisor_err = nuwax_offline_audio_supervisor_start();
    if (sd_supervisor_err != ESP_OK) {
        ESP_LOGW(TAG, "SD supervisor start failed: %s", esp_err_to_name(sd_supervisor_err));
    }
    if (offline_audio_init_err != ESP_OK) {
        /* SD storage is an optional durability path. Never turn a missing,
         * full, or damaged card into a boot failure or audio-owner reset. */
        ESP_LOGW(TAG,
                 "offline audio archive unavailable; online meeting/monitoring remain enabled err=%s",
                 esp_err_to_name(offline_audio_init_err));
    }
#endif
/* OFFLINE_AUDIO_ROUND_20260825_END */
    nuwax_sleep_transaction_init(&s_sleep_transaction);
    nuwax_deferred_sleep_intent_init(&s_deferred_sleep_intent);
    nuwax_notification_init(&s_notification_transaction);
    nuwax_notification_rx_barrier_init(&s_notification_rx_barrier);
    ESP_LOGI(TAG,
             "conversation protocol listen_stop=enabled sleep_transaction_timeout_ms=%u sleep_after_playback_start_timeout_ms=%u sleep_after_playback_stall_timeout_ms=%u",
             (unsigned)NUWAX_SLEEP_TRANSACTION_TIMEOUT_MS,
             (unsigned)NUWAX_SLEEP_AFTER_PLAYBACK_START_TIMEOUT_MS,
             (unsigned)NUWAX_SLEEP_AFTER_PLAYBACK_STALL_TIMEOUT_MS);
    ESP_LOGI(TAG,
             "build config app=%s ws_url=runtime-signed uplink_codec=%s sample_rate=%d frame_ms=%d max_frame_samples=%d speaker=%d wake=%s custom_wake_cmd=%s custom_wake_threshold=%d",
             esp_app_get_description()->version,
             NUWAX_AUDIO_UPLINK_CODEC_NAME,
             CONFIG_NUWAX_VOICE_SAMPLE_RATE,
             CONFIG_NUWAX_VOICE_FRAME_DURATION_MS,
             CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME,
#if CONFIG_NUWAX_SPEAKER_ENABLE
             1,
#else
             0,
#endif
             wake_backend_name(),
#if CONFIG_NUWAX_WAKE_WORD_BACKEND_MULTINET
             CONFIG_NUWAX_CUSTOM_WAKE_WORD_COMMAND,
             CONFIG_NUWAX_CUSTOM_WAKE_WORD_THRESHOLD_PERCENT
#else
             "-",
             0
#endif
    );
    ret = nvs_flash_init();
    if (ret == ESP_ERR_NVS_NO_FREE_PAGES || ret == ESP_ERR_NVS_NEW_VERSION_FOUND) {
        ret = nvs_flash_erase();
        if (ret != ESP_OK) {
            ESP_LOGE(TAG, "NVS recovery erase failed: %s",
                     esp_err_to_name(ret));
            boot_fail_controlled_restart("nvs_recovery_erase");
        }
        ret = nvs_flash_init();
    }
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "NVS initialization failed: %s", esp_err_to_name(ret));
        boot_fail_controlled_restart("nvs_init");
    }
    ESP_ERROR_CHECK_WITHOUT_ABORT(nuwax_device_error_report_init());
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    if (offline_audio_init_err != ESP_OK) {
        (void)nuwax_device_warning_report_enqueue(
            "sd", "archive_init", offline_audio_init_err,
            "booting", 0U, NULL);
    }
#endif
    const bool provisioning_boot_profile =
        nuwax_provision_main_requires_low_memory_boot_profile();
    bool product_touch_ready = !CONFIG_NUWAX_TOUCH_ENABLE;
    bool product_wake_word_ready = !CONFIG_NUWAX_WAKE_WORD_ENABLE;
    bool product_live_aec_ready = !CONFIG_NUWAX_LIVE_AEC_ENABLE;
    nuwax_lvgl_port_set_provisioning_memory_profile(provisioning_boot_profile);
#if CONFIG_NUWAX_OTA_ENABLE
    s_ws_pointer_mutex = xSemaphoreCreateMutex();
    if (s_ws_pointer_mutex == NULL) {
        ESP_LOGE(TAG, "failed to create OTA WebSocket pointer mutex");
        boot_fail_controlled_restart("ota_ws_pointer_mutex");
    }
    const nuwax_ota_device_callbacks_t ota_callbacks = {
        .ctx = NULL,
        .send_json = ota_send_json,
        .request_cloud_reconnect = ota_request_cloud_reconnect,
        .continuous_audio_busy = ota_continuous_audio_busy,
        .prepare_audio_for_update = ota_prepare_audio,
        .show_local_progress = ota_show_local_progress,
        .check_boot_health = ota_check_boot_health,
    };
    ret = nuwax_ota_device_init(&ota_callbacks);
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "OTA device controller init failed: %s",
                 esp_err_to_name(ret));
        boot_fail_controlled_restart("ota_device_init");
    }
    ret = nuwax_firmware_report_init();
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "firmware report init failed: %s",
                 esp_err_to_name(ret));
        boot_fail_controlled_restart("firmware_report_init");
    }
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    ret = init_auto_followup_preroll();
    if (ret != ESP_OK) {
        boot_fail_controlled_restart("auto_followup_preroll");
    }
#endif
    nuwax_head_touch_agent_intent_init(&s_head_touch_agent_intent);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_turn_guard_init(&s_turn_guard);
    s_speaker_owner_event_overflow_epoch = 0U;
    s_speaker_owner_event_overflow_generation = 0U;
    s_speaker_ingress_pending = false;
    s_speaker_ingress_epoch = 0U;
    s_speaker_ingress_generation = 0U;
    atomic_init(&s_reported_speaker_fault_generation, 0U);
    atomic_init(&s_pending_speaker_start_generation, 0U);
    atomic_init(&s_normal_downlink_allowed, false);
    atomic_init(&s_normal_downlink_epoch, 1U);
    s_speaker_owner_events = create_queue_prefer_psram(
        "speaker_owner",
        16U,
        sizeof(nuwax_speaker_owner_event_t),
        NULL);
    if (!s_speaker_owner_events) {
        ESP_LOGE(TAG, "failed to create speaker owner event queue");
        boot_fail_controlled_restart("speaker_owner_queue");
    }
    const nuwax_speaker_playback_callbacks_t speaker_callbacks = {
         .get_state = speaker_callback_get_state,
         .set_state = speaker_callback_set_state,
         .set_state_fast = speaker_callback_set_state,
         .on_start_pending = speaker_callback_on_start_pending,
         .on_tts_start = NULL,
          .on_first_pcm_written = speaker_callback_on_first_pcm_written,
          .on_start_gate_timeout = speaker_callback_on_start_gate_timeout,
          .on_playback_fault = speaker_callback_on_playback_fault,
          .on_playback_progress = speaker_callback_on_playback_progress,
          .on_ingress_progress = speaker_callback_on_ingress_progress,
          .on_playback_done = speaker_callback_on_playback_done,
          .on_stream_end = speaker_callback_on_stream_end,
        .schedule_auto_followup_after_playback = speaker_callback_schedule_auto_followup,
        .return_to_listening_after_cancel = speaker_callback_return_to_listening_after_cancel,
        .on_volume_changed = speaker_callback_on_volume_changed,
    };
    const esp_err_t speaker_init_err =
        nuwax_speaker_playback_init(&speaker_callbacks);
    if (speaker_init_err != ESP_OK) {
        ESP_LOGE(TAG, "failed to initialize speaker playback");
        (void)nuwax_device_error_report_enqueue(
            "error", "speaker", "playback_init", speaker_init_err,
            "booting", 0U, NULL);
        boot_fail_controlled_restart("speaker_playback_init");
    }
    s_current_volume_percent = nuwax_speaker_playback_get_volume_percent();
    nuwax_speaker_playback_set_downlink_admission(1U, false);
#if defined(CONFIG_NUWAX_MUSIC_PLAYBACK_ENABLE) && \
    CONFIG_NUWAX_MUSIC_PLAYBACK_ENABLE
    const esp_err_t music_playback_init_err = nuwax_music_playback_init();
    if (music_playback_init_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "formal music playback disabled after init failure: %s",
                 esp_err_to_name(music_playback_init_err));
    }
#endif
#if CONFIG_NUWAX_MUSIC_URL_TEST_ENABLE
    const esp_err_t music_test_init_err = nuwax_music_url_test_init();
    if (music_test_init_err != ESP_OK) {
        /* A development aid must never prevent the product from booting. */
        ESP_LOGW(TAG, "music URL test disabled after init failure: %s",
                 esp_err_to_name(music_test_init_err));
    }
#endif
#if CONFIG_NUWAX_OTA_ENABLE
    ota_boot_health_mark(OTA_BOOT_HEALTH_SPEAKER_MANAGER);
#endif
#endif
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    /* Security 2 and Wi-Fi authentication need the same scarce internal RAM as
     * the AEC engine. Provisioning boots reserve AEC only after BLE has stopped. */
    esp_err_t live_aec_pool_err = ESP_OK;
    if (!provisioning_boot_profile) {
        /* Preflight runs after model construction and releases its reserve
         * before speaker/wake and background WPA3 association start. */
        ESP_LOGI(TAG,
                 "live AEC reservation deferred until Wi-Fi and local wake bootstrap complete");
    } else {
        ESP_LOGI(TAG, "live AEC reservation deferred until provisioning exits");
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (!provisioning_boot_profile && live_aec_pool_err == ESP_OK) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_LIVE_AEC);
    }
#endif
#endif
    s_touch_trigger = xSemaphoreCreateBinary();
    if (!s_touch_trigger) {
        ESP_LOGE(TAG, "failed to create touch trigger semaphore");
        boot_fail_controlled_restart("touch_trigger_semaphore");
    }
    s_touch_events = xQueueCreate(4, sizeof(nuwax_touch_point_t));
    if (!s_touch_events) {
        ESP_LOGE(TAG, "failed to create touch event queue");
        boot_fail_controlled_restart("touch_event_queue");
    }
    s_shell_actions = create_queue_prefer_psram(
        "shell_actions", 8, sizeof(nuwax_app_shell_result_t), NULL);
    s_session_commands = create_queue_prefer_psram("session_commands",
                                                     NUWAX_SESSION_COMMAND_QUEUE_DEPTH,
                                                     sizeof(nuwax_session_command_envelope_t),
                                                     NULL);
    s_session_notification_commands = create_queue_prefer_psram(
        "session_notification_commands",
        NUWAX_SESSION_NOTIFICATION_QUEUE_DEPTH,
        sizeof(nuwax_session_command_envelope_t),
        NULL);
    s_session_critical_commands = create_queue_prefer_psram(
        "session_critical_commands",
        NUWAX_SESSION_CRITICAL_QUEUE_DEPTH,
        sizeof(nuwax_session_command_envelope_t),
        NULL);
#if CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE
    s_p3_softref_ab_requests = create_queue_prefer_psram(
        "p3_softref_ab_requests", 2, sizeof(p3_softref_ab_request_t), NULL);
#endif
#if CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
    s_p5_during_playback_candidate_requests =
        create_queue_prefer_psram("p5_during_playback_candidate_requests",
                                   2,
                                   sizeof(p5_during_playback_candidate_request_t),
                                   NULL);
#endif
    s_wake_word_events = create_queue_prefer_psram(
        "wake_word_events", 2, sizeof(wake_word_event_t), NULL);
    s_wifi_connect_requests = create_queue_prefer_psram(
        "wifi_connect_requests", 2, sizeof(wifi_connect_request_t), NULL);
    s_wifi_scan_results = create_queue_prefer_psram(
        "wifi_scan_results", 1, sizeof(wifi_scan_report_t), NULL);
    s_wifi_status_reports = create_queue_prefer_psram(
        "wifi_status_reports", 1, sizeof(wifi_status_report_t), NULL);
    s_wifi_connect_mutex = xSemaphoreCreateMutex();
    if (!s_shell_actions || !s_session_commands ||
        !s_session_notification_commands ||
        !s_session_critical_commands ||
#if CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE
        !s_p3_softref_ab_requests ||
#endif
#if CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
        !s_p5_during_playback_candidate_requests ||
#endif
        !s_wake_word_events || !s_wifi_connect_requests || !s_wifi_scan_results ||
        !s_wifi_status_reports || !s_wifi_connect_mutex) {
        ESP_LOGE(TAG, "failed to create app queues");
        boot_fail_controlled_restart("application_queues");
    }
    const nuwax_meeting_mode_callbacks_t meeting_callbacks = {
        .ctx = NULL,
        .can_start = meeting_can_start,
        .acquire_mic = exclusive_audio_acquire_mic,
        .is_playback_active = exclusive_audio_playback_active,
        .fade_and_cancel_playback = exclusive_audio_fade_and_cancel_playback,
        .poll_controls = exclusive_audio_poll_controls,
        .on_state_changed = meeting_state_changed,
    };
    const esp_err_t meeting_init_err =
        nuwax_meeting_mode_init(&s_meeting_mode, &meeting_callbacks);
    if (meeting_init_err != ESP_OK) {
        ESP_LOGE(TAG, "failed to initialize meeting mode controller");
        (void)nuwax_device_error_report_enqueue(
            "error", "meeting", "mode_init", meeting_init_err,
            "booting", 0U, NULL);
        boot_fail_controlled_restart("meeting_mode_init");
    }
    const nuwax_monitoring_mode_callbacks_t monitoring_callbacks = {
        .ctx = NULL,
        .can_start = monitoring_can_start,
        .acquire_mic = exclusive_audio_acquire_mic,
        .is_playback_active = exclusive_audio_playback_active,
        .fade_and_cancel_playback = exclusive_audio_fade_and_cancel_playback,
        .poll_controls = exclusive_audio_poll_controls,
        .on_state_changed = monitoring_state_changed,
    };
    const esp_err_t monitoring_init_err =
        nuwax_monitoring_mode_init(&s_monitoring_mode,
                                    &monitoring_callbacks);
    if (monitoring_init_err != ESP_OK) {
        ESP_LOGE(TAG, "failed to initialize monitoring mode controller");
        (void)nuwax_device_error_report_enqueue(
            "error", "monitoring", "mode_init", monitoring_init_err,
            "booting", 0U, NULL);
        nuwax_meeting_mode_deinit(&s_meeting_mode);
        boot_fail_controlled_restart("monitoring_mode_init");
    }
    /* The power task starts before application queues and sleep state exist.
     * Install the semantic listener only after both exclusive-mode owners are
     * initialized; early boot presses are intentionally not replayed. */
    nuwax_power_ctrl_set_key_event_listener(
        power_key_event_listener, NULL);
    if (!create_app_task_internal(flash_ops_task,
                                  "nuwax_flash_ops",
                                  NUWAX_FLASH_OP_TASK_STACK_BYTES,
                                  NUWAX_FLASH_OP_TASK_PRIORITY,
                                  &s_flash_ops_task)) {
        nuwax_monitoring_mode_deinit(&s_monitoring_mode);
        nuwax_meeting_mode_deinit(&s_meeting_mode);
        return;
    }
#if CONFIG_NUWAX_PROVISION_USB_CONTROL_ENABLE
    esp_err_t usb_control_err = nuwax_provision_usb_control_start(
        usb_control_request_ble_reprovision, NULL);
    if (usb_control_err != ESP_OK) {
        ESP_LOGE(TAG, "failed to start integration USB provisioning control: %s",
                 esp_err_to_name(usb_control_err));
    }
#endif
    nuwax_touch_gesture_set_action_queue(s_shell_actions);
    nuwax_app_shell_set_action_queue(s_shell_actions);
    nuwax_touch_gesture_set_volume_preview_callback(nuwax_speaker_playback_preview_volume_percent);
    nuwax_app_shell_set_reprovision_callback(
        shell_dispatch_set_reprovisioning, NULL);

#if CONFIG_NUWAX_HEAD_TOUCH_ENABLE && \
    (CONFIG_NUWAX_TOUCH_WAKE_ACTION_ENABLE || \
     CONFIG_NUWAX_TOUCH_INTERRUPT_ACTION_ENABLE) && \
    !CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE && \
    !CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME
    /* GPIO8 is a separate head sensor, not the CST816 screen controller.
     * Its worker only posts bounded actions to s_shell_actions. */
    esp_err_t head_touch_err = nuwax_head_touch_control_init(
        head_touch_get_conversation_state,
        head_touch_interaction_allowed,
        NULL);
    ESP_ERROR_CHECK_WITHOUT_ABORT(head_touch_err);
#elif CONFIG_NUWAX_HEAD_TOUCH_ENABLE && \
    !(CONFIG_NUWAX_TOUCH_WAKE_ACTION_ENABLE || \
      CONFIG_NUWAX_TOUCH_INTERRUPT_ACTION_ENABLE)
    ESP_LOGI(TAG,
             "head touch conversation control disabled wake_action=0 interrupt_action=0");
#elif CONFIG_NUWAX_HEAD_TOUCH_ENABLE
    ESP_LOGW(TAG, "head touch product control skipped by isolated diagnostic mode");
#endif

#if CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_UI_RUNTIME
    ESP_LOGW(TAG, "P3-0S resource attribution: display/UI/LVGL runtime skipped");
    ui_ready_store(false);
#else
    esp_err_t display_err = nuwax_display_init();
    ESP_ERROR_CHECK_WITHOUT_ABORT(display_err);
    if (display_err == ESP_OK) {
        /* Display init completed the logo before enabling the backlight.
         * No LVGL writer exists yet; its output gate preserves this frame
         * throughout normal/provisioning UI bootstrap. */
        const esp_err_t boot_backlight_err =
            nuwax_display_backlight_set_percent(100U);
        ESP_ERROR_CHECK_WITHOUT_ABORT(boot_backlight_err);
        ESP_LOGI(TAG,
                 "startup logo retained; waiting for first formal UI frame mode=%s",
                 provisioning_boot_profile ? "provisioning" : "normal");
    }
#if CONFIG_NUWAX_UI_PERF_LOG_ENABLE
    if (display_err == ESP_OK) {
        uint32_t te_edges = 0U;
        const uint32_t te_window_ms = 1000U;
        const esp_err_t te_err = nuwax_display_te_selftest(te_window_ms,
                                                           &te_edges);
        const uint32_t te_hz = te_edges * 1000U / te_window_ms;
        if (te_err != ESP_OK ||
            te_hz < CONFIG_NUWAX_UI_ANIMATION_TARGET_FPS) {
            ESP_LOGW(TAG,
                     "LCD TE acceptance below UI target result=%s edges=%lu window_ms=%lu measured_hz=%lu target_fps=%u",
                     esp_err_to_name(te_err),
                     (unsigned long)te_edges,
                     (unsigned long)te_window_ms,
                     (unsigned long)te_hz,
                     (unsigned)CONFIG_NUWAX_UI_ANIMATION_TARGET_FPS);
        } else {
            ESP_LOGI(TAG,
                     "LCD TE acceptance passed edges=%lu window_ms=%lu measured_hz=%lu target_fps=%u",
                     (unsigned long)te_edges,
                     (unsigned long)te_window_ms,
                     (unsigned long)te_hz,
                     (unsigned)CONFIG_NUWAX_UI_ANIMATION_TARGET_FPS);
        }
    }
#endif
#if CONFIG_NUWAX_OTA_ENABLE
    if (display_err == ESP_OK) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_DISPLAY);
    }
#endif
#endif

#if CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE
    ESP_LOGW(TAG, "P2 audio smoke mode: touch init skipped to keep audio diagnostics isolated");
#elif CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME
    ESP_LOGW(TAG, "P3-0S resource attribution: touch init skipped");
#else
    esp_err_t touch_init_err = nuwax_touch_init();
    ESP_ERROR_CHECK_WITHOUT_ABORT(touch_init_err);
#if CONFIG_NUWAX_OTA_ENABLE
    if (touch_init_err == ESP_OK) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_TOUCH);
    }
#endif
#endif

#if !CONFIG_NUWAX_P1_HW_DIAG_MODE && \
    !CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE && \
    !CONFIG_NUWAX_HW_ACCEPTANCE_MODE && \
    !CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME
    const esp_err_t shake_detector_err =
        nuwax_shake_detector_start(shake_detector_event, NULL);
    if (shake_detector_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "shake detector start unavailable: %s; existing touch and conversation paths remain active",
                 esp_err_to_name(shake_detector_err));
    }
#endif

#if !CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_UI_RUNTIME
    if (display_err != ESP_OK) {
        ESP_LOGE(TAG, "physical display unavailable - LVGL UI disabled");
        ui_ready_store(false);
    } else {
        esp_err_t lvgl_err = nuwax_lvgl_port_init();
        ESP_ERROR_CHECK_WITHOUT_ABORT(lvgl_err);
        if (lvgl_err == ESP_OK) {
#if CONFIG_NUWAX_OTA_ENABLE
            ota_boot_health_mark(OTA_BOOT_HEALTH_LVGL);
#endif
            esp_err_t ui_err = initialize_v28_ui_with_retry(
                provisioning_boot_profile);
            ESP_ERROR_CHECK_WITHOUT_ABORT(ui_err);
#if CONFIG_NUWAX_OTA_ENABLE
            if (ui_err == ESP_OK) {
                ota_boot_health_mark(OTA_BOOT_HEALTH_APP_SHELL);
            }
#endif
        } else {
            ESP_LOGE(TAG, "LVGL UI init failed - UI disabled");
            ui_ready_store(false);
        }
    }
#endif
#if !CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_UI_RUNTIME
    if (display_err == ESP_OK && ui_ready_snapshot()) {
        /* Also retry a transient early backlight error after UI bootstrap. */
        const esp_err_t backlight_err =
            nuwax_display_backlight_set_percent(100U);
        if (backlight_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "display backlight enable deferred after UI bootstrap: %s",
                     esp_err_to_name(backlight_err));
        }
    }
#endif
    nuwax_diagnostics_log_heap_label(TAG, "after_ui_init");

#if CONFIG_NUWAX_BATTERY_SERVICE_ENABLE && \
    !CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE && !CONFIG_NUWAX_HW_ACCEPTANCE_MODE
    esp_err_t battery_service_err = start_battery_service_for_ui();
    ESP_ERROR_CHECK_WITHOUT_ABORT(battery_service_err);
    if (battery_service_err == ESP_OK) service_boot_low_battery_gate();
#endif

#if CONFIG_NUWAX_P1_HW_DIAG_MODE
    ESP_LOGW(TAG, "P1 hardware diagnostic mode active: Wi-Fi/WebSocket path is disabled");
    set_state(NUWAX_APP_STATE_IDLE);
    ESP_ERROR_CHECK_WITHOUT_ABORT(nuwax_touch_start_p1_diag_task());
    nuwax_i2c_bus_log_full_scan("p1_hw_diag_boot", CONFIG_NUWAX_TOUCH_I2C_TIMEOUT_MS);
    nuwax_diagnostics_log_heap_label(TAG, "p1_hw_diag_ready");
    while (true) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
#endif

#if CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE
    ESP_LOGW(TAG, "P2 audio smoke mode active: Wi-Fi/WebSocket path is disabled");
    set_state(NUWAX_APP_STATE_IDLE);
    /* P2-1: audio_board abstraction lifecycle acceptance (repeated start/stop). */
    esp_err_t board_selftest_err = nuwax_audio_board_lifecycle_selftest(5);
    if (board_selftest_err != ESP_OK) {
        ESP_LOGE(TAG, "P2-1 audio_board lifecycle selftest FAILED: %s",
                 esp_err_to_name(board_selftest_err));
    }
    audio_diagnostic_owner_t p2_diagnostic_lease = {0};
    esp_err_t p2_diagnostic_err = audio_diagnostic_begin(&p2_diagnostic_lease);
    if (p2_diagnostic_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "P2 exclusive audio diagnostic lease FAILED: %s",
                 esp_err_to_name(p2_diagnostic_err));
        set_state(NUWAX_APP_STATE_ERROR);
        while (true) {
            vTaskDelay(pdMS_TO_TICKS(1000));
        }
    }
    /* P2-3: ES8311 playback start/stop x100 (codec-managed PA, no hang/brownout). */
    nuwax_vocat_playback_stress_stats_t pb_stress = {0};
    esp_err_t pb_stress_err = nuwax_vocat_audio_board_playback_stress(100, &pb_stress);
    if (pb_stress_err != ESP_OK) {
        ESP_LOGE(TAG, "P2-3 playback stress FAILED: cycles=%d en_err=%lu wr_err=%lu dis_err=%lu",
                 pb_stress.cycles_done, (unsigned long)pb_stress.enable_errors,
                 (unsigned long)pb_stress.write_errors, (unsigned long)pb_stress.disable_errors);
    }
    nuwax_vocat_audio_smoke_stats_t audio_stats = {0};
    esp_err_t audio_smoke_err =
        nuwax_vocat_audio_board_smoke_test(CONFIG_NUWAX_P2_AUDIO_SMOKE_DURATION_MS, &audio_stats);
    if (audio_smoke_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "P2 audio smoke failed: %s tx_err=%lu rx_err=%lu tx_frames=%llu rx_frames=%llu rx_rate=%luHz rate_ok=%d signal=%d rms=%d/%d/%d/%d peak=%d/%d/%d/%d",
                 esp_err_to_name(audio_smoke_err),
                 (unsigned long)audio_stats.tx_errors,
                 (unsigned long)audio_stats.rx_errors,
                 (unsigned long long)audio_stats.tx_frames,
                 (unsigned long long)audio_stats.rx_frames,
                 (unsigned long)audio_stats.rx_rate_hz,
                 audio_stats.rx_rate_ok,
                 audio_stats.signal_present,
                 audio_stats.slot_rms[0],
                 audio_stats.slot_rms[1],
                 audio_stats.slot_rms[2],
                 audio_stats.slot_rms[3],
                 audio_stats.slot_peak[0],
                 audio_stats.slot_peak[1],
                 audio_stats.slot_peak[2],
                 audio_stats.slot_peak[3]);
        set_state(NUWAX_APP_STATE_ERROR);
    } else {
        ESP_LOGI(TAG,
                 "P2 audio smoke passed: tx_frames=%llu rx_frames=%llu rx_rate=%luHz rms=%d/%d/%d/%d peak=%d/%d/%d/%d",
                 (unsigned long long)audio_stats.tx_frames,
                 (unsigned long long)audio_stats.rx_frames,
                 (unsigned long)audio_stats.rx_rate_hz,
                 audio_stats.slot_rms[0],
                 audio_stats.slot_rms[1],
                 audio_stats.slot_rms[2],
                 audio_stats.slot_rms[3],
                 audio_stats.slot_peak[0],
                 audio_stats.slot_peak[1],
                 audio_stats.slot_peak[2],
                 audio_stats.slot_peak[3]);
    }
    nuwax_diagnostics_log_heap_label(TAG, "p2_audio_smoke_done");
    /* P2-5/P3-0: AEC reference identification and health check.
     * Identifies which ES7210 TDM slot carries the playback reference
     * (expected: slot2 = MIC3) and runs the P3-0 health diagnostic. */
    {
        nuwax_vocat_ref_probe_stats_t ref = {0};
        esp_err_t ref_err = nuwax_vocat_audio_board_ref_probe(&ref);
        ESP_LOGW(TAG, "P2-5/P3-0 REF slot probe result=%s ref_slot=%d delta=%d tone=[%d,%d,%d,%d] quiet=[%d,%d,%d,%d]",
                 esp_err_to_name(ref_err), ref.ref_slot, ref.ref_delta,
                 ref.tone_rms[0], ref.tone_rms[1], ref.tone_rms[2], ref.tone_rms[3],
                 ref.quiet_rms[0], ref.quiet_rms[1], ref.quiet_rms[2], ref.quiet_rms[3]);

        /* P3-0: AEC ref health check with Goertzel 1kHz analysis */
        nuwax_aec_ref_health_t health = {0};
        esp_err_t health_err = nuwax_vocat_aec_ref_health_check(-6.0f, 2000, &health);
        apply_hardware_ref_release_gate(&health);
        s_aec_ref_health = health;  /* cache for later use by audio path */
        ESP_LOGW(TAG, "P3-0 AEC ref health result=%s status=%d score=%.3f tone_amp=%.1f "
                 "quiet_rms=%.1f corr=%.3f delay=%d clip_ratio=%.3f slot0_rms=%d passed=%d",
                 esp_err_to_name(health_err), health.status, (double)health.score,
                 (double)health.slot2_tone_amplitude, (double)health.slot2_quiet_rms,
                 (double)health.slot2_correlation, health.estimated_delay_samples, (double)health.slot2_clip_ratio,
                 health.slot0_rms, health.passed);
        /* P3-0: structured log line for script parsing */
        nuwax_diagnostics_log_aec_ref_health(TAG,
                                              health.status,
                                              health.score,
                                              health.slot2_tone_amplitude,
                                              health.slot2_quiet_rms,
                                              health.slot2_correlation,
                                              health.estimated_delay_samples,
                                              health.slot2_clip_ratio,
                                              health.slot0_rms,
                                              health.passed);
        if (!health.passed) {
            ESP_LOGW(TAG, "P3-0 AEC ref health NOT passed — hardware AEC will be "
                     "disabled (L3 not available); fallback to software reference");
        }
    }
    esp_err_t p2_diagnostic_cleanup_err =
        audio_diagnostic_end(&p2_diagnostic_lease);
    if (p2_diagnostic_cleanup_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "P2 exclusive audio diagnostic cleanup FAILED: %s",
                 esp_err_to_name(p2_diagnostic_cleanup_err));
        set_state(NUWAX_APP_STATE_ERROR);
    }
    /* P2-4: exercise the real mic capture path (vocat shared-RX 4-slot TDM ->
     * mono PCM16 downmix) via the same read_pcm16 the ASR/wake consumers use. */
    {
        int mic_rms = 0;
        int mic_peak = 0;
        esp_err_t mic_st = nuwax_mic_input_capture_selftest(1600, &mic_rms, &mic_peak);
        ESP_LOGW(TAG, "P2-4 mic capture selftest result=%s rms=%d peak=%d",
                 esp_err_to_name(mic_st), mic_rms, mic_peak);
    }
    while (true) {
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
#endif

    if (!create_app_task_pinned(shell_task, "nuwax_shell", 4096, 3, 1)) {
        return;
    }
#if CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME
    ESP_LOGW(TAG, "P3-0S resource attribution: touch tasks skipped");
#elif CONFIG_NUWAX_TOUCH_ENABLE
    /* Local controls, including BLE reprovisioning, must work without Wi-Fi or
     * a WebSocket connection.  Start touch handling before network bring-up. */
    esp_err_t touch_runtime_err = nuwax_touch_start_log_task();
    ESP_ERROR_CHECK_WITHOUT_ABORT(touch_runtime_err);
    product_touch_ready = touch_runtime_err == ESP_OK;
    /* The touch driver stages every I2C transaction buffer in internal DRAM,
     * so this large gesture stack can remain in PSRAM and preserve the
     * internal heap required by Wi-Fi and WebSocket startup. */
    if (!create_app_task(nuwax_touch_gesture_task,
                         "nuwax_touch_gesture",
                         CONFIG_NUWAX_TOUCH_GESTURE_TASK_STACK_SIZE,
                         5,
                         NULL)) {
        return;
    }
#endif

#if CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE && CONFIG_NUWAX_P3_AEC_REF_HEALTH_BOOT_GATE_ENABLE
    ESP_LOGW(TAG, "P3 AFE MR prototype enabled: running AEC reference health gate before network start");
    const esp_err_t ref_gate_err =
        run_p3_aec_ref_health_gate("P3-0 boot gate", true);
    if (ref_gate_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "P3 AEC reference release gate failed; hardware reference remains blocked and software/mono fallback stays active: %s",
                 esp_err_to_name(ref_gate_err));
    }
#elif CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE
    ESP_LOGW(TAG, "P3 AFE MR prototype enabled: boot AEC ref health gate disabled; use p3_ref_health command");
#endif

    nuwax_diagnostics_log_heap_label(TAG, "before_wifi_init");
    esp_err_t wifi_init_err = nuwax_wifi_init();
    nuwax_diagnostics_log_heap_label(TAG, wifi_init_err == ESP_OK ? "after_wifi_init" : "wifi_init_failed");

    if (wifi_init_err != ESP_OK) {
        ESP_LOGE(TAG, "Wi-Fi init failed before UI: %s", esp_err_to_name(wifi_init_err));
        (void)nuwax_device_error_report_enqueue(
            "error", "wifi", "manager_init", wifi_init_err,
            "booting", 0U, NULL);
        boot_fail_controlled_restart("wifi_manager_init");
    }

    /* BLE provisioning owns the STA configuration flow on an unprovisioned
     * device. It must run before the normal Kconfig/fallback Wi-Fi path. */
    esp_err_t provision_init_err = nuwax_provision_main_init();
    if (provision_init_err != ESP_OK) {
        ESP_LOGE(TAG, "BLE provisioning init failed: %s",
                 esp_err_to_name(provision_init_err));
        (void)nuwax_device_error_report_enqueue(
            "error", "provisioning", "init", provision_init_err,
            "booting", 0U, NULL);
        (void)nuwax_provision_main_stop();
        boot_fail_controlled_restart("ble_provisioning_init");
    }
    if (nuwax_provision_main_should_auto_enter()) {
        const bool reversible_reprovision =
            nuwax_provision_main_is_reprovisioning();
        const bool missing_provisioned_pair =
            !nuwax_provision_main_has_complete_pair();
        if (!provisioning_boot_profile) {
            ESP_LOGW(TAG,
                     "provisioning requirement appeared after Wi-Fi init; rebooting before BLE into low-memory profile missing_pair=%d",
                     missing_provisioned_pair);
            const esp_err_t recovery_err =
                nuwax_provision_main_request_low_memory_boot_profile();
            (void)nuwax_provision_main_stop();
            if (recovery_err != ESP_OK) {
                ESP_LOGE(TAG, "persist low-memory provisioning reboot failed: %s",
                         esp_err_to_name(recovery_err));
                boot_fail_controlled_restart(
                    "provisioning_low_memory_profile");
            }
            vTaskDelay(pdMS_TO_TICKS(100));
            esp_restart();
        }
        ESP_LOGI(TAG, "Starting BLE provisioning service name=%s reversible=%d",
                 nuwax_provision_main_service_name(), reversible_reprovision);
        set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
        esp_err_t provision_start_err = nuwax_provision_main_start("first_boot");
        if (provision_start_err != ESP_OK) {
            ESP_LOGE(TAG, "BLE provisioning start failed: %s",
                     esp_err_to_name(provision_start_err));
            (void)nuwax_device_error_report_enqueue(
                "error", "provisioning", "start", provision_start_err,
                "wifi_connecting", 0U, NULL);
            (void)nuwax_provision_main_stop();
            nuwax_app_shell_set_provisioning_active(false);
            nuwax_face_clear_provisioning_boot_visual();
            if (reversible_reprovision &&
                rollback_wifi_credentials_guarded() == ESP_OK) {
                ESP_LOGW(TAG, "BLE service failed to start; previous Wi-Fi retained");
            } else {
                boot_fail_controlled_restart("ble_provisioning_start");
            }
        } else {
            nuwax_app_shell_set_provisioning_active(true);
            nuwax_face_clear_provisioning_boot_visual();
            nuwax_app_shell_schedule_provisioning_qr(0U);
            nuwax_provision_outcome_t provision_outcome =
                nuwax_provision_main_run(300000);
            const bool provision_completed =
                provision_outcome == NUWAX_PROVISION_OUTCOME_SUCCESS ||
                provision_outcome == NUWAX_PROVISION_OUTCOME_OLD_WIFI_RECOVERED;
            if (!provision_completed) {
                ESP_LOGE(TAG, "BLE provisioning failed outcome=%d reason=%s",
                         (int)provision_outcome,
                         nuwax_provision_main_last_reason());
                (void)nuwax_device_error_report_enqueue(
                    "error", "provisioning", "transaction", ESP_FAIL,
                    "wifi_connecting", 0U, NULL);
                (void)nuwax_provision_main_stop();
                nuwax_app_shell_set_provisioning_active(false);
                nuwax_face_clear_provisioning_boot_visual();
                if (reversible_reprovision) {
                    esp_err_t rollback_err =
                        rollback_wifi_credentials_guarded();
                    if (rollback_err == ESP_OK) {
                        ESP_LOGW(TAG, "BLE reprovision failed; previous Wi-Fi restored");
                    } else {
                        ESP_LOGE(TAG, "restore previous Wi-Fi failed: %s",
                                 esp_err_to_name(rollback_err));
                        boot_fail_controlled_restart(
                            "ble_provisioning_wifi_rollback");
                    }
                } else {
                    boot_fail_controlled_restart(
                        "ble_provisioning_unrecoverable");
                }
            } else {
                (void)nuwax_provision_main_stop();
                nuwax_app_shell_set_provisioning_active(false);
                nuwax_face_clear_provisioning_boot_visual();
                ESP_LOGI(TAG, "BLE provisioning exited outcome=%d reason=%s",
                         (int)provision_outcome,
                         nuwax_provision_main_last_reason());
            }
        }
    } else {
        /* The manager is not needed during normal application operation. */
        (void)nuwax_provision_main_stop();
        nuwax_app_shell_set_provisioning_active(false);
    }

    if (provisioning_boot_profile && ui_ready_snapshot()) {
        esp_err_t ui_memory_err = ESP_FAIL;
        for (uint32_t attempt = 1; attempt <= 3U; ++attempt) {
            ui_memory_err =
                nuwax_lvgl_port_set_runtime_provisioning_memory(false);
            if (ui_memory_err == ESP_OK) {
                ESP_LOGI(TAG,
                         "post-provisioning LVGL draw buffer restored to internal RAM attempt=%lu",
                         (unsigned long)attempt);
                break;
            }
            if (attempt < 3U) {
                vTaskDelay(pdMS_TO_TICKS(100));
            }
        }
        if (ui_memory_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "post-provisioning LVGL draw buffer remains in PSRAM err=%s; UI continues in reduced-performance mode",
                     esp_err_to_name(ui_memory_err));
        }
    }

    /* NVS accesses retain their Flash safety fence. Complete boot-only
     * reads/config writes before wake starts instead of stopping it afterward. */
    refresh_saved_wifi_list_ui();
    const esp_err_t boot_sta_prepare_err = nuwax_wifi_prepare_boot_config();
    if (boot_sta_prepare_err != ESP_OK) {
        ESP_LOGW(TAG, "boot STA prepare deferred; connection worker will retry err=%s",
                 esp_err_to_name(boot_sta_prepare_err));
    }
    ESP_LOGI(TAG, "boot optimization revision=20260922-startup-v1");
    ESP_LOGI(TAG, "interaction optimization revision=20260922-interaction-v3");

    /* P3-0H: kick off the dual-SSID fallback watcher so when retries on the
     * primary SSID are exhausted, the device flips to the backup SSID and vice
     * versa. The watcher task is no-op when CONFIG_NUWAX_WIFI_SSID_B is empty. */
    nuwax_wifi_start_fallback_watcher();
    /* L3 interrupt level: load NVS gating flag (default OFF). */
    (void)nuwax_p3_l3_init();

    set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    bool boot_wake_parked_for_network = false;
    bool boot_wake_parked_for_aec = false;
    s_wake_model_restore_mutex = xSemaphoreCreateMutexStatic(
        &s_wake_model_restore_mutex_storage);
    s_wake_model_operation_mutex = xSemaphoreCreateMutexStatic(
        &s_wake_model_operation_mutex_storage);
    if (!s_wake_model_restore_mutex || !s_wake_model_operation_mutex) {
        ESP_LOGE(TAG, "failed to create wake model lifecycle mutexes");
        boot_fail_controlled_restart("wake_model_mutexes");
    }
    /* Load and start local wake before the blocking Wi-Fi/DHCP path. Model
     * construction is complete before association starts, so its transient
     * allocation peak cannot collide with WPA2/WPA3 authentication. Runtime
     * wake remains active during network recovery when the measured heap
     * reserve is sufficient. */
    esp_err_t wake_init_err = init_wake_model_serialized();
    product_wake_word_ready = wake_init_err == ESP_OK;
    if (wake_init_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "early wake word detector init failed: %s; wake supervisor will retry",
                 esp_err_to_name(wake_init_err));
    }
#endif
    /* Keep the AEC allocation peak before speaker DMA is anchored and before
     * authentication starts. No wake capture needs to be stopped for preflight. */
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (product_wake_word_ready &&
        nuwax_wake_word_detector_is_running()) {
        const size_t aec_internal = heap_caps_get_free_size(
            MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        const size_t aec_internal_largest =
            heap_caps_get_largest_free_block(
                MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        if (aec_internal < NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_FREE_BYTES ||
            aec_internal_largest <
                NUWAX_LIVE_AEC_PREP_MIN_INTERNAL_LARGEST_BYTES) {
            boot_wake_parked_for_aec = true;
            ESP_LOGI(TAG,
                     "parking early wake for AEC reserve internal=%u largest=%u",
                     (unsigned)aec_internal,
                     (unsigned)aec_internal_largest);
            stop_sleep_wake_word_detector("boot_aec_memory_reserve");
        }
    }
#endif
    if (!s_conversation_live_aec_pool_initialized) {
        live_aec_pool_err = conversation_live_aec_pool_init();
        ESP_ERROR_CHECK_WITHOUT_ABORT(live_aec_pool_err);
        product_live_aec_ready = live_aec_pool_err == ESP_OK;
        if (live_aec_pool_err == ESP_OK) {
            const esp_err_t suspend_err =
                conversation_live_aec_pool_suspend("boot_preflight_complete");
            if (suspend_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "boot live AEC preflight release failed: %s",
                         esp_err_to_name(suspend_err));
                (void)nuwax_device_error_report_enqueue(
                    "error", "audio", "aec_preflight_release", suspend_err,
                    "booting", 0U, NULL);
                live_aec_pool_err = suspend_err;
                product_live_aec_ready = false;
            }
        }
#if CONFIG_NUWAX_OTA_ENABLE
        if (live_aec_pool_err == ESP_OK) {
            ota_boot_health_mark(OTA_BOOT_HEALTH_LIVE_AEC);
        }
#endif
    }
#endif
    /* Anchor the shared I2S board once, after model construction but before
     * the first wake capture. Flash maintenance can then park wake without
     * tearing down and rebuilding the codec/DMA board. */
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!create_app_task(nuwax_speaker_playback_task,
                         "nuwax_speaker",
                         NUWAX_SPEAKER_TASK_STACK_BYTES,
                         NUWAX_SPEAKER_TASK_PRIORITY,
                         NULL)) {
        return;
    }
    nuwax_speaker_playback_prepare_for_tts("boot_preallocate");
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_speaker_playback_output_ready()) {
        ota_boot_health_mark(OTA_BOOT_HEALTH_SPEAKER_OUTPUT);
    }
#endif
#endif
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!create_app_task(wake_word_supervisor_task,
                         "nuwax_wake_guard",
                         NUWAX_WAKE_SUPERVISOR_TASK_STACK_BYTES,
                         NUWAX_WAKE_SUPERVISOR_TASK_PRIORITY,
                         &s_wake_supervisor_task)) {
        return;
    }
    if (wake_init_err == ESP_OK) {
        request_sleep_wake_word_detector("boot_local_wake");
        const bool boot_wake_ready = wait_for_sleep_wake_word_ready(
            NUWAX_BOOT_WAKE_READY_WAIT_MS);
        const size_t wake_internal = heap_caps_get_free_size(
            MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        const size_t wake_internal_largest = heap_caps_get_largest_free_block(
            MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT);
        const size_t wake_dma_largest = heap_caps_get_largest_free_block(
            MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
        const bool network_reserve_ok =
            boot_wake_ready &&
            wake_internal >= NUWAX_BOOT_WAKE_MIN_INTERNAL_FREE_BYTES &&
            wake_internal_largest >=
                NUWAX_BOOT_WAKE_MIN_INTERNAL_LARGEST_BYTES &&
            wake_dma_largest >= NUWAX_BOOT_WAKE_MIN_DMA_LARGEST_BYTES;
        ESP_LOGI(TAG,
                 "early local wake ready=%d network_reserve_ok=%d internal=%u largest=%u dma_largest=%u",
                 boot_wake_ready ? 1 : 0,
                 network_reserve_ok ? 1 : 0,
                 (unsigned)wake_internal,
                 (unsigned)wake_internal_largest,
                 (unsigned)wake_dma_largest);
        if (!network_reserve_ok) {
            boot_wake_parked_for_network = true;
            stop_sleep_wake_word_detector("boot_network_memory_reserve");
        }
    } else {
        /* Defer construction to the supervisor's large PSRAM stack after the
         * blocking Wi-Fi path, instead of retrying on app_main's stack. */
        boot_wake_parked_for_network = true;
    }
    nuwax_diagnostics_log_heap_label(TAG, "after_early_wake_init");
#endif
    nuwax_diagnostics_log_heap_label(TAG, "before_wifi_connect");
    /* Start the primary<->backup fallback watcher before connecting, so retries
     * exhausted events on the active SSID flip to the other slot automatically. */
    nuwax_wifi_start_fallback_watcher();
    /* Association starts through wifi_connect_task after local/audio preflight.
     * Never serialize a 30-second AP timeout into local startup. */
    const bool boot_wifi_connected = nuwax_wifi_is_connected();
    if (!boot_wifi_connected) {
        ESP_LOGI(TAG, "boot Wi-Fi deferred to worker after local preflight");
        nuwax_app_shell_set_bridge_status(false);
        set_wifi_transport_connecting_state("boot_wifi_pending");
        queue_wifi_status_report("recovery_pending",
                                 "RECOVER",
                                 "",
                                 false,
                                 "background_pending");
    } else {
        nuwax_diagnostics_log_heap_label(TAG, "after_wifi_connect");
        char ssid[33] = {0};
        char ip[16] = {0};
        nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));
        nuwax_app_shell_set_wifi_status(ssid, ip);
        queue_wifi_status_report("connected", ssid, ip, true, "boot connected");
    }


#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (wake_init_err != ESP_OK) {
        ESP_LOGW(TAG,
                 "retrying wake model construction on app_main internal stack after network/audio preflight");
        wake_init_err = init_wake_model_serialized();
        product_wake_word_ready = wake_init_err == ESP_OK;
        if (wake_init_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "wake model retry on app_main internal stack failed: %s",
                     esp_err_to_name(wake_init_err));
            (void)nuwax_device_error_report_enqueue(
                "error", "wake", "model_init", wake_init_err,
                "booting", 0U, NULL);
        }
    }
    if (boot_wake_parked_for_network || boot_wake_parked_for_aec) {
        if (wake_init_err == ESP_OK) {
            request_sleep_wake_word_detector("boot_network_ready");
        }
        if (wake_init_err != ESP_OK ||
            !wait_for_sleep_wake_word_ready(NUWAX_WAKE_READY_WAIT_MS)) {
            ESP_LOGW(TAG,
                     "local wake recovery is pending after Wi-Fi; supervisor will retry");
        }
    }
    product_wake_word_ready = nuwax_wake_word_detector_is_ready();
    if (!product_wake_word_ready && wake_init_err == ESP_OK) {
        /* The detector can be between an ownership stop and supervisor re-arm
         * when the one-shot product-readiness snapshot is taken. Give the
         * supervisor one bounded convergence window so PRODUCT_READY does not
         * report wake_word=0 while the local wake owner is recoverable. */
        request_sleep_wake_word_detector("product_ready_recheck");
        product_wake_word_ready = wait_for_sleep_wake_word_ready(
            NUWAX_BOOT_WAKE_READY_WAIT_MS);
        if (!product_wake_word_ready) {
            ESP_LOGW(TAG,
                     "product readiness wake detector recheck still pending; supervisor will continue recovery");
        }
    }
    nuwax_diagnostics_log_heap_label(TAG, "after_wake_init");
#endif
    if (!create_app_task(wifi_scan_task, "nuwax_wifi_scan", 8192, 4, &s_wifi_scan_task)) {
        return;
    }
    if (!create_app_task(wifi_connect_task, "nuwax_wifi_conn", 4096, 4, NULL)) {
        return;
    }
    /* Model construction and AEC preflight have finished. Start association
     * while final local services are registered, rather than waiting for the
     * first cloud-owner iteration. Keep the original main-loop fallback when
     * the remaining internal/DMA reserve is too small for safe overlap. */
    if (heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) >= 32768U &&
        heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT) >= 16384U &&
        heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_DMA) >= 8192U) {
        (void)recover_wifi_if_needed();
    }
#if CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE
    if (!create_app_task(p3_softref_ab_fast_task, "p3_softref_ab", 8192, 5, NULL)) {
        return;
    }
#endif
#if CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
    if (!create_app_task(p5_during_playback_candidate_fast_task,
                         "p5_candidate",
                         NUWAX_P5_CANDIDATE_TASK_STACK_BYTES,
                         5,
                         NULL)) {
        return;
    }
#endif


#if CONFIG_NUWAX_OTA_ENABLE && CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    bool ota_pending_verify = false;
    if (nuwax_ota_main_running_image_pending_verify(&ota_pending_verify) == ESP_OK &&
        ota_pending_verify) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        const bool audio_board_anchored =
            nuwax_speaker_playback_output_ready();
#else
        const bool audio_board_anchored = true;
#endif
        if (!audio_board_anchored) {
            ESP_LOGE(TAG,
                     "OTA boot mic health deferred because audio board anchor is unavailable");
        } else {
            char mic_detail[128] = {0};
            const esp_err_t mic_health_err =
                ota_validate_boot_mic_input(mic_detail,
                                            sizeof(mic_detail));
            if (mic_health_err == ESP_ERR_NOT_FINISHED) {
                ESP_LOGW(TAG, "OTA boot mic health deferred: %s", mic_detail);
            } else if (mic_health_err != ESP_OK) {
                ESP_LOGE(TAG, "OTA boot mic health failed: %s", mic_detail);
            }
        }
    }
#endif

#if CONFIG_NUWAX_OTA_ENABLE
    ota_boot_health_mark(OTA_BOOT_HEALTH_RUNTIME_TASKS);
#endif

    const nuwax_product_ready_inputs_t ready_inputs = {
        .core_tasks_ready = true,
        .wifi_ready = nuwax_wifi_is_connected(),
#if CONFIG_NUWAX_SPEAKER_ENABLE
        .speaker_required = true,
        .speaker_ready = nuwax_speaker_playback_output_ready(),
#else
        .speaker_required = false,
        .speaker_ready = true,
#endif
#if CONFIG_NUWAX_UI_USE_LVGL
        .ui_required = true,
        .ui_ready = ui_ready_snapshot(),
#else
        .ui_required = false,
        .ui_ready = true,
#endif
        .touch_required = CONFIG_NUWAX_TOUCH_ENABLE != 0,
        .touch_ready = product_touch_ready,
        .wake_word_required = CONFIG_NUWAX_WAKE_WORD_ENABLE != 0,
        .wake_word_ready = product_wake_word_ready,
        .live_aec_required = CONFIG_NUWAX_LIVE_AEC_ENABLE != 0,
        .live_aec_ready = product_live_aec_ready,
        .hardware_ref_required =
            CONFIG_NUWAX_VOCAT_SLOT2_AEC_REF_ENABLE != 0,
        .hardware_ref_released =
            nuwax_audio_board_get_hardware_ref_health() ==
            NUWAX_HARDWARE_REF_HEALTH_PASSED,
    };
    nuwax_product_ready_snapshot_t ready_snapshot = {0};
    esp_err_t product_ready_err =
        nuwax_product_ready_publish(&ready_inputs, &ready_snapshot);
    if (product_ready_err != ESP_OK) {
        const uint32_t fatal_blockers =
            ready_snapshot.blockers & ~NUWAX_PRODUCT_READY_BLOCK_WIFI;
        if (fatal_blockers != 0U) {
            ESP_LOGE(TAG,
                     "product readiness has fatal blockers=0x%08lx all_blockers=0x%08lx",
                     (unsigned long)fatal_blockers,
                     (unsigned long)ready_snapshot.blockers);
            boot_fail_controlled_restart("product_readiness_fatal");
        }
        ESP_LOGW(TAG,
                 "product readiness is network-degraded blockers=0x%08lx; local services remain active while recovery continues",
                 (unsigned long)ready_snapshot.blockers);
    }

    /* Reaching the owner loop means all mandatory local resources are alive.
     * A missing Wi-Fi link is recoverable and must not extend a prior boot
     * failure backoff into later healthy restarts. */
    s_boot_failure_restart_streak = 0U;

    nuwax_diagnostics_log_heap_label(TAG, "after_boot");
    nuwax_diagnostics_log_current_task_stack(TAG, "after_boot");

    /* The RX and TX workers retain this address while a connection is alive.
     * Keep one owner object for the lifetime of app_main so a failed close can
     * be retried without ever reusing storage still referenced by a worker. */
    nuwax_ws_client_t ws;
    nuwax_ws_init(&ws);
    ret = app_task_watchdog_register();
    if (ret != ESP_OK) {
        ESP_LOGE(TAG, "application task watchdog registration failed: %s",
                 esp_err_to_name(ret));
        boot_fail_controlled_restart("application_task_watchdog");
    }
    ESP_LOGI(TAG,
             "application task watchdog armed timeout_s=%d panic=enabled",
             CONFIG_ESP_TASK_WDT_TIMEOUT_S);
    atomic_store_explicit(&s_cloud_owner_ready, true, memory_order_release);

    while (true) {
        app_task_watchdog_checkpoint();
        /* Also run offline, before a Wi-Fi retry or a parked network owner. */
        service_power_key_events(&ws);
        /* The same idle gate applies offline: never delay pending playback
         * completion or an interaction while compacting diagnostic NVS. */
        service_idle_diagnostic_persistence();
        (void)service_wake_model_restore_owner();
        service_ota_wake_detector_recovery();
        service_exclusive_audio_sleep_reconcile();
        if (service_cloud_binding_reprovision()) {
            vTaskDelay(pdMS_TO_TICKS(20));
            continue;
        }
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            /* Never acknowledge the handoff while transport workers still
             * reference this owner. Failed closes retain storage for retry. */
            const esp_err_t park_close_err = nuwax_ws_owner_close(&ws);
            observe_ws_owner_cleanup_result(&ws, park_close_err,
                                            "ble_reprovision_park");
            if (park_close_err != ESP_OK) {
                vTaskDelay(pdMS_TO_TICKS(20));
                continue;
            }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            offline_mode_lease_store(false);
            (void)nuwax_offline_audio_request_stop(false);
#endif
            nuwax_meeting_mode_notify_ws_disconnected(&s_meeting_mode);
            nuwax_monitoring_mode_notify_ws_disconnected(&s_monitoring_mode);
            atomic_store_explicit(&s_cloud_owner_parked, true,
                                  memory_order_release);
            ESP_LOGI(TAG, "cloud owner parked; BLE provisioning owns network");
            while (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                        memory_order_acquire)) {
                app_task_watchdog_checkpoint();
                service_power_key_events(&ws);
                (void)service_wake_model_restore_owner();
                vTaskDelay(pdMS_TO_TICKS(20));
            }
            atomic_store_explicit(&s_cloud_owner_parked, false,
                                  memory_order_release);
            ESP_LOGI(TAG, "cloud owner resumed after BLE provisioning");
            set_cloud_transport_connecting_state("ble_reprovision_resume");
            continue;
        }
        /* The test switch must remain operable after the cloud socket has
         * already been closed.  Drain local shell actions before any network
         * recovery decision, then hold the cloud owner parked while the
         * physical STA association stays available for the replay gateway. */
        drain_shell_actions(&ws);
#if CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE
        if (nuwax_wifi_simulated_offline()) {
            if (nuwax_ws_is_connected(&ws)) {
                (void)nuwax_ws_force_close_if_epoch(
                    &ws, nuwax_ws_connection_epoch(&ws));
            }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            /* The simulator keeps the physical STA associated while the
             * cloud socket is intentionally down. Keep retrying the offline
             * capture handoff in this branch; otherwise a transient SD
             * admission failure leaves the whole simulated outage unrecorded. */
            service_offline_capture_retry_disconnected();
#endif
            nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_DISCONNECTED);
            vTaskDelay(pdMS_TO_TICKS(50));
            continue;
        }
#endif
        if (s_awake_resume_after_ws_reconnect &&
            elapsed_ms(monotonic_ms(),
                       s_awake_disconnect_ms +
                           NUWAX_AWAKE_WS_RESUME_GRACE_MS)) {
            ESP_LOGW(TAG,
                     "conversation awake reconnect grace expired before WebSocket recovery; entering sleep");
            enter_sleeping_conversation_state("ws_reconnect_grace_expired");
        }
        service_conversation_live_aec_pool_recovery();
        /* This owner is the only task allowed to restart wake capture after
         * provisioning or a cloud outage. Keep wake functional even while
         * Wi-Fi/WebSocket recovery is still pending. */
        service_offline_wake_word_detector("network_offline");
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        /* A transient SD/MIC allocation failure must not silently discard the
         * remainder of an exclusive meeting/monitoring session. Retry the
         * offline owner with bounded backoff while the cloud is unavailable;
         * the retry is skipped during provisioning/OTA and never blocks the
         * network recovery decision. */
        service_offline_capture_retry_disconnected();
#endif
        if (!recover_wifi_if_needed()) {
            /* Recovery/backoff runs independently. Keep servicing UI, mode
             * handoffs and the watchdog even during an indefinitely absent AP. */
            vTaskDelay(pdMS_TO_TICKS(50));
            continue;
        }
        ESP_ERROR_CHECK_WITHOUT_ABORT(nuwax_time_sync_once());
        set_cloud_transport_connecting_state("cloud_connect_begin");
        uint32_t barge_dispatch_binding = 0U;
        store_cloud_connection_state(false, false, false);
        /* set_state() intentionally deduplicates equal app states. Publish the
         * transport attempt explicitly so every retry moves the cloud icon
         * from DISCONNECTED back to CONNECTING. */
        nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_CONNECTING);
        nuwax_cloud_config_t cloud_config = {0};
        esp_err_t cloud_config_err = nuwax_cloud_config_get(&cloud_config);
        if (cloud_config_err != ESP_OK) {
            log_cloud_connect_failure("config_load",
                                      NULL,
                                      &ws,
                                      cloud_config_err);
            ESP_LOGE(TAG, "No dynamic cloud configuration is available: %s",
                     esp_err_to_name(cloud_config_err));
            nuwax_app_shell_set_bridge_status(false);
            set_cloud_transport_connecting_state("cloud_config_load");
            delay_before_cloud_reconnect("config_load", 0, cloud_config_err);
            continue;
        }
        nuwax_ws_config_t ws_config = {
            .url = cloud_config.cloud_url,
            .token = cloud_config.device_secret,
            .on_text = on_ws_text,
            .on_binary = on_ws_binary,
            .on_rx_activity = on_ws_rx_activity,
            .on_handshake_verified = on_ws_handshake_authenticated,
            .connect_cancelled = cloud_connect_cancelled_for_reprovision,
            .user_ctx = &ws,
        };

        esp_err_t err = nuwax_ws_connect(&ws, &ws_config);
        if (err != ESP_OK) {
            observe_ws_owner_cleanup_result(
                &ws, err, "websocket_connect_failure");
            log_cloud_connect_failure("websocket_connect",
                                      &cloud_config,
                                      &ws,
                                      err);
            secure_zero_memory(cloud_config.device_secret,
                               sizeof(cloud_config.device_secret));
            ESP_LOGE(TAG, "WebSocket connect failed: %s", esp_err_to_name(err));
            set_cloud_transport_connecting_state("websocket_connect_failure");
            const int http_status = nuwax_ws_last_http_status(&ws);
            const bool transient_gateway =
                cloud_http_status_is_transient(http_status);
            if (http_status == 401 || http_status == 403) {
                mark_cloud_auth_failed();
                s_cloud_http_rebind_pending = true;
            } else {
                mark_cloud_disconnected();
            }
            /* Cloud reachability never changes the already successful Wi-Fi
             * provisioning result or triggers an SSID switch. */
            if (err == ESP_ERR_INVALID_RESPONSE) {
                ESP_LOGW(TAG,
                         "WebSocket handshake was rejected by server; keeping current Wi-Fi SSID transient=%d",
                         transient_gateway ? 1 : 0);
            } else if (!nuwax_wifi_is_connected() && recover_wifi_if_needed()) {
                continue;
            }
            if (!s_cloud_http_rebind_pending) {
                delay_before_cloud_reconnect("websocket_connect", http_status,
                                             err);
            }
            continue;
        }
        nuwax_ws_owner_close_recovery_reset(&s_ws_owner_close_recovery);
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            secure_zero_memory(cloud_config.device_secret,
                               sizeof(cloud_config.device_secret));
            ESP_LOGI(TAG,
                     "WebSocket connected during BLE reprovision handoff; closing before publish");
            (void)nuwax_ws_force_close_if_epoch(
                &ws, nuwax_ws_connection_epoch(&ws));
            const esp_err_t close_err = nuwax_ws_owner_close(&ws);
            observe_ws_owner_cleanup_result(
                &ws, close_err, "ble_reprovision_handoff");
            if (close_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "WebSocket owner close incomplete during BLE reprovision handoff stage=%d err=%s",
                         (int)nuwax_ws_owner_close_failure_stage(&ws),
                         esp_err_to_name(close_err));
            }
            discard_connection_bound_queues("ble_reprovision_handoff");
            continue;
        }

#if CONFIG_NUWAX_OTA_ENABLE
        xSemaphoreTake(s_ws_pointer_mutex, portMAX_DELAY);
        publish_active_ws(&ws);
        xSemaphoreGive(s_ws_pointer_mutex);
#else
        publish_active_ws(&ws);
#endif
        reset_application_keepalive(&ws);
        barge_dispatch_binding = nuwax_barge_dispatcher_bind(&ws);
        if (barge_dispatch_binding == 0U) {
            ESP_LOGE(TAG, "barge-in protocol dispatcher bind failed");
        }
        ws_mark_rx_activity();
        esp_err_t hello_err = nuwax_session_send_hello(
            &ws, cloud_config.device_secret);
        ESP_ERROR_CHECK_WITHOUT_ABORT(hello_err);
        if (hello_err != ESP_OK) {
            log_cloud_connect_failure("hello_send",
                                      &cloud_config,
                                      &ws,
                                      hello_err);
        }
        secure_zero_memory(cloud_config.device_secret,
                           sizeof(cloud_config.device_secret));
        if (hello_err != ESP_OK) {
            ESP_LOGE(TAG, "cloud hello send failed; closing session");
            mark_cloud_disconnected();
            (void)nuwax_ws_close_if_epoch(
                &ws,
                nuwax_ws_connection_epoch(&ws),
                NUWAX_WS_CLOSE_CAUSE_HEARTBEAT_EXPIRED);
        } else {
            /* The formal cloud does not require a hello ACK. An immediate
             * application ping obtains positive peer activity quickly when no
             * bootstrap command is waiting, without gating normal traffic. */
            const int64_t ping_now_ms = now_ms_i64();
            esp_err_t ping_err = nuwax_session_send_ping(&ws, ping_now_ms);
            if (ping_err != ESP_OK) {
                ESP_LOGW(TAG, "initial cloud ping send failed: %s",
                         esp_err_to_name(ping_err));
            } else {
                note_application_keepalive_sent(&ws, ping_now_ms);
            }
        }
        if (!nuwax_ws_is_connected(&ws)) {
            mark_cloud_disconnected();
            nuwax_barge_dispatcher_unbind(&ws, barge_dispatch_binding);
#if CONFIG_NUWAX_OTA_ENABLE
            xSemaphoreTake(s_ws_pointer_mutex, portMAX_DELAY);
            unpublish_active_ws();
            xSemaphoreGive(s_ws_pointer_mutex);
#else
            unpublish_active_ws();
#endif
            const esp_err_t close_err = nuwax_ws_owner_close(&ws);
            observe_ws_owner_cleanup_result(
                &ws, close_err, "hello_failure");
            if (close_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "WebSocket owner close incomplete after hello failure stage=%d err=%s; retaining owner for retry",
                         (int)nuwax_ws_owner_close_failure_stage(&ws),
                         esp_err_to_name(close_err));
            }
            discard_connection_bound_queues("hello_failure");
            delay_before_cloud_reconnect("hello_failure", 0, hello_err);
            continue;
        }
        const uint32_t cloud_ready_epoch = nuwax_ws_connection_epoch(&ws);
        esp_err_t cloud_ready_err = ESP_OK;
        do {
            cloud_ready_err = wait_for_cloud_service_ready(&ws);
            if (cloud_ready_err != ESP_OK && nuwax_ws_is_connected(&ws) &&
                !atomic_load_explicit(&s_reprovision_quiesce_requested,
                                      memory_order_acquire)) {
                ESP_LOGW(TAG,
                         "cloud-ready processing error retained on heartbeat-owned WebSocket err=%s; retrying in place",
                         esp_err_to_name(cloud_ready_err));
                vTaskDelay(pdMS_TO_TICKS(250));
            }
        } while (cloud_ready_err != ESP_OK && nuwax_ws_is_connected(&ws) &&
                 !atomic_load_explicit(&s_reprovision_quiesce_requested,
                                       memory_order_acquire));
        if (cloud_ready_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "cloud application did not become ready: %s; audio remains stopped",
                     esp_err_to_name(cloud_ready_err));
            if (nuwax_ws_is_connected(&ws) &&
                atomic_load_explicit(&s_reprovision_quiesce_requested,
                                     memory_order_acquire)) {
                (void)nuwax_ws_force_close_if_epoch(
                    &ws, nuwax_ws_connection_epoch(&ws));
            }
            mark_cloud_disconnected();
            nuwax_barge_dispatcher_unbind(&ws, barge_dispatch_binding);
#if CONFIG_NUWAX_OTA_ENABLE
            xSemaphoreTake(s_ws_pointer_mutex, portMAX_DELAY);
            unpublish_active_ws();
            xSemaphoreGive(s_ws_pointer_mutex);
#else
            unpublish_active_ws();
#endif
            const esp_err_t close_err = nuwax_ws_owner_close(&ws);
            observe_ws_owner_cleanup_result(
                &ws, close_err, "cloud_ready_failure");
            if (close_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "WebSocket owner close incomplete after cloud-ready failure stage=%d err=%s",
                         (int)nuwax_ws_owner_close_failure_stage(&ws),
                         esp_err_to_name(close_err));
            }
            discard_connection_bound_queues("cloud_ready_failure");
            if (cloud_provision_required_epoch() != cloud_ready_epoch) {
                delay_before_cloud_reconnect("cloud_ready_failure", 0,
                                             cloud_ready_err);
            } else {
                ESP_LOGI(TAG,
                         "cloud reconnect skipped for unbound device epoch=%lu; BLE rebind will be serviced by connection owner",
                         (unsigned long)cloud_ready_epoch);
            }
            continue;
        }
        cloud_reconnect_backoff_reset();
#if CONFIG_NUWAX_OTA_ENABLE
        const uint32_t firmware_report_epoch = nuwax_ws_connection_epoch(&ws);
        const esp_err_t firmware_report_err = nuwax_firmware_report_service(
            &ws, firmware_report_epoch, monotonic_ms());
        if (firmware_report_err != ESP_OK &&
            firmware_report_err != ESP_ERR_NOT_FINISHED) {
            /* Version reporting is reliable but deliberately non-gating. A
             * later keepalive or reconnect retries the same boot transaction
             * without delaying wake, conversation, meeting, or monitoring. */
            ESP_LOGW(TAG,
                     "initial boot firmware report deferred epoch=%lu err=%s",
                     (unsigned long)firmware_report_epoch,
                     esp_err_to_name(firmware_report_err));
        }
#endif
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        if ((offline_mode_lease_pending() ||
             nuwax_offline_audio_has_ready()) &&
            nuwax_ws_is_connected(&ws)) {
            (void)service_offline_audio_handoff(&ws);
            service_exclusive_audio_sleep_reconcile();
        }
#endif
        if (nuwax_ws_is_connected(&ws)) {
            s_consecutive_post_end_response_timeouts = 0U;
#if CONFIG_NUWAX_SPEAKER_ENABLE
            nuwax_speaker_playback_apply_current_volume();
#endif
            schedule_current_volume_snapshot();
            service_pending_volume_report(&ws);
            bool resume_awake = false;
            if (s_awake_resume_after_ws_reconnect) {
                const uint32_t reconnect_now_ms = monotonic_ms();
                resume_awake =
                    !elapsed_ms(reconnect_now_ms,
                                s_awake_disconnect_ms +
                                    NUWAX_AWAKE_WS_RESUME_GRACE_MS) &&
                    nuwax_awake_session_state_is_active(&s_awake_session) &&
                    nuwax_awake_session_state_remaining_ms(
                        &s_awake_session, reconnect_now_ms) > 0U;
                s_awake_resume_after_ws_reconnect = false;
                s_awake_disconnect_ms = 0U;
            }
            if (resume_awake) {
                ESP_LOGI(TAG,
                         "WebSocket recovered; resuming awake conversation remaining_ms=%lu generation=%lu",
                         (unsigned long)nuwax_awake_session_state_remaining_ms(
                             &s_awake_session, monotonic_ms()),
                         (unsigned long)nuwax_awake_session_state_generation(
                             &s_awake_session));
                if (!arm_ws_reconnect_audio_recovery(&ws, "ws_reconnect")) {
                    enter_sleeping_conversation_state(
                        "ws_reconnect_recovery_arm_failed");
                } else if (recover_awake_conversation_after_ws_reconnect(
                               &ws, "ws_reconnect") ==
                           NUWAX_WS_RECOVERY_FALLBACK_SLEEP) {
                    clear_ws_reconnect_audio_recovery();
                    enter_sleeping_conversation_state("ws_reconnect_expired");
                }
            } else if (meeting_or_monitoring_mode_blocks_sleep() ||
                       atomic_load_explicit(&s_reprovision_quiesce_requested,
                                            memory_order_acquire)) {
                /* A meeting/monitoring lease may have just been restored from
                 * an offline archive.  Do not overwrite its controller/UI
                 * state with the generic boot-ready sleeping transition. */
                ESP_LOGI(TAG,
                         "WebSocket recovered with exclusive audio lease; preserving mode state");
            } else if (conversation_state_current() != NUWAX_APP_STATE_SLEEPING) {
                enter_sleeping_conversation_state("boot_ready");
            }
#if CONFIG_NUWAX_SPEAKER_ENABLE
            /* Volume synchronization above queues an owner event. Drain it
             * now, then enter the normal control loop without a blind delay. */
            drain_speaker_owner_events();
#endif
            if (resume_awake &&
                nuwax_awake_session_state_is_active(&s_awake_session) &&
                !s_ws_audio_recovery.pending &&
                !exclusive_audio_owner_active() &&
                !exclusive_audio_mode_blocks_normal_audio() &&
                !nuwax_app_shell_blocks_auto_followup() &&
                !s_prelisten.pending && !s_prelisten.capture_active) {
                ESP_LOGE(TAG,
                         "WebSocket reconnect recovery lost its audio target; forcing sleeping wake-ready state");
                enter_sleeping_conversation_state(
                    "ws_reconnect_recovery_invariant");
            }

            while (nuwax_ws_is_connected(&ws)) {
                app_task_watchdog_checkpoint();
                if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                         memory_order_acquire)) {
                    (void)nuwax_ws_force_close_if_epoch(
                        &ws, nuwax_ws_connection_epoch(&ws));
                    break;
                }
                service_conversation_live_aec_pool_recovery();
                service_ota_wake_detector_recovery();
                service_pending_ws_reconnect_audio_recovery(&ws);
                if (nuwax_notification_blocks_conversation(
                        &s_notification_transaction)) {
                    /* Notification owns RX audio and speaker lifecycle. Keep
                     * control traffic alive without constructing a normal
                     * microphone uplink context every 100 ms. */
                    drain_session_commands_limited(&ws, 4U);
                    (void)drain_shell_actions_preserving_listen_control(
                        &ws);
                    if (nuwax_notification_blocks_conversation(
                            &s_notification_transaction)) {
                        (void)service_application_keepalive(
                            &ws, "notification_wait");
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
                }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
                if (offline_mode_lease_pending() ||
                    nuwax_offline_audio_capture_running() ||
                    nuwax_offline_audio_is_active() ||
                    nuwax_offline_audio_has_ready()) {
                    (void)service_offline_audio_handoff(&ws);
                    service_exclusive_audio_sleep_reconcile();
                    if ((nuwax_offline_audio_capture_running() &&
                         !nuwax_meeting_mode_has_pending(&s_meeting_mode) &&
                         !nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) ||
                        (offline_mode_lease_pending() &&
                         !nuwax_meeting_mode_has_pending(&s_meeting_mode) &&
                         !nuwax_monitoring_mode_has_pending(&s_monitoring_mode))) {
                        (void)service_application_keepalive(
                            &ws, "offline_audio_handoff");
                        if (nuwax_audio_terminal_recovery_pending()) {
                            (void)service_audio_terminal_recovery(&ws);
                        }
                        drain_session_commands_limited(&ws, 4U);
                        (void)drain_shell_actions_preserving_listen_control(
                            &ws);
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
                }
#endif
                const bool exclusive_mode_run_requested =
                    exclusive_audio_mode_blocks_normal_audio();
                if (exclusive_mode_run_requested &&
                    !nuwax_meeting_mode_has_pending(&s_meeting_mode) &&
                    !nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) {
                    (void)service_application_keepalive(&ws, "audio_owner_wait");
                    drain_session_commands_limited(&ws, 4U);
                    (void)drain_shell_actions_preserving_listen_control(&ws);
                    service_exclusive_audio_sleep_reconcile();
                    conversation_owner_wait_ms(20U);
                    continue;
                }
                err = run_audio_source(&ws);
                if (err != ESP_OK) {
                    if (atomic_load_explicit(
                            &s_reprovision_quiesce_requested,
                            memory_order_acquire)) {
                        ESP_LOGI(TAG,
                                 "audio source yielded to BLE provisioning; closing WebSocket owner");
                        (void)nuwax_ws_force_close_if_epoch(
                            &ws, nuwax_ws_connection_epoch(&ws));
                        break;
                    }
                    if (nuwax_audio_terminal_recovery_pending()) {
                        /* Serialize new MIC ownership, but keep the control
                         * plane alive while the old terminal retries on the
                         * healthy WebSocket. Remote sleep/mode commands and
                         * local Wi-Fi, volume, power and touch controls must
                         * continue to converge during this bounded wait. */
                        (void)service_audio_terminal_recovery(&ws);
                        (void)service_application_keepalive(
                            &ws, "terminal_recovery");
                        drain_session_commands_limited(&ws, 4U);
                        (void)drain_shell_actions_preserving_listen_control(
                            &ws);
                        service_pending_ws_reconnect_audio_recovery(&ws);
                        service_conversation_live_aec_pool_recovery();
                        if (nuwax_audio_terminal_recovery_pending()) {
                            conversation_owner_wait_ms(
                                nuwax_audio_terminal_recovery_next_service_ms(
                                    100U));
                        }
                        continue;
                    }
                    if (err == ESP_ERR_NOT_FINISHED &&
                        nuwax_audio_uplink_sender_busy()) {
                        /* Keep the control plane responsive while detached
                         * cleanup owns the previous sender. This prevents the
                         * former 100 ms full capture restart loop and never
                         * commits a second listen transaction. */
                        (void)service_application_keepalive(
                            &ws, "uplink_reaper_wait");
                        drain_session_commands_limited(&ws, 4U);
                        (void)drain_shell_actions_preserving_listen_control(
                            &ws);
                        service_pending_ws_reconnect_audio_recovery(&ws);
                        conversation_owner_wait_ms(
                            NUWAX_AUDIO_UPLINK_REAPER_WAIT_MS);
                        continue;
                    }
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
                    if (err == ESP_ERR_NOT_FINISHED &&
                        nuwax_offline_audio_replay_retry_pending() &&
                        nuwax_offline_audio_has_ready() &&
                        !nuwax_offline_audio_storage_busy() &&
                        !nuwax_offline_audio_replay_running()) {
                        (void)service_offline_audio_handoff(&ws);
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
                    if (err == ESP_ERR_NOT_FINISHED &&
                        (offline_mode_lease_pending() ||
                         nuwax_offline_audio_capture_running())) {
                        /* Keep the control/keepalive plane alive while the SD
                         * owner converges.  This is intentionally separate
                         * from the generic local-audio error path: an offline
                         * handoff is not a microphone fault and must not force
                         * the conversation into SLEEPING. */
                        (void)service_application_keepalive(
                            &ws, "offline_audio_handoff");
                        drain_session_commands_limited(&ws, 4U);
                        (void)drain_shell_actions_preserving_listen_control(
                            &ws);
                        (void)service_offline_audio_handoff(&ws);
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
#endif
                    const bool normal_source_preempted =
                        !exclusive_mode_run_requested &&
                        exclusive_audio_mode_blocks_normal_audio() &&
                        err == ESP_ERR_INVALID_STATE;
                    if (normal_source_preempted) {
                        ESP_LOGI(TAG, "normal audio source preempted; running exclusive audio mode");
                        continue;
                    }
                    if (normal_audio_source_notification_preempted(err)) {
                        /* Notification playback owns the audio lifecycle. It
                         * is an intentional handoff, not a local microphone
                         * fault, so keep the connected control plane alive. */
                        drain_session_commands_limited(&ws, 4U);
                        (void)drain_shell_actions_preserving_listen_control(
                            &ws);
                        service_notification_transaction();
                        (void)service_application_keepalive(
                            &ws, "notification_handoff");
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
                    if (normal_audio_source_sleep_preempted(err)) {
                        /* A committed sleep state keeps the wake detector and
                         * WebSocket alive while normal capture is fenced. Do
                         * not enter the generic local-audio recovery path or
                         * spin through repeated MIC initialization. */
                        drain_session_commands_limited(&ws, 4U);
                        service_power_key_events(&ws);
                        service_sleep_transaction();
                        ensure_sleep_wake_word_detector();
                        conversation_owner_wait_ms(100U);
                        continue;
                    }
                    const bool ws_connected_after_source =
                        nuwax_ws_is_connected(&ws);
                    if (!ws_connected_after_source) {
                        ESP_LOGI(TAG,
                                 "audio source ended with WebSocket disconnect: %s",
                                 esp_err_to_name(err));
                        /* Transport recovery owns this failure.  In particular,
                         * never classify its ESP_ERR_TIMEOUT as a local audio
                         * error: doing so clears the awake-session budget before
                         * the outer reconnect path has a chance to preserve it. */
                        break;
                    } else {
                        ESP_LOGW(TAG,
                                 "Audio source stopped: %s",
                                 esp_err_to_name(err));
                    }
                    const bool recoverable_normal_conversation_error =
                        !exclusive_mode_run_requested &&
                        !exclusive_audio_mode_blocks_normal_audio() &&
                        ws_connected_after_source;
                    if (recoverable_normal_conversation_error) {
                        if (nuwax_awake_session_state_is_active(
                                &s_awake_session)) {
                            pause_awake_waiting("local_audio_error");
                            ESP_LOGW(TAG,
                                     "normal conversation retained after local audio error err=%s waiting=%d remaining_ms=%lu generation=%lu WebSocket=connected",
                                     esp_err_to_name(err),
                                     nuwax_awake_session_state_is_waiting(
                                         &s_awake_session)
                                         ? 1
                                         : 0,
                                     (unsigned long)nuwax_awake_session_state_remaining_ms(
                                         &s_awake_session, monotonic_ms()),
                                     (unsigned long)nuwax_awake_session_state_generation(
                                         &s_awake_session));
                            if (!resume_awake_conversation_after_inactivity(
                                    "local_audio_error_retry")) {
                                enter_sleeping_conversation_state(
                                    "awake_idle_timeout");
                            }
                        } else {
                            ESP_LOGW(TAG,
                                     "local audio error outside an awake conversation; retaining connected WebSocket");
                            enter_sleeping_conversation_state(
                                "local_audio_error");
                        }
                        vTaskDelay(pdMS_TO_TICKS(100));
                        continue;
                    }
                    if (exclusive_mode_run_requested ||
                        exclusive_audio_mode_blocks_normal_audio() ||
                        err == ESP_ERR_INVALID_SIZE || err == ESP_ERR_NO_MEM ||
                        err == ESP_ERR_TIMEOUT) {
                        enter_sleeping_conversation_state("audio_source_error");
                        continue;
                    }
                    ESP_LOGE(TAG,
                             "unclassified local audio error retained on healthy WebSocket err=%s; restoring wake-ready state",
                             esp_err_to_name(err));
                    enter_sleeping_conversation_state(
                        "unclassified_local_audio_error");
                    vTaskDelay(pdMS_TO_TICKS(100));
                    continue;
                }
                drain_session_commands(&ws);
                service_pending_ws_reconnect_audio_recovery(&ws);
                err = send_cloud_text_request(&ws);
                if (err != ESP_OK) {
                    ESP_LOGW(TAG, "Cloud text request failed: %s", esp_err_to_name(err));
                }
                wait_for_cloud_updates(&ws, 2500);
                nuwax_diagnostics_log_heap(TAG);
                nuwax_diagnostics_log_current_task_stack(TAG, "after_cloud_updates");
            }
        }

        /* Close the application-ready gate before any lengthy transport
         * teardown so a concurrent local hit cannot be replayed after reconnect. */
        store_cloud_connection_state(false, false, false);
        const nuwax_app_state_t disconnect_state = conversation_state_current();
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        const bool meeting_was_active =
            nuwax_meeting_mode_take_offline_resume(&s_meeting_mode) ||
            nuwax_meeting_mode_state(&s_meeting_mode) !=
                NUWAX_MEETING_STATE_DISABLED;
        const bool monitoring_was_active =
            nuwax_monitoring_mode_take_offline_resume(&s_monitoring_mode) ||
            nuwax_monitoring_mode_state(&s_monitoring_mode) !=
                NUWAX_MONITORING_STATE_DISABLED;
        ESP_LOGI(TAG,
                 "WebSocket disconnect offline ownership snapshot meeting=%d monitoring=%d meeting_state=%d monitoring_state=%d",
                 meeting_was_active ? 1 : 0,
                 monitoring_was_active ? 1 : 0,
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
        /* A mode records offline_resume_required immediately before its
         * cleanup transitions the controller to DISABLED.  Treat that
         * durable handoff marker as ownership here; checking only the
         * post-cleanup state would skip SD capture on the normal disconnect
         * path. */
        const bool exclusive_mode_was_active =
            atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire) ||
            meeting_was_active || monitoring_was_active;
#else
        const bool exclusive_mode_was_active = exclusive_audio_owner_active();
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
        const bool speaker_was_active = nuwax_speaker_playback_has_pending();
#else
        const bool speaker_was_active = false;
#endif
        const bool conversation_was_in_flight =
            disconnect_state == NUWAX_APP_STATE_THINKING ||
            disconnect_state == NUWAX_APP_STATE_SPEAKING ||
            s_turn_guard.active || speaker_was_active;
        nuwax_sd_session_network(false);
        nuwax_monitoring_mode_notify_ws_disconnected(&s_monitoring_mode);
        nuwax_meeting_mode_notify_ws_disconnected(&s_meeting_mode);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        if (exclusive_mode_was_active &&
            !s_meeting_mode.sd_local && !s_monitoring_mode.sd_local &&
            !atomic_load_explicit(&s_reprovision_quiesce_requested,
                                  memory_order_acquire) &&
            (meeting_was_active || monitoring_was_active) &&
#if CONFIG_NUWAX_SD_SESSION_ENABLE
            false &&
#endif
            !nuwax_offline_audio_capture_running()) {
            /* Media discovery belongs to the background storage owner. A
             * missing card remains non-fatal to online mode recovery. */
            const nuwax_audio_runtime_memory_t handoff_memory =
                exclusive_audio_memory_snapshot();
            const nuwax_audio_runtime_memory_state_t handoff_memory_state =
                nuwax_audio_runtime_memory_classify(handoff_memory);
            nuwax_offline_audio_supervisor_wake();
            offline_mode_kind_store(
                monitoring_was_active
                    ? NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                    : NUWAX_OFFLINE_AUDIO_MODE_MEETING);
            nuwax_audio_mode_identity_t *identity = offline_mode_identity();
            if (!identity->session_id[0]) {
                /* A disconnect during initial authorization may precede the
                 * first listen-start. Establish one local identity then. */
                snprintf(identity->session_id, sizeof(identity->session_id),
                         "%s_stream_%08lx", monitoring_was_active ? "monitoring" : "meeting",
                         (unsigned long)esp_random());
            }
            identity->resuming = true;
            strlcpy(s_offline_mode_resume_session, identity->session_id,
                    sizeof(s_offline_mode_resume_session));
            s_offline_mode_capture_started = false;
            /* Preserve the mode lease even when the optional SD path is
             * unavailable.  Reconnect must still re-admit the online mode. */
            const bool offline_writer_busy = nuwax_offline_audio_capture_running();
            const esp_err_t offline_capture_err =
                offline_writer_busy
                           ? ESP_ERR_NOT_FINISHED
                           : nuwax_offline_audio_start_capture_continuation(
                                 offline_mode_kind(),
                                 s_offline_mode_resume_session,
                                 CONFIG_NUWAX_VOICE_SAMPLE_RATE,
                                 CONFIG_NUWAX_VOICE_CHANNELS,
                                 CONFIG_NUWAX_VOICE_FRAME_DURATION_MS,
                                 identity->next_capture_sequence);
            atomic_store_explicit(&s_offline_mode_cancel_to_sleep, false,
                                  memory_order_release);
            atomic_store_explicit(&s_offline_mode_capture_failed,
                                  offline_capture_err != ESP_OK,
                                  memory_order_release);
            if (offline_capture_err == ESP_OK) {
                s_offline_mode_capture_started = true;
                reset_offline_capture_retry_state();
            } else {
                s_offline_capture_retry_backoff_ms =
                    NUWAX_OFFLINE_CAPTURE_RETRY_INITIAL_MS;
                s_offline_capture_retry_next_ms =
                    monotonic_ms() + s_offline_capture_retry_backoff_ms;
                s_offline_capture_retry_attempts = 1U;
            }
            if (offline_capture_err == ESP_ERR_NO_MEM) {
                (void)nuwax_device_warning_report_enqueue(
                    "audio", "offline_capture_memory_deferred",
                    ESP_ERR_NO_MEM, NULL, 0U, NULL);
            }
            s_offline_mode_restore_request_epoch = 0U;
            s_offline_mode_restore_next_attempt_ms = 0U;
            s_offline_mode_restore_started_ms = 0U;
            offline_mode_lease_store(true);
            ESP_LOGI(TAG,
                     "WebSocket offline archive handoff mode=%s started=%d err=%s memory_state=%d internal=%u largest=%u dma_largest=%u",
                     offline_mode_kind() ==
                             NUWAX_OFFLINE_AUDIO_MODE_MONITORING
                         ? "monitoring"
                         : "meeting",
                     offline_capture_err == ESP_OK ? 1 : 0,
                     esp_err_to_name(offline_capture_err),
                     (int)handoff_memory_state,
                     (unsigned)handoff_memory.internal_free,
                     (unsigned)handoff_memory.internal_largest,
                     (unsigned)handoff_memory.dma_largest);
        }
#endif
        bool awake_session_preserved = false;
        if (!exclusive_mode_was_active &&
            !atomic_load_explicit(&s_reprovision_quiesce_requested,
                                  memory_order_acquire)) {
            awake_session_preserved =
                preserve_awake_session_for_ws_reconnect(
                    conversation_was_in_flight
                        ? "ws_disconnect_inflight_aborted"
                        : "ws_disconnect");
        }
        if (!awake_session_preserved) {
            clear_awake_session(exclusive_mode_was_active
                                    ? "exclusive_ws_disconnect"
                                    : (conversation_was_in_flight
                                           ? "inflight_ws_disconnect"
                                           : "ws_disconnect"));
        }
        nuwax_barge_dispatcher_unbind(&ws, barge_dispatch_binding);
#if CONFIG_NUWAX_OTA_ENABLE
        xSemaphoreTake(s_ws_pointer_mutex, portMAX_DELAY);
        unpublish_active_ws();
        xSemaphoreGive(s_ws_pointer_mutex);
#else
        unpublish_active_ws();
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
        const esp_err_t speaker_reset_err =
            nuwax_speaker_playback_reset_runtime();
        if (speaker_reset_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "WebSocket disconnect could not converge physical speaker ownership err=%s; controlled restart prevents stale I2S/board lease",
                     esp_err_to_name(speaker_reset_err));
            set_state(NUWAX_APP_STATE_ERROR);
            nuwax_diagnostics_log_heap_label(TAG,
                                             "ws_disconnect_speaker_reset_failed");
            vTaskDelay(pdMS_TO_TICKS(100));
            esp_restart();
            vTaskDelay(portMAX_DELAY);
        }
        clear_auto_followup("ws_disconnect");
        nuwax_speaker_playback_release_idle_output("ws_disconnect");
#endif
        discard_connection_bound_queues("ws_disconnect");
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
        if (nuwax_offline_audio_replay_formal_running()) {
            const uint32_t disconnect_epoch =
                nuwax_ws_connection_epoch(&ws);
            const esp_err_t replay_cancel_err =
                nuwax_offline_audio_replay_formal_cancel(
                    disconnect_epoch, 6000U);
            if (replay_cancel_err != ESP_OK) {
                /* Reusing ws while a replay worker still references it would
                 * corrupt the next transport generation. A controlled reboot
                 * preserves .ready archives and restores ownership cleanly. */
                ESP_LOGE(TAG,
                         "offline formal replay did not quiesce before WebSocket close epoch=%lu err=%s; controlled restart preserves archives",
                         (unsigned long)disconnect_epoch,
                         esp_err_to_name(replay_cancel_err));
                nuwax_diagnostics_log_heap_label(
                    TAG, "offline_replay_quiesce_restart");
                vTaskDelay(pdMS_TO_TICKS(100U));
                esp_restart();
                vTaskDelay(portMAX_DELAY);
            }
        }
#endif
        if (!awake_session_preserved &&
            !atomic_load_explicit(&s_reprovision_quiesce_requested,
                                  memory_order_acquire)
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            && !offline_mode_lease_pending()
            && !nuwax_offline_audio_capture_running()
            && !nuwax_offline_audio_is_active()
#endif
        ) {
            enter_sleeping_conversation_state(
                conversation_was_in_flight
                    ? "ws_disconnect_inflight_aborted"
                    : "ws_disconnect_wake_ready");
        }
        const esp_err_t close_err = nuwax_ws_owner_close(&ws);
        observe_ws_owner_cleanup_result(
            &ws, close_err, "websocket_disconnect");
        if (close_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "WebSocket owner close incomplete after disconnect stage=%d err=%s; retaining owner for retry",
                     (int)nuwax_ws_owner_close_failure_stage(&ws),
                     esp_err_to_name(close_err));
        }
        const esp_err_t aec_suspend_err =
            conversation_live_aec_pool_suspend("ws_disconnect");
        if (aec_suspend_err != ESP_OK) {
            ESP_LOGW(TAG,
                     "WebSocket disconnect could not release live AEC reservation: %s",
                     esp_err_to_name(aec_suspend_err));
        }
        nuwax_app_shell_set_cloud_state(NUWAX_CLOUD_DISCONNECTED);
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            ESP_LOGI(TAG, "WebSocket cleanup yielding to BLE handoff close_err=%s; wake/reconnect skipped",
                     esp_err_to_name(close_err));
            continue;
        }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
        /* WebSocket reachability does not own the local wake lifecycle. If no
         * awake conversation is being preserved, keep/recover wake while the
         * network owner reconnects. */
        service_offline_wake_word_detector("ws_disconnect");
#endif
        if (!nuwax_wifi_is_connected()) {
            (void)recover_wifi_if_needed();
        }
        set_cloud_transport_connecting_state("websocket_disconnect");
        delay_before_cloud_reconnect("ws_disconnect", 0, ESP_FAIL);
    }
}
