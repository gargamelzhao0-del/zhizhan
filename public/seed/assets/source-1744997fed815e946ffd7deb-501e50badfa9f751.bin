static void shell_dispatch_apply_volume_percent(void *ctx, int volume_percent) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_apply_volume_percent(volume_percent, true);
    s_current_volume_percent = nuwax_speaker_playback_get_volume_percent();
#else
    s_current_volume_percent = (uint8_t)(volume_percent < 0
                                             ? 0
                                             : (volume_percent > 100
                                                    ? 100
                                                    : volume_percent));
    nuwax_app_shell_set_volume_percent(s_current_volume_percent);
    ESP_LOGI(TAG,
             "speaker volume UI set to %u%% but speaker output is disabled",
             (unsigned)s_current_volume_percent);
#endif
    schedule_volume_report(s_current_volume_percent, true);
}

static void shell_dispatch_select_wifi(void *ctx, int index) {
    (void)ctx;
    ESP_LOGI(TAG, "Wi-Fi selected index=%d, waiting for PC password command", index);
}

static void shell_dispatch_connect_saved_wifi(void *ctx, int index) {
    (void)ctx;
    refresh_saved_wifi_list_ui();
    nuwax_wifi_saved_network_t saved[NUWAX_WIFI_MAX_SAVED_NETWORKS] = {0};
    int count = 0;
    esp_err_t err = nuwax_wifi_get_saved_networks(saved, NUWAX_WIFI_MAX_SAVED_NETWORKS, &count);
    if (err != ESP_OK || index < 0 || index >= count || saved[index].ssid[0] == '\0') {
        ESP_LOGW(TAG, "saved Wi-Fi index invalid index=%d err=%s", index, esp_err_to_name(err));
        set_wifi_result_from_current_link(
            "SAVED WIFI", false, "invalid saved network");
        return;
    }

    wifi_connect_request_t request = {0};
    strlcpy(request.ssid, saved[index].ssid, sizeof(request.ssid));
    strlcpy(request.request_id, "saved_wifi", sizeof(request.request_id));
    request.use_saved_index = true;
    request.saved_index = index;
    if (s_wifi_connect_requests && xQueueSend(s_wifi_connect_requests, &request, 0) == pdTRUE) {
        nuwax_app_shell_set_wifi_connecting(request.ssid);
        ESP_LOGI(TAG, "saved Wi-Fi connect queued index=%d ssid=%s", index, request.ssid);
    } else {
        ESP_LOGW(TAG, "saved Wi-Fi queue full");
        set_wifi_result_from_current_link(
            request.ssid, false, "wifi queue full");
    }
}

static void flash_ops_task(void *arg) {
    (void)arg;
    while (true) {
        uint32_t operations = 0;
        xTaskNotifyWait(0, UINT32_MAX, &operations, portMAX_DELAY);
        if (operations & NUWAX_FLASH_OP_REPROVISION) {
            const char *busy_reason = reprovision_hard_busy_reason(false);
            if (busy_reason) {
                ESP_LOGW(TAG,
                         "BLE reprovision cancelled after queue: %s",
                         busy_reason);
                set_wifi_result_from_current_link(
                    "", false, "Provisioning blocked: system busy");
                nuwax_app_shell_set_provisioning_active(false);
                set_cloud_transport_connecting_state("ble_reprovision_busy");
                clear_reprovision_reservation(true);
                nuwax_app_shell_notify_action_rejected(
                    NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
                continue;
            }

            set_reprovision_phase(NUWAX_REPROVISION_PHASE_WAIT_READY);
            const esp_err_t ready_err =
                wait_for_reprovision_transient_busy();
            if (ready_err != ESP_OK) {
                set_reprovision_phase(NUWAX_REPROVISION_PHASE_CLEANUP);
                set_wifi_result_from_current_link(
                    "", false, "Provisioning wait timeout");
                nuwax_app_shell_set_provisioning_active(false);
                set_cloud_transport_connecting_state(
                    "ble_reprovision_ready_timeout");
                clear_reprovision_reservation(true);
                nuwax_app_shell_notify_action_rejected(
                    NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
                continue;
            }

            set_reprovision_phase(NUWAX_REPROVISION_PHASE_AUDIO_QUIESCE);
            ESP_LOGW(TAG,
                     "BLE reprovision audio quiesce started timeout_ms=%u",
                     (unsigned)NUWAX_REPROVISION_AUDIO_QUIESCE_TIMEOUT_MS);
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
            /* The resume lease is revoked by the connection owner before it
             * parks. Stop admission now, but let the writer drain and seal. */
            (void)nuwax_offline_audio_request_stop(false);
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
            nuwax_speaker_playback_request_fade_cancel(
                "ble_reprovision", NUWAX_REPROVISION_AUDIO_FADE_MS);
#endif
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
            inhibit_sleep_wake_word_detector("ble_reprovision");
            nuwax_wake_word_detector_request_stop();
#endif

            const uint32_t deadline = monotonic_ms() +
                                      NUWAX_REPROVISION_AUDIO_QUIESCE_TIMEOUT_MS;
            unsigned idle_checks = 0U;
            bool speaker_output_released = false;
            bool capture_starting = false;
            bool capture_runtime_active = false;
            bool playback_busy = false;
            bool wake_detector_running = false;
            while ((int32_t)(monotonic_ms() - deadline) < 0) {
                capture_starting = atomic_load_explicit(
                    &s_conversation_capture_starting, memory_order_acquire);
                capture_runtime_active = atomic_load_explicit(
                    &s_conversation_capture_runtime_active,
                    memory_order_acquire);
#if CONFIG_NUWAX_SPEAKER_ENABLE
                playback_busy = nuwax_speaker_playback_has_pending();
                if (!playback_busy && !speaker_output_released) {
                    nuwax_speaker_playback_release_idle_output(
                        "ble_reprovision");
                    speaker_output_released = true;
                    playback_busy = nuwax_speaker_playback_has_pending();
                }
#else
                playback_busy = false;
#endif
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
                wake_detector_running =
                    nuwax_wake_word_detector_is_running();
#else
                wake_detector_running = false;
#endif
                if (!capture_starting && !capture_runtime_active &&
                    !playback_busy && !wake_detector_running &&
                    !reprovision_audio_mode_busy()) {
                    if (++idle_checks >= NUWAX_REPROVISION_AUDIO_IDLE_CHECKS) {
                        break;
                    }
                } else {
                    idle_checks = 0U;
                }
                vTaskDelay(pdMS_TO_TICKS(
                    NUWAX_REPROVISION_AUDIO_IDLE_POLL_MS));
            }
            if (idle_checks < NUWAX_REPROVISION_AUDIO_IDLE_CHECKS) {
                ESP_LOGE(TAG,
                         "BLE reprovision audio quiesce timed out capture_starting=%d capture_runtime=%d playback=%d wake_detector=%d",
                         capture_starting ? 1 : 0,
                         capture_runtime_active ? 1 : 0,
                         playback_busy ? 1 : 0,
                         wake_detector_running ? 1 : 0);
                set_reprovision_phase(NUWAX_REPROVISION_PHASE_CLEANUP);
                clear_reprovision_reservation(true);
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
                request_sleep_wake_word_detector(
                    "ble_reprovision_audio_quiesce_timeout");
#endif
                set_wifi_result_from_current_link(
                    "", false, "Provisioning audio stop timeout");
                nuwax_app_shell_set_provisioning_active(false);
                set_cloud_transport_connecting_state(
                    "ble_reprovision_audio_quiesce_timeout");
                nuwax_app_shell_notify_action_rejected(
                    NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
                continue;
            }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
            /* No detector task remains at this point. Discard a wake captured
             * before the provisioning boundary so it cannot start a stale
             * conversation after new cloud credentials are committed. */
            if (s_wake_word_events) {
                xQueueReset(s_wake_word_events);
            }
#endif
            ESP_LOGW(TAG, "BLE reprovision audio paths are idle");
            ESP_LOGW(TAG,
                     "BLE reprovision worker preparing provisioning entry");
            const esp_err_t reprovision_err = run_runtime_ble_reprovision();
            ESP_LOGI(TAG, "in-process BLE reprovision finished result=%s",
                     esp_err_to_name(reprovision_err));
            if (reprovision_err != ESP_OK) {
                nuwax_app_shell_notify_action_rejected(
                    NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
            }
        }

    }
}

static bool queue_ble_reprovision_request(const char *source) {
    const nuwax_reprovision_orphan_result_t orphan_result =
        recover_orphaned_reprovision_owner(source);
    if (orphan_result == NUWAX_REPROVISION_ORPHAN_RETRY_REQUIRED) {
        ESP_LOGE(TAG,
                 "%s BLE provisioning request rejected while orphan ownership recovery remains isolated",
                 source ? source : "unknown");
        set_wifi_result_from_current_link(
            "", false, "Provisioning recovery pending");
        return false;
    }
    nuwax_reprovision_snapshot_t active = reprovision_snapshot();
    if (active.requested) {
        ESP_LOGW(TAG,
                 "%s BLE provisioning request joined active generation=%lu phase=%s elapsed_ms=%lu",
                 source ? source : "unknown",
                 (unsigned long)active.generation,
                 reprovision_phase_name(active.phase),
                 (unsigned long)(monotonic_ms() -
                                 active.transaction_started_ms));
        nuwax_app_shell_set_wifi_connecting("BLE PROVISIONING");
        /* The worker may still be waiting for audio quiescence. Publish the
         * provisioning owner immediately so a manual tap or a cloud-triggered
         * rebind cannot leave the old listening face on screen. */
        set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
        if (nuwax_provision_main_is_active()) {
            nuwax_app_shell_set_provisioning_active(true);
        } else {
            nuwax_app_shell_set_provisioning_starting();
        }
        return true;
    }

    if (nuwax_provision_main_is_active()) {
        ESP_LOGI(TAG,
                 "%s BLE provisioning request joined active official service=%s",
                 source ? source : "unknown",
                 nuwax_provision_main_service_name());
        nuwax_app_shell_set_wifi_connecting("BLE PROVISIONING");
        set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
        nuwax_app_shell_set_provisioning_active(true);
        return true;
    }

    const char *busy_reason = reprovision_hard_busy_reason(true);
    if (busy_reason) {
        ESP_LOGW(TAG, "%s BLE provisioning request rejected: %s",
                 source ? source : "unknown", busy_reason);
        set_wifi_result_from_current_link(
            "", false, "Provisioning blocked: system busy");
        return false;
    }

    bool reserved = false;
    const uint32_t reserved_ms = monotonic_ms();
    portENTER_CRITICAL(&s_flash_ops_lock);
    if (!s_reprovision_requested &&
        !s_reprovision_orphan_recovery_active &&
        s_flash_ops_task) {
        s_reprovision_requested = true;
        s_reprovision_generation++;
        if (s_reprovision_generation == 0U) {
            s_reprovision_generation = 1U;
        }
        s_reprovision_phase = NUWAX_REPROVISION_PHASE_RESERVED;
        s_reprovision_transaction_started_ms = reserved_ms;
        s_reprovision_phase_started_ms = reserved_ms;
        atomic_store_explicit(&s_reprovision_quiesce_requested,
                              true,
                              memory_order_release);
        reserved = true;
    }
    portEXIT_CRITICAL(&s_flash_ops_lock);

    if (!reserved) {
        ESP_LOGW(TAG, "%s BLE provisioning request ignored: provisioning already pending",
                 source ? source : "unknown");
        return false;
    }

    if (!nuwax_power_ctrl_acquire_shutdown_inhibit(
            NUWAX_POWER_INHIBIT_REPROVISION)) {
        ESP_LOGW(TAG,
                 "%s BLE provisioning request rejected: shutdown already accepted",
                 source ? source : "unknown");
        clear_reprovision_reservation(false);
        set_wifi_result_from_current_link(
            "", false, "Provisioning blocked: power transition");
        return false;
    }

    /* Fence ordinary STA work before the worker waits for an operation that
     * was already in flight. This closes the request-to-owner handoff window
     * without blocking the UI/control callback on the Wi-Fi mutex. */
    nuwax_wifi_request_provisioning_handoff();
    cancel_background_wifi_recovery();

    busy_reason = reprovision_hard_busy_reason(false);
    if (busy_reason) {
        ESP_LOGW(TAG, "%s BLE provisioning request lost operation race: %s",
                 source ? source : "unknown", busy_reason);
        clear_reprovision_reservation(true);
        set_wifi_result_from_current_link(
            "", false, "Provisioning blocked: system busy");
        return false;
    }
    active = reprovision_snapshot();
    ESP_LOGW(TAG,
             "%s BLE provisioning requested generation=%lu; audio quiesce queued owners=0x%08lx",
             source ? source : "unknown",
             (unsigned long)active.generation,
             (unsigned long)nuwax_power_ctrl_shutdown_inhibit_owners());
    nuwax_app_shell_set_wifi_connecting("BLE PROVISIONING");
    set_state(NUWAX_APP_STATE_WIFI_CONNECTING);
    nuwax_app_shell_set_provisioning_starting();
    if (xTaskNotify(s_flash_ops_task,
                    NUWAX_FLASH_OP_REPROVISION,
                    eSetBits) != pdPASS) {
        ESP_LOGE(TAG, "%s BLE provisioning worker notification failed",
                 source ? source : "unknown");
        clear_reprovision_reservation(true);
        set_wifi_result_from_current_link(
            "", false, "Provisioning worker unavailable");
        nuwax_app_shell_set_provisioning_active(false);
        set_cloud_transport_connecting_state(
            "ble_reprovision_worker_unavailable");
        return false;
    }
    return true;
}

static bool service_cloud_binding_reprovision(void)
{
    static uint32_t next_attempt_ms;
    const uint32_t rejected_epoch = cloud_provision_required_epoch();
    if (rejected_epoch == 0U && !s_cloud_http_rebind_pending) {
        next_attempt_ms = 0U;
        return false;
    }

    const uint32_t now_ms = monotonic_ms();
    if (next_attempt_ms != 0U && !elapsed_ms(now_ms, next_attempt_ms)) {
        return true;
    }
    if (queue_ble_reprovision_request("cloud_device_not_bound")) {
        s_cloud_http_rebind_pending = false;
        if (rejected_epoch != 0U && !consume_cloud_provision_required(rejected_epoch)) {
            ESP_LOGW(TAG,
                     "cloud binding reprovision queued but rejection epoch changed expected=%lu pending=%lu",
                     (unsigned long)rejected_epoch,
                     (unsigned long)cloud_provision_required_epoch());
        } else {
            ESP_LOGW(TAG,
                     "cloud binding reprovision handed to existing BLE coordinator rejected_epoch=%lu",
                     (unsigned long)rejected_epoch);
        }
        next_attempt_ms = 0U;
        return true;
    }

    next_attempt_ms = now_ms + 1000U;
    ESP_LOGW(TAG,
             "cloud binding reprovision deferred rejected_epoch=%lu retry_ms=1000; WebSocket reconnect remains inhibited",
             (unsigned long)rejected_epoch);
    return true;
}

static bool usb_control_request_ble_reprovision(void *ctx) {
    (void)ctx;
    return queue_ble_reprovision_request("usb_serial_control");
}

static void shell_dispatch_set_reprovisioning(void *ctx, bool enabled) {
    (void)ctx;
    const bool active = nuwax_provision_main_is_active();
    const bool requested = reprovision_request_pending();
    if (!enabled) {
        if (!active && !requested &&
            !nuwax_provision_main_is_reprovisioning()) {
            ESP_LOGI(TAG, "device menu provisioning already disabled");
            return;
        }
        if (!nuwax_provision_main_request_runtime_cancel()) {
            if (active) {
                ESP_LOGW(TAG,
                         "device menu provisioning stop rejected: no reversible previous pair or commit already started");
                nuwax_app_shell_notify_action_rejected(
                    NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
            } else {
                ESP_LOGI(TAG,
                         "device menu provisioning stop already converging active=0 requested=%d",
                         requested ? 1 : 0);
            }
        }
        return;
    }
    if (active || requested) {
        ESP_LOGI(TAG,
                 "device menu provisioning already enabled active=%d requested=%d",
                 active ? 1 : 0, requested ? 1 : 0);
        return;
    }
    if (!queue_ble_reprovision_request("device_menu")) {
        nuwax_app_shell_notify_action_rejected(
            NUWAX_APP_SHELL_ACTION_REPROVISION_WIFI);
    }
}

static const nuwax_shell_action_dispatch_callbacks_t s_shell_action_dispatch_callbacks = {
    .ctx = NULL,
    .clear_auto_followup = shell_dispatch_clear_auto_followup,
    .request_wifi_scan = shell_dispatch_request_wifi_scan,
    .refresh_saved_wifi_list_ui = shell_dispatch_refresh_saved_wifi_list_ui,
    .request_pc_status = shell_dispatch_request_pc_status,
    .request_status_app = shell_dispatch_request_status_app,
    .request_cancel_turn = shell_dispatch_request_cancel_turn,
    .request_head_touch_agent = shell_dispatch_request_head_touch_agent,
    .request_shake_agent = shell_dispatch_request_shake_agent,
    .apply_volume_percent = shell_dispatch_apply_volume_percent,
    .set_meeting_mode = shell_dispatch_set_meeting_mode,
    .set_simulated_offline = shell_dispatch_set_simulated_offline,
    .select_wifi = shell_dispatch_select_wifi,
    .connect_saved_wifi = shell_dispatch_connect_saved_wifi,
    .set_reprovisioning = shell_dispatch_set_reprovisioning,
};

static void handle_shell_action(nuwax_ws_client_t *ws, const nuwax_app_shell_result_t *action) {
    nuwax_shell_action_dispatch(ws, action, &s_shell_action_dispatch_callbacks);
    service_pending_volume_report(ws);
}

static void wifi_connect_task(void *arg) {
    (void)arg;
    while (true) {
        wifi_connect_request_t request = {0};
        if (xQueueReceive(s_wifi_connect_requests, &request, pdMS_TO_TICKS(100)) != pdTRUE) {
            service_background_wifi_recovery();
            continue;
        }
        cancel_background_wifi_recovery();
        nuwax_app_shell_set_wifi_connecting(request.ssid);
        queue_wifi_status_report_for_request(request.request_id,
                                             "connecting",
                                             request.ssid,
                                             "",
                                             false,
                                             "connecting");
        if (!begin_wifi_connect_operation("wifi_connect", portMAX_DELAY)) {
            queue_wifi_status_report_for_request(request.request_id,
                                                 "failed",
                                                 request.ssid,
                                                 "",
                                                 false,
                                                 "busy");
            continue;
        }
        esp_err_t err = request.use_saved_index ? nuwax_wifi_connect_saved_index(request.saved_index)
                                                : nuwax_wifi_reconnect_to(request.ssid, request.password);
        end_wifi_connect_operation();
        if (err == ESP_OK) {
            char ssid[33] = {0};
            char ip[16] = {0};
            nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));
            nuwax_app_shell_set_wifi_status(ssid, ip);
            set_wifi_result_from_current_link(request.ssid, true, ip);
            queue_wifi_status_report_for_request(
                request.request_id,
                "connected",
                ssid[0] ? ssid : request.ssid,
                ip,
                true,
                "connected");
            refresh_saved_wifi_list_ui();
        } else {
            set_wifi_result_from_current_link(request.ssid, false,
                                              esp_err_to_name(err));
            queue_wifi_status_report_for_request(request.request_id,
                                                 "failed",
                                                 request.ssid,
                                                 "",
                                                 false,
                                                 esp_err_to_name(err));
        }
    }
}

#if CONFIG_NUWAX_AUDIO_SOURCE_SYNTHETIC
static esp_err_t send_pcm16_audio_frame(nuwax_ws_client_t *ws,
                                        const int16_t *samples,
                                        size_t sample_count,
                                        uint32_t sequence,
                                        uint8_t flags) {
    size_t frame_len = 0;
    esp_err_t err = nuwax_audio_uplink_build_pcm16_frame(s_audio_frame,
                                                         sizeof(s_audio_frame),
                                                         samples,
                                                         sample_count,
                                                         sequence,
                                                         flags,
                                                         &frame_len);
    if (err != ESP_OK) {
        return err;
    }
    return nuwax_ws_send_binary(ws, s_audio_frame, frame_len);
}
#endif

#if CONFIG_NUWAX_AUDIO_SOURCE_SYNTHETIC
static esp_err_t send_synthetic_audio_burst(nuwax_ws_client_t *ws) {
    const size_t samples_per_frame = nuwax_audio_uplink_samples_per_frame();
    nuwax_synthetic_audio_t synthetic;
    nuwax_synthetic_audio_init(&synthetic);

    if (samples_per_frame > CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME) {
        ESP_LOGE(TAG, "Configured frame has too many samples: %u", (unsigned)samples_per_frame);
        return ESP_ERR_INVALID_ARG;
    }

    ESP_RETURN_ON_ERROR(nuwax_session_send_listen(ws, "start", "synthetic"), TAG, "listen start failed");
    set_state(NUWAX_APP_STATE_LISTENING);

    for (uint32_t seq = 0; seq < CONFIG_NUWAX_VOICE_SYNTHETIC_FRAMES_PER_BURST; seq++) {
        if (!nuwax_ws_is_connected(ws)) {
            return ESP_ERR_INVALID_STATE;
        }

        nuwax_synthetic_audio_fill_pcm16(&synthetic, s_audio_samples, samples_per_frame, CONFIG_NUWAX_VOICE_SAMPLE_RATE);
        uint8_t flags = NUWAX_AUDIO_FLAG_VAD_SPEECH;
        if (recorded_frames == 0) {
            flags |= NUWAX_AUDIO_FLAG_START;
        }
        if (seq + 1 == CONFIG_NUWAX_VOICE_SYNTHETIC_FRAMES_PER_BURST) {
            flags |= NUWAX_AUDIO_FLAG_END;
        }

        ESP_RETURN_ON_ERROR(send_pcm16_audio_frame(ws, s_audio_samples, samples_per_frame, seq, flags),
                            TAG,
                            "audio frame send failed");
        drain_session_commands(ws);
        vTaskDelay(pdMS_TO_TICKS(CONFIG_NUWAX_VOICE_FRAME_DURATION_MS));
    }

    ESP_RETURN_ON_ERROR(nuwax_session_send_listen(ws, "stop", "synthetic"), TAG, "listen stop failed");
    set_state(NUWAX_APP_STATE_THINKING);
    return ESP_OK;
}

static esp_err_t wait_for_start_action(nuwax_ws_client_t *ws, nuwax_touch_point_t *point) {
#if CONFIG_NUWAX_VOICE_SYNTHETIC_TOUCH_TRIGGER
    if (!s_shell_actions) {
        return ESP_ERR_INVALID_STATE;
    }
    ESP_LOGI(TAG, "Hold face card to start a synthetic listen cycle");
    while (true) {
        if (!nuwax_ws_is_connected(ws)) {
            return ESP_ERR_INVALID_STATE;
        }
        drain_session_commands(ws);
        nuwax_app_shell_result_t action = {0};
        if (xQueueReceive(s_shell_actions, &action, pdMS_TO_TICKS(100)) != pdTRUE) {
            continue;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_START_LISTEN) {
            break;
        }
        handle_shell_action(ws, &action);
    }
    if (point) {
        memset(point, 0, sizeof(*point));
        point->touched = true;
    }
    return ESP_OK;
#else
    if (point) {
        memset(point, 0, sizeof(*point));
    }
    vTaskDelay(pdMS_TO_TICKS(CONFIG_NUWAX_VOICE_BURST_INTERVAL_MS));
    return ESP_OK;
#endif
}
#endif

#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
static void log_mic_raw_stats(const nuwax_mic_raw_stats_t *raw, uint32_t seq) {
#if CONFIG_NUWAX_MIC_RAW_LOG_ENABLE
    if (!raw || raw->sample_count == 0) {
        ESP_LOGI(TAG, "mic raw seq=%lu samples=0", (unsigned long)seq);
        return;
    }
    ESP_LOGI(TAG,
             "mic raw seq=%lu samples=%u first=%ld last=%ld min=%ld max=%ld mean=%ld centered_peak=%lld zero=%lu pos=%lu neg=%lu shift=%lu dc=%d auto=%d",
             (unsigned long)seq,
             (unsigned)raw->sample_count,
             (long)raw->first,
             (long)raw->last,
             (long)raw->min,
             (long)raw->max,
             (long)raw->mean,
             (long long)raw->centered_peak,
             (unsigned long)raw->zero_count,
             (unsigned long)raw->positive_count,
             (unsigned long)raw->negative_count,
             (unsigned long)raw->selected_shift,
             raw->dc_block_enabled ? 1 : 0,
             raw->auto_attenuate_enabled ? 1 : 0);
#else
    (void)raw;
    (void)seq;
#endif
}

static void log_audio_cleaner_frame(uint32_t seq,
                                    bool playback_active,
                                    const nuwax_audio_cleaner_result_t *clean) {
#if CONFIG_NUWAX_REALTIME_AUDIO_DIAGNOSTIC_LOG_ENABLE
    if (!clean) {
        return;
    }
    const bool acted = clean->zeroed_quiet ||
                       clean->attenuated_quiet ||
                       clean->attenuated_impulse ||
                       clean->playback_unprotected_attenuated ||
                       clean->playback_protected_gain ||
                       clean->playback_continuity_gain ||
                       clean->playback_protected_limited ||
                       clean->playback_echo_veto_attenuated ||
                       clean->playback_echo_veto_guarded ||
                       clean->speech_protected ||
                       clean->softref_linear_cancel ||
                       clean->softref_echo_gate ||
                       clean->softref_nearend_guard;
    const bool periodic = (seq % NUWAX_AUDIO_CLEANER_LOG_INTERVAL_FRAMES) == 0;
    const bool protected_limit_sample =
        clean->playback_protected_limited &&
        (seq % NUWAX_AUDIO_CLEANER_LIMIT_LOG_INTERVAL_FRAMES) == 0;
    const bool important = clean->attenuated_impulse ||
                           protected_limit_sample ||
                           periodic ||
                           (seq < 3 && (acted || clean->zeroed_quiet));
    if (!acted && !periodic) {
        return;
    }
    if (acted && !important) {
        return;
    }
    NUWAX_RT_DIAG_LOGI(
        TAG,
        "audio clean seq=%lu playback=%d before_avg=%lu before_peak=%lu after_avg=%lu after_peak=%lu gain_q15=%lu far_gain_q15=%lu quiet_zero=%d quiet_atten=%d playback_quiet=%d impulse=%d unprotected_atten=%d unprotected_guard=%d protected_gain=%d continuity_gain=%d protected_limited=%d echo_veto_atten=%d echo_veto_guarded=%d speech_protect=%d softref_active=%d softref_linear=%d softref_gate=%d softref_guard=%d ref_avg=%lu ref_peak=%lu corr_q15=%lu copied=%lu",
        (unsigned long)seq,
        playback_active ? 1 : 0,
        (unsigned long)clean->before.avg_abs,
        (unsigned long)clean->before.peak,
        (unsigned long)clean->after.avg_abs,
        (unsigned long)clean->after.peak,
        (unsigned long)clean->playback_gain_q15,
        (unsigned long)clean->playback_unprotected_gain_q15,
        clean->zeroed_quiet ? 1 : 0,
        clean->attenuated_quiet ? 1 : 0,
        clean->playback_quiet ? 1 : 0,
        clean->attenuated_impulse ? 1 : 0,
        clean->playback_unprotected_attenuated ? 1 : 0,
        clean->playback_unprotected_guarded ? 1 : 0,
        clean->playback_protected_gain ? 1 : 0,
        clean->playback_continuity_gain ? 1 : 0,
        clean->playback_protected_limited ? 1 : 0,
        clean->playback_echo_veto_attenuated ? 1 : 0,
        clean->playback_echo_veto_guarded ? 1 : 0,
        clean->speech_protected ? 1 : 0,
        clean->softref_active ? 1 : 0,
        clean->softref_linear_cancel ? 1 : 0,
        clean->softref_echo_gate ? 1 : 0,
        clean->softref_nearend_guard ? 1 : 0,
        (unsigned long)clean->softref_ref_avg_abs,
        (unsigned long)clean->softref_ref_peak,
        (unsigned long)clean->softref_corr_q15,
        (unsigned long)clean->softref_copied_samples);
#else
    (void)seq;
    (void)playback_active;
    (void)clean;
#endif
}

static void log_audio_cleaner_summary(const nuwax_audio_cleaner_t *cleaner) {
    nuwax_audio_cleaner_stats_t stats = {0};
    nuwax_audio_cleaner_get_stats(cleaner, &stats);
    if (stats.processed_frames == 0) {
        return;
    }
    ESP_LOGI(TAG,
             "audio clean summary frames=%lu quiet_zeroed=%lu quiet_attenuated=%lu playback_quiet=%lu impulse_attenuated=%lu playback_unprotected_attenuated=%lu playback_unprotected_guarded=%lu playback_unprotected_zero=%lu playback_unprotected_min_gain_q15=%lu playback_protected_gain=%lu playback_continuity_gain=%lu playback_protected_limited=%lu playback_gain_max_q15=%lu playback_echo_veto_attenuated=%lu playback_echo_veto_guarded=%lu speech_protected=%lu softref_frames=%lu softref_active=%lu softref_missing=%lu softref_linear=%lu softref_gate=%lu softref_guard=%lu softref_underrun=%lu softref_last_ref_avg=%lu softref_last_ref_peak=%lu softref_last_corr_q15=%lu clipped=%lu noise_floor_avg=%lu",
             (unsigned long)stats.processed_frames,
             (unsigned long)stats.zeroed_quiet_frames,
             (unsigned long)stats.attenuated_quiet_frames,
             (unsigned long)stats.playback_quiet_frames,
             (unsigned long)stats.attenuated_impulse_frames,
             (unsigned long)stats.playback_unprotected_attenuated_frames,
             (unsigned long)stats.playback_unprotected_guarded_frames,
             (unsigned long)stats.playback_unprotected_zero_frames,
             (unsigned long)stats.playback_unprotected_min_gain_q15,
             (unsigned long)stats.playback_protected_gain_frames,
             (unsigned long)stats.playback_continuity_gain_frames,
             (unsigned long)stats.playback_protected_limited_frames,
             (unsigned long)stats.playback_gain_max_q15,
             (unsigned long)stats.playback_echo_veto_attenuated_frames,
             (unsigned long)stats.playback_echo_veto_guarded_frames,
             (unsigned long)stats.speech_protected_frames,
             (unsigned long)stats.softref_frames,
             (unsigned long)stats.softref_ref_active_frames,
             (unsigned long)stats.softref_ref_missing_frames,
             (unsigned long)stats.softref_linear_cancel_frames,
             (unsigned long)stats.softref_echo_gate_frames,
             (unsigned long)stats.softref_nearend_guard_frames,
             (unsigned long)stats.softref_underrun_samples,
             (unsigned long)stats.softref_last_ref_avg_abs,
             (unsigned long)stats.softref_last_ref_peak,
             (unsigned long)stats.softref_last_corr_q15,
             (unsigned long)stats.clipped_samples,
             (unsigned long)stats.noise_floor_avg_abs);
}

static void clear_wake_interrupt_cancel(const char *reason) {
    if (s_wake_interrupt_cancel.active) {
        ESP_LOGI(TAG,
                 "wake interrupt cancel cleared token=%lu generation=%lu physical=%d mic_released=%d reason=%s",
                 (unsigned long)s_wake_interrupt_cancel.mode_token,
                 (unsigned long)s_wake_interrupt_cancel.speaker_generation,
                 s_wake_interrupt_cancel.physical_stop_done ? 1 : 0,
                 s_wake_interrupt_cancel.detector_released ? 1 : 0,
                 reason ? reason : "-");
    }
    memset(&s_wake_interrupt_cancel, 0,
           sizeof(s_wake_interrupt_cancel));
}

static void clear_touch_cancel_recovery(const char *reason) {
    if (s_touch_cancel_recovery.active) {
        ESP_LOGI(TAG,
                 "touch cancel recovery cleared epoch=%lu awake_generation=%lu speaker_generation=%lu physical=%d detector_released=%d ack=%d ack_ok=%d reset_attempts=%u reason=%s",
                 (unsigned long)s_touch_cancel_recovery.ws_epoch,
                 (unsigned long)s_touch_cancel_recovery.awake_generation,
                 (unsigned long)s_touch_cancel_recovery.speaker_generation,
                 s_touch_cancel_recovery.physical_stop_done ? 1 : 0,
                 s_touch_cancel_recovery.detector_released ? 1 : 0,
                 s_touch_cancel_recovery.cancel_ack_received ? 1 : 0,
                 s_touch_cancel_recovery.cancel_ack_ok ? 1 : 0,
                 (unsigned)s_touch_cancel_recovery.reset_attempts,
                 reason ? reason : "-");
    }
    nuwax_touch_cancel_recovery_clear(&s_touch_cancel_recovery);
}

static void clear_head_touch_agent_intent(const char *reason) {
    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
        if (s_head_touch_agent_intent.interaction ==
            NUWAX_AGENT_INTERACTION_SHAKE) {
            nuwax_shake_detector_release_shake();
        } else {
            nuwax_shake_detector_release_head_touch();
        }
    }
    if (s_head_touch_agent_intent.interaction ==
            NUWAX_AGENT_INTERACTION_SHAKE &&
        s_head_touch_agent_intent.state !=
            NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
        bool pending_cancelled = false;
        uint32_t invalidated_through_revision = 0U;
        portENTER_CRITICAL(&s_emotion_ui_lock);
        pending_cancelled = nuwax_emotion_ui_cancel_source(
            &s_emotion_ui_sync, "shake_agent");
        if (pending_cancelled) {
            invalidated_through_revision = s_emotion_ui_sync.revision;
        }
        portEXIT_CRITICAL(&s_emotion_ui_lock);
        if (invalidated_through_revision != 0U) {
            nuwax_state_bridge_invalidate_semantic_revisions_through(
                invalidated_through_revision);
        }
        const bool active_cleared =
            nuwax_state_bridge_clear_semantic_emotion_if_owner(
                "shake_agent", 0U);
        if (pending_cancelled || active_cleared) {
            ESP_LOGI(TAG,
                     "shake semantic emotion cancelled pending=%d active=%d reason=%s",
                     pending_cancelled ? 1 : 0,
                     active_cleared ? 1 : 0,
                     reason ? reason : "-");
        }
    }
    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
        ESP_LOGI(TAG,
                 "head touch agent intent cleared token=%lu state=%s source=%s epoch=%lu awake_generation=%lu speaker_generation=%lu audio_session=%s reason=%s",
                 (unsigned long)s_head_touch_agent_intent.token,
                 nuwax_head_touch_agent_state_name(
                     s_head_touch_agent_intent.state),
                 nuwax_head_touch_agent_source_name(
                     s_head_touch_agent_intent.source),
                 (unsigned long)s_head_touch_agent_intent.ws_epoch,
                 (unsigned long)s_head_touch_agent_intent.awake_generation,
                 (unsigned long)s_head_touch_agent_intent.speaker_generation,
                 s_head_touch_agent_intent.audio_session_id[0]
                     ? s_head_touch_agent_intent.audio_session_id
                     : "-",
                 reason ? reason : "-");
    }
    nuwax_head_touch_agent_intent_clear(&s_head_touch_agent_intent);
}

static bool natural_playback_touch_protection_active(void) {
    const uint32_t deadline_ms =
        s_natural_playback_touch_protection_deadline_ms;
    if (deadline_ms == 0U) {
        return false;
    }
    if ((int32_t)(monotonic_ms() - deadline_ms) < 0) {
        return true;
    }
    s_natural_playback_touch_protection_deadline_ms = 0U;
    return false;
}

static bool __attribute__((unused)) begin_wake_interrupt_cancel(
    nuwax_ws_client_t *ws,
    const nuwax_wake_word_result_t *event) {
#if CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE && CONFIG_NUWAX_SPEAKER_ENABLE
    if (!ws || !event || s_wake_interrupt_cancel.active) {
        return false;
    }
    if (event->arm.playback_owner ==
        NUWAX_WAKE_PLAYBACK_OWNER_NOTIFICATION) {
        if (!nuwax_notification_matches(
                &s_notification_transaction,
                event->arm.ws_epoch,
                event->arm.notify_id,
                event->arm.playback_id) ||
            s_notification_transaction.speaker_generation !=
                event->arm.speaker_generation) {
            return false;
        }
        cancel_active_notification(ws, "wake_word_interrupt");
        return true;
    }
    /* Preserve the first-PCM fence before inhibiting the detector.  If the
     * speaker generation has already completed by the time this event is
     * consumed, the generation-bound cancel is legitimately rejected; in
     * that case the detector must be restored so a later TTS generation can
     * still be interrupted. */
    int64_t first_pcm_us = 0;
    (void)wake_detector_request_snapshot(&first_pcm_us);
    inhibit_sleep_wake_word_detector("wake_word_interrupt_confirmed");
    nuwax_wake_word_detector_request_stop();

    nuwax_speaker_cancel_request_result_t cancel = {0};
    if (!nuwax_speaker_playback_request_cancel_generation_ex(
            event->arm.speaker_generation,
            "wake_word_interrupt",
            CONFIG_NUWAX_WAKE_WORD_INTERRUPT_FADE_MS,
            &cancel)) {
        ESP_LOGE(TAG,
                 "wake interrupt could not arm generation-bound fade generation=%lu status=%d",
                 (unsigned long)event->arm.speaker_generation,
                 (int)cancel.status);
        if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_REJECTED) {
            request_playback_wake_word_detector(
                event->arm.ws_epoch,
                event->arm.speaker_generation,
                event->arm.turn_id,
                event->arm.playback_id,
                "cancel_rejected_rearm");
            if (first_pcm_us > 0) {
                (void)arm_playback_wake_word_detector(
                    event->arm.ws_epoch,
                    event->arm.speaker_generation,
                    first_pcm_us);
            }
        } else {
            /* A failed physical stop is not recoverable by starting a new
             * listen owner; leave the WebSocket recovery path in charge. */
            (void)nuwax_ws_request_close_if_epoch(ws, event->arm.ws_epoch);
        }
        return false;
    }

    char request_id[40] = {0};
    snprintf(request_id,
             sizeof(request_id),
             "wake_cancel_%lu",
             (unsigned long)++s_cancel_turn_request_seq);
    const int64_t send_deadline_us =
        esp_timer_get_time() +
        (int64_t)NUWAX_WAKE_INTERRUPT_CANCEL_SEND_TIMEOUT_MS * 1000LL;
    const esp_err_t send_err =
        nuwax_session_send_cancel_turn_until_if_epoch(
            ws,
            request_id,
            event->arm.turn_id,
            "wake_word_interrupt",
            send_deadline_us,
            event->arm.ws_epoch);
    if (send_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "wake interrupt cancel_turn failed generation=%lu err=%s; reconnecting without starting listen",
                 (unsigned long)event->arm.speaker_generation,
                 esp_err_to_name(send_err));
        (void)nuwax_ws_request_close_if_epoch(ws, event->arm.ws_epoch);
        return false;
    }

    if (!release_playback_terminal_after_committed_barge(
            event->arm.ws_epoch,
            event->arm.speaker_generation,
            event->arm.turn_id,
            event->arm.playback_id,
            "wake_word_interrupt")) {
        return false;
    }

    s_wake_interrupt_cancel = (nuwax_wake_interrupt_cancel_t){
        .active = true,
        .physical_stop_done =
            cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
            cancel.completed_stop_result == ESP_OK,
        .mode_token = event->arm.mode_token,
        .ws_epoch = event->arm.ws_epoch,
        .speaker_generation = event->arm.speaker_generation,
        .deadline_ms = monotonic_ms() +
                       NUWAX_WAKE_INTERRUPT_CANCEL_TIMEOUT_MS,
    };
    strlcpy(s_wake_interrupt_cancel.turn_id,
            event->arm.turn_id,
            sizeof(s_wake_interrupt_cancel.turn_id));
    strlcpy(s_wake_interrupt_cancel.playback_id,
            event->arm.playback_id,
            sizeof(s_wake_interrupt_cancel.playback_id));
    clear_auto_followup("wake_word_interrupt");
    nuwax_app_shell_set_conversation_status(
        "VOICE", "CANCEL", "wake interrupt", true);
    ESP_LOGI(TAG,
             "wake interrupt committed token=%lu ws_epoch=%lu generation=%lu prob=%lu fade_ms=%d turn=%s playback=%s",
             (unsigned long)event->arm.mode_token,
             (unsigned long)event->arm.ws_epoch,
             (unsigned long)event->arm.speaker_generation,
             (unsigned long)event->probability_q1000,
             CONFIG_NUWAX_WAKE_WORD_INTERRUPT_FADE_MS,
             event->arm.turn_id,
             event->arm.playback_id);
    return true;
#else
    (void)ws;
    (void)event;
    return false;
#endif
}

static bool handle_playback_wake_event(
    nuwax_ws_client_t *ws,
    const nuwax_wake_word_result_t *event) {
#if CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
    if (!event ||
        event->arm.mode != NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT) {
        return false;
    }
    const uint32_t now_ms = monotonic_ms();
    int64_t first_pcm_us = 0;
    const nuwax_wake_arm_context_t request =
        wake_detector_request_snapshot(&first_pcm_us);
    const bool request_matches =
        atomic_load_explicit(&s_wake_detector_desired,
                             memory_order_acquire) &&
        request.mode == NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT &&
        request.mode_token == event->arm.mode_token &&
        request.ws_epoch == event->arm.ws_epoch &&
        request.speaker_generation == event->arm.speaker_generation &&
        request.playback_owner == event->arm.playback_owner &&
        ((request.playback_owner ==
              NUWAX_WAKE_PLAYBACK_OWNER_NOTIFICATION &&
          strcmp(request.notify_id, event->arm.notify_id) == 0) ||
         (request.playback_owner ==
              NUWAX_WAKE_PLAYBACK_OWNER_CONVERSATION &&
          strcmp(request.turn_id, event->arm.turn_id) == 0)) &&
        strcmp(request.playback_id, event->arm.playback_id) == 0;
    const bool fresh =
        !elapsed_ms(now_ms,
                    event->detected_ms +
                        CONFIG_NUWAX_WAKE_WORD_INTERRUPT_EVENT_MAX_AGE_MS);
    const bool after_first_pcm = first_pcm_us > 0 &&
                                 event->detected_us >= first_pcm_us;
    const bool conversation_matches =
        event->arm.playback_owner ==
            NUWAX_WAKE_PLAYBACK_OWNER_CONVERSATION &&
        s_turn_guard.active &&
        s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING &&
        nuwax_turn_guard_speaker_generation_matches(
            &s_turn_guard, event->arm.speaker_generation) &&
        strcmp(s_turn_guard.turn_id, event->arm.turn_id) == 0 &&
        strcmp(s_turn_guard.playback_id, event->arm.playback_id) == 0;
    const bool notification_matches =
        event->arm.playback_owner ==
            NUWAX_WAKE_PLAYBACK_OWNER_NOTIFICATION &&
        nuwax_notification_matches(&s_notification_transaction,
                                   event->arm.ws_epoch,
                                   event->arm.notify_id,
                                   event->arm.playback_id) &&
        s_notification_transaction.speaker_generation ==
            event->arm.speaker_generation &&
        (s_notification_transaction.state ==
             NUWAX_NOTIFICATION_STATE_STREAMING ||
         s_notification_transaction.state ==
             NUWAX_NOTIFICATION_STATE_DRAINING);
    const bool owner_matches =
        conversation_matches || notification_matches;
    const bool epoch_matches = ws && nuwax_ws_is_connected(ws) &&
                               nuwax_ws_connection_epoch(ws) ==
                                   event->arm.ws_epoch &&
                               active_ws_epoch_snapshot() ==
                                   event->arm.ws_epoch;
    if (!request_matches || !fresh || !after_first_pcm || !owner_matches ||
        !epoch_matches || s_wake_interrupt_cancel.active) {
        ESP_LOGW(TAG,
                 "playback wake event rejected token=%lu request_token=%lu generation=%lu request_generation=%lu fresh=%d after_first_pcm=%d turn=%d epoch=%d transaction=%d age_ms=%lu",
                 (unsigned long)event->arm.mode_token,
                 (unsigned long)request.mode_token,
                 (unsigned long)event->arm.speaker_generation,
                 (unsigned long)request.speaker_generation,
                 fresh ? 1 : 0,
                 after_first_pcm ? 1 : 0,
                 owner_matches ? 1 : 0,
                 epoch_matches ? 1 : 0,
                 s_wake_interrupt_cancel.active ? 1 : 0,
                 (unsigned long)(now_ms - event->detected_ms));
        if (request_matches && owner_matches && epoch_matches &&
            !s_wake_interrupt_cancel.active) {
            notify_wake_supervisor();
        }
        return true;
    }

    ESP_LOGI(TAG,
             "playback wake decision token=%lu generation=%lu prob=%lu eligible=%d shadow=%d reference=%d active=%d corr_q15=%lu echo=%d nearfield=%d mic1=%lu/%lu mic2=%lu/%lu diff=%lu/%lu",
             (unsigned long)event->arm.mode_token,
             (unsigned long)event->arm.speaker_generation,
             (unsigned long)event->probability_q1000,
             event->action_eligible ? 1 : 0,
             CONFIG_NUWAX_WAKE_WORD_INTERRUPT_SHADOW_ONLY ? 1 : 0,
             event->reference_available ? 1 : 0,
             event->reference_active ? 1 : 0,
             (unsigned long)event->reference_correlation_q15,
             event->echo_likely ? 1 : 0,
             event->nearfield_safe ? 1 : 0,
             (unsigned long)event->mic1_avg_abs,
             (unsigned long)event->mic1_peak,
             (unsigned long)event->mic2_avg_abs,
             (unsigned long)event->mic2_peak,
             (unsigned long)event->diff_avg_abs,
             (unsigned long)event->diff_peak);
    if (event->probe_requested) {
        if (CONFIG_NUWAX_WAKE_WORD_INTERRUPT_SHADOW_ONLY) {
            ESP_LOGI(TAG,
                     "playback wake probe suppressed shadow_only=1 generation=%lu",
                     (unsigned long)event->arm.speaker_generation);
            return true;
        }
        const bool probe_applied =
            nuwax_speaker_playback_request_probe_duck_generation(
                event->arm.speaker_generation,
                NUWAX_WAKE_PROBE_ATTENUATION_DB,
                NUWAX_WAKE_PROBE_DURATION_MS);
        ESP_LOGI(TAG,
                 "speaker probe duck applied=%d generation=%lu attenuation_db=%u duration_ms=%u",
                 probe_applied ? 1 : 0,
                 (unsigned long)event->arm.speaker_generation,
                 (unsigned)NUWAX_WAKE_PROBE_ATTENUATION_DB,
                 (unsigned)NUWAX_WAKE_PROBE_DURATION_MS);
        return true;
    }
    if (CONFIG_NUWAX_WAKE_WORD_INTERRUPT_SHADOW_ONLY ||
        !event->action_eligible) {
        notify_wake_supervisor();
        return true;
    }
    (void)begin_wake_interrupt_cancel(ws, event);
    return true;
#else
    (void)ws;
    (void)event;
    return false;
#endif
}

static void service_wake_interrupt_cancel(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE && CONFIG_NUWAX_SPEAKER_ENABLE
    if (!s_wake_interrupt_cancel.active) {
        return;
    }
    if (!ws || !nuwax_ws_is_connected(ws) ||
        nuwax_ws_connection_epoch(ws) != s_wake_interrupt_cancel.ws_epoch) {
        clear_wake_interrupt_cancel("ws_epoch_changed");
        return;
    }

    const uint32_t now_ms = monotonic_ms();
    if (!s_wake_interrupt_cancel.detector_released &&
        !nuwax_wake_word_detector_is_running()) {
        s_wake_interrupt_cancel.detector_released = true;
        ESP_LOGI(TAG,
                 "wake interrupt microphone released token=%lu generation=%lu",
                 (unsigned long)s_wake_interrupt_cancel.mode_token,
                 (unsigned long)s_wake_interrupt_cancel.speaker_generation);
    }
    if (!s_wake_interrupt_cancel.physical_stop_done) {
        nuwax_speaker_playback_stats_t stats = {0};
        nuwax_speaker_playback_get_stats(&stats);
        if (stats.completed_stop_generation ==
                s_wake_interrupt_cancel.speaker_generation &&
            stats.completed_stop_connection_epoch ==
                s_wake_interrupt_cancel.ws_epoch &&
            stats.completed_stop_result == ESP_OK) {
            s_wake_interrupt_cancel.physical_stop_done = true;
        } else if (stats.failed_stop_generation ==
                       s_wake_interrupt_cancel.speaker_generation &&
                   stats.failed_stop_connection_epoch ==
                       s_wake_interrupt_cancel.ws_epoch) {
            ESP_LOGE(TAG,
                     "wake interrupt physical stop failed generation=%lu err=%s; reconnecting",
                     (unsigned long)s_wake_interrupt_cancel.speaker_generation,
                     esp_err_to_name(stats.failed_stop_result));
            (void)nuwax_ws_request_close_if_epoch(
                ws, s_wake_interrupt_cancel.ws_epoch);
            clear_wake_interrupt_cancel("physical_stop_failed");
            return;
        }
    }

    if (s_wake_interrupt_cancel.physical_stop_done &&
        s_wake_interrupt_cancel.detector_released) {
        if (s_wake_interrupt_cancel.guard_deadline_ms == 0U) {
            s_wake_interrupt_cancel.guard_deadline_ms =
                now_ms +
                CONFIG_NUWAX_WAKE_WORD_INTERRUPT_POST_STOP_GUARD_MS;
            ESP_LOGI(TAG,
                     "wake interrupt acoustic guard started generation=%lu guard_ms=%d",
                     (unsigned long)s_wake_interrupt_cancel.speaker_generation,
                     CONFIG_NUWAX_WAKE_WORD_INTERRUPT_POST_STOP_GUARD_MS);
            return;
        }
        if (elapsed_ms(now_ms,
                       s_wake_interrupt_cancel.guard_deadline_ms)) {
            const uint32_t generation =
                s_wake_interrupt_cancel.speaker_generation;
            clear_wake_interrupt_cancel("listening_handoff");
            reset_awake_wait_budget_paused("wake_word_interrupt");
            return_to_listening_after_cancel("wake_word_interrupt");
            ESP_LOGI(TAG,
                     "wake interrupt listening handoff complete generation=%lu",
                     (unsigned long)generation);
            return;
        }
    }

    if (elapsed_ms(now_ms, s_wake_interrupt_cancel.deadline_ms)) {
        ESP_LOGE(TAG,
                 "wake interrupt cancel barrier timed out generation=%lu physical=%d mic_released=%d; reconnecting",
                 (unsigned long)s_wake_interrupt_cancel.speaker_generation,
                 s_wake_interrupt_cancel.physical_stop_done ? 1 : 0,
                 s_wake_interrupt_cancel.detector_released ? 1 : 0);
        (void)nuwax_ws_request_close_if_epoch(
            ws, s_wake_interrupt_cancel.ws_epoch);
        clear_wake_interrupt_cancel("barrier_timeout");
    }
#else
    (void)ws;
#endif
}

static void service_touch_cancel_recovery(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!s_touch_cancel_recovery.active) {
        return;
    }

    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (!ws || !nuwax_ws_is_connected(ws) || active_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != active_epoch ||
        !nuwax_touch_cancel_recovery_owner_matches(
            &s_touch_cancel_recovery,
            active_epoch,
            awake_generation)) {
        clear_touch_cancel_recovery("owner_boundary_changed");
        return;
    }
    if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        clear_touch_cancel_recovery("sleep_takeover");
        return;
    }
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        clear_touch_cancel_recovery("reprovision_takeover");
        return;
    }
    if (sleep_lifecycle_blocks_new_capture()) {
        /* Sleep and notification transactions independently poll the same
         * generation-bound stop statistics. Yield the listening handoff to
         * the newer lifecycle owner instead of reopening normal capture. */
        clear_touch_cancel_recovery("audio_lifecycle_takeover");
        return;
    }
    if (exclusive_audio_mode_blocks_normal_audio()) {
        clear_touch_cancel_recovery("exclusive_audio_takeover");
        return;
    }
#if CONFIG_NUWAX_OTA_ENABLE
    if (nuwax_ota_device_blocks_audio()) {
        clear_touch_cancel_recovery("ota_takeover");
        return;
    }
#endif

    if (s_touch_cancel_recovery.head_touch_agent_handoff &&
        s_touch_cancel_recovery.cancel_ack_received &&
        !s_touch_cancel_recovery.cancel_ack_ok) {
        const uint32_t rejected_epoch = s_touch_cancel_recovery.ws_epoch;
        ESP_LOGE(TAG,
                 "head touch cancel rejected; closing bound WebSocket before physical recovery completes epoch=%lu generation=%lu",
                 (unsigned long)rejected_epoch,
                 (unsigned long)s_touch_cancel_recovery.speaker_generation);
        if (s_turn_guard.active &&
            strncmp(s_turn_guard.request_id,
                    NUWAX_HEAD_TOUCH_AGENT_REQUEST_PREFIX,
                    sizeof(NUWAX_HEAD_TOUCH_AGENT_REQUEST_PREFIX) - 1U) ==
                0) {
            clear_active_turn_guard("head_touch_agent_cancel_rejected");
        }
        clear_head_touch_agent_intent("cancel_ack_rejected");
        clear_touch_cancel_recovery("cancel_ack_rejected");
        (void)nuwax_ws_request_close_if_epoch(ws, rejected_epoch);
        return;
    }

#if CONFIG_NUWAX_WAKE_WORD_ENABLE
    if (!s_touch_cancel_recovery.detector_released) {
        inhibit_sleep_wake_word_detector("touch_cancel_recovery");
        nuwax_wake_word_detector_request_stop();
        if (!nuwax_wake_word_detector_is_running()) {
            (void)nuwax_touch_cancel_recovery_mark_detector_released(
                &s_touch_cancel_recovery);
            ESP_LOGI(TAG,
                     "touch cancel wake detector released generation=%lu",
                     (unsigned long)s_touch_cancel_recovery
                         .speaker_generation);
        }
    }
#else
    (void)nuwax_touch_cancel_recovery_mark_detector_released(
        &s_touch_cancel_recovery);
#endif

    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    if (!s_touch_cancel_recovery.physical_stop_done &&
        stats.completed_stop_connection_epoch ==
            s_touch_cancel_recovery.ws_epoch &&
        stats.completed_stop_generation ==
            s_touch_cancel_recovery.speaker_generation &&
        stats.completed_stop_result == ESP_OK) {
        (void)nuwax_touch_cancel_recovery_mark_physical_stop(
            &s_touch_cancel_recovery,
            stats.completed_stop_connection_epoch,
            stats.completed_stop_generation);
        ESP_LOGI(TAG,
                 "touch cancel physical stop observed by stats epoch=%lu generation=%lu",
                 (unsigned long)stats.completed_stop_connection_epoch,
                 (unsigned long)stats.completed_stop_generation);
    }

    const uint32_t now_ms = monotonic_ms();
    const bool speaker_pending = nuwax_speaker_playback_has_pending();
    const bool stop_failed =
        !s_touch_cancel_recovery.physical_stop_done &&
        stats.failed_stop_connection_epoch ==
            s_touch_cancel_recovery.ws_epoch &&
        stats.failed_stop_generation ==
            s_touch_cancel_recovery.speaker_generation;
    const bool expired = nuwax_touch_cancel_recovery_deadline_expired(
        &s_touch_cancel_recovery, now_ms);

    if (s_touch_cancel_recovery.physical_stop_done &&
        s_touch_cancel_recovery.detector_released && !speaker_pending) {
        const uint32_t generation =
            s_touch_cancel_recovery.speaker_generation;
        const bool agent_handoff =
            s_touch_cancel_recovery.head_touch_agent_handoff;
        if (agent_handoff) {
            if (s_head_touch_agent_intent.state ==
                    NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
                s_head_touch_agent_intent.source ==
                    NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK &&
                s_head_touch_agent_intent.ws_epoch ==
                    s_touch_cancel_recovery.ws_epoch &&
                s_head_touch_agent_intent.speaker_generation == generation) {
                (void)nuwax_head_touch_agent_intent_mark_speaker_released(
                    &s_head_touch_agent_intent,
                    s_touch_cancel_recovery.ws_epoch,
                    generation);
            }
            if (s_touch_cancel_recovery.cancel_ack_received &&
                !s_touch_cancel_recovery.cancel_ack_ok) {
                ESP_LOGE(TAG,
                         "head touch cancel rejected after physical stop; closing bound WebSocket epoch=%lu generation=%lu",
                         (unsigned long)s_touch_cancel_recovery.ws_epoch,
                         (unsigned long)generation);
                if (s_head_touch_agent_intent.state ==
                    NUWAX_HEAD_TOUCH_AGENT_STATE_SENT &&
                    s_turn_guard.active &&
                    strcmp(s_turn_guard.request_id,
                           s_head_touch_agent_intent.request_id) == 0) {
                    clear_active_turn_guard("head_touch_agent_cancel_rejected");
                }
                clear_head_touch_agent_intent("cancel_ack_rejected");
                const uint32_t rejected_epoch =
                    s_touch_cancel_recovery.ws_epoch;
                clear_touch_cancel_recovery("cancel_ack_rejected");
                (void)nuwax_ws_request_close_if_epoch(ws, rejected_epoch);
                return;
            }
            if (!s_touch_cancel_recovery.cancel_ack_received) {
                if (!s_touch_cancel_recovery.cancel_ack_grace_started) {
                    s_touch_cancel_recovery.deadline_ms =
                        monotonic_ms() +
                        NUWAX_TOUCH_CANCEL_ACK_GRACE_MS;
                    s_touch_cancel_recovery.cancel_ack_grace_started = true;
                }
                const bool ack_expired =
                    nuwax_touch_cancel_recovery_deadline_expired(
                        &s_touch_cancel_recovery, monotonic_ms());
                if (ack_expired) {
                    ESP_LOGW(TAG,
                             "head touch cancel ACK grace expired; releasing local recovery token=%lu",
                             (unsigned long)s_head_touch_agent_intent.token);
                    clear_touch_cancel_recovery("cancel_ack_grace_expired");
                    return;
                }
                ESP_LOGI(TAG,
                         "head touch agent speaker barrier released; retaining cancel identity for late ACK window_ms=%u token=%lu",
                         (unsigned)NUWAX_TOUCH_CANCEL_ACK_GRACE_MS,
                         (unsigned long)s_head_touch_agent_intent.token);
                return;
            }
            clear_touch_cancel_recovery("head_touch_agent_handoff_acknowledged");
            ESP_LOGI(TAG,
                     "head touch agent speaker barrier released token=%lu generation=%lu",
                     (unsigned long)s_head_touch_agent_intent.token,
                     (unsigned long)generation);
            return;
        }
        clear_touch_cancel_recovery("listening_handoff");
        reset_awake_wait_budget_paused("touch_cancel_recovery");
        recover_normal_conversation_after_playback_abort(
            "touch_cancel_recovery");
        ESP_LOGI(TAG,
                 "touch cancel listening handoff complete generation=%lu",
                 (unsigned long)generation);
        return;
    }

    if (expired && !s_touch_cancel_recovery.detector_released) {
        ESP_LOGE(TAG,
                 "touch cancel wake detector release timed out generation=%lu; enforcing bounded MIC owner stop",
                 (unsigned long)s_touch_cancel_recovery
                     .speaker_generation);
        stop_sleep_wake_word_detector("touch_cancel_recovery_timeout");
        (void)nuwax_touch_cancel_recovery_mark_detector_released(
            &s_touch_cancel_recovery);
    }

    const bool reset_required =
        (stop_failed && s_touch_cancel_recovery.reset_attempts == 0U) ||
        (expired &&
         (!s_touch_cancel_recovery.physical_stop_done || speaker_pending));
    if (!reset_required) {
        return;
    }
    if (s_touch_cancel_recovery.reset_attempts >=
        NUWAX_TOUCH_CANCEL_MAX_RESET_ATTEMPTS) {
        ESP_LOGE(TAG,
                 "touch cancel failed to establish physical silence epoch=%lu generation=%lu pending=%d; WebSocket retained and listening remains blocked",
                 (unsigned long)s_touch_cancel_recovery.ws_epoch,
                 (unsigned long)s_touch_cancel_recovery.speaker_generation,
                 speaker_pending ? 1 : 0);
        clear_touch_cancel_recovery("speaker_reset_exhausted");
        set_conversation_status_guarded(
            "SYSTEM", "ERROR", "speaker recovery failed", true);
        set_state(NUWAX_APP_STATE_ERROR);
        return;
    }

    s_touch_cancel_recovery.reset_attempts++;
    const uint8_t reset_attempt =
        s_touch_cancel_recovery.reset_attempts;
    ESP_LOGW(TAG,
             "touch cancel resetting local speaker runtime attempt=%u/%u epoch=%lu generation=%lu stop_failed=%d pending=%d",
             (unsigned)reset_attempt,
             (unsigned)NUWAX_TOUCH_CANCEL_MAX_RESET_ATTEMPTS,
             (unsigned long)s_touch_cancel_recovery.ws_epoch,
             (unsigned long)s_touch_cancel_recovery.speaker_generation,
             stop_failed ? 1 : 0,
             speaker_pending ? 1 : 0);
    const esp_err_t reset_err = nuwax_speaker_playback_reset_runtime();
    if (reset_err == ESP_OK && !nuwax_speaker_playback_has_pending()) {
        s_touch_cancel_recovery.physical_stop_done = true;
        s_touch_cancel_recovery.deadline_ms =
            monotonic_ms() + NUWAX_TOUCH_CANCEL_RESET_RETRY_TIMEOUT_MS;
        ESP_LOGW(TAG,
                 "touch cancel local speaker runtime reset recovered physical silence attempt=%u",
                 (unsigned)reset_attempt);
        return;
    }

    s_touch_cancel_recovery.deadline_ms =
        monotonic_ms() + NUWAX_TOUCH_CANCEL_RESET_RETRY_TIMEOUT_MS;
    ESP_LOGE(TAG,
             "touch cancel local speaker runtime reset incomplete attempt=%u err=%s pending=%d; retry remains bounded and WebSocket is retained",
             (unsigned)reset_attempt,
             esp_err_to_name(reset_err),
             nuwax_speaker_playback_has_pending() ? 1 : 0);
#else
    (void)ws;
#endif
}

static void service_head_touch_agent_intent(nuwax_ws_client_t *ws) {
    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
        return;
    }
    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_CANCELLED) {
        clear_head_touch_agent_intent("cancelled");
        return;
    }
    const bool is_shake =
        s_head_touch_agent_intent.interaction == NUWAX_AGENT_INTERACTION_SHAKE;
    const char *request_prefix = is_shake
                                     ? NUWAX_SHAKE_AGENT_REQUEST_PREFIX
                                     : NUWAX_HEAD_TOUCH_AGENT_REQUEST_PREFIX;
    const char *agent_text = is_shake ? NUWAX_SHAKE_AGENT_TEXT
                                      : NUWAX_HEAD_TOUCH_AGENT_TEXT;

    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (!ws || !nuwax_ws_is_connected(ws) || active_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != active_epoch ||
        !nuwax_head_touch_agent_intent_owner_matches(
            &s_head_touch_agent_intent,
            active_epoch,
            awake_generation)) {
        clear_head_touch_agent_intent("owner_boundary_changed");
        return;
    }
    if (head_touch_agent_is_blocked() || s_notification_transaction.active) {
        const bool ota_takeover =
#if CONFIG_NUWAX_OTA_ENABLE
            nuwax_ota_device_blocks_audio();
#else
            false;
#endif
        const bool active_head_touch_turn =
            s_turn_guard.active &&
            strncmp(s_turn_guard.request_id,
                    request_prefix,
                    strlen(request_prefix)) ==
                0;
        if (ota_takeover && active_head_touch_turn) {
            clear_active_turn_guard("ota_takeover_head_touch_agent");
        }
        clear_head_touch_agent_intent("strong_lifecycle_takeover");
        return;
    }
    if (nuwax_head_touch_agent_intent_cancel_ack_expired(
            &s_head_touch_agent_intent, monotonic_ms())) {
        ESP_LOGE(TAG,
                 "head touch agent cancel ACK timed out token=%lu request=%s turn=%s epoch=%lu; closing owner epoch before any replacement turn",
                 (unsigned long)s_head_touch_agent_intent.token,
                 s_head_touch_agent_intent.cancel_request_id[0]
                     ? s_head_touch_agent_intent.cancel_request_id
                     : "-",
                 s_head_touch_agent_intent.cancel_turn_id[0]
                     ? s_head_touch_agent_intent.cancel_turn_id
                     : "-",
                 (unsigned long)active_epoch);
        clear_head_touch_agent_intent("cancel_ack_timeout");
        (void)nuwax_ws_request_close_if_epoch(ws, active_epoch);
        return;
    }
    if (s_head_touch_agent_intent.cancel_ack_received &&
        !s_head_touch_agent_intent.cancel_ack_ok) {
        ESP_LOGE(TAG,
                 "head touch agent cancel rejected by cloud token=%lu epoch=%lu; closing bound WebSocket",
                 (unsigned long)s_head_touch_agent_intent.token,
                 (unsigned long)active_epoch);
        if (s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_SENT) {
            clear_active_turn_guard("head_touch_agent_cancel_rejected");
        }
        clear_head_touch_agent_intent("cancel_ack_rejected");
        (void)nuwax_ws_request_close_if_epoch(ws, active_epoch);
        return;
    }

    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_SENT) {
        if (!s_turn_guard.active ||
            strcmp(s_turn_guard.request_id,
                   s_head_touch_agent_intent.request_id) != 0) {
            clear_head_touch_agent_intent("sent_turn_owner_released");
        }
        return;
    }

    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_ARBITRATING) {
        if (s_head_touch_agent_intent.source ==
            NUWAX_HEAD_TOUCH_AGENT_SOURCE_POST_END_ASR) {
            if (s_turn_guard.active) {
                clear_head_touch_agent_intent(
                    "post_end_user_turn_won");
                return;
            }
            const bool matching_asr_wait =
                nuwax_listen_resume_state_is_waiting_post_end_asr(
                    &s_listen_resume) &&
                nuwax_listen_resume_state_event_matches(
                    &s_listen_resume,
                    awake_generation,
                    s_head_touch_agent_intent.audio_session_id);
            if (matching_asr_wait) {
                return;
            }
            if (atomic_load_explicit(
                    &s_conversation_capture_runtime_active,
                    memory_order_acquire) ||
                s_prelisten.capture_active) {
                clear_head_touch_agent_intent(
                    "new_capture_won_after_post_end_asr");
                return;
            }
            if (!nuwax_head_touch_agent_intent_begin_quiesce(
                    &s_head_touch_agent_intent) ||
                !begin_head_touch_agent_quiesce(ws)) {
                clear_head_touch_agent_intent(
                    "post_end_asr_quiesce_failed");
            }
            return;
        }
        if (s_head_touch_agent_intent.source ==
                NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING &&
            s_turn_guard.active) {
            clear_head_touch_agent_intent("cloud_user_turn_won");
            return;
        }
        if (s_head_touch_agent_intent.capture_required &&
            !atomic_load_explicit(&s_conversation_capture_runtime_active,
                                  memory_order_acquire) &&
            !s_prelisten.capture_active) {
            clear_head_touch_agent_intent("capture_ended_before_arbitration");
        }
        return;
    }

    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING) {
        if (s_turn_guard.active) {
            clear_head_touch_agent_intent("new_turn_won_before_send");
            return;
        }
#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (s_head_touch_agent_intent.speaker_required &&
            !s_head_touch_agent_intent.speaker_released &&
            !s_touch_cancel_recovery.active) {
            nuwax_speaker_playback_stats_t stats = {0};
            nuwax_speaker_playback_get_stats(&stats);
            const bool matching_stop =
                stats.completed_stop_connection_epoch == active_epoch &&
                stats.completed_stop_generation ==
                    s_head_touch_agent_intent.speaker_generation &&
                stats.completed_stop_result == ESP_OK;
            if (matching_stop || !nuwax_speaker_playback_has_pending()) {
                (void)nuwax_head_touch_agent_intent_mark_speaker_released(
                    &s_head_touch_agent_intent,
                    active_epoch,
                    s_head_touch_agent_intent.speaker_generation);
            }
        }
#endif
        if (s_head_touch_agent_intent.capture_required &&
            !s_head_touch_agent_intent.capture_released &&
            !atomic_load_explicit(&s_conversation_capture_runtime_active,
                                  memory_order_acquire) &&
            !s_prelisten.capture_active) {
            (void)nuwax_head_touch_agent_intent_mark_capture_released(
                &s_head_touch_agent_intent,
                active_epoch,
                awake_generation,
                s_head_touch_agent_intent.audio_session_id[0]
                    ? s_head_touch_agent_intent.audio_session_id
                    : NULL);
        }
        if (nuwax_head_touch_agent_intent_advance_release_barrier(
                &s_head_touch_agent_intent)) {
            ESP_LOGI(TAG,
                     "head touch agent release barriers complete token=%lu; draining queued cloud events before send",
                     (unsigned long)s_head_touch_agent_intent.token);
        }
        return;
    }

    if (s_head_touch_agent_intent.state ==
        NUWAX_HEAD_TOUCH_AGENT_STATE_READY_DRAIN) {
        if (s_turn_guard.active) {
            clear_head_touch_agent_intent("queued_cloud_turn_won");
            return;
        }
        (void)nuwax_head_touch_agent_intent_advance_drain_barrier(
            &s_head_touch_agent_intent);
        return;
    }

    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_READY_TO_SEND) {
        return;
    }
    if (s_turn_guard.active || nuwax_audio_terminal_recovery_pending() ||
        atomic_load_explicit(&s_conversation_capture_runtime_active,
                             memory_order_acquire) ||
        s_prelisten.capture_active) {
        if (s_turn_guard.active) {
            clear_head_touch_agent_intent("turn_owner_changed_at_commit");
        }
        return;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        clear_head_touch_agent_intent("speaker_owner_changed_at_commit");
        return;
    }
#endif

    char request_id[NUWAX_HEAD_TOUCH_AGENT_REQUEST_ID_LEN];
    snprintf(request_id,
             sizeof(request_id),
             "%s%lu",
             request_prefix,
             (unsigned long)++s_cloud_text_request_seq);
    if (!begin_active_turn_guard(request_id,
                                 NULL,
                                 NUWAX_CONVERSATION_TEXT_TIMEOUT_MS,
                                 is_shake ? "shake_agent" : "head_touch_agent")) {
        clear_head_touch_agent_intent("turn_guard_start_failed");
        return;
    }
    if (!begin_conversation_visual_round(
            is_shake ? NUWAX_VISUAL_ROUND_SHAKE
                     : NUWAX_VISUAL_ROUND_HEAD_TOUCH,
            request_id,
            is_shake ? "shake_agent" : "head_touch_agent")) {
        clear_active_turn_guard("head_touch_visual_round_failed");
        clear_head_touch_agent_intent("visual_round_start_failed");
        return;
    }
    if (active_ws_epoch_snapshot() != active_epoch ||
        nuwax_ws_connection_epoch(ws) != active_epoch) {
        clear_active_turn_guard("head_touch_agent_epoch_lost");
        clear_head_touch_agent_intent("epoch_lost_before_send");
        return;
    }

    /* Retire the old listen identity only at the send commit point. Commands
     * already queued for it were drained during READY_DRAIN. */
    clear_last_listen_resume();
    const esp_err_t err =
        nuwax_session_send_text_request_with_timeout_if_epoch(
            ws,
            request_id,
            agent_text,
            NUWAX_INTERACTIVE_CONTROL_SEND_TIMEOUT_MS,
            active_epoch);
    if (err != ESP_OK) {
        const bool safe_unsent =
            nuwax_ws_is_connected(ws) &&
            nuwax_ws_connection_epoch(ws) == active_epoch &&
            active_ws_epoch_snapshot() == active_epoch;
        clear_active_turn_guard("head_touch_agent_send_failed");
        clear_head_touch_agent_intent(safe_unsent
                                          ? "send_safely_unsent"
                                          : "send_transport_failed");
        if (safe_unsent &&
            !resume_awake_conversation_after_inactivity(
                "head_touch_agent_send_failed")) {
            enter_sleeping_conversation_state(
                "head_touch_agent_send_failed");
        }
        return;
    }
    if (!nuwax_head_touch_agent_intent_mark_sent(
            &s_head_touch_agent_intent, request_id)) {
        ESP_LOGE(TAG,
                 "head touch agent send committed but transaction could not enter SENT; closing epoch=%lu",
                 (unsigned long)active_epoch);
        clear_active_turn_guard("head_touch_agent_sent_state_failed");
        clear_head_touch_agent_intent("sent_state_failed");
        (void)nuwax_ws_request_close_if_epoch(ws, active_epoch);
        return;
    }
    metrics_begin_prelisten(is_shake ? "shake" : "head_touch",
                            is_shake ? "shake_request_committed"
                                     : "head_touch_request_committed");
    (void)invalidate_all_pending_semantic_emotions(
        is_shake ? "shake_round_committed" : "touch_round_committed");
    nuwax_state_bridge_clear_waiting_question();
    if (is_shake) {
        nuwax_state_bridge_pin_shake();
    } else {
        nuwax_state_bridge_pin_touch();
    }
    pause_awake_waiting(is_shake ? "shake_agent_sent" : "head_touch_agent_sent");
    set_conversation_status_guarded(
        is_shake ? "SHAKE" : "TOUCH", "WAIT_REPLY", agent_text, true);
    ESP_LOGI(TAG,
             "head touch agent text_request sent token=%lu request=%s epoch=%lu text=%s",
             (unsigned long)s_head_touch_agent_intent.token,
             request_id,
             (unsigned long)active_epoch,
             agent_text);
}

/* Playback wake events share a queue with the ordinary sleep wake event.  The
 * cloud-update wait loop and the microphone capture loop both call
 * drain_session_commands_limited(), so consume only a playback event here and
 * leave a normal wake event at the queue head for wait_for_mic_start_action().
 * This keeps the interrupt path bounded by the normal 20 ms/command polling
 * cadence instead of the 2.5 s cloud-settle window. */
static void drain_playback_wake_events(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_WAKE_WORD_ENABLE && CONFIG_NUWAX_WAKE_WORD_INTERRUPT_ENABLE
    if (!ws || !s_wake_word_events) {
        return;
    }
    for (unsigned i = 0U; i < 2U; ++i) {
        wake_word_event_t peek = {0};
        if (xQueuePeek(s_wake_word_events, &peek, 0) != pdTRUE) {
            break;
        }
        if (peek.arm.mode != NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT) {
            /* A sleep detector hit can race the transition into a bound TTS
             * generation.  It is stale once the turn is PLAYING and must not
             * sit in front of the playback event, otherwise the supervisor's
             * queue guard prevents the playback detector from starting. */
            if (peek.arm.mode == NUWAX_WAKE_MODE_SLEEP &&
                ((s_turn_guard.active &&
                  s_turn_guard.phase == NUWAX_TURN_PHASE_PLAYING) ||
                 s_notification_transaction.active)) {
                wake_word_event_t stale = {0};
                if (xQueueReceive(s_wake_word_events, &stale, 0) == pdTRUE) {
                    ESP_LOGI(TAG,
                             "stale sleep wake event dropped during playback epoch=%lu generation=%lu",
                             (unsigned long)stale.arm.ws_epoch,
                             (unsigned long)stale.arm.speaker_generation);
                    continue;
                }
            }
            break;
        }
        wake_word_event_t event = {0};
        if (xQueueReceive(s_wake_word_events, &event, 0) != pdTRUE) {
            break;
        }
        (void)handle_playback_wake_event(ws, &event);
    }
    service_wake_interrupt_cancel(ws);
#else
    (void)ws;
#endif
}

static esp_err_t send_wake_word_greeting(nuwax_ws_client_t *ws, const char *wake_word) {
    char request_id[48];
    snprintf(request_id,
             sizeof(request_id),
             NUWAX_WAKE_WORD_GREETING_REQUEST_PREFIX "%lu",
             (unsigned long)++s_cloud_text_request_seq);
    ESP_LOGI(TAG,
             "Sending wake greeting id=%s wake_word=%s text=%s",
             request_id,
             wake_word && wake_word[0] ? wake_word : "-",
             NUWAX_WAKE_WORD_GREETING_TEXT);
    /* Establish ownership before putting bytes on the wire.  A response can
     * arrive immediately after the send, so creating the guard afterwards is
     * a real race rather than just an ordering preference. */
    if (!begin_active_turn_guard(request_id,
                                 NULL,
                                 NUWAX_CONVERSATION_WAKE_TEXT_TIMEOUT_MS,
                                 "wake_greeting")) {
        ESP_LOGE(TAG,
                 "wake greeting turn guard could not be established; request not sent");
        wake_greeting_metrics_cancel("wake_greeting_guard_failed");
        return ESP_ERR_INVALID_STATE;
    }
    if (!begin_conversation_visual_round(
            NUWAX_VISUAL_ROUND_WAKE_GREETING,
            request_id,
            "wake_greeting")) {
        clear_active_turn_guard("wake_greeting_visual_round_failed");
        wake_greeting_metrics_cancel("wake_greeting_visual_round_failed");
        return ESP_ERR_INVALID_STATE;
    }
    const uint32_t expected_epoch = active_ws_epoch_snapshot();
    if (expected_epoch == 0U ||
        nuwax_ws_connection_epoch(ws) != expected_epoch) {
        clear_active_turn_guard("wake_greeting_epoch_lost");
        wake_greeting_metrics_cancel("wake_greeting_epoch_lost");
        return ESP_ERR_INVALID_STATE;
    }
    /* Keep the current face until the owned greeting actually starts playing.
     * Playback metadata alone does not mean audio is available. The existing
     * generation-checked first-PCM handler publishes LISTENING; playback
     * completion remains the only successful-greeting capture handoff. */
    ESP_LOGI(TAG,
             "wake feedback deferred revision=wake-pcm-v3 request=%s wake_to_request_ms=%ld capture_started=0 trigger=first_pcm",
             request_id,
             (long)metrics_delta_ms(s_wake_greeting_metrics.wake_detected_ms,
                                   monotonic_ms()));
    esp_err_t err = nuwax_session_send_text_request_with_timeout_if_epoch(
        ws,
        request_id,
        NUWAX_WAKE_WORD_GREETING_TEXT,
        NUWAX_INTERACTIVE_CONTROL_SEND_TIMEOUT_MS,
        expected_epoch);
    wake_greeting_metrics_mark_sent(request_id, err);
    if (err != ESP_OK) {
        /* No response may be admitted to a request whose send failed.  The
         * caller will return to listening and can retry on the next wake. */
        clear_active_turn_guard("wake_greeting_send_failed");
    }
    return err;
}

static esp_err_t wait_for_mic_start_action(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_VOICE_MIC_TOUCH_TRIGGER
    if (!s_shell_actions) {
        return ESP_ERR_INVALID_STATE;
    }
#if CONFIG_NUWAX_TOUCH_WAKE_ACTION_ENABLE || \
    CONFIG_NUWAX_TOUCH_INTERRUPT_ACTION_ENABLE
    ESP_LOGI(TAG,
             "Waiting for wake word or enabled touch conversation control");
#else
    ESP_LOGI(TAG,
             "Waiting for local wake word; touch wake and touch interruption are disabled");
#endif
    while (true) {
        app_task_watchdog_checkpoint();
        service_power_key_events(ws);
        /* Cancellation is serviced before connection/state exits so the
         * isolated HTTP worker cannot outlive a product preemption edge. */
        (void)service_music_url_test(false);
        if (s_power_shutdown_requested) {
            return ESP_ERR_INVALID_STATE;
        }
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            ESP_LOGI(TAG,
                     "normal listen wait preempted by BLE reprovision");
            return ESP_ERR_INVALID_STATE;
        }
        if (!nuwax_ws_is_connected(ws)) {
            return ESP_ERR_INVALID_STATE;
        }
        if (exclusive_audio_mode_blocks_normal_audio()) {
            ESP_LOGI(TAG, "normal listen wait preempted by exclusive audio mode");
            return ESP_ERR_INVALID_STATE;
        }
        complete_during_playback_wake_stop();
        if (s_prelisten.capture_active) {
            return ESP_OK;
        }
        drain_session_commands(ws);
        /* OTA commands are consumed inside this blocking wake wait. Service
         * the non-reboot recovery marker here as well as in the outer owner
         * loop; otherwise the outer loop cannot run until a wake or another
         * lifecycle event breaks this wait. */
        service_ota_wake_detector_recovery();
#if CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE
        /* The control-center test switch must be serviced while the normal
         * conversation owner is waiting for a wake word as well as during an
         * exclusive meeting/monitoring run. */
        drain_shell_actions(ws);
        if (nuwax_wifi_simulated_offline()) {
            return ESP_ERR_INVALID_STATE;
        }
#endif
        /* PLAYBACK_DONE is delivered through drain_session_commands() and can
         * start post-playback capture synchronously. Recheck before entering
         * the generic owner wait; otherwise every successful handoff pays an
         * avoidable wait of up to 100 ms despite the capture already being
         * armed. */
        if (s_prelisten.capture_active) {
            return ESP_OK;
        }
        /* A committed sleep state still owns the wake-word detector, but it
         * does not need to tear down and recreate the normal audio source on
         * every poll. Keep this wait loop alive so it can consume a wake word
         * or a notification command while refusing normal MIC ownership.
         * Pending/quiescing sleep, notification takeover, reprovision, and
         * power shutdown remain hard preemption paths below. */
        const bool sleeping_idle_wait =
            conversation_state_current() == NUWAX_APP_STATE_SLEEPING &&
            !s_sleep_transaction.active &&
            !s_sleep_request_pending &&
            !s_deferred_sleep_intent.active &&
            !nuwax_notification_blocks_conversation(
                &s_notification_transaction);
        if (sleep_lifecycle_blocks_new_capture() &&
            !sleeping_idle_wait) {
            return ESP_ERR_INVALID_STATE;
        }
        if (nuwax_sleep_transaction_requires_local_sleep_reconcile(
                &s_sleep_transaction,
                conversation_state_current() == NUWAX_APP_STATE_SLEEPING)) {
            request_sleeping_conversation_state(
                "idle_wait_sleep_state_reconcile");
            continue;
        }
        service_wake_interrupt_cancel(ws);
        maybe_enter_idle_sleep();
        const bool music_url_test_active = service_music_url_test(true);
        if (!music_url_test_active) {
            ensure_sleep_wake_word_detector();
        }
        int64_t now_ms = now_ms_i64();
        esp_err_t activity_err =
            service_idle_wait_application_keepalive(ws);
        if (activity_err != ESP_OK) {
            return activity_err;
        }
        if (s_prelisten.pending) {
            const uint32_t now32 = (uint32_t)now_ms;
            if (elapsed_ms(now32, s_prelisten.deadline_ms)) {
                clear_auto_followup("expired");
            } else if (!nuwax_app_shell_blocks_auto_followup() &&
                       elapsed_ms(now32, s_prelisten.ready_ms)) {
                (void)activate_pending_prelisten_capture(now32, "started");
                return ESP_OK;
            }
        }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
        if (s_wake_word_events) {
            wake_word_event_t wake_event = {0};
            if (xQueueReceive(s_wake_word_events, &wake_event, 0) == pdTRUE) {
                if (wake_event.arm.mode ==
                    NUWAX_WAKE_MODE_PLAYBACK_INTERRUPT) {
                    (void)handle_playback_wake_event(ws, &wake_event);
                    continue;
                }
                const uint32_t now32 = monotonic_ms();
                const uint32_t active_epoch = active_ws_epoch_snapshot();
                if (wake_event.arm.ws_epoch == 0U ||
                    wake_event.arm.ws_epoch != active_epoch ||
                    elapsed_ms(now32,
                               wake_event.detected_ms +
                                   NUWAX_WAKE_EVENT_MAX_AGE_MS)) {
                    ESP_LOGW(TAG,
                              "stale wake word event discarded event_epoch=%lu active_epoch=%lu age_ms=%lu",
                              (unsigned long)wake_event.arm.ws_epoch,
                             (unsigned long)active_epoch,
                             (unsigned long)(now32 - wake_event.detected_ms));
                    request_sleep_wake_word_detector("stale_wake_event");
                    continue;
                }
                const nuwax_app_state_t current_state =
                    conversation_state_current();
                if (s_deferred_sleep_intent.active) {
                    ESP_LOGI(TAG,
                             "wake word ignored while sleep-after-playback intent is pending token=%lu",
                             (unsigned long)s_deferred_sleep_intent.token);
                    continue;
                }
                if (s_sleep_transaction.active) {
                    ESP_LOGI(TAG,
                             "wake word deferred while sleep transaction is quiescing token=%lu state=%s",
                             (unsigned long)s_sleep_transaction.token,
                             nuwax_sleep_transaction_state_name(
                                 s_sleep_transaction.state));
                    continue;
                }
                if (s_sleep_transaction.state ==
                    NUWAX_SLEEP_TRANSACTION_SLEEPING) {
                    nuwax_sleep_transaction_reset_for_wake(
                        &s_sleep_transaction);
                }
                ESP_LOGI(TAG,
                         "conversation wake by local wake word word=%s state=%d",
                         wake_event.wake_word[0] ? wake_event.wake_word : "-",
                         (int)current_state);
                begin_awake_session("wake_word");
                wake_greeting_metrics_begin(wake_event.wake_word,
                                            wake_event.detected_ms);
                stop_sleep_wake_word_detector("wake_word_greeting");
                clear_auto_followup("wake_word_greeting");
                clear_last_listen_resume();
                /* First PCM owns the greeting visual; owned playback completion
                 * controls microphone capture. */
                set_conversation_status_guarded(
                    "VOICE", "WAKE_REPLY", NUWAX_WAKE_WORD_GREETING_TEXT, false);
                esp_err_t greet_err = send_wake_word_greeting(ws, wake_event.wake_word);
                if (greet_err != ESP_OK) {
                    ESP_LOGW(TAG, "wake greeting send failed: %s; fallback to listen", esp_err_to_name(greet_err));
                    reset_awake_wait_budget_paused("wake_greeting_failed");
                    start_prelisten_window("wake_word",
                                           conversation_listen_window_ms(),
                                           (uint32_t)CONFIG_NUWAX_WAKE_WORD_LISTEN_GRACE_MS);
                } else {
                    const esp_err_t aec_err =
                        conversation_live_aec_pool_init();
                    if (aec_err != ESP_OK) {
                        ESP_LOGW(TAG,
                                 "wake greeting AEC prewarm deferred: %s",
                                 esp_err_to_name(aec_err));
                        restart_if_post_reprovision_aec_failed(
                            "wake_greeting_prewarm");
                    }
                }
                continue;
            }
        }
#endif
        const esp_err_t keepalive_err =
            service_idle_wait_application_keepalive(ws);
        if (keepalive_err != ESP_OK) {
            return keepalive_err;
        }
        nuwax_app_shell_result_t action = {0};
        if (!take_deferred_shell_listen_action(&action) &&
            xQueueReceive(s_shell_actions, &action, 0) != pdTRUE) {
            conversation_owner_wait_ms(100U);
            continue;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_START_LISTEN) {
            const nuwax_app_state_t current_state =
                conversation_state_current();
            if (s_deferred_sleep_intent.active) {
                ESP_LOGI(TAG,
                         "touch listen ignored while sleep-after-playback intent is pending token=%lu",
                         (unsigned long)s_deferred_sleep_intent.token);
                continue;
            }
            if (s_sleep_transaction.active) {
                ESP_LOGI(TAG,
                         "touch wake deferred while sleep transaction is quiescing token=%lu state=%s",
                         (unsigned long)s_sleep_transaction.token,
                         nuwax_sleep_transaction_state_name(
                             s_sleep_transaction.state));
                continue;
            }
            if (s_sleep_transaction.state ==
                NUWAX_SLEEP_TRANSACTION_SLEEPING) {
                nuwax_sleep_transaction_reset_for_wake(
                    &s_sleep_transaction);
            }
            begin_awake_session(current_state == NUWAX_APP_STATE_SLEEPING
                                    ? "touch_wake"
                                    : "touch_listen");
            if (s_prelisten.pending) {
                const uint32_t now32 = (uint32_t)now_ms;
                if (elapsed_ms(now32, s_prelisten.deadline_ms)) {
                    clear_auto_followup("expired");
                } else {
                    (void)activate_pending_prelisten_capture(now32, "touch_start");
                    return ESP_OK;
                }
            }
            const char *mode = (current_state == NUWAX_APP_STATE_SLEEPING) ? "touch_wake" : "touch_listen";
            if (current_state == NUWAX_APP_STATE_SLEEPING) {
                ESP_LOGI(TAG, "conversation wake by touch_hold");
            }
            reset_awake_wait_budget_paused("touch_listen_ready");
            start_prelisten_capture_now(mode, conversation_listen_window_ms(), "touch_start");
            return ESP_OK;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_STOP_LISTEN) {
            continue;
        }
        handle_shell_action(ws, &action);
    }
#else
    vTaskDelay(pdMS_TO_TICKS(CONFIG_NUWAX_VOICE_FRAME_DURATION_MS * CONFIG_NUWAX_VOICE_MIC_FRAMES_PER_BURST));
    return nuwax_ws_is_connected(ws) ? ESP_OK : ESP_ERR_INVALID_STATE;
#endif
}

static bool poll_mic_stop_action(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_VOICE_MIC_TOUCH_TRIGGER
    service_power_key_events(ws);
    if (!s_shell_actions) {
        return sleep_lifecycle_blocks_new_capture() ||
               s_power_shutdown_requested;
    }
    bool should_stop = sleep_lifecycle_blocks_new_capture() ||
                       s_power_shutdown_requested;
    nuwax_app_shell_result_t action = {0};
    bool have_action = take_deferred_shell_listen_action(&action);
    const int64_t drain_started_us = esp_timer_get_time();
    uint32_t handled = 0U;
    while (handled < NUWAX_SHELL_ACTION_DRAIN_MAX &&
           (have_action ||
           xQueueReceive(s_shell_actions, &action, 0) == pdTRUE)) {
        have_action = false;
        app_task_watchdog_checkpoint();
        if (action.action == NUWAX_APP_SHELL_ACTION_STOP_LISTEN) {
            if (s_prelisten.mic_release_stops_capture) {
                should_stop = true;
            } else {
                ESP_LOGI(TAG, "mic release ignored in continuous listen mode");
            }
            handled++;
            continue;
        }
        if (action.action == NUWAX_APP_SHELL_ACTION_START_LISTEN) {
            handled++;
            continue;
        }
        handle_shell_action(ws, &action);
        handled++;
        app_task_watchdog_checkpoint();
        if (esp_timer_get_time() - drain_started_us >=
            NUWAX_SHELL_ACTION_DRAIN_BUDGET_US) {
            break;
        }
    }
    return should_stop;
#else
    service_power_key_events(ws);
    if (s_shell_actions) {
        nuwax_app_shell_result_t action = {0};
        const int64_t drain_started_us = esp_timer_get_time();
        uint32_t handled = 0U;
        while (handled < NUWAX_SHELL_ACTION_DRAIN_MAX &&
               xQueueReceive(s_shell_actions, &action, 0) == pdTRUE) {
            app_task_watchdog_checkpoint();
            if (action.action == NUWAX_APP_SHELL_ACTION_SHAKE_AGENT ||
                action.action == NUWAX_APP_SHELL_ACTION_HEAD_TOUCH_AGENT) {
                handle_shell_action(ws, &action);
            }
            handled++;
            app_task_watchdog_checkpoint();
            if (esp_timer_get_time() - drain_started_us >=
                NUWAX_SHELL_ACTION_DRAIN_BUDGET_US) {
                break;
            }
        }
    }
    return sleep_lifecycle_blocks_new_capture() ||
           s_power_shutdown_requested;
#endif
}

typedef struct {
    nuwax_ws_client_t *ws;
    char mode[NUWAX_PRELISTEN_MODE_MAX_LEN];
    char audio_session_id[48];
} seamless_listen_stop_t;

_Static_assert(sizeof(seamless_listen_stop_t) <=
                   NUWAX_AUDIO_UPLINK_AFTER_END_CONTEXT_MAX_BYTES,
               "seamless listen-stop context exceeds uplink-owned storage");

static esp_err_t send_seamless_listen_stop_after_end(void *user_ctx,
                                                     uint32_t ws_epoch) {
    seamless_listen_stop_t *stop =
        (seamless_listen_stop_t *)user_ctx;
    if (!stop || !stop->ws || stop->mode[0] == '\0' ||
        stop->audio_session_id[0] == '\0' || ws_epoch == 0U) {
        return ESP_ERR_INVALID_ARG;
    }
    const int64_t deadline_us =
        esp_timer_get_time() + NUWAX_ASYNC_WS_CONTROL_SEND_TIMEOUT_US;
    const esp_err_t result =
        nuwax_session_send_listen_with_audio_session_until_if_epoch(
            stop->ws,
            "stop",
            stop->mode,
            stop->audio_session_id,
            NULL,
            deadline_us,
            ws_epoch);
    if (result == ESP_OK) {
        ESP_LOGI(TAG,
                 "seamless handoff listen stop stage completed after binary END mode=%s session=%s epoch=%lu",
                 stop->mode,
                 stop->audio_session_id,
                 (unsigned long)ws_epoch);
    }
    return result;
}

static esp_err_t prepare_mic_cloud_upload(
    nuwax_ws_client_t *ws,
    nuwax_audio_uplink_t *send_ctx,
    const char *mode,
    const char *audio_session_id,
    const char *request_id) {
    esp_err_t result = ESP_OK;
    if (nuwax_audio_uplink_sender_busy()) {
        ESP_LOGW(TAG,
                 "listen start deferred while prior audio sender releases singleton mode=%s session=%s",
                 mode ? mode : "i2s-mic-stream",
                 audio_session_id ? audio_session_id : "-");
        return ESP_ERR_NOT_FINISHED;
    }
    if (nuwax_audio_terminal_recovery_pending()) {
        (void)service_audio_terminal_recovery(ws);
        if (nuwax_audio_terminal_recovery_pending()) {
            ESP_LOGW(TAG,
                     "listen start deferred until prior terminal transaction closes mode=%s session=%s",
                     mode ? mode : "i2s-mic-stream",
                     audio_session_id ? audio_session_id : "-");
            return ESP_ERR_NOT_FINISHED;
        }
    }
    /* Allocate every fallible local uplink resource before committing a cloud
     * listen session. Otherwise a queue/task allocation failure leaves a
     * server-side session for which this device can never send binary END. */
    result = nuwax_audio_uplink_start_with_profile(
        send_ctx, ws, NUWAX_AUDIO_UPLINK_PROFILE_REALTIME);
    if (result != ESP_OK) {
        ESP_LOGE(TAG, "audio send queue start failed: %s", esp_err_to_name(result));
        return result;
    }
    result = nuwax_audio_uplink_set_low_latency(send_ctx, true);
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "enable normal-conversation low-latency uplink failed: %s",
                 esp_err_to_name(result));
        const esp_err_t discard_err =
            nuwax_audio_uplink_discard_uncommitted(send_ctx);
        if (discard_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "prepared audio sender cleanup failed before listen start: %s",
                     esp_err_to_name(discard_err));
        }
        return result;
    }
    const esp_err_t recovery_bind_err =
        nuwax_audio_uplink_bind_terminal_recovery(
            send_ctx,
            mode ? mode : "i2s-mic-stream",
            audio_session_id,
            request_id,
            NUWAX_AUDIO_TERMINAL_RECOVERY_DEFAULT_ATTEMPT_TIMEOUT_MS);
    if (recovery_bind_err != ESP_OK) {
        ESP_LOGE(TAG,
                 "terminal recovery binding failed before listen start mode=%s session=%s err=%s",
                 mode ? mode : "i2s-mic-stream",
                 audio_session_id ? audio_session_id : "-",
                 esp_err_to_name(recovery_bind_err));
        const esp_err_t discard_err =
            nuwax_audio_uplink_discard_uncommitted(send_ctx);
        if (discard_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "prepared audio sender cleanup failed after recovery bind error: %s",
                     esp_err_to_name(discard_err));
        }
        return recovery_bind_err;
    }
    return ESP_OK;
}

static esp_err_t start_mic_cloud_upload(nuwax_ws_client_t *ws,
                                        nuwax_audio_uplink_t *send_ctx,
                                        const char *mode,
                                        const char *audio_session_id,
                                        const char *request_id,
                                        size_t max_record_samples,
                                        uint32_t max_record_ms,
                                        bool *listen_started,
                                        int64_t *upload_started_us,
                                        bool listen_start_committed,
                                        bool uplink_prepared) {
    esp_err_t result = ESP_OK;
    if (listen_started) {
        *listen_started = listen_start_committed;
    }
    const bool playback_interrupt_mode =
        mode && (strcmp(mode, "during_playback") == 0 ||
                 strcmp(mode, "barge_in") == 0 ||
                 strcmp(mode, NUWAX_ACCEPTANCE_CAPTURE_MODE) == 0);
    if (!listen_start_committed && !playback_interrupt_mode &&
        s_playback_terminal_guard.active) {
        ESP_LOGW(TAG,
                 "normal listen start blocked by playback terminal barrier mode=%s epoch=%lu generation=%lu physical_done=%d stream_end=%d logical_end=%d faulted=%d",
                 mode ? mode : "i2s-mic-stream",
                 (unsigned long)s_playback_terminal_guard.connection_epoch,
                 (unsigned long)s_playback_terminal_guard.speaker_generation,
                 s_playback_terminal_guard.physical_done ? 1 : 0,
                 s_playback_terminal_guard.stream_end_seen ? 1 : 0,
                 s_playback_terminal_guard.logical_end_seen ? 1 : 0,
                 s_playback_terminal_guard.faulted ? 1 : 0);
        (void)begin_playback_terminal_local_recovery(
            "normal_listen_terminal_conflict");
        return ESP_ERR_INVALID_STATE;
    }

    if (!uplink_prepared) {
        result = prepare_mic_cloud_upload(ws,
                                          send_ctx,
                                          mode,
                                          audio_session_id,
                                          request_id);
        if (result != ESP_OK) {
            return result;
        }
    } else if (!send_ctx || !send_ctx->task || send_ctx->ws != ws ||
               send_ctx->ws_connection_epoch == 0U ||
               nuwax_ws_connection_epoch(ws) !=
                   send_ctx->ws_connection_epoch ||
               !send_ctx->terminal_recovery_bound) {
        ESP_LOGE(TAG,
                 "prepared audio uplink lost ownership before listen activation mode=%s session=%s",
                 mode ? mode : "i2s-mic-stream",
                 audio_session_id ? audio_session_id : "-");
        return ESP_ERR_INVALID_STATE;
    }

    if (!listen_start_committed) {
        const uint32_t expected_epoch = active_ws_epoch_snapshot();
        if (expected_epoch == 0U ||
            nuwax_ws_connection_epoch(ws) != expected_epoch) {
            result = ESP_ERR_INVALID_STATE;
        } else {
            const int64_t deadline_us =
                esp_timer_get_time() +
                (int64_t)NUWAX_INTERACTIVE_CONTROL_SEND_TIMEOUT_MS * 1000LL;
            result = nuwax_session_send_listen_with_audio_session_until_if_epoch(
                ws,
                "start",
                mode ? mode : "i2s-mic-stream",
                audio_session_id,
                request_id,
                deadline_us,
                expected_epoch);
        }
        if (result != ESP_OK) {
            ESP_LOGE(TAG,
                     "listen start failed after local uplink prepare: %s; aborting current audio session while retaining WebSocket",
                     esp_err_to_name(result));
            const esp_err_t discard_err =
                nuwax_audio_uplink_discard_uncommitted(send_ctx);
            if (discard_err != ESP_OK) {
                ESP_LOGE(TAG,
                         "prepared audio sender cleanup failed after listen start error: %s",
                         esp_err_to_name(discard_err));
            }
            return result;
        }
        if (listen_started) {
            *listen_started = true;
        }
    }
    if (upload_started_us) {
        *upload_started_us = esp_timer_get_time();
    }
    metrics_mark_upload_start();
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (nuwax_speaker_playback_has_pending()) {
        ESP_LOGI(TAG, "mic upload started during speaker playback; keeping speaking UI state");
    } else
#endif
    {
        set_state(NUWAX_APP_STATE_LISTENING);
    }

    ESP_LOGI(TAG,
             "I2S microphone stream start mode=%s codec=%s max_ms=%d frame_ms=%d stream_batch=%d low_latency_first=%d low_latency_steady=%d queue_depth=%d max_samples=%u",
             mode ? mode : "i2s-mic-stream",
             NUWAX_AUDIO_UPLINK_CODEC_NAME,
             (int)max_record_ms,
             CONFIG_NUWAX_VOICE_FRAME_DURATION_MS,
             (int)nuwax_audio_uplink_batch_frames(),
             NUWAX_AUDIO_UPLINK_LOW_LATENCY_FIRST_BATCH_FRAMES,
             NUWAX_AUDIO_UPLINK_LOW_LATENCY_STEADY_BATCH_FRAMES,
             (int)nuwax_audio_uplink_context_queue_depth(send_ctx),
             (unsigned)max_record_samples);
    return ESP_OK;
}

static esp_err_t enqueue_mic_uplink_frame(nuwax_audio_uplink_t *send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                          nuwax_opus_encoder_t *opus_encoder,
#endif
                                          const int16_t *samples,
                                          size_t sample_count,
                                          uint32_t seq,
                                          uint8_t flags,
                                          bool final_frame,
                                          uint32_t *queued_frames,
                                          uint32_t *dropped_frames) {
    esp_err_t result = nuwax_audio_uplink_enqueue_frame(send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                                       opus_encoder,
#else
                                                       NULL,
#endif
                                                       samples,
                                                       sample_count,
                                                       seq,
                                                       flags,
                                                       final_frame);
    nuwax_audio_uplink_stats_t uplink_stats = {0};
    nuwax_audio_uplink_get_stats(send_ctx, &uplink_stats);
    metrics_record_elapsed(NUWAX_CONVERSATION_LATENCY_DSP_ENCODE,
                           uplink_stats.last_encode_us);
    if (uplink_stats.last_enqueue_us > 0U) {
        metrics_record_elapsed(NUWAX_CONVERSATION_LATENCY_DSP_ENQUEUE,
                               uplink_stats.last_enqueue_us);
    }
    if (result != ESP_OK) {
        return result;
    }
    if (queued_frames) {
        *queued_frames = uplink_stats.queued_frames;
    }
    if (dropped_frames) {
        *dropped_frames = uplink_stats.dropped_frames;
    }
    return ESP_OK;
}

static esp_err_t init_auto_followup_preroll(void) {
    if (s_auto_followup_preroll) {
        return ESP_OK;
    }

    const size_t bytes = NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES * sizeof(*s_auto_followup_preroll);
    s_auto_followup_preroll = heap_caps_calloc(NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES,
                                               sizeof(*s_auto_followup_preroll),
                                               MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!s_auto_followup_preroll) {
        ESP_LOGE(TAG,
                 "auto-followup preroll PSRAM allocation failed bytes=%u psram_free=%u psram_largest=%u internal_free=%u internal_largest=%u",
                 (unsigned)bytes,
                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
        return ESP_ERR_NO_MEM;
    }

    ESP_LOGI(TAG,
             "auto-followup preroll allocated in PSRAM frames=%u frame_samples=%u bytes=%u internal_free=%u internal_largest=%u",
             (unsigned)NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES,
             (unsigned)NUWAX_CAPTURE_FRAME_SAMPLES,
             (unsigned)bytes,
             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
    return ESP_OK;
}

static nuwax_preroll_cleaner_state_t capture_preroll_cleaner_state(
    const nuwax_audio_cleaner_t *cleaner) {
    nuwax_preroll_cleaner_state_t state = {0};
    if (!cleaner) {
        return state;
    }
    state.prev_input = cleaner->prev_input;
    state.prev_highpass = cleaner->prev_highpass;
    state.notch_x1 = cleaner->notch_x1;
    state.notch_x2 = cleaner->notch_x2;
    state.notch_y1 = cleaner->notch_y1;
    state.notch_y2 = cleaner->notch_y2;
    state.noise_floor_avg_abs = cleaner->noise_floor_avg_abs;
    state.speech_hangover_frames = cleaner->speech_hangover_frames;
    state.playback_gain_q15 = cleaner->playback_gain_q15;
    state.playback_gain_hold_frames = cleaner->playback_gain_hold_frames;
    state.playback_echo_atten_q15 = cleaner->playback_echo_atten_q15;
    state.playback_echo_veto_streak_frames = cleaner->playback_echo_veto_streak_frames;
    state.playback_unprotected_gain_q15 = cleaner->playback_unprotected_gain_q15;
    return state;
}

static esp_err_t store_auto_followup_preroll_frame(
    const int16_t *samples,
    const int16_t *preclean_samples,
    const int16_t *human_rescue_source,
    const int16_t *ref_samples,
    size_t sample_count,
    bool playback_active,
    uint32_t rescue_mix_q15,
    nuwax_live_aec_rescue_source_kind_t rescue_source_kind,
    const nuwax_live_aec_rescue_provenance_t *rescue_provenance,
    const nuwax_preroll_cleaner_state_t *cleaner_state_before,
    const nuwax_preroll_audio_trust_t *audio_trust,
    bool is_speech,
    uint32_t capture_sequence,
    uint32_t *preroll_write,
    uint32_t *preroll_count) {
    if (!s_auto_followup_preroll || !samples || !preclean_samples || !human_rescue_source ||
        !ref_samples || !rescue_provenance || !cleaner_state_before ||
        !audio_trust ||
        !preroll_write || !preroll_count) {
        return ESP_ERR_INVALID_STATE;
    }
    if (sample_count == 0 || sample_count > NUWAX_CAPTURE_FRAME_SAMPLES) {
        return ESP_ERR_INVALID_SIZE;
    }
    (void)rescue_mix_q15;
    const uint64_t preroll_started_us = (uint64_t)esp_timer_get_time();

    const uint32_t slot = *preroll_write % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    nuwax_auto_followup_preroll_frame_t *frame = &s_auto_followup_preroll[slot];
    memcpy(frame->samples, samples, sample_count * sizeof(int16_t));
    memcpy(frame->preclean_samples, preclean_samples, sample_count * sizeof(int16_t));
    memcpy(frame->human_rescue_source, human_rescue_source, sample_count * sizeof(int16_t));
    memcpy(frame->ref_samples, ref_samples, sample_count * sizeof(int16_t));
    frame->sample_count = sample_count;
    frame->playback_active = playback_active;
    frame->rescue_mix_q15 = 0U;
    for (size_t segment = 0U;
         segment < rescue_provenance->segment_count;
         segment++) {
        if (rescue_provenance->segments[segment].mix_q15 >
            frame->rescue_mix_q15) {
            frame->rescue_mix_q15 =
                rescue_provenance->segments[segment].mix_q15;
        }
    }
    frame->human_rescue_source_kind = rescue_source_kind;
    frame->human_rescue_provenance = *rescue_provenance;
    frame->cleaner_state_before = *cleaner_state_before;
    frame->audio_trust = *audio_trust;
    frame->speech = is_speech;
    frame->sequence = capture_sequence;
    frame->human_repaired = false;
    frame->barge_silenced = false;
    frame->forced_silence = false;
    *preroll_write = (*preroll_write + 1) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    if (*preroll_count < NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES) {
        (*preroll_count)++;
    }
    metrics_record_duration(NUWAX_CONVERSATION_LATENCY_DSP_PREROLL,
                            preroll_started_us,
                            (uint64_t)esp_timer_get_time());
    return ESP_OK;
}

static int16_t clamp_preroll_i16(int32_t value) {
    if (value > INT16_MAX) {
        return INT16_MAX;
    }
    if (value < INT16_MIN) {
        return INT16_MIN;
    }
    return (int16_t)value;
}

static bool rescue_kind_trusted(
    nuwax_live_aec_rescue_source_kind_t kind) {
    return kind == NUWAX_LIVE_AEC_RESCUE_SOURCE_SCALAR ||
           kind == NUWAX_LIVE_AEC_RESCUE_SOURCE_FIR;
}

static bool rescue_provenance_all_trusted(
    const nuwax_live_aec_rescue_provenance_t *provenance,
    size_t sample_count) {
    if (!provenance || provenance->sample_count != sample_count ||
        provenance->segment_count == 0U) {
        return false;
    }
    for (size_t i = 0U; i < provenance->segment_count; i++) {
        if (!rescue_kind_trusted(provenance->segments[i].kind)) {
            return false;
        }
    }
    return true;
}

/* Raise the stored rescue mix to the confirmed target, then replay the stateful cleaner. */
static esp_err_t repair_auto_followup_human_preroll(
    uint32_t preroll_write,
    uint32_t preroll_count,
    uint32_t start_sequence,
    uint32_t end_sequence,
    uint32_t lead_frames,
    uint32_t target_mix_q15,
    bool cleaner_runtime_enabled,
    nuwax_audio_cleaner_t *runtime_cleaner,
    uint32_t *actual_start_sequence,
    uint32_t *repaired_frames,
    uint32_t *untrusted_source_frames) {
    if (!s_auto_followup_preroll || preroll_count == 0 || !actual_start_sequence ||
        !repaired_frames || !untrusted_source_frames) {
        return ESP_ERR_INVALID_STATE;
    }
    const uint64_t preroll_started_us = (uint64_t)esp_timer_get_time();
    *actual_start_sequence = start_sequence;
    *repaired_frames = 0;
    *untrusted_source_frames = 0;
    if (target_mix_q15 > 32768U) {
        target_mix_q15 = 32768U;
    }

    const uint32_t oldest =
        (preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES - preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    nuwax_auto_followup_preroll_frame_t *start_frame = NULL;
    uint32_t start_offset = 0;
    for (uint32_t i = 0; i < preroll_count; i++) {
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[(oldest + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (frame->sequence == start_sequence) {
            start_frame = frame;
            start_offset = i;
            break;
        }
    }
    if (!start_frame) {
        return ESP_ERR_NOT_FOUND;
    }
    if (lead_frames > start_offset) {
        lead_frames = start_offset;
    }
    start_offset -= lead_frames;
    start_frame =
        &s_auto_followup_preroll[(oldest + start_offset) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
    *actual_start_sequence = start_frame->sequence;

    nuwax_audio_cleaner_t repair_cleaner = {0};
    nuwax_audio_cleaner_init(&repair_cleaner);
    repair_cleaner.enabled = cleaner_runtime_enabled;
    repair_cleaner.prev_input = start_frame->cleaner_state_before.prev_input;
    repair_cleaner.prev_highpass = start_frame->cleaner_state_before.prev_highpass;
    repair_cleaner.notch_x1 = start_frame->cleaner_state_before.notch_x1;
    repair_cleaner.notch_x2 = start_frame->cleaner_state_before.notch_x2;
    repair_cleaner.notch_y1 = start_frame->cleaner_state_before.notch_y1;
    repair_cleaner.notch_y2 = start_frame->cleaner_state_before.notch_y2;
    repair_cleaner.noise_floor_avg_abs = start_frame->cleaner_state_before.noise_floor_avg_abs;
    repair_cleaner.speech_hangover_frames = start_frame->cleaner_state_before.speech_hangover_frames;
    repair_cleaner.playback_gain_q15 = start_frame->cleaner_state_before.playback_gain_q15;
    repair_cleaner.playback_gain_hold_frames = start_frame->cleaner_state_before.playback_gain_hold_frames;
    repair_cleaner.playback_echo_atten_q15 = start_frame->cleaner_state_before.playback_echo_atten_q15;
    repair_cleaner.playback_echo_veto_streak_frames =
        start_frame->cleaner_state_before.playback_echo_veto_streak_frames;
    repair_cleaner.playback_unprotected_gain_q15 =
        start_frame->cleaner_state_before.playback_unprotected_gain_q15;

    esp_err_t result = ESP_ERR_NOT_FOUND;
    uint32_t expected_sequence = start_frame->sequence;
    for (uint32_t i = start_offset; i < preroll_count; i++) {
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[(oldest + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (frame->sequence != expected_sequence || frame->sample_count == 0 ||
            frame->sample_count > NUWAX_CAPTURE_FRAME_SAMPLES) {
            result = ESP_ERR_INVALID_STATE;
            break;
        }

        if (frame->forced_silence) {
            memset(frame->samples,
                   0,
                   frame->sample_count * sizeof(frame->samples[0]));
            frame->speech = false;
            frame->human_repaired = false;
            frame->barge_silenced = true;
            if (frame->sequence == end_sequence) {
                result = ESP_OK;
                break;
            }
            expected_sequence++;
            continue;
        }

        const bool trusted_rescue_source = rescue_provenance_all_trusted(
            &frame->human_rescue_provenance, frame->sample_count);
        if (!trusted_rescue_source) {
            (*untrusted_source_frames)++;
        }
        bool repaired_any_sample = false;
        for (size_t sample = 0; sample < frame->sample_count; sample++) {
            nuwax_live_aec_rescue_source_kind_t sample_kind =
                NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW;
            uint32_t current_mix_q15 = 0U;
            const bool sample_trusted =
                nuwax_live_aec_rescue_provenance_sample_at(
                    &frame->human_rescue_provenance,
                    sample,
                    &sample_kind,
                    &current_mix_q15) &&
                rescue_kind_trusted(sample_kind);
            if (current_mix_q15 > 32768U) {
                current_mix_q15 = 32768U;
            }
            uint32_t trusted_overlay_mix_q15 = 0U;
            if (sample_trusted && current_mix_q15 < target_mix_q15 &&
                current_mix_q15 < 32768U) {
                trusted_overlay_mix_q15 =
                    (uint32_t)(((uint64_t)(target_mix_q15 -
                                          current_mix_q15) *
                                    32768ULL +
                                ((32768U - current_mix_q15) / 2U)) /
                               (32768U - current_mix_q15));
            }
            const uint32_t overlay_mix_q15 =
                sample_trusted ? trusted_overlay_mix_q15 : 0U;
            const int32_t original_mix_q15 =
                (int32_t)(32768U - overlay_mix_q15);
            const int16_t rescue = frame->human_rescue_source[sample];
            const int32_t repaired =
                (int32_t)((((int64_t)frame->preclean_samples[sample] * original_mix_q15) +
                           ((int64_t)rescue * (int32_t)overlay_mix_q15)) >> 15);
            s_audio_repair_samples[sample] = clamp_preroll_i16(repaired);
            repaired_any_sample = repaired_any_sample || overlay_mix_q15 > 0U;
        }

        nuwax_audio_cleaner_result_t repair_result = {0};
        nuwax_audio_cleaner_process_with_ref(&repair_cleaner,
                                             s_audio_repair_samples,
                                             frame->sample_count,
                                             frame->playback_active,
                                             true,
                                             true,
                                             true,
                                             false,
                                             true,
                                             frame->ref_samples,
                                             frame->sample_count,
                                             &repair_result);
        memcpy(frame->samples,
               s_audio_repair_samples,
               frame->sample_count * sizeof(frame->samples[0]));
        frame->speech = true;
        frame->human_repaired = repaired_any_sample;
        (*repaired_frames)++;
        if (frame->sequence == end_sequence) {
            result = ESP_OK;
            break;
        }
        expected_sequence++;
    }
    if (result == ESP_OK && runtime_cleaner) {
        runtime_cleaner->prev_input = repair_cleaner.prev_input;
        runtime_cleaner->prev_highpass = repair_cleaner.prev_highpass;
        runtime_cleaner->notch_x1 = repair_cleaner.notch_x1;
        runtime_cleaner->notch_x2 = repair_cleaner.notch_x2;
        runtime_cleaner->notch_y1 = repair_cleaner.notch_y1;
        runtime_cleaner->notch_y2 = repair_cleaner.notch_y2;
        runtime_cleaner->noise_floor_avg_abs = repair_cleaner.noise_floor_avg_abs;
        runtime_cleaner->speech_hangover_frames = repair_cleaner.speech_hangover_frames;
        runtime_cleaner->playback_gain_q15 = repair_cleaner.playback_gain_q15;
        runtime_cleaner->playback_gain_hold_frames = repair_cleaner.playback_gain_hold_frames;
        runtime_cleaner->playback_echo_atten_q15 = repair_cleaner.playback_echo_atten_q15;
        runtime_cleaner->playback_echo_veto_streak_frames =
            repair_cleaner.playback_echo_veto_streak_frames;
        runtime_cleaner->playback_unprotected_gain_q15 =
            repair_cleaner.playback_unprotected_gain_q15;
    }
    nuwax_audio_cleaner_deinit(&repair_cleaner);
    metrics_record_duration(NUWAX_CONVERSATION_LATENCY_DSP_PREROLL,
                            preroll_started_us,
                            (uint64_t)esp_timer_get_time());
    return result;
}

static bool level_ratio_at_least_q15(nuwax_mic_level_t numerator,
                                     nuwax_mic_level_t denominator,
                                     uint32_t ratio_q15) {
    if (ratio_q15 == 0) {
        return true;
    }
    bool avg_ok = false;
    bool peak_ok = false;
    if (denominator.avg_abs > 0) {
        avg_ok = (uint64_t)numerator.avg_abs * 32768ULL >=
                 (uint64_t)denominator.avg_abs * (uint64_t)ratio_q15;
    }
    if (denominator.peak > 0) {
        peak_ok = (uint64_t)numerator.peak * 32768ULL >=
                  (uint64_t)denominator.peak * (uint64_t)ratio_q15;
    }
    return avg_ok || peak_ok;
}

static uint32_t max3_u32(uint32_t a, uint32_t b, uint32_t c) {
    uint32_t m = a > b ? a : b;
    return m > c ? m : c;
}

typedef struct {
    bool valid;
    bool voice_like;
    uint32_t diff_avg_abs;
    uint32_t diff_peak;
    uint32_t diff_energy_ratio_q15;
    uint32_t level_balance_q15;
} nuwax_dual_mic_features_t;

static uint32_t abs_i32_to_u32(int32_t value) {
    return value < 0 ? (uint32_t)(-value) : (uint32_t)value;
}

static uint32_t clamp_q15_from_ratio_u64(uint64_t numerator, uint64_t denominator) {
    if (denominator == 0) {
        return 0;
    }
    uint64_t q15 = (numerator * 32768ULL) / denominator;
    if (q15 > 32768ULL) {
        q15 = 32768ULL;
    }
    return (uint32_t)q15;
}

static uint32_t compute_abs_corr_q15(const int16_t *a, const int16_t *b, size_t sample_count) {
    if (!a || !b || sample_count == 0) {
        return 0;
    }
    int64_t dot = 0;
    uint64_t a_sumsq = 0;
    uint64_t b_sumsq = 0;
    for (size_t i = 0; i < sample_count; i++) {
        const int32_t av = a[i];
        const int32_t bv = b[i];
        dot += (int64_t)av * (int64_t)bv;
        a_sumsq += (uint64_t)((int64_t)av * (int64_t)av);
        b_sumsq += (uint64_t)((int64_t)bv * (int64_t)bv);
    }
    if (a_sumsq == 0 || b_sumsq == 0) {
        return 0;
    }
    const double denom = sqrt((double)a_sumsq * (double)b_sumsq);
    if (denom <= 0.0) {
        return 0;
    }
    double corr = (double)dot / denom;
    if (corr < 0.0) {
        corr = -corr;
    }
    if (corr > 1.0) {
        corr = 1.0;
    }
    return (uint32_t)(corr * 32768.0 + 0.5);
}

static esp_err_t sanitize_barge_overlap_preroll(
    uint32_t preroll_write,
    uint32_t preroll_count,
    uint32_t onset_sequence,
    uint32_t end_sequence,
    bool repair_succeeded,
    uint32_t *preserved_frames,
    uint32_t *silenced_frames,
    uint32_t *max_ref_correlation_q15) {
    if (!s_auto_followup_preroll || preroll_count == 0 || !preserved_frames ||
        !silenced_frames || !max_ref_correlation_q15) {
        return ESP_ERR_INVALID_STATE;
    }
    *preserved_frames = 0;
    *silenced_frames = 0;
    *max_ref_correlation_q15 = 0;

    const uint32_t oldest =
        (preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES - preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    bool onset_found = false;
    bool end_found = false;
    uint32_t expected_sequence = onset_sequence;
    for (uint32_t i = 0; i < preroll_count; i++) {
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[(oldest + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (!onset_found) {
            if (frame->sequence != onset_sequence) {
                continue;
            }
            onset_found = true;
        }
        if (frame->sequence != expected_sequence || frame->sample_count == 0 ||
            frame->sample_count > NUWAX_CAPTURE_FRAME_SAMPLES) {
            return ESP_ERR_INVALID_STATE;
        }

        if (frame->forced_silence) {
            memset(frame->samples,
                   0,
                   frame->sample_count * sizeof(frame->samples[0]));
            frame->speech = false;
            frame->human_repaired = false;
            frame->barge_silenced = true;
            (*silenced_frames)++;
            if (frame->sequence == end_sequence) {
                end_found = true;
                break;
            }
            expected_sequence++;
            continue;
        }

        const bool trusted_rescue_source = rescue_provenance_all_trusted(
            &frame->human_rescue_provenance, frame->sample_count);
        const bool trusted_clean_source =
            nuwax_preroll_audio_trust_allows_preserve(
                &frame->audio_trust,
                repair_succeeded,
                frame->human_repaired,
                trusted_rescue_source);
        const uint32_t ref_correlation_q15 =
            compute_abs_corr_q15(frame->samples, frame->ref_samples, frame->sample_count);
        if (ref_correlation_q15 > *max_ref_correlation_q15) {
            *max_ref_correlation_q15 = ref_correlation_q15;
        }
        if (nuwax_preroll_overlap_frame_should_silence(
                frame->playback_active,
                trusted_clean_source,
                ref_correlation_q15,
                NUWAX_BARGE_IN_OVERLAP_MAX_REF_CORR_Q15)) {
            memset(frame->samples, 0, frame->sample_count * sizeof(frame->samples[0]));
            frame->speech = false;
            frame->barge_silenced = true;
            (*silenced_frames)++;
        } else {
            frame->speech = true;
            frame->barge_silenced = false;
            (*preserved_frames)++;
        }
        if (frame->sequence == end_sequence) {
            end_found = true;
            break;
        }
        expected_sequence++;
    }
    return onset_found && end_found ? ESP_OK : ESP_ERR_NOT_FOUND;
}

static esp_err_t silence_barge_preroll_range(uint32_t preroll_write,
                                             uint32_t preroll_count,
                                             uint32_t start_sequence,
                                             uint32_t end_sequence,
                                             uint32_t *silenced_frames) {
    if (!s_auto_followup_preroll || preroll_count == 0 || !silenced_frames) {
        return ESP_ERR_INVALID_STATE;
    }
    *silenced_frames = 0;
    const uint32_t oldest =
        (preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES - preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    bool start_found = false;
    bool end_found = false;
    uint32_t start_offset = 0;
    uint32_t range_frames = 0;
    uint32_t expected_sequence = start_sequence;
    for (uint32_t i = 0; i < preroll_count; i++) {
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[(oldest + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (!start_found) {
            if (frame->sequence != start_sequence) {
                continue;
            }
            start_found = true;
            start_offset = i;
        }
        if (frame->sequence != expected_sequence || frame->sample_count == 0 ||
            frame->sample_count > NUWAX_CAPTURE_FRAME_SAMPLES) {
            return ESP_ERR_INVALID_STATE;
        }
        range_frames++;
        if (frame->sequence == end_sequence) {
            end_found = true;
            break;
        }
        expected_sequence++;
    }
    if (!start_found || !end_found) {
        return ESP_ERR_NOT_FOUND;
    }
    for (uint32_t i = 0; i < range_frames; i++) {
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[
                (oldest + start_offset + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        memset(frame->samples, 0, frame->sample_count * sizeof(frame->samples[0]));
        memset(frame->preclean_samples,
               0,
               frame->sample_count * sizeof(frame->preclean_samples[0]));
        memset(frame->human_rescue_source,
               0,
               frame->sample_count * sizeof(frame->human_rescue_source[0]));
        memset(frame->ref_samples,
               0,
               frame->sample_count * sizeof(frame->ref_samples[0]));
        memset(&frame->audio_trust, 0, sizeof(frame->audio_trust));
        frame->rescue_mix_q15 = 0U;
        frame->human_rescue_source_kind =
            NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW;
        frame->speech = false;
        frame->human_repaired = false;
        frame->barge_silenced = true;
        frame->forced_silence = true;
        (*silenced_frames)++;
    }
    return ESP_OK;
}

static esp_err_t repair_confirmed_barge_preroll_gap(
    uint32_t current_sequence,
    uint32_t onset_sequence,
    uint32_t confirmed_sequence,
    bool upload_started,
    uint32_t *preroll_write,
    uint32_t *preroll_count,
    uint32_t *repaired_frames) {
    if (repaired_frames) {
        *repaired_frames = 0U;
    }
    if (!s_auto_followup_preroll || !preroll_write || !preroll_count ||
        !repaired_frames || *preroll_count == 0U ||
        *preroll_count > NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES) {
        return ESP_ERR_INVALID_STATE;
    }

    const uint32_t oldest =
        (*preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES -
         *preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    const uint32_t tail =
        (oldest + *preroll_count - 1U) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    const uint32_t previous_sequence =
        s_auto_followup_preroll[tail].sequence;
    uint32_t gap_frames = 0U;
    if (!nuwax_preroll_confirmed_gap_repair_allowed(
            true,
            upload_started,
            confirmed_sequence,
            previous_sequence,
            current_sequence,
            &gap_frames)) {
        return ESP_ERR_INVALID_STATE;
    }

    bool onset_found = false;
    bool confirmed_found = false;
    uint32_t onset_offset = 0U;
    uint32_t expected_sequence = onset_sequence;
    for (uint32_t i = 0U; i < *preroll_count; i++) {
        const nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[
                (oldest + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (!onset_found) {
            if (frame->sequence != onset_sequence) {
                continue;
            }
            onset_found = true;
            onset_offset = i;
        }
        if (frame->sequence != expected_sequence ||
            frame->sample_count == 0U ||
            frame->sample_count > NUWAX_CAPTURE_FRAME_SAMPLES) {
            return ESP_ERR_INVALID_STATE;
        }
        if (!confirmed_found &&
            (frame->barge_silenced || frame->forced_silence)) {
            return ESP_ERR_INVALID_STATE;
        }
        if (frame->sequence == confirmed_sequence) {
            confirmed_found = true;
        }
        expected_sequence++;
    }
    if (!onset_found || !confirmed_found) {
        return ESP_ERR_NOT_FOUND;
    }

    const uint32_t evicted_frames =
        *preroll_count + gap_frames > NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES
            ? *preroll_count + gap_frames -
                  NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES
            : 0U;
    if (evicted_frames > onset_offset) {
        return ESP_ERR_NO_MEM;
    }

    uint32_t sequence = previous_sequence + 1U;
    for (uint32_t i = 0U; i < gap_frames; i++, sequence++) {
        const uint32_t slot =
            *preroll_write % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
        nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[slot];
        memset(frame, 0, sizeof(*frame));
        frame->sample_count = NUWAX_CAPTURE_FRAME_SAMPLES;
        frame->sequence = sequence;
        frame->human_rescue_source_kind =
            NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW;
        frame->speech = false;
        frame->human_repaired = false;
        frame->barge_silenced = true;
        frame->forced_silence = true;
        *preroll_write =
            (*preroll_write + 1U) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
        if (*preroll_count < NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES) {
            (*preroll_count)++;
        }
    }
    *repaired_frames = gap_frames;
    return ESP_OK;
}

typedef struct {
    uint16_t slot;
    uint32_t seq;
    uint32_t read_finished_ms;
    int64_t read_started_us;
    int64_t read_finished_us;
    size_t samples_read;
    esp_err_t err;
    nuwax_mic_raw_stats_t raw_stats;
    bool slot2_ref_candidate;
    bool have_aec_ref;
    bool hw_ref_active;
    nuwax_mic_level_t hw_ref_raw_level;
    bool software_ref_snapshot;
    bool software_ref_active;
    uint64_t software_ref_anchor_events;
    uint32_t software_ref_generation;
    nuwax_aec_reference_provenance_t reference_provenance;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    bool software_fir_ref_full;
    uint32_t software_fir_ref_delay_samples;
    uint32_t software_fir_ref_delay_revision;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    bool software_ref_epoch_valid;
    uint64_t software_ref_source_end_index;
    int64_t software_ref_phase_error;
#endif
    bool hw_ref_fallback;
    bool speaker_pending;
    bool speaker_session_active;
    uint32_t speaker_submitted_generation;
    uint32_t speaker_volume_generation;
    uint8_t speaker_volume_percent;
    bool speaker_playback_snapshot_stable;
    bool speaker_volume_snapshot_stable;
    uint32_t speaker_completed_stop_generation;
    int64_t speaker_completed_stop_timestamp_us;
    esp_err_t speaker_completed_stop_result;
    bool speaker_stop_fault_active;
    uint32_t speaker_failed_stop_generation;
    int64_t speaker_failed_stop_timestamp_us;
    esp_err_t speaker_failed_stop_result;
    int16_t *mic1;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    int16_t *mic2;
    int16_t *ref;
    int16_t *hw_ref;
    int16_t *fir_ref;
#endif
} nuwax_rt_capture_frame_t;

#define NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY 4U

typedef struct {
    nuwax_rt_capture_frame_t meta;
    int16_t mic1[NUWAX_CAPTURE_FRAME_SAMPLES];
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    int16_t mic2[NUWAX_CAPTURE_FRAME_SAMPLES];
    int16_t ref[NUWAX_CAPTURE_FRAME_SAMPLES];
    int16_t hw_ref[NUWAX_CAPTURE_FRAME_SAMPLES];
    int16_t fir_ref[NUWAX_CAPTURE_FRAME_SAMPLES];
#endif
    bool playback_active;
    bool capture_sequence_contiguous;
    uint32_t capture_gap_expected_sequence;
    uint32_t capture_gap_frames;
    bool barge_post_stop_guard_frame;
    uint32_t aec_gate_now_ms;
} nuwax_aec_alignment_context_t;

typedef struct {
    nuwax_mic_input_t *mic;
    size_t samples_per_frame;
    uint32_t software_ref_delay_samples;
    uint32_t software_fir_ref_delay_samples;
    nuwax_p3_software_ref_reader_t software_ref_reader;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    nuwax_aec_fir_delay_control_t fir_ref_delay_control;
    QueueHandle_t fir_ref_delay_requests;
    int16_t *fir_ref_delay_scratch;
    size_t fir_ref_delay_scratch_capacity;
    nuwax_aec_fir_delay_request_t fir_ref_delay_pending;
    bool fir_ref_delay_pending_valid;
    uint32_t fir_ref_delay_requests_published;
    uint32_t fir_ref_delay_requests_received;
    uint32_t fir_ref_delay_applied;
    uint32_t fir_ref_delay_rejected_epoch;
    uint32_t fir_ref_delay_strict_copy_failures;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    nuwax_aec_delay_shadow_state_t *aec_delay_shadow;
    int16_t *aec_delay_shadow_history;
    size_t aec_delay_shadow_history_capacity;
    uint32_t aec_delay_shadow_human_hold_frames;
    uint32_t aec_delay_shadow_inactive_frames;
    uint32_t aec_delay_shadow_snapshots;
    uint32_t aec_delay_shadow_snapshot_misses;
    uint32_t aec_delay_shadow_human_skips;
    uint32_t aec_delay_shadow_sequence_gaps;
    uint32_t aec_delay_shadow_results;
    uint32_t aec_delay_shadow_accepted;
    uint32_t aec_delay_shadow_last_sequence;
    uint64_t aec_delay_shadow_last_anchor_events;
    bool aec_delay_shadow_sequence_seen;
    bool aec_delay_shadow_anchor_seen;
    bool aec_delay_shadow_last_accepted;
#endif
    QueueHandle_t free_slots;
    QueueHandle_t ready_slots;
    bool free_slots_with_caps;
    bool ready_slots_with_caps;
    TaskHandle_t task;
    void *task_stack;
    nuwax_rt_capture_frame_t *frames;
    int16_t *mic1_pool;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    int16_t *mic2_pool;
    int16_t *ref_pool;
    int16_t *hw_ref_pool;
    int16_t *fir_ref_pool;
#endif
    nuwax_rt_capture_frame_t drop_frame;
    int16_t *drop_mic1;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    int16_t *drop_mic2;
    int16_t *drop_ref;
    int16_t *drop_hw_ref;
    int16_t *drop_fir_ref;
#endif
    _Atomic bool stop_requested;
    _Atomic bool stopped;
    uint32_t next_seq;
    uint32_t read_frames;
    uint32_t dropped_no_slot;
    uint32_t dropped_oldest_ready;
    uint32_t ready_full_drops;
    uint32_t dropped_samples;
    uint32_t backpressure_waits;
    uint32_t backpressure_recovers;
    uint32_t pending_ready_on_stop;
    uint32_t pending_samples_on_stop;
    uint32_t max_ready_depth;
    esp_err_t last_error;
} nuwax_rt_capture_ctx_t;

static StaticTask_t s_rt_capture_task_tcb;
static portMUX_TYPE s_rt_capture_task_lock = portMUX_INITIALIZER_UNLOCKED;
static bool s_rt_capture_task_in_use;

static bool rt_capture_claim_task_tcb(void) {
    bool claimed = false;
    portENTER_CRITICAL(&s_rt_capture_task_lock);
    if (!s_rt_capture_task_in_use) {
        s_rt_capture_task_in_use = true;
        claimed = true;
    }
    portEXIT_CRITICAL(&s_rt_capture_task_lock);
    return claimed;
}

static void rt_capture_release_task_tcb(void) {
    portENTER_CRITICAL(&s_rt_capture_task_lock);
    s_rt_capture_task_in_use = false;
    portEXIT_CRITICAL(&s_rt_capture_task_lock);
}

static void *rt_capture_alloc(size_t bytes) {
    /* Capture pools are large and long-lived. Falling back to internal RAM
     * starves I2S, Wi-Fi and control-path allocations under full duplex. */
    return heap_caps_malloc(bytes, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
}

static void rt_capture_release_allocations(nuwax_rt_capture_ctx_t *ctx) {
    if (!ctx) {
        return;
    }
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    if (ctx->fir_ref_delay_requests) {
        vQueueDelete(ctx->fir_ref_delay_requests);
        ctx->fir_ref_delay_requests = NULL;
    }
    free(ctx->fir_ref_delay_scratch);
    ctx->fir_ref_delay_scratch = NULL;
    ctx->fir_ref_delay_scratch_capacity = 0;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    free(ctx->aec_delay_shadow);
    ctx->aec_delay_shadow = NULL;
    free(ctx->aec_delay_shadow_history);
    ctx->aec_delay_shadow_history = NULL;
    ctx->aec_delay_shadow_history_capacity = 0;
#endif
    delete_owned_queue(&ctx->free_slots, &ctx->free_slots_with_caps);
    delete_owned_queue(&ctx->ready_slots, &ctx->ready_slots_with_caps);
    free(ctx->frames);
    ctx->frames = NULL;
    free(ctx->mic1_pool);
    ctx->mic1_pool = NULL;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    free(ctx->mic2_pool);
    ctx->mic2_pool = NULL;
    free(ctx->ref_pool);
    ctx->ref_pool = NULL;
    free(ctx->hw_ref_pool);
    ctx->hw_ref_pool = NULL;
    free(ctx->fir_ref_pool);
    ctx->fir_ref_pool = NULL;
#endif
    free(ctx->drop_mic1);
    ctx->drop_mic1 = NULL;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    free(ctx->drop_mic2);
    ctx->drop_mic2 = NULL;
    free(ctx->drop_ref);
    ctx->drop_ref = NULL;
    free(ctx->drop_hw_ref);
    ctx->drop_hw_ref = NULL;
    free(ctx->drop_fir_ref);
    ctx->drop_fir_ref = NULL;
#endif
}

static esp_err_t rt_capture_read_frame(nuwax_rt_capture_ctx_t *ctx,
                                       nuwax_rt_capture_frame_t *frame) {
    if (!ctx || !frame || !ctx->mic || !frame->mic1) {
        return ESP_ERR_INVALID_ARG;
    }
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    if (!frame->mic2 || !frame->ref || !frame->hw_ref || !frame->fir_ref) {
        return ESP_ERR_INVALID_ARG;
    }
#endif
    frame->samples_read = 0;
    frame->err = ESP_OK;
    frame->slot2_ref_candidate = false;
    frame->have_aec_ref = false;
    frame->hw_ref_active = false;
    frame->hw_ref_raw_level = (nuwax_mic_level_t){0};
    frame->software_ref_snapshot = false;
    frame->software_ref_active = false;
    frame->software_ref_anchor_events = ctx->software_ref_reader.anchor_events;
    frame->software_ref_generation = ctx->software_ref_reader.generation;
    frame->reference_provenance =
        (nuwax_aec_reference_provenance_t){0};
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    const uint32_t frame_fir_delay_samples = ctx->software_fir_ref_delay_samples;
    frame->software_fir_ref_full = false;
    frame->software_fir_ref_delay_samples = frame_fir_delay_samples;
    frame->software_fir_ref_delay_revision = ctx->fir_ref_delay_control.active_revision;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    frame->software_ref_epoch_valid = false;
    frame->software_ref_source_end_index = 0;
    frame->software_ref_phase_error = 0;
#endif
    frame->hw_ref_fallback = false;
    frame->speaker_pending = false;
    frame->speaker_session_active = false;
    frame->speaker_submitted_generation = 0U;
    frame->speaker_volume_generation = 0U;
    frame->speaker_volume_percent = 0U;
    frame->speaker_playback_snapshot_stable = false;
    frame->speaker_volume_snapshot_stable = false;
    frame->speaker_completed_stop_generation = 0U;
    frame->speaker_completed_stop_timestamp_us = 0;
    frame->speaker_completed_stop_result = ESP_ERR_INVALID_STATE;
    frame->speaker_stop_fault_active = false;
    frame->speaker_failed_stop_generation = 0U;
    frame->speaker_failed_stop_timestamp_us = 0;
    frame->speaker_failed_stop_result = ESP_ERR_INVALID_STATE;
    memset(&frame->raw_stats, 0, sizeof(frame->raw_stats));
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats_before = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats_before);
#endif
    frame->read_started_us = esp_timer_get_time();

    esp_err_t err = ESP_OK;
    size_t samples_read = 0;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    if (!frame->mic2 || !frame->ref || !frame->fir_ref) {
        return ESP_ERR_INVALID_ARG;
    }
    err = nuwax_mic_input_read_vocat_mic12_ref_pcm16(ctx->mic,
                                                     frame->mic1,
                                                     frame->mic2,
                                                     frame->ref,
                                                     ctx->samples_per_frame,
                                                     CONFIG_NUWAX_MIC_READ_TIMEOUT_MS,
                                                     &samples_read);
    if (err == ESP_OK || err == ESP_ERR_TIMEOUT) {
        if (samples_read > 0) {
            frame->slot2_ref_candidate = true;
            memcpy(frame->hw_ref,
                   frame->ref,
                   samples_read * sizeof(frame->hw_ref[0]));
            const nuwax_mic_level_t ref_level =
                nuwax_mic_level_measure(frame->hw_ref, samples_read);
            frame->hw_ref_raw_level = ref_level;
            const bool ref_active =
                ref_level.avg_abs >= NUWAX_HW_REF_ACTIVE_MIN_AVG_ABS ||
                ref_level.peak >= NUWAX_HW_REF_ACTIVE_MIN_PEAK;
            frame->hw_ref_active = CONFIG_NUWAX_VOCAT_SLOT2_AEC_REF_ENABLE != 0 &&
                                   CONFIG_NUWAX_VOCAT_MIC3_REFERENCE_PRODUCTION_PROVEN != 0 &&
                                   s_hw_ref_health_passed &&
                                   ref_active;
            frame->have_aec_ref = frame->hw_ref_active;
            if (!frame->have_aec_ref) {
                size_t fir_copied = 0;
                const size_t copied =
                    nuwax_p3_software_ref_read_delayed_pair_continuous(
                        &ctx->software_ref_reader,
                        frame->ref,
                        ctx->software_ref_delay_samples,
                        frame->fir_ref,
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
                        frame_fir_delay_samples,
#else
                        ctx->software_fir_ref_delay_samples,
#endif
                        samples_read,
                        &fir_copied);
                frame->software_ref_anchor_events = ctx->software_ref_reader.anchor_events;
                frame->software_ref_generation = ctx->software_ref_reader.generation;
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
                if (copied == samples_read && fir_copied == samples_read &&
                    ctx->software_ref_reader.source_end_index >= samples_read) {
                    frame->software_ref_epoch_valid = true;
                    frame->software_ref_source_end_index =
                        ctx->software_ref_reader.source_end_index - samples_read;
                    frame->software_ref_phase_error = ctx->software_ref_reader.last_phase_error;
                }
#endif
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
                frame->software_fir_ref_full =
                    copied == samples_read && fir_copied == samples_read &&
                    samples_read == ctx->samples_per_frame;
                if (ctx->fir_ref_delay_pending_valid) {
                    const nuwax_aec_fir_delay_request_t request =
                        ctx->fir_ref_delay_pending;
                    const bool epoch_matches =
                        frame->software_fir_ref_full &&
                        request.generation == frame->software_ref_generation &&
                        request.anchor_events == frame->software_ref_anchor_events &&
                        ctx->software_ref_reader.source_end_index >= samples_read &&
                        ctx->fir_ref_delay_scratch &&
                        ctx->fir_ref_delay_scratch_capacity >= samples_read;
                    bool strict_copy_ok = false;
                    nuwax_p3_software_ref_history_span_t strict_span = {0};
                    esp_err_t strict_result = ESP_ERR_INVALID_STATE;
                    if (epoch_matches) {
                        const uint64_t source_end_index =
                            ctx->software_ref_reader.source_end_index - samples_read;
                        strict_result = nuwax_p3_software_ref_read_history_span_at(
                            frame->software_ref_generation,
                            source_end_index,
                            request.target_delay_samples,
                            request.target_delay_samples,
                            samples_read,
                            ctx->fir_ref_delay_scratch,
                            ctx->fir_ref_delay_scratch_capacity,
                            &strict_span);
                        strict_copy_ok =
                            strict_result == ESP_OK && strict_span.recent &&
                            strict_span.span_samples == samples_read;
                    }
                    if (strict_copy_ok) {
                        nuwax_aec_fir_delay_transition_t transition = {0};
                        if (nuwax_aec_fir_delay_commit(
                                &ctx->fir_ref_delay_control,
                                &request,
                                frame->software_ref_generation,
                                frame->software_ref_anchor_events,
                                &transition) &&
                            transition.changed) {
                            memcpy(frame->fir_ref,
                                   ctx->fir_ref_delay_scratch,
                                   samples_read * sizeof(frame->fir_ref[0]));
                            ctx->software_fir_ref_delay_samples =
                                transition.new_delay_samples;
                            frame->software_fir_ref_delay_samples =
                                transition.new_delay_samples;
                            frame->software_fir_ref_delay_revision =
                                transition.new_revision;
                            ctx->fir_ref_delay_applied++;
                            ESP_LOGI(TAG,
                                     "AEC_FIR_DELAY capture_apply decision_seq=%lu capture_seq=%lu generation=%lu anchor=%llu acoustic=%lu target_tap=%lu old=%lu new=%lu revision=%lu->%lu main_delay=%lu",
                                     (unsigned long)request.decision_sequence,
                                     (unsigned long)frame->seq,
                                     (unsigned long)request.generation,
                                     (unsigned long long)request.anchor_events,
                                     (unsigned long)request.acoustic_delay_samples,
                                     (unsigned long)request.target_tap,
                                     (unsigned long)transition.old_delay_samples,
                                     (unsigned long)transition.new_delay_samples,
                                     (unsigned long)transition.old_revision,
                                     (unsigned long)transition.new_revision,
                                     (unsigned long)ctx->software_ref_delay_samples);
                        }
                    } else {
                        if (!epoch_matches) {
                            ctx->fir_ref_delay_rejected_epoch++;
                        } else {
                            ctx->fir_ref_delay_strict_copy_failures++;
                        }
                        ESP_LOGW(TAG,
                                 "AEC_FIR_DELAY capture_reject reason=%s err=%s decision_seq=%lu capture_seq=%lu request_generation=%lu frame_generation=%lu request_anchor=%llu frame_anchor=%llu target=%lu",
                                 epoch_matches ? "strict_copy" : "stale_epoch",
                                 esp_err_to_name(strict_result),
                                 (unsigned long)request.decision_sequence,
                                 (unsigned long)frame->seq,
                                 (unsigned long)request.generation,
                                 (unsigned long)frame->software_ref_generation,
                                 (unsigned long long)request.anchor_events,
                                 (unsigned long long)frame->software_ref_anchor_events,
                                 (unsigned long)request.target_delay_samples);
                    }
                    ctx->fir_ref_delay_pending_valid = false;
                }
#endif
                if (copied >= (samples_read / 2U)) {
                    const nuwax_mic_level_t soft_ref_level =
                        nuwax_mic_level_measure(frame->ref, samples_read);
                    const bool soft_ref_active =
                        soft_ref_level.avg_abs >= NUWAX_HW_REF_ACTIVE_MIN_AVG_ABS ||
                        soft_ref_level.peak >= NUWAX_HW_REF_ACTIVE_MIN_PEAK;
                    frame->software_ref_snapshot = true;
                    frame->software_ref_active = soft_ref_active;
                    frame->have_aec_ref = true;
                }
                if (fir_copied < (samples_read / 2U)) {
                    memset(frame->fir_ref, 0, samples_read * sizeof(frame->fir_ref[0]));
                }
            } else {
                nuwax_p3_software_ref_reader_invalidate(&ctx->software_ref_reader);
                memcpy(frame->fir_ref, frame->ref, samples_read * sizeof(frame->fir_ref[0]));
            }
        }
    } else if (err == ESP_ERR_NOT_SUPPORTED) {
        frame->hw_ref_fallback = true;
        samples_read = 0;
        err = nuwax_mic_input_read_pcm16(ctx->mic,
                                         frame->mic1,
                                         ctx->samples_per_frame,
                                         CONFIG_NUWAX_MIC_READ_TIMEOUT_MS,
                                         &samples_read);
        if (samples_read > 0) {
            memset(frame->mic2, 0, samples_read * sizeof(frame->mic2[0]));
            memset(frame->ref, 0, samples_read * sizeof(frame->ref[0]));
            memset(frame->hw_ref, 0, samples_read * sizeof(frame->hw_ref[0]));
            memset(frame->fir_ref, 0, samples_read * sizeof(frame->fir_ref[0]));
        }
    }
#else
    err = nuwax_mic_input_read_pcm16(ctx->mic,
                                     frame->mic1,
                                     ctx->samples_per_frame,
                                     CONFIG_NUWAX_MIC_READ_TIMEOUT_MS,
                                     &samples_read);
#endif
    frame->read_finished_us = esp_timer_get_time();
    frame->read_finished_ms = monotonic_ms();
    frame->samples_read = samples_read;
    frame->err = err;
    const nuwax_mic_raw_stats_t *raw = nuwax_mic_input_get_last_raw_stats(ctx->mic);
    if (raw) {
        frame->raw_stats = *raw;
    }
#if CONFIG_NUWAX_SPEAKER_ENABLE
    nuwax_speaker_playback_stats_t speaker_stats = {0};
    nuwax_speaker_playback_get_stats(&speaker_stats);
    frame->speaker_pending = speaker_stats.pending;
    frame->speaker_session_active = speaker_stats.playback_session_active;
    frame->speaker_submitted_generation = speaker_stats.submitted_generation;
    frame->speaker_volume_generation = speaker_stats.volume_generation;
    frame->speaker_volume_percent = speaker_stats.volume_percent;
    frame->speaker_playback_snapshot_stable =
        speaker_stats_before.submitted_generation ==
            speaker_stats.submitted_generation &&
        speaker_stats_before.playback_generation ==
            speaker_stats.playback_generation &&
        speaker_stats_before.playback_active == speaker_stats.playback_active &&
        speaker_stats_before.pending == speaker_stats.pending &&
        speaker_stats_before.playback_session_active ==
            speaker_stats.playback_session_active &&
        speaker_stats_before.fade_cancel_active ==
            speaker_stats.fade_cancel_active &&
        speaker_stats_before.fade_cancel_generation ==
            speaker_stats.fade_cancel_generation &&
        speaker_stats_before.probe_duck_active ==
            speaker_stats.probe_duck_active &&
        speaker_stats_before.probe_duck_generation ==
            speaker_stats.probe_duck_generation &&
        speaker_stats_before.stop_in_progress ==
            speaker_stats.stop_in_progress &&
        speaker_stats_before.stop_fault_active ==
            speaker_stats.stop_fault_active &&
        speaker_stats_before.failed_stop_generation ==
            speaker_stats.failed_stop_generation;
    frame->speaker_volume_snapshot_stable =
        speaker_stats_before.volume_generation == speaker_stats.volume_generation &&
        speaker_stats_before.volume_percent == speaker_stats.volume_percent;
    frame->speaker_completed_stop_generation =
        speaker_stats.completed_stop_generation;
    frame->speaker_completed_stop_timestamp_us =
        speaker_stats.completed_stop_timestamp_us;
    frame->speaker_completed_stop_result =
        speaker_stats.completed_stop_result;
    frame->speaker_stop_fault_active = speaker_stats.stop_fault_active;
    frame->speaker_failed_stop_generation =
        speaker_stats.failed_stop_generation;
    frame->speaker_failed_stop_timestamp_us =
        speaker_stats.failed_stop_timestamp_us;
    frame->speaker_failed_stop_result = speaker_stats.failed_stop_result;
#endif
    frame->reference_provenance = nuwax_aec_reference_select(
        frame->hw_ref_active,
        frame->speaker_playback_snapshot_stable,
        frame->speaker_submitted_generation,
        frame->software_ref_snapshot,
        frame->software_ref_generation);
    if (err != ESP_OK && err != ESP_ERR_TIMEOUT) {
        ctx->last_error = err;
    }
    return err;
}

static void rt_capture_task(void *arg) {
    nuwax_rt_capture_ctx_t *ctx = (nuwax_rt_capture_ctx_t *)arg;
    if (!ctx) {
        vTaskSuspend(NULL);
        return;
    }
    while (!atomic_load_explicit(&ctx->stop_requested,
                                 memory_order_acquire)) {
        uint16_t slot = 0;
        bool dropping = false;
        nuwax_rt_capture_frame_t *frame = NULL;
        bool have_free_slot =
            xQueueReceive(ctx->free_slots, &slot, 0) == pdTRUE &&
            slot < NUWAX_RT_CAPTURE_QUEUE_DEPTH;
        if (!have_free_slot) {
            ctx->backpressure_waits++;
            have_free_slot =
                xQueueReceive(ctx->free_slots,
                              &slot,
                              pdMS_TO_TICKS(NUWAX_RT_CAPTURE_BACKPRESSURE_WAIT_MS)) == pdTRUE &&
                slot < NUWAX_RT_CAPTURE_QUEUE_DEPTH;
            if (have_free_slot) {
                ctx->backpressure_recovers++;
            }
        }
        if (have_free_slot) {
            frame = &ctx->frames[slot];
        } else {
            uint16_t stale_slot = 0;
            if (xQueueReceive(ctx->ready_slots, &stale_slot, 0) == pdTRUE &&
                stale_slot < NUWAX_RT_CAPTURE_QUEUE_DEPTH) {
                frame = &ctx->frames[stale_slot];
                slot = stale_slot;
                ctx->dropped_oldest_ready++;
                ctx->dropped_samples += (uint32_t)frame->samples_read;
            } else {
                dropping = true;
                frame = &ctx->drop_frame;
                ctx->dropped_no_slot++;
            }
        }

#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
        nuwax_aec_fir_delay_request_t fir_delay_request = {0};
        if (ctx->fir_ref_delay_requests &&
            xQueueReceive(ctx->fir_ref_delay_requests, &fir_delay_request, 0) == pdTRUE) {
            ctx->fir_ref_delay_pending = fir_delay_request;
            ctx->fir_ref_delay_pending_valid = true;
            ctx->fir_ref_delay_requests_received++;
        }
#endif
        frame->seq = ctx->next_seq++;
        (void)rt_capture_read_frame(ctx, frame);

        if (dropping) {
            ctx->dropped_samples += (uint32_t)frame->samples_read;
            continue;
        }

        if (xQueueSend(ctx->ready_slots, &slot, 0) != pdTRUE) {
            ctx->ready_full_drops++;
            ctx->dropped_samples += (uint32_t)frame->samples_read;
            (void)xQueueSend(ctx->free_slots, &slot, 0);
            continue;
        }
        ctx->read_frames++;
        const uint32_t ready_depth = (uint32_t)uxQueueMessagesWaiting(ctx->ready_slots);
        if (ready_depth > ctx->max_ready_depth) {
            ctx->max_ready_depth = ready_depth;
        }
    }
    atomic_store_explicit(&ctx->stopped, true, memory_order_release);
    vTaskSuspend(NULL);
}

static esp_err_t rt_capture_start(nuwax_rt_capture_ctx_t *ctx,
                                  nuwax_mic_input_t *mic,
                                  size_t samples_per_frame,
                                  uint32_t software_ref_delay_samples) {
    if (!ctx || !mic || samples_per_frame == 0 ||
        samples_per_frame > CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME) {
        return ESP_ERR_INVALID_ARG;
    }
    memset(ctx, 0, sizeof(*ctx));
    atomic_init(&ctx->stop_requested, false);
    atomic_init(&ctx->stopped, false);
    ctx->mic = mic;
    ctx->samples_per_frame = samples_per_frame;
    ctx->software_ref_delay_samples = software_ref_delay_samples;
    const uint32_t baseline_fir_ref_delay =
        software_ref_delay_samples + NUWAX_HUMAN_RESCUE_FIR_REF_LAG_SAMPLES;
    ctx->software_fir_ref_delay_samples = baseline_fir_ref_delay;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    nuwax_aec_fir_delay_control_init(&ctx->fir_ref_delay_control,
                                     baseline_fir_ref_delay);
#endif
    nuwax_p3_software_ref_reader_reset(&ctx->software_ref_reader);
    ctx->last_error = ESP_OK;
    ctx->free_slots = create_queue_prefer_psram("rt_capture_free",
                                                 NUWAX_RT_CAPTURE_QUEUE_DEPTH,
                                                 sizeof(uint16_t),
                                                 &ctx->free_slots_with_caps);
    ctx->ready_slots = create_queue_prefer_psram("rt_capture_ready",
                                                  NUWAX_RT_CAPTURE_QUEUE_DEPTH,
                                                  sizeof(uint16_t),
                                                  &ctx->ready_slots_with_caps);
    const size_t frame_bytes = NUWAX_RT_CAPTURE_QUEUE_DEPTH * sizeof(ctx->frames[0]);
    const size_t sample_bytes = NUWAX_RT_CAPTURE_QUEUE_DEPTH * samples_per_frame * sizeof(int16_t);
    ctx->frames = (nuwax_rt_capture_frame_t *)rt_capture_alloc(frame_bytes);
    ctx->mic1_pool = (int16_t *)rt_capture_alloc(sample_bytes);
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    ctx->mic2_pool = (int16_t *)rt_capture_alloc(sample_bytes);
    ctx->ref_pool = (int16_t *)rt_capture_alloc(sample_bytes);
    ctx->hw_ref_pool = (int16_t *)rt_capture_alloc(sample_bytes);
    ctx->fir_ref_pool = (int16_t *)rt_capture_alloc(sample_bytes);
#endif
    ctx->drop_mic1 = (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    ctx->drop_mic2 = (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
    ctx->drop_ref = (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
    ctx->drop_hw_ref = (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
    ctx->drop_fir_ref = (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
#endif
    if (!ctx->free_slots || !ctx->ready_slots || !ctx->frames || !ctx->mic1_pool ||
        !ctx->drop_mic1
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        || !ctx->mic2_pool || !ctx->ref_pool || !ctx->hw_ref_pool ||
           !ctx->fir_ref_pool || !ctx->drop_mic2 || !ctx->drop_ref ||
           !ctx->drop_hw_ref || !ctx->drop_fir_ref
#endif
    ) {
        ESP_LOGE(TAG,
                 "rt capture allocation failed depth=%u samples=%u frame_bytes=%u sample_bytes=%u free_psram=%u largest_psram=%u",
                 (unsigned)NUWAX_RT_CAPTURE_QUEUE_DEPTH,
                 (unsigned)samples_per_frame,
                 (unsigned)frame_bytes,
                 (unsigned)sample_bytes,
                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
        rt_capture_release_allocations(ctx);
        memset(ctx, 0, sizeof(*ctx));
        return ESP_ERR_NO_MEM;
    }
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    ctx->fir_ref_delay_requests =
        xQueueCreate(1U, sizeof(nuwax_aec_fir_delay_request_t));
    ctx->fir_ref_delay_scratch =
        (int16_t *)rt_capture_alloc(samples_per_frame * sizeof(int16_t));
    ctx->fir_ref_delay_scratch_capacity = samples_per_frame;
    if (!ctx->fir_ref_delay_requests || !ctx->fir_ref_delay_scratch) {
        const bool queue_allocated = ctx->fir_ref_delay_requests != NULL;
        const bool scratch_allocated = ctx->fir_ref_delay_scratch != NULL;
        if (ctx->fir_ref_delay_requests) {
            vQueueDelete(ctx->fir_ref_delay_requests);
            ctx->fir_ref_delay_requests = NULL;
        }
        free(ctx->fir_ref_delay_scratch);
        ctx->fir_ref_delay_scratch = NULL;
        ctx->fir_ref_delay_scratch_capacity = 0;
        ESP_LOGW(TAG,
                 "AEC_FIR_DELAY disabled allocation queue=%d scratch=%d",
                 queue_allocated ? 1 : 0,
                 scratch_allocated ? 1 : 0);
    } else {
        ESP_LOGI(TAG,
                 "AEC_FIR_DELAY enabled baseline=%lu main_delay=%lu revision=1",
                 (unsigned long)baseline_fir_ref_delay,
                 (unsigned long)software_ref_delay_samples);
    }
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    nuwax_aec_delay_shadow_config_t shadow_config = {0};
    nuwax_aec_delay_shadow_default_config(&shadow_config);
    const size_t shadow_history_samples =
        samples_per_frame +
        (size_t)shadow_config.max_delay_samples -
        (size_t)shadow_config.min_delay_samples;
    ctx->aec_delay_shadow =
        (nuwax_aec_delay_shadow_state_t *)rt_capture_alloc(sizeof(*ctx->aec_delay_shadow));
    ctx->aec_delay_shadow_history =
        (int16_t *)rt_capture_alloc(shadow_history_samples * sizeof(int16_t));
    ctx->aec_delay_shadow_history_capacity = shadow_history_samples;
    const nuwax_aec_delay_shadow_status_t shadow_status =
        ctx->aec_delay_shadow && ctx->aec_delay_shadow_history
            ? nuwax_aec_delay_shadow_init(ctx->aec_delay_shadow,
                                          &shadow_config,
                                          0)
            : NUWAX_AEC_DELAY_SHADOW_INVALID_ARGUMENT;
    if (shadow_status != NUWAX_AEC_DELAY_SHADOW_OK) {
        free(ctx->aec_delay_shadow);
        ctx->aec_delay_shadow = NULL;
        free(ctx->aec_delay_shadow_history);
        ctx->aec_delay_shadow_history = NULL;
        ctx->aec_delay_shadow_history_capacity = 0;
        ESP_LOGW(TAG,
                 "AEC_ALIGN_SHADOW disabled allocation_or_config status=%d state_bytes=%u history_bytes=%u",
                 (int)shadow_status,
                 (unsigned)sizeof(nuwax_aec_delay_shadow_state_t),
                 (unsigned)(shadow_history_samples * sizeof(int16_t)));
    } else {
        ESP_LOGI(TAG,
                 "AEC_ALIGN_SHADOW enabled range=%lu..%lu coarse=%lu cadence=%lu state_bytes=%u history_samples=%u main_apply=0 fir_apply=%d",
                 (unsigned long)shadow_config.min_delay_samples,
                 (unsigned long)shadow_config.max_delay_samples,
                 (unsigned long)shadow_config.coarse_step_samples,
                 (unsigned long)shadow_config.cadence_frames,
                 (unsigned)sizeof(nuwax_aec_delay_shadow_state_t),
                 (unsigned)shadow_history_samples,
                 CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE ? 1 : 0);
    }
#endif
    memset(ctx->frames, 0, frame_bytes);
    for (uint16_t slot = 0; slot < NUWAX_RT_CAPTURE_QUEUE_DEPTH; slot++) {
        nuwax_rt_capture_frame_t *frame = &ctx->frames[slot];
        frame->slot = slot;
        frame->mic1 = &ctx->mic1_pool[(size_t)slot * samples_per_frame];
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        frame->mic2 = &ctx->mic2_pool[(size_t)slot * samples_per_frame];
        frame->ref = &ctx->ref_pool[(size_t)slot * samples_per_frame];
        frame->hw_ref = &ctx->hw_ref_pool[(size_t)slot * samples_per_frame];
        frame->fir_ref = &ctx->fir_ref_pool[(size_t)slot * samples_per_frame];
#endif
        (void)xQueueSend(ctx->free_slots, &slot, 0);
    }
    ctx->drop_frame.slot = UINT16_MAX;
    ctx->drop_frame.mic1 = ctx->drop_mic1;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
    ctx->drop_frame.mic2 = ctx->drop_mic2;
    ctx->drop_frame.ref = ctx->drop_ref;
    ctx->drop_frame.hw_ref = ctx->drop_hw_ref;
    ctx->drop_frame.fir_ref = ctx->drop_fir_ref;
#endif

    if (!rt_capture_claim_task_tcb()) {
        ESP_LOGE(TAG, "rt capture task singleton is already in use");
        rt_capture_release_allocations(ctx);
        memset(ctx, 0, sizeof(*ctx));
        return ESP_ERR_INVALID_STATE;
    }
    ctx->task_stack = heap_caps_malloc(NUWAX_RT_CAPTURE_TASK_STACK_BYTES,
                                       MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!ctx->task_stack) {
        ESP_LOGE(TAG,
                 "rt capture task PSRAM stack allocation failed bytes=%u free_psram=%u largest_psram=%u",
                 (unsigned)NUWAX_RT_CAPTURE_TASK_STACK_BYTES,
                 (unsigned)heap_caps_get_free_size(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT),
                 (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
        rt_capture_release_task_tcb();
        rt_capture_release_allocations(ctx);
        memset(ctx, 0, sizeof(*ctx));
        return ESP_ERR_NO_MEM;
    }
    ctx->task = xTaskCreateStaticPinnedToCore(
        rt_capture_task,
        "nuwax_mic_rx",
        NUWAX_RT_CAPTURE_TASK_STACK_BYTES,
        ctx,
        NUWAX_RT_CAPTURE_TASK_PRIORITY,
        (StackType_t *)ctx->task_stack,
        &s_rt_capture_task_tcb,
        NUWAX_RT_CAPTURE_TASK_CORE);
    if (!ctx->task) {
        ESP_LOGE(TAG, "rt capture task static creation failed");
        heap_caps_free(ctx->task_stack);
        ctx->task_stack = NULL;
        rt_capture_release_task_tcb();
        rt_capture_release_allocations(ctx);
        memset(ctx, 0, sizeof(*ctx));
        return ESP_ERR_NO_MEM;
    }
    ESP_LOGI(TAG,
             "rt capture started depth=%u samples_per_frame=%u buffer_ms=%u software_ref_delay=%lu fir_ref_delay=%lu fir_ref_lag=%u ref_cursor=continuous task_stack=psram static_tcb=1 core=%u priority=%u",
             (unsigned)NUWAX_RT_CAPTURE_QUEUE_DEPTH,
             (unsigned)samples_per_frame,
             (unsigned)(NUWAX_RT_CAPTURE_QUEUE_DEPTH * CONFIG_NUWAX_VOICE_FRAME_DURATION_MS),
             (unsigned long)software_ref_delay_samples,
             (unsigned long)ctx->software_fir_ref_delay_samples,
             (unsigned)NUWAX_HUMAN_RESCUE_FIR_REF_LAG_SAMPLES,
             (unsigned)NUWAX_RT_CAPTURE_TASK_CORE,
             (unsigned)NUWAX_RT_CAPTURE_TASK_PRIORITY);
    return ESP_OK;
}

static bool rt_capture_receive(nuwax_rt_capture_ctx_t *ctx,
                               nuwax_rt_capture_frame_t **out_frame,
                               uint32_t timeout_ms) {
    if (!ctx || !ctx->ready_slots || !out_frame) {
        return false;
    }
    uint16_t slot = 0;
    if (xQueueReceive(ctx->ready_slots, &slot, pdMS_TO_TICKS(timeout_ms)) != pdTRUE ||
        slot >= NUWAX_RT_CAPTURE_QUEUE_DEPTH) {
        return false;
    }
    *out_frame = &ctx->frames[slot];
    return true;
}

static void rt_capture_release(nuwax_rt_capture_ctx_t *ctx,
                               nuwax_rt_capture_frame_t *frame) {
    if (!ctx || !ctx->free_slots || !frame || frame->slot >= NUWAX_RT_CAPTURE_QUEUE_DEPTH) {
        return;
    }
    const uint16_t slot = frame->slot;
    (void)xQueueSend(ctx->free_slots, &slot, 0);
}

static void __attribute__((noreturn)) rt_capture_restart_preserving_ownership(
    const nuwax_rt_capture_ctx_t *ctx,
    const char *reason) {
    const eTaskState task_state = ctx && ctx->task
                                      ? eTaskGetState(ctx->task)
                                      : eInvalid;
    ESP_LOGE(TAG,
             "rt capture cleanup could not prove task quiescence reason=%s state=%d stopped=%d stop_requested=%d read=%lu last_error=%s; controlled restart preserves task, I2S, queue and stack ownership",
             reason ? reason : "unknown",
             (int)task_state,
             ctx && atomic_load_explicit(&ctx->stopped,
                                         memory_order_acquire)
                 ? 1
                 : 0,
             ctx && atomic_load_explicit(&ctx->stop_requested,
                                         memory_order_acquire)
                 ? 1
                 : 0,
             (unsigned long)(ctx ? ctx->read_frames : 0U),
             ctx ? esp_err_to_name(ctx->last_error) : "-");
    nuwax_diagnostics_log_heap_label(TAG, "rt_capture_cleanup_restart");
    vTaskDelay(pdMS_TO_TICKS(100));
    esp_restart();
    vTaskDelay(portMAX_DELAY);
}

#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
static uint32_t aec_delay_shadow_q15(float value);
#endif

static esp_err_t rt_capture_stop(nuwax_rt_capture_ctx_t *ctx) {
    if (!ctx || !ctx->free_slots) {
        return ESP_OK;
    }
    atomic_store_explicit(&ctx->stop_requested, true, memory_order_release);
    const uint32_t started_ms = monotonic_ms();
    while (!atomic_load_explicit(&ctx->stopped, memory_order_acquire) &&
           !elapsed_ms(monotonic_ms(), started_ms + NUWAX_RT_CAPTURE_STOP_WAIT_MS)) {
        vTaskDelay(pdMS_TO_TICKS(10));
    }
    const bool stop_acknowledged =
        atomic_load_explicit(&ctx->stopped, memory_order_acquire);
    UBaseType_t task_stack_min_free = 0U;
    if (ctx->task && !stop_acknowledged) {
        rt_capture_restart_preserving_ownership(ctx,
                                                "stop_ack_timeout");
    }
    if (ctx->task) {
        /* stopped is published only after the capture loop has stopped using
         * its stack-owned context. Confirm the task is suspended as a second
         * ownership barrier before deleting its static task storage. */
        vTaskSuspend(ctx->task);
        const uint32_t suspend_deadline = monotonic_ms() +
            NUWAX_RT_CAPTURE_FORCE_SUSPEND_WAIT_MS;
        eTaskState task_state = eTaskGetState(ctx->task);
        while (task_state != eSuspended &&
               !elapsed_ms(monotonic_ms(), suspend_deadline)) {
            vTaskDelay(1);
            task_state = eTaskGetState(ctx->task);
        }
        if (task_state != eSuspended) {
            rt_capture_restart_preserving_ownership(
                ctx, "suspend_confirmation_timeout");
        }
        task_stack_min_free = uxTaskGetStackHighWaterMark(ctx->task);
        vTaskDelete(ctx->task);
        ctx->task = NULL;
        heap_caps_free(ctx->task_stack);
        ctx->task_stack = NULL;
        rt_capture_release_task_tcb();
    }
    uint16_t pending_slot = 0;
    while (ctx->ready_slots && xQueueReceive(ctx->ready_slots, &pending_slot, 0) == pdTRUE) {
        if (pending_slot < NUWAX_RT_CAPTURE_QUEUE_DEPTH) {
            ctx->pending_ready_on_stop++;
            ctx->pending_samples_on_stop += (uint32_t)ctx->frames[pending_slot].samples_read;
        }
    }
    ESP_LOGI(TAG,
             "rt capture stopped read=%lu dropped_no_slot=%lu dropped_oldest=%lu ready_full=%lu dropped_samples=%lu backpressure=%lu/%lu pending=%lu pending_samples=%lu max_ready=%lu stack_min_free=%u stack_bytes=%u last_error=%s ref_cursor=%llu/%llu anchors=%llu generation_resets=%llu resync=%llu underrun=%llu blocked_reanchor=%llu waiting=%d wait_write=%llu phase=%lld/%lld/%lld",
             (unsigned long)ctx->read_frames,
             (unsigned long)ctx->dropped_no_slot,
             (unsigned long)ctx->dropped_oldest_ready,
             (unsigned long)ctx->ready_full_drops,
             (unsigned long)ctx->dropped_samples,
             (unsigned long)ctx->backpressure_recovers,
             (unsigned long)ctx->backpressure_waits,
             (unsigned long)ctx->pending_ready_on_stop,
             (unsigned long)ctx->pending_samples_on_stop,
             (unsigned long)ctx->max_ready_depth,
             (unsigned)task_stack_min_free,
             (unsigned)NUWAX_RT_CAPTURE_TASK_STACK_BYTES,
             esp_err_to_name(ctx->last_error),
             (unsigned long long)ctx->software_ref_reader.successful_reads,
             (unsigned long long)ctx->software_ref_reader.source_end_index,
             (unsigned long long)ctx->software_ref_reader.anchor_events,
             (unsigned long long)ctx->software_ref_reader.generation_resets,
             (unsigned long long)ctx->software_ref_reader.resync_events,
             (unsigned long long)ctx->software_ref_reader.underrun_reads,
             (unsigned long long)ctx->software_ref_reader.blocked_reanchor_reads,
             ctx->software_ref_reader.reanchor_wait_for_write ? 1 : 0,
             (unsigned long long)ctx->software_ref_reader.reanchor_wait_write_index,
             (long long)ctx->software_ref_reader.min_phase_error,
             (long long)ctx->software_ref_reader.max_phase_error,
             (long long)ctx->software_ref_reader.last_phase_error);
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    ESP_LOGI(TAG,
             "AEC_FIR_DELAY_SUMMARY published=%lu received=%lu applied=%lu stale_epoch=%lu strict_copy_fail=%lu active_delay=%lu revision=%lu generation=%lu main_delay=%lu",
             (unsigned long)ctx->fir_ref_delay_requests_published,
             (unsigned long)ctx->fir_ref_delay_requests_received,
             (unsigned long)ctx->fir_ref_delay_applied,
             (unsigned long)ctx->fir_ref_delay_rejected_epoch,
             (unsigned long)ctx->fir_ref_delay_strict_copy_failures,
             (unsigned long)ctx->fir_ref_delay_control.active_delay_samples,
             (unsigned long)ctx->fir_ref_delay_control.active_revision,
             (unsigned long)ctx->fir_ref_delay_control.active_generation,
             (unsigned long)ctx->software_ref_delay_samples);
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
    if (ctx->aec_delay_shadow) {
        const uint32_t recommended =
            ctx->aec_delay_shadow->has_stable_delay
                ? (uint32_t)(ctx->aec_delay_shadow->stable_delay_samples + 0.5f)
                : NUWAX_AEC_DELAY_SHADOW_INVALID_DELAY;
    NUWAX_RT_DIAG_LOGI(TAG,
             "AEC_ALIGN_SHADOW_SUMMARY snapshots=%lu misses=%lu results=%lu accepted=%lu human_skips=%lu sequence_gaps=%lu generation=%lu stable_updates=%lu recommended=%lu stability_q15=%lu main_apply=0",
                 (unsigned long)ctx->aec_delay_shadow_snapshots,
                 (unsigned long)ctx->aec_delay_shadow_snapshot_misses,
                 (unsigned long)ctx->aec_delay_shadow_results,
                 (unsigned long)ctx->aec_delay_shadow_accepted,
                 (unsigned long)ctx->aec_delay_shadow_human_skips,
                 (unsigned long)ctx->aec_delay_shadow_sequence_gaps,
                 (unsigned long)ctx->aec_delay_shadow->generation,
                 (unsigned long)ctx->aec_delay_shadow->stability_updates,
                 (unsigned long)recommended,
                 (unsigned long)aec_delay_shadow_q15(ctx->aec_delay_shadow->stability_ewma));
    }
#endif
    rt_capture_release_allocations(ctx);
    return ESP_OK;
}

#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
static uint32_t aec_delay_shadow_q15(float value) {
    if (!(value > 0.0f)) {
        return 0;
    }
    if (value >= 1.0f) {
        return 32768U;
    }
    return (uint32_t)(value * 32768.0f + 0.5f);
}

static void rt_capture_shadow_delay_observe(
    nuwax_rt_capture_ctx_t *ctx,
    const int16_t *mic,
    size_t sample_count,
    uint32_t capture_sequence,
    uint64_t anchor_events,
    uint32_t generation,
    uint64_t source_end_index,
    int64_t phase_error,
    bool epoch_valid,
    bool eligible,
    bool human_block,
    bool dynamic_apply_allowed) {
    if (!ctx || !ctx->aec_delay_shadow || !ctx->aec_delay_shadow_history ||
        !mic || sample_count < 2U) {
        return;
    }

    nuwax_aec_delay_shadow_state_t *shadow = ctx->aec_delay_shadow;
    const bool sequence_gap =
        ctx->aec_delay_shadow_sequence_seen &&
        capture_sequence != ctx->aec_delay_shadow_last_sequence + 1U;
    const bool anchor_changed =
        ctx->aec_delay_shadow_anchor_seen &&
        anchor_events != ctx->aec_delay_shadow_last_anchor_events;
    ctx->aec_delay_shadow_sequence_seen = true;
    ctx->aec_delay_shadow_last_sequence = capture_sequence;
    if (anchor_events > 0) {
        ctx->aec_delay_shadow_anchor_seen = true;
        ctx->aec_delay_shadow_last_anchor_events = anchor_events;
    }
    if (sequence_gap || anchor_changed) {
        nuwax_aec_delay_shadow_reset(shadow, generation);
        if (sequence_gap) {
            ctx->aec_delay_shadow_sequence_gaps++;
        }
    NUWAX_RT_DIAG_LOGI(TAG,
             "AEC_ALIGN_SHADOW reset reason=%s%s seq=%lu generation=%lu anchor=%llu main_apply=0",
                 sequence_gap ? "sequence_gap" : "",
                 anchor_changed ? (sequence_gap ? "+anchor" : "anchor") : "",
                 (unsigned long)capture_sequence,
                 (unsigned long)generation,
                 (unsigned long long)anchor_events);
    }

    if (human_block) {
        if (ctx->aec_delay_shadow_human_hold_frames == 0) {
            nuwax_aec_delay_shadow_reset(shadow, generation);
        }
        ctx->aec_delay_shadow_human_hold_frames =
            NUWAX_AEC_DELAY_SHADOW_HUMAN_HOLD_FRAMES;
        ctx->aec_delay_shadow_human_skips++;
        return;
    }
    if (ctx->aec_delay_shadow_human_hold_frames > 0) {
        ctx->aec_delay_shadow_human_hold_frames--;
        ctx->aec_delay_shadow_human_skips++;
        return;
    }
    if (!eligible || !epoch_valid || generation == 0 || anchor_events == 0) {
        ctx->aec_delay_shadow_inactive_frames++;
        if (ctx->aec_delay_shadow_inactive_frames ==
            NUWAX_AEC_DELAY_SHADOW_INACTIVE_RESET_FRAMES) {
            nuwax_aec_delay_shadow_reset(shadow, generation);
        }
        return;
    }
    ctx->aec_delay_shadow_inactive_frames = 0;

    const bool sample_due =
        shadow->generation != generation ||
        (shadow->frame_count % shadow->config.cadence_frames) == 0U;
    if (!sample_due) {
        nuwax_aec_delay_shadow_result_t skipped = {0};
        (void)nuwax_aec_delay_shadow_process(shadow,
                                             mic,
                                             sample_count,
                                             ctx->aec_delay_shadow_history,
                                             ctx->aec_delay_shadow_history_capacity,
                                             generation,
                                             &skipped);
        return;
    }

    uint64_t reference_ahead = 0;
    if (phase_error < 0) {
        reference_ahead = (uint64_t)(-(phase_error + 1)) + 1ULL;
    }
    uint32_t effective_min_delay = shadow->config.min_delay_samples;
    if (reference_ahead > effective_min_delay) {
        if (reference_ahead > UINT32_MAX) {
            ctx->aec_delay_shadow_snapshot_misses++;
            return;
        }
        effective_min_delay = (uint32_t)reference_ahead;
    }
    if (effective_min_delay > shadow->config.max_delay_samples) {
        ctx->aec_delay_shadow_snapshot_misses++;
        return;
    }

    memset(ctx->aec_delay_shadow_history,
           0,
           ctx->aec_delay_shadow_history_capacity * sizeof(int16_t));
    nuwax_p3_software_ref_history_span_t span = {0};
    const int64_t copy_started_us = esp_timer_get_time();
    const esp_err_t snapshot_result =
        nuwax_p3_software_ref_read_history_span_at(
            generation,
            source_end_index,
            effective_min_delay,
            shadow->config.max_delay_samples,
            sample_count,
            ctx->aec_delay_shadow_history,
            ctx->aec_delay_shadow_history_capacity,
            &span);
    const uint32_t copy_us = (uint32_t)(esp_timer_get_time() - copy_started_us);
    if (snapshot_result != ESP_OK || !span.recent) {
        ctx->aec_delay_shadow_snapshot_misses++;
        if (ctx->aec_delay_shadow_snapshot_misses == 1U ||
            (ctx->aec_delay_shadow_snapshot_misses % 32U) == 0U) {
        NUWAX_RT_DIAG_LOGW(TAG,
                 "AEC_ALIGN_SHADOW snapshot_miss err=%s seq=%lu generation=%lu source_end=%llu phase=%lld effective_min=%lu write=%llu oldest=%llu age_ms=%lu misses=%lu main_apply=0",
                     esp_err_to_name(snapshot_result),
                     (unsigned long)capture_sequence,
                     (unsigned long)generation,
                     (unsigned long long)source_end_index,
                     (long long)phase_error,
                     (unsigned long)effective_min_delay,
                     (unsigned long long)span.write_index_snapshot,
                     (unsigned long long)span.oldest_index_snapshot,
                     (unsigned long)span.last_write_age_ms,
                     (unsigned long)ctx->aec_delay_shadow_snapshot_misses);
        }
        return;
    }
    ctx->aec_delay_shadow_snapshots++;

    nuwax_aec_delay_shadow_result_t estimate = {0};
    const int64_t dsp_started_us = esp_timer_get_time();
    const nuwax_aec_delay_shadow_status_t status =
        nuwax_aec_delay_shadow_process(shadow,
                                       mic,
                                       sample_count,
                                       ctx->aec_delay_shadow_history,
                                       ctx->aec_delay_shadow_history_capacity,
                                       generation,
                                       &estimate);
    const uint32_t dsp_us = (uint32_t)(esp_timer_get_time() - dsp_started_us);
    if (status != NUWAX_AEC_DELAY_SHADOW_OK || !estimate.estimate_ready) {
        return;
    }
    ctx->aec_delay_shadow_results++;
    if (estimate.accepted) {
        ctx->aec_delay_shadow_accepted++;
    }
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    if (estimate.accepted && dynamic_apply_allowed &&
        ctx->fir_ref_delay_requests &&
        estimate.stable_delay_samples != NUWAX_AEC_DELAY_SHADOW_INVALID_DELAY) {
        nuwax_aec_fir_delay_request_t request = {0};
        if (nuwax_aec_fir_delay_plan(
                &ctx->fir_ref_delay_control,
                estimate.stable_delay_samples,
                (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_FIR_SEED_TAP,
                0U,
                shadow->config.max_delay_samples,
                generation,
                anchor_events,
                capture_sequence,
                aec_delay_shadow_q15(estimate.overall_confidence),
                &request)) {
            if (xQueueOverwrite(ctx->fir_ref_delay_requests, &request) == pdPASS) {
                ctx->fir_ref_delay_requests_published++;
    NUWAX_RT_DIAG_LOGI(TAG,
             "AEC_FIR_DELAY request decision_seq=%lu generation=%lu anchor=%llu acoustic=%lu target_tap=%lu target=%lu revision=%lu confidence_q15=%lu main_delay=%lu",
                         (unsigned long)capture_sequence,
                         (unsigned long)generation,
                         (unsigned long long)anchor_events,
                         (unsigned long)request.acoustic_delay_samples,
                         (unsigned long)request.target_tap,
                         (unsigned long)request.target_delay_samples,
                         (unsigned long)request.revision,
                         (unsigned long)request.confidence_q15,
                         (unsigned long)ctx->software_ref_delay_samples);
            } else {
        NUWAX_RT_DIAG_LOGW(TAG,
                 "AEC_FIR_DELAY request queue full generation=%lu revision=%lu",
                         (unsigned long)generation,
                         (unsigned long)request.revision);
            }
        }
    }
#else
    (void)dynamic_apply_allowed;
#endif
    const bool accepted_changed =
        estimate.accepted != ctx->aec_delay_shadow_last_accepted;
    ctx->aec_delay_shadow_last_accepted = estimate.accepted;
    const bool log_due =
        ctx->aec_delay_shadow_results == 1U || accepted_changed ||
        (ctx->aec_delay_shadow_results %
         NUWAX_AEC_DELAY_SHADOW_LOG_INTERVAL_SAMPLES) == 0U;
    if (log_due) {
        const float residual = 1.0f -
                               estimate.best_abs_correlation *
                                   estimate.best_abs_correlation;
        const float projection_erle_db =
            residual > 0.000001f ? -10.0f * log10f(residual) : 60.0f;
    NUWAX_RT_DIAG_LOGI(TAG,
             "AEC_ALIGN_SHADOW result accepted=%d seq=%lu generation=%lu anchor=%llu source_end=%llu phase=%lld effective_min=%lu best=%lu corr_q15=%lu second=%lu second_q15=%lu margin_q15=%lu stable=%lu updates=%lu stability_q15=%lu confidence_q15=%lu projection_erle_x100=%ld candidates=%lu pairs=%u copy_us=%lu dsp_us=%lu main_apply=0",
                 estimate.accepted ? 1 : 0,
                 (unsigned long)capture_sequence,
                 (unsigned long)generation,
                 (unsigned long long)anchor_events,
                 (unsigned long long)source_end_index,
                 (long long)phase_error,
                 (unsigned long)effective_min_delay,
                 (unsigned long)estimate.best_delay_samples,
                 (unsigned long)aec_delay_shadow_q15(estimate.best_abs_correlation),
                 (unsigned long)estimate.second_delay_samples,
                 (unsigned long)aec_delay_shadow_q15(estimate.second_abs_correlation),
                 (unsigned long)aec_delay_shadow_q15(estimate.peak_margin),
                 (unsigned long)estimate.stable_delay_samples,
                 (unsigned long)estimate.stability_updates,
                 (unsigned long)aec_delay_shadow_q15(estimate.stability_confidence),
                 (unsigned long)aec_delay_shadow_q15(estimate.overall_confidence),
                 (long)(projection_erle_db * 100.0f + 0.5f),
                 (unsigned long)estimate.evaluated_candidates,
                 (unsigned)estimate.sample_pairs,
                 (unsigned long)copy_us,
                 (unsigned long)dsp_us);
    }
}
#endif

static nuwax_dual_mic_features_t compute_dual_mic_features(const int16_t *mic1,
                                                           const int16_t *mic2,
                                                           size_t sample_count,
                                                           nuwax_mic_level_t mic1_level,
                                                           nuwax_mic_level_t mic2_level) {
    nuwax_dual_mic_features_t features = {0};
    if (!mic1 || !mic2 || sample_count == 0) {
        return features;
    }

    uint64_t sum_abs_diff = 0;
    uint64_t sumsq_mic1 = 0;
    uint64_t sumsq_mic2 = 0;
    uint64_t sumsq_diff = 0;
    uint32_t diff_peak = 0;
    for (size_t i = 0; i < sample_count; i++) {
        const int32_t a = mic1[i];
        const int32_t b = mic2[i];
        const int32_t diff = a - b;
        const uint32_t abs_diff = abs_i32_to_u32(diff);
        sum_abs_diff += abs_diff;
        sumsq_mic1 += (uint64_t)((int64_t)a * (int64_t)a);
        sumsq_mic2 += (uint64_t)((int64_t)b * (int64_t)b);
        sumsq_diff += (uint64_t)((int64_t)diff * (int64_t)diff);
        if (abs_diff > diff_peak) {
            diff_peak = abs_diff;
        }
    }

    const uint32_t max_avg = mic1_level.avg_abs > mic2_level.avg_abs ? mic1_level.avg_abs : mic2_level.avg_abs;
    const uint32_t min_avg = mic1_level.avg_abs > mic2_level.avg_abs ? mic2_level.avg_abs : mic1_level.avg_abs;
    const uint64_t max_sumsq = sumsq_mic1 > sumsq_mic2 ? sumsq_mic1 : sumsq_mic2;

    features.valid = true;
    features.diff_avg_abs = (uint32_t)(sum_abs_diff / sample_count);
    features.diff_peak = diff_peak;
    features.diff_energy_ratio_q15 = clamp_q15_from_ratio_u64(sumsq_diff, max_sumsq);
    features.level_balance_q15 = max_avg > 0 ? (uint32_t)(((uint64_t)min_avg * 32768ULL) / max_avg) : 0;

    const bool enough_mic_energy =
        mic1_level.avg_abs >= NUWAX_DUAL_MIC_NEAREND_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_DUAL_MIC_NEAREND_MIN_MIC1_PEAK &&
        mic2_level.avg_abs >= NUWAX_DUAL_MIC_NEAREND_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_DUAL_MIC_NEAREND_MIN_MIC2_PEAK;
    const bool enough_difference =
        features.diff_avg_abs >= NUWAX_DUAL_MIC_NEAREND_MIN_DIFF_AVG_ABS &&
        features.diff_peak >= NUWAX_DUAL_MIC_NEAREND_MIN_DIFF_PEAK;
    const bool imbalanced_near_field =
        features.level_balance_q15 <= NUWAX_DUAL_MIC_NEAREND_IMBALANCE_BALANCE_Q15 &&
        features.diff_energy_ratio_q15 >= NUWAX_DUAL_MIC_NEAREND_IMBALANCE_DIFF_ENERGY_Q15;
    const bool strong_difference =
        features.diff_energy_ratio_q15 >= NUWAX_DUAL_MIC_NEAREND_STRONG_DIFF_ENERGY_Q15;
    features.voice_like = enough_mic_energy && enough_difference &&
                          (imbalanced_near_field || strong_difference);
    return features;
}

static bool dual_mic_playback_nearend_candidate(nuwax_dual_mic_features_t dual,
                                                nuwax_mic_level_t out_level,
                                                const nuwax_audio_cleaner_result_t *clean_result) {
    if (!dual.valid || !dual.voice_like) {
        return false;
    }
    if (out_level.avg_abs < NUWAX_DUAL_MIC_NEAREND_MIN_OUT_AVG_ABS ||
        out_level.peak < NUWAX_DUAL_MIC_NEAREND_MIN_OUT_PEAK) {
        return false;
    }
    if (clean_result && (clean_result->zeroed_quiet || clean_result->playback_quiet)) {
        return false;
    }
    return true;
}

static bool dual_mic_aec_preserve_hint(nuwax_dual_mic_features_t dual,
                                       nuwax_mic_level_t mic1_level,
                                       nuwax_mic_level_t mic2_level) {
    if (!dual.valid) {
        return false;
    }
    const bool enough_energy =
        mic1_level.avg_abs >= NUWAX_DUAL_MIC_AEC_HINT_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_DUAL_MIC_AEC_HINT_MIN_MIC1_PEAK &&
        mic2_level.avg_abs >= NUWAX_DUAL_MIC_AEC_HINT_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_DUAL_MIC_AEC_HINT_MIN_MIC2_PEAK;
    const bool enough_difference =
        dual.diff_avg_abs >= NUWAX_DUAL_MIC_AEC_HINT_MIN_DIFF_AVG_ABS &&
        dual.diff_peak >= NUWAX_DUAL_MIC_AEC_HINT_MIN_DIFF_PEAK;
    const bool spatial_nearend =
        dual.level_balance_q15 <= NUWAX_DUAL_MIC_AEC_HINT_MAX_BALANCE_Q15 ||
        dual.diff_energy_ratio_q15 >= NUWAX_DUAL_MIC_AEC_HINT_MIN_DIFF_ENERGY_Q15;
    return enough_energy && enough_difference && spatial_nearend;
}

static bool dual_mic_cleaner_preserve_hint(nuwax_dual_mic_features_t dual,
                                           nuwax_mic_level_t mic1_level,
                                           nuwax_mic_level_t mic2_level) {
    if (!dual.valid) {
        return false;
    }
    const bool enough_energy =
        mic1_level.avg_abs >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_MIC1_PEAK &&
        mic2_level.avg_abs >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_MIC2_PEAK;
    const bool enough_difference =
        dual.diff_avg_abs >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_DIFF_AVG_ABS &&
        dual.diff_peak >= NUWAX_DUAL_MIC_CLEANER_HINT_MIN_DIFF_PEAK;
    const bool near_field_imbalance =
        dual.level_balance_q15 > 0 &&
        dual.level_balance_q15 <= NUWAX_DUAL_MIC_CLEANER_HINT_MAX_BALANCE_Q15;
    return enough_energy && enough_difference && near_field_imbalance;
}

static bool dual_mic_playback_raw_human_hint(nuwax_dual_mic_features_t dual,
                                             nuwax_mic_level_t mic1_level,
                                             nuwax_mic_level_t mic2_level) {
    if (!dual.valid) {
        return false;
    }
    const bool mic1_voice_energy =
        mic1_level.avg_abs >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_MIC1_PEAK;
    const bool mic1_strong_voice_energy =
        mic1_level.avg_abs >= NUWAX_PLAYBACK_RAW_HUMAN_STRONG_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_PLAYBACK_RAW_HUMAN_STRONG_MIC1_PEAK;
    const bool mic2_observes_voice =
        mic2_level.avg_abs >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_MIC2_PEAK;
    const bool enough_difference =
        dual.diff_avg_abs >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_DIFF_AVG_ABS &&
        dual.diff_peak >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_DIFF_PEAK;
    const bool spatial_difference =
        dual.diff_energy_ratio_q15 >= NUWAX_PLAYBACK_RAW_HUMAN_MIN_DIFF_ENERGY_Q15 &&
        (dual.level_balance_q15 <= NUWAX_PLAYBACK_RAW_HUMAN_MAX_BALANCE_Q15 ||
         dual.diff_avg_abs >= (NUWAX_PLAYBACK_RAW_HUMAN_MIN_DIFF_AVG_ABS * 2U));
    return mic2_observes_voice &&
           enough_difference &&
           spatial_difference &&
           (mic1_voice_energy || mic1_strong_voice_energy);
}

static bool dual_mic_playback_weak_continuity_hint(nuwax_dual_mic_features_t dual,
                                                   nuwax_mic_level_t mic1_level,
                                                   nuwax_mic_level_t mic2_level) {
    if (!dual.valid) {
        return false;
    }
    const bool mic1_possible_voice =
        mic1_level.avg_abs >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_MIC1_PEAK;
    const bool mic2_possible_voice =
        mic2_level.avg_abs >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_MIC2_PEAK;
    const bool enough_difference =
        dual.diff_avg_abs >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_DIFF_AVG_ABS &&
        dual.diff_peak >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_DIFF_PEAK;
    const bool differential_energy =
        dual.diff_energy_ratio_q15 >= NUWAX_PLAYBACK_WEAK_CONTINUITY_MIN_DIFF_ENERGY_Q15;
    return mic1_possible_voice &&
           mic2_possible_voice &&
           (enough_difference || differential_energy);
}

static bool dual_mic_playback_echo_atten_guard(nuwax_dual_mic_features_t dual,
                                               nuwax_mic_level_t mic1_level,
                                               nuwax_mic_level_t mic2_level) {
    if (!dual.valid) {
        return false;
    }
    const bool possible_voice_energy =
        mic1_level.avg_abs >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_MIC1_AVG_ABS &&
        mic1_level.peak >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_MIC1_PEAK &&
        mic2_level.avg_abs >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_MIC2_AVG_ABS &&
        mic2_level.peak >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_MIC2_PEAK;
    const bool possible_spatial_onset =
        dual.diff_avg_abs >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_DIFF_AVG_ABS ||
        dual.diff_peak >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_DIFF_PEAK ||
        dual.diff_energy_ratio_q15 >= NUWAX_PLAYBACK_ECHO_ATTEN_GUARD_MIN_DIFF_ENERGY_Q15;
    return possible_voice_energy && possible_spatial_onset;
}

static void playback_gate_score_update(uint32_t *score_frames,
                                       bool aec_candidate,
                                       bool dual_candidate) {
    if (!score_frames) {
        return;
    }
    if (aec_candidate) {
        *score_frames += NUWAX_PLAYBACK_GATE_SCORE_PER_AEC_CANDIDATE;
    } else if (dual_candidate) {
        *score_frames += NUWAX_PLAYBACK_GATE_SCORE_PER_DUAL_CANDIDATE;
    } else if (*score_frames > NUWAX_PLAYBACK_GATE_SCORE_DECAY_PER_FRAME) {
        *score_frames -= NUWAX_PLAYBACK_GATE_SCORE_DECAY_PER_FRAME;
    } else {
        *score_frames = 0;
    }
    if (*score_frames > NUWAX_PLAYBACK_GATE_SCORE_MAX_FRAMES) {
        *score_frames = NUWAX_PLAYBACK_GATE_SCORE_MAX_FRAMES;
    }
}

static bool during_playback_nearend_candidate(const nuwax_live_aec_t *aec,
                                              nuwax_mic_level_t raw_level,
                                              nuwax_mic_level_t out_level,
                                              const nuwax_audio_cleaner_result_t *clean_result,
                                              bool frame_aec_processed,
                                              bool frame_ref_missing,
                                              bool *out_ref_healthy) {
    bool ref_healthy = false;
    if (aec && aec->enabled && aec->initialized && frame_aec_processed && !frame_ref_missing) {
        ref_healthy = aec->last_ref_avg_abs >= NUWAX_DURING_PLAYBACK_REF_MIN_AVG_ABS ||
                      aec->last_ref_peak >= NUWAX_DURING_PLAYBACK_REF_MIN_PEAK;
    }
    if (out_ref_healthy) {
        *out_ref_healthy = ref_healthy;
    }
    if (!ref_healthy) {
        return false;
    }
    if (!nuwax_mic_level_is_speech(out_level)) {
        return false;
    }
    if (clean_result && (clean_result->zeroed_quiet || clean_result->playback_quiet)) {
        return false;
    }

    const bool normal_energy =
        out_level.avg_abs >= NUWAX_DURING_PLAYBACK_NEAREND_MIN_AVG_ABS &&
        out_level.peak >= NUWAX_DURING_PLAYBACK_NEAREND_MIN_PEAK;
    const bool strong_energy =
        out_level.avg_abs >= NUWAX_DURING_PLAYBACK_NEAREND_STRONG_AVG_ABS &&
        out_level.peak >= NUWAX_DURING_PLAYBACK_NEAREND_STRONG_PEAK;
    if (!normal_energy) {
        return false;
    }

    const bool normal_ratio =
        level_ratio_at_least_q15(out_level,
                                 raw_level,
                                 NUWAX_DURING_PLAYBACK_NEAREND_MIN_RATIO_Q15);
    const bool strong_ratio =
        level_ratio_at_least_q15(out_level,
                                 raw_level,
                                 NUWAX_DURING_PLAYBACK_NEAREND_STRONG_RATIO_Q15);
    if (!strong_energy && !normal_ratio) {
        return false;
    }
    if (strong_energy && !strong_ratio) {
        const uint32_t corr_q15 = aec
                                      ? max3_u32(aec->last_mic_ref_corr_q15,
                                                 aec->last_residual_corr_q15,
                                                 aec->last_post_blend_residual_corr_q15)
                                      : 0;
        if (corr_q15 >= NUWAX_DURING_PLAYBACK_NEAREND_HIGH_CORR_Q15) {
            return false;
        }
    }

    return true;
}

static uint32_t auto_followup_preroll_sequence_at(void *ctx, uint32_t chronological_offset) {
    const uint32_t oldest = *(const uint32_t *)ctx;
    const uint32_t index =
        (oldest + chronological_offset) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    return s_auto_followup_preroll[index].sequence;
}

static esp_err_t validate_auto_followup_preroll_for_upload(
    uint32_t preroll_write,
    uint32_t preroll_count,
    bool targeted_barge_in,
    uint32_t onset_sequence,
    uint32_t confirmed_sequence,
    uint32_t live_sequence) {
    if (!s_auto_followup_preroll ||
        preroll_count > NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES) {
        return ESP_ERR_INVALID_STATE;
    }
    uint32_t oldest =
        (preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES - preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    uint32_t chronological_start = 0U;
    uint32_t validate_count = preroll_count;
    const bool wake_word_window =
        nuwax_prelisten_state_mode_is(&s_prelisten, "wake_word");
    const bool select_onset_window = targeted_barge_in || !wake_word_window;
    if (select_onset_window) {
        nuwax_preroll_window_t window = {0};
        if (!nuwax_preroll_select_targeted_window(
                preroll_count,
                onset_sequence,
                live_sequence,
                NUWAX_BARGE_IN_PREROLL_LEAD_FRAMES,
                NUWAX_BARGE_IN_PREROLL_FALLBACK_FRAMES,
                auto_followup_preroll_sequence_at,
                &oldest,
                &window)) {
            return ESP_ERR_NOT_FOUND;
        }
        if (!window.onset_found || !window.onset_included) {
            return ESP_ERR_NOT_FOUND;
        }
        chronological_start = window.start_offset;
        validate_count = window.frame_count;
    } else if (wake_word_window &&
               validate_count > NUWAX_WAKE_WORD_PREROLL_FRAMES) {
        validate_count = NUWAX_WAKE_WORD_PREROLL_FRAMES;
        chronological_start = preroll_count - validate_count;
    }

    const uint32_t start =
        (oldest + chronological_start) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    uint32_t previous_sequence = 0U;
    bool previous_valid = false;
    bool onset_preserved = !targeted_barge_in;
    bool confirmed_span_seen = !targeted_barge_in;
    bool checking_confirmed_span = false;
    for (uint32_t i = 0; i < validate_count; i++) {
        const nuwax_auto_followup_preroll_frame_t *frame =
            &s_auto_followup_preroll[
                (start + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES];
        if (frame->sample_count == 0 ||
            frame->sample_count > NUWAX_CAPTURE_FRAME_SAMPLES ||
            frame->sample_count > CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME ||
            (previous_valid && frame->sequence != previous_sequence + 1U)) {
            return ESP_ERR_INVALID_STATE;
        }
        if (frame->forced_silence) {
            if (frame->speech || frame->human_repaired ||
                !frame->barge_silenced) {
                return ESP_ERR_INVALID_STATE;
            }
            for (size_t sample = 0; sample < frame->sample_count; sample++) {
                if (frame->samples[sample] != 0) {
                    return ESP_ERR_INVALID_STATE;
                }
            }
        }
        if (targeted_barge_in && frame->sequence == onset_sequence) {
            checking_confirmed_span = true;
            if (frame->barge_silenced || frame->forced_silence ||
                !frame->speech) {
                return ESP_ERR_INVALID_STATE;
            }
            onset_preserved = true;
        }
        if (!nuwax_preroll_targeted_frame_preserves_confirmation(
                checking_confirmed_span,
                frame->barge_silenced,
                frame->forced_silence)) {
            return ESP_ERR_INVALID_STATE;
        }
        if (checking_confirmed_span &&
            frame->sequence == confirmed_sequence) {
            confirmed_span_seen = true;
            checking_confirmed_span = false;
        }
        previous_sequence = frame->sequence;
        previous_valid = true;
    }
    return onset_preserved && confirmed_span_seen
               ? ESP_OK
               : ESP_ERR_NOT_FOUND;
}

static esp_err_t send_auto_followup_preroll(nuwax_audio_uplink_t *send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                            nuwax_opus_encoder_t *opus_encoder,
#endif
                                            uint32_t preroll_write,
                                            uint32_t preroll_count,
                                            bool targeted_barge_in,
                                            uint32_t onset_sequence,
                                            uint32_t live_sequence,
                                            uint32_t *recorded_frames,
                                            size_t *recorded_samples,
                                            uint32_t *queued_frames,
                                            uint32_t *dropped_frames,
                                            uint32_t *sent_preroll_frames) {
    if (!s_auto_followup_preroll) {
        return ESP_ERR_INVALID_STATE;
    }

    uint32_t oldest =
        (preroll_write + NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES - preroll_count) %
        NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    uint32_t chronological_start = 0;
    uint32_t preroll_send_count = preroll_count;
    const bool wake_word_window =
        nuwax_prelisten_state_mode_is(&s_prelisten, "wake_word");
    const bool select_onset_window = targeted_barge_in || !wake_word_window;
    if (select_onset_window) {
        nuwax_preroll_window_t window = {0};
        if (nuwax_preroll_select_targeted_window(preroll_count,
                                                  onset_sequence,
                                                  live_sequence,
                                                  NUWAX_BARGE_IN_PREROLL_LEAD_FRAMES,
                                                  NUWAX_BARGE_IN_PREROLL_FALLBACK_FRAMES,
                                                  auto_followup_preroll_sequence_at,
                                                  &oldest,
                                                  &window)) {
            chronological_start = window.start_offset;
            preroll_send_count = window.frame_count;
    NUWAX_RT_DIAG_LOGI(TAG,
             "onset-targeted preroll mode=%s first_seq=%lu last_seq=%lu live_seq=%lu frames=%lu onset_seq=%lu onset_found=%d onset_included=%d lead_trimmed=%d lead_frames=%u missing_or_post_onset_gap=reject",
                     targeted_barge_in ? "barge_in" : "followup",
                     (unsigned long)window.first_sequence,
                     (unsigned long)window.last_sequence,
                     (unsigned long)live_sequence,
                     (unsigned long)window.frame_count,
                     (unsigned long)onset_sequence,
                     window.onset_found ? 1 : 0,
                     window.onset_included ? 1 : 0,
                     window.gap_trimmed ? 1 : 0,
                     (unsigned)NUWAX_BARGE_IN_PREROLL_LEAD_FRAMES);
        } else {
            ESP_LOGW(TAG,
                     "onset-targeted preroll rejected mode=%s buffered=%lu onset_seq=%lu live_seq=%lu reason=onset_missing_or_post_onset_gap",
                     targeted_barge_in ? "barge_in" : "followup",
                     (unsigned long)preroll_count,
                     (unsigned long)onset_sequence,
                     (unsigned long)live_sequence);
            /* Validation and sending must have the same admission rule. A
             * missing onset is never converted into a valid upload with an
             * empty prefix, otherwise the first syllable would be silently
             * discarded after a race or a future call-site omission. */
            return ESP_ERR_NOT_FOUND;
        }
    } else if (wake_word_window &&
               preroll_send_count > NUWAX_WAKE_WORD_PREROLL_FRAMES) {
        preroll_send_count = NUWAX_WAKE_WORD_PREROLL_FRAMES;
        chronological_start = preroll_count - preroll_send_count;
    }
    const uint32_t start =
        (oldest + chronological_start) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
    if (sent_preroll_frames) {
        *sent_preroll_frames = 0U;
    }
    for (uint32_t i = 0; i < preroll_send_count; i++) {
        const uint32_t idx = (start + i) % NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES;
        const nuwax_auto_followup_preroll_frame_t *frame = &s_auto_followup_preroll[idx];
        if (frame->sample_count == 0 ||
            frame->sample_count > CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME) {
            return ESP_ERR_INVALID_SIZE;
        }
        uint8_t preroll_flags = frame->speech ? NUWAX_AUDIO_FLAG_VAD_SPEECH : 0;
        if (*recorded_frames == 0) {
            preroll_flags |= NUWAX_AUDIO_FLAG_START;
        }
        const uint32_t wire_sequence = *recorded_frames;
        esp_err_t result = enqueue_mic_uplink_frame(send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                                    opus_encoder,
#endif
                                                    frame->samples,
                                                    frame->sample_count,
                                                    wire_sequence,
                                                    preroll_flags,
                                                    false,
                                                    queued_frames,
                                                    dropped_frames);
        if (!nuwax_audio_uplink_enqueue_frame_accepted(result)) {
            return result;
        }
        *recorded_samples += frame->sample_count;
        (*recorded_frames)++;
        if (sent_preroll_frames) {
            *sent_preroll_frames = i + 1U;
        }
        if (nuwax_audio_uplink_is_recoverable_backpressure(result)) {
            return result;
        }
    }
    return ESP_OK;
}

typedef enum {
    NUWAX_MIC_CAPTURE_STOP_NONE = 0,
    NUWAX_MIC_CAPTURE_STOP_RELEASE,
    NUWAX_MIC_CAPTURE_STOP_MAX_DURATION,
    NUWAX_MIC_CAPTURE_STOP_VAD_ENDPOINT,
    NUWAX_MIC_CAPTURE_STOP_VAD_NO_SPEECH,
    NUWAX_MIC_CAPTURE_STOP_AWAKE_TIMEOUT,
    NUWAX_MIC_CAPTURE_STOP_REPROVISION,
    NUWAX_MIC_CAPTURE_STOP_EXCLUSIVE_PREEMPT,
    NUWAX_MIC_CAPTURE_STOP_NOTIFICATION_TAKEOVER,
    NUWAX_MIC_CAPTURE_STOP_CLOUD_TURN_ACCEPTED,
    NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT,
    NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND,
    NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF,
    NUWAX_MIC_CAPTURE_STOP_ACCEPTANCE_COMPLETE,
    NUWAX_MIC_CAPTURE_STOP_CLOUD_TIMEOUT,
    NUWAX_MIC_CAPTURE_STOP_WS_ERROR,
    NUWAX_MIC_CAPTURE_STOP_MIC_ERROR,
    NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR,
    NUWAX_MIC_CAPTURE_STOP_UPLINK_BACKPRESSURE,
    NUWAX_MIC_CAPTURE_STOP_CAPTURE_SEQUENCE_GAP,
    NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR,
} nuwax_mic_capture_stop_reason_t;

static const char *mic_capture_stop_reason_name(
    nuwax_mic_capture_stop_reason_t reason) {
    switch (reason) {
        case NUWAX_MIC_CAPTURE_STOP_RELEASE:
            return "release";
        case NUWAX_MIC_CAPTURE_STOP_MAX_DURATION:
            return "max_duration";
        case NUWAX_MIC_CAPTURE_STOP_VAD_ENDPOINT:
            return "vad_endpoint";
        case NUWAX_MIC_CAPTURE_STOP_VAD_NO_SPEECH:
            return "vad_no_speech";
        case NUWAX_MIC_CAPTURE_STOP_AWAKE_TIMEOUT:
            return "awake_timeout";
        case NUWAX_MIC_CAPTURE_STOP_REPROVISION:
            return "reprovision";
        case NUWAX_MIC_CAPTURE_STOP_EXCLUSIVE_PREEMPT:
            return "exclusive_preempt";
        case NUWAX_MIC_CAPTURE_STOP_NOTIFICATION_TAKEOVER:
            return "notification_takeover";
        case NUWAX_MIC_CAPTURE_STOP_CLOUD_TURN_ACCEPTED:
            return "cloud_turn_accepted";
        case NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT:
            return "head_touch_agent";
        case NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND:
            return "session_command";
        case NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF:
            return "playback_handoff";
        case NUWAX_MIC_CAPTURE_STOP_ACCEPTANCE_COMPLETE:
            return "acceptance_complete";
        case NUWAX_MIC_CAPTURE_STOP_CLOUD_TIMEOUT:
            return "cloud_timeout";
        case NUWAX_MIC_CAPTURE_STOP_WS_ERROR:
            return "ws_error";
        case NUWAX_MIC_CAPTURE_STOP_MIC_ERROR:
            return "mic_error";
        case NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR:
            return "uplink_error";
        case NUWAX_MIC_CAPTURE_STOP_UPLINK_BACKPRESSURE:
            return "uplink_backpressure";
        case NUWAX_MIC_CAPTURE_STOP_CAPTURE_SEQUENCE_GAP:
            return "capture_sequence_gap";
        case NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR:
            return "processing_error";
        case NUWAX_MIC_CAPTURE_STOP_NONE:
        default:
            return "none";
    }
}

static void mic_capture_set_stop_reason(
    nuwax_mic_capture_stop_reason_t *current,
    nuwax_mic_capture_stop_reason_t reason) {
    if (current && *current == NUWAX_MIC_CAPTURE_STOP_NONE &&
        reason != NUWAX_MIC_CAPTURE_STOP_NONE) {
        *current = reason;
    }
}

static bool persistent_normal_conversation_capture(bool auto_followup_mode,
                                                   bool during_playback_mode) {
    return auto_followup_mode &&
           !during_playback_mode &&
           nuwax_awake_session_state_is_active(&s_awake_session);
}

static bool head_touch_agent_consume_capture_frame(
    nuwax_ws_client_t *ws,
    bool listen_started,
    bool upload_started,
    const char *conversation_audio_session_id,
    const char *barge_audio_session_id,
    bool user_speech_confirmed,
    bool user_speech_candidate) {
    if (s_head_touch_agent_intent.state !=
        NUWAX_HEAD_TOUCH_AGENT_STATE_ARBITRATING) {
        return false;
    }
    const uint32_t active_epoch = active_ws_epoch_snapshot();
    const uint32_t awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (!nuwax_head_touch_agent_intent_owner_matches(
            &s_head_touch_agent_intent,
            active_epoch,
            awake_generation)) {
        clear_head_touch_agent_intent(
            "capture_frame_owner_boundary_changed");
        return false;
    }
    if (s_head_touch_agent_intent.source ==
            NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING &&
        s_turn_guard.active) {
        clear_head_touch_agent_intent("user_turn_won_during_capture");
        return false;
    }

    const bool shake_listening_bypasses_chat_guard =
        s_head_touch_agent_intent.interaction ==
            NUWAX_AGENT_INTERACTION_SHAKE &&
        s_head_touch_agent_intent.source ==
            NUWAX_HEAD_TOUCH_AGENT_SOURCE_LISTENING;
    /* A shake is an explicit physical interrupt.  In the normal LISTENING
     * source it intentionally does not wait for VAD confirmation or a quiet
     * window: the next frame ends the current listen transaction so the shake
     * request can be submitted promptly.  All ownership/epoch checks above
     * remain active; touch keeps the speech-protection policy below. */
    const nuwax_head_touch_agent_frame_action_t action =
        shake_listening_bypasses_chat_guard
            ? (nuwax_head_touch_agent_intent_begin_quiesce(
                   &s_head_touch_agent_intent)
                   ? NUWAX_HEAD_TOUCH_AGENT_FRAME_BEGIN_QUIESCE
                   : NUWAX_HEAD_TOUCH_AGENT_FRAME_WAIT)
            : nuwax_head_touch_agent_intent_observe_frame(
                  &s_head_touch_agent_intent,
                  monotonic_ms(),
                  user_speech_confirmed,
                  user_speech_candidate);
    if (shake_listening_bypasses_chat_guard) {
        ESP_LOGI(TAG,
                 "shake agent bypassing listening speech guard token=%lu confirmed=%d candidate=%d",
                 (unsigned long)s_head_touch_agent_intent.token,
                 user_speech_confirmed ? 1 : 0,
                 user_speech_candidate ? 1 : 0);
    }
    if (action == NUWAX_HEAD_TOUCH_AGENT_FRAME_USER_WON) {
        ESP_LOGI(TAG,
                 "head touch agent yielded to user speech token=%lu source=%s",
                 (unsigned long)s_head_touch_agent_intent.token,
                 nuwax_head_touch_agent_source_name(
                     s_head_touch_agent_intent.source));
        clear_head_touch_agent_intent("user_speech_won");
        return false;
    }
    if (action != NUWAX_HEAD_TOUCH_AGENT_FRAME_BEGIN_QUIESCE) {
        return false;
    }

    const char *bound_audio_session_id = NULL;
    if (upload_started || listen_started) {
        bound_audio_session_id =
            barge_audio_session_id && barge_audio_session_id[0]
                ? barge_audio_session_id
                : conversation_audio_session_id;
    }
    const bool terminal_required =
        listen_started && upload_started && bound_audio_session_id &&
        bound_audio_session_id[0] != '\0';
    if (!nuwax_head_touch_agent_intent_bind_capture_transaction(
            &s_head_touch_agent_intent,
            bound_audio_session_id,
            terminal_required)) {
        ESP_LOGE(TAG,
                 "head touch agent capture binding failed token=%lu session=%s listen_started=%d upload_started=%d",
                 (unsigned long)s_head_touch_agent_intent.token,
                 bound_audio_session_id ? bound_audio_session_id : "-",
                 listen_started ? 1 : 0,
                 upload_started ? 1 : 0);
        clear_head_touch_agent_intent("capture_binding_failed");
        return false;
    }
    ESP_LOGI(TAG,
             "head touch agent won quiet arbitration token=%lu source=%s session=%s terminal=%d",
             (unsigned long)s_head_touch_agent_intent.token,
             nuwax_head_touch_agent_source_name(
                 s_head_touch_agent_intent.source),
             bound_audio_session_id ? bound_audio_session_id : "-",
             terminal_required ? 1 : 0);
    if (s_head_touch_agent_intent.interaction ==
        NUWAX_AGENT_INTERACTION_SHAKE) {
        nuwax_state_bridge_trigger_shake();
    }
    return begin_head_touch_agent_quiesce(ws);
}

static esp_err_t stream_microphone_audio(nuwax_ws_client_t *ws) {
    typedef struct {
        nuwax_audio_cleaner_t audio_cleaner;
        nuwax_live_aec_t live_aec;
        nuwax_barge_controller_t barge_controller;
        nuwax_conversation_audio_health_t barge_audio_health;
        nuwax_rt_capture_ctx_t capture_ctx;
    } capture_owner_work_t;
    /* Main-owner-only, just like s_audio_samples; retained across sessions so
     * repeated listening never fragments the internal heap. Capture workers
     * are joined during cleanup before the next call can reset this memory. */
    static capture_owner_work_t *work;
    if (!work) {
        work = heap_caps_calloc(1, sizeof(*work),
                               MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
        if (work) ESP_LOGI(TAG, "capture owner work allocated heap=psram bytes=%u",
                          (unsigned)sizeof(*work));
    }
    if (!work) return ESP_ERR_NO_MEM;
    memset(work, 0, sizeof(*work));

    const size_t samples_per_frame = nuwax_audio_uplink_samples_per_frame();
    const size_t default_max_record_samples =
        ((size_t)CONFIG_NUWAX_VOICE_SAMPLE_RATE * CONFIG_NUWAX_VOICE_MIC_MAX_RECORD_MS) / 1000;
    size_t max_record_samples = default_max_record_samples;
    uint32_t max_record_ms = (uint32_t)CONFIG_NUWAX_VOICE_MIC_MAX_RECORD_MS;
    nuwax_mic_input_t mic = {0};
    uint32_t consecutive_timeouts = 0;
    uint32_t total_timeouts = 0;
    esp_err_t result = ESP_OK;
    bool listen_started = false;
    bool upload_started = false;
    bool auto_followup_mode = false;
    bool during_playback_mode = false;
    bool persistent_conversation_mode = false;
    bool handoff_old_session_closing = false;
    char handoff_old_listen_mode[NUWAX_PRELISTEN_MODE_MAX_LEN] = {0};
    char handoff_old_audio_session_id[48] = {0};
    seamless_listen_stop_t handoff_listen_stop = {0};
    int64_t handoff_requested_us = 0;
    nuwax_capture_phase_handoff_t capture_phase_handoff = {0};
    bool persistent_awake_timeout = false;
    bool acceptance_capture_enabled = false;
    bool acceptance_capture_playback_seen = false;
    bool acceptance_capture_stop_logged = false;
    bool auto_followup_sleep_after_no_speech = false;
    bool stop_requested = false;
    bool max_duration_reached = false;
    nuwax_mic_capture_stop_reason_t stop_reason =
        NUWAX_MIC_CAPTURE_STOP_NONE;
    bool uplink_finish_attempted = false;
    bool uplink_finish_succeeded = false;
    bool uplink_end_committed = false;
    bool listen_stop_succeeded = false;
    bool local_power_uplink_preempted = false;
    esp_err_t uplink_finish_result = ESP_ERR_INVALID_STATE;
    size_t recorded_samples = 0;
    uint32_t recorded_frames = 0;
    uint32_t captured_frames = 0;
    int64_t confirmed_speech_us = 0;
    int64_t last_confirmed_speech_us = 0;
    uint32_t continuous_utterance_limit_ms =
        NUWAX_CONVERSATION_UTTERANCE_SOFT_LIMIT_MS;
    uint32_t sent_frames = 0;
    uint32_t queued_frames = 0;
    uint32_t dropped_frames = 0;
    bool uplink_backpressure_boundary = false;
    uint32_t vad_speech_frames = 0;
    uint32_t vad_silence_frames = 0;
#if CONFIG_NUWAX_VOICE_LOCAL_VAD_ENDPOINT_ENABLE
    nuwax_conversation_weak_continuation_t weak_continuation = {0};
    uint32_t weak_continuation_evidence_frames = 0U;
    uint32_t weak_continuation_confirmed_frames = 0U;
    uint32_t weak_start_evidence_frames = 0U;
    uint32_t weak_start_confirmation_count = 0U;
#endif
    nuwax_speech_confirmation_t weak_start_confirmation = {0};
    nuwax_short_speech_tracker_t short_speech_tracker = {0};
    nuwax_conversation_correlated_weak_t correlated_weak = {0};
    nuwax_short_speech_observation_t short_speech_observation = {0};
    bool short_speech_runtime_enabled =
        NUWAX_SHORT_SPEECH_TRACKING != 0;
    uint32_t short_speech_shadow_confirmations = 0U;
    uint32_t short_speech_active_confirmations = 0U;
    bool adaptive_seed_pending = false;
    uint32_t adaptive_seed_voiced_ms = 0U;
    uint32_t adaptive_seed_span_ms = 0U;
    uint32_t adaptive_seed_tail_ms = 0U;
    bool adaptive_seed_trusted = false;
    bool vad_candidate_start_valid = false;
    uint32_t vad_candidate_start_sequence = 0;
    nuwax_speech_confirmation_t speech_confirmation = {0};
    bool speech_confirmation_runtime_enabled =
        NUWAX_SPEECH_CONFIRMATION_TRACKING != 0;
    bool barge_event_initialized = false;
    bool barge_local_cancel_requested = false;
    bool barge_controller_confirmed = false;
    bool barge_stop_request_armed = false;
    bool barge_physical_stop_observed = false;
    bool barge_post_cancel_guard_started = false;
    uint64_t barge_physical_stop_timestamp_us = 0;
    uint64_t barge_stop_requested_timestamp_us = 0;
    uint32_t barge_dispatch_binding = 0;
    bool barge_protocol_enqueued = false;
    bool barge_protocol_listen_committed = false;
    bool barge_uplink_prepared = false;
    uint32_t barge_stop_playback_generation = 0;
    uint32_t barge_playback_connection_epoch = 0;
    uint32_t barge_controller_candidate_id = 0;
    nuwax_aec_reference_provenance_t barge_reference_source = {0};
    bool barge_probe_active = false;
    uint32_t barge_probe_playback_generation = 0;
    uint32_t barge_probe_candidate_id = 0;
    uint8_t barge_probe_elapsed_frames = 0;
    uint32_t barge_post_cancel_guard_frames = 0;
    uint32_t barge_overlap_frames_preserved = 0;
    uint32_t barge_overlap_frames_silenced = 0;
    uint32_t barge_stale_frames_preserved = 0;
    uint32_t barge_overlap_max_ref_correlation_q15 = 0;
    uint32_t barge_event_onset_sequence = 0;
    uint32_t barge_event_confirmed_sequence = 0;
    char barge_event_id[48] = {0};
    char barge_audio_session_id[48] = {0};
    char barge_parent_turn_id[48] = {0};
    char barge_playback_id[48] = {0};
    char conversation_audio_session_id[48] = {0};
    uint32_t capture_awake_generation = 0;
    uint32_t slot2_ref_candidate_frames = 0;
    uint32_t mic2_speech_like_frames = 0;
    uint32_t hw_ref_frames = 0;
    uint32_t hw_ref_inactive_frames = 0;
    uint32_t hw_ref_fallback_frames = 0;
    uint32_t hw_ref_raw_active_frames = 0;
    uint32_t hw_ref_raw_avg_abs_max = 0;
    uint32_t hw_ref_raw_peak_max = 0;
    uint32_t software_ref_snapshot_frames = 0;
    uint32_t software_ref_active_frames = 0;
    uint64_t live_aec_software_ref_anchor_events = 0;
    uint32_t live_aec_software_ref_generation = 0;
    nuwax_aec_reference_provenance_t live_aec_reference_provenance = {0};
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
    uint32_t live_aec_fir_ref_delay_samples = 0;
    uint32_t live_aec_fir_ref_delay_revision = 0;
#endif
    uint32_t aec_playback_frames = 0;
    uint32_t aec_playback_pending_frames = 0;
    uint32_t aec_playback_session_gap_frames = 0;
    uint32_t aec_playback_hangover_frames = 0;
    uint32_t aec_playback_last_active_ms = 0;
    uint32_t stable_silent_reference_frames = 0;
    uint32_t playback_gate_candidate_frames = 0;
    uint32_t playback_gate_dual_candidate_frames = 0;
    uint32_t playback_gate_dual_open_frames = 0;
    uint32_t playback_gate_suppressed_frames = 0;
    uint32_t playback_gate_open_frame = 0;
    uint32_t playback_gate_candidate_streak = 0;
    uint32_t playback_gate_max_candidate_streak = 0;
    uint32_t playback_gate_score_frames = 0;
    uint32_t playback_gate_max_score_frames = 0;
    uint32_t playback_gate_ref_unhealthy_frames = 0;
    uint32_t playback_ref_active_frames = 0;
    uint32_t playback_ref_echo_veto_frames = 0;
    uint32_t playback_spatial_echo_veto_frames = 0;
    uint32_t playback_echo_only_streak = 0;
    uint32_t playback_human_onset_evidence_frames = 0;
    uint32_t playback_human_strong_evidence_frames = 0;
    uint32_t playback_human_seed_evidence_frames = 0;
    uint32_t playback_human_candidate_streak = 0;
    uint32_t playback_human_candidate_gap_frames = 0;
    uint32_t playback_human_candidate_max_gap_frames = 0;
    uint32_t playback_human_candidate_max_streak = 0;
    uint64_t playback_human_candidate_mic_avg_sum = 0;
    uint64_t playback_human_candidate_mic_peak_sum = 0;
    bool playback_human_candidate_start_valid = false;
    uint32_t playback_human_candidate_start_sequence = 0;
    bool playback_human_preroll_repair_pending = false;
    uint32_t playback_human_preroll_repair_start_sequence = 0;
    uint32_t playback_human_preroll_repair_end_sequence = 0;
    uint32_t playback_human_preroll_repair_attempts = 0;
    uint32_t playback_human_preroll_repair_successes = 0;
    uint32_t playback_human_preroll_repair_failures = 0;
    uint32_t playback_human_preroll_repair_skipped = 0;
    uint32_t playback_human_preroll_repaired_frames = 0;
    uint32_t playback_human_preroll_untrusted_source_frames = 0;
    uint32_t playback_human_spatial_anchor_frames = 0;
    uint32_t playback_human_separated_anchor_frames = 0;
    uint32_t playback_human_exceptional_anchor_frames = 0;
    uint32_t playback_human_low_level_anchor_frames = 0;
    uint32_t playback_human_voice_anchor_frames = 0;
    uint32_t playback_human_nearfield_candidate_frames = 0;
    uint32_t playback_human_nearfield_anchor_frames = 0;
    uint32_t playback_human_cloud_guarded_anchor_frames = 0;
    bool playback_human_nearfield_candidate_logged = false;
    bool playback_human_nearfield_anchor_logged = false;
    bool playback_human_cloud_guarded_anchor_logged = false;
    bool playback_human_nearfield_onset_valid = false;
    uint32_t playback_human_nearfield_onset_sequence = 0;
    nuwax_barge_in_nearfield_tracker_t playback_human_nearfield_tracker = {0};
    nuwax_barge_in_nearfield_tracker_t playback_human_symmetric_tracker = {0};
    uint32_t playback_human_provisional_frames = 0;
    uint32_t playback_human_fast_protect_frames = 0;
    uint32_t playback_human_fast_protect_remaining = 0;
    uint32_t playback_human_confirmed_frames = 0;
    uint32_t playback_human_seed_frames = 0;
    uint32_t playback_human_seed_refresh_frames = 0;
    uint32_t playback_human_seed_active_frames = 0;
    bool playback_human_log_seen = false;
    uint32_t playback_human_last_log_frame = 0;
    uint32_t confirmed_playback_human_context_frames = 0;
    uint32_t confirmed_playback_human_context_starts = 0;
    uint32_t playback_vad_echo_blocked_frames = 0;
    uint32_t playback_aec_gate_echo_blocked_frames = 0;
    uint32_t playback_ref_corr_q15_max = 0;
    uint32_t dual_mic_voice_like_frames = 0;
    uint32_t dual_mic_aec_hint_frames = 0;
    uint32_t dual_mic_aec_hint_active_frames = 0;
    uint32_t dual_mic_aec_hint_hangover_frames = 0;
    uint32_t dual_mic_aec_hint_hangover_remaining = 0;
    uint32_t dual_mic_cleaner_hint_frames = 0;
    uint32_t dual_mic_cleaner_hint_active_frames = 0;
    uint32_t dual_mic_cleaner_hint_hangover_frames = 0;
    uint32_t dual_mic_cleaner_hint_hangover_remaining = 0;
    uint32_t playback_raw_human_hint_frames = 0;
    uint32_t playback_raw_human_hint_active_frames = 0;
    uint32_t playback_raw_human_hint_hangover_frames = 0;
    uint32_t playback_raw_human_hint_hangover_remaining = 0;
    uint32_t playback_weak_continuity_hint_frames = 0;
    uint32_t playback_weak_continuity_hint_active_frames = 0;
    uint32_t playback_weak_continuity_hint_hangover_frames = 0;
    uint32_t playback_weak_continuity_hint_hangover_remaining = 0;
    uint32_t dual_mic_human_first_hint_frames = 0;
    uint32_t dual_mic_human_first_hint_active_frames = 0;
    uint32_t dual_mic_human_first_hint_hangover_frames = 0;
    uint32_t dual_mic_human_first_hint_hangover_remaining = 0;
    uint32_t dual_mic_voice_hint_hangover_remaining = 0;
    uint32_t dual_mic_diff_avg_abs_max = 0;
    uint32_t dual_mic_diff_energy_ratio_q15_max = 0;
    uint32_t dual_mic_level_balance_q15_min = 32768U;
    bool aec_playback_gate_active = false;
    bool vad_speech_seen = false;
    bool continuous_endpoint_candidate = false;
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
    nuwax_adaptive_endpoint_t adaptive_endpoint = {0};
    nuwax_adaptive_endpoint_observation_t adaptive_observation = {0};
    bool adaptive_session_eligible = false;
    bool adaptive_v2_session = false;
    nuwax_adaptive_endpoint_t short_endpoint_shadow = {0};
    nuwax_adaptive_endpoint_observation_t short_endpoint_shadow_observation =
        {0};
    bool short_endpoint_shadow_active = false;
    bool short_endpoint_shadow_seed_pending = false;
    bool short_endpoint_shadow_prediction_logged = false;
    bool short_endpoint_shadow_commit_logged = false;
    uint32_t short_endpoint_shadow_ws_epoch = 0U;
    bool adaptive_previous_playback_active = false;
    bool adaptive_prediction_actionable = false;
    uint32_t adaptive_ws_epoch = 0U;
    uint32_t adaptive_prediction_count = 0U;
    uint32_t adaptive_actionable_prediction_count = 0U;
    uint32_t adaptive_confirmed_truncation_count = 0U;
    uint32_t adaptive_actionable_truncation_count = 0U;
#endif
    bool cloud_progress_watchdog_armed = false;
    bool cloud_progress_watchdog_timed_out = false;
    uint32_t cloud_progress_watchdog_deadline_ms = 0U;
    uint32_t cloud_progress_watchdog_epoch = 0U;
    bool playback_human_seed_seen = false;
    bool confirmed_playback_human_context_previous = false;
    uint32_t playback_human_seed_hangover_remaining = 0;
    bool vad_no_speech_timeout = false;
    bool auto_followup_cancelled = false;
    bool auto_followup_replaced_by_command = false;
    bool exclusive_mode_preempted = false;
    uint32_t preroll_write = 0;
    uint32_t preroll_count = 0;
    acceptance_capture_request_t acceptance_capture = {0};
    nuwax_audio_uplink_t *send_ctx = nuwax_audio_uplink_create();
    nuwax_aec_alignment_context_t *aec_alignment_contexts = NULL;
    size_t aec_alignment_read = 0U;
    size_t aec_alignment_count = 0U;
    uint32_t aec_alignment_startup_frames = 0U;
    uint32_t aec_alignment_transition_drops = 0U;
    bool live_aec_pool_acquired = false;
    uint32_t live_aec_pool_delay_samples = 0;
    bool live_aec_custom_delay_active = false;
    bool live_aec_custom_delay_exercised = false;
    bool live_aec_runtime_faulted = false;
    esp_err_t live_aec_pool_reusable_status = ESP_OK;
    bool capture_started = false;
    const UBaseType_t original_task_priority = uxTaskPriorityGet(NULL);
    bool audio_task_priority_raised = false;
    uint32_t rt_capture_read_frames = 0;
    uint32_t rt_capture_dropped_no_slot = 0;
    uint32_t rt_capture_dropped_oldest_ready = 0;
    uint32_t rt_capture_ready_full_drops = 0;
    uint32_t rt_capture_dropped_samples = 0;
    uint32_t rt_capture_stale_decision_drops = 0;
    uint32_t rt_capture_max_ready_depth = 0;
    uint32_t capture_sequence = 0;
    uint32_t last_capture_sequence = 0;
    uint32_t capture_sequence_gap_frames = 0;
    uint32_t capture_sequence_gap_events = 0;
    uint32_t repaired_preroll_gap_frames = 0;
    uint32_t repaired_preroll_gap_events = 0;
    uint32_t rejected_preroll_gap_frames = 0;
    uint32_t rejected_preroll_gap_events = 0;
    bool capture_sequence_seen = false;
    nuwax_aec_runtime_state_t last_audio_health_state =
        NUWAX_AEC_RUNTIME_UNKNOWN;
    nuwax_aec_runtime_reason_bits_t last_audio_health_reasons =
        NUWAX_AEC_REASON_NONE;
    int64_t last_audio_health_log_us = 0;
    uint32_t suppressed_audio_health_logs = 0;
    bool audio_health_log_pending = false;
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
    nuwax_opus_encoder_t opus_encoder = {0};
    bool opus_encoder_ready = false;
#endif

    if (!send_ctx) {
        ESP_LOGE(TAG, "failed to allocate heap-owned audio uplink session");
        result = ESP_ERR_NO_MEM;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }

    if (samples_per_frame > CONFIG_NUWAX_VOICE_MAX_SAMPLES_PER_FRAME) {
        ESP_LOGE(TAG, "Configured frame has too many samples: %u", (unsigned)samples_per_frame);
        result = ESP_ERR_INVALID_ARG;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }
    if (default_max_record_samples == 0) {
        ESP_LOGE(TAG, "Configured microphone record length is zero");
        result = ESP_ERR_INVALID_ARG;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }
    nuwax_audio_cleaner_init(&(work->audio_cleaner));
    if (!nuwax_barge_controller_init(&(work->barge_controller), NULL)) {
        ESP_LOGE(TAG, "barge-in controller initialization failed");
        result = ESP_ERR_INVALID_STATE;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }
    if (!nuwax_conversation_audio_health_init(&(work->barge_audio_health), NULL)) {
        ESP_LOGE(TAG, "conversation audio health initialization failed");
        result = ESP_ERR_INVALID_STATE;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }
    ESP_LOGI(TAG, "audio cleaner runtime enabled=%d", s_audio_cleaner_runtime_enabled ? 1 : 0);
    result = wait_for_mic_start_action(ws);
    if (result != ESP_OK) {
        const bool reprovision_preempted = atomic_load_explicit(
            &s_reprovision_quiesce_requested, memory_order_acquire);
        exclusive_mode_preempted =
            !reprovision_preempted && exclusive_audio_mode_blocks_normal_audio();
        if (s_deferred_sleep_intent.active && result == ESP_ERR_INVALID_STATE) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND);
            ESP_LOGI(TAG,
                     "normal audio source yielded to sleep-after-playback intent token=%lu",
                     (unsigned long)s_deferred_sleep_intent.token);
        } else if (reprovision_preempted && result == ESP_ERR_INVALID_STATE) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_REPROVISION);
            ESP_LOGI(TAG, "normal audio source yielded to BLE reprovision");
        } else if (exclusive_mode_preempted && result == ESP_ERR_INVALID_STATE) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_EXCLUSIVE_PREEMPT);
            ESP_LOGI(TAG, "normal audio source yielded to exclusive audio mode");
        } else if (normal_audio_source_notification_preempted(result)) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_NOTIFICATION_TAKEOVER);
            ESP_LOGI(TAG,
                     "normal audio source yielded to notification transaction");
        } else if (normal_audio_source_sleep_preempted(result)) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND);
            ESP_LOGI(TAG,
                     "normal audio source yielded to sleep lifecycle state=%s sleep_txn=%s",
                     nuwax_app_state_name(conversation_state_current()),
                     nuwax_sleep_transaction_state_name(
                         s_sleep_transaction.state));
        } else {
            mic_capture_set_stop_reason(
                &stop_reason,
                nuwax_ws_is_connected(ws)
                    ? NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR
                    : NUWAX_MIC_CAPTURE_STOP_WS_ERROR);
            ESP_LOGW(TAG, "mic trigger wait failed: %s", esp_err_to_name(result));
        }
        goto cleanup;
    }
    if (s_deferred_sleep_intent.active) {
        result = ESP_ERR_INVALID_STATE;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND);
        ESP_LOGI(TAG,
                 "normal audio source aborted before MIC ownership for sleep-after-playback intent token=%lu",
                 (unsigned long)s_deferred_sleep_intent.token);
        goto cleanup;
    }
    const esp_err_t live_aec_prepare_err =
        conversation_live_aec_pool_init();
    if (live_aec_prepare_err != ESP_OK) {
        ESP_LOGW(TAG, "conversation live AEC on-demand prepare failed: %s",
                 esp_err_to_name(live_aec_prepare_err));
        restart_if_post_reprovision_aec_failed("capture_prepare");
    }
    live_aec_pool_acquired =
        conversation_live_aec_pool_acquire(&(work->live_aec));
    if (!live_aec_pool_acquired) {
        nuwax_live_aec_init(&(work->live_aec));
        (work->live_aec).enabled = false;
        ESP_LOGE(TAG,
                 "conversation live AEC pool unavailable status=%s in_use=%d degraded=%d; raw uplink remains available but barge-in is fail-closed",
                 esp_err_to_name(s_conversation_live_aec_pool_status),
                 s_conversation_live_aec_pool_in_use ? 1 : 0,
                 atomic_load_explicit(&s_conversation_live_aec_degraded,
                                      memory_order_acquire) ? 1 : 0);
    }
    live_aec_pool_delay_samples = (work->live_aec).delay_samples;
    nuwax_live_aec_set_internal_software_ref_enabled(&(work->live_aec), false);
    vTaskPrioritySet(NULL, NUWAX_AUDIO_DSP_TASK_PRIORITY);
    audio_task_priority_raised = true;
    auto_followup_mode = s_prelisten.capture_active;
    during_playback_mode =
        auto_followup_mode && nuwax_prelisten_state_mode_is(&s_prelisten, "during_playback");
#if !CONFIG_NUWAX_BARGE_IN_ENABLE
    if (during_playback_mode) {
        ESP_LOGW(TAG,
                 "during-playback capture rejected because voice barge-in is disabled");
        clear_auto_followup("voice_barge_disabled_pre_mic");
        auto_followup_replaced_by_command = true;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF);
        goto cleanup;
    }
#endif
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (auto_followup_mode &&
        !during_playback_mode &&
        nuwax_speaker_playback_has_pending()) {
#if CONFIG_NUWAX_BARGE_IN_ENABLE
        const uint32_t playback_guard_now_ms = monotonic_ms();
        const uint32_t playback_guard_window_ms =
            awake_session_listen_window_ms(playback_guard_now_ms);
        ESP_LOGI(TAG,
                 "normal prelisten blocked during speaker playback mode=%s; converting to during-playback capture window_ms=%lu",
                 nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                 (unsigned long)playback_guard_window_ms);
        nuwax_prelisten_state_start_capture(&s_prelisten,
                                            "during_playback",
                                            playback_guard_now_ms,
                                            playback_guard_window_ms,
                                            false);
        during_playback_mode = true;
#else
        ESP_LOGI(TAG,
                 "normal prelisten yielded before MIC ownership because TTS is pending and voice barge-in is disabled mode=%s",
                 nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"));
        clear_auto_followup("tts_pending_voice_barge_disabled");
        auto_followup_replaced_by_command = true;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF);
        goto cleanup;
#endif
    }
#endif
    if (during_playback_mode) {
        s_during_playback_capture_runtime_ready = false;
    }
    persistent_conversation_mode =
        persistent_normal_conversation_capture(auto_followup_mode, during_playback_mode);
    nuwax_speech_confirmation_reset(&speech_confirmation);
    nuwax_speech_confirmation_reset(&weak_start_confirmation);
    nuwax_short_speech_tracker_reset(&short_speech_tracker);
    nuwax_conversation_correlated_weak_reset(&correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
    nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
    /* Ambient prelisten must never teach the adaptive endpoint. Arm it only
     * when the local speech-confirmation gate admits human audio. */
    adaptive_session_eligible = false;
    adaptive_v2_session = false;
    adaptive_previous_playback_active = false;
    adaptive_ws_epoch = nuwax_ws_connection_epoch(ws);
#endif
    if (during_playback_mode) {
        nuwax_capture_phase_handoff_begin_during_playback(
            &capture_phase_handoff);
    }
    capture_awake_generation =
        nuwax_awake_session_state_generation(&s_awake_session);
    if (persistent_conversation_mode) {
        make_conversation_audio_session_id(conversation_audio_session_id,
                                           sizeof(conversation_audio_session_id));
        nuwax_listen_resume_state_bind_round(
            &s_listen_resume,
            capture_awake_generation,
            conversation_audio_session_id);
    }
    if (during_playback_mode && s_acceptance_capture_next.armed) {
        acceptance_capture = s_acceptance_capture_next;
        s_acceptance_capture_next.armed = false;
        acceptance_capture_enabled = true;
        max_record_ms = acceptance_capture.duration_ms;
        if (acceptance_capture.has_delay_samples) {
            (work->live_aec).delay_samples = acceptance_capture.delay_samples;
            live_aec_custom_delay_active =
                live_aec_pool_acquired &&
                acceptance_capture.delay_samples !=
                    live_aec_pool_delay_samples;
        }
        const size_t acceptance_max_samples =
            ((size_t)CONFIG_NUWAX_VOICE_SAMPLE_RATE * (size_t)max_record_ms) / 1000;
        if (acceptance_max_samples > max_record_samples) {
            max_record_samples = acceptance_max_samples;
        }
        ESP_LOGI(TAG,
                 "acceptance playback capture armed for this stream request=%s audio_session_id=%s duration_ms=%lu delay_samples=%lu max_samples=%u",
                 acceptance_capture.request_id[0] ? acceptance_capture.request_id : "-",
                 acceptance_capture.audio_session_id[0] ? acceptance_capture.audio_session_id : "-",
                 (unsigned long)acceptance_capture.duration_ms,
                 (unsigned long)(work->live_aec).delay_samples,
                 (unsigned)max_record_samples);
    }
    if (max_record_samples != SIZE_MAX) {
        max_record_samples -= max_record_samples % samples_per_frame;
        if (max_record_samples == 0U) {
            max_record_samples = samples_per_frame;
        }
    }

    bool reprovision_preempted_before_mic = false;
    portENTER_CRITICAL(&s_flash_ops_lock);
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        reprovision_preempted_before_mic = true;
    } else {
        atomic_store_explicit(&s_conversation_capture_starting,
                              true,
                              memory_order_release);
    }
    portEXIT_CRITICAL(&s_flash_ops_lock);
    if (reprovision_preempted_before_mic) {
        result = ESP_ERR_INVALID_STATE;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_REPROVISION);
        ESP_LOGI(TAG, "conversation MIC start fenced by BLE reprovision");
        goto cleanup;
    }

    result = nuwax_mic_input_init_with_owner(&mic, NUWAX_MIC_OWNER_CONVERSATION_CAPTURE);
    if (result == ESP_OK) {
        atomic_store_explicit(&s_conversation_capture_runtime_active,
                              true,
                              memory_order_release);
    }
    atomic_store_explicit(&s_conversation_capture_starting,
                          false,
                          memory_order_release);
    if (result != ESP_OK) {
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_MIC_ERROR);
        ESP_LOGE(TAG, "mic init failed: %s", esp_err_to_name(result));
        goto cleanup;
    }
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
    result = nuwax_opus_encoder_init(&opus_encoder,
                                     CONFIG_NUWAX_VOICE_SAMPLE_RATE,
                                     CONFIG_NUWAX_VOICE_CHANNELS,
                                     CONFIG_NUWAX_VOICE_FRAME_DURATION_MS);
    if (result != ESP_OK) {
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        ESP_LOGE(TAG, "Opus encoder init failed: %s", esp_err_to_name(result));
        goto cleanup;
    }
    opus_encoder_ready = true;
    if (nuwax_opus_encoder_frame_samples(&opus_encoder) != samples_per_frame) {
        ESP_LOGE(TAG,
                 "Opus frame size mismatch samples_per_frame=%u encoder_samples=%u",
                 (unsigned)samples_per_frame,
                 (unsigned)nuwax_opus_encoder_frame_samples(&opus_encoder));
        result = ESP_ERR_INVALID_SIZE;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }
    result = nuwax_audio_uplink_ensure_encoded_frame_capacity(nuwax_opus_encoder_output_bytes(&opus_encoder));
    if (result != ESP_OK) {
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
        goto cleanup;
    }
#endif

    result = nuwax_live_aec_begin_session(&(work->live_aec), samples_per_frame);
    if (result != ESP_OK) {
        ESP_LOGE(TAG,
                 "live AEC session reset failed frame_samples=%u err=%s; this round remains raw and barge-in fail-closed",
                 (unsigned)samples_per_frame,
                 esp_err_to_name(result));
        live_aec_runtime_faulted = true;
        (work->live_aec).enabled = false;
        result = ESP_OK;
    }
    ESP_LOGI(TAG,
             "live AEC session resources pooled=%d enabled=%d initialized=%d free_internal=%u largest_internal=%u free_dma=%u largest_dma=%u",
             live_aec_pool_acquired ? 1 : 0,
             nuwax_live_aec_is_enabled(&(work->live_aec)) ? 1 : 0,
             (work->live_aec).initialized ? 1 : 0,
             (unsigned)heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT),
             (unsigned)heap_caps_get_free_size(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL),
             (unsigned)heap_caps_get_largest_free_block(MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL));

    int64_t started_us = esp_timer_get_time();
    int64_t upload_started_us = started_us;

#if CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE
    /* P3-0/P3-1: if ref health passed, attempt AFE MR init.
     * On failure or health-not-passed, silently fall through to mono path. */
    s_afe_mr_enabled = false;
    if (s_aec_ref_health.passed) {
        /* TODO P3-1: wire real AFE create/process/destroy here.
         * For now the feature flag and guard exist so the build
         * compiles with the Kconfig option. Actual esp-sr AFE
         * integration is the P3-1 deliverable. */
        ESP_LOGI(TAG, "P3-0 AFE MR guard: ref_health passed (score=%.3f), "
                 "AFE create deferred to P3-1",
                 (double)s_aec_ref_health.score);
    } else {
        ESP_LOGI(TAG, "P3-0 AFE MR guard: ref_health NOT passed (status=%d), "
                 "falling back to mono path",
                 s_aec_ref_health.status);
    }
#endif
    /* Allocate the large capture-side context before advertising a cloud
     * listen session. The live reader starts after the control send so a slow
     * WebSocket lock cannot overflow its bounded queue before consumption. */
    aec_alignment_contexts = (nuwax_aec_alignment_context_t *)
        heap_caps_calloc(NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY,
                         sizeof(aec_alignment_contexts[0]),
                         MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
    if (!aec_alignment_contexts) {
        ESP_LOGE(TAG,
                 "AEC alignment context allocation failed frames=%u bytes=%u",
                 (unsigned)NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY,
                 (unsigned)(NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY *
                            sizeof(aec_alignment_contexts[0])));
        result = ESP_ERR_NO_MEM;
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        goto cleanup;
    }

    if (!auto_followup_mode) {
        s_prelisten.mic_release_stops_capture = true;
        make_conversation_audio_session_id(conversation_audio_session_id,
                                           sizeof(conversation_audio_session_id));
        nuwax_listen_resume_state_bind_round(
            &s_listen_resume,
            capture_awake_generation,
            conversation_audio_session_id);
        result = start_mic_cloud_upload(ws,
                                        send_ctx,
                                        "i2s-mic-stream",
                                        conversation_audio_session_id,
                                        NULL,
                                        max_record_samples,
                                        max_record_ms,
                                        &listen_started,
                                        &upload_started_us,
                                        false,
                                        false);
        if (result != ESP_OK) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
            goto cleanup;
        }
        upload_started = true;
        if (!acceptance_capture_enabled &&
            !conversation_wait_text_deadline_owned_by_turn_guard()) {
            cloud_progress_watchdog_armed = true;
            cloud_progress_watchdog_epoch = s_conversation_cloud_progress_epoch;
            cloud_progress_watchdog_deadline_ms =
                monotonic_ms() + NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS;
        }
    } else if (persistent_conversation_mode) {
        s_prelisten.mic_release_stops_capture = false;
        max_record_samples = SIZE_MAX;
        max_record_ms = awake_session_listen_window_ms(monotonic_ms());
        /* Keep ordinary awake listening local until the existing human-speech
         * confirmation gate fires. The rolling preroll preserves the onset,
         * while silence creates no cloud transaction and therefore needs no
         * protocol END/listen-stop pair. */
        nuwax_capture_phase_handoff_begin_awake_prelisten(
            &capture_phase_handoff);
        ESP_LOGI(TAG,
                 "continuous conversation local prelisten active mode=%s idle_timeout_ms=%u upload_gate=speech_confirmation preroll_frames=%u fixed_endpoint=candidate_%ums_commit_%ums adaptive_endpoint=%s adaptive_commit_ms=%u/%u-%u/%u/%u speech_confirmation=%s short_speech=%s",
                 nuwax_prelisten_state_mode_or(&s_prelisten, "awake_session"),
                 (unsigned)CONFIG_NUWAX_CONVERSATION_AWAKE_IDLE_TIMEOUT_MS,
                 (unsigned)NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES,
                 (unsigned)NUWAX_CONTINUOUS_ENDPOINT_CANDIDATE_SILENCE_MS,
                 (unsigned)CONFIG_NUWAX_VOICE_LOCAL_VAD_TRAILING_SILENCE_MS,
                 NUWAX_ADAPTIVE_ENDPOINT_MODE_NAME,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_SHORT_COMMIT_MS,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_MEDIUM_COMMIT_MS,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_MEDIUM_FIRST_PAUSE_COMMIT_MS,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_LONG_COMMIT_MS,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_VERY_LONG_COMMIT_MS,
                 NUWAX_SPEECH_CONFIRMATION_MODE_NAME,
                 NUWAX_SHORT_SPEECH_MODE_NAME);
    } else {
        s_prelisten.mic_release_stops_capture = false;
        if (!during_playback_mode) {
            set_state(NUWAX_APP_STATE_LISTENING);
        }
        ESP_LOGI(TAG,
                 "I2S microphone prelisten start mode=%s window_ms=%lu frame_ms=%d preroll_frames=%d upload_gate=%s",
                 nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                 (unsigned long)(s_prelisten.capture_deadline_ms - monotonic_ms()),
                 CONFIG_NUWAX_VOICE_FRAME_DURATION_MS,
                 NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES,
                 during_playback_mode ? "during_playback_nearend" : "local_vad");
    }

    result = rt_capture_start(&(work->capture_ctx), &mic, samples_per_frame,
                              (work->live_aec).delay_samples);
    if (result != ESP_OK) {
        mic_capture_set_stop_reason(
            &stop_reason, NUWAX_MIC_CAPTURE_STOP_MIC_ERROR);
        ESP_LOGE(TAG, "rt capture start failed: %s", esp_err_to_name(result));
        goto cleanup;
    }
    capture_started = true;
    if (during_playback_mode) {
        s_during_playback_capture_runtime_ready = true;
        ESP_LOGI(TAG,
                 "during-playback capture runtime ready; speaker START may be authorized");
    }
    if (persistent_conversation_mode) {
        resume_awake_waiting("stable_listening_capture");
    }
    live_aec_custom_delay_exercised = live_aec_custom_delay_active;
    while (nuwax_ws_is_connected(ws)) {
        app_task_watchdog_checkpoint();
        nuwax_preroll_cleaner_state_t frame_cleaner_state_before = {0};
        bool barge_post_stop_guard_frame = false;
        bool barge_current_frame_buffered = false;
        bool barge_current_frame_sanitized = false;
        if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                                 memory_order_acquire)) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_REPROVISION);
            if (!stop_requested) {
                stop_requested = true;
                ESP_LOGI(TAG,
                         "conversation capture stopping for BLE reprovision frames_recorded=%lu upload_started=%d",
                         (unsigned long)recorded_frames,
                         upload_started ? 1 : 0);
            }
        } else if (exclusive_audio_mode_blocks_normal_audio()) {
            /* An exclusive-mode request can arrive while the ordinary
             * microphone stream is already running. Release the conversation
             * MIC owner at the next frame boundary so its controller can take
             * over instead of waiting for local VAD or touch release. */
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_EXCLUSIVE_PREEMPT);
            if (persistent_conversation_mode && upload_started) {
                stop_requested = true;
                ESP_LOGI(TAG,
                         "continuous conversation ending for exclusive audio mode frames_recorded=%lu",
                         (unsigned long)recorded_frames);
            } else {
                ESP_LOGI(TAG,
                         "conversation capture preempted by exclusive audio mode frames_recorded=%lu upload_started=%d",
                         (unsigned long)recorded_frames,
                         upload_started ? 1 : 0);
                break;
            }
        }
        if (!stop_requested && poll_mic_stop_action(ws)) {
            stop_requested = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_RELEASE);
            ESP_LOGI(TAG, "mic stop requested by release frames_recorded=%lu", (unsigned long)captured_frames);
        }
        /* Bound control/UI work at each capture checkpoint so one cloud burst
         * cannot consume the next 20 ms audio deadline. */
        drain_session_commands_limited(ws, 1);
        (void)service_application_keepalive(ws, "conversation_capture");
        if (nuwax_notification_blocks_conversation(
                &s_notification_transaction) &&
            !stop_requested) {
            stop_requested = true;
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason,
                NUWAX_MIC_CAPTURE_STOP_NOTIFICATION_TAKEOVER);
            ESP_LOGI(TAG,
                     "conversation capture stopping at frame boundary for notification token=%lu frames_recorded=%lu upload_started=%d",
                     (unsigned long)s_notification_transaction.token,
                     (unsigned long)recorded_frames,
                     upload_started ? 1 : 0);
        }
        if (sleep_transaction_blocks_new_audio() && !stop_requested) {
            /* A semantic sleep command may have been consumed while this
             * owner still held I2S.  Finish the current frame boundary and
             * let cleanup commit the state after mic deinit. */
            stop_requested = true;
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND);
            ESP_LOGI(TAG,
                     "conversation capture stopping for deferred sleep reason=%s frames_recorded=%lu",
                     s_sleep_transaction.active
                         ? "remote_sleep_transaction"
                         : (s_sleep_request_reason[0]
                                ? s_sleep_request_reason
                                : "sleep"),
                     (unsigned long)recorded_frames);
        }
        if (handoff_old_session_closing) {
            esp_err_t old_finish_result = ESP_ERR_INVALID_STATE;
            if (nuwax_audio_uplink_finish_is_complete(send_ctx,
                                                      &old_finish_result)) {
                uplink_finish_succeeded = old_finish_result == ESP_OK;
                if (!uplink_finish_succeeded) {
                    nuwax_capture_phase_handoff_fail(&capture_phase_handoff);
                    result = old_finish_result;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    ESP_LOGE(TAG,
                             "seamless playback handoff old END/listen-stop transaction failed session=%s: %s",
                             handoff_old_audio_session_id,
                             esp_err_to_name(old_finish_result));
                    break;
                }
                nuwax_audio_uplink_destroy(send_ctx);
                handoff_old_session_closing = false;
                listen_started = false;
                uplink_finish_attempted = false;
                uplink_finish_succeeded = false;
                uplink_finish_result = ESP_ERR_INVALID_STATE;
                nuwax_capture_phase_handoff_mark_old_session_closed(
                    &capture_phase_handoff);
                ESP_LOGI(TAG,
                         "seamless playback handoff protocol closed old_session=%s capture_continuous=1 elapsed_ms=%lld transition_seq=%lu frozen_wire_frames=%lu",
                         handoff_old_audio_session_id,
                         (long long)((esp_timer_get_time() - handoff_requested_us) /
                                     1000),
                         (unsigned long)capture_phase_handoff
                             .transition_capture_sequence,
                         (unsigned long)capture_phase_handoff
                             .frozen_old_wire_frames);
                handoff_old_listen_mode[0] = '\0';
                handoff_old_audio_session_id[0] = '\0';
                memset(&handoff_listen_stop, 0,
                       sizeof(handoff_listen_stop));
            } else if (handoff_requested_us > 0 &&
                       (uint64_t)(esp_timer_get_time() -
                                  handoff_requested_us) >=
                           (uint64_t)
                               NUWAX_SEAMLESS_HANDOFF_DRAIN_TIMEOUT_MS *
                               1000ULL) {
                nuwax_capture_phase_handoff_fail(&capture_phase_handoff);
                result = ESP_ERR_TIMEOUT;
                uplink_finish_result = ESP_ERR_TIMEOUT;
                uplink_finish_succeeded = false;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                ESP_LOGE(TAG,
                         "seamless handoff END/listen-stop transaction timed out session=%s timeout_ms=%u; aborting current audio session while retaining WebSocket",
                         handoff_old_audio_session_id,
                         (unsigned)
                             NUWAX_SEAMLESS_HANDOFF_DRAIN_TIMEOUT_MS);
                break;
            }
        }
        if (cloud_progress_watchdog_armed) {
            const uint32_t progress_now_ms = monotonic_ms();
            const bool progress_changed =
                s_conversation_cloud_progress_epoch !=
                cloud_progress_watchdog_epoch;
            if (progress_changed &&
                s_conversation_cloud_progress_closes_capture) {
                cloud_progress_watchdog_epoch =
                    s_conversation_cloud_progress_epoch;
                cloud_progress_watchdog_armed = false;
                if (!stop_requested && persistent_conversation_mode &&
                    upload_started) {
                    stop_requested = true;
                    auto_followup_replaced_by_command = true;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_CLOUD_TURN_ACCEPTED);
                    ESP_LOGI(TAG,
                             "accepted cloud output closes active capture round at frame boundary event=%d audio_session=%s turn=%s frames_recorded=%lu",
                             (int)s_conversation_cloud_progress_event,
                             conversation_audio_session_id[0]
                                 ? conversation_audio_session_id
                                 : (barge_audio_session_id[0]
                                        ? barge_audio_session_id
                                        : "-"),
                             s_turn_guard.turn_id[0]
                                 ? s_turn_guard.turn_id
                                 : "-",
                             (unsigned long)recorded_frames);
                }
            } else if (conversation_wait_text_deadline_owned_by_turn_guard()) {
                cloud_progress_watchdog_armed = false;
                if (!stop_requested && persistent_conversation_mode &&
                    upload_started &&
                    s_conversation_cloud_progress_event ==
                        NUWAX_SESSION_EVENT_ASR_RESULT) {
                    stop_requested = true;
                    auto_followup_replaced_by_command = true;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_CLOUD_TURN_ACCEPTED);
                    ESP_LOGI(TAG,
                             "accepted ASR closes active capture round at frame boundary audio_session=%s turn=%s frames_recorded=%lu",
                             conversation_audio_session_id[0]
                                 ? conversation_audio_session_id
                                 : "-",
                             s_turn_guard.turn_id[0]
                                 ? s_turn_guard.turn_id
                                 : "-",
                             (unsigned long)recorded_frames);
                }
                ESP_LOGI(TAG,
                         "cloud deadline ownership transferred ASR->WAIT_TEXT turn=%s deadline_ms=%lu",
                         s_turn_guard.turn_id,
                         (unsigned long)s_turn_guard.deadline_ms);
            } else if (s_conversation_cloud_progress_epoch !=
                       cloud_progress_watchdog_epoch) {
                cloud_progress_watchdog_epoch =
                    s_conversation_cloud_progress_epoch;
                if (s_conversation_cloud_progress_event ==
                    NUWAX_SESSION_EVENT_ASR_RESULT) {
                    /* ASR is terminal for this stage. A successful result has
                     * already installed the sole WAIT_TEXT deadline; errors
                     * return to listening or close the session. */
                    cloud_progress_watchdog_armed = false;
                } else {
                    cloud_progress_watchdog_deadline_ms =
                        progress_now_ms +
                        NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS;
                }
            } else if (elapsed_ms(progress_now_ms,
                                  cloud_progress_watchdog_deadline_ms)) {
                cloud_progress_watchdog_timed_out = true;
                stop_requested = true;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_CLOUD_TIMEOUT);
                result = ESP_ERR_TIMEOUT;
                ESP_LOGE(TAG,
                         "cloud response progress watchdog expired after %u ms session=%s; returning to listening while retaining WebSocket",
                         (unsigned)NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS,
                         conversation_audio_session_id[0]
                             ? conversation_audio_session_id
                             : (barge_audio_session_id[0]
                                    ? barge_audio_session_id
                                    : "-"));
                break;
            }
        }
        if (exclusive_audio_mode_blocks_normal_audio() && !stop_requested) {
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_EXCLUSIVE_PREEMPT);
            ESP_LOGI(TAG,
                     "conversation capture preempted by exclusive audio mode after command drain frames_recorded=%lu upload_started=%d",
                     (unsigned long)recorded_frames,
                     upload_started ? 1 : 0);
            break;
        }
        if (auto_followup_mode && !s_prelisten.capture_active) {
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND);
            if (persistent_conversation_mode && upload_started) {
                stop_requested = true;
                ESP_LOGI(TAG,
                         "continuous conversation ending by explicit session command frames_recorded=%lu",
                         (unsigned long)recorded_frames);
            } else {
                ESP_LOGI(TAG,
                         "conversation prelisten stopped by session command frames_recorded=%lu upload_started=%d",
                         (unsigned long)recorded_frames,
                         upload_started ? 1 : 0);
                break;
            }
        }
        const int64_t capture_now_us = esp_timer_get_time();
        int64_t elapsed_since_start_ms = (capture_now_us - started_us) / 1000;
        int64_t elapsed_since_upload_ms = upload_started ? (capture_now_us - upload_started_us) / 1000 : 0;
        if (persistent_conversation_mode && upload_started &&
            confirmed_speech_us > 0 && !stop_requested &&
            (capture_now_us - confirmed_speech_us) >=
                (int64_t)continuous_utterance_limit_ms * 1000LL) {
            const uint64_t confirmed_age_us =
                last_confirmed_speech_us > 0 &&
                        capture_now_us >= last_confirmed_speech_us
                    ? (uint64_t)(capture_now_us - last_confirmed_speech_us)
                    : UINT64_MAX;
            const uint32_t confirmed_age_ms =
                confirmed_age_us / 1000ULL > UINT32_MAX
                    ? UINT32_MAX
                    : (uint32_t)(confirmed_age_us / 1000ULL);
            nuwax_audio_uplink_stats_t duration_uplink_stats = {0};
            nuwax_audio_uplink_get_stats(send_ctx, &duration_uplink_stats);
            const uint32_t uplink_queue_capacity =
                nuwax_audio_uplink_context_queue_depth(send_ctx);
            const bool uplink_queue_healthy =
                uplink_queue_capacity > 0U &&
                duration_uplink_stats.ready_depth <
                    (uplink_queue_capacity + 1U) / 2U;
            const uint32_t active_epoch = nuwax_ws_connection_epoch(ws);
            const bool transport_healthy =
                active_epoch != 0U && nuwax_ws_is_connected(ws) &&
                nuwax_ws_heartbeat_healthy_if_epoch(ws, active_epoch);
            const uint32_t next_limit_ms =
                nuwax_conversation_utterance_next_limit_ms(
                    continuous_utterance_limit_ms,
                    confirmed_age_ms,
                    transport_healthy,
                    uplink_queue_healthy);
            if (next_limit_ms > continuous_utterance_limit_ms) {
                ESP_LOGI(TAG,
                         "continuous conversation utterance extended old_limit_ms=%u new_limit_ms=%u confirmed_speech_age_ms=%u ready=%lu/%lu",
                         (unsigned)continuous_utterance_limit_ms,
                         (unsigned)next_limit_ms,
                         (unsigned)confirmed_age_ms,
                         (unsigned long)duration_uplink_stats.ready_depth,
                         (unsigned long)uplink_queue_capacity);
                continuous_utterance_limit_ms = next_limit_ms;
            } else {
                max_duration_reached = true;
                stop_requested = true;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_MAX_DURATION);
                ESP_LOGW(TAG,
                         "continuous conversation health bound reached limit_ms=%u confirmed_speech_age_ms=%u transport_healthy=%d queue_healthy=%d frames_recorded=%lu; ending audio transaction while retaining WebSocket",
                         (unsigned)continuous_utterance_limit_ms,
                         (unsigned)confirmed_age_ms,
                         transport_healthy ? 1 : 0,
                         uplink_queue_healthy ? 1 : 0,
                         (unsigned long)recorded_frames);
            }
        }
        if (stop_requested &&
            stop_reason == NUWAX_MIC_CAPTURE_STOP_MAX_DURATION) {
            ESP_LOGI(TAG,
                     "continuous conversation utterance bound stopping before next frame frames_recorded=%lu",
                     (unsigned long)recorded_frames);
            break;
        }
        if (auto_followup_mode &&
            atomic_load_explicit(&s_prelisten.cancel_capture,
                                 memory_order_acquire)) {
            auto_followup_cancelled = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF);
            nuwax_prelisten_state_clear_cancel(&s_prelisten);
            if (persistent_conversation_mode && upload_started) {
                stop_requested = true;
                ESP_LOGI(TAG,
                         "continuous conversation ending by explicit capture cancel frames_recorded=%lu",
                         (unsigned long)recorded_frames);
            } else {
                ESP_LOGI(TAG,
                         "conversation prelisten stopped for playback frames_recorded=%lu upload_started=%d",
                         (unsigned long)recorded_frames,
                         upload_started ? 1 : 0);
                break;
            }
        }
        const bool explicit_control_stop =
            stop_reason == NUWAX_MIC_CAPTURE_STOP_SESSION_COMMAND ||
            stop_reason == NUWAX_MIC_CAPTURE_STOP_PLAYBACK_HANDOFF ||
            stop_reason == NUWAX_MIC_CAPTURE_STOP_NOTIFICATION_TAKEOVER ||
            stop_reason == NUWAX_MIC_CAPTURE_STOP_CLOUD_TURN_ACCEPTED;
        if (nuwax_capture_phase_stop_before_next_frame(
                stop_requested,
                explicit_control_stop,
                handoff_old_session_closing)) {
            ESP_LOGI(TAG,
                     "capture control stop committed before next microphone frame reason=%s frames_recorded=%lu",
                     mic_capture_stop_reason_name(stop_reason),
                     (unsigned long)recorded_frames);
            break;
        }
        if (auto_followup_mode && !upload_started &&
            elapsed_ms((uint32_t)monotonic_ms(), s_prelisten.capture_deadline_ms)) {
            vad_no_speech_timeout = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_VAD_NO_SPEECH);
            ESP_LOGI(TAG,
                     "conversation prelisten expired mode=%s elapsed_ms=%lld frames=%lu",
                     nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                     (long long)elapsed_since_start_ms,
                     (unsigned long)captured_frames);
            break;
        }
        if (!persistent_conversation_mode &&
            upload_started && elapsed_since_upload_ms >= max_record_ms) {
            max_duration_reached = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MAX_DURATION);
            ESP_LOGI(TAG,
                     "mic max duration reached elapsed_ms=%lld frames_recorded=%lu",
                     (long long)elapsed_since_upload_ms,
                     (unsigned long)recorded_frames);
            break;
        }

        bool playback_active = false;
        bool speaker_pending = false;
        bool speaker_session_active = false;
        uint32_t speaker_submitted_generation = 0;
        uint32_t speaker_volume_generation = 0;
        uint8_t speaker_volume_percent = 0;
        bool speaker_playback_snapshot_stable = false;
        bool speaker_volume_snapshot_stable = false;
        uint32_t speaker_completed_stop_generation = 0;
        int64_t speaker_completed_stop_timestamp_us = 0;
        esp_err_t speaker_completed_stop_result = ESP_ERR_INVALID_STATE;
        bool speaker_stop_fault_active = false;
        uint32_t speaker_failed_stop_generation = 0;
        int64_t speaker_failed_stop_timestamp_us = 0;
        esp_err_t speaker_failed_stop_result = ESP_ERR_INVALID_STATE;
        int64_t frame_capture_finished_us = 0;
        bool capture_sequence_contiguous = true;
        bool aec_session_gap_active = false;
        bool aec_hangover_active = false;
#if !CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        bool have_aec_ref = false;
#endif
        size_t samples_read = 0;
        esp_err_t err = ESP_OK;
        nuwax_mic_raw_stats_t frame_raw_stats = {0};
        nuwax_live_aec_rescue_source_kind_t frame_rescue_source_kind =
            NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW;
        nuwax_live_aec_rescue_provenance_t frame_rescue_provenance = {0};
        uint64_t frame_software_ref_anchor_events = 0;
        uint32_t frame_software_ref_generation = 0;
        nuwax_aec_reference_provenance_t frame_reference_provenance = {0};
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
        bool frame_software_fir_ref_full = false;
        uint32_t frame_software_fir_ref_delay_samples = 0;
        uint32_t frame_software_fir_ref_delay_revision = 0;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
        bool frame_software_ref_epoch_valid = false;
        uint64_t frame_software_ref_source_end_index = 0;
        int64_t frame_software_ref_phase_error = 0;
#endif
        nuwax_rt_capture_frame_t *capture_frame = NULL;
        nuwax_aec_alignment_context_t *staged_alignment_context = NULL;
        const bool capture_frame_ready = rt_capture_receive(
            &(work->capture_ctx),
            &capture_frame,
            NUWAX_CONVERSATION_CAPTURE_OWNER_POLL_MS);
        const nuwax_rt_capture_wait_result_t capture_wait_result =
            nuwax_rt_capture_wait_classify(
                capture_frame_ready,
                atomic_load_explicit(&(work->capture_ctx).stopped,
                                     memory_order_acquire));
        if (capture_wait_result ==
            NUWAX_RT_CAPTURE_WAIT_CONTROL_POLL_IDLE) {
            /* The capture worker owns the real I2S timeout. Return to the
             * control checkpoint so speaker terminal events, cloud commands
             * and touch/shake arbitration cannot wait behind that timeout. */
            continue;
        }
        if (capture_wait_result == NUWAX_RT_CAPTURE_WAIT_WORKER_STOPPED) {
            result = (work->capture_ctx).last_error != ESP_OK
                         ? (work->capture_ctx).last_error
                         : ESP_ERR_INVALID_STATE;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MIC_ERROR);
            ESP_LOGE(TAG,
                     "rt capture worker stopped before frame delivery err=%s frames_recorded=%lu",
                     esp_err_to_name(result),
                     (unsigned long)recorded_frames);
            break;
        }
        {
            const int64_t dequeued_us = esp_timer_get_time();
            const uint64_t capture_age_us =
                capture_frame->read_finished_us > 0 &&
                        dequeued_us >= capture_frame->read_finished_us
                    ? (uint64_t)(dequeued_us - capture_frame->read_finished_us)
                    : 0U;
            const bool preserve_confirmed_barge_frame =
                auto_followup_mode && during_playback_mode &&
                barge_controller_confirmed;
            const bool preserve_pending_handoff_frame =
                nuwax_capture_phase_preserve_stale_transition(
                    persistent_conversation_mode,
                    s_during_playback_handoff_pending);
            const bool preserve_stale_capture_frame =
                preserve_confirmed_barge_frame ||
                preserve_pending_handoff_frame;
            if (capture_age_us >
                    (uint64_t)NUWAX_RT_CAPTURE_MAX_DECISION_AGE_MS * 1000ULL &&
                !preserve_stale_capture_frame) {
                const uint32_t stale_sequence = capture_frame->seq;
                rt_capture_release(&(work->capture_ctx), capture_frame);
                rt_capture_stale_decision_drops++;
                if (s_conversation_runtime_metrics_ready) {
                    (void)nuwax_conversation_metrics_count_event(
                        s_conversation_runtime_metrics,
                        NUWAX_CONVERSATION_EVENT_STALE_CAPTURE_FRAME,
                        1U);
                }
                if (rt_capture_stale_decision_drops == 1U ||
                    (rt_capture_stale_decision_drops %
                     NUWAX_CAPTURE_GAP_LOG_INTERVAL_EVENTS) == 0U) {
                    ESP_LOGW(TAG,
                             "stale capture frame dropped before DSP seq=%lu age_us=%llu limit_ms=%u drops=%lu ready=%u",
                             (unsigned long)stale_sequence,
                             (unsigned long long)capture_age_us,
                             (unsigned)NUWAX_RT_CAPTURE_MAX_DECISION_AGE_MS,
                             (unsigned long)rt_capture_stale_decision_drops,
                             (work->capture_ctx).ready_slots
                                 ? (unsigned)uxQueueMessagesWaiting(
                                       (work->capture_ctx).ready_slots)
                                 : 0U);
                }
                continue;
            }
            if (capture_age_us >
                    (uint64_t)NUWAX_RT_CAPTURE_MAX_DECISION_AGE_MS * 1000ULL &&
                preserve_stale_capture_frame) {
                if (preserve_confirmed_barge_frame) {
                    barge_stale_frames_preserved++;
                }
                if (preserve_pending_handoff_frame ||
                    barge_stale_frames_preserved == 1U ||
                    (barge_stale_frames_preserved %
                     NUWAX_CAPTURE_GAP_LOG_INTERVAL_EVENTS) == 0U) {
                    ESP_LOGW(TAG,
                             "stale capture frame retained for %s transition seq=%lu age_us=%llu barge_retained=%lu ready=%u",
                             preserve_pending_handoff_frame
                                 ? "playback_handoff"
                                 : "confirmed_barge",
                             (unsigned long)capture_frame->seq,
                             (unsigned long long)capture_age_us,
                             (unsigned long)barge_stale_frames_preserved,
                             (work->capture_ctx).ready_slots
                                 ? (unsigned)uxQueueMessagesWaiting(
                                       (work->capture_ctx).ready_slots)
                                 : 0U);
                }
            }
            if (s_conversation_runtime_metrics_ready &&
                (work->capture_ctx).ready_slots) {
                (void)nuwax_conversation_metrics_observe_queue(
                    s_conversation_runtime_metrics,
                    NUWAX_CONVERSATION_QUEUE_CAPTURE,
                    (uint32_t)uxQueueMessagesWaiting((work->capture_ctx).ready_slots),
                    NUWAX_RT_CAPTURE_QUEUE_DEPTH);
            }
            err = capture_frame->err;
            samples_read = capture_frame->samples_read;
            capture_sequence = capture_frame->seq;
#if !CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
            have_aec_ref = capture_frame->have_aec_ref;
#endif
            frame_raw_stats = capture_frame->raw_stats;
            speaker_pending = capture_frame->speaker_pending;
            speaker_session_active = capture_frame->speaker_session_active;
            speaker_submitted_generation =
                capture_frame->speaker_submitted_generation;
            speaker_volume_generation = capture_frame->speaker_volume_generation;
            speaker_volume_percent = capture_frame->speaker_volume_percent;
            speaker_playback_snapshot_stable =
                capture_frame->speaker_playback_snapshot_stable;
            speaker_volume_snapshot_stable =
                capture_frame->speaker_volume_snapshot_stable;
            speaker_completed_stop_generation =
                capture_frame->speaker_completed_stop_generation;
            speaker_completed_stop_timestamp_us =
                capture_frame->speaker_completed_stop_timestamp_us;
            speaker_completed_stop_result =
                capture_frame->speaker_completed_stop_result;
            speaker_stop_fault_active =
                capture_frame->speaker_stop_fault_active;
            speaker_failed_stop_generation =
                capture_frame->speaker_failed_stop_generation;
            speaker_failed_stop_timestamp_us =
                capture_frame->speaker_failed_stop_timestamp_us;
            speaker_failed_stop_result =
                capture_frame->speaker_failed_stop_result;
            frame_capture_finished_us = capture_frame->read_finished_us;
            frame_software_ref_anchor_events = capture_frame->software_ref_anchor_events;
            frame_software_ref_generation = capture_frame->software_ref_generation;
            frame_reference_provenance = capture_frame->reference_provenance;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
            frame_software_fir_ref_full = capture_frame->software_fir_ref_full;
            frame_software_fir_ref_delay_samples =
                capture_frame->software_fir_ref_delay_samples;
            frame_software_fir_ref_delay_revision =
                capture_frame->software_fir_ref_delay_revision;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
            frame_software_ref_epoch_valid = capture_frame->software_ref_epoch_valid;
            frame_software_ref_source_end_index = capture_frame->software_ref_source_end_index;
            frame_software_ref_phase_error = capture_frame->software_ref_phase_error;
#endif
            if ((err == ESP_OK || err == ESP_ERR_TIMEOUT) &&
                samples_read > 0 &&
                capture_frame->slot2_ref_candidate) {
                slot2_ref_candidate_frames++;
                const nuwax_mic_level_t hw_ref_raw_level =
                    capture_frame->hw_ref_raw_level;
                const bool hw_ref_raw_active =
                    hw_ref_raw_level.avg_abs >=
                        NUWAX_HW_REF_ACTIVE_MIN_AVG_ABS ||
                    hw_ref_raw_level.peak >= NUWAX_HW_REF_ACTIVE_MIN_PEAK;
                if (hw_ref_raw_active) {
                    hw_ref_raw_active_frames++;
                }
                if (hw_ref_raw_level.avg_abs > hw_ref_raw_avg_abs_max) {
                    hw_ref_raw_avg_abs_max = hw_ref_raw_level.avg_abs;
                }
                if (hw_ref_raw_level.peak > hw_ref_raw_peak_max) {
                    hw_ref_raw_peak_max = hw_ref_raw_level.peak;
                }
                if (capture_frame->hw_ref_active) {
                    hw_ref_frames++;
                } else {
                    hw_ref_inactive_frames++;
                }
            }
            if (capture_frame->software_ref_snapshot) {
                software_ref_snapshot_frames++;
            }
            if (capture_frame->software_ref_active) {
                software_ref_active_frames++;
            }
            if (capture_frame->hw_ref_fallback) {
                hw_ref_fallback_frames++;
            }
            if (samples_read > 0) {
                memcpy(s_audio_samples, capture_frame->mic1, samples_read * sizeof(s_audio_samples[0]));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
                memcpy(s_audio_mic2_samples,
                       capture_frame->mic2,
                       samples_read * sizeof(s_audio_mic2_samples[0]));
                memcpy(s_audio_ref_samples,
                       capture_frame->ref,
                       samples_read * sizeof(s_audio_ref_samples[0]));
                memcpy(s_audio_fir_ref_samples,
                       capture_frame->fir_ref,
                       samples_read * sizeof(s_audio_fir_ref_samples[0]));
#endif
            }
            if (aec_alignment_count >=
                NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY) {
                ESP_LOGE(TAG,
                         "AEC alignment context overflow count=%u seq=%lu",
                         (unsigned)aec_alignment_count,
                         (unsigned long)capture_frame->seq);
                rt_capture_release(&(work->capture_ctx), capture_frame);
                result = ESP_ERR_INVALID_SIZE;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                break;
            }
            const size_t alignment_write =
                (aec_alignment_read + aec_alignment_count) %
                NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY;
            staged_alignment_context =
                &aec_alignment_contexts[alignment_write];
            memset(staged_alignment_context,
                   0,
                   sizeof(*staged_alignment_context));
            staged_alignment_context->meta = *capture_frame;
            if (samples_read > 0U) {
                memcpy(staged_alignment_context->mic1,
                       capture_frame->mic1,
                       samples_read *
                           sizeof(staged_alignment_context->mic1[0]));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
                memcpy(staged_alignment_context->mic2,
                       capture_frame->mic2,
                       samples_read *
                           sizeof(staged_alignment_context->mic2[0]));
                memcpy(staged_alignment_context->ref,
                       capture_frame->ref,
                       samples_read *
                           sizeof(staged_alignment_context->ref[0]));
                memcpy(staged_alignment_context->hw_ref,
                       capture_frame->hw_ref,
                       samples_read *
                           sizeof(staged_alignment_context->hw_ref[0]));
                memcpy(staged_alignment_context->fir_ref,
                       capture_frame->fir_ref,
                       samples_read *
                           sizeof(staged_alignment_context->fir_ref[0]));
#endif
            }
            aec_alignment_count++;
            const uint32_t aec_gate_now_ms =
                capture_frame->read_finished_ms != 0 ? capture_frame->read_finished_ms : monotonic_ms();
            staged_alignment_context->aec_gate_now_ms = aec_gate_now_ms;
            rt_capture_release(&(work->capture_ctx), capture_frame);
            if (capture_sequence_seen) {
                const uint32_t expected_sequence = last_capture_sequence + 1U;
                if (capture_sequence != expected_sequence) {
                    capture_sequence_contiguous = false;
                    const uint32_t forward_distance =
                        capture_sequence - expected_sequence;
                    const uint32_t gap =
                        forward_distance < (UINT32_MAX / 2U + 1U)
                            ? forward_distance
                            : 0U;
                    capture_sequence_gap_frames += gap;
                    capture_sequence_gap_events++;
                    if (s_conversation_runtime_metrics_ready) {
                        (void)nuwax_conversation_metrics_count_event(
                            s_conversation_runtime_metrics,
                            NUWAX_CONVERSATION_EVENT_SEQUENCE_GAP,
                            gap == 0U ? 1U : gap);
                    }
                    if (capture_sequence_gap_events == 1U ||
                        gap >= 8U ||
                        (capture_sequence_gap_events % NUWAX_CAPTURE_GAP_LOG_INTERVAL_EVENTS) == 0U) {
                        ESP_LOGW(TAG,
                                 "capture sequence gap expected=%lu actual=%lu gap_frames=%lu cumulative_events=%lu cumulative_frames=%lu",
                                 (unsigned long)expected_sequence,
                                 (unsigned long)capture_sequence,
                                 (unsigned long)gap,
                                 (unsigned long)capture_sequence_gap_events,
                                 (unsigned long)capture_sequence_gap_frames);
                    }
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
                    nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
                    adaptive_session_eligible = false;
                    adaptive_v2_session = false;
#endif
                    nuwax_speech_confirmation_reset(&speech_confirmation);
                    nuwax_speech_confirmation_reset(&weak_start_confirmation);
                    nuwax_short_speech_tracker_reset(&short_speech_tracker);
                    nuwax_conversation_correlated_weak_reset(
                        &correlated_weak);
                    /* Before a listen transaction exists, preroll selection
                     * may crop old history and start from a fresh contiguous
                     * onset. Once uplink is committed, however, accepting the
                     * current frame would renumber it as the next wire frame
                     * and silently hide missing captured audio from the cloud.
                     * Finish the current stream at the last trustworthy frame
                     * and report an explicit failure instead. */
                    if (upload_started) {
                        ESP_LOGE(TAG,
                                 "capture sequence gap after uplink start; terminating session expected=%lu actual=%lu gap_frames=%lu",
                                 (unsigned long)expected_sequence,
                                 (unsigned long)capture_sequence,
                                 (unsigned long)gap);
                        result = ESP_ERR_INVALID_STATE;
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_CAPTURE_SEQUENCE_GAP);
                        break;
                    }
                    staged_alignment_context->capture_gap_expected_sequence =
                        expected_sequence;
                    staged_alignment_context->capture_gap_frames = gap;
                }
            }
            capture_sequence_seen = true;
            last_capture_sequence = capture_sequence;
            staged_alignment_context->capture_sequence_contiguous =
                capture_sequence_contiguous;
            if (barge_controller_confirmed &&
                !barge_physical_stop_observed &&
                speaker_stop_fault_active &&
                speaker_failed_stop_generation ==
                    barge_stop_playback_generation) {
                ESP_LOGE(TAG,
                         "barge-in physical speaker stop fault generation=%lu timestamp_us=%lld err=%s",
                         (unsigned long)barge_stop_playback_generation,
                         (long long)speaker_failed_stop_timestamp_us,
                         esp_err_to_name(speaker_failed_stop_result));
                result = speaker_failed_stop_result == ESP_OK
                             ? ESP_FAIL
                             : speaker_failed_stop_result;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                break;
            }
            if (barge_controller_confirmed &&
                !barge_physical_stop_observed &&
                speaker_completed_stop_generation ==
                    barge_stop_playback_generation &&
                speaker_completed_stop_timestamp_us > 0) {
                if (speaker_completed_stop_result != ESP_OK) {
                    ESP_LOGE(TAG,
                             "barge-in physical speaker stop failed generation=%lu err=%s",
                             (unsigned long)barge_stop_playback_generation,
                             esp_err_to_name(
                                 speaker_completed_stop_result));
                    result = speaker_completed_stop_result;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    break;
                }
                barge_physical_stop_observed = true;
                barge_physical_stop_timestamp_us =
                    (uint64_t)speaker_completed_stop_timestamp_us;
            }
            if (barge_controller_confirmed &&
                !barge_physical_stop_observed &&
                barge_stop_requested_timestamp_us > 0U &&
                frame_capture_finished_us > 0 &&
                (uint64_t)frame_capture_finished_us >
                    barge_stop_requested_timestamp_us +
                        (uint64_t)NUWAX_BARGE_PHYSICAL_STOP_TIMEOUT_MS *
                            1000ULL) {
                ESP_LOGE(TAG,
                         "barge-in physical speaker stop timeout generation=%lu waited_ms=%u",
                         (unsigned long)barge_stop_playback_generation,
                         (unsigned)NUWAX_BARGE_PHYSICAL_STOP_TIMEOUT_MS);
                result = ESP_ERR_TIMEOUT;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                break;
            }
#if CONFIG_NUWAX_SPEAKER_ENABLE
            if (speaker_pending) {
                aec_playback_last_active_ms = aec_gate_now_ms;
            }
            if (aec_playback_last_active_ms != 0) {
                aec_session_gap_active =
                    speaker_session_active &&
                    !elapsed_ms(aec_gate_now_ms,
                                aec_playback_last_active_ms + NUWAX_LIVE_AEC_PLAYBACK_SESSION_GAP_MS);
                aec_hangover_active =
                    during_playback_mode &&
                    !elapsed_ms(aec_gate_now_ms,
                                aec_playback_last_active_ms + NUWAX_LIVE_AEC_PLAYBACK_HANGOVER_MS);
            }
            playback_active = speaker_pending || aec_session_gap_active || aec_hangover_active;
            /* A confirmed local barge-in owns the handoff after the physical
             * output stop. Keep the bounded hangover AEC active through the
             * guard; per-frame trust decides whether each tail frame is clean
             * enough to preserve or must become equal-duration silence. */
            if (during_playback_mode &&
                barge_local_cancel_requested &&
                barge_physical_stop_observed &&
                !barge_post_cancel_guard_started &&
                frame_capture_finished_us >= 0 &&
                (uint64_t)frame_capture_finished_us >=
                    barge_physical_stop_timestamp_us) {
                barge_post_cancel_guard_frames =
                    NUWAX_BARGE_IN_POST_CANCEL_GUARD_FRAMES;
                barge_post_cancel_guard_started = true;
            }
            if (during_playback_mode &&
                barge_local_cancel_requested &&
                barge_post_cancel_guard_started &&
                !speaker_pending) {
                if (barge_post_cancel_guard_frames > 0U) {
                    barge_post_cancel_guard_frames--;
                    barge_post_stop_guard_frame = true;
                }
            }
            if (playback_active) {
                aec_playback_frames++;
                if (speaker_pending) {
                    aec_playback_pending_frames++;
                } else if (aec_session_gap_active) {
                    aec_playback_session_gap_frames++;
                } else if (aec_hangover_active) {
                    aec_playback_hangover_frames++;
                }
            }
            staged_alignment_context->playback_active = playback_active;
            staged_alignment_context->barge_post_stop_guard_frame =
                barge_post_stop_guard_frame;
            if (playback_active != aec_playback_gate_active) {
        NUWAX_RT_DIAG_LOGI(TAG,
                 "live AEC playback gate active=%d pending=%d session=%d gap=%d hangover=%d frame=%lu",
                         playback_active ? 1 : 0,
                         speaker_pending ? 1 : 0,
                         speaker_session_active ? 1 : 0,
                         aec_session_gap_active ? 1 : 0,
                         aec_hangover_active ? 1 : 0,
                         (unsigned long)captured_frames);
                aec_playback_gate_active = playback_active;
            }
#endif
        }
        if (nuwax_rt_capture_wait_counts_mic_timeout(
                capture_wait_result,
                err == ESP_ERR_TIMEOUT,
                samples_read > 0)) {
            const bool pending_speech_candidate =
                ordinary_listen_speech_candidate_active(
                    &speech_confirmation,
                    speech_confirmation_runtime_enabled,
                    &weak_start_confirmation,
                    vad_speech_seen,
                    short_speech_runtime_enabled &&
                        short_speech_tracker.candidate_active,
                    vad_speech_frames,
                    (uint32_t)CONFIG_NUWAX_VOICE_FRAME_DURATION_MS);
            bool timeout_playback_active = playback_active;
#if CONFIG_NUWAX_SPEAKER_ENABLE
            timeout_playback_active =
                timeout_playback_active ||
                nuwax_speaker_playback_has_pending();
#endif
            if (persistent_conversation_mode && !stop_requested &&
                nuwax_awake_session_state_generation_matches(
                    &s_awake_session, capture_awake_generation) &&
                nuwax_awake_session_state_can_enter_idle_sleep(
                    &s_awake_session,
                    monotonic_ms(),
                    conversation_state_current() ==
                        NUWAX_APP_STATE_LISTENING,
                    s_turn_guard.active,
                    timeout_playback_active,
                    pending_speech_candidate)) {
                stop_requested = true;
                persistent_awake_timeout = true;
                nuwax_listen_resume_state_set_idle_expiry_pending(
                    &s_listen_resume, true);
                mic_capture_set_stop_reason(
                    &stop_reason,
                    NUWAX_MIC_CAPTURE_STOP_AWAKE_TIMEOUT);
                ESP_LOGI(TAG,
                         "continuous conversation idle timeout during empty MIC read; closing uplink frames_recorded=%lu",
                         (unsigned long)recorded_frames);
                break;
            }
            consecutive_timeouts++;
            total_timeouts++;
            if (consecutive_timeouts == 1 || (consecutive_timeouts % 5) == 0) {
                ESP_LOGW(TAG,
                         "mic read timeout consecutive=%lu total=%lu frames_recorded=%lu",
                         (unsigned long)consecutive_timeouts,
                         (unsigned long)total_timeouts,
                         (unsigned long)recorded_frames);
            }
            if (consecutive_timeouts >= CONFIG_NUWAX_MIC_MAX_CONSECUTIVE_TIMEOUTS) {
                result = ESP_ERR_TIMEOUT;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_MIC_ERROR);
                ESP_LOGE(TAG,
                         "mic capture failed after consecutive timeouts frames_recorded=%lu limit=%u",
                         (unsigned long)captured_frames,
                         (unsigned)CONFIG_NUWAX_MIC_MAX_CONSECUTIVE_TIMEOUTS);
                break;
            }
            continue;
        }
        if (err != ESP_OK && err != ESP_ERR_TIMEOUT) {
            ESP_LOGW(TAG, "mic read failed: %s", esp_err_to_name(err));
            result = err;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MIC_ERROR);
            break;
        }
        if (err == ESP_ERR_TIMEOUT) {
            total_timeouts++;
            ESP_LOGW(TAG,
                     "mic partial read timeout samples=%u expected=%u frames_recorded=%lu",
                     (unsigned)samples_read,
                     (unsigned)samples_per_frame,
                     (unsigned long)captured_frames);
        }
        consecutive_timeouts = 0;
        if (samples_read != samples_per_frame) {
            ESP_LOGW(TAG, "mic short read samples=%u expected=%u",
                     (unsigned)samples_read,
                     (unsigned)samples_per_frame);
            if (samples_read < samples_per_frame) {
                memset(&s_audio_samples[samples_read], 0, (samples_per_frame - samples_read) * sizeof(int16_t));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
                memset(&s_audio_mic2_samples[samples_read],
                       0,
                       (samples_per_frame - samples_read) * sizeof(int16_t));
                memset(&s_audio_hw_ref_samples[samples_read],
                       0,
                       (samples_per_frame - samples_read) * sizeof(int16_t));
#endif
                memset(&s_audio_ref_samples[samples_read],
                       0,
                       (samples_per_frame - samples_read) * sizeof(int16_t));
                memset(&s_audio_fir_ref_samples[samples_read],
                       0,
                       (samples_per_frame - samples_read) * sizeof(int16_t));
                samples_read = samples_per_frame;
            }
        }
        if (recorded_samples + samples_read > max_record_samples) {
            samples_read = max_record_samples - recorded_samples;
            max_duration_reached = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MAX_DURATION);
        }
        const uint64_t frame_dsp_started_us =
            (uint64_t)esp_timer_get_time();

        esp_err_t frame_aec_process_result = ESP_ERR_INVALID_STATE;
        bool frame_aec_process_attempted = false;

        if (staged_alignment_context) {
            staged_alignment_context->meta.samples_read = samples_read;
            if (samples_read < NUWAX_CAPTURE_FRAME_SAMPLES) {
                memset(&staged_alignment_context->mic1[samples_read],
                       0,
                       (NUWAX_CAPTURE_FRAME_SAMPLES - samples_read) *
                           sizeof(staged_alignment_context->mic1[0]));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
                memset(&staged_alignment_context->mic2[samples_read],
                       0,
                       (NUWAX_CAPTURE_FRAME_SAMPLES - samples_read) *
                           sizeof(staged_alignment_context->mic2[0]));
                memset(&staged_alignment_context->ref[samples_read],
                       0,
                       (NUWAX_CAPTURE_FRAME_SAMPLES - samples_read) *
                           sizeof(staged_alignment_context->ref[0]));
                memset(&staged_alignment_context->fir_ref[samples_read],
                       0,
                       (NUWAX_CAPTURE_FRAME_SAMPLES - samples_read) *
                           sizeof(staged_alignment_context->fir_ref[0]));
#endif
            }
        }

        /* Feed the 256-sample AEC atom before downstream analysis. The AEC
         * adapter may retain a partial atom, so the capture context is kept in
         * a parallel ring until a complete 320-sample output frame exists. */
        if (samples_read > 0U) {
            const uint64_t aec_phase_started_us =
                (uint64_t)esp_timer_get_time();
            if (!playback_active && aec_alignment_count > 1U) {
                const size_t dropped_contexts = aec_alignment_count - 1U;
                const size_t dropped_samples =
                    nuwax_live_aec_flush_pending(&(work->live_aec));
                aec_alignment_read =
                    (aec_alignment_read + dropped_contexts) %
                    NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY;
                aec_alignment_count = 1U;
                aec_alignment_transition_drops +=
                    (uint32_t)dropped_contexts;
                if (dropped_contexts > 1U ||
                    dropped_samples > samples_per_frame) {
                    ESP_LOGW(TAG,
                             "AEC stream transition flush contexts=%u samples=%u total_contexts=%lu",
                             (unsigned)dropped_contexts,
                             (unsigned)dropped_samples,
                             (unsigned long)aec_alignment_transition_drops);
                } else {
                    ESP_LOGI(TAG,
                             "AEC stream transition boundary flushed contexts=%u samples=%u total_contexts=%lu",
                             (unsigned)dropped_contexts,
                             (unsigned)dropped_samples,
                             (unsigned long)aec_alignment_transition_drops);
                }
            }
            bool software_ref_generation_changed = false;
            bool fir_ref_delay_revision_changed = false;
            if (frame_reference_provenance.snapshot &&
                !nuwax_aec_reference_same_epoch(
                    frame_reference_provenance,
                    live_aec_reference_provenance)) {
                if (live_aec_reference_provenance.snapshot) {
                    nuwax_live_aec_reset_reference_epoch(&(work->live_aec));
                    NUWAX_RT_DIAG_LOGI(
                        TAG,
                        "live AEC reference epoch reset source=%d/%lu -> %d/%lu frame=%lu",
                        (int)live_aec_reference_provenance.kind,
                        (unsigned long)live_aec_reference_provenance.generation,
                        (int)frame_reference_provenance.kind,
                        (unsigned long)frame_reference_provenance.generation,
                        (unsigned long)captured_frames);
                }
                live_aec_reference_provenance =
                    frame_reference_provenance;
            }
            if (frame_reference_provenance.kind ==
                    NUWAX_AEC_PROVENANCE_SOFTWARE &&
                frame_software_ref_generation > 0U &&
                frame_software_ref_generation !=
                    live_aec_software_ref_generation) {
                if (live_aec_software_ref_generation > 0U) {
                    NUWAX_RT_DIAG_LOGI(TAG,
                         "live AEC software reference generation changed old=%lu new=%lu frame=%lu",
                             (unsigned long)live_aec_software_ref_generation,
                             (unsigned long)frame_software_ref_generation,
                             (unsigned long)captured_frames);
                }
                live_aec_software_ref_generation =
                    frame_software_ref_generation;
                software_ref_generation_changed = true;
            }
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
            if (frame_reference_provenance.kind ==
                    NUWAX_AEC_PROVENANCE_SOFTWARE &&
                frame_software_fir_ref_full &&
                frame_software_fir_ref_delay_revision != 0U) {
                if (live_aec_fir_ref_delay_revision == 0U) {
                    live_aec_fir_ref_delay_revision =
                        frame_software_fir_ref_delay_revision;
                    live_aec_fir_ref_delay_samples =
                        frame_software_fir_ref_delay_samples;
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "AEC_FIR_DELAY dsp_baseline frame=%lu delay=%lu revision=%lu main_delay=%d",
                             (unsigned long)capture_sequence,
                             (unsigned long)live_aec_fir_ref_delay_samples,
                             (unsigned long)live_aec_fir_ref_delay_revision,
                             CONFIG_NUWAX_LIVE_AEC_REF_DELAY_SAMPLES);
                } else if (frame_software_fir_ref_delay_revision !=
                           live_aec_fir_ref_delay_revision) {
                    fir_ref_delay_revision_changed = true;
                    const bool fir_ready_before =
                        (work->live_aec).human_rescue_fir_ready;
                    const size_t pending_before = (work->live_aec).pending_count;
                    if (!software_ref_generation_changed) {
                        nuwax_live_aec_reset_reference_epoch(&(work->live_aec));
                    }
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "AEC_FIR_DELAY dsp_handoff frame=%lu generation=%lu old=%lu new=%lu revision=%lu->%lu reset=%s fir_ready_before=%d pending=%u main_delay=%d",
                             (unsigned long)capture_sequence,
                             (unsigned long)frame_software_ref_generation,
                             (unsigned long)live_aec_fir_ref_delay_samples,
                             (unsigned long)frame_software_fir_ref_delay_samples,
                             (unsigned long)live_aec_fir_ref_delay_revision,
                             (unsigned long)frame_software_fir_ref_delay_revision,
                             software_ref_generation_changed
                                 ? "covered_by_generation"
                                 : "fir_hard",
                             fir_ready_before ? 1 : 0,
                             (unsigned)pending_before,
                             CONFIG_NUWAX_LIVE_AEC_REF_DELAY_SAMPLES);
                    live_aec_fir_ref_delay_revision =
                        frame_software_fir_ref_delay_revision;
                    live_aec_fir_ref_delay_samples =
                        frame_software_fir_ref_delay_samples;
                }
            }
#endif
            if (frame_reference_provenance.kind ==
                    NUWAX_AEC_PROVENANCE_SOFTWARE &&
                frame_software_ref_anchor_events > 0U &&
                frame_software_ref_anchor_events !=
                    live_aec_software_ref_anchor_events) {
                if (live_aec_software_ref_anchor_events > 0U &&
                    !software_ref_generation_changed &&
                    !fir_ref_delay_revision_changed) {
                    const bool model_preserved =
                        nuwax_live_aec_reanchor_reference(&(work->live_aec));
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "live AEC software reference cursor reanchor old=%llu new=%llu frame=%lu model=%s",
                             (unsigned long long)
                                 live_aec_software_ref_anchor_events,
                             (unsigned long long)
                                 frame_software_ref_anchor_events,
                             (unsigned long)captured_frames,
                             model_preserved ? "preserved" : "retrain");
                }
                live_aec_software_ref_anchor_events =
                    frame_software_ref_anchor_events;
            }

            const nuwax_mic_level_t aec_input_raw_level =
                nuwax_mic_level_measure(s_audio_samples, samples_read);
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
            const nuwax_mic_level_t aec_input_mic2_level =
                nuwax_mic_level_measure(s_audio_mic2_samples, samples_read);
            const nuwax_dual_mic_features_t aec_input_dual =
                compute_dual_mic_features(s_audio_samples,
                                          s_audio_mic2_samples,
                                          samples_read,
                                          aec_input_raw_level,
                                          aec_input_mic2_level);
            const bool aec_input_preserve =
                dual_mic_aec_preserve_hint(aec_input_dual,
                                           aec_input_raw_level,
                                           aec_input_mic2_level) ||
                aec_input_dual.voice_like ||
                (playback_active &&
                 dual_mic_playback_raw_human_hint(aec_input_dual,
                                                  aec_input_raw_level,
                                                  aec_input_mic2_level));
#else
            const bool aec_input_preserve =
                nuwax_mic_level_is_speech(aec_input_raw_level);
#endif
            const bool aec_input_confirmed =
                playback_active && playback_human_seed_seen &&
                playback_human_seed_hangover_remaining > 0U;
            nuwax_live_aec_set_human_protection(
                &(work->live_aec),
                playback_active && aec_input_preserve &&
                    !aec_input_confirmed,
                playback_active && aec_input_preserve &&
                    !aec_input_confirmed,
                aec_input_confirmed);
            nuwax_live_aec_set_nearend_hint(&(work->live_aec),
                                            aec_input_preserve,
                                            aec_input_confirmed ||
                                                aec_input_preserve);

#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
            frame_aec_process_attempted = true;
            if (playback_active) {
                frame_aec_process_result =
                    nuwax_live_aec_process_with_refs_and_dual_mic(
                        &(work->live_aec),
                        s_audio_samples,
                        s_audio_mic2_samples,
                        s_audio_ref_samples,
                        s_audio_fir_ref_samples,
                        samples_read,
                        true);
            } else {
                frame_aec_process_result =
                    nuwax_live_aec_process_with_dual_mic(
                        &(work->live_aec),
                        s_audio_samples,
                        s_audio_mic2_samples,
                        samples_read,
                        false);
            }
#else
            frame_aec_process_attempted = true;
            frame_aec_process_result = have_aec_ref
                                           ? nuwax_live_aec_process_with_ref(
                                                 &(work->live_aec),
                                                 s_audio_samples,
                                                 s_audio_ref_samples,
                                                 samples_read,
                                                 playback_active)
                                           : nuwax_live_aec_process(
                                                 &(work->live_aec),
                                                 s_audio_samples,
                                                 samples_read,
                                                 playback_active);
#endif
            metrics_record_duration(NUWAX_CONVERSATION_LATENCY_DSP_AEC,
                                    aec_phase_started_us,
                                    (uint64_t)esp_timer_get_time());
            if (frame_aec_process_result != ESP_OK) {
                live_aec_runtime_faulted = true;
                result = frame_aec_process_result;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "live AEC processing failed seq=%lu: %s",
                         (unsigned long)capture_sequence,
                         esp_err_to_name(frame_aec_process_result));
                break;
            }
        }

        if (!nuwax_live_aec_output_emitted(&(work->live_aec))) {
            aec_alignment_startup_frames++;
            continue;
        }
        if (aec_alignment_count == 0U) {
            ESP_LOGE(TAG,
                     "AEC emitted audio without a capture context seq=%lu",
                     (unsigned long)capture_sequence);
            result = ESP_ERR_INVALID_STATE;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
            break;
        }
        memcpy(s_audio_aec_samples,
               s_audio_samples,
               samples_read * sizeof(s_audio_aec_samples[0]));

        nuwax_aec_alignment_context_t *aligned_context =
            &aec_alignment_contexts[aec_alignment_read];
        if (aligned_context->meta.samples_read != samples_read) {
            ESP_LOGE(TAG,
                     "AEC output/context size mismatch output=%u context=%u seq=%lu",
                     (unsigned)samples_read,
                     (unsigned)aligned_context->meta.samples_read,
                     (unsigned long)aligned_context->meta.seq);
            result = ESP_ERR_INVALID_SIZE;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
            break;
        }
        aec_alignment_read =
            (aec_alignment_read + 1U) % NUWAX_AEC_ALIGNMENT_CONTEXT_CAPACITY;
        aec_alignment_count--;

        err = aligned_context->meta.err;
        samples_read = aligned_context->meta.samples_read;
        capture_sequence = aligned_context->meta.seq;
#if !CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        have_aec_ref = aligned_context->meta.have_aec_ref;
#endif
        frame_raw_stats = aligned_context->meta.raw_stats;
        speaker_pending = aligned_context->meta.speaker_pending;
        speaker_session_active =
            aligned_context->meta.speaker_session_active;
        speaker_submitted_generation =
            aligned_context->meta.speaker_submitted_generation;
        speaker_volume_generation =
            aligned_context->meta.speaker_volume_generation;
        speaker_volume_percent = aligned_context->meta.speaker_volume_percent;
        speaker_playback_snapshot_stable =
            aligned_context->meta.speaker_playback_snapshot_stable;
        speaker_volume_snapshot_stable =
            aligned_context->meta.speaker_volume_snapshot_stable;
        speaker_completed_stop_generation =
            aligned_context->meta.speaker_completed_stop_generation;
        speaker_completed_stop_timestamp_us =
            aligned_context->meta.speaker_completed_stop_timestamp_us;
        speaker_completed_stop_result =
            aligned_context->meta.speaker_completed_stop_result;
        speaker_stop_fault_active =
            aligned_context->meta.speaker_stop_fault_active;
        speaker_failed_stop_generation =
            aligned_context->meta.speaker_failed_stop_generation;
        speaker_failed_stop_timestamp_us =
            aligned_context->meta.speaker_failed_stop_timestamp_us;
        speaker_failed_stop_result =
            aligned_context->meta.speaker_failed_stop_result;
        frame_capture_finished_us = aligned_context->meta.read_finished_us;
        frame_software_ref_anchor_events =
            aligned_context->meta.software_ref_anchor_events;
        frame_software_ref_generation =
            aligned_context->meta.software_ref_generation;
        frame_reference_provenance =
            aligned_context->meta.reference_provenance;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
        frame_software_fir_ref_full =
            aligned_context->meta.software_fir_ref_full;
        frame_software_fir_ref_delay_samples =
            aligned_context->meta.software_fir_ref_delay_samples;
        frame_software_fir_ref_delay_revision =
            aligned_context->meta.software_fir_ref_delay_revision;
#endif
#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
        frame_software_ref_epoch_valid =
            aligned_context->meta.software_ref_epoch_valid;
        frame_software_ref_source_end_index =
            aligned_context->meta.software_ref_source_end_index;
        frame_software_ref_phase_error =
            aligned_context->meta.software_ref_phase_error;
#endif
        playback_active = aligned_context->playback_active;
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
        const uint32_t current_adaptive_ws_epoch =
            nuwax_ws_connection_epoch(ws);
        if (current_adaptive_ws_epoch != adaptive_ws_epoch) {
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            nuwax_speech_confirmation_reset(&speech_confirmation);
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
            adaptive_ws_epoch = current_adaptive_ws_epoch;
            ESP_LOGW(TAG,
                     "adaptive endpoint disabled for current audio session after WebSocket epoch change");
        }
        if (playback_active && !adaptive_previous_playback_active) {
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
        }
        adaptive_previous_playback_active = playback_active;
#endif
        capture_sequence_contiguous =
            aligned_context->capture_sequence_contiguous;
        const uint32_t aligned_capture_gap_expected_sequence =
            aligned_context->capture_gap_expected_sequence;
        const uint32_t aligned_capture_gap_frames =
            aligned_context->capture_gap_frames;
        barge_post_stop_guard_frame =
            aligned_context->barge_post_stop_guard_frame;
        memcpy(s_audio_samples,
               aligned_context->mic1,
               samples_read * sizeof(s_audio_samples[0]));
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        memcpy(s_audio_mic2_samples,
               aligned_context->mic2,
               samples_read * sizeof(s_audio_mic2_samples[0]));
        memcpy(s_audio_ref_samples,
               aligned_context->ref,
               samples_read * sizeof(s_audio_ref_samples[0]));
        memcpy(s_audio_hw_ref_samples,
               aligned_context->hw_ref,
               samples_read * sizeof(s_audio_hw_ref_samples[0]));
        memcpy(s_audio_fir_ref_samples,
               aligned_context->fir_ref,
               samples_read * sizeof(s_audio_fir_ref_samples[0]));
#endif
        if (!capture_sequence_contiguous && during_playback_mode &&
            nuwax_capture_phase_may_discard_uncommitted_candidate(
                during_playback_mode,
                upload_started || barge_protocol_enqueued ||
                    barge_protocol_listen_committed)) {
            /* Frames before this boundary can no longer form a trustworthy
             * onset-to-live span. Reset only speculative local evidence; the
             * current aligned frame is stored below as the first frame of a
             * fresh preroll timeline. */
            preroll_write = 0U;
            preroll_count = 0U;
            vad_speech_seen = false;
            vad_speech_frames = 0U;
            vad_silence_frames = 0U;
            vad_candidate_start_valid = false;
            nuwax_speech_confirmation_reset(&speech_confirmation);
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
#endif
            playback_human_nearfield_onset_valid = false;
            playback_human_preroll_repair_pending = false;
            playback_human_candidate_streak = 0U;
            playback_human_candidate_gap_frames = 0U;
            playback_human_candidate_mic_avg_sum = 0U;
            playback_human_candidate_mic_peak_sum = 0U;
            playback_human_candidate_start_valid = false;
            playback_human_seed_seen = false;
            playback_human_seed_hangover_remaining = 0U;
            barge_event_initialized = false;
            barge_local_cancel_requested = false;
            barge_controller_confirmed = false;
            barge_stop_request_armed = false;
            barge_physical_stop_observed = false;
            barge_post_cancel_guard_started = false;
            barge_physical_stop_timestamp_us = 0U;
            barge_stop_requested_timestamp_us = 0U;
            barge_stop_playback_generation = 0U;
            barge_playback_connection_epoch = 0U;
            barge_controller_candidate_id = 0U;
            barge_event_onset_sequence = 0U;
            barge_event_confirmed_sequence = 0U;
            barge_event_id[0] = '\0';
            barge_audio_session_id[0] = '\0';
            barge_parent_turn_id[0] = '\0';
            barge_playback_id[0] = '\0';
            barge_probe_active = false;
            barge_probe_playback_generation = 0U;
            barge_probe_candidate_id = 0U;
            barge_probe_elapsed_frames = 0U;
            nuwax_barge_controller_reset(&(work->barge_controller));
            nuwax_barge_in_nearfield_tracker_reset(
                &playback_human_nearfield_tracker);
            nuwax_barge_in_nearfield_tracker_reset(
                &playback_human_symmetric_tracker);
            ESP_LOGW(TAG,
                     "playback prelisten sequence boundary reset speculative candidate seq=%lu; capture and WebSocket retained",
                     (unsigned long)capture_sequence);
        } else if (!capture_sequence_contiguous && during_playback_mode &&
                   barge_controller_confirmed) {
            uint32_t repaired_frames = 0U;
            const esp_err_t repair_err =
                repair_confirmed_barge_preroll_gap(
                    capture_sequence,
                    barge_event_onset_sequence,
                    barge_event_confirmed_sequence,
                    upload_started,
                    &preroll_write,
                    &preroll_count,
                    &repaired_frames);
            const bool capture_gap_matches_preroll =
                aligned_capture_gap_frames == repaired_frames &&
                aligned_capture_gap_expected_sequence + repaired_frames ==
                    capture_sequence;
            if (repair_err != ESP_OK || !capture_gap_matches_preroll) {
                rejected_preroll_gap_events++;
                rejected_preroll_gap_frames +=
                    aligned_capture_gap_frames == 0U
                        ? 1U
                        : aligned_capture_gap_frames;
                ESP_LOGE(TAG,
                         "confirmed barge-in capture gap rejected onset_seq=%lu confirmed_seq=%lu expected=%lu actual=%lu gap_frames=%lu upload_started=%d buffered=%lu repair=%s; audio session terminated and WebSocket retained",
                         (unsigned long)barge_event_onset_sequence,
                         (unsigned long)barge_event_confirmed_sequence,
                         (unsigned long)aligned_capture_gap_expected_sequence,
                         (unsigned long)capture_sequence,
                         (unsigned long)aligned_capture_gap_frames,
                         upload_started ? 1 : 0,
                         (unsigned long)preroll_count,
                         esp_err_to_name(repair_err));
                result = repair_err == ESP_OK ? ESP_ERR_INVALID_STATE
                                              : repair_err;
                mic_capture_set_stop_reason(
                    &stop_reason,
                    NUWAX_MIC_CAPTURE_STOP_CAPTURE_SEQUENCE_GAP);
                break;
            }
            repaired_preroll_gap_events++;
            repaired_preroll_gap_frames += repaired_frames;
            ESP_LOGW(TAG,
                     "confirmed barge-in capture gap repaired with forced silence confirmed_seq=%lu expected=%lu actual=%lu repaired_frames=%lu repaired_ms=%lu buffered=%lu",
                     (unsigned long)barge_event_confirmed_sequence,
                     (unsigned long)aligned_capture_gap_expected_sequence,
                     (unsigned long)capture_sequence,
                     (unsigned long)repaired_frames,
                     (unsigned long)(repaired_frames *
                                     CONFIG_NUWAX_VOICE_FRAME_DURATION_MS),
                     (unsigned long)preroll_count);
        }
        if (persistent_conversation_mode &&
            s_during_playback_handoff_pending) {
            if (capture_phase_handoff.phase ==
                    NUWAX_CAPTURE_PHASE_AWAKE_PRELISTEN &&
                !listen_started && !upload_started) {
                if (!nuwax_capture_phase_handoff_request_playback_without_session(
                        &capture_phase_handoff, capture_sequence)) {
                    result = ESP_ERR_INVALID_STATE;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    ESP_LOGE(TAG,
                             "local prelisten to during-playback handoff rejected phase=%d seq=%lu",
                             (int)capture_phase_handoff.phase,
                             (unsigned long)capture_sequence);
                    break;
                }
                s_during_playback_handoff_pending = false;
                s_during_playback_handoff_playback_started = false;
                s_during_playback_handoff_seamless = false;
                nuwax_prelisten_state_start_capture(
                    &s_prelisten, "during_playback", monotonic_ms(),
                    awake_session_listen_window_ms(monotonic_ms()), false);
                persistent_conversation_mode = false;
                during_playback_mode = true;
                s_during_playback_capture_runtime_ready = true;
                ESP_LOGI(TAG,
                         "local prelisten handed off to during-playback without cloud END seq=%lu; WebSocket retained",
                         (unsigned long)capture_sequence);
                continue;
            }
            strlcpy(handoff_old_listen_mode,
                    nuwax_prelisten_state_mode_or(&s_prelisten,
                                                  "awake_session"),
                    sizeof(handoff_old_listen_mode));
            strlcpy(handoff_old_audio_session_id,
                    conversation_audio_session_id,
                    sizeof(handoff_old_audio_session_id));
            handoff_listen_stop.ws = ws;
            strlcpy(handoff_listen_stop.mode,
                    handoff_old_listen_mode,
                    sizeof(handoff_listen_stop.mode));
            strlcpy(handoff_listen_stop.audio_session_id,
                    handoff_old_audio_session_id,
                    sizeof(handoff_listen_stop.audio_session_id));
            if (!nuwax_capture_phase_handoff_request(
                    &capture_phase_handoff,
                    capture_sequence,
                    recorded_frames)) {
                result = ESP_ERR_INVALID_STATE;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "seamless playback handoff state rejected phase=%d seq=%lu",
                         (int)capture_phase_handoff.phase,
                         (unsigned long)capture_sequence);
                break;
            }
            uplink_finish_attempted = true;
            uplink_finish_result =
                nuwax_audio_uplink_request_finish_then(
                    send_ctx,
                    send_seamless_listen_stop_after_end,
                    &handoff_listen_stop,
                    sizeof(handoff_listen_stop));
            if (uplink_finish_result != ESP_OK) {
                nuwax_capture_phase_handoff_fail(&capture_phase_handoff);
                result = uplink_finish_result;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                ESP_LOGE(TAG,
                         "seamless playback handoff could not queue old END session=%s: %s",
                         handoff_old_audio_session_id,
                         esp_err_to_name(uplink_finish_result));
                break;
            }

            handoff_old_session_closing = true;
            handoff_requested_us = esp_timer_get_time();
            s_during_playback_handoff_pending = false;
            s_during_playback_handoff_playback_started = false;
            s_during_playback_handoff_seamless = false;
            const uint32_t handoff_now_ms = monotonic_ms();
            const uint32_t handoff_window_ms =
                awake_session_listen_window_ms(handoff_now_ms);
            nuwax_prelisten_state_start_capture(&s_prelisten,
                                                "during_playback",
                                                handoff_now_ms,
                                                handoff_window_ms,
                                                false);
            metrics_begin_prelisten("during_playback",
                                    "seamless_tts_handoff");
            persistent_conversation_mode = false;
            during_playback_mode = true;
            confirmed_speech_us = 0;
            last_confirmed_speech_us = 0;
            continuous_utterance_limit_ms =
                NUWAX_CONVERSATION_UTTERANCE_SOFT_LIMIT_MS;
            upload_started = false;
            s_during_playback_capture_runtime_ready = true;
            started_us = handoff_requested_us;
            recorded_samples = 0U;
            recorded_frames = 0U;
            captured_frames = 0U;
            sent_frames = 0U;
            queued_frames = 0U;
            dropped_frames = 0U;
            uplink_backpressure_boundary = false;
            stop_requested = false;
            max_duration_reached = false;
            stop_reason = NUWAX_MIC_CAPTURE_STOP_NONE;
            vad_speech_frames = 0U;
            vad_silence_frames = 0U;
            vad_candidate_start_valid = false;
            vad_candidate_start_sequence = 0U;
            vad_speech_seen = false;
            nuwax_speech_confirmation_reset(&speech_confirmation);
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
#endif
            cloud_progress_watchdog_armed = false;
            cloud_progress_watchdog_timed_out = false;
            preroll_write = 0U;
            preroll_count = 0U;
            auto_followup_cancelled = false;
            auto_followup_replaced_by_command = false;
            ESP_LOGI(TAG,
                     "seamless playback handoff phase switched at frame boundary seq=%lu old_wire_frames=%lu rt_capture_reused=1 mic_reused=1 aec_reused=1 window_ms=%lu",
                     (unsigned long)capture_sequence,
                     (unsigned long)capture_phase_handoff
                         .frozen_old_wire_frames,
                     (unsigned long)handoff_window_ms);
        }
        if (during_playback_mode &&
            s_post_playback_resume_pending &&
            !handoff_old_session_closing &&
            !upload_started &&
            !listen_started &&
            !barge_protocol_enqueued &&
            !playback_active &&
            !speaker_pending) {
            bool preserve_post_playback_onset =
                vad_speech_seen &&
                playback_human_nearfield_onset_valid &&
                preroll_count > 0U;
            const uint32_t post_playback_onset_sequence =
                playback_human_nearfield_onset_sequence;
            if (preserve_post_playback_onset) {
                result = validate_auto_followup_preroll_for_upload(
                    preroll_write,
                    preroll_count,
                    false,
                    post_playback_onset_sequence,
                    0U,
                    capture_sequence);
                if (result == ESP_ERR_NOT_FOUND &&
                    nuwax_capture_phase_may_discard_uncommitted_candidate(
                        during_playback_mode,
                        upload_started || barge_protocol_enqueued ||
                            barge_protocol_listen_committed)) {
                    ESP_LOGW(TAG,
                             "post-playback onset aged out or crossed a capture gap onset_seq=%lu live_seq=%lu buffered=%lu; discarding speculative preroll and continuing in place",
                             (unsigned long)post_playback_onset_sequence,
                             (unsigned long)capture_sequence,
                             (unsigned long)preroll_count);
                    preserve_post_playback_onset = false;
                    result = ESP_OK;
                } else if (result != ESP_OK) {
                    ESP_LOGE(TAG,
                             "post-playback seamless onset validation failed onset_seq=%lu live_seq=%lu buffered=%lu: %s",
                             (unsigned long)post_playback_onset_sequence,
                             (unsigned long)capture_sequence,
                             (unsigned long)preroll_count,
                             esp_err_to_name(result));
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    break;
                }
            }
            if (!nuwax_capture_phase_handoff_request_awake(
                    &capture_phase_handoff, capture_sequence)) {
                result = ESP_ERR_INVALID_STATE;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "post-playback seamless resume rejected phase=%d seq=%lu",
                         (int)capture_phase_handoff.phase,
                         (unsigned long)capture_sequence);
                break;
            }

            s_post_playback_resume_pending = false;
            s_during_playback_capture_runtime_ready = false;
            reset_awake_wait_budget_paused("seamless_playback_complete");
            const uint32_t resume_now_ms = monotonic_ms();
            const uint32_t resume_window_ms =
                awake_session_listen_window_ms(resume_now_ms);
            nuwax_prelisten_state_start_capture(&s_prelisten,
                                                "awake_session",
                                                resume_now_ms,
                                                resume_window_ms,
                                                false);
            metrics_begin_prelisten("awake_session",
                                    "seamless_playback_complete");
            during_playback_mode = false;
            persistent_conversation_mode = true;
            nuwax_speech_confirmation_reset(&speech_confirmation);
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
#endif
            max_record_samples = SIZE_MAX;
            max_record_ms = resume_window_ms;
            conversation_audio_session_id[0] = '\0';
            make_conversation_audio_session_id(
                conversation_audio_session_id,
                sizeof(conversation_audio_session_id));
            nuwax_listen_resume_state_bind_round(
                &s_listen_resume,
                capture_awake_generation,
                conversation_audio_session_id);
            recorded_samples = 0U;
            recorded_frames = 0U;
            sent_frames = 0U;
            queued_frames = 0U;
            dropped_frames = 0U;
            uplink_backpressure_boundary = false;
            uplink_finish_attempted = false;
            uplink_finish_succeeded = false;
            uplink_finish_result = ESP_ERR_INVALID_STATE;
            set_conversation_status_guarded(
                "VOICE", "LISTENING", "listening", true);
            set_state(NUWAX_APP_STATE_LISTENING);
            uint32_t preserved_resume_frames = 0U;
            if (preserve_post_playback_onset) {
                result = start_mic_cloud_upload(
                    ws,
                    send_ctx,
                    "awake_session",
                    conversation_audio_session_id,
                    NULL,
                    max_record_samples,
                    max_record_ms,
                    &listen_started,
                    &upload_started_us,
                    false,
                    false);
                if (result != ESP_OK) {
                    nuwax_capture_phase_handoff_fail(&capture_phase_handoff);
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
                upload_started = true;
                if (!nuwax_capture_phase_handoff_promote_awake_uplink(
                        &capture_phase_handoff)) {
                    result = ESP_ERR_INVALID_STATE;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    ESP_LOGE(TAG,
                             "post-playback preserved onset could not bind awake uplink phase=%d",
                             (int)capture_phase_handoff.phase);
                    break;
                }
                result = send_auto_followup_preroll(
                    send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                    &opus_encoder,
#endif
                    preroll_write,
                    preroll_count,
                    false,
                    post_playback_onset_sequence,
                    capture_sequence,
                    &recorded_frames,
                    &recorded_samples,
                    &queued_frames,
                    &dropped_frames,
                    &preserved_resume_frames);
                if (result != ESP_OK) {
                    ESP_LOGE(TAG,
                             "post-playback preserved onset enqueue failed onset_seq=%lu live_seq=%lu: %s",
                             (unsigned long)post_playback_onset_sequence,
                             (unsigned long)capture_sequence,
                             esp_err_to_name(result));
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
                cloud_progress_watchdog_armed = true;
                cloud_progress_watchdog_epoch =
                    s_conversation_cloud_progress_epoch;
                cloud_progress_watchdog_deadline_ms =
                    monotonic_ms() +
                    NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS;
                ESP_LOGI(TAG,
                         "post-playback preserved speech promoted to cloud uplink onset_seq=%lu preroll_frames=%lu",
                         (unsigned long)post_playback_onset_sequence,
                         (unsigned long)preserved_resume_frames);
            } else {
                vad_speech_frames = 0U;
                vad_silence_frames = 0U;
                vad_candidate_start_valid = false;
                vad_speech_seen = false;
                confirmed_speech_us = 0;
                last_confirmed_speech_us = 0;
                continuous_utterance_limit_ms =
                    NUWAX_CONVERSATION_UTTERANCE_SOFT_LIMIT_MS;
                nuwax_speech_confirmation_reset(&speech_confirmation);
                nuwax_speech_confirmation_reset(&weak_start_confirmation);
                nuwax_short_speech_tracker_reset(&short_speech_tracker);
                nuwax_conversation_correlated_weak_reset(
                    &correlated_weak);
                resume_awake_waiting("seamless_playback_complete");
                ESP_LOGI(TAG,
                         "post-playback local prelisten resumed upload_gate=speech_confirmation");
            }
            preroll_write = 0U;
            preroll_count = 0U;
            barge_event_initialized = false;
            barge_local_cancel_requested = false;
            barge_controller_confirmed = false;
            barge_stop_request_armed = false;
            barge_physical_stop_observed = false;
            barge_post_cancel_guard_started = false;
            barge_protocol_enqueued = false;
            barge_protocol_listen_committed = false;
            barge_event_id[0] = '\0';
            barge_audio_session_id[0] = '\0';
            barge_parent_turn_id[0] = '\0';
            barge_playback_id[0] = '\0';
            nuwax_barge_controller_reset(&(work->barge_controller));
            nuwax_barge_in_nearfield_tracker_reset(
                &playback_human_nearfield_tracker);
            nuwax_barge_in_nearfield_tracker_reset(
                &playback_human_symmetric_tracker);
            playback_human_nearfield_onset_valid = false;
            playback_human_preroll_repair_pending = false;
            started_us = esp_timer_get_time();
            auto_followup_cancelled = false;
            auto_followup_replaced_by_command = false;
            ESP_LOGI(TAG,
                     "post-playback seamless resume committed at frame boundary seq=%lu preserved_onset_frames=%lu cloud_uplink=%d rt_capture_reused=1 mic_reused=1 aec_reused=1",
                     (unsigned long)capture_sequence,
                     (unsigned long)preserved_resume_frames,
                     upload_started ? 1 : 0);
        }
        const uint64_t human_detector_started_us =
            (uint64_t)esp_timer_get_time();

        if (!stop_requested && poll_mic_stop_action(ws)) {
            stop_requested = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_RELEASE);
            ESP_LOGI(TAG, "mic stop requested by release frames_recorded=%lu", (unsigned long)captured_frames);
        }
        elapsed_since_start_ms = (esp_timer_get_time() - started_us) / 1000;
        elapsed_since_upload_ms = upload_started ? (esp_timer_get_time() - upload_started_us) / 1000 : 0;
        if (upload_started && !persistent_conversation_mode &&
            !max_duration_reached &&
            elapsed_since_upload_ms >= max_record_ms) {
            max_duration_reached = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MAX_DURATION);
        }

        if (acceptance_capture_enabled && acceptance_capture.raw_mic1 && samples_read > 0) {
            memcpy(s_audio_raw_mic1_samples,
                   s_audio_samples,
                   samples_read * sizeof(s_audio_raw_mic1_samples[0]));
        }
        if (acceptance_capture_enabled && acceptance_capture.raw_fir_ref_pair && samples_read > 0) {
            const size_t pair_frames = samples_read / 2U;
            for (size_t i = 0; i < pair_frames; i++) {
                const size_t source = i * 2U;
                s_audio_raw_fir_ref_pair[i * 2U] = s_audio_samples[source];
                s_audio_raw_fir_ref_pair[i * 2U + 1U] = s_audio_fir_ref_samples[source];
            }
        }
        if (acceptance_capture_enabled && acceptance_capture.raw_hw_ref_pair &&
            samples_read > 0) {
            const size_t pair_frames = samples_read / 2U;
            for (size_t i = 0; i < pair_frames; i++) {
                const size_t source = i * 2U;
                s_audio_raw_hw_ref_pair[i * 2U] = s_audio_samples[source];
                s_audio_raw_hw_ref_pair[i * 2U + 1U] =
                    s_audio_hw_ref_samples[source];
            }
        }
        if (samples_read > 0) {
            memcpy(s_audio_human_rescue_source,
                   s_audio_samples,
                   samples_read * sizeof(s_audio_human_rescue_source[0]));
        }
        const nuwax_mic_level_t raw_level =
            samples_read > 0 ? nuwax_mic_level_measure(s_audio_samples, samples_read) : (nuwax_mic_level_t){0};
        const nuwax_mic_level_t playback_ref_level =
            (playback_active && samples_read > 0)
                ? nuwax_mic_level_measure(s_audio_ref_samples, samples_read)
                : (nuwax_mic_level_t){0};
        const bool playback_ref_active =
            playback_ref_level.avg_abs >= NUWAX_HW_REF_ACTIVE_MIN_AVG_ABS ||
            playback_ref_level.peak >= NUWAX_HW_REF_ACTIVE_MIN_PEAK;
        const bool reference_source_present =
            frame_reference_provenance.snapshot;
        const bool reference_epoch_contiguous =
            nuwax_aec_reference_epoch_contiguous(
                frame_reference_provenance,
                barge_reference_source,
                capture_sequence_contiguous);
        const bool playback_silent_reference_expected =
            playback_active &&
            speaker_volume_percent <= 5U &&
            !playback_ref_active &&
            reference_source_present &&
            reference_epoch_contiguous;
        const uint32_t playback_mic_ref_corr_q15 =
            playback_ref_active ? compute_abs_corr_q15(s_audio_samples, s_audio_ref_samples, samples_read) : 0;
        if (playback_ref_active) {
            playback_ref_active_frames++;
        }
        if (playback_mic_ref_corr_q15 > playback_ref_corr_q15_max) {
            playback_ref_corr_q15_max = playback_mic_ref_corr_q15;
        }
        nuwax_dual_mic_features_t dual_mic = {0};
        bool dual_mic_aec_hint = false;
        bool dual_mic_cleaner_hint = false;
        bool playback_raw_human_hint = false;
        bool playback_weak_continuity_hint = false;
        bool playback_provisional_human_hint = false;
        bool playback_human_strong_hint = false;
        bool dual_mic_human_first_hint = false;
        bool playback_echo_veto = false;
        bool playback_dual_onset_guard = false;
        bool barge_voice_like_evidence = false;
        bool barge_spatial_imbalanced_evidence = false;
        bool barge_spatial_symmetric_evidence = false;
        bool barge_echo_candidate = false;
        bool playback_human_seed_active = playback_active &&
                                          playback_human_seed_seen &&
                                          playback_human_seed_hangover_remaining > 0;
#if CONFIG_NUWAX_BOARD_ESP_VOCAT_V1_0
        const nuwax_mic_level_t mic2_level =
            samples_read > 0 ? nuwax_mic_level_measure(s_audio_mic2_samples, samples_read) : (nuwax_mic_level_t){0};
        const bool mic2_speech_like =
            samples_read > 0 && nuwax_mic_level_is_speech(mic2_level);
        if (mic2_speech_like) {
            mic2_speech_like_frames++;
        }
        if (samples_read > 0) {
            dual_mic = compute_dual_mic_features(s_audio_samples,
                                                 s_audio_mic2_samples,
                                                 samples_read,
                                                 raw_level,
                                                 mic2_level);
            if (dual_mic.voice_like) {
                dual_mic_voice_like_frames++;
            }
            if (dual_mic.diff_avg_abs > dual_mic_diff_avg_abs_max) {
                dual_mic_diff_avg_abs_max = dual_mic.diff_avg_abs;
            }
            if (dual_mic.diff_energy_ratio_q15 > dual_mic_diff_energy_ratio_q15_max) {
                dual_mic_diff_energy_ratio_q15_max = dual_mic.diff_energy_ratio_q15;
            }
            if (dual_mic.level_balance_q15 < dual_mic_level_balance_q15_min) {
                dual_mic_level_balance_q15_min = dual_mic.level_balance_q15;
            }
            dual_mic_aec_hint = dual_mic_aec_preserve_hint(dual_mic, raw_level, mic2_level);
            dual_mic_cleaner_hint = dual_mic_cleaner_preserve_hint(dual_mic, raw_level, mic2_level);
            playback_raw_human_hint =
                playback_active &&
                dual_mic_playback_raw_human_hint(dual_mic, raw_level, mic2_level);
            const bool onset_human_evidence =
                dual_mic.voice_like ||
                dual_mic_aec_hint ||
                dual_mic_cleaner_hint ||
                playback_raw_human_hint;
            const bool strong_human_evidence =
                dual_mic.voice_like ||
                dual_mic_aec_hint ||
                dual_mic_cleaner_hint;
            const bool playback_ref_echo_candidate =
                playback_active &&
                playback_ref_active &&
                playback_mic_ref_corr_q15 >= NUWAX_PLAYBACK_REF_ECHO_VETO_CORR_Q15 &&
                dual_mic.diff_energy_ratio_q15 < NUWAX_PLAYBACK_REF_ECHO_VETO_DIFF_ENERGY_Q15;
            const bool playback_spatial_echo_candidate =
                playback_active &&
                playback_ref_active &&
                playback_mic_ref_corr_q15 >= NUWAX_PLAYBACK_REF_SPATIAL_ECHO_MIN_CORR_Q15 &&
                dual_mic.valid &&
                dual_mic.level_balance_q15 >= NUWAX_PLAYBACK_REF_SPATIAL_ECHO_MIN_BALANCE_Q15 &&
                dual_mic.diff_avg_abs <= NUWAX_PLAYBACK_REF_SPATIAL_ECHO_MAX_DIFF_AVG_ABS &&
                dual_mic.diff_peak <= NUWAX_PLAYBACK_REF_SPATIAL_ECHO_MAX_DIFF_PEAK &&
                dual_mic.diff_energy_ratio_q15 <= NUWAX_PLAYBACK_REF_SPATIAL_ECHO_MAX_DIFF_ENERGY_Q15;
            const bool seed_near_field_spatial =
                dual_mic.level_balance_q15 > 0 &&
                dual_mic.level_balance_q15 <= NUWAX_DUAL_MIC_NEAREND_IMBALANCE_BALANCE_Q15 &&
                dual_mic.diff_energy_ratio_q15 >= NUWAX_DUAL_MIC_NEAREND_STRONG_DIFF_ENERGY_Q15;
            const bool seed_level_plausible =
                raw_level.avg_abs >= NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_AVG_ABS &&
                raw_level.peak >= NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_PEAK &&
                ((raw_level.avg_abs <= NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_MIC1_AVG_ABS &&
                  raw_level.peak <= NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_MIC1_PEAK) ||
                 seed_near_field_spatial);
            const bool seed_ref_plausible =
                (playback_ref_active &&
                 (playback_mic_ref_corr_q15 < NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_REF_CORR_Q15 ||
                  seed_near_field_spatial)) ||
                playback_silent_reference_expected;
            const bool playback_human_seed_evidence =
                playback_active &&
                strong_human_evidence &&
                seed_level_plausible &&
                seed_ref_plausible &&
                ((!playback_ref_echo_candidate && !playback_spatial_echo_candidate) ||
                 seed_near_field_spatial);
            /* Quiet speech onsets need an anchor independent of the high voice_like floor. */
            const bool playback_human_low_level_spatial_anchor =
                playback_human_seed_evidence &&
                dual_mic_aec_hint &&
                raw_level.avg_abs >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_MIC1_AVG_ABS &&
                raw_level.peak >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_MIC1_PEAK &&
                dual_mic.diff_avg_abs >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_AVG_ABS &&
                dual_mic.diff_peak >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_PEAK &&
                dual_mic.diff_energy_ratio_q15 >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_ENERGY_Q15 &&
                dual_mic.level_balance_q15 >=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_BALANCE_Q15 &&
                dual_mic.level_balance_q15 <=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MAX_BALANCE_Q15 &&
                playback_mic_ref_corr_q15 <=
                    NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MAX_REF_CORR_Q15 &&
                (uint64_t)dual_mic.diff_peak * 32768ULL >=
                    (uint64_t)raw_level.peak *
                        NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15;
            const uint32_t playback_human_candidate_count_before =
                playback_human_candidate_streak;
            const uint32_t playback_human_candidate_gap_before =
                playback_human_candidate_gap_frames;
            const bool playback_human_anchor_spatial_quality =
                dual_mic.voice_like &&
                dual_mic.diff_peak >= NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_DIFF_PEAK &&
                (uint64_t)dual_mic.diff_peak * 32768ULL >=
                    (uint64_t)raw_level.peak *
                        NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15;
            const bool playback_human_separated_anchor =
                playback_human_seed_evidence &&
                playback_human_candidate_count_before > 0 &&
                playback_human_candidate_gap_before >=
                    NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_PRECEDING_GAP_FRAMES &&
                playback_human_anchor_spatial_quality;
            const bool playback_human_exceptional_anchor =
                playback_human_seed_evidence &&
                dual_mic.voice_like &&
                raw_level.peak >= NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_MIC_PEAK &&
                dual_mic.diff_peak >= NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_DIFF_PEAK &&
                (uint64_t)dual_mic.diff_peak * 32768ULL >=
                    (uint64_t)raw_level.peak *
                        NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15 &&
                dual_mic.level_balance_q15 >=
                    NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_BALANCE_Q15 &&
                dual_mic.diff_energy_ratio_q15 <=
                    NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MAX_DIFF_ENERGY_Q15;
            /* A sustained candidate can still be genuine speech when the user
             * reaches both microphones almost equally. Admit that case only on
             * a high-energy voice-shaped frame that is weakly reference-correlated. */
            const bool playback_human_voice_anchor =
                playback_human_seed_evidence &&
                dual_mic.voice_like &&
                playback_human_candidate_count_before >=
                    NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_PRIOR_CANDIDATES &&
                raw_level.avg_abs >= NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_MIC1_AVG_ABS &&
                raw_level.peak >= NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_MIC1_PEAK &&
                dual_mic.diff_avg_abs >= NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_AVG_ABS &&
                dual_mic.diff_peak >= NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_PEAK &&
                playback_mic_ref_corr_q15 <= NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MAX_REF_CORR_Q15 &&
                (uint64_t)dual_mic.diff_peak * 32768ULL >=
                    (uint64_t)raw_level.peak *
                        NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15;
            const nuwax_barge_in_nearfield_features_t nearfield_features = {
                .seed_evidence = playback_human_seed_evidence,
                .ref_active = playback_ref_active,
                .silent_reference_expected =
                    playback_silent_reference_expected,
                .echo_candidate = playback_ref_echo_candidate ||
                                  playback_spatial_echo_candidate,
                .voice_like = dual_mic.voice_like,
                .mic1_avg_abs = raw_level.avg_abs,
                .mic1_peak = raw_level.peak,
                .mic2_avg_abs = mic2_level.avg_abs,
                .mic2_peak = mic2_level.peak,
                .diff_avg_abs = dual_mic.diff_avg_abs,
                .diff_peak = dual_mic.diff_peak,
                .diff_energy_q15 = dual_mic.diff_energy_ratio_q15,
                .balance_q15 = dual_mic.level_balance_q15,
                .ref_corr_q15 = playback_mic_ref_corr_q15,
            };
            if (!playback_active) {
                nuwax_barge_in_nearfield_tracker_reset(
                    &playback_human_nearfield_tracker);
                nuwax_barge_in_nearfield_tracker_reset(
                    &playback_human_symmetric_tracker);
            }
            const nuwax_barge_in_nearfield_kind_t playback_human_nearfield_kind =
                nuwax_barge_in_nearfield_classify(&nearfield_features);
            barge_voice_like_evidence = strong_human_evidence;
            barge_spatial_imbalanced_evidence =
                playback_human_nearfield_kind ==
                NUWAX_BARGE_IN_NEARFIELD_IMBALANCED;
            barge_spatial_symmetric_evidence =
                playback_human_nearfield_kind ==
                NUWAX_BARGE_IN_NEARFIELD_SYMMETRIC_HIGH_ENERGY;
            barge_echo_candidate = playback_ref_echo_candidate ||
                                   playback_spatial_echo_candidate;
            const bool playback_human_nearfield_candidate =
                playback_human_nearfield_kind != NUWAX_BARGE_IN_NEARFIELD_NONE;
#if CONFIG_NUWAX_BARGE_IN_CLOUD_GUARDED_HIGH_RECALL
            const bool playback_human_cloud_guarded_anchor =
                nuwax_barge_in_cloud_guarded_high_recall_anchor(
                    playback_human_nearfield_kind,
                    true);
#else
            const bool playback_human_cloud_guarded_anchor = false;
#endif
            const bool playback_human_imbalanced_anchor =
                nuwax_barge_in_nearfield_tracker_update(
                    &playback_human_nearfield_tracker,
                    playback_human_nearfield_kind ==
                        NUWAX_BARGE_IN_NEARFIELD_IMBALANCED,
                    capture_sequence);
            const bool playback_human_symmetric_support =
                playback_human_seed_evidence &&
                (playback_ref_active ||
                 playback_silent_reference_expected) &&
                !playback_ref_echo_candidate &&
                !playback_spatial_echo_candidate &&
                strong_human_evidence;
            const bool symmetric_continuity_was_armed =
                playback_human_symmetric_tracker.continuity_armed;
            const uint32_t symmetric_support_count_before =
                playback_human_symmetric_tracker.continuity_support_count;
            const bool playback_human_symmetric_anchor =
                nuwax_barge_in_symmetric_tracker_update_with_support(
                    &playback_human_symmetric_tracker,
                    playback_human_nearfield_kind ==
                        NUWAX_BARGE_IN_NEARFIELD_SYMMETRIC_HIGH_ENERGY,
                    playback_human_symmetric_support,
                    capture_sequence);
            /* The symmetric tracker deliberately accepts two strong,
             * echo-vetoed support frames after a strict onset. Carry those
             * frames into the controller as symmetric spatial evidence so
             * its continuity gate observes the same accepted sequence. */
            if (symmetric_continuity_was_armed &&
                playback_human_symmetric_support) {
                barge_spatial_symmetric_evidence = true;
            }
            if (playback_human_symmetric_tracker.continuity_support_count >
                symmetric_support_count_before) {
                NUWAX_RT_DIAG_LOGI(TAG,
                         "playback symmetric continuation seq=%lu capture_seq=%lu onset_seq=%lu support_run=%lu/%u",
                         (unsigned long)captured_frames,
                         (unsigned long)capture_sequence,
                         (unsigned long)playback_human_symmetric_tracker.first_candidate_sequence,
                         (unsigned long)playback_human_symmetric_tracker.continuity_support_count,
                         (unsigned)NUWAX_BARGE_IN_SYMMETRIC_SUPPORT_CONFIRM_COUNT);
            } else if (symmetric_continuity_was_armed &&
                       !playback_human_symmetric_tracker.continuity_armed &&
                       !playback_human_symmetric_anchor) {
                NUWAX_RT_DIAG_LOGI(TAG,
                         "playback symmetric continuation reset seq=%lu capture_seq=%lu strict=%d support=%d",
                         (unsigned long)captured_frames,
                         (unsigned long)capture_sequence,
                         playback_human_nearfield_kind ==
                                 NUWAX_BARGE_IN_NEARFIELD_SYMMETRIC_HIGH_ENERGY
                             ? 1
                             : 0,
                         playback_human_symmetric_support ? 1 : 0);
            }
            const bool playback_human_nearfield_anchor =
                playback_human_imbalanced_anchor || playback_human_symmetric_anchor;
            const nuwax_barge_in_nearfield_tracker_t *confirmed_nearfield_tracker =
                playback_human_symmetric_anchor ? &playback_human_symmetric_tracker
                                                : &playback_human_nearfield_tracker;
            const char *playback_human_nearfield_kind_name =
                playback_human_nearfield_kind ==
                        NUWAX_BARGE_IN_NEARFIELD_SYMMETRIC_HIGH_ENERGY
                    ? "symmetric_high_energy"
                    : (playback_human_nearfield_kind ==
                               NUWAX_BARGE_IN_NEARFIELD_IMBALANCED
                           ? "imbalanced"
                           : "none");
            const char *playback_human_anchor_kind_name =
                playback_human_symmetric_anchor
                    ? "symmetric_supported_onset"
                    : (playback_human_imbalanced_anchor ? "imbalanced_pair" : "none");
            const bool playback_human_spatial_anchor =
                playback_human_separated_anchor ||
                playback_human_exceptional_anchor ||
                playback_human_low_level_spatial_anchor ||
                playback_human_voice_anchor ||
                playback_human_nearfield_anchor ||
                playback_human_cloud_guarded_anchor;
            if (playback_human_spatial_anchor) {
                playback_human_spatial_anchor_frames++;
            }
            if (playback_human_separated_anchor) {
                playback_human_separated_anchor_frames++;
            }
            if (playback_human_exceptional_anchor) {
                playback_human_exceptional_anchor_frames++;
            }
            if (playback_human_low_level_spatial_anchor) {
                playback_human_low_level_anchor_frames++;
            }
            if (playback_human_voice_anchor) {
                playback_human_voice_anchor_frames++;
            }
            if (playback_human_nearfield_candidate) {
                playback_human_nearfield_candidate_frames++;
                if (!playback_human_nearfield_candidate_logged) {
                    playback_human_nearfield_candidate_logged = true;
                NUWAX_RT_DIAG_LOGI(TAG,
                         "playback nearfield human potential seq=%lu capture_seq=%lu kind=%s mic1=%lu/%lu mic2=%lu/%lu diff=%lu/%lu diff_energy_q15=%lu balance_q15=%lu ref_corr_q15=%lu",
                             (unsigned long)captured_frames,
                             (unsigned long)capture_sequence,
                             playback_human_nearfield_kind_name,
                             (unsigned long)raw_level.avg_abs,
                             (unsigned long)raw_level.peak,
                             (unsigned long)mic2_level.avg_abs,
                             (unsigned long)mic2_level.peak,
                             (unsigned long)dual_mic.diff_avg_abs,
                             (unsigned long)dual_mic.diff_peak,
                             (unsigned long)dual_mic.diff_energy_ratio_q15,
                             (unsigned long)dual_mic.level_balance_q15,
                             (unsigned long)playback_mic_ref_corr_q15);
                }
            }
            if (playback_human_cloud_guarded_anchor) {
                playback_human_cloud_guarded_anchor_frames++;
                if (!playback_human_nearfield_onset_valid) {
                    playback_human_nearfield_onset_valid = true;
                    playback_human_nearfield_onset_sequence = capture_sequence;
                }
                if (!playback_human_cloud_guarded_anchor_logged) {
                    playback_human_cloud_guarded_anchor_logged = true;
                NUWAX_RT_DIAG_LOGI(TAG,
                         "playback cloud-guarded high-recall onset admitted seq=%lu capture_seq=%lu kind=%s local_fade=0 cloud_confirmation=1 strict_anchor=%d",
                             (unsigned long)captured_frames,
                             (unsigned long)capture_sequence,
                             playback_human_nearfield_kind_name,
                             playback_human_nearfield_anchor ? 1 : 0);
                }
            }
            if (playback_human_nearfield_anchor) {
                playback_human_nearfield_anchor_frames++;
                if (!playback_human_nearfield_onset_valid) {
                    playback_human_nearfield_onset_valid = true;
                    playback_human_nearfield_onset_sequence =
                        confirmed_nearfield_tracker->first_candidate_sequence;
                }
                if (!playback_human_nearfield_anchor_logged) {
                    playback_human_nearfield_anchor_logged = true;
                NUWAX_RT_DIAG_LOGI(TAG,
                         "playback nearfield human anchor confirmed seq=%lu capture_seq=%lu onset_seq=%lu kind=%s strict_count=%lu support_count=%lu window_frames=%u",
                             (unsigned long)captured_frames,
                             (unsigned long)capture_sequence,
                             (unsigned long)confirmed_nearfield_tracker->first_candidate_sequence,
                             playback_human_anchor_kind_name,
                             (unsigned long)confirmed_nearfield_tracker->candidate_count,
                             (unsigned long)confirmed_nearfield_tracker->continuity_support_count,
                             (unsigned)(playback_human_symmetric_anchor
                                            ? NUWAX_BARGE_IN_SYMMETRIC_CONFIRM_WINDOW_FRAMES
                                            : NUWAX_BARGE_IN_NEARFIELD_CONFIRM_WINDOW_FRAMES));
                }
            }
            playback_human_strong_hint = playback_active && strong_human_evidence;
            if (playback_active && onset_human_evidence) {
                playback_human_onset_evidence_frames++;
            }
            if (playback_human_seed_evidence) {
                playback_human_seed_evidence_frames++;
                playback_human_strong_evidence_frames++;
                if (playback_human_candidate_streak == 0) {
                    playback_human_candidate_start_valid = true;
                    playback_human_candidate_start_sequence = capture_sequence;
                }
                if (playback_human_candidate_streak < UINT32_MAX) {
                    playback_human_candidate_streak++;
                }
                playback_human_candidate_gap_frames = 0;
                playback_human_candidate_mic_avg_sum += raw_level.avg_abs;
                playback_human_candidate_mic_peak_sum += raw_level.peak;
                if (playback_human_candidate_streak > playback_human_candidate_max_streak) {
                    playback_human_candidate_max_streak = playback_human_candidate_streak;
                }
            } else if (playback_active &&
                       playback_human_candidate_streak > 0 &&
                       playback_human_candidate_gap_frames < NUWAX_PLAYBACK_HUMAN_CANDIDATE_MAX_GAP_FRAMES) {
                playback_human_candidate_gap_frames++;
                if (playback_human_candidate_gap_frames > playback_human_candidate_max_gap_frames) {
                    playback_human_candidate_max_gap_frames = playback_human_candidate_gap_frames;
                }
            } else {
                playback_human_candidate_streak = 0;
                playback_human_candidate_gap_frames = 0;
                playback_human_candidate_mic_avg_sum = 0;
                playback_human_candidate_mic_peak_sum = 0;
                playback_human_candidate_start_valid = false;
            }
            if (playback_active && strong_human_evidence && !playback_human_seed_evidence) {
                playback_human_strong_evidence_frames++;
            }
            const bool playback_human_window_energy =
                playback_human_candidate_streak > 0 &&
                playback_human_candidate_mic_avg_sum >=
                    (uint64_t)NUWAX_PLAYBACK_HUMAN_CONFIRM_MIN_MIC1_AVG_ABS *
                        playback_human_candidate_streak &&
                playback_human_candidate_mic_peak_sum >=
                    (uint64_t)NUWAX_PLAYBACK_HUMAN_CONFIRM_MIN_MIC1_PEAK *
                        playback_human_candidate_streak;
            /* Legacy spatial anchors remain useful for short-term AEC protection,
             * but a single playback transient must not interrupt TTS. Admission
             * requires a strict onset followed immediately by two echo-vetoed
             * human-support frames, including any additional strict frames. */
            const bool playback_human_confirmation_anchor =
                playback_human_nearfield_anchor ||
                playback_human_cloud_guarded_anchor;
            playback_provisional_human_hint =
                playback_active &&
                playback_human_candidate_streak >= NUWAX_PLAYBACK_HUMAN_PROVISIONAL_FRAMES &&
                playback_human_candidate_gap_frames <= NUWAX_PLAYBACK_HUMAN_PROVISIONAL_HOLD_FRAMES &&
                playback_human_candidate_mic_avg_sum >=
                    (uint64_t)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_AVG_ABS *
                        playback_human_candidate_streak &&
                playback_human_candidate_mic_peak_sum >=
                    (uint64_t)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_PEAK *
                        playback_human_candidate_streak;
            if (playback_provisional_human_hint) {
                playback_human_provisional_frames++;
            }
            const bool current_human_evidence =
                playback_human_seed_evidence &&
                playback_human_window_energy &&
                playback_human_confirmation_anchor;
            if (current_human_evidence) {
                playback_human_confirmed_frames++;
                if (!during_playback_mode && !playback_human_seed_active &&
                    playback_human_candidate_start_valid) {
                    playback_human_preroll_repair_pending = true;
                    playback_human_preroll_repair_start_sequence =
                        playback_human_candidate_start_sequence;
                    playback_human_preroll_repair_end_sequence = capture_sequence;
                }
            }
            const bool playback_human_fast_protect_evidence =
                playback_human_seed_evidence &&
                raw_level.avg_abs >= NUWAX_PLAYBACK_HUMAN_FAST_PROTECT_MIN_MIC1_AVG_ABS &&
                raw_level.peak >= NUWAX_PLAYBACK_HUMAN_FAST_PROTECT_MIN_MIC1_PEAK &&
                playback_human_spatial_anchor;
            if (playback_human_fast_protect_evidence) {
                playback_human_fast_protect_remaining =
                    NUWAX_PLAYBACK_HUMAN_CANDIDATE_MAX_GAP_FRAMES + 1U;
            } else if (playback_active && playback_human_fast_protect_remaining > 0) {
                playback_human_fast_protect_remaining--;
            } else if (!playback_active) {
                playback_human_fast_protect_remaining = 0;
            }
            const bool playback_echo_candidate =
                playback_ref_echo_candidate || playback_spatial_echo_candidate;
            const bool playback_human_log_due =
                !playback_human_log_seen ||
                (captured_frames - playback_human_last_log_frame) >=
                    NUWAX_PLAYBACK_HUMAN_LOG_INTERVAL_FRAMES;
            if (playback_active && strong_human_evidence && playback_human_log_due) {
                playback_human_log_seen = true;
                playback_human_last_log_frame = captured_frames;
            NUWAX_RT_DIAG_LOGI(TAG,
                     "playback human strong seq=%lu streak=%lu gap=%lu seed_evidence=%d window_avg=%lu window_peak=%lu confirmed=%d voice=%d aec=%d cleaner=%d raw=%d mic1_avg=%lu mic1_peak=%lu mic2_avg=%lu mic2_peak=%lu diff_avg=%lu diff_peak=%lu diff_energy_q15=%lu balance_q15=%lu ref_active=%d ref_corr_q15=%lu ref_echo=%d spatial_echo=%d spatial_anchor=%d separated_anchor=%d exceptional_anchor=%d low_level_anchor=%d voice_anchor=%d nearfield_potential=%d nearfield_anchor=%d candidate_gap_before=%lu",
                         (unsigned long)captured_frames,
                         (unsigned long)playback_human_candidate_streak,
                         (unsigned long)playback_human_candidate_gap_frames,
                         playback_human_seed_evidence ? 1 : 0,
                         (unsigned long)(playback_human_candidate_mic_avg_sum /
                                         (playback_human_candidate_streak > 0
                                              ? playback_human_candidate_streak
                                              : 1U)),
                         (unsigned long)(playback_human_candidate_mic_peak_sum /
                                         (playback_human_candidate_streak > 0
                                              ? playback_human_candidate_streak
                                              : 1U)),
                         current_human_evidence ? 1 : 0,
                         dual_mic.voice_like ? 1 : 0,
                         dual_mic_aec_hint ? 1 : 0,
                         dual_mic_cleaner_hint ? 1 : 0,
                         playback_raw_human_hint ? 1 : 0,
                         (unsigned long)raw_level.avg_abs,
                         (unsigned long)raw_level.peak,
                         (unsigned long)mic2_level.avg_abs,
                         (unsigned long)mic2_level.peak,
                         (unsigned long)dual_mic.diff_avg_abs,
                         (unsigned long)dual_mic.diff_peak,
                         (unsigned long)dual_mic.diff_energy_ratio_q15,
                         (unsigned long)dual_mic.level_balance_q15,
                         playback_ref_active ? 1 : 0,
                         (unsigned long)playback_mic_ref_corr_q15,
                         playback_ref_echo_candidate ? 1 : 0,
                         playback_spatial_echo_candidate ? 1 : 0,
                         playback_human_spatial_anchor ? 1 : 0,
                         playback_human_separated_anchor ? 1 : 0,
                         playback_human_exceptional_anchor ? 1 : 0,
                         playback_human_low_level_spatial_anchor ? 1 : 0,
                         playback_human_voice_anchor ? 1 : 0,
                         playback_human_nearfield_candidate ? 1 : 0,
                         playback_human_nearfield_anchor ? 1 : 0,
                         (unsigned long)playback_human_candidate_gap_before);
            }
            if (playback_echo_candidate &&
                !current_human_evidence &&
                !playback_human_seed_active) {
                playback_echo_only_streak++;
            } else {
                playback_echo_only_streak = 0;
            }
            playback_echo_veto =
                playback_echo_only_streak >= NUWAX_PLAYBACK_ECHO_ONLY_VETO_STREAK_FRAMES;
            if (playback_echo_veto && playback_ref_echo_candidate) {
                playback_ref_echo_veto_frames++;
            }
            if (playback_echo_veto && playback_spatial_echo_candidate) {
                playback_spatial_echo_veto_frames++;
            }
            if (dual_mic_aec_hint) {
                dual_mic_aec_hint_frames++;
            }
            if (dual_mic_cleaner_hint) {
                dual_mic_cleaner_hint_frames++;
            }
            if (playback_raw_human_hint) {
                playback_raw_human_hint_frames++;
            }
            const bool spatial_human_first = current_human_evidence;
            /* The strict spatial anchor admits the human session. Once admitted,
             * refresh from the already echo-vetoed seed evidence so ordinary
             * syllables do not need to repeatedly satisfy the much rarer
             * voice_like/anchor shape. */
            const bool refresh_confirmed_human_seed =
                playback_active &&
                playback_human_seed_seen &&
                playback_human_seed_evidence &&
                !spatial_human_first;
            if (playback_active && (spatial_human_first || refresh_confirmed_human_seed)) {
                playback_human_seed_seen = true;
                playback_human_seed_hangover_remaining = NUWAX_PLAYBACK_HUMAN_SEED_HANGOVER_FRAMES;
                if (spatial_human_first) {
                    playback_human_seed_frames++;
                } else {
                    playback_human_seed_refresh_frames++;
                }
            } else if (playback_active && playback_human_seed_hangover_remaining > 0) {
                playback_human_seed_hangover_remaining--;
            } else if (!playback_active) {
                playback_human_seed_seen = false;
                playback_human_seed_hangover_remaining = 0;
            }
            playback_human_seed_active =
                playback_active &&
                playback_human_seed_seen &&
                playback_human_seed_hangover_remaining > 0;
            if (playback_human_seed_active) {
                playback_human_seed_active_frames++;
            }
            playback_weak_continuity_hint =
                playback_human_seed_active &&
                dual_mic_playback_weak_continuity_hint(dual_mic, raw_level, mic2_level);
            if (playback_weak_continuity_hint) {
                playback_weak_continuity_hint_frames++;
            }
            playback_dual_onset_guard =
                playback_active &&
                dual_mic_playback_echo_atten_guard(dual_mic, raw_level, mic2_level);
            dual_mic_human_first_hint =
                spatial_human_first || (!playback_active && mic2_speech_like);
            if (dual_mic_human_first_hint) {
                dual_mic_human_first_hint_frames++;
            }
        }
#endif
        bool dual_mic_aec_hint_hangover = false;
        bool dual_mic_cleaner_hint_hangover = false;
        bool playback_raw_human_hint_hangover = false;
        bool playback_weak_continuity_hint_hangover = false;
        bool dual_mic_human_first_hint_hangover = false;
        const bool dual_mic_voice_hint = dual_mic.valid && dual_mic.voice_like;
        if (dual_mic_aec_hint) {
            dual_mic_aec_hint_hangover_remaining = NUWAX_DUAL_MIC_AEC_HINT_HANGOVER_FRAMES;
        } else if (dual_mic_aec_hint_hangover_remaining > 0) {
            dual_mic_aec_hint_hangover = true;
            dual_mic_aec_hint_hangover_remaining--;
        }
        if (dual_mic_cleaner_hint) {
            dual_mic_cleaner_hint_hangover_remaining = NUWAX_DUAL_MIC_CLEANER_HINT_HANGOVER_FRAMES;
        } else if (dual_mic_cleaner_hint_hangover_remaining > 0) {
            dual_mic_cleaner_hint_hangover = true;
            dual_mic_cleaner_hint_hangover_remaining--;
        }
        if (playback_raw_human_hint) {
            playback_raw_human_hint_hangover_remaining = NUWAX_DUAL_MIC_HUMAN_FIRST_HINT_HANGOVER_FRAMES;
        } else if (playback_active && playback_raw_human_hint_hangover_remaining > 0) {
            playback_raw_human_hint_hangover = true;
            playback_raw_human_hint_hangover_remaining--;
        } else if (!playback_active) {
            playback_raw_human_hint_hangover_remaining = 0;
        }
        if (playback_weak_continuity_hint) {
            playback_weak_continuity_hint_hangover_remaining = NUWAX_PLAYBACK_WEAK_CONTINUITY_HANGOVER_FRAMES;
        } else if (playback_active && playback_weak_continuity_hint_hangover_remaining > 0) {
            playback_weak_continuity_hint_hangover = true;
            playback_weak_continuity_hint_hangover_remaining--;
        } else if (!playback_active) {
            playback_weak_continuity_hint_hangover_remaining = 0;
        }
        if (dual_mic_human_first_hint) {
            dual_mic_human_first_hint_hangover_remaining = NUWAX_DUAL_MIC_HUMAN_FIRST_HINT_HANGOVER_FRAMES;
        } else if (dual_mic_human_first_hint_hangover_remaining > 0) {
            dual_mic_human_first_hint_hangover = true;
            dual_mic_human_first_hint_hangover_remaining--;
        }
        if (dual_mic_voice_hint) {
            dual_mic_voice_hint_hangover_remaining = NUWAX_DUAL_MIC_VOICE_HINT_HANGOVER_FRAMES;
        } else if (dual_mic_voice_hint_hangover_remaining > 0) {
            dual_mic_aec_hint_hangover = true;
            dual_mic_voice_hint_hangover_remaining--;
        }
        const bool playback_raw_human_hint_active =
            playback_raw_human_hint || playback_raw_human_hint_hangover;
        const bool playback_weak_continuity_hint_active =
            playback_weak_continuity_hint || playback_weak_continuity_hint_hangover;
        const bool dual_mic_aec_hint_active =
            dual_mic_aec_hint ||
            dual_mic_voice_hint ||
            playback_raw_human_hint_active ||
            dual_mic_aec_hint_hangover;
        const bool dual_mic_cleaner_hint_active =
            dual_mic_aec_hint_active ||
            dual_mic_cleaner_hint ||
            playback_raw_human_hint_active ||
            dual_mic_cleaner_hint_hangover;
        const bool dual_mic_human_first_hint_active =
            dual_mic_cleaner_hint_active || dual_mic_human_first_hint || dual_mic_human_first_hint_hangover;
        const bool confirmed_playback_human_context =
            playback_active &&
            playback_human_seed_active &&
            (dual_mic_cleaner_hint_active || playback_weak_continuity_hint_active);
        if (confirmed_playback_human_context) {
            confirmed_playback_human_context_frames++;
            if (!confirmed_playback_human_context_previous) {
                confirmed_playback_human_context_starts++;
            }
        }
        confirmed_playback_human_context_previous = confirmed_playback_human_context;
        const bool playback_human_context_guard =
            playback_active &&
            playback_human_seed_seen &&
            playback_human_seed_hangover_remaining > 0;
        const bool playback_echo_atten_guard =
            playback_human_context_guard ||
            playback_dual_onset_guard ||
            playback_raw_human_hint_active ||
            playback_weak_continuity_hint_active ||
            dual_mic_cleaner_hint_active;
        const bool playback_nearend_preserve_hint =
            playback_active &&
            (confirmed_playback_human_context ||
             playback_provisional_human_hint ||
             dual_mic_aec_hint_active);
        const bool playback_confirmed_human_protect =
            playback_active && playback_human_seed_active;
        const bool playback_fast_human_protect =
            playback_active &&
            !playback_confirmed_human_protect &&
            playback_human_fast_protect_remaining > 0;
        metrics_record_duration(
            NUWAX_CONVERSATION_LATENCY_DSP_HUMAN_DETECTOR,
            human_detector_started_us,
            (uint64_t)esp_timer_get_time());

#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
        const bool playback_provisional_human_protect =
            playback_active &&
            playback_provisional_human_hint &&
            !playback_fast_human_protect &&
            !playback_confirmed_human_protect;
#endif
        if (playback_fast_human_protect) {
            playback_human_fast_protect_frames++;
        }
        if (playback_raw_human_hint_active) {
            playback_raw_human_hint_active_frames++;
            if (playback_raw_human_hint_hangover && !playback_raw_human_hint) {
                playback_raw_human_hint_hangover_frames++;
            }
        }
        if (playback_weak_continuity_hint_active) {
            playback_weak_continuity_hint_active_frames++;
            if (playback_weak_continuity_hint_hangover && !playback_weak_continuity_hint) {
                playback_weak_continuity_hint_hangover_frames++;
            }
        }
        if (dual_mic_aec_hint_active) {
            dual_mic_aec_hint_active_frames++;
            if (dual_mic_aec_hint_hangover && !dual_mic_aec_hint && !dual_mic_voice_hint) {
                dual_mic_aec_hint_hangover_frames++;
            }
        }
        if (dual_mic_cleaner_hint_active) {
            dual_mic_cleaner_hint_active_frames++;
            if (dual_mic_cleaner_hint_hangover && !dual_mic_cleaner_hint && !dual_mic_aec_hint_active) {
                dual_mic_cleaner_hint_hangover_frames++;
            }
        }
        if (dual_mic_human_first_hint_active) {
            dual_mic_human_first_hint_active_frames++;
            if (dual_mic_human_first_hint_hangover &&
                !dual_mic_human_first_hint &&
                !dual_mic_cleaner_hint_active) {
                dual_mic_human_first_hint_hangover_frames++;
            }
        }

#if CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE
        const bool aec_delay_shadow_human_block =
            confirmed_playback_human_context ||
            playback_human_seed_active ||
            playback_fast_human_protect ||
            playback_provisional_human_protect ||
            playback_confirmed_human_protect ||
            playback_human_nearfield_onset_valid;
        const bool aec_delay_shadow_eligible =
            playback_active && speaker_pending && playback_ref_active &&
            raw_level.peak < NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK &&
            playback_ref_level.peak < NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK;
#if CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE
        const bool aec_delay_shadow_dynamic_apply_allowed =
            !aec_delay_shadow_human_block &&
            (work->live_aec).pending_count == 0U &&
            (work->live_aec).chunk_samples > 0 &&
            samples_read == (size_t)(work->live_aec).chunk_samples;
#else
        const bool aec_delay_shadow_dynamic_apply_allowed = false;
#endif
        rt_capture_shadow_delay_observe(&(work->capture_ctx),
                                        s_audio_samples,
                                        samples_read,
                                        capture_sequence,
                                        frame_software_ref_anchor_events,
                                        frame_software_ref_generation,
                                        frame_software_ref_source_end_index,
                                        frame_software_ref_phase_error,
                                        frame_software_ref_epoch_valid,
                                        aec_delay_shadow_eligible,
                                        aec_delay_shadow_human_block,
                                        aec_delay_shadow_dynamic_apply_allowed);
#endif

        if (samples_read > 0U) {
            memcpy(s_audio_samples,
                   s_audio_aec_samples,
                   samples_read * sizeof(s_audio_samples[0]));
        }
        if (samples_read > 0) {
            if (nuwax_live_aec_copy_human_rescue_frame(
                    &(work->live_aec),
                    s_audio_human_rescue_source,
                    samples_read,
                    &frame_rescue_provenance)) {
                frame_rescue_source_kind =
                    frame_rescue_provenance.segment_count == 1U
                        ? frame_rescue_provenance.segments[0].kind
                        : NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW;
            } else {
                frame_rescue_provenance.segment_count = 1U;
                frame_rescue_provenance.sample_count = samples_read;
                frame_rescue_provenance.segments[0] =
                    (nuwax_live_aec_rescue_segment_t){
                        .kind = NUWAX_LIVE_AEC_RESCUE_SOURCE_RAW,
                        .sample_count = samples_read,
                    };
            }
        }
        /* L3 interrupt level: NVS-gated legacy experiment. Skip it while live AEC owns the main path. */
        if (samples_read > 0 && !nuwax_live_aec_is_enabled(&(work->live_aec))) {
            (void)nuwax_p3_l3_process_chunk(s_audio_samples, samples_read);
        }
        if (samples_read > 0) {
            memcpy(s_audio_preclean_samples,
                   s_audio_samples,
                   samples_read * sizeof(s_audio_preclean_samples[0]));
            frame_cleaner_state_before = capture_preroll_cleaner_state(&(work->audio_cleaner));
        }
        nuwax_audio_cleaner_result_t clean_result = {0};
        const uint64_t cleaner_started_us = (uint64_t)esp_timer_get_time();
        if (s_audio_cleaner_runtime_enabled) {
            nuwax_audio_cleaner_process_with_ref(&(work->audio_cleaner),
                                                 s_audio_samples,
                                                  samples_read,
                                                  playback_active,
                                                   playback_active ? playback_nearend_preserve_hint
                                                                   : dual_mic_human_first_hint_active,
                                                   playback_active ? playback_nearend_preserve_hint
                                                                   : dual_mic_cleaner_hint_active,
                                                  playback_active
                                                      ? (playback_human_strong_hint ||
                                                         playback_human_seed_seen)
                                                      : dual_mic_human_first_hint_active,
                                                  playback_echo_veto,
                                                  playback_echo_atten_guard,
                                                  playback_active ? s_audio_ref_samples : NULL,
                                                  playback_active ? samples_read : 0,
                                                  &clean_result);
        } else {
            clean_result.before = nuwax_mic_level_measure(s_audio_samples, samples_read);
            clean_result.after = clean_result.before;
        }
        metrics_record_duration(NUWAX_CONVERSATION_LATENCY_DSP_CLEANER,
                                cleaner_started_us,
                                (uint64_t)esp_timer_get_time());
        log_audio_cleaner_frame(captured_frames, playback_active, &clean_result);
        metrics_record_duration(NUWAX_CONVERSATION_LATENCY_DSP_PROCESS,
                                frame_dsp_started_us,
                                (uint64_t)esp_timer_get_time());

        // v15-v2 Goertzel filter removed (2026-07-16): self-recognition
        // 0.999 fooled correctness check; offline eval showed device/human
        // score overlap (99.83% vs 99.82%). Method retired to
        // main/_archive/v15-goertzel-failed/. See RETIREMENT_NOTES.md.

        if (acceptance_capture_enabled && playback_active) {
            acceptance_capture_playback_seen = true;
        }
        if (acceptance_capture_enabled && !upload_started && playback_active) {
            result = start_mic_cloud_upload(ws,
                                            send_ctx,
                                            NUWAX_ACCEPTANCE_CAPTURE_MODE,
                                            acceptance_capture.audio_session_id,
                                            acceptance_capture.request_id,
                                            max_record_samples,
                                            max_record_ms,
                                            &listen_started,
                                            &upload_started_us,
                                            false,
                                            false);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                break;
            }
            upload_started = true;
            ESP_LOGI(TAG,
                     "acceptance playback capture upload started frame=%lu audio_session_id=%s",
                     (unsigned long)captured_frames,
                     acceptance_capture.audio_session_id[0] ? acceptance_capture.audio_session_id : "-");
        }
        if (acceptance_capture_enabled &&
            upload_started &&
            acceptance_capture_playback_seen &&
            !playback_active &&
            !stop_requested) {
            stop_requested = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_ACCEPTANCE_COMPLETE);
            acceptance_capture_stop_logged = true;
            ESP_LOGI(TAG,
                     "acceptance playback capture stopping at playback end frame=%lu recorded_frames=%lu",
                     (unsigned long)captured_frames,
                     (unsigned long)recorded_frames);
        }

        nuwax_mic_level_t level = nuwax_mic_level_measure(s_audio_samples, samples_read);
        bool frame_is_speech = false;
        bool playback_nearend_candidate = false;
        bool playback_dual_mic_candidate = false;
        bool playback_gate_candidate = false;
        const bool barge_clean_post_stop_capture =
            during_playback_mode &&
            barge_local_cancel_requested &&
            barge_physical_stop_observed &&
            barge_post_cancel_guard_started &&
            !speaker_pending &&
            barge_post_cancel_guard_frames == 0 &&
            !barge_post_stop_guard_frame;
        const bool playback_upload_gate_required =
            (during_playback_mode || persistent_conversation_mode) &&
            playback_active &&
            !barge_clean_post_stop_capture;
        const bool during_playback_post_gate_required =
            during_playback_mode &&
            (!playback_active || barge_clean_post_stop_capture);
        const bool frame_aec_processed =
            frame_aec_process_attempted &&
            frame_aec_process_result == ESP_OK &&
            nuwax_live_aec_output_stats_fully_aec(&(work->live_aec).last_output,
                                                   samples_read);
        const bool frame_output_fallback =
            nuwax_live_aec_output_stats_has_fallback(&(work->live_aec).last_output);
        const bool frame_ref_missing =
            (work->live_aec).last_output.ref_missing_samples > 0U;
        const uint32_t output_underrun_samples =
            (work->live_aec).last_output.underrun_samples > UINT32_MAX
                ? UINT32_MAX
                : (uint32_t)(work->live_aec).last_output.underrun_samples;
        const bool aec_processing_error =
            frame_aec_process_attempted &&
            frame_aec_process_result != ESP_OK;
        if (aec_processing_error) {
            live_aec_runtime_faulted = true;
        }
        const bool reference_locked_this_frame =
            !playback_ref_active ||
            (frame_aec_processed && !frame_ref_missing &&
             frame_aec_process_result == ESP_OK);
        const bool microphone_clipped =
            raw_level.peak >= NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK;
        const bool reference_clipped =
            playback_ref_level.peak >=
            NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK;
        const bool stable_silent_reference_context =
            playback_active &&
            speaker_volume_percent <= 5U &&
            speaker_submitted_generation != 0U &&
            speaker_volume_generation != 0U &&
            speaker_playback_snapshot_stable &&
            speaker_volume_snapshot_stable &&
            reference_source_present &&
            reference_epoch_contiguous &&
            !playback_ref_active &&
            !frame_aec_processed &&
            !frame_ref_missing &&
            !aec_processing_error &&
            !microphone_clipped &&
            !reference_clipped &&
            output_underrun_samples == 0U;
        if (stable_silent_reference_context) {
            if (stable_silent_reference_frames < UINT32_MAX) {
                stable_silent_reference_frames++;
            }
        } else {
            stable_silent_reference_frames = 0U;
        }
        const bool verified_silent_passthrough =
            stable_silent_reference_context &&
            stable_silent_reference_frames >=
                NUWAX_BARGE_SILENT_REFERENCE_STABLE_FRAMES;
        const nuwax_preroll_audio_trust_t frame_preroll_trust = {
            .reference_generation = frame_reference_provenance.generation,
            .playback_generation = speaker_submitted_generation,
            .volume_generation = speaker_volume_generation,
            .output_underrun_delta = output_underrun_samples,
            .volume_percent = speaker_volume_percent,
            .playback_state_stable = speaker_playback_snapshot_stable,
            .volume_state_stable = speaker_volume_snapshot_stable,
            .reference_snapshot = reference_source_present,
            .reference_generation_valid = reference_source_present,
            .reference_contiguous = reference_epoch_contiguous,
            .reference_active = playback_ref_active,
            .reference_locked = reference_locked_this_frame,
            .aec_processed_ok = frame_aec_processed &&
                                frame_aec_process_result == ESP_OK,
            .ref_missing = frame_ref_missing,
            .processing_error = aec_processing_error,
            .microphone_clipped = microphone_clipped,
            .reference_clipped = reference_clipped,
            .verified_silent_passthrough =
                verified_silent_passthrough,
        };
        if (playback_upload_gate_required) {
            bool playback_ref_healthy = false;
            playback_nearend_candidate =
                during_playback_nearend_candidate(&(work->live_aec),
                                                  raw_level,
                                                  level,
                                                  &clean_result,
                                                  frame_aec_processed,
                                                   frame_ref_missing,
                                                   &playback_ref_healthy);
            if (playback_echo_veto && playback_nearend_candidate) {
                playback_nearend_candidate = false;
                playback_aec_gate_echo_blocked_frames++;
            }
            if (!playback_ref_healthy) {
                playback_gate_ref_unhealthy_frames++;
            }
            playback_dual_mic_candidate =
                !playback_nearend_candidate &&
                (dual_mic_playback_nearend_candidate(dual_mic, level, &clean_result) ||
                 playback_raw_human_hint_active ||
                 (playback_human_seed_active && playback_weak_continuity_hint_active));
            if (playback_dual_mic_candidate) {
                playback_gate_dual_candidate_frames++;
            }
            playback_gate_score_update(&playback_gate_score_frames,
                                       playback_nearend_candidate,
                                       playback_dual_mic_candidate);
            const bool playback_dual_gate_candidate =
                playback_dual_mic_candidate &&
                (playback_ref_healthy ||
                 playback_raw_human_hint_active ||
                 (playback_human_seed_active && playback_weak_continuity_hint_active)) &&
                playback_gate_score_frames >= NUWAX_PLAYBACK_GATE_DUAL_OPEN_MIN_SCORE;
            playback_gate_candidate = playback_nearend_candidate || playback_dual_gate_candidate;
            if (playback_dual_gate_candidate) {
                playback_gate_dual_open_frames++;
            }
            if (playback_gate_candidate) {
                playback_gate_candidate_frames++;
                playback_gate_candidate_streak++;
                if (playback_gate_candidate_streak > playback_gate_max_candidate_streak) {
                    playback_gate_max_candidate_streak = playback_gate_candidate_streak;
                }
            } else {
                playback_gate_suppressed_frames++;
                playback_gate_candidate_streak = 0;
            }
            if (playback_gate_score_frames > playback_gate_max_score_frames) {
                playback_gate_max_score_frames = playback_gate_score_frames;
            }
        }
        bool playback_vad_gate_candidate = playback_gate_candidate;
#if NUWAX_PLAYBACK_VAD_REQUIRE_HUMAN_SEED
        if (playback_upload_gate_required) {
            playback_vad_gate_candidate =
                playback_gate_candidate &&
                !playback_echo_veto &&
                playback_human_seed_active;
            if (playback_gate_candidate && !playback_vad_gate_candidate) {
                playback_vad_echo_blocked_frames++;
            }
        }
#endif

        /* The controller is the only authority allowed to stop local playback.
         * Legacy VAD remains useful for endpointing, but cannot bypass AEC,
         * reference, generation or frame-age health gates. */
        if (during_playback_mode && speaker_pending &&
            speaker_submitted_generation != 0U &&
            !barge_controller_confirmed) {
            const uint64_t decision_timestamp_us =
                frame_capture_finished_us > 0
                    ? (uint64_t)frame_capture_finished_us
                    : (uint64_t)esp_timer_get_time();
            const uint64_t decision_now_us = (uint64_t)esp_timer_get_time();
            const uint64_t frame_age_us =
                decision_now_us >= decision_timestamp_us
                    ? decision_now_us - decision_timestamp_us
                    : UINT64_MAX;
            const uint16_t frame_age_ms =
                frame_age_us / 1000ULL > UINT16_MAX
                    ? UINT16_MAX
                    : (uint16_t)(frame_age_us / 1000ULL);

            const bool new_playback_generation =
                !(work->barge_controller).playback_active ||
                (work->barge_controller).playback_generation !=
                    speaker_submitted_generation;
            if (new_playback_generation) {
                nuwax_conversation_audio_health_reset(&(work->barge_audio_health));
                barge_probe_active = false;
                barge_probe_playback_generation = 0U;
                barge_probe_candidate_id = 0U;
                barge_probe_elapsed_frames = 0U;
                (void)nuwax_barge_controller_begin_playback(
                    &(work->barge_controller),
                    speaker_submitted_generation,
                    speaker_volume_generation,
                    speaker_volume_percent,
                    decision_timestamp_us);
                barge_reference_source = frame_reference_provenance;
            }

            if (reference_source_present) {
                barge_reference_source = frame_reference_provenance;
            }

            const uint32_t health_frame_age_us =
                frame_age_us > UINT32_MAX
                    ? UINT32_MAX
                    : (uint32_t)frame_age_us;
            const nuwax_conversation_audio_health_frame_t health_frame = {
                .enabled = nuwax_live_aec_is_enabled(&(work->live_aec)),
                .initialized = (work->live_aec).initialized,
                .playback_active = playback_active,
                .reference_generation_matches =
                    reference_source_present &&
                    reference_epoch_contiguous,
                .reference_contiguous = reference_epoch_contiguous,
                .reference_active = playback_ref_active,
                .reference_locked = reference_locked_this_frame,
                .aec_frame_processed = frame_aec_processed,
                .ref_missing = frame_ref_missing,
                .processing_error = aec_processing_error,
                .microphone_clipped = microphone_clipped,
                .reference_clipped = reference_clipped,
                .output_underrun_delta = output_underrun_samples,
                .frame_age_us = health_frame_age_us,
                .deadline_missed = false,
            };
            nuwax_conversation_audio_health_result_t health = {0};
            if (!nuwax_conversation_audio_health_process(
                    &(work->barge_audio_health), &health_frame, &health)) {
                health.aec_health = NUWAX_BARGE_HEALTH_RED;
                health.reference_health = NUWAX_BARGE_HEALTH_RED;
                health.fail_closed = true;
                health.metrics_runtime_state = NUWAX_AEC_RUNTIME_FAILED;
                health.metrics_reason_bits =
                    NUWAX_AEC_REASON_PROCESSING_ERROR;
            }
            if (health.metrics_runtime_state != last_audio_health_state ||
                health.metrics_reason_bits != last_audio_health_reasons) {
                if (s_conversation_runtime_metrics_ready) {
                    (void)nuwax_conversation_metrics_set_aec_runtime(
                        s_conversation_runtime_metrics,
                        health.metrics_runtime_state,
                        health.metrics_reason_bits,
                        decision_now_us);
                }
                if (audio_health_log_pending) {
                    suppressed_audio_health_logs++;
                }
                audio_health_log_pending = true;
                last_audio_health_state = health.metrics_runtime_state;
                last_audio_health_reasons = health.metrics_reason_bits;
            }
            const int64_t audio_health_log_interval_us =
                health.metrics_runtime_state == NUWAX_AEC_RUNTIME_FAILED
                    ? NUWAX_AUDIO_HEALTH_FAILED_LOG_MIN_INTERVAL_US
                    : NUWAX_AUDIO_HEALTH_LOG_MIN_INTERVAL_US;
            if (audio_health_log_pending &&
                (last_audio_health_log_us == 0 ||
                 decision_now_us - last_audio_health_log_us >=
                     audio_health_log_interval_us)) {
            NUWAX_RT_DIAG_LOGI(TAG,
                     "conversation audio health state=%s reasons=0x%lx aec=%d ref=%d locked=%d fail_closed=%d stable=%u/%u anomaly=%u/%u generation=%lu seq=%lu suppressed=%lu",
                         nuwax_aec_runtime_state_name(
                             health.metrics_runtime_state),
                         (unsigned long)health.metrics_reason_bits,
                         (int)health.aec_health,
                         (int)health.reference_health,
                         health.reference_locked ? 1 : 0,
                         health.fail_closed ? 1 : 0,
                         (unsigned)health.aec_stable_frames,
                         (unsigned)health.reference_stable_frames,
                         (unsigned)health.aec_anomaly_frames,
                         (unsigned)health.reference_anomaly_frames,
                         (unsigned long)speaker_submitted_generation,
                         (unsigned long)capture_sequence,
                         (unsigned long)suppressed_audio_health_logs);
                last_audio_health_log_us = decision_now_us;
                suppressed_audio_health_logs = 0;
                audio_health_log_pending = false;
            }
            if (s_conversation_runtime_metrics_ready) {
                if (speaker_pending && frame_output_fallback) {
                    (void)nuwax_conversation_metrics_count_event(
                        s_conversation_runtime_metrics,
                        NUWAX_CONVERSATION_EVENT_AEC_FALLBACK,
                        1U);
                }
            }

            nuwax_barge_evidence_t evidence = 0U;
            if (barge_voice_like_evidence) {
                evidence |= NUWAX_BARGE_EVIDENCE_VOICE_LIKE;
            }
            if (barge_spatial_imbalanced_evidence) {
                evidence |= NUWAX_BARGE_EVIDENCE_DUAL_MIC_IMBALANCED;
            }
            if (barge_spatial_symmetric_evidence) {
                evidence |= NUWAX_BARGE_EVIDENCE_DUAL_MIC_SYMMETRIC;
            }
            if (playback_nearend_candidate && frame_aec_processed &&
                !frame_ref_missing) {
                evidence |= NUWAX_BARGE_EVIDENCE_AEC_NEAREND;
            }
            if (playback_ref_active &&
                playback_mic_ref_corr_q15 <
                    NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_REF_CORR_Q15) {
                evidence |= NUWAX_BARGE_EVIDENCE_LOW_REF_CORRELATION;
            }

            const bool probe_human_base =
                (evidence & NUWAX_BARGE_EVIDENCE_VOICE_LIKE) != 0U &&
                (evidence &
                    (NUWAX_BARGE_EVIDENCE_DUAL_MIC_IMBALANCED |
                     NUWAX_BARGE_EVIDENCE_DUAL_MIC_SYMMETRIC)) != 0U;
            const bool probe_independent_nearend =
                (evidence &
                    (NUWAX_BARGE_EVIDENCE_AEC_NEAREND |
                     NUWAX_BARGE_EVIDENCE_LOW_REF_CORRELATION)) != 0U;
            const bool frame_echo_candidate =
                barge_echo_candidate || playback_echo_veto;
            nuwax_barge_probe_observation_t probe_observation =
                NUWAX_BARGE_PROBE_NOT_AVAILABLE;
            if (barge_probe_active) {
                if (barge_probe_playback_generation !=
                        speaker_submitted_generation ||
                    barge_probe_candidate_id !=
                        (work->barge_controller).candidate_id) {
                    barge_probe_active = false;
                    barge_probe_playback_generation = 0U;
                    barge_probe_candidate_id = 0U;
                    barge_probe_elapsed_frames = 0U;
                } else {
                    if (barge_probe_elapsed_frames < UINT8_MAX) {
                        barge_probe_elapsed_frames++;
                    }
                    /* One frame is allowed for codec gain and acoustic
                     * propagation to reach the microphones. */
                    if (barge_probe_elapsed_frames <= 1U) {
                        probe_observation =
                            NUWAX_BARGE_PROBE_INCONCLUSIVE;
                    } else if (probe_human_base &&
                               probe_independent_nearend &&
                               !frame_echo_candidate) {
                        probe_observation =
                            NUWAX_BARGE_PROBE_HUMAN_PERSISTS;
                    } else if (frame_echo_candidate &&
                               (!probe_human_base ||
                                !probe_independent_nearend)) {
                        probe_observation =
                            NUWAX_BARGE_PROBE_ECHO_TRACKS_DUCK;
                    } else {
                        probe_observation =
                            NUWAX_BARGE_PROBE_INCONCLUSIVE;
                    }
                }
            }

            const nuwax_barge_decision_frame_t decision_frame = {
                .playback_generation = speaker_submitted_generation,
                .volume_generation = speaker_volume_generation,
                .reference_generation = reference_source_present
                                            && reference_epoch_contiguous
                                            ? speaker_submitted_generation
                                            : 0U,
                .sequence = capture_sequence,
                .capture_timestamp_us = decision_timestamp_us,
                .frame_age_ms = frame_age_ms,
                .volume_percent = speaker_volume_percent,
                .aec_health = health.aec_health,
                .reference_health = health.reference_health,
                .reference_active = playback_ref_active,
                .reference_locked = health.reference_locked,
                .reference_contiguous = reference_epoch_contiguous,
                .aec_frame_processed = frame_aec_processed,
                .verified_silent_passthrough =
                    health.verified_silent_passthrough,
                .microphone_clipped = raw_level.peak >=
                                      NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK,
                .reference_clipped = playback_ref_level.peak >=
                                     NUWAX_AEC_DELAY_SHADOW_CLIP_PEAK,
                .echo_candidate = frame_echo_candidate,
                .evidence = evidence,
                .probe_observation = probe_observation,
            };
            nuwax_barge_controller_result_t decision = {0};
            if (nuwax_barge_controller_process_frame(
                    &(work->barge_controller), &decision_frame, &decision)) {
                if (decision.event ==
                    NUWAX_BARGE_EVENT_CANDIDATE_STARTED) {
                    playback_human_nearfield_onset_valid = true;
                    playback_human_nearfield_onset_sequence =
                        decision.candidate_start_sequence;
                NUWAX_RT_DIAG_LOGI(TAG,
                         "barge controller candidate generation=%lu candidate=%lu onset_seq=%lu frame_age_ms=%u volume=%u evidence=0x%lx",
                             (unsigned long)decision.event_playback_generation,
                             (unsigned long)decision.candidate_id,
                             (unsigned long)decision.candidate_start_sequence,
                             (unsigned)frame_age_ms,
                             (unsigned)speaker_volume_percent,
                             (unsigned long)evidence);
                } else if (decision.event ==
                               NUWAX_BARGE_EVENT_PROBE_REQUESTED &&
                           decision.request_probe) {
                    const bool probe_applied =
                        nuwax_speaker_playback_request_probe_duck_generation(
                            decision.event_playback_generation,
                            decision.probe_attenuation_db,
                            decision.probe_duration_ms);
                    if (probe_applied) {
                        barge_probe_active = true;
                        barge_probe_playback_generation =
                            decision.event_playback_generation;
                        barge_probe_candidate_id = decision.candidate_id;
                        barge_probe_elapsed_frames = 0U;
                    }
                NUWAX_RT_DIAG_LOGI(TAG,
                         "barge controller ambiguity probe generation=%lu candidate=%lu attenuation_db=%u duration_ms=%u applied=%d",
                             (unsigned long)decision.event_playback_generation,
                             (unsigned long)decision.candidate_id,
                             (unsigned)decision.probe_attenuation_db,
                             (unsigned)decision.probe_duration_ms,
                             probe_applied ? 1 : 0);
                } else if (decision.event ==
                               NUWAX_BARGE_EVENT_CONFIRMED &&
                           decision.request_local_stop) {
                    metrics_record_duration(
                        NUWAX_CONVERSATION_LATENCY_BARGE_CANDIDATE_TO_CONFIRM,
                        decision.candidate_started_timestamp_us,
                        decision.event_timestamp_us);
                    barge_probe_active = false;
                    barge_probe_playback_generation = 0U;
                    barge_probe_candidate_id = 0U;
                    barge_probe_elapsed_frames = 0U;
                    if (!barge_event_initialized) {
                        uint32_t event_seq = ++s_barge_event_seq;
                        if (event_seq == 0U) {
                            event_seq = ++s_barge_event_seq;
                        }
                        snprintf(barge_event_id,
                                 sizeof(barge_event_id),
                                 "barge_%08lx_%08lx",
                                 (unsigned long)event_seq,
                                 (unsigned long)capture_sequence);
                        snprintf(barge_audio_session_id,
                                 sizeof(barge_audio_session_id),
                                 "barge_audio_%08lx",
                                 (unsigned long)event_seq);
                        nuwax_listen_resume_state_bind_round(
                            &s_listen_resume,
                            nuwax_awake_session_state_generation(
                                &s_awake_session),
                            barge_audio_session_id);
                        nuwax_speaker_playback_stats_t current_speaker = {0};
                        nuwax_speaker_playback_get_stats(&current_speaker);
                        strlcpy(barge_parent_turn_id,
                                s_turn_guard.turn_id[0]
                                    ? s_turn_guard.turn_id
                                    : s_active_turn_id,
                                sizeof(barge_parent_turn_id));
                        strlcpy(barge_playback_id,
                                current_speaker.active_playback_id,
                                sizeof(barge_playback_id));
                        barge_playback_connection_epoch =
                            current_speaker.playback_connection_epoch != 0U
                                ? current_speaker.playback_connection_epoch
                                : current_speaker.submitted_connection_epoch;
                        barge_event_onset_sequence =
                            decision.candidate_start_sequence;
                        barge_event_initialized = true;
                    }

                    nuwax_speaker_cancel_request_result_t cancel_request = {0};
                    const bool cancel_accepted =
                        nuwax_speaker_playback_request_cancel_generation_ex(
                            decision.event_playback_generation,
                            barge_event_id,
                            NUWAX_BARGE_IN_LOCAL_FADE_MS,
                            &cancel_request);
                    if (cancel_request.status ==
                        NUWAX_SPEAKER_CANCEL_REQUEST_FAILED) {
                        ESP_LOGE(TAG,
                                 "barge-in rejected because speaker stop already failed generation=%lu timestamp_us=%lld err=%s",
                                 (unsigned long)decision.event_playback_generation,
                                 (long long)cancel_request.failed_stop_timestamp_us,
                                 esp_err_to_name(
                                     cancel_request.failed_stop_result));
                        result = cancel_request.failed_stop_result == ESP_OK
                                     ? ESP_FAIL
                                     : cancel_request.failed_stop_result;
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                        break;
                    }
                    if (cancel_accepted) {
                        uint64_t local_stop_request_us =
                            cancel_request.request_timestamp_us > 0
                                ? (uint64_t)cancel_request.request_timestamp_us
                                : decision.event_timestamp_us;
                        if (local_stop_request_us < decision.event_timestamp_us) {
                            local_stop_request_us = decision.event_timestamp_us;
                        }
                        const bool local_stop_marked =
                            nuwax_barge_controller_mark_local_stop_started(
                            &(work->barge_controller),
                            decision.event_playback_generation,
                            decision.candidate_id,
                            local_stop_request_us);
                        if (!local_stop_marked) {
                            ESP_LOGE(TAG,
                                     "barge controller rejected generation-bound local stop transition generation=%lu candidate=%lu request_us=%llu confirmed_us=%llu",
                                     (unsigned long)decision.event_playback_generation,
                                     (unsigned long)decision.candidate_id,
                                     (unsigned long long)local_stop_request_us,
                                     (unsigned long long)decision.event_timestamp_us);
                            result = ESP_ERR_INVALID_STATE;
                            mic_capture_set_stop_reason(
                                &stop_reason,
                                NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                            break;
                        }
                        barge_stop_playback_generation =
                            decision.event_playback_generation;
                        barge_controller_candidate_id = decision.candidate_id;
                        barge_stop_request_armed = true;
                        barge_controller_confirmed = true;
                        barge_stop_requested_timestamp_us =
                            local_stop_request_us;
                        if (cancel_request.status ==
                            NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED) {
                            if (cancel_request.completed_stop_result != ESP_OK ||
                                cancel_request.completed_stop_timestamp_us <= 0) {
                                ESP_LOGE(TAG,
                                         "barge-in observed failed completed speaker stop generation=%lu err=%s timestamp_us=%lld",
                                         (unsigned long)decision.event_playback_generation,
                                         esp_err_to_name(
                                             cancel_request.completed_stop_result),
                                         (long long)cancel_request.completed_stop_timestamp_us);
                                result = cancel_request.completed_stop_result == ESP_OK
                                             ? ESP_ERR_INVALID_STATE
                                             : cancel_request.completed_stop_result;
                                mic_capture_set_stop_reason(
                                    &stop_reason,
                                    NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                                break;
                            }
                            barge_physical_stop_observed = true;
                            barge_physical_stop_timestamp_us =
                                (uint64_t)cancel_request.completed_stop_timestamp_us;
                        }
                        vad_speech_seen = true;
                        reset_awake_wait_budget_paused(
                            "confirmed_human_speech_during_playback");
                        vad_candidate_start_valid = true;
                        vad_candidate_start_sequence =
                            decision.candidate_start_sequence;
                        barge_event_confirmed_sequence = capture_sequence;
                        metrics_mark_speech_detected();
                NUWAX_RT_DIAG_LOGI(TAG,
                         "barge controller confirmed locally event=%s generation=%lu candidate=%lu onset_seq=%lu confirm_seq=%lu stop_armed=%d protocol_deferred_until_preroll_valid=1 frame_age_ms=%u",
                                 barge_event_id,
                                 (unsigned long)decision.event_playback_generation,
                                 (unsigned long)decision.candidate_id,
                                 (unsigned long)barge_event_onset_sequence,
                                 (unsigned long)barge_event_confirmed_sequence,
                                 cancel_accepted ? 1 : 0,
                                 (unsigned)frame_age_ms);
                    } else {
                        ESP_LOGW(TAG,
                                 "barge controller confirmation superseded before stop expected_generation=%lu request_status=%d",
                                 (unsigned long)decision.event_playback_generation,
                                 (int)cancel_request.status);
                        nuwax_barge_controller_reset(&(work->barge_controller));
                        barge_event_initialized = false;
                        barge_event_id[0] = '\0';
                        barge_audio_session_id[0] = '\0';
                        barge_playback_id[0] = '\0';
                    }
                } else if (decision.event ==
                               NUWAX_BARGE_EVENT_DEGRADED ||
                           decision.event ==
                               NUWAX_BARGE_EVENT_REJECTED) {
                    barge_probe_active = false;
                    barge_probe_playback_generation = 0U;
                    barge_probe_candidate_id = 0U;
                    barge_probe_elapsed_frames = 0U;
                NUWAX_RT_DIAG_LOGW(TAG,
                         "barge controller fail-closed event=%d state=%d reason=%d generation=%lu seq=%lu age_ms=%u aec=%d ref=%d",
                             (int)decision.event,
                             (int)decision.state_after,
                             (int)decision.reason,
                             (unsigned long)decision.event_playback_generation,
                             (unsigned long)capture_sequence,
                             (unsigned)frame_age_ms,
                             (int)health.aec_health,
                             (int)health.reference_health);
                }
            }
        }

        if (barge_controller_confirmed &&
            barge_physical_stop_observed &&
            nuwax_barge_controller_state(&(work->barge_controller)) ==
                NUWAX_BARGE_CONTROLLER_LOCAL_STOPPING) {
            if (barge_physical_stop_timestamp_us >=
                (work->barge_controller).timestamps.confirmed_timestamp_us) {
                metrics_record_duration(
                    NUWAX_CONVERSATION_LATENCY_BARGE_CONFIRM_TO_LOCAL_STOP,
                    (work->barge_controller).timestamps.confirmed_timestamp_us,
                    barge_physical_stop_timestamp_us);
            }
            if (barge_physical_stop_timestamp_us >=
                (work->barge_controller).timestamps.candidate_started_timestamp_us) {
                metrics_record_duration(
                    NUWAX_CONVERSATION_LATENCY_BARGE_ONSET_TO_LOCAL_STOP,
                    (work->barge_controller).timestamps.candidate_started_timestamp_us,
                    barge_physical_stop_timestamp_us);
            }
            uint64_t controller_stop_marker_us =
                barge_physical_stop_timestamp_us;
            if (controller_stop_marker_us <
                (work->barge_controller).timestamps.local_stop_started_timestamp_us) {
                controller_stop_marker_us =
                    (work->barge_controller).timestamps.local_stop_started_timestamp_us;
            }
            const bool playback_stop_marked =
                nuwax_barge_controller_mark_playback_stopped(
                &(work->barge_controller),
                barge_stop_playback_generation,
                barge_controller_candidate_id,
                controller_stop_marker_us);
            if (!playback_stop_marked) {
                ESP_LOGE(TAG,
                         "barge controller rejected physical stop transition generation=%lu candidate=%lu completion_us=%llu marker_us=%llu",
                         (unsigned long)barge_stop_playback_generation,
                         (unsigned long)barge_controller_candidate_id,
                         (unsigned long long)barge_physical_stop_timestamp_us,
                         (unsigned long long)controller_stop_marker_us);
                result = ESP_ERR_INVALID_STATE;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                break;
            }
        }
#if CONFIG_NUWAX_VOICE_LOCAL_VAD_ENDPOINT_ENABLE
        const uint32_t frame_ms = CONFIG_NUWAX_VOICE_FRAME_DURATION_MS;
        const uint32_t captured_after_frame_ms =
            (uint32_t)(((recorded_samples + samples_read) * 1000) / CONFIG_NUWAX_VOICE_SAMPLE_RATE);
        const bool followup_warmup =
            auto_followup_mode &&
            !upload_started &&
            (nuwax_prelisten_state_mode_is(&s_prelisten, "auto_followup") ||
             nuwax_prelisten_state_mode_is(&s_prelisten, "cancel_followup")) &&
            elapsed_since_start_ms < NUWAX_PRELISTEN_VAD_WARMUP_MS;
        const bool during_playback_post_candidate =
            during_playback_post_gate_required &&
            nuwax_mic_level_is_speech(level);
        const bool level_frame_is_speech =
            nuwax_mic_level_is_speech(level);
        const bool primary_frame_is_speech =
            !followup_warmup &&
            (playback_upload_gate_required
                 ? playback_vad_gate_candidate
                 : (during_playback_post_gate_required
                        ? during_playback_post_candidate
                        : level_frame_is_speech));
        const bool weak_level_evidence =
            nuwax_conversation_weak_level_evidence(
                level.avg_abs,
                level.peak,
                clean_result.before.avg_abs,
                (work->audio_cleaner).noise_floor_avg_abs,
                (uint32_t)CONFIG_NUWAX_AUDIO_CLEANER_SPEECH_GUARD_AVG_ABS,
                (uint32_t)CONFIG_NUWAX_AUDIO_CLEANER_SPEECH_GUARD_PEAK);
        const bool fresh_weak_speech_evidence =
            !primary_frame_is_speech && !followup_warmup &&
            (weak_level_evidence || dual_mic_aec_hint ||
             dual_mic_cleaner_hint || dual_mic_voice_hint);
        const bool trusted_weak_speech_evidence =
            fresh_weak_speech_evidence &&
            (dual_mic_aec_hint || dual_mic_cleaner_hint ||
             dual_mic_voice_hint);
        if (primary_frame_is_speech || trusted_weak_speech_evidence) {
            last_confirmed_speech_us = esp_timer_get_time();
        }
        const bool weak_start_level_evidence =
            nuwax_conversation_weak_start_level_evidence(
                level.avg_abs,
                level.peak,
                clean_result.before.avg_abs,
                (work->audio_cleaner).noise_floor_avg_abs,
                (uint32_t)CONFIG_NUWAX_AUDIO_CLEANER_SPEECH_GUARD_AVG_ABS,
                (uint32_t)CONFIG_NUWAX_AUDIO_CLEANER_SPEECH_GUARD_PEAK);
        const bool fresh_weak_start_evidence =
            nuwax_conversation_weak_start_frame_evidence(
                primary_frame_is_speech,
                followup_warmup,
                weak_start_level_evidence,
                dual_mic_aec_hint,
                dual_mic_cleaner_hint,
                dual_mic_voice_hint,
                dual_mic_human_first_hint);
        const uint32_t noise_floor_avg_abs =
            (work->audio_cleaner).noise_floor_avg_abs;
        const uint32_t relative_stable_avg_limit =
            noise_floor_avg_abs + noise_floor_avg_abs / 2U + 20U;
        const uint32_t relative_stable_peak_limit =
            noise_floor_avg_abs * 6U;
        const uint32_t stable_avg_limit =
            relative_stable_avg_limit >
                    (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_AVG_ABS
                ? relative_stable_avg_limit
                : (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_AVG_ABS;
        const uint32_t stable_peak_limit =
            relative_stable_peak_limit >
                    (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_PEAK
                ? relative_stable_peak_limit
                : (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_PEAK;
        const uint32_t energy_weak_avg_margin =
            stable_avg_limit / 8U > 24U ? stable_avg_limit / 8U : 24U;
        const uint32_t energy_weak_peak_margin =
            stable_peak_limit / 8U > 80U ? stable_peak_limit / 8U : 80U;
        const uint32_t energy_weak_avg_floor =
            stable_avg_limit + energy_weak_avg_margin;
        const uint32_t energy_weak_peak_floor =
            stable_peak_limit + energy_weak_peak_margin;
        const bool energy_only_weak_speech_evidence =
            fresh_weak_speech_evidence &&
            !trusted_weak_speech_evidence &&
            clean_result.after.avg_abs >= energy_weak_avg_floor &&
            clean_result.after.peak >= energy_weak_peak_floor;
        const bool stable_noise_evidence =
            !primary_frame_is_speech &&
            !trusted_weak_speech_evidence &&
            !energy_only_weak_speech_evidence &&
            clean_result.after.avg_abs <= stable_avg_limit &&
            clean_result.after.peak <= stable_peak_limit &&
            clean_result.before.avg_abs <
                (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_AVG_ABS &&
            clean_result.before.peak <
                (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_PEAK;
        const uint32_t high_snr_avg_threshold =
            noise_floor_avg_abs * 4U >
                    (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_AVG_ABS
                ? noise_floor_avg_abs * 4U
                : (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_AVG_ABS;
        const uint32_t high_snr_peak_threshold =
            noise_floor_avg_abs * 12U >
                    (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_PEAK
                ? noise_floor_avg_abs * 12U
                : (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_PEAK;
        const bool short_speech_tracking_allowed =
            short_speech_runtime_enabled && persistent_conversation_mode &&
            !during_playback_mode && !playback_active &&
            !acceptance_capture_enabled && !vad_speech_seen &&
            !followup_warmup;
        const bool correlated_weak_confirmed =
            nuwax_conversation_correlated_weak_observe(
                &correlated_weak,
                short_speech_tracking_allowed,
                weak_start_level_evidence,
                dual_mic_human_first_hint,
                capture_sequence_contiguous,
                !playback_echo_veto && !aec_playback_gate_active,
                frame_ms);
        if (correlated_weak_confirmed) {
            last_confirmed_speech_us = esp_timer_get_time();
        }
        const bool trusted_short_speech_evidence =
            dual_mic_aec_hint || dual_mic_cleaner_hint ||
            dual_mic_voice_hint || correlated_weak_confirmed ||
            (primary_frame_is_speech &&
             level.avg_abs >= high_snr_avg_threshold &&
             level.peak >= high_snr_peak_threshold);
        short_speech_observation =
            (nuwax_short_speech_observation_t){0};
        if (short_speech_tracking_allowed) {
            short_speech_observation = nuwax_short_speech_tracker_observe(
                &short_speech_tracker,
                primary_frame_is_speech,
                fresh_weak_start_evidence,
                trusted_short_speech_evidence,
                stable_noise_evidence,
                capture_sequence_contiguous,
                !playback_echo_veto && !aec_playback_gate_active,
                capture_sequence,
                nuwax_ws_connection_epoch(ws),
                frame_ms);
            if (!short_speech_observation.valid) {
                short_speech_runtime_enabled = false;
                nuwax_short_speech_tracker_reset(&short_speech_tracker);
                nuwax_conversation_correlated_weak_reset(&correlated_weak);
                ESP_LOGE(TAG,
                         "unified short-speech tracker invalid; legacy confirmation retained for current audio session");
            } else {
                if (NUWAX_SHORT_SPEECH_ACTIVE &&
                    short_speech_observation.candidate_started &&
                    !vad_candidate_start_valid) {
                    vad_candidate_start_valid = true;
                    vad_candidate_start_sequence = capture_sequence;
                }
                if (short_speech_observation.confirmed_now) {
                    if (NUWAX_SHORT_SPEECH_ACTIVE) {
                        const bool previous_onset_valid =
                            vad_candidate_start_valid;
                        const uint32_t previous_onset_sequence =
                            vad_candidate_start_sequence;
                        vad_candidate_start_sequence =
                            nuwax_preroll_choose_confirmed_onset(
                                true,
                                short_speech_observation
                                    .first_voiced_sequence,
                                previous_onset_valid,
                                previous_onset_sequence,
                                capture_sequence);
                        vad_candidate_start_valid = true;
                        if (previous_onset_valid &&
                            previous_onset_sequence !=
                                vad_candidate_start_sequence) {
                            ESP_LOGI(TAG,
                                     "confirmed short speech rebased stale onset old_seq=%lu confirmed_seq=%lu live_seq=%lu",
                                     (unsigned long)previous_onset_sequence,
                                     (unsigned long)
                                         vad_candidate_start_sequence,
                                     (unsigned long)capture_sequence);
                        }
                        short_speech_active_confirmations++;
                    } else {
                        short_speech_shadow_confirmations++;
                    }
                    ESP_LOGI(TAG,
                             "unified short-speech decision mode=%s reason=%s voiced_ms=%u strong_ms=%u weak_ms=%u span_ms=%u tail_ms=%u trusted=%d first_seq=%lu last_seq=%lu",
                             NUWAX_SHORT_SPEECH_MODE_NAME,
                             nuwax_short_speech_confirmation_reason_name(
                                 short_speech_observation.reason),
                             (unsigned)short_speech_observation.voiced_ms,
                             (unsigned)short_speech_observation.strong_ms,
                             (unsigned)short_speech_observation.weak_ms,
                             (unsigned)short_speech_observation
                                 .candidate_span_ms,
                             (unsigned)short_speech_observation
                                 .trailing_silence_ms,
                             short_speech_observation.trusted_evidence_seen
                                 ? 1
                                 : 0,
                             (unsigned long)short_speech_observation
                                 .first_voiced_sequence,
                             (unsigned long)short_speech_observation
                                 .last_voiced_sequence);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
                    if (!NUWAX_SHORT_SPEECH_ACTIVE) {
                        adaptive_seed_voiced_ms =
                            short_speech_observation.voiced_ms;
                        adaptive_seed_tail_ms =
                            short_speech_observation.trailing_silence_ms;
                        adaptive_seed_span_ms =
                            short_speech_observation.candidate_span_ms >=
                                    adaptive_seed_tail_ms
                                ? short_speech_observation
                                          .candidate_span_ms -
                                      adaptive_seed_tail_ms
                                : short_speech_observation.voiced_ms;
                        if (adaptive_seed_span_ms <
                            adaptive_seed_voiced_ms) {
                            adaptive_seed_span_ms =
                                adaptive_seed_voiced_ms;
                        }
                        adaptive_seed_trusted =
                            short_speech_observation
                                .trusted_evidence_seen;
                        short_endpoint_shadow_seed_pending = true;
                        short_endpoint_shadow_ws_epoch =
                            nuwax_ws_connection_epoch(ws);
                        short_endpoint_shadow_prediction_logged = false;
                        short_endpoint_shadow_commit_logged = false;
                    }
#endif
                }
            }
        } else if (!vad_speech_seen) {
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
        }
        const bool short_policy_owns_confirmation =
            NUWAX_SHORT_SPEECH_ACTIVE && short_speech_runtime_enabled &&
            persistent_conversation_mode && !during_playback_mode &&
            !playback_active && !acceptance_capture_enabled;
        const bool unified_speech_confirmed_now =
            short_speech_tracking_allowed &&
            short_speech_observation.valid &&
            short_speech_observation.confirmed_now;
        const bool weak_start_eligible =
            nuwax_conversation_weak_start_eligible(
                persistent_conversation_mode,
                during_playback_mode,
                playback_active,
                acceptance_capture_enabled,
                vad_speech_seen,
                followup_warmup);
        nuwax_speech_confirmation_observation_t weak_start_window = {0};
        if (weak_start_eligible) {
            /* Strict speech is stronger evidence than the weak fallback. It
             * must not look like silence to an already active weak candidate,
             * but it still does not count toward the weak 180 ms budget. */
            weak_start_window =
                nuwax_speech_confirmation_observe_with_continuity(
                    &weak_start_confirmation,
                    &s_ordinary_weak_start_policy,
                    fresh_weak_start_evidence,
                    primary_frame_is_speech,
                    frame_ms);
            if (!weak_start_window.valid) {
                nuwax_speech_confirmation_reset(&weak_start_confirmation);
                ESP_LOGE(TAG,
                         "ordinary weak speech start policy invalid; strict VAD retained for current audio session");
            } else {
                if (fresh_weak_start_evidence) {
                    weak_start_evidence_frames++;
                }
                if (weak_start_window.candidate_started &&
                    !vad_candidate_start_valid) {
                    vad_candidate_start_valid = true;
                    vad_candidate_start_sequence = capture_sequence;
                }
            }
        } else {
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
        }
        const bool weak_start_confirmed_now =
            weak_start_eligible && weak_start_window.valid &&
            weak_start_window.confirmed_now;
        const bool weak_continuation_eligible =
            persistent_conversation_mode && vad_speech_seen &&
            !during_playback_mode && !playback_active &&
            !acceptance_capture_enabled;
        if (primary_frame_is_speech && weak_continuation_eligible) {
            nuwax_conversation_weak_continuation_rearm(&weak_continuation);
        }
        const bool weak_continuation_confirmed =
            nuwax_conversation_weak_continuation_observe(
                &weak_continuation,
                weak_continuation_eligible,
                fresh_weak_speech_evidence,
                trusted_weak_speech_evidence,
                NUWAX_CONTINUOUS_ENDPOINT_WEAK_CONFIRM_FRAMES,
                (NUWAX_CONTINUOUS_ENDPOINT_WEAK_BRIDGE_MS + frame_ms - 1U) /
                    frame_ms);
        if (fresh_weak_speech_evidence && weak_continuation_eligible) {
            weak_continuation_evidence_frames++;
        }
        if (weak_continuation_confirmed) {
            weak_continuation_confirmed_frames++;
            last_confirmed_speech_us = esp_timer_get_time();
        }
        const bool unified_weak_confirmed_now =
            short_policy_owns_confirmation &&
            unified_speech_confirmed_now && fresh_weak_start_evidence;
        frame_is_speech =
            primary_frame_is_speech || unified_weak_confirmed_now ||
            (!short_policy_owns_confirmation && weak_start_confirmed_now) ||
            weak_continuation_confirmed;
        nuwax_speech_confirmation_observation_t speech_window = {0};
        bool speech_window_tracks_candidate = false;
#if NUWAX_SPEECH_CONFIRMATION_TRACKING
        bool speech_window_tracking_allowed =
            speech_confirmation_runtime_enabled &&
            persistent_conversation_mode &&
            !during_playback_mode &&
            !playback_active &&
            !acceptance_capture_enabled &&
            !vad_speech_seen;
        if (speech_window_tracking_allowed) {
            speech_window = nuwax_speech_confirmation_observe(
                &speech_confirmation,
                &s_normal_speech_confirmation_policy,
                frame_is_speech,
                frame_ms);
            if (!speech_window.valid) {
                speech_confirmation_runtime_enabled = false;
                speech_window_tracking_allowed = false;
                nuwax_speech_confirmation_reset(&speech_confirmation);
                ESP_LOGE(TAG,
                         "speech confirmation policy invalid; legacy consecutive gate restored for current audio session");
            } else if (speech_window.confirmed_now) {
                ESP_LOGI(TAG,
                         "speech confirmation window decision mode=%s voiced_ms=%u span_ms=%u window_ms=%u required_ms=%u reset_silence_ms=%u",
                         NUWAX_SPEECH_CONFIRMATION_MODE_NAME,
                         (unsigned)speech_window.voiced_ms,
                         (unsigned)speech_window.candidate_span_ms,
                         (unsigned)CONFIG_NUWAX_SPEECH_CONFIRMATION_WINDOW_MS,
                         (unsigned)CONFIG_NUWAX_SPEECH_CONFIRMATION_REQUIRED_VOICED_MS,
                         (unsigned)CONFIG_NUWAX_SPEECH_CONFIRMATION_RESET_SILENCE_MS);
            }
        } else if (!vad_speech_seen) {
            nuwax_speech_confirmation_reset(&speech_confirmation);
        }
        speech_window_tracks_candidate =
            NUWAX_SPEECH_CONFIRMATION_ACTIVE &&
            speech_window_tracking_allowed && speech_window.valid;
#else
        (void)speech_confirmation_runtime_enabled;
#endif
        bool legacy_speech_confirmed_now = false;
        bool window_speech_confirmed = false;
        uint32_t confirm_frames = vad_speech_frames;
        if (frame_is_speech) {
            if (persistent_conversation_mode &&
                continuous_endpoint_candidate
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
                && !(adaptive_session_eligible && !during_playback_mode &&
                     !playback_active && !acceptance_capture_enabled)
#endif
                ) {
                ESP_LOGI(TAG,
                         "continuous local VAD endpoint candidate canceled seq=%lu silence_ms=%lu",
                         (unsigned long)captured_frames,
                         (unsigned long)(vad_silence_frames * frame_ms));
                continuous_endpoint_candidate = false;
            }
            if (!vad_speech_seen &&
                ((speech_window_tracks_candidate &&
                  speech_window.candidate_started) ||
                 (!speech_window_tracks_candidate &&
                  vad_speech_frames == 0U)) &&
                !vad_candidate_start_valid) {
                vad_candidate_start_valid = true;
                vad_candidate_start_sequence = capture_sequence;
            }
            vad_speech_frames++;
            vad_silence_frames = 0;
            const uint32_t min_speech_ms =
                playback_upload_gate_required
                    ? NUWAX_DURING_PLAYBACK_NEAREND_MIN_SPEECH_MS
                    : (during_playback_post_gate_required
                           ? NUWAX_DURING_PLAYBACK_POST_MIN_SPEECH_MS
                           : CONFIG_NUWAX_VOICE_LOCAL_VAD_MIN_SPEECH_MS);
            confirm_frames = vad_speech_frames;
            const bool legacy_speech_confirmed =
                confirm_frames * frame_ms >= min_speech_ms;
            window_speech_confirmed =
                speech_window_tracks_candidate &&
                speech_window.confirmed_now;
            legacy_speech_confirmed_now =
                legacy_speech_confirmed || window_speech_confirmed ||
                weak_start_confirmed_now;
        } else {
            if (vad_speech_seen) {
                vad_silence_frames++;
            } else {
                vad_speech_frames = 0;
                if (!speech_window_tracks_candidate ||
                    speech_window.candidate_reset ||
                    !speech_window.candidate_active) {
                    if (!weak_start_window.candidate_active &&
                        !(NUWAX_SHORT_SPEECH_ACTIVE &&
                          short_speech_observation.candidate_active)) {
                        vad_candidate_start_valid = false;
                    }
                }
            }
        }

        const bool speech_confirmed_now = short_policy_owns_confirmation
                                              ? unified_speech_confirmed_now
                                              : legacy_speech_confirmed_now;
        if (!vad_speech_seen && speech_confirmed_now) {
            vad_speech_seen = true;
            if (weak_start_confirmed_now &&
                !short_policy_owns_confirmation) {
                weak_start_confirmation_count++;
            }
            if (short_policy_owns_confirmation &&
                short_speech_observation.trailing_silence_ms > 0U) {
                vad_silence_frames =
                    short_speech_observation.trailing_silence_ms / frame_ms;
            }
            confirmed_speech_us = esp_timer_get_time();
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_v2_session = short_policy_owns_confirmation;
            adaptive_session_eligible = persistent_conversation_mode &&
                                         !during_playback_mode &&
                                         !playback_active &&
                                         !acceptance_capture_enabled;
            adaptive_seed_pending = short_policy_owns_confirmation;
            if (adaptive_seed_pending) {
                adaptive_seed_voiced_ms = short_speech_observation.voiced_ms;
                adaptive_seed_tail_ms =
                    short_speech_observation.trailing_silence_ms;
                adaptive_seed_span_ms =
                    short_speech_observation.candidate_span_ms >=
                            adaptive_seed_tail_ms
                        ? short_speech_observation.candidate_span_ms -
                              adaptive_seed_tail_ms
                        : short_speech_observation.voiced_ms;
                if (adaptive_seed_span_ms < adaptive_seed_voiced_ms) {
                    adaptive_seed_span_ms = adaptive_seed_voiced_ms;
                }
                adaptive_seed_trusted =
                    short_speech_observation.trusted_evidence_seen;
            }
#endif
            if (upload_started && !acceptance_capture_enabled &&
                !cloud_progress_watchdog_armed &&
                !conversation_wait_text_deadline_owned_by_turn_guard()) {
                cloud_progress_watchdog_armed = true;
                cloud_progress_watchdog_epoch =
                    s_conversation_cloud_progress_epoch;
                cloud_progress_watchdog_deadline_ms =
                    monotonic_ms() +
                    NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS;
            }
            reset_awake_wait_budget_paused(
                during_playback_mode
                    ? "confirmed_human_speech_during_playback"
                    : "confirmed_human_speech");
            if (during_playback_mode && playback_gate_open_frame == 0) {
                playback_gate_open_frame = captured_frames;
            }
            metrics_mark_speech_detected();
            const uint32_t confirmation_speech_ms =
                short_policy_owns_confirmation
                    ? (uint32_t)short_speech_observation.voiced_ms
                    : (weak_start_confirmed_now
                           ? (uint32_t)weak_start_window.voiced_ms
                           : (window_speech_confirmed
                                  ? (uint32_t)speech_window.voiced_ms
                                  : confirm_frames * frame_ms));
            const char *confirmation_name = short_policy_owns_confirmation
                                                ? nuwax_short_speech_confirmation_reason_name(
                                                      short_speech_observation.reason)
                                                : (weak_start_confirmed_now
                                                       ? "weak_far_field_window"
                                                       : (window_speech_confirmed
                                                              ? "window"
                                                              : "legacy"));
            NUWAX_RT_DIAG_LOGI(TAG,
                 "local VAD speech confirmed seq=%lu avg_abs=%lu peak=%lu raw_avg=%lu raw_peak=%lu speech_ms=%lu confirmation=%s playback_gate=%d gate_score=%lu echo_veto=%d human_seed=%d dual_candidate=%d dual_voice=%d dual_diff_avg=%lu dual_diff_energy_q15=%lu dual_balance_q15=%lu",
                     (unsigned long)captured_frames,
                     (unsigned long)level.avg_abs,
                     (unsigned long)level.peak,
                     (unsigned long)raw_level.avg_abs,
                     (unsigned long)raw_level.peak,
                     (unsigned long)confirmation_speech_ms,
                     confirmation_name,
                     playback_upload_gate_required ? 1 : 0,
                     (unsigned long)playback_gate_score_frames,
                     playback_echo_veto ? 1 : 0,
                     playback_human_seed_active ? 1 : 0,
                     playback_dual_mic_candidate ? 1 : 0,
                     dual_mic.voice_like ? 1 : 0,
                     (unsigned long)dual_mic.diff_avg_abs,
                     (unsigned long)dual_mic.diff_energy_ratio_q15,
                     (unsigned long)dual_mic.level_balance_q15);
        }

        /* Decide the 60-second idle boundary only after classifying the frame
         * already delivered by I2S. A real utterance that starts at the edge
         * gets one bounded confirmation window; an unconfirmed noise candidate
         * cannot extend the session beyond that window. */
        const bool idle_expiry_speech_candidate =
            ordinary_listen_speech_candidate_active(
                &speech_confirmation,
                speech_confirmation_runtime_enabled,
                &weak_start_confirmation,
                vad_speech_seen,
                short_speech_runtime_enabled &&
                    short_speech_observation.candidate_active,
                vad_speech_frames,
                frame_ms);
        const bool head_touch_playback_speech_candidate =
            barge_controller_confirmed || frame_is_speech ||
            vad_candidate_start_valid || playback_gate_candidate ||
            playback_nearend_candidate || playback_dual_mic_candidate;
        const bool head_touch_user_confirmed =
            vad_speech_seen ||
            (s_head_touch_agent_intent.source ==
                 NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK &&
             barge_controller_confirmed);
        const bool head_touch_user_candidate =
            s_head_touch_agent_intent.source ==
                    NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK
                ? head_touch_playback_speech_candidate
                : idle_expiry_speech_candidate;
        if (!stop_requested &&
            head_touch_agent_consume_capture_frame(
                ws,
                listen_started,
                upload_started,
                conversation_audio_session_id,
                barge_audio_session_id,
                head_touch_user_confirmed,
                head_touch_user_candidate)) {
            stop_requested = true;
            auto_followup_replaced_by_command = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT);
            break;
        }
        if (persistent_conversation_mode && !stop_requested &&
            nuwax_awake_session_state_generation_matches(
                &s_awake_session, capture_awake_generation) &&
            nuwax_awake_session_state_can_enter_idle_sleep(
                &s_awake_session,
                monotonic_ms(),
                conversation_state_current() == NUWAX_APP_STATE_LISTENING,
                s_turn_guard.active,
                playback_active,
                idle_expiry_speech_candidate)) {
            stop_requested = true;
            persistent_awake_timeout = true;
            nuwax_listen_resume_state_set_idle_expiry_pending(
                &s_listen_resume, true);
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_AWAKE_TIMEOUT);
            ESP_LOGI(TAG,
                     "continuous conversation idle timeout after frame classification; closing uplink frames_recorded=%lu",
                     (unsigned long)recorded_frames);
        }

        /* After local confirmation, preserve every frame until the speaker
         * queue is physically empty.  The upload gate may not be open yet, so
         * this cleanup cannot depend on a second VAD confirmation. */
        if (!upload_started &&
            auto_followup_mode &&
            during_playback_mode &&
            barge_local_cancel_requested &&
            speaker_pending &&
            !barge_current_frame_buffered) {
            result = store_auto_followup_preroll_frame(
                s_audio_samples,
                s_audio_preclean_samples,
                s_audio_human_rescue_source,
                s_audio_ref_samples,
                samples_read,
                playback_active,
                (work->live_aec).human_rescue_mix_q15,
                frame_rescue_source_kind,
                &frame_rescue_provenance,
                &frame_cleaner_state_before,
                &frame_preroll_trust,
                frame_is_speech,
                capture_sequence,
                &preroll_write,
                &preroll_count);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "barge-in pending-speaker frame store failed seq=%lu: %s",
                         (unsigned long)capture_sequence,
                         esp_err_to_name(result));
                break;
            }
            barge_current_frame_buffered = true;

            uint32_t repair_actual_start_sequence = capture_sequence;
            uint32_t repaired_frames = 0;
            uint32_t untrusted_source_frames = 0;
            const esp_err_t repair_err = repair_auto_followup_human_preroll(
                preroll_write,
                preroll_count,
                capture_sequence,
                capture_sequence,
                0,
                (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                s_audio_cleaner_runtime_enabled,
                &(work->audio_cleaner),
                &repair_actual_start_sequence,
                &repaired_frames,
                &untrusted_source_frames);
            uint32_t preserved_frames = 0;
            uint32_t silenced_frames = 0;
            uint32_t max_ref_correlation_q15 = 0;
            const esp_err_t sanitize_err = sanitize_barge_overlap_preroll(
                preroll_write,
                preroll_count,
                capture_sequence,
                capture_sequence,
                repair_err == ESP_OK,
                &preserved_frames,
                &silenced_frames,
                &max_ref_correlation_q15);
            if (repair_err != ESP_OK || sanitize_err != ESP_OK) {
                ESP_LOGW(TAG,
                         "barge-in pending-speaker cleanup failed seq=%lu repair=%s sanitize=%s",
                         (unsigned long)capture_sequence,
                         esp_err_to_name(repair_err),
                         esp_err_to_name(sanitize_err));
                uint32_t fail_closed_frames = 0;
                const esp_err_t fail_closed_err = silence_barge_preroll_range(
                    preroll_write,
                    preroll_count,
                    capture_sequence,
                    capture_sequence,
                    &fail_closed_frames);
                if (fail_closed_err != ESP_OK) {
                    ESP_LOGE(TAG,
                             "barge-in pending-speaker fail-closed silence failed seq=%lu: %s",
                             (unsigned long)capture_sequence,
                             esp_err_to_name(fail_closed_err));
                    result = fail_closed_err;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    break;
                }
                barge_current_frame_sanitized = true;
                barge_overlap_frames_silenced += fail_closed_frames;
            } else {
                barge_current_frame_sanitized = true;
                barge_overlap_frames_preserved += preserved_frames;
                barge_overlap_frames_silenced += silenced_frames;
                playback_human_preroll_repaired_frames += repaired_frames;
                playback_human_preroll_untrusted_source_frames +=
                    untrusted_source_frames;
                if (max_ref_correlation_q15 >
                    barge_overlap_max_ref_correlation_q15) {
                    barge_overlap_max_ref_correlation_q15 =
                        max_ref_correlation_q15;
                }
            }
        }

        if (!upload_started &&
            during_playback_mode &&
            barge_local_cancel_requested &&
            barge_post_stop_guard_frame) {
            result = store_auto_followup_preroll_frame(
                s_audio_samples,
                s_audio_preclean_samples,
                s_audio_human_rescue_source,
                s_audio_ref_samples,
                samples_read,
                true,
                (work->live_aec).human_rescue_mix_q15,
                frame_rescue_source_kind,
                &frame_rescue_provenance,
                &frame_cleaner_state_before,
                &frame_preroll_trust,
                frame_is_speech,
                capture_sequence,
                &preroll_write,
                &preroll_count);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "barge-in post-stop guard store failed seq=%lu: %s",
                         (unsigned long)capture_sequence,
                         esp_err_to_name(result));
                break;
            }
            uint32_t repair_actual_start_sequence = capture_sequence;
            uint32_t repaired_frames = 0;
            uint32_t untrusted_source_frames = 0;
            const esp_err_t repair_err = repair_auto_followup_human_preroll(
                preroll_write,
                preroll_count,
                capture_sequence,
                capture_sequence,
                0,
                (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                s_audio_cleaner_runtime_enabled,
                &(work->audio_cleaner),
                &repair_actual_start_sequence,
                &repaired_frames,
                &untrusted_source_frames);
            uint32_t preserved_frames = 0;
            uint32_t silenced_frames = 0;
            uint32_t max_ref_correlation_q15 = 0;
            const esp_err_t sanitize_err = sanitize_barge_overlap_preroll(
                preroll_write,
                preroll_count,
                capture_sequence,
                capture_sequence,
                repair_err == ESP_OK,
                &preserved_frames,
                &silenced_frames,
                &max_ref_correlation_q15);
            if (repair_err != ESP_OK || sanitize_err != ESP_OK) {
                ESP_LOGW(TAG,
                         "barge-in post-stop guard sanitize failed seq=%lu repair=%s sanitize=%s",
                         (unsigned long)capture_sequence,
                         esp_err_to_name(repair_err),
                         esp_err_to_name(sanitize_err));
                uint32_t fail_closed_frames = 0;
                const esp_err_t fail_closed_err = silence_barge_preroll_range(
                    preroll_write,
                    preroll_count,
                    capture_sequence,
                    capture_sequence,
                    &fail_closed_frames);
                if (fail_closed_err != ESP_OK) {
                    ESP_LOGE(TAG,
                             "barge-in post-stop fail-closed silence failed seq=%lu: %s",
                             (unsigned long)capture_sequence,
                             esp_err_to_name(fail_closed_err));
                    result = fail_closed_err;
                    mic_capture_set_stop_reason(
                        &stop_reason,
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                    break;
                }
                barge_overlap_frames_silenced += fail_closed_frames;
            } else {
                barge_overlap_frames_preserved += preserved_frames;
                barge_overlap_frames_silenced += silenced_frames;
                playback_human_preroll_repaired_frames += repaired_frames;
                playback_human_preroll_untrusted_source_frames +=
                    untrusted_source_frames;
                if (max_ref_correlation_q15 >
                    barge_overlap_max_ref_correlation_q15) {
                    barge_overlap_max_ref_correlation_q15 =
                        max_ref_correlation_q15;
                }
            }
            if (nuwax_mic_level_should_log(captured_frames, false)) {
                NUWAX_RT_DIAG_LOGI(TAG,
                         "barge-in post-stop guard resolved seq=%lu guard_frames=%lu preserved=%lu silenced=%lu aec_ok=%d silent_ref=%d",
                         (unsigned long)capture_sequence,
                         (unsigned long)barge_post_cancel_guard_frames,
                         (unsigned long)preserved_frames,
                         (unsigned long)silenced_frames,
                         frame_preroll_trust.aec_processed_ok ? 1 : 0,
                         frame_preroll_trust.verified_silent_passthrough ? 1 : 0);
            }
            captured_frames++;
            continue;
        }

        if (!upload_started && auto_followup_mode && during_playback_mode &&
            vad_speech_seen && !barge_controller_confirmed &&
            !s_post_playback_resume_pending) {
            /* A level-only VAD decision cannot interrupt TTS. Keep buffering
             * while the health-gated controller remains fail-closed. */
            vad_speech_seen = false;
            vad_speech_frames = 0;
            vad_silence_frames = 0;
            vad_candidate_start_valid = false;
            nuwax_speech_confirmation_reset(&speech_confirmation);
            nuwax_speech_confirmation_reset(&weak_start_confirmation);
            nuwax_short_speech_tracker_reset(&short_speech_tracker);
            nuwax_conversation_correlated_weak_reset(&correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
            adaptive_session_eligible = false;
            adaptive_v2_session = false;
#endif
        }

        if (!upload_started && auto_followup_mode && vad_speech_seen &&
            !(during_playback_mode && s_post_playback_resume_pending)) {
            const char *upload_audio_session_id = NULL;
            const char *upload_request_id = NULL;
            const uint32_t detected_onset_sequence =
                during_playback_mode && playback_human_nearfield_onset_valid
                    ? playback_human_nearfield_onset_sequence
                    : (vad_candidate_start_valid ? vad_candidate_start_sequence
                                                 : capture_sequence);
            if (during_playback_mode) {
                if (!barge_event_initialized ||
                    !barge_controller_confirmed ||
                    !barge_stop_request_armed) {
                    ESP_LOGE(TAG,
                             "barge-in invariant failed event=%d controller=%d stop=%d",
                             barge_event_initialized ? 1 : 0,
                             barge_controller_confirmed ? 1 : 0,
                             barge_stop_request_armed ? 1 : 0);
                    result = ESP_ERR_INVALID_STATE;
                    stop_reason =
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR;
                    break;
                }
                upload_audio_session_id = barge_audio_session_id;
                upload_request_id = barge_event_id;
                if (!barge_local_cancel_requested) {
                    result = store_auto_followup_preroll_frame(
                        s_audio_samples,
                        s_audio_preclean_samples,
                        s_audio_human_rescue_source,
                        s_audio_ref_samples,
                        samples_read,
                        playback_active,
                        (work->live_aec).human_rescue_mix_q15,
                        frame_rescue_source_kind,
                        &frame_rescue_provenance,
                        &frame_cleaner_state_before,
                        &frame_preroll_trust,
                        true,
                        capture_sequence,
                        &preroll_write,
                        &preroll_count);
                    if (result != ESP_OK) {
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                        ESP_LOGE(TAG,
                                 "barge-in confirmation frame store failed seq=%lu: %s",
                                 (unsigned long)capture_sequence,
                                 esp_err_to_name(result));
                        break;
                    }
                    barge_current_frame_buffered = true;

                    uint32_t repair_actual_start_sequence = barge_event_onset_sequence;
                    uint32_t repaired_frames = 0;
                    uint32_t untrusted_source_frames = 0;
                    playback_human_preroll_repair_attempts++;
                    const esp_err_t repair_err = repair_auto_followup_human_preroll(
                        preroll_write,
                        preroll_count,
                        barge_event_onset_sequence,
                        capture_sequence,
                        NUWAX_BARGE_IN_PREROLL_LEAD_FRAMES,
                        (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                        s_audio_cleaner_runtime_enabled,
                        &(work->audio_cleaner),
                        &repair_actual_start_sequence,
                        &repaired_frames,
                        &untrusted_source_frames);
                    if (repair_err == ESP_OK) {
                        playback_human_preroll_repair_successes++;
                        playback_human_preroll_repaired_frames += repaired_frames;
                        playback_human_preroll_untrusted_source_frames +=
                            untrusted_source_frames;
                    } else {
                        playback_human_preroll_repair_failures++;
                        ESP_LOGW(TAG,
                                 "barge-in overlap repair failed onset_seq=%lu end_seq=%lu: %s",
                                 (unsigned long)barge_event_onset_sequence,
                                 (unsigned long)capture_sequence,
                                 esp_err_to_name(repair_err));
                    }

                    uint32_t preserved_frames = 0;
                    uint32_t silenced_frames = 0;
                    uint32_t max_ref_correlation_q15 = 0;
                    const esp_err_t sanitize_err = sanitize_barge_overlap_preroll(
                        preroll_write,
                        preroll_count,
                        repair_actual_start_sequence,
                        capture_sequence,
                        repair_err == ESP_OK,
                        &preserved_frames,
                        &silenced_frames,
                        &max_ref_correlation_q15);
                    if (repair_err != ESP_OK || sanitize_err != ESP_OK) {
                        ESP_LOGW(TAG,
                                 "barge-in overlap sanitize failed onset_seq=%lu end_seq=%lu: %s",
                                 (unsigned long)barge_event_onset_sequence,
                                 (unsigned long)capture_sequence,
                                 esp_err_to_name(sanitize_err));
                        uint32_t fail_closed_frames = 0;
                        const esp_err_t fail_closed_err =
                            silence_barge_preroll_range(
                                preroll_write,
                                preroll_count,
                                repair_actual_start_sequence,
                                capture_sequence,
                                &fail_closed_frames);
                        if (fail_closed_err != ESP_OK) {
                            ESP_LOGE(TAG,
                                     "barge-in overlap fail-closed silence failed start_seq=%lu end_seq=%lu: %s",
                                     (unsigned long)repair_actual_start_sequence,
                                     (unsigned long)capture_sequence,
                                     esp_err_to_name(fail_closed_err));
                            result = fail_closed_err;
                            mic_capture_set_stop_reason(
                                &stop_reason,
                                NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                            break;
                        }
                        barge_current_frame_sanitized = true;
                        barge_overlap_frames_silenced += fail_closed_frames;
                    } else {
                        barge_current_frame_sanitized = true;
                        barge_overlap_frames_preserved += preserved_frames;
                        barge_overlap_frames_silenced += silenced_frames;
                        if (max_ref_correlation_q15 >
                            barge_overlap_max_ref_correlation_q15) {
                            barge_overlap_max_ref_correlation_q15 =
                                max_ref_correlation_q15;
                        }
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "barge-in overlap sanitized start_seq=%lu onset_seq=%lu end_seq=%lu preserved=%lu silenced=%lu max_ref_corr_q15=%lu threshold_q15=%u",
                                 (unsigned long)repair_actual_start_sequence,
                                 (unsigned long)barge_event_onset_sequence,
                                 (unsigned long)capture_sequence,
                                 (unsigned long)preserved_frames,
                                 (unsigned long)silenced_frames,
                                 (unsigned long)max_ref_correlation_q15,
                                 (unsigned)NUWAX_BARGE_IN_OVERLAP_MAX_REF_CORR_Q15);
                    }
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "barge-in local speaker stop already armed event=%s generation=%lu fade_ms=%u seq=%lu",
                             barge_event_id,
                             (unsigned long)barge_stop_playback_generation,
                             (unsigned)NUWAX_BARGE_IN_LOCAL_FADE_MS,
                             (unsigned long)capture_sequence);
                    nuwax_app_shell_set_conversation_status("VOICE",
                                                            "LISTENING",
                                                            "listening",
                                                            true);
                    set_state(NUWAX_APP_STATE_LISTENING);
                    barge_local_cancel_requested = true;
                    /* The onset-to-confirm prefix remains authoritative. The
                     * post-stop guard keeps processing the acoustic tail and
                     * preserves only frames whose cleanup can be proven. */
                    vad_silence_frames = 0;
                    playback_human_preroll_repair_pending = false;
                }
                /* Never start the new uplink in the same frame that requested
                 * local cancellation. A capture snapshot can observe the
                 * speaker queue as empty while its last DMA samples are still
                 * audible; the independent post-stop cleanup owns that tail. */
                if (speaker_pending ||
                    !barge_physical_stop_observed ||
                    !barge_post_cancel_guard_started ||
                    barge_post_cancel_guard_frames > 0) {
                    if (!barge_current_frame_buffered) {
                        result = store_auto_followup_preroll_frame(
                            s_audio_samples,
                            s_audio_preclean_samples,
                            s_audio_human_rescue_source,
                            s_audio_ref_samples,
                            samples_read,
                            playback_active,
                            (work->live_aec).human_rescue_mix_q15,
                            frame_rescue_source_kind,
                            &frame_rescue_provenance,
                            &frame_cleaner_state_before,
                            &frame_preroll_trust,
                            frame_is_speech,
                            capture_sequence,
                            &preroll_write,
                            &preroll_count);
                        if (result != ESP_OK) {
                            mic_capture_set_stop_reason(
                                &stop_reason,
                                NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                            ESP_LOGE(TAG,
                                     "barge-in held frame store failed seq=%lu: %s",
                                     (unsigned long)capture_sequence,
                                     esp_err_to_name(result));
                            break;
                        }
                        barge_current_frame_buffered = true;
                    }
                    if ((speaker_pending ||
                         !barge_physical_stop_observed) &&
                        !barge_current_frame_sanitized) {
                        uint32_t repair_actual_start_sequence = capture_sequence;
                        uint32_t repaired_frames = 0;
                        uint32_t untrusted_source_frames = 0;
                        const esp_err_t repair_err = repair_auto_followup_human_preroll(
                            preroll_write,
                            preroll_count,
                            capture_sequence,
                            capture_sequence,
                            0,
                            (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                            s_audio_cleaner_runtime_enabled,
                            &(work->audio_cleaner),
                            &repair_actual_start_sequence,
                            &repaired_frames,
                            &untrusted_source_frames);
                        uint32_t preserved_frames = 0;
                        uint32_t silenced_frames = 0;
                        uint32_t max_ref_correlation_q15 = 0;
                        const esp_err_t sanitize_err = sanitize_barge_overlap_preroll(
                            preroll_write,
                            preroll_count,
                            capture_sequence,
                            capture_sequence,
                            repair_err == ESP_OK,
                            &preserved_frames,
                            &silenced_frames,
                            &max_ref_correlation_q15);
                        if (repair_err != ESP_OK || sanitize_err != ESP_OK) {
                            ESP_LOGW(TAG,
                                     "barge-in held overlap cleanup failed seq=%lu repair=%s sanitize=%s",
                                     (unsigned long)capture_sequence,
                                     esp_err_to_name(repair_err),
                                     esp_err_to_name(sanitize_err));
                            uint32_t fail_closed_frames = 0;
                            const esp_err_t fail_closed_err =
                                silence_barge_preroll_range(
                                    preroll_write,
                                    preroll_count,
                                    capture_sequence,
                                    capture_sequence,
                                    &fail_closed_frames);
                            if (fail_closed_err != ESP_OK) {
                                ESP_LOGE(TAG,
                                         "barge-in held fail-closed silence failed seq=%lu: %s",
                                         (unsigned long)capture_sequence,
                                         esp_err_to_name(fail_closed_err));
                                result = fail_closed_err;
                                mic_capture_set_stop_reason(
                                    &stop_reason,
                                    NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                                break;
                            }
                            barge_current_frame_sanitized = true;
                            barge_overlap_frames_silenced += fail_closed_frames;
                        } else {
                            barge_current_frame_sanitized = true;
                            barge_overlap_frames_preserved += preserved_frames;
                            barge_overlap_frames_silenced += silenced_frames;
                            playback_human_preroll_repaired_frames += repaired_frames;
                            playback_human_preroll_untrusted_source_frames +=
                                untrusted_source_frames;
                            if (max_ref_correlation_q15 >
                                barge_overlap_max_ref_correlation_q15) {
                                barge_overlap_max_ref_correlation_q15 =
                                    max_ref_correlation_q15;
                            }
                        }
                    }
                    if (nuwax_mic_level_should_log(captured_frames, false)) {
                        NUWAX_RT_DIAG_LOGI(TAG,
                                 "barge-in uplink held with contiguous preroll seq=%lu speaker_pending=%d guard_frames=%lu speech=%d buffered=%lu preserved=%lu silenced=%lu",
                                 (unsigned long)capture_sequence,
                                 speaker_pending ? 1 : 0,
                                 (unsigned long)barge_post_cancel_guard_frames,
                                 frame_is_speech ? 1 : 0,
                                 (unsigned long)preroll_count,
                                 (unsigned long)barge_overlap_frames_preserved,
                                 (unsigned long)barge_overlap_frames_silenced);
                    }
                    captured_frames++;
                    continue;
                }

                if (!barge_protocol_enqueued) {
                    if (!nuwax_capture_phase_allows_new_session(
                            &capture_phase_handoff)) {
                        if (!barge_current_frame_buffered) {
                            result = store_auto_followup_preroll_frame(
                                s_audio_samples,
                                s_audio_preclean_samples,
                                s_audio_human_rescue_source,
                                s_audio_ref_samples,
                                samples_read,
                                playback_active,
                                (work->live_aec).human_rescue_mix_q15,
                                frame_rescue_source_kind,
                                &frame_rescue_provenance,
                                &frame_cleaner_state_before,
                                &frame_preroll_trust,
                                frame_is_speech,
                                capture_sequence,
                                &preroll_write,
                                &preroll_count);
                            if (result != ESP_OK) {
                                mic_capture_set_stop_reason(
                                    &stop_reason,
                                    NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                                break;
                            }
                        }
                        captured_frames++;
                        continue;
                    }
                    esp_err_t preroll_validation_err = ESP_OK;
                    uint32_t final_preserved_frames = 0U;
                    uint32_t final_silenced_frames = 0U;
                    uint32_t final_max_ref_correlation_q15 = 0U;
                    if (preroll_count == 0U || capture_sequence == 0U) {
                        preroll_validation_err = ESP_ERR_NOT_FOUND;
                    } else {
                        /* Re-run the inexpensive trust/correlation gate across
                         * the complete buffered utterance. Frames accumulated
                         * while the protocol dispatcher was pending must obey
                         * the same overlap policy as the confirmation window. */
                        preroll_validation_err =
                            sanitize_barge_overlap_preroll(
                                preroll_write,
                                preroll_count,
                                barge_event_onset_sequence,
                                capture_sequence - 1U,
                                true,
                                &final_preserved_frames,
                                &final_silenced_frames,
                                &final_max_ref_correlation_q15);
                    }
                    if (preroll_validation_err == ESP_OK) {
                        if (final_max_ref_correlation_q15 >
                            barge_overlap_max_ref_correlation_q15) {
                            barge_overlap_max_ref_correlation_q15 =
                                final_max_ref_correlation_q15;
                        }
                        preroll_validation_err =
                            validate_auto_followup_preroll_for_upload(
                                preroll_write,
                                preroll_count,
                                true,
                                barge_event_onset_sequence,
                                barge_event_confirmed_sequence,
                                capture_sequence);
                        NUWAX_RT_DIAG_LOGI(TAG,
                                 "barge final preroll gate preserved=%lu silenced=%lu max_ref_corr_q15=%lu validation=%s",
                                 (unsigned long)final_preserved_frames,
                                 (unsigned long)final_silenced_frames,
                                 (unsigned long)final_max_ref_correlation_q15,
                                 esp_err_to_name(preroll_validation_err));
                    }
                    if (preroll_validation_err != ESP_OK) {
                        ESP_LOGE(TAG,
                                 "barge-in degraded before protocol commit event=%s onset_seq=%lu confirm_seq=%lu live_seq=%lu buffered=%lu: %s",
                                 barge_event_id,
                                 (unsigned long)barge_event_onset_sequence,
                                 (unsigned long)barge_event_confirmed_sequence,
                                 (unsigned long)capture_sequence,
                                 (unsigned long)preroll_count,
                                 esp_err_to_name(preroll_validation_err));
                        const esp_err_t cancel_turn_err =
                            nuwax_session_send_cancel_turn(
                                ws,
                                barge_event_id,
                                s_active_turn_id,
                                "barge_audio_untrusted");
                        if (cancel_turn_err != ESP_OK) {
                            ESP_LOGE(TAG,
                                     "barge degraded cancel_turn failed event=%s: %s; retaining WebSocket",
                                     barge_event_id,
                                     esp_err_to_name(cancel_turn_err));
                        }
                        result = preroll_validation_err;
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                        break;
                    }
                    const nuwax_barge_confirmed_event_t event = {
                        .event_id = barge_event_id,
                        .parent_turn_id = barge_parent_turn_id,
                        .playback_id = barge_playback_id,
                        .audio_session_id = barge_audio_session_id,
                        .listen_mode = nuwax_prelisten_state_mode_or(
                            &s_prelisten, "during_playback"),
                        .onset_sequence = barge_event_onset_sequence,
                        .confirmed_sequence = barge_event_confirmed_sequence,
                        .confidence_q15 =
                            NUWAX_BARGE_IN_LOCAL_CONFIDENCE_Q15,
                    };
                    result = prepare_mic_cloud_upload(
                        ws,
                        send_ctx,
                        event.listen_mode,
                        barge_audio_session_id,
                        barge_event_id);
                    if (result != ESP_OK) {
                        ESP_LOGE(TAG,
                                 "barge local uplink prepare failed before protocol commit event=%s err=%s",
                                 barge_event_id,
                                 esp_err_to_name(result));
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                        break;
                    }
                    barge_uplink_prepared = true;
                    barge_dispatch_binding =
                        nuwax_barge_dispatcher_current_binding(ws);
                    const esp_err_t dispatch_err =
                        nuwax_barge_dispatcher_enqueue_confirmed(
                            barge_dispatch_binding, &event);
                    if (dispatch_err != ESP_OK) {
                        ESP_LOGE(TAG,
                                 "barge protocol transaction enqueue failed after preroll validation event=%s err=%s",
                                 barge_event_id,
                                 esp_err_to_name(dispatch_err));
                        const esp_err_t discard_err =
                            nuwax_audio_uplink_discard_uncommitted(send_ctx);
                        if (discard_err == ESP_OK) {
                            barge_uplink_prepared = false;
                        } else {
                            ESP_LOGE(TAG,
                                     "barge prepared uplink cleanup failed after enqueue rejection event=%s err=%s",
                                     barge_event_id,
                                     esp_err_to_name(discard_err));
                        }
                        result = dispatch_err;
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                        break;
                    }
                    barge_protocol_enqueued = true;
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "barge protocol transaction queued after trusted onset validation event=%s binding=%lu onset_seq=%lu confirm_seq=%lu",
                             barge_event_id,
                             (unsigned long)barge_dispatch_binding,
                             (unsigned long)barge_event_onset_sequence,
                             (unsigned long)barge_event_confirmed_sequence);
                }
                nuwax_barge_dispatch_status_t dispatch_status =
                    NUWAX_BARGE_DISPATCH_UNKNOWN;
                esp_err_t dispatch_result = ESP_ERR_INVALID_STATE;
                const bool dispatch_status_found =
                    nuwax_barge_dispatcher_get_status(
                        barge_dispatch_binding,
                        barge_event_id,
                        &dispatch_status,
                        &dispatch_result);
                if (!dispatch_status_found) {
                    ESP_LOGE(TAG,
                             "barge protocol transaction lost event=%s binding=%lu",
                             barge_event_id,
                             (unsigned long)barge_dispatch_binding);
                    result = ESP_ERR_INVALID_STATE;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
                if (dispatch_status == NUWAX_BARGE_DISPATCH_UNKNOWN ||
                    dispatch_status == NUWAX_BARGE_DISPATCH_PENDING ||
                    dispatch_status ==
                        NUWAX_BARGE_DISPATCH_LISTEN_SENDING) {
                    if (!barge_current_frame_buffered) {
                        result = store_auto_followup_preroll_frame(
                            s_audio_samples,
                            s_audio_preclean_samples,
                            s_audio_human_rescue_source,
                            s_audio_ref_samples,
                            samples_read,
                            playback_active,
                            (work->live_aec).human_rescue_mix_q15,
                            frame_rescue_source_kind,
                            &frame_rescue_provenance,
                            &frame_cleaner_state_before,
                            &frame_preroll_trust,
                            frame_is_speech,
                            capture_sequence,
                            &preroll_write,
                            &preroll_count);
                        if (result != ESP_OK) {
                            mic_capture_set_stop_reason(
                                &stop_reason,
                                NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                            ESP_LOGE(TAG,
                                     "barge protocol wait frame store failed seq=%lu: %s",
                                     (unsigned long)capture_sequence,
                                     esp_err_to_name(result));
                            break;
                        }
                    }
                    captured_frames++;
                    continue;
                }
                if (dispatch_status ==
                    NUWAX_BARGE_DISPATCH_COMMIT_UNCERTAIN) {
                    ESP_LOGE(TAG,
                             "barge listen start commit uncertain event=%s err=%s; prepared uplink will emit END and cleanup will stop the matching session while retaining WebSocket",
                             barge_event_id,
                             esp_err_to_name(dispatch_result));
                    listen_started = true;
                    barge_protocol_listen_committed = true;
                    barge_uplink_prepared = false;
                    quarantine_playback_terminal_after_failed_barge(
                        barge_playback_connection_epoch,
                        barge_stop_playback_generation,
                        barge_physical_stop_observed,
                        "barge_listen_commit_uncertain");
                    result = dispatch_result == ESP_OK
                                 ? ESP_FAIL
                                 : dispatch_result;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
                if (dispatch_status == NUWAX_BARGE_DISPATCH_FAILED ||
                    dispatch_result != ESP_OK) {
                    ESP_LOGE(TAG,
                             "barge protocol transaction failed event=%s err=%s; audio uplink will not start",
                             barge_event_id,
                             esp_err_to_name(dispatch_result));
                    if (barge_uplink_prepared) {
                        const esp_err_t discard_err =
                            nuwax_audio_uplink_discard_uncommitted(send_ctx);
                        if (discard_err == ESP_OK) {
                            barge_uplink_prepared = false;
                        } else {
                            ESP_LOGE(TAG,
                                     "barge uncommitted uplink discard failed event=%s err=%s",
                                     barge_event_id,
                                     esp_err_to_name(discard_err));
                        }
                    }
                    result = dispatch_result == ESP_OK
                                 ? ESP_FAIL
                                 : dispatch_result;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
                barge_protocol_listen_committed = true;
                if (!release_playback_terminal_after_committed_barge(
                        barge_playback_connection_epoch,
                        barge_stop_playback_generation,
                        barge_parent_turn_id,
                        barge_playback_id,
                        "barge_listen_committed")) {
                    result = ESP_ERR_INVALID_STATE;
                    mic_capture_set_stop_reason(
                        &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                    break;
                }
            } else {
                if (conversation_audio_session_id[0] == '\0') {
                    make_conversation_audio_session_id(
                        conversation_audio_session_id,
                        sizeof(conversation_audio_session_id));
                }
                nuwax_listen_resume_state_bind_round(
                    &s_listen_resume,
                    capture_awake_generation,
                    conversation_audio_session_id);
                upload_audio_session_id = conversation_audio_session_id;
            }

            const uint32_t upload_onset_sequence =
                during_playback_mode && barge_local_cancel_requested
                    ? barge_event_onset_sequence
                    : detected_onset_sequence;
            result = validate_auto_followup_preroll_for_upload(
                preroll_write,
                preroll_count,
                during_playback_mode,
                upload_onset_sequence,
                barge_event_confirmed_sequence,
                capture_sequence);
            if (result != ESP_OK) {
                ESP_LOGE(TAG,
                         "conversation preroll validation failed before listen start mode=%s buffered=%lu onset_seq=%lu live_seq=%lu: %s",
                         nuwax_prelisten_state_mode_or(&s_prelisten,
                                                       "prelisten"),
                         (unsigned long)preroll_count,
                         (unsigned long)upload_onset_sequence,
                         (unsigned long)capture_sequence,
                         esp_err_to_name(result));
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                break;
            }
            result = start_mic_cloud_upload(ws,
                                            send_ctx,
                                            nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                                            upload_audio_session_id,
                                            upload_request_id,
                                            max_record_samples,
                                            max_record_ms,
                                            &listen_started,
                                            &upload_started_us,
                                            during_playback_mode &&
                                                barge_protocol_listen_committed,
                                            during_playback_mode &&
                                                barge_uplink_prepared);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                if (during_playback_mode && barge_controller_confirmed) {
                    ESP_LOGE(TAG,
                             "barge-in audio uplink start failed after terminal confirmation event=%s upload_err=%s; confirmation is not reverted",
                             barge_event_id,
                             esp_err_to_name(result));
                }
                break;
            }
            upload_started = true;
            /* A new user turn supersedes any late emotion from the previous
            * no-TTS response.  Keep the WebSocket and audio transaction
             * untouched; only the short visual admission window is closed. */
            clear_tts_skip_emotion_window("new_user_turn");
            clear_tts_skip_prebound_emotion("new_user_turn");
            if (!during_playback_mode && persistent_conversation_mode &&
                !nuwax_capture_phase_handoff_promote_awake_uplink(
                    &capture_phase_handoff)) {
                result = ESP_ERR_INVALID_STATE;
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG,
                         "confirmed speech upload could not bind awake uplink phase=%d",
                         (int)capture_phase_handoff.phase);
                break;
            }
            if (during_playback_mode) {
                barge_uplink_prepared = false;
            }
            if (!acceptance_capture_enabled && vad_speech_seen &&
                !cloud_progress_watchdog_armed &&
                !conversation_wait_text_deadline_owned_by_turn_guard()) {
                cloud_progress_watchdog_armed = true;
                cloud_progress_watchdog_epoch =
                    s_conversation_cloud_progress_epoch;
                cloud_progress_watchdog_deadline_ms =
                    monotonic_ms() +
                    NUWAX_CONVERSATION_ASR_PROGRESS_TIMEOUT_MS;
            }
            if (during_playback_mode && barge_controller_confirmed &&
                nuwax_barge_controller_state(&(work->barge_controller)) ==
                    NUWAX_BARGE_CONTROLLER_POST_STOP_TAIL) {
                (void)nuwax_barge_controller_mark_uplink_active(
                    &(work->barge_controller),
                    barge_stop_playback_generation,
                    barge_controller_candidate_id,
                    (uint64_t)esp_timer_get_time());
            }
            uint32_t preroll_send_count = 0;
            result = send_auto_followup_preroll(send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                                &opus_encoder,
#endif
                                                preroll_write,
                                                preroll_count,
                                                during_playback_mode,
                                                upload_onset_sequence,
                                                capture_sequence,
                                                &recorded_frames,
                                                &recorded_samples,
                                                &queued_frames,
                                                &dropped_frames,
                                                &preroll_send_count);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
                break;
            }
            ESP_LOGI(TAG,
                     "conversation speech detected mode=%s; cloud upload started preroll_frames=%lu recorded_frames=%lu playback_gate_candidates=%lu playback_gate_dual_candidates=%lu playback_gate_suppressed=%lu gate_open_frame=%lu max_streak=%lu max_score=%lu ref_unhealthy=%lu dual_voice_like=%lu",
                     nuwax_prelisten_state_mode_or(&s_prelisten, "prelisten"),
                     (unsigned long)preroll_send_count,
                     (unsigned long)recorded_frames,
                     (unsigned long)playback_gate_candidate_frames,
                     (unsigned long)playback_gate_dual_candidate_frames,
                     (unsigned long)playback_gate_suppressed_frames,
                     (unsigned long)playback_gate_open_frame,
                     (unsigned long)playback_gate_max_candidate_streak,
                     (unsigned long)playback_gate_max_score_frames,
                     (unsigned long)playback_gate_ref_unhealthy_frames,
                     (unsigned long)dual_mic_voice_like_frames);
        }

#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
        adaptive_observation =
            (nuwax_adaptive_endpoint_observation_t){0};
        const bool adaptive_tracking_allowed =
            adaptive_session_eligible &&
            persistent_conversation_mode &&
            !during_playback_mode &&
            !playback_active &&
            !acceptance_capture_enabled;
        nuwax_adaptive_endpoint_frame_class_t adaptive_v2_frame_class =
            NUWAX_ADAPTIVE_ENDPOINT_FRAME_UNKNOWN;
        const nuwax_adaptive_endpoint_resume_evidence_t
            adaptive_resume_evidence = {
                .strong_speech = primary_frame_is_speech,
                .trusted_weak_speech = trusted_weak_speech_evidence,
                .energy_weak_speech = energy_only_weak_speech_evidence,
            };
        if (primary_frame_is_speech) {
            adaptive_v2_frame_class =
                NUWAX_ADAPTIVE_ENDPOINT_FRAME_STRONG_SPEECH;
        } else if (weak_continuation_confirmed) {
            adaptive_v2_frame_class =
                NUWAX_ADAPTIVE_ENDPOINT_FRAME_WEAK_SPEECH;
        } else if (stable_noise_evidence) {
            adaptive_v2_frame_class =
                NUWAX_ADAPTIVE_ENDPOINT_FRAME_STABLE_NOISE;
        }
        if (adaptive_tracking_allowed) {
            nuwax_adaptive_endpoint_frame_class_t adaptive_frame_class =
                adaptive_v2_frame_class;
            if (!adaptive_v2_session) {
                const bool legacy_strict_silence =
                    clean_result.after.avg_abs <=
                        (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_AVG_ABS &&
                    clean_result.after.peak <=
                        (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SILENCE_PEAK &&
                    clean_result.before.avg_abs <
                        (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_AVG_ABS &&
                    clean_result.before.peak <
                        (uint32_t)CONFIG_NUWAX_VOICE_LOCAL_VAD_SPEECH_PEAK;
                adaptive_frame_class = primary_frame_is_speech
                                           ? NUWAX_ADAPTIVE_ENDPOINT_FRAME_SPEECH
                                           : (legacy_strict_silence
                                                  ? NUWAX_ADAPTIVE_ENDPOINT_FRAME_STRICT_SILENCE
                                                  : NUWAX_ADAPTIVE_ENDPOINT_FRAME_UNCERTAIN);
            }
            if (adaptive_seed_pending) {
                adaptive_observation = nuwax_adaptive_endpoint_seed(
                    &adaptive_endpoint,
                    adaptive_seed_voiced_ms,
                    adaptive_seed_span_ms,
                    adaptive_seed_tail_ms,
                    adaptive_seed_trusted,
                    frame_ms);
                adaptive_seed_pending = false;
            } else {
                adaptive_observation = adaptive_v2_session
                    ? nuwax_adaptive_endpoint_observe_v3(
                          &adaptive_endpoint,
                          adaptive_frame_class,
                          &adaptive_resume_evidence,
                          frame_ms)
                    : nuwax_adaptive_endpoint_observe(
                          &adaptive_endpoint, adaptive_frame_class, frame_ms);
            }
            if (!adaptive_observation.valid) {
                nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
                adaptive_session_eligible = false;
                adaptive_v2_session = false;
                adaptive_prediction_actionable = false;
                ESP_LOGE(TAG,
                         "adaptive endpoint state invalid; fixed endpoint restored for current audio session");
            } else {
                if (adaptive_observation.prediction_started) {
                    adaptive_prediction_actionable =
                        upload_started && vad_speech_seen &&
                        adaptive_endpoint.speech_started;
                    adaptive_prediction_count++;
                    if (adaptive_prediction_actionable) {
                        adaptive_actionable_prediction_count++;
                    }
                    ESP_LOGI(TAG,
                             "adaptive endpoint prediction actionable=%d upload_started=%d vad_speech_seen=%d session_eligible=%d frame_class=%d pause_ms=%lu strict_tail_ms=%lu uncertain_seen=%d weak_pause_seen=%d commit_ms=%u",
                             adaptive_prediction_actionable ? 1 : 0,
                             upload_started ? 1 : 0,
                             vad_speech_seen ? 1 : 0,
                             adaptive_session_eligible ? 1 : 0,
                             (int)adaptive_frame_class,
                             (unsigned long)adaptive_endpoint.pause_ms,
                             (unsigned long)adaptive_endpoint
                                 .strict_silence_tail_ms,
                             adaptive_endpoint.uncertain_pause_seen ? 1 : 0,
                             adaptive_endpoint.weak_pause_seen ? 1 : 0,
                             (unsigned)adaptive_observation.commit_ms);
                }
                if (adaptive_observation.truncation_confirmed) {
                    adaptive_confirmed_truncation_count++;
                    if (adaptive_prediction_actionable) {
                        adaptive_actionable_truncation_count++;
                    }
                    ESP_LOGW(TAG,
                             "adaptive endpoint shadow truncation confirmed actionable=%d resumed_pause_ms=%lu resume_confirm_ms=%u cancel_count=%u",
                             adaptive_prediction_actionable ? 1 : 0,
                             (unsigned long)adaptive_endpoint
                                 .max_resumed_pause_ms,
                             (unsigned)NUWAX_ADAPTIVE_ENDPOINT_RESUME_CONFIRM_MS,
                             (unsigned)adaptive_endpoint
                                 .candidate_cancel_count);
                    adaptive_prediction_actionable = false;
                } else if (!adaptive_endpoint.predicted_commit &&
                           !adaptive_endpoint.pending_prediction_cancel) {
                    adaptive_prediction_actionable = false;
                }
                if (adaptive_observation.resumed_pause_learned) {
                    last_confirmed_speech_us = esp_timer_get_time();
                    if (continuous_endpoint_candidate) {
                        ESP_LOGI(TAG,
                                 "continuous local VAD endpoint candidate canceled after confirmed resume seq=%lu learned_pause_ms=%lu",
                                 (unsigned long)captured_frames,
                                 (unsigned long)adaptive_endpoint
                                     .max_resumed_pause_ms);
                        continuous_endpoint_candidate = false;
                    }
                }
            }

        }
        const bool short_endpoint_shadow_tracking_allowed =
            !NUWAX_SHORT_SPEECH_ACTIVE && persistent_conversation_mode &&
            !during_playback_mode && !playback_active &&
            !acceptance_capture_enabled && capture_sequence_contiguous &&
            short_endpoint_shadow_ws_epoch != 0U &&
            short_endpoint_shadow_ws_epoch ==
                nuwax_ws_connection_epoch(ws);
        if (short_endpoint_shadow_tracking_allowed &&
            short_endpoint_shadow_seed_pending) {
            nuwax_adaptive_endpoint_reset(&short_endpoint_shadow);
            short_endpoint_shadow_observation =
                nuwax_adaptive_endpoint_seed(
                    &short_endpoint_shadow,
                    adaptive_seed_voiced_ms,
                    adaptive_seed_span_ms,
                    adaptive_seed_tail_ms,
                    adaptive_seed_trusted,
                    frame_ms);
            short_endpoint_shadow_seed_pending = false;
            short_endpoint_shadow_active =
                short_endpoint_shadow_observation.valid;
        } else if (short_endpoint_shadow_tracking_allowed &&
                   short_endpoint_shadow_active) {
            short_endpoint_shadow_observation =
                nuwax_adaptive_endpoint_observe_v3(
                    &short_endpoint_shadow,
                    adaptive_v2_frame_class,
                    &adaptive_resume_evidence,
                    frame_ms);
            if (!short_endpoint_shadow_observation.valid) {
                short_endpoint_shadow_active = false;
                nuwax_adaptive_endpoint_reset(&short_endpoint_shadow);
            }
        } else if (!short_endpoint_shadow_tracking_allowed) {
            short_endpoint_shadow_active = false;
            short_endpoint_shadow_seed_pending = false;
            short_endpoint_shadow_ws_epoch = 0U;
            nuwax_adaptive_endpoint_reset(&short_endpoint_shadow);
        }
        if (short_endpoint_shadow_active &&
            short_endpoint_shadow_observation.prediction_started &&
            !short_endpoint_shadow_prediction_logged) {
            short_endpoint_shadow_prediction_logged = true;
            ESP_LOGI(TAG,
                     "unified short-speech endpoint shadow candidate pause_ms=%lu commit_ms=%u legacy_confirmed=%d",
                     (unsigned long)short_endpoint_shadow.pause_ms,
                     (unsigned)short_endpoint_shadow_observation.commit_ms,
                     vad_speech_seen ? 1 : 0);
        }
        if (short_endpoint_shadow_active &&
            short_endpoint_shadow_observation.decision ==
                NUWAX_ADAPTIVE_ENDPOINT_COMMIT &&
            !short_endpoint_shadow_commit_logged) {
            short_endpoint_shadow_commit_logged = true;
            ESP_LOGI(TAG,
                     "unified short-speech endpoint shadow commit pause_ms=%lu commit_ms=%u legacy_pause_ms=%lu",
                     (unsigned long)short_endpoint_shadow.pause_ms,
                     (unsigned)short_endpoint_shadow_observation.commit_ms,
                     (unsigned long)adaptive_endpoint.pause_ms);
        }
#endif

        const uint32_t trailing_silence_ms = during_playback_mode
                                                 ? NUWAX_DURING_PLAYBACK_TRAILING_SILENCE_MS
                                                 : CONFIG_NUWAX_VOICE_LOCAL_VAD_TRAILING_SILENCE_MS;
        const uint32_t min_capture_ms = during_playback_mode
                                            ? NUWAX_DURING_PLAYBACK_MIN_UPLOAD_MS
                                            : CONFIG_NUWAX_VOICE_LOCAL_VAD_MIN_CAPTURE_MS;
        nuwax_conversation_endpoint_decision_t endpoint_decision =
            NUWAX_CONVERSATION_ENDPOINT_NONE;
        uint32_t endpoint_silence_ms = vad_silence_frames * frame_ms;
        uint32_t endpoint_commit_ms = trailing_silence_ms;
        const char *endpoint_policy = "fixed";
        if (persistent_conversation_mode) {
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
            const bool adaptive_active_and_eligible =
                adaptive_session_eligible &&
                !during_playback_mode &&
                !playback_active &&
                upload_started &&
                vad_speech_seen &&
                adaptive_endpoint.speech_started &&
                adaptive_observation.valid;
            if (adaptive_active_and_eligible) {
                endpoint_silence_ms = adaptive_endpoint.pause_ms;
                endpoint_commit_ms = adaptive_observation.commit_ms;
                endpoint_policy = "adaptive";
                if (nuwax_conversation_endpoint_gate_ready(
                        upload_started,
                        vad_speech_seen,
                        frame_is_speech,
                        captured_after_frame_ms,
                        min_capture_ms)) {
                    if (adaptive_observation.decision ==
                        NUWAX_ADAPTIVE_ENDPOINT_COMMIT) {
                        endpoint_decision =
                            NUWAX_CONVERSATION_ENDPOINT_COMMIT;
                    } else if (adaptive_observation.decision ==
                               NUWAX_ADAPTIVE_ENDPOINT_CANDIDATE) {
                        endpoint_decision =
                            NUWAX_CONVERSATION_ENDPOINT_CANDIDATE;
                    }
                }
            } else
#endif
            {
                endpoint_decision = nuwax_conversation_endpoint_decide(
                    upload_started,
                    vad_speech_seen,
                    frame_is_speech,
                    captured_after_frame_ms,
                    endpoint_silence_ms,
                    min_capture_ms,
                    NUWAX_CONTINUOUS_ENDPOINT_CANDIDATE_SILENCE_MS,
                    endpoint_commit_ms);
            }
        }
        if (!stop_requested &&
            endpoint_decision ==
                NUWAX_CONVERSATION_ENDPOINT_CANDIDATE) {
            if (!continuous_endpoint_candidate) {
                continuous_endpoint_candidate = true;
                ESP_LOGI(TAG,
                         "continuous local VAD endpoint candidate seq=%lu silence_ms=%lu commit_ms=%lu policy=%s",
                         (unsigned long)captured_frames,
                         (unsigned long)endpoint_silence_ms,
                         (unsigned long)endpoint_commit_ms,
                         endpoint_policy);
            }
        } else if (!stop_requested &&
                   endpoint_decision ==
                       NUWAX_CONVERSATION_ENDPOINT_COMMIT) {
            continuous_endpoint_candidate = false;
            stop_requested = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_VAD_ENDPOINT);
            ESP_LOGI(TAG,
                     "continuous local VAD endpoint committed seq=%lu silence_ms=%lu captured_ms=%lu policy=%s commit_ms=%lu; binary END then listen stop, WebSocket retained",
                     (unsigned long)captured_frames,
                     (unsigned long)endpoint_silence_ms,
                     (unsigned long)captured_after_frame_ms,
                     endpoint_policy,
                     (unsigned long)endpoint_commit_ms);
        } else if (!persistent_conversation_mode &&
            !stop_requested &&
            !acceptance_capture_enabled &&
            upload_started &&
            vad_speech_seen &&
            captured_after_frame_ms >= min_capture_ms &&
            vad_silence_frames * frame_ms >= trailing_silence_ms) {
            stop_requested = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_VAD_ENDPOINT);
            ESP_LOGI(TAG,
                     "local VAD endpoint seq=%lu trailing_silence_ms=%lu captured_ms=%lu min_capture_ms=%lu avg_abs=%lu peak=%lu during_playback=%d",
                     (unsigned long)captured_frames,
                     (unsigned long)(vad_silence_frames * frame_ms),
                     (unsigned long)captured_after_frame_ms,
                     (unsigned long)min_capture_ms,
                     (unsigned long)level.avg_abs,
                     (unsigned long)level.peak,
                     during_playback_mode ? 1 : 0);
        } else if (!persistent_conversation_mode &&
                   !stop_requested &&
                   upload_started &&
                   !during_playback_mode &&
                   !vad_speech_seen &&
                   elapsed_since_upload_ms >= CONFIG_NUWAX_VOICE_LOCAL_VAD_NO_SPEECH_TIMEOUT_MS) {
            stop_requested = true;
            vad_no_speech_timeout = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_VAD_NO_SPEECH);
            ESP_LOGI(TAG,
                     "local VAD no-speech timeout elapsed_ms=%lld avg_abs=%lu peak=%lu",
                     (long long)elapsed_since_upload_ms,
                     (unsigned long)level.avg_abs,
                     (unsigned long)level.peak);
        }
#endif

        if (!upload_started && auto_followup_mode && !barge_current_frame_buffered) {
            result = store_auto_followup_preroll_frame(s_audio_samples,
                                                       s_audio_preclean_samples,
                                                       s_audio_human_rescue_source,
                                                       s_audio_ref_samples,
                                                       samples_read,
                                                       playback_active,
                                                       (work->live_aec).human_rescue_mix_q15,
                                                       frame_rescue_source_kind,
                                                       &frame_rescue_provenance,
                                                       &frame_cleaner_state_before,
                                                       &frame_preroll_trust,
                                                       frame_is_speech,
                                                       capture_sequence,
                                                       &preroll_write,
                                                       &preroll_count);
            if (result != ESP_OK) {
                mic_capture_set_stop_reason(
                    &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                ESP_LOGE(TAG, "auto-followup preroll store failed: %s", esp_err_to_name(result));
                break;
            }
            if (playback_human_preroll_repair_pending) {
                playback_human_preroll_repair_attempts++;
                uint32_t repair_actual_start_sequence =
                    playback_human_preroll_repair_start_sequence;
                uint32_t repaired_frames = 0;
                uint32_t untrusted_source_frames = 0;
                const esp_err_t repair_err = repair_auto_followup_human_preroll(
                    preroll_write,
                    preroll_count,
                    playback_human_preroll_repair_start_sequence,
                    playback_human_preroll_repair_end_sequence,
                    NUWAX_PLAYBACK_HUMAN_PREROLL_REPAIR_LEAD_FRAMES,
                    (uint32_t)CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                    s_audio_cleaner_runtime_enabled,
                    &(work->audio_cleaner),
                    &repair_actual_start_sequence,
                    &repaired_frames,
                    &untrusted_source_frames);
                if (repair_err == ESP_OK) {
                    playback_human_preroll_repair_successes++;
                    playback_human_preroll_repaired_frames += repaired_frames;
                    playback_human_preroll_untrusted_source_frames += untrusted_source_frames;
                    NUWAX_RT_DIAG_LOGI(TAG,
                             "human preroll repaired candidate_seq=%lu actual_start_seq=%lu end_seq=%lu frames=%lu untrusted_source_frames=%lu lead_frames=%u target_mix_q15=%d stored_rescue_source=1 cleaner_state_committed=1",
                             (unsigned long)playback_human_preroll_repair_start_sequence,
                             (unsigned long)repair_actual_start_sequence,
                             (unsigned long)playback_human_preroll_repair_end_sequence,
                             (unsigned long)repaired_frames,
                             (unsigned long)untrusted_source_frames,
                             (unsigned)NUWAX_PLAYBACK_HUMAN_PREROLL_REPAIR_LEAD_FRAMES,
                             CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15);
                } else {
                    playback_human_preroll_repair_failures++;
                    ESP_LOGW(TAG,
                             "human preroll repair failed start_seq=%lu end_seq=%lu buffered=%lu: %s",
                             (unsigned long)playback_human_preroll_repair_start_sequence,
                             (unsigned long)playback_human_preroll_repair_end_sequence,
                             (unsigned long)preroll_count,
                             esp_err_to_name(repair_err));
                    uint32_t fail_closed_frames = 0;
                    const esp_err_t fail_closed_err = silence_barge_preroll_range(
                        preroll_write,
                        preroll_count,
                        repair_actual_start_sequence,
                        playback_human_preroll_repair_end_sequence,
                        &fail_closed_frames);
                    if (fail_closed_err != ESP_OK) {
                        ESP_LOGE(TAG,
                                 "human preroll fail-closed silence failed start_seq=%lu end_seq=%lu: %s",
                                 (unsigned long)repair_actual_start_sequence,
                                 (unsigned long)playback_human_preroll_repair_end_sequence,
                                 esp_err_to_name(fail_closed_err));
                        result = fail_closed_err;
                        mic_capture_set_stop_reason(
                            &stop_reason,
                            NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
                        break;
                    }
                    playback_human_preroll_untrusted_source_frames +=
                        fail_closed_frames;
                }
                playback_human_preroll_repair_pending = false;
            }
            if (nuwax_mic_level_should_log(captured_frames, false)) {
                nuwax_mic_level_log(TAG, level, captured_frames);
                log_mic_raw_stats(&frame_raw_stats, captured_frames);
            }
            captured_frames++;
            continue;
        }
        if (playback_human_preroll_repair_pending) {
            playback_human_preroll_repair_skipped++;
            playback_human_preroll_repair_pending = false;
        }

        if (!stop_requested && !max_duration_reached &&
            recorded_samples + samples_read >= max_record_samples) {
            max_duration_reached = true;
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_MAX_DURATION);
        }
        bool last_capture_frame = stop_requested || max_duration_reached;
        if (nuwax_mic_level_should_log(captured_frames, last_capture_frame)) {
            nuwax_mic_level_log(TAG, level, captured_frames);
            log_mic_raw_stats(&frame_raw_stats, captured_frames);
        }

        /* The binary stream sequence is session-local and contiguous from
         * zero. capture_sequence remains the device timeline used by
         * preroll selection, barge-in events, and diagnostics. */
        const uint32_t wire_sequence = recorded_frames;
        uint8_t flags = 0;
#if CONFIG_NUWAX_VOICE_LOCAL_VAD_ENDPOINT_ENABLE
        if (frame_is_speech) {
            flags |= NUWAX_AUDIO_FLAG_VAD_SPEECH;
        }
#else
        frame_is_speech = true;
        flags |= NUWAX_AUDIO_FLAG_VAD_SPEECH;
#endif
        if (recorded_frames == 0) {
            flags |= NUWAX_AUDIO_FLAG_START;
        }
        if (last_capture_frame) {
            flags |= NUWAX_AUDIO_FLAG_END;
        }

        const int16_t *uplink_samples = s_audio_samples;
        if (acceptance_capture_enabled && acceptance_capture.raw_hw_ref_pair) {
            uplink_samples = s_audio_raw_hw_ref_pair;
        } else if (acceptance_capture_enabled && acceptance_capture.raw_fir_ref_pair) {
            uplink_samples = s_audio_raw_fir_ref_pair;
        } else if (acceptance_capture_enabled && acceptance_capture.raw_mic1) {
            uplink_samples = s_audio_raw_mic1_samples;
        }
        result = enqueue_mic_uplink_frame(send_ctx,
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                                          &opus_encoder,
#endif
                                          uplink_samples,
                                          samples_read,
                                          wire_sequence,
                                          flags,
                                          last_capture_frame,
                                          &queued_frames,
                                          &dropped_frames);
        const bool uplink_frame_deferred =
            nuwax_audio_uplink_is_recoverable_backpressure(result);
        if (!nuwax_audio_uplink_enqueue_frame_accepted(result)) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR);
            break;
        }
        recorded_samples += samples_read;
        recorded_frames++;
        captured_frames++;
        if (uplink_frame_deferred) {
            uplink_backpressure_boundary = true;
            mic_capture_set_stop_reason(
                &stop_reason,
                NUWAX_MIC_CAPTURE_STOP_UPLINK_BACKPRESSURE);
            ESP_LOGW(TAG,
                     "normal conversation uplink reached bounded backpressure at wire_seq=%lu; retained frame will be finalized after FIFO drain",
                     (unsigned long)wire_sequence);
            break;
        }
        drain_session_commands_limited(ws, 1);

        if (last_capture_frame) {
            if (during_playback_mode &&
                s_post_playback_resume_pending &&
                listen_started &&
                upload_started &&
                stop_reason == NUWAX_MIC_CAPTURE_STOP_VAD_ENDPOINT) {
                if (!nuwax_capture_phase_handoff_request_playback_session_close(
                        &capture_phase_handoff,
                        capture_sequence,
                        recorded_frames)) {
                    result = ESP_ERR_INVALID_STATE;
                    stop_reason =
                        NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR;
                    ESP_LOGE(TAG,
                             "barge-to-awake session close rejected phase=%d seq=%lu",
                             (int)capture_phase_handoff.phase,
                             (unsigned long)capture_sequence);
                    break;
                }
                strlcpy(handoff_old_listen_mode,
                        nuwax_prelisten_state_mode_or(
                            &s_prelisten, "during_playback"),
                        sizeof(handoff_old_listen_mode));
                strlcpy(handoff_old_audio_session_id,
                        barge_audio_session_id,
                        sizeof(handoff_old_audio_session_id));
                handoff_listen_stop.ws = ws;
                strlcpy(handoff_listen_stop.mode,
                        handoff_old_listen_mode,
                        sizeof(handoff_listen_stop.mode));
                strlcpy(handoff_listen_stop.audio_session_id,
                        handoff_old_audio_session_id,
                        sizeof(handoff_listen_stop.audio_session_id));
                uplink_finish_attempted = true;
                uplink_finish_result =
                    nuwax_audio_uplink_request_finish_then(
                        send_ctx,
                        send_seamless_listen_stop_after_end,
                        &handoff_listen_stop,
                        sizeof(handoff_listen_stop));
                if (uplink_finish_result != ESP_OK) {
                    nuwax_capture_phase_handoff_fail(
                        &capture_phase_handoff);
                    result = uplink_finish_result;
                    stop_reason = NUWAX_MIC_CAPTURE_STOP_UPLINK_ERROR;
                    ESP_LOGE(TAG,
                             "barge-to-awake END request failed session=%s: %s",
                             handoff_old_audio_session_id,
                             esp_err_to_name(result));
                    break;
                }
                handoff_old_session_closing = true;
                handoff_requested_us = esp_timer_get_time();
                upload_started = false;
                stop_requested = false;
                max_duration_reached = false;
                stop_reason = NUWAX_MIC_CAPTURE_STOP_NONE;
                vad_speech_seen = false;
                confirmed_speech_us = 0;
                last_confirmed_speech_us = 0;
                continuous_utterance_limit_ms =
                    NUWAX_CONVERSATION_UTTERANCE_SOFT_LIMIT_MS;
                vad_speech_frames = 0U;
                vad_silence_frames = 0U;
                vad_candidate_start_valid = false;
                nuwax_speech_confirmation_reset(&speech_confirmation);
                nuwax_speech_confirmation_reset(&weak_start_confirmation);
                nuwax_short_speech_tracker_reset(&short_speech_tracker);
                nuwax_conversation_correlated_weak_reset(
                    &correlated_weak);
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW || \
    CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE
                nuwax_adaptive_endpoint_reset(&adaptive_endpoint);
                adaptive_session_eligible = false;
                adaptive_v2_session = false;
#endif
                preroll_write = 0U;
                preroll_count = 0U;
                playback_human_nearfield_onset_valid = false;
                playback_human_preroll_repair_pending = false;
                cloud_progress_watchdog_armed = false;
                ESP_LOGI(TAG,
                         "barge-to-awake old session draining after END frame session=%s wire_frames=%lu capture_seq=%lu capture_continuous=1",
                         handoff_old_audio_session_id,
                         (unsigned long)recorded_frames,
                         (unsigned long)capture_sequence);
                continue;
            }
            ESP_LOGI(TAG,
                     "mic stream stop after frame reason=%s frames_recorded=%lu frames_queued=%lu samples=%u elapsed_ms=%lld",
                     mic_capture_stop_reason_name(stop_reason),
                     (unsigned long)recorded_frames,
                     (unsigned long)queued_frames,
                     (unsigned)recorded_samples,
                     (long long)elapsed_since_start_ms);
            break;
        }
    }

    if (stop_reason == NUWAX_MIC_CAPTURE_STOP_NONE) {
        if (!nuwax_ws_is_connected(ws)) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_WS_ERROR);
        } else if (result != ESP_OK) {
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        } else {
            /* Every successful capture exit should have assigned its cause at
             * the branch that requested termination. Keep an explicit
             * diagnostic fallback instead of reconstructing it from booleans. */
            mic_capture_set_stop_reason(
                &stop_reason, NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
            ESP_LOGE(TAG,
                     "mic capture exited without an explicit stop reason; marking processing_error");
            result = ESP_ERR_INVALID_STATE;
        }
    }

    if (capture_started) {
        if (during_playback_mode) {
            s_during_playback_capture_runtime_ready = false;
        }
        const esp_err_t capture_stop_err = rt_capture_stop(&(work->capture_ctx));
        if (capture_stop_err != ESP_OK && result == ESP_OK) {
            result = capture_stop_err;
        }
        capture_started = false;
        rt_capture_read_frames = (work->capture_ctx).read_frames;
        rt_capture_dropped_no_slot = (work->capture_ctx).dropped_no_slot;
        rt_capture_dropped_oldest_ready = (work->capture_ctx).dropped_oldest_ready;
        rt_capture_ready_full_drops = (work->capture_ctx).ready_full_drops;
        rt_capture_dropped_samples = (work->capture_ctx).dropped_samples;
        rt_capture_max_ready_depth = (work->capture_ctx).max_ready_depth;
    }

    nuwax_audio_uplink_stats_t final_uplink_stats = {0};
    if (upload_started && local_power_transition_active()) {
        /* A physical sleep/shutdown is a local privacy boundary.  Preserve the
         * cloud protocol terminal through recovery, but do not hold the MIC
         * and main state machine behind the normal realtime queue-drain
         * timeout.  Remaining queued speech belongs to the cancelled round. */
        nuwax_audio_uplink_get_stats(send_ctx, &final_uplink_stats);
        uplink_finish_attempted = true;
        uplink_finish_result =
            nuwax_audio_uplink_preempt_for_local_power(send_ctx);
        uplink_finish_succeeded = false;
        local_power_uplink_preempted = true;
        ESP_LOGI(TAG,
                 "local power capture terminal detached from realtime queue result=%s queued=%lu sent=%lu dropped=%lu",
                 esp_err_to_name(uplink_finish_result),
                 (unsigned long)final_uplink_stats.queued_frames,
                 (unsigned long)final_uplink_stats.sent_frames,
                 (unsigned long)final_uplink_stats.dropped_frames);
    } else if (upload_started) {
        uplink_finish_attempted = true;
        uplink_finish_result = nuwax_audio_uplink_finish(send_ctx);
        uplink_finish_succeeded = uplink_finish_result == ESP_OK;
        result = nuwax_audio_uplink_resolve_capture_finish_result(
            result, uplink_finish_result);
        if (uplink_backpressure_boundary) {
            if (result == ESP_OK) {
                ESP_LOGI(TAG,
                         "normal conversation uplink backpressure drained cleanly; session remains valid");
            } else {
                ESP_LOGE(TAG,
                         "normal conversation uplink backpressure drain failed: %s",
                         esp_err_to_name(result));
            }
        }
    }
    if (!local_power_uplink_preempted) {
        nuwax_audio_uplink_get_stats(send_ctx, &final_uplink_stats);
    }
    queued_frames = final_uplink_stats.queued_frames;
    sent_frames = final_uplink_stats.sent_frames;
    dropped_frames = final_uplink_stats.dropped_frames;
    if (final_uplink_stats.recovery_grace_batches > 0U ||
        final_uplink_stats.stale_batches > 0U) {
        ESP_LOGI(TAG,
                 "mic uplink freshness soft_ms=%u hard_ms=%u grace_batches=%lu grace_frames=%lu max_grace_age_us=%llu stale_batches=%lu stale_frames=%lu",
                 (unsigned)NUWAX_AUDIO_UPLINK_REALTIME_MAX_AGE_MS,
                 (unsigned)NUWAX_AUDIO_UPLINK_REALTIME_RECOVERY_MAX_AGE_MS,
                 (unsigned long)final_uplink_stats.recovery_grace_batches,
                 (unsigned long)final_uplink_stats.recovery_grace_frames,
                 (unsigned long long)final_uplink_stats.max_recovery_age_us,
                 (unsigned long)final_uplink_stats.stale_batches,
                 (unsigned long)final_uplink_stats.stale_frames);
    }
    if (s_conversation_runtime_metrics_ready) {
        (void)nuwax_conversation_metrics_observe_queue(
            s_conversation_runtime_metrics,
            NUWAX_CONVERSATION_QUEUE_CAPTURE,
            rt_capture_max_ready_depth,
            NUWAX_RT_CAPTURE_QUEUE_DEPTH);
        (void)nuwax_conversation_metrics_observe_queue(
            s_conversation_runtime_metrics,
            NUWAX_CONVERSATION_QUEUE_UPLINK,
            final_uplink_stats.max_ready_depth,
            nuwax_audio_uplink_context_queue_depth(send_ctx));
        const uint32_t capture_queue_failures =
            rt_capture_dropped_no_slot + rt_capture_ready_full_drops;
        if (capture_queue_failures > 0U) {
            (void)nuwax_conversation_metrics_count_event(
                s_conversation_runtime_metrics,
                NUWAX_CONVERSATION_EVENT_CAPTURE_QUEUE_FULL,
                capture_queue_failures);
        }
        if (final_uplink_stats.queue_full_events > 0U) {
            (void)nuwax_conversation_metrics_count_event(
                s_conversation_runtime_metrics,
                NUWAX_CONVERSATION_EVENT_UPLINK_QUEUE_FULL,
                final_uplink_stats.queue_full_events);
        }
    }
    nuwax_live_aec_log_summary(&(work->live_aec));
    log_audio_cleaner_summary(&(work->audio_cleaner));
#if CONFIG_NUWAX_VOICE_LOCAL_VAD_ENDPOINT_ENABLE
    if (weak_continuation_evidence_frames > 0U) {
        ESP_LOGI(TAG,
                 "conversation weak continuation evidence=%lu confirmed=%lu confirm_frames=%u long_commit_ms=%u",
                 (unsigned long)weak_continuation_evidence_frames,
                 (unsigned long)weak_continuation_confirmed_frames,
                 (unsigned)NUWAX_CONTINUOUS_ENDPOINT_WEAK_CONFIRM_FRAMES,
                 (unsigned)NUWAX_ADAPTIVE_ENDPOINT_MAX_COMMIT_MS);
    }
    if (weak_start_evidence_frames > 0U) {
        ESP_LOGI(TAG,
                 "conversation weak start evidence=%lu confirmations=%lu window_ms=%u required_ms=%u reset_silence_ms=%u",
                 (unsigned long)weak_start_evidence_frames,
                 (unsigned long)weak_start_confirmation_count,
                 (unsigned)NUWAX_ORDINARY_WEAK_START_WINDOW_MS,
                 (unsigned)NUWAX_ORDINARY_WEAK_START_REQUIRED_MS,
                 (unsigned)NUWAX_ORDINARY_WEAK_START_RESET_SILENCE_MS);
    }
    if (NUWAX_SHORT_SPEECH_TRACKING) {
        ESP_LOGI(TAG,
                 "unified short-speech summary mode=%s runtime_enabled=%d shadow_confirmations=%lu active_confirmations=%lu",
                 NUWAX_SHORT_SPEECH_MODE_NAME,
                 short_speech_runtime_enabled ? 1 : 0,
                 (unsigned long)short_speech_shadow_confirmations,
                 (unsigned long)short_speech_active_confirmations);
    }
#endif

    if (acceptance_capture_enabled) {
        ESP_LOGI(TAG,
                 "acceptance playback capture summary request=%s audio_session_id=%s signal=%s playback_seen=%d stop_by_playback_end=%d frames=%lu sent=%lu dropped=%lu result=%s",
                 acceptance_capture.request_id[0] ? acceptance_capture.request_id : "-",
                 acceptance_capture.audio_session_id[0] ? acceptance_capture.audio_session_id : "-",
                 acceptance_capture_signal_name(&acceptance_capture),
                 acceptance_capture_playback_seen ? 1 : 0,
                 acceptance_capture_stop_logged ? 1 : 0,
                 (unsigned long)recorded_frames,
                 (unsigned long)sent_frames,
                 (unsigned long)dropped_frames,
                 esp_err_to_name(result));
    }

    if (!nuwax_ws_is_connected(ws) && result == ESP_OK) {
        result = ESP_ERR_INVALID_STATE;
    }
    if (result == ESP_OK) {
        ESP_LOGI(TAG,
                 "playback human evidence onset=%lu strong=%lu seed_evidence=%lu provisional=%lu fast_protect=%lu confirmed=%lu seed_refresh=%lu spatial_anchor=%lu separated_anchor=%lu exceptional_anchor=%lu voice_anchor=%lu nearfield_potential=%lu nearfield_anchor=%lu context_frames=%lu context_starts=%lu max_candidate_count=%lu max_candidate_gap=%lu seed_hangover=%u provisional_frames=%u provisional_hold=%u provisional_min_avg=%u provisional_min_peak=%u fast_min_avg=%u fast_min_peak=%u anchor_min_gap=%u anchor_min_diff_peak=%u anchor_min_diff_to_mic_peak_q15=%u exceptional_min_mic_peak=%u exceptional_min_diff_peak=%u exceptional_min_diff_to_mic_peak_q15=%u exceptional_min_balance=%u exceptional_max_diff_energy=%u confirm_frames=%u confirm_min_avg=%u confirm_min_peak=%u confirm_max_gap=%u evidence_max_avg=%u evidence_max_peak=%u evidence_max_ref_corr=%u",
                 (unsigned long)playback_human_onset_evidence_frames,
                 (unsigned long)playback_human_strong_evidence_frames,
                 (unsigned long)playback_human_seed_evidence_frames,
                 (unsigned long)playback_human_provisional_frames,
                 (unsigned long)playback_human_fast_protect_frames,
                 (unsigned long)playback_human_confirmed_frames,
                 (unsigned long)playback_human_seed_refresh_frames,
                 (unsigned long)playback_human_spatial_anchor_frames,
                 (unsigned long)playback_human_separated_anchor_frames,
                 (unsigned long)playback_human_exceptional_anchor_frames,
                 (unsigned long)playback_human_voice_anchor_frames,
                 (unsigned long)playback_human_nearfield_candidate_frames,
                 (unsigned long)playback_human_nearfield_anchor_frames,
                 (unsigned long)confirmed_playback_human_context_frames,
                 (unsigned long)confirmed_playback_human_context_starts,
                 (unsigned long)playback_human_candidate_max_streak,
                 (unsigned long)playback_human_candidate_max_gap_frames,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_SEED_HANGOVER_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_HOLD_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_PROVISIONAL_MIN_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_FAST_PROTECT_MIN_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_FAST_PROTECT_MIN_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_PRECEDING_GAP_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_DIFF_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_MIC_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_DIFF_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MIN_BALANCE_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EXCEPTIONAL_ANCHOR_MAX_DIFF_ENERGY_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_CONFIRM_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_CONFIRM_MIN_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_CONFIRM_MIN_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_CANDIDATE_MAX_GAP_FRAMES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_EVIDENCE_MAX_REF_CORR_Q15);
        ESP_LOGI(TAG,
                 "playback low-level human anchor frames=%lu min_mic=%u/%u min_diff=%u/%u min_diff_energy=%u balance=%u..%u max_ref_corr=%u min_diff_to_mic_peak_q15=%u",
                 (unsigned long)playback_human_low_level_anchor_frames,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_ENERGY_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_BALANCE_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MAX_BALANCE_Q15,
                  (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MAX_REF_CORR_Q15,
                  (unsigned)NUWAX_PLAYBACK_HUMAN_LOW_LEVEL_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15);
        ESP_LOGI(TAG,
                 "playback voice human anchor frames=%lu min_prior=%u min_mic=%u/%u min_diff=%u/%u min_diff_to_mic_peak_q15=%u max_ref_corr=%u",
                 (unsigned long)playback_human_voice_anchor_frames,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_PRIOR_CANDIDATES,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_MIC1_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_MIC1_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_AVG_ABS,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_PEAK,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MIN_DIFF_TO_MIC_PEAK_Q15,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_VOICE_ANCHOR_MAX_REF_CORR_Q15);
        ESP_LOGI(TAG,
                 "human preroll repair attempts=%lu success=%lu failures=%lu skipped=%lu repaired_frames=%lu untrusted_source_frames=%lu stored_rescue_source=1 cleaner_state_committed=1 lead_frames=%u target_mix_q15=%d frame_samples=%u buffer_frames=%u",
                 (unsigned long)playback_human_preroll_repair_attempts,
                 (unsigned long)playback_human_preroll_repair_successes,
                 (unsigned long)playback_human_preroll_repair_failures,
                 (unsigned long)playback_human_preroll_repair_skipped,
                 (unsigned long)playback_human_preroll_repaired_frames,
                 (unsigned long)playback_human_preroll_untrusted_source_frames,
                 (unsigned)NUWAX_PLAYBACK_HUMAN_PREROLL_REPAIR_LEAD_FRAMES,
                 CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_CONFIRMED_MIX_Q15,
                 (unsigned)NUWAX_CAPTURE_FRAME_SAMPLES,
                 (unsigned)NUWAX_AUTO_FOLLOWUP_PREROLL_FRAMES);
        int64_t captured_ms = ((int64_t)recorded_samples * 1000) / CONFIG_NUWAX_VOICE_SAMPLE_RATE;
        int64_t wall_ms = (esp_timer_get_time() - upload_started_us) / 1000;
        int64_t realtime_percent = wall_ms > 0 ? (captured_ms * 100) / wall_ms : 0;
        ESP_LOGI(TAG,
                 "I2S microphone stream done codec=%s frames=%lu queued=%lu sent=%lu dropped=%lu queue_full=%lu samples=%u encoded_bytes=%u audio_ms=%lld wall_ms=%lld realtime=%lld%% timeouts=%lu slot2_ref_candidates=%lu mic2_speech_like=%lu dual_mic_voice_like=%lu dual_mic_aec_hint=%lu dual_mic_aec_hint_active=%lu dual_mic_aec_hint_hangover=%lu dual_mic_cleaner_hint=%lu dual_mic_cleaner_hint_active=%lu dual_mic_cleaner_hint_hangover=%lu playback_raw_human_hint=%lu playback_raw_human_hint_active=%lu playback_raw_human_hint_hangover=%lu playback_weak_continuity_hint=%lu playback_weak_continuity_hint_active=%lu playback_weak_continuity_hint_hangover=%lu dual_mic_human_first_hint=%lu dual_mic_human_first_hint_active=%lu dual_mic_human_first_hint_hangover=%lu dual_diff_avg_max=%lu dual_diff_energy_q15_max=%lu dual_balance_q15_min=%lu playback_ref_active=%lu playback_ref_echo_veto=%lu playback_spatial_echo_veto=%lu playback_human_seed=%lu playback_human_seed_active=%lu playback_vad_echo_blocked=%lu playback_aec_gate_echo_blocked=%lu playback_ref_corr_q15_max=%lu slot2_aec_ref_enabled=%d hw_ref_frames=%lu hw_ref_inactive=%lu hw_ref_fallback=%lu hw_ref_raw_active=%lu hw_ref_raw_avg_max=%lu hw_ref_raw_peak_max=%lu hw_ref_health_passed=%d soft_ref_snapshots=%lu soft_ref_active=%lu aec_playback_frames=%lu aec_pending=%lu aec_session_gap=%lu aec_hangover=%lu playback_gate_candidates=%lu playback_gate_dual_candidates=%lu playback_gate_dual_open=%lu playback_gate_suppressed=%lu playback_gate_open_frame=%lu playback_gate_max_streak=%lu playback_gate_max_score=%lu playback_gate_ref_unhealthy=%lu rtcap_read=%lu rtcap_drop_no_slot=%lu rtcap_drop_oldest=%lu rtcap_ready_full=%lu rtcap_drop_samples=%lu rtcap_stale=%lu rtcap_gap_events=%lu rtcap_gap_frames=%lu rtcap_max_ready=%lu stop_reason=%s queue_max=%lu",
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
                 "opus",
#else
                 "pcm16",
#endif
                 (unsigned long)recorded_frames,
                 (unsigned long)queued_frames,
                 (unsigned long)sent_frames,
                 (unsigned long)dropped_frames,
                 (unsigned long)final_uplink_stats.queue_full_events,
                 (unsigned)recorded_samples,
                 (unsigned)final_uplink_stats.encoded_bytes_total,
                 (long long)captured_ms,
                 (long long)wall_ms,
                 (long long)realtime_percent,
                 (unsigned long)total_timeouts,
                 (unsigned long)slot2_ref_candidate_frames,
                 (unsigned long)mic2_speech_like_frames,
                 (unsigned long)dual_mic_voice_like_frames,
                 (unsigned long)dual_mic_aec_hint_frames,
                 (unsigned long)dual_mic_aec_hint_active_frames,
                 (unsigned long)dual_mic_aec_hint_hangover_frames,
                 (unsigned long)dual_mic_cleaner_hint_frames,
                 (unsigned long)dual_mic_cleaner_hint_active_frames,
                 (unsigned long)dual_mic_cleaner_hint_hangover_frames,
                 (unsigned long)playback_raw_human_hint_frames,
                 (unsigned long)playback_raw_human_hint_active_frames,
                 (unsigned long)playback_raw_human_hint_hangover_frames,
                 (unsigned long)playback_weak_continuity_hint_frames,
                 (unsigned long)playback_weak_continuity_hint_active_frames,
                 (unsigned long)playback_weak_continuity_hint_hangover_frames,
                 (unsigned long)dual_mic_human_first_hint_frames,
                 (unsigned long)dual_mic_human_first_hint_active_frames,
                 (unsigned long)dual_mic_human_first_hint_hangover_frames,
                 (unsigned long)dual_mic_diff_avg_abs_max,
                 (unsigned long)dual_mic_diff_energy_ratio_q15_max,
                 (unsigned long)dual_mic_level_balance_q15_min,
                 (unsigned long)playback_ref_active_frames,
                 (unsigned long)playback_ref_echo_veto_frames,
                 (unsigned long)playback_spatial_echo_veto_frames,
                 (unsigned long)playback_human_seed_frames,
                 (unsigned long)playback_human_seed_active_frames,
                 (unsigned long)playback_vad_echo_blocked_frames,
                 (unsigned long)playback_aec_gate_echo_blocked_frames,
                 (unsigned long)playback_ref_corr_q15_max,
                 CONFIG_NUWAX_VOCAT_SLOT2_AEC_REF_ENABLE ? 1 : 0,
                 (unsigned long)hw_ref_frames,
                 (unsigned long)hw_ref_inactive_frames,
                 (unsigned long)hw_ref_fallback_frames,
                 (unsigned long)hw_ref_raw_active_frames,
                 (unsigned long)hw_ref_raw_avg_abs_max,
                 (unsigned long)hw_ref_raw_peak_max,
                 s_hw_ref_health_passed ? 1 : 0,
                 (unsigned long)software_ref_snapshot_frames,
                 (unsigned long)software_ref_active_frames,
                 (unsigned long)aec_playback_frames,
                 (unsigned long)aec_playback_pending_frames,
                 (unsigned long)aec_playback_session_gap_frames,
                 (unsigned long)aec_playback_hangover_frames,
                 (unsigned long)playback_gate_candidate_frames,
                 (unsigned long)playback_gate_dual_candidate_frames,
                 (unsigned long)playback_gate_dual_open_frames,
                 (unsigned long)playback_gate_suppressed_frames,
                 (unsigned long)playback_gate_open_frame,
                 (unsigned long)playback_gate_max_candidate_streak,
                 (unsigned long)playback_gate_max_score_frames,
                 (unsigned long)playback_gate_ref_unhealthy_frames,
                 (unsigned long)rt_capture_read_frames,
                 (unsigned long)rt_capture_dropped_no_slot,
                 (unsigned long)rt_capture_dropped_oldest_ready,
                 (unsigned long)rt_capture_ready_full_drops,
                 (unsigned long)rt_capture_dropped_samples,
                 (unsigned long)rt_capture_stale_decision_drops,
                 (unsigned long)capture_sequence_gap_events,
                 (unsigned long)capture_sequence_gap_frames,
                 (unsigned long)rt_capture_max_ready_depth,
                 mic_capture_stop_reason_name(stop_reason),
                 (unsigned long)final_uplink_stats.max_ready_depth);
        if (cloud_progress_watchdog_timed_out) {
            ESP_LOGW(TAG,
                     "cloud response progress watchdog caused capture termination session=%s",
                     conversation_audio_session_id[0]
                         ? conversation_audio_session_id
                         : (barge_audio_session_id[0] ? barge_audio_session_id : "-"));
        }
        if (recorded_samples > 0 && realtime_percent < NUWAX_AUDIO_UPLINK_CAPTURE_REALTIME_WARN_PERCENT) {
            ESP_LOGW(TAG,
                     "mic stream slower than real time; ASR may miss speech audio_ms=%lld wall_ms=%lld realtime=%lld%%",
                     (long long)captured_ms,
                     (long long)wall_ms,
                     (long long)realtime_percent);
        }
    }

    if (vad_no_speech_timeout) {
        clear_auto_followup("no_speech");
    }
    if (result == ESP_OK && recorded_samples == 0) {
        if (auto_followup_mode) {
            if (auto_followup_cancelled) {
                ESP_LOGI(TAG, "conversation prelisten ended because playback started; keep speaking state");
            } else if (during_playback_mode) {
                auto_followup_replaced_by_command = true;
                ESP_LOGI(TAG,
                         "during-playback prelisten ended without nearend upload candidates=%lu dual_candidates=%lu suppressed=%lu max_streak=%lu max_score=%lu ref_unhealthy=%lu dual_voice_like=%lu dual_aec_hint=%lu dual_aec_hint_active=%lu playback_raw_human_hint=%lu playback_raw_human_hint_active=%lu playback_weak_continuity_hint=%lu playback_weak_continuity_hint_active=%lu",
                         (unsigned long)playback_gate_candidate_frames,
                         (unsigned long)playback_gate_dual_candidate_frames,
                         (unsigned long)playback_gate_suppressed_frames,
                         (unsigned long)playback_gate_max_candidate_streak,
                         (unsigned long)playback_gate_max_score_frames,
                         (unsigned long)playback_gate_ref_unhealthy_frames,
                         (unsigned long)dual_mic_voice_like_frames,
                         (unsigned long)dual_mic_aec_hint_frames,
                         (unsigned long)dual_mic_aec_hint_active_frames,
                         (unsigned long)playback_raw_human_hint_frames,
                         (unsigned long)playback_raw_human_hint_active_frames,
                         (unsigned long)playback_weak_continuity_hint_frames,
                         (unsigned long)playback_weak_continuity_hint_active_frames);
            } else {
                auto_followup_sleep_after_no_speech = true;
                ESP_LOGI(TAG, "conversation prelisten ended without cloud upload");
            }
        } else {
            ESP_LOGW(TAG, "I2S microphone stream ended without audio samples");
        }
    }
    ESP_LOGI(TAG,
             "I2S microphone stream upload done frames=%lu queued=%lu sent=%lu dropped=%lu queue_full=%lu batches=%lu/%lu result=%s",
             (unsigned long)recorded_frames,
             (unsigned long)queued_frames,
             (unsigned long)sent_frames,
             (unsigned long)dropped_frames,
             (unsigned long)final_uplink_stats.queue_full_events,
             (unsigned long)final_uplink_stats.sent_batches,
             (unsigned long)final_uplink_stats.queued_batches,
             esp_err_to_name(result));
    if (capture_sequence_gap_frames > 0) {
        if (result == ESP_OK) {
            ESP_LOGI(TAG,
                     "capture stream recovered across local sequence gaps frames=%lu last_sequence=%lu",
                     (unsigned long)capture_sequence_gap_frames,
                     (unsigned long)last_capture_sequence);
        } else {
            ESP_LOGW(TAG,
                     "capture stream contained sequence gaps frames=%lu last_sequence=%lu",
                     (unsigned long)capture_sequence_gap_frames,
                     (unsigned long)last_capture_sequence);
        }
    }
    if (repaired_preroll_gap_events > 0U ||
        rejected_preroll_gap_events > 0U) {
        ESP_LOGW(TAG,
                 "confirmed barge-in preroll gap summary repaired_events=%lu repaired_frames=%lu rejected_events=%lu rejected_frames=%lu",
                 (unsigned long)repaired_preroll_gap_events,
                 (unsigned long)repaired_preroll_gap_frames,
                 (unsigned long)rejected_preroll_gap_events,
                 (unsigned long)rejected_preroll_gap_frames);
    }
    if (listen_started) {
        metrics_mark_upload_done(sent_frames);
    } else if (auto_followup_mode &&
               (persistent_awake_timeout || vad_no_speech_timeout)) {
        metrics_cancel(persistent_awake_timeout ? "awake_no_speech_timeout"
                                                : "no_speech_timeout");
    }
    metrics_log_runtime_snapshot("capture_done");

    if (result == ESP_OK &&
        listen_started &&
        auto_followup_mode &&
        !during_playback_mode &&
        recorded_samples > 0) {
        const uint32_t captured_ms =
            (uint32_t)(((uint64_t)recorded_samples * 1000ULL) / CONFIG_NUWAX_VOICE_SAMPLE_RATE);
        if (captured_ms < NUWAX_AUTO_FOLLOWUP_MIN_ASR_AUDIO_MS) {
            nuwax_listen_resume_state_set_short_audio(&s_listen_resume, true);
            ESP_LOGI(TAG,
                     "auto follow-up short audio filtered audio_ms=%lu frames=%lu threshold_ms=%u",
                     (unsigned long)captured_ms,
                     (unsigned long)recorded_frames,
                     (unsigned)NUWAX_AUTO_FOLLOWUP_MIN_ASR_AUDIO_MS);
        }
    }

cleanup:
    if (stop_reason == NUWAX_MIC_CAPTURE_STOP_NONE) {
        mic_capture_set_stop_reason(
            &stop_reason,
            !nuwax_ws_is_connected(ws)
                ? NUWAX_MIC_CAPTURE_STOP_WS_ERROR
                : NUWAX_MIC_CAPTURE_STOP_PROCESSING_ERROR);
        if (result == ESP_OK) {
            ESP_LOGE(TAG,
                     "mic capture reached cleanup without an explicit stop cause");
            result = ESP_ERR_INVALID_STATE;
        }
    }
    ESP_LOGI(TAG,
             "mic capture cleanup reason=%s result=%s listen_started=%d upload_started=%d",
             mic_capture_stop_reason_name(stop_reason),
             esp_err_to_name(result),
             listen_started ? 1 : 0,
             upload_started ? 1 : 0);
    if (audio_task_priority_raised) {
        vTaskPrioritySet(NULL, original_task_priority);
        audio_task_priority_raised = false;
    }
    if (capture_started) {
        if (during_playback_mode) {
            s_during_playback_capture_runtime_ready = false;
        }
        const esp_err_t capture_stop_err = rt_capture_stop(&(work->capture_ctx));
        if (capture_stop_err != ESP_OK && result == ESP_OK) {
            result = capture_stop_err;
        }
        capture_started = false;
        rt_capture_read_frames = (work->capture_ctx).read_frames;
        rt_capture_dropped_no_slot = (work->capture_ctx).dropped_no_slot;
        rt_capture_dropped_oldest_ready = (work->capture_ctx).dropped_oldest_ready;
        rt_capture_ready_full_drops = (work->capture_ctx).ready_full_drops;
        rt_capture_dropped_samples = (work->capture_ctx).dropped_samples;
        rt_capture_max_ready_depth = (work->capture_ctx).max_ready_depth;
    }
#if CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_SHADOW
    if (adaptive_endpoint.speech_started) {
        ESP_LOGI(TAG,
                 "adaptive endpoint shadow summary predicted=%d predictions=%lu actionable_predictions=%lu would_truncate=%d confirmed_truncations=%lu actionable_truncations=%lu cancel_count=%u voiced_ms=%lu span_ms=%lu max_resumed_pause_ms=%lu frozen_commit_ms=%u",
                 adaptive_endpoint.predicted_commit ? 1 : 0,
                 (unsigned long)adaptive_prediction_count,
                 (unsigned long)adaptive_actionable_prediction_count,
                 adaptive_endpoint.would_have_truncated ? 1 : 0,
                 (unsigned long)adaptive_confirmed_truncation_count,
                 (unsigned long)adaptive_actionable_truncation_count,
                 (unsigned)adaptive_endpoint.candidate_cancel_count,
                 (unsigned long)adaptive_endpoint.voiced_ms,
                 (unsigned long)adaptive_endpoint.utterance_span_ms,
                 (unsigned long)adaptive_endpoint.max_resumed_pause_ms,
                 (unsigned)adaptive_endpoint.frozen_commit_ms);
    }
#endif
    if (aec_alignment_count > 0U || (work->live_aec).pending_count > 0U ||
        (work->live_aec).output_count > 0U) {
        const size_t dropped_samples =
            nuwax_live_aec_flush_pending(&(work->live_aec));
        if (aec_alignment_count > 1U ||
            dropped_samples > samples_per_frame) {
            ESP_LOGW(TAG,
                     "AEC stream end flush contexts=%u samples=%u startup_frames=%lu transition_drops=%lu",
                     (unsigned)aec_alignment_count,
                     (unsigned)dropped_samples,
                     (unsigned long)aec_alignment_startup_frames,
                     (unsigned long)aec_alignment_transition_drops);
        } else {
            ESP_LOGI(TAG,
                     "AEC stream end boundary flushed contexts=%u samples=%u startup_frames=%lu transition_drops=%lu",
                     (unsigned)aec_alignment_count,
                     (unsigned)dropped_samples,
                     (unsigned long)aec_alignment_startup_frames,
                     (unsigned long)aec_alignment_transition_drops);
        }
        aec_alignment_count = 0U;
        aec_alignment_read = 0U;
    }
    heap_caps_free(aec_alignment_contexts);
    aec_alignment_contexts = NULL;
    nuwax_audio_cleaner_deinit(&(work->audio_cleaner));
    if (barge_protocol_enqueued && !listen_started) {
        nuwax_barge_dispatch_status_t dispatch_status =
            NUWAX_BARGE_DISPATCH_UNKNOWN;
        esp_err_t dispatch_result = ESP_ERR_INVALID_STATE;
        bool status_found = nuwax_barge_dispatcher_get_status(
            barge_dispatch_binding,
            barge_event_id,
            &dispatch_status,
            &dispatch_result);
        if (status_found &&
            dispatch_status == NUWAX_BARGE_DISPATCH_PENDING) {
            (void)nuwax_barge_dispatcher_cancel(
                barge_dispatch_binding, barge_event_id);
            status_found = nuwax_barge_dispatcher_get_status(
                barge_dispatch_binding,
                barge_event_id,
                &dispatch_status,
                &dispatch_result);
        }
        if (status_found &&
            dispatch_status == NUWAX_BARGE_DISPATCH_LISTEN_SENDING) {
            const uint32_t wait_started_ms = monotonic_ms();
            do {
                vTaskDelay(pdMS_TO_TICKS(10));
                status_found = nuwax_barge_dispatcher_get_status(
                    barge_dispatch_binding,
                    barge_event_id,
                    &dispatch_status,
                    &dispatch_result);
            } while (status_found &&
                     dispatch_status ==
                         NUWAX_BARGE_DISPATCH_LISTEN_SENDING &&
                     monotonic_ms() - wait_started_ms < 1500U);
        }
        const bool dispatch_delivered =
            status_found &&
            dispatch_status == NUWAX_BARGE_DISPATCH_DELIVERED &&
            dispatch_result == ESP_OK;
        const bool dispatch_may_have_committed =
            status_found &&
            nuwax_barge_dispatch_listen_may_be_committed(
                dispatch_status);
        if (dispatch_delivered) {
            listen_started = true;
            barge_protocol_listen_committed = true;
            barge_uplink_prepared = false;
            if (!release_playback_terminal_after_committed_barge(
                    barge_playback_connection_epoch,
                    barge_stop_playback_generation,
                    barge_parent_turn_id,
                    barge_playback_id,
                    "barge_listen_committed_cleanup")) {
                if (result == ESP_OK) {
                    result = ESP_ERR_INVALID_STATE;
                }
            }
            ESP_LOGW(TAG,
                     "barge listen start committed during capture cleanup event=%s; prepared uplink retained for ordered END and listen stop",
                     barge_event_id);
        } else if (dispatch_may_have_committed || !status_found) {
            /* The listen send may still be completing, or its binding may
             * have disappeared with the connection epoch. Conservatively
             * retain the already prepared sender so END follows any late
             * listen-start on the same serialized WebSocket writer. */
            const bool prepared_terminal =
                barge_uplink_prepared && send_ctx && send_ctx->task;
            listen_started = prepared_terminal;
            barge_protocol_listen_committed = listen_started;
            barge_uplink_prepared = false;
            quarantine_playback_terminal_after_failed_barge(
                barge_playback_connection_epoch,
                barge_stop_playback_generation,
                barge_physical_stop_observed,
                status_found ? "barge_listen_commit_uncertain"
                             : "barge_dispatch_status_lost");
            ESP_LOGE(TAG,
                     "barge listen transaction unresolved during cleanup event=%s status=%d err=%s prepared_terminal=%d; completing END/stop when possible and retaining healthy WebSocket",
                     barge_event_id,
                     (int)dispatch_status,
                     esp_err_to_name(dispatch_result),
                     prepared_terminal ? 1 : 0);
            if (result == ESP_OK) {
                result = status_found && dispatch_result != ESP_OK
                             ? dispatch_result
                             : ESP_ERR_INVALID_STATE;
            }
        } else {
            if (barge_uplink_prepared) {
                const esp_err_t discard_err =
                    nuwax_audio_uplink_discard_uncommitted(send_ctx);
                if (discard_err != ESP_OK && result == ESP_OK) {
                    result = discard_err;
                }
                barge_uplink_prepared = false;
            }
            quarantine_playback_terminal_after_failed_barge(
                barge_playback_connection_epoch,
                barge_stop_playback_generation,
                barge_physical_stop_observed,
                "barge_protocol_failed_before_listen");
        }
    }
    if (barge_uplink_prepared && !listen_started) {
        const esp_err_t discard_err =
            nuwax_audio_uplink_discard_uncommitted(send_ctx);
        if (discard_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "orphaned prepared barge uplink cleanup failed event=%s err=%s",
                     barge_event_id[0] ? barge_event_id : "-",
                     esp_err_to_name(discard_err));
            if (result == ESP_OK) {
                result = discard_err;
            }
        }
        barge_uplink_prepared = false;
    }
    /* Resolve the dispatcher first: a listen start that commits during
     * cleanup still owns a prepared sender and must observe binary END before
     * JSON stop. This covers every goto-cleanup path after local prepare. */
    if (listen_started && send_ctx && send_ctx->task &&
        !uplink_finish_attempted) {
        uplink_finish_attempted = true;
        uplink_finish_result = nuwax_audio_uplink_finish(send_ctx);
        uplink_finish_succeeded = uplink_finish_result == ESP_OK;
        result = nuwax_audio_uplink_resolve_capture_finish_result(
            result, uplink_finish_result);
    }
    uplink_end_committed =
        send_ctx && nuwax_audio_uplink_end_committed(send_ctx);
    if (uplink_end_committed && send_ctx &&
        stop_reason != NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
        !s_sleep_transaction.active &&
        nuwax_listen_resume_state_event_matches(
            &s_listen_resume,
            nuwax_awake_session_state_generation(&s_awake_session),
            send_ctx->terminal_recovery_audio_session_id) &&
        nuwax_listen_resume_state_mark_post_end_terminal(
            &s_listen_resume, send_ctx->ws_connection_epoch)) {
        ESP_LOGI(TAG,
                 "post-END cloud terminal ownership bound at binary END session=%s ws_epoch=%lu",
                 send_ctx->terminal_recovery_audio_session_id,
                 (unsigned long)send_ctx->ws_connection_epoch);
    }
    const bool listen_stop_protocol_safe =
        listen_started && uplink_finish_attempted &&
        uplink_end_committed && send_ctx &&
        send_ctx->terminal_recovery_bound &&
        send_ctx->terminal_recovery_mode[0] != '\0';
    if (listen_started && !listen_stop_protocol_safe) {
        const bool bound_ws_alive =
            nuwax_ws_is_connected(ws) &&
            send_ctx && send_ctx->ws_connection_epoch != 0U &&
            nuwax_ws_connection_epoch(ws) == send_ctx->ws_connection_epoch;
        if (bound_ws_alive) {
            ESP_LOGE(TAG,
                     "listen session cannot send JSON stop because its binary END or frozen terminal binding is unavailable finish_attempted=%d finish_result=%s end_committed=%d terminal_bound=%d uplink_task=%d; closing bound WebSocket",
                     uplink_finish_attempted ? 1 : 0,
                     uplink_finish_attempted
                         ? esp_err_to_name(uplink_finish_result)
                         : "not_started",
                     uplink_end_committed ? 1 : 0,
                     send_ctx && send_ctx->terminal_recovery_bound ? 1 : 0,
                     send_ctx && send_ctx->task ? 1 : 0);
        } else {
            ESP_LOGI(TAG,
                     "listen terminal messages abandoned with closed WebSocket epoch=%lu finish_attempted=%d finish_result=%s",
                     (unsigned long)(send_ctx
                                         ? send_ctx->ws_connection_epoch
                                         : 0U),
                     uplink_finish_attempted ? 1 : 0,
                     uplink_finish_attempted
                         ? esp_err_to_name(uplink_finish_result)
                         : "not_started");
        }
        if (result == ESP_OK) {
            result = uplink_finish_attempted
                         ? uplink_finish_result
                         : ESP_ERR_INVALID_STATE;
        }
        const uint32_t terminal_epoch =
            send_ctx ? send_ctx->ws_connection_epoch : 0U;
        const bool recovery_pending =
            nuwax_audio_terminal_recovery_pending();
        const bool close_queued =
            !recovery_pending && bound_ws_alive && terminal_epoch != 0U &&
            nuwax_ws_close_if_epoch(
                ws,
                terminal_epoch,
                NUWAX_WS_CLOSE_CAUSE_TRANSPORT_INTEGRITY);
        if (recovery_pending) {
            ESP_LOGW(TAG,
                     "binary END deferred to cross-loop terminal recovery epoch=%lu; WebSocket retained",
                     (unsigned long)terminal_epoch);
        }
        if (s_sleep_transaction.active &&
            s_sleep_transaction.ws_epoch == terminal_epoch &&
            close_queued) {
            (void)nuwax_sleep_transaction_mark_protocol_closed(
                &s_sleep_transaction,
                s_sleep_transaction.token,
                s_sleep_transaction.ws_epoch);
            ESP_LOGW(TAG,
                     "sleep transaction closed bound WebSocket because binary END could not be proven token=%lu epoch=%lu",
                     (unsigned long)s_sleep_transaction.token,
                     (unsigned long)s_sleep_transaction.ws_epoch);
        }
    }
    if (listen_stop_protocol_safe &&
        !nuwax_audio_terminal_recovery_pending()) {
        /* The terminal binding was frozen before listen start. Global
         * prelisten/barge state may be cleared or replaced while capture is
         * active, so it must never be used to reconstruct this session's
         * matching stop. */
        const char *stop_mode = send_ctx->terminal_recovery_mode;
        const char *stop_audio_session_id =
            send_ctx->terminal_recovery_audio_session_id[0]
                ? send_ctx->terminal_recovery_audio_session_id
                : NULL;
        const char *stop_request_id =
            send_ctx->terminal_recovery_request_id[0]
                ? send_ctx->terminal_recovery_request_id
                : NULL;
        const uint32_t listen_stop_epoch =
            send_ctx && send_ctx->ws_connection_epoch != 0U
                ? send_ctx->ws_connection_epoch
                : nuwax_ws_connection_epoch(ws);
        const esp_err_t listen_stop_err =
            nuwax_session_send_listen_stop_retry_if_epoch(
                ws,
                stop_mode,
                stop_audio_session_id,
                stop_request_id,
                (uint32_t)(NUWAX_ASYNC_WS_CONTROL_SEND_TIMEOUT_US / 1000LL),
                listen_stop_epoch);
        if (listen_stop_err != ESP_OK) {
            ESP_LOGE(TAG,
                     "listen stop send failed mode=%s audio_session=%s event=%s: %s; closing bound WebSocket",
                     stop_mode,
                     stop_audio_session_id ? stop_audio_session_id : "-",
                     stop_request_id ? stop_request_id : "-",
                     esp_err_to_name(listen_stop_err));
            if (result == ESP_OK) {
                result = listen_stop_err;
            }
            const esp_err_t recovery_arm_err =
                nuwax_audio_terminal_recovery_arm(
                    ws,
                    listen_stop_epoch,
                    NULL,
                    0U,
                    true,
                    stop_mode,
                    stop_audio_session_id,
                    stop_request_id,
                    NUWAX_AUDIO_TERMINAL_RECOVERY_DEFAULT_ATTEMPT_TIMEOUT_MS);
            const bool close_queued =
                recovery_arm_err != ESP_OK &&
                nuwax_ws_close_if_epoch(
                    ws,
                    listen_stop_epoch,
                    NUWAX_WS_CLOSE_CAUSE_TRANSPORT_INTEGRITY);
            if (recovery_arm_err == ESP_OK) {
                ESP_LOGW(TAG,
                         "listen stop deferred to cross-loop terminal recovery mode=%s session=%s epoch=%lu",
                         stop_mode,
                         stop_audio_session_id ? stop_audio_session_id : "-",
                         (unsigned long)listen_stop_epoch);
            }
            if (s_sleep_transaction.active &&
                s_sleep_transaction.ws_epoch == listen_stop_epoch &&
                close_queued) {
                (void)nuwax_sleep_transaction_mark_protocol_closed(
                    &s_sleep_transaction,
                    s_sleep_transaction.token,
                    s_sleep_transaction.ws_epoch);
                ESP_LOGW(TAG,
                         "sleep transaction closed bound WebSocket after listen stop failure token=%lu epoch=%lu",
                         (unsigned long)s_sleep_transaction.token,
                         (unsigned long)s_sleep_transaction.ws_epoch);
            }
        } else {
            listen_stop_succeeded = true;
            ESP_LOGI(TAG,
                     "listen stop sent after binary END mode=%s audio_session=%s event=%s epoch=%lu",
                     stop_mode,
                     stop_audio_session_id ? stop_audio_session_id : "-",
                     stop_request_id ? stop_request_id : "-",
                     (unsigned long)listen_stop_epoch);
            if (stop_reason ==
                    NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
                nuwax_head_touch_agent_intent_audio_matches(
                    &s_head_touch_agent_intent,
                    stop_audio_session_id)) {
                (void)nuwax_head_touch_agent_intent_mark_terminal_released(
                    &s_head_touch_agent_intent,
                    listen_stop_epoch,
                    stop_audio_session_id);
                ESP_LOGI(TAG,
                         "head touch agent audio terminal barrier released token=%lu session=%s epoch=%lu",
                         (unsigned long)s_head_touch_agent_intent.token,
                         stop_audio_session_id,
                         (unsigned long)listen_stop_epoch);
            }
        }
        if (listen_stop_err == ESP_OK &&
            stop_reason != NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
            !s_sleep_transaction.active &&
            !conversation_wait_text_deadline_owned_by_turn_guard() &&
                   nuwax_listen_resume_state_event_matches(
                       &s_listen_resume,
                       nuwax_awake_session_state_generation(
                           &s_awake_session),
                       stop_audio_session_id) &&
                   nuwax_listen_resume_state_arm_post_end_asr(
                       &s_listen_resume,
                       nuwax_ws_connection_epoch(ws),
                       monotonic_ms() +
                           NUWAX_POST_END_RESPONSE_TIMEOUT_MS)) {
            ESP_LOGI(TAG,
                     "post-END cloud response watchdog armed session=%s ws_epoch=%lu timeout_ms=%u",
                     stop_audio_session_id ? stop_audio_session_id : "-",
                     (unsigned long)nuwax_listen_resume_state_ws_epoch(
                         &s_listen_resume),
                     (unsigned)NUWAX_POST_END_RESPONSE_TIMEOUT_MS);
        }
        if (persistent_awake_timeout &&
            nuwax_listen_resume_state_is_waiting_post_end_asr(
                &s_listen_resume)) {
            pause_awake_waiting("awake_idle_timeout_post_end");
        }
    }
#if CONFIG_NUWAX_VOICE_UPLINK_CODEC_OPUS
    if (opus_encoder_ready) {
        nuwax_opus_encoder_deinit(&opus_encoder);
    }
#endif
#if CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE
    /* P3-0/P3-1: teardown AFE if it was created */
    if (s_afe_mr_enabled && s_afe_handle) {
        /* TODO P3-1: afe_destroy(s_afe_handle); */
        s_afe_handle = NULL;
        s_afe_mr_enabled = false;
        ESP_LOGI(TAG, "P3-0 AFE MR teardown");
    }
#endif
    esp_err_t mic_deinit_err = ESP_OK;
    for (unsigned attempt = 1U; attempt <= NUWAX_MIC_DEINIT_ATTEMPTS;
         ++attempt) {
        mic_deinit_err = nuwax_mic_input_deinit(&mic);
        if (mic_deinit_err == ESP_OK) {
            break;
        }
        ESP_LOGW(TAG,
                 "conversation microphone deinit attempt=%u/%u failed: %s",
                 attempt, (unsigned)NUWAX_MIC_DEINIT_ATTEMPTS,
                 esp_err_to_name(mic_deinit_err));
        if (attempt < NUWAX_MIC_DEINIT_ATTEMPTS) {
            vTaskDelay(pdMS_TO_TICKS(NUWAX_MIC_DEINIT_RETRY_MS));
        }
    }
    if (mic_deinit_err != ESP_OK) {
        ESP_LOGE(TAG, "conversation microphone deinit failed: %s",
                 esp_err_to_name(mic_deinit_err));
        if (result == ESP_OK) {
            result = mic_deinit_err;
        }
        if (stop_reason == NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT) {
            clear_head_touch_agent_intent("microphone_deinit_failed");
        }
    }
    atomic_store_explicit(&s_conversation_capture_runtime_active,
                          false,
                          memory_order_release);
    if (stop_reason == NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING) {
        (void)nuwax_head_touch_agent_intent_mark_capture_released(
            &s_head_touch_agent_intent,
            nuwax_ws_connection_epoch(ws),
            capture_awake_generation,
            s_head_touch_agent_intent.audio_session_id[0]
                ? s_head_touch_agent_intent.audio_session_id
                : NULL);
        ESP_LOGI(TAG,
                 "head touch agent microphone barrier released token=%lu session=%s",
                 (unsigned long)s_head_touch_agent_intent.token,
                 s_head_touch_agent_intent.audio_session_id[0]
                     ? s_head_touch_agent_intent.audio_session_id
                     : "-");
    }
    if (s_sleep_transaction.active &&
        s_sleep_transaction.ws_epoch == nuwax_ws_connection_epoch(ws)) {
        const uint32_t sleep_token = s_sleep_transaction.token;
        (void)nuwax_sleep_transaction_mark_capture_released(
            &s_sleep_transaction, sleep_token);
        if (!listen_started || listen_stop_succeeded) {
            (void)nuwax_sleep_transaction_mark_protocol_closed(
                &s_sleep_transaction,
                sleep_token,
                s_sleep_transaction.ws_epoch);
        }
        ESP_LOGI(TAG,
                 "sleep transaction capture cleanup token=%lu epoch=%lu listen_started=%d end_committed=%d listen_stop=%d",
                 (unsigned long)sleep_token,
                 (unsigned long)s_sleep_transaction.ws_epoch,
                 listen_started ? 1 : 0,
                 uplink_end_committed ? 1 : 0,
                 listen_stop_succeeded ? 1 : 0);
    }
    (void)nuwax_audio_uplink_destroy_owned(&send_ctx);
    if (live_aec_pool_acquired) {
        const bool live_aec_raw_diagnostic_exercised =
            acceptance_capture_enabled &&
            acceptance_capture_playback_seen &&
            (acceptance_capture.raw_mic1 ||
             acceptance_capture.raw_fir_ref_pair ||
             acceptance_capture.raw_hw_ref_pair);
        if (live_aec_custom_delay_exercised ||
            live_aec_runtime_faulted ||
            live_aec_raw_diagnostic_exercised) {
            live_aec_pool_reusable_status =
                conversation_live_aec_restore_production_state(
                    &(work->live_aec),
                    samples_per_frame,
                    live_aec_pool_delay_samples);
        } else {
            (work->live_aec).delay_samples = live_aec_pool_delay_samples;
        }
    }
    conversation_live_aec_pool_release(&(work->live_aec),
                                       live_aec_pool_acquired,
                                       live_aec_pool_reusable_status);
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!sleep_transaction_blocks_new_audio() &&
        !atomic_load_explicit(&s_reprovision_quiesce_requested,
                              memory_order_acquire) &&
        stop_reason != NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
        listen_started && result == ESP_OK && recorded_samples > 0) {
        nuwax_speaker_playback_prepare_for_tts("after_mic_deinit");
    }
#endif
    const uint32_t resume_check_ms = monotonic_ms();
    if (stop_reason != NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT &&
        listen_started &&
        auto_followup_mode &&
        !during_playback_mode &&
        s_prelisten.capture_deadline_ms != 0 &&
        !elapsed_ms(resume_check_ms, s_prelisten.capture_deadline_ms)) {
        nuwax_listen_resume_state_arm_no_speech(&s_listen_resume,
                                                nuwax_prelisten_state_mode_or(&s_prelisten, "auto_followup"),
                                                s_prelisten.capture_deadline_ms);
        ESP_LOGI(TAG,
                 "listen no-speech resume armed mode=%s remaining_ms=%lu",
                 nuwax_listen_resume_state_mode_or(&s_listen_resume, "auto_followup"),
                 (unsigned long)(nuwax_listen_resume_state_deadline_ms(&s_listen_resume) - resume_check_ms));
    } else if (!listen_started) {
        /* Keep the bound round after a successful listen stop. ASR events are
         * asynchronous and are consumed after capture cleanup; clearing here
         * made every direct-touch result look stale. The ASR result/error,
         * awake-session replacement, or disconnect clears the binding. */
        clear_last_listen_resume();
    }
    nuwax_prelisten_state_finish_capture(&s_prelisten);
    if (atomic_load_explicit(&s_reprovision_quiesce_requested,
                             memory_order_acquire)) {
        ESP_LOGI(TAG,
                 "conversation cleanup complete for pending BLE reprovision");
        return result;
    }
    if (s_notification_transaction.active &&
        !conversation_capture_busy_for_sleep()) {
        service_notification_transaction();
        return result;
    }
    if (s_sleep_transaction.active &&
        !conversation_capture_busy_for_sleep()) {
        service_sleep_transaction();
        return result;
    }
    if (s_sleep_request_pending && !conversation_capture_busy_for_sleep()) {
        service_pending_sleep_request();
        return result;
    }
    if (stop_reason == NUWAX_MIC_CAPTURE_STOP_HEAD_TOUCH_AGENT) {
        s_post_playback_resume_pending = false;
        ESP_LOGI(TAG,
                 "head touch agent capture cleanup retained transaction token=%lu state=%s result=%s",
                 (unsigned long)s_head_touch_agent_intent.token,
                 nuwax_head_touch_agent_state_name(
                     s_head_touch_agent_intent.state),
                 esp_err_to_name(result));
        return result;
    }
    complete_during_playback_capture_handoff();
    if (exclusive_mode_preempted) {
        ESP_LOGI(TAG, "normal conversation cleanup preserved exclusive audio mode state");
    } else if (persistent_awake_timeout) {
        const bool idle_expiry_waiting_for_cloud =
            nuwax_listen_resume_state_holds_idle_expiry_boundary(
                &s_listen_resume);
        if (idle_expiry_waiting_for_cloud &&
            nuwax_awake_session_state_generation_matches(
                &s_awake_session, capture_awake_generation)) {
            /* The expired idle budget stays frozen. The session-bound
             * post-END watchdog now owns the sleep decision so a queued
             * playback_begin/text/asr event can continue this turn. */
            pause_awake_waiting("awake_idle_timeout_post_end");
            nuwax_state_bridge_clear_pending_sleep_visual();
            (void)enter_cloud_waiting_question(
                "awake_idle_timeout_post_end");
            ESP_LOGI(TAG,
                     "awake idle timeout deferred after committed END; visual=question awaiting cloud turn session=%s generation=%lu epoch=%lu",
                     s_listen_resume.audio_session_id[0]
                         ? s_listen_resume.audio_session_id
                         : "-",
                     (unsigned long)nuwax_awake_session_state_generation(
                         &s_awake_session),
                     (unsigned long)nuwax_listen_resume_state_ws_epoch(
                         &s_listen_resume));
        } else if (nuwax_awake_session_state_generation_matches(
                       &s_awake_session, capture_awake_generation) &&
                   awake_idle_sleep_admitted(monotonic_ms())) {
            enter_sleeping_conversation_state("awake_idle_timeout");
        } else {
            ESP_LOGI(TAG,
                     "stale awake timeout ignored capture_generation=%lu current_generation=%lu",
                     (unsigned long)capture_awake_generation,
                     (unsigned long)nuwax_awake_session_state_generation(
                         &s_awake_session));
        }
    } else if (s_post_playback_resume_pending) {
        complete_post_playback_resume();
    } else if (auto_followup_cancelled) {
        /* A cancelled capture can race the first PCM owner event. Keep the
         * lifecycle pending until that generation-bound event is consumed. */
        set_state(NUWAX_APP_STATE_THINKING);
    } else if (auto_followup_replaced_by_command) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
        if (during_playback_mode && nuwax_speaker_playback_has_pending()) {
            ESP_LOGI(TAG,
                     "during-playback capture window ended; rearming while playback remains active");
            arm_during_playback_capture("during_playback_window_restart", true);
        } else
#endif
        {
            ESP_LOGI(TAG, "conversation prelisten exit kept session command state");
        }
    } else if (nuwax_listen_resume_state_has_short_audio(&s_listen_resume)) {
        set_state(NUWAX_APP_STATE_LISTENING);
    } else if (auto_followup_sleep_after_no_speech) {
        if (!resume_awake_conversation_after_inactivity("listen_timeout")) {
            enter_sleeping_conversation_state("listen_timeout");
        }
    } else if (listen_started || recorded_samples > 0) {
        if (!enter_cloud_waiting_question("audio_submitted") &&
            !resume_awake_conversation_after_inactivity(
                "cloud_wait_unowned")) {
            enter_sleeping_conversation_state("cloud_wait_unowned");
        }
    } else {
        if (!resume_awake_conversation_after_inactivity("listen_empty")) {
            enter_sleeping_conversation_state("listen_empty");
        }
    }
    return result;
}
#endif

static esp_err_t service_audio_terminal_recovery(nuwax_ws_client_t *ws) {
    const esp_err_t err = nuwax_audio_terminal_recovery_service(ws);
    nuwax_audio_terminal_recovery_completion_t completion = {0};
    if (!nuwax_audio_terminal_recovery_take_completion(&completion)) {
        return err;
    }

    const bool bound_epoch =
        ws && completion.ws_epoch != 0U &&
        completion.ws_epoch == nuwax_ws_connection_epoch(ws) &&
        completion.ws_epoch == active_ws_epoch_snapshot();
    const bool current_epoch = bound_epoch && nuwax_ws_is_connected(ws);
    const bool listen_round_matches =
        completion.audio_session_id[0] != '\0' &&
        s_listen_resume.audio_session_id[0] != '\0' &&
        strcmp(completion.audio_session_id,
               s_listen_resume.audio_session_id) == 0;
    const bool head_touch_round_matches =
        s_head_touch_agent_intent.state ==
            NUWAX_HEAD_TOUCH_AGENT_STATE_QUIESCING &&
        s_head_touch_agent_intent.ws_epoch == completion.ws_epoch &&
        nuwax_head_touch_agent_intent_audio_matches(
            &s_head_touch_agent_intent,
            completion.audio_session_id);

    if ((completion.success || completion.quarantined) &&
        s_sleep_transaction.active &&
        completion.ws_epoch == s_sleep_transaction.ws_epoch) {
        (void)nuwax_sleep_transaction_mark_protocol_closed(
            &s_sleep_transaction,
            s_sleep_transaction.token,
            completion.ws_epoch);
        ESP_LOGW(TAG,
                 "terminal recovery released sleep protocol barrier token=%lu epoch=%lu session=%s outcome=%s failures=%lu age_ms=%lu",
                 (unsigned long)s_sleep_transaction.token,
                 (unsigned long)completion.ws_epoch,
                 completion.audio_session_id[0]
                     ? completion.audio_session_id
                     : "-",
                 completion.success ? "committed" : "local_quarantine",
                 (unsigned long)completion.failures,
                 (unsigned long)completion.age_ms);
        service_sleep_transaction();
    }

    if (head_touch_round_matches) {
        if (completion.success && current_epoch) {
            (void)nuwax_head_touch_agent_intent_mark_terminal_released(
                &s_head_touch_agent_intent,
                completion.ws_epoch,
                completion.audio_session_id);
            ESP_LOGI(TAG,
                     "terminal recovery released head touch agent audio barrier token=%lu session=%s epoch=%lu failures=%lu age_ms=%lu",
                     (unsigned long)s_head_touch_agent_intent.token,
                     completion.audio_session_id,
                     (unsigned long)completion.ws_epoch,
                     (unsigned long)completion.failures,
                     (unsigned long)completion.age_ms);
        } else {
            clear_head_touch_agent_intent(
                completion.quarantined
                    ? "terminal_recovery_quarantined"
                    : "terminal_recovery_owner_changed");
        }
    }

    if (!head_touch_round_matches && completion.success && current_epoch &&
        listen_round_matches &&
        !s_sleep_transaction.active &&
        nuwax_awake_session_state_is_active(&s_awake_session) &&
        nuwax_listen_resume_state_arm_post_end_asr(
            &s_listen_resume,
            completion.ws_epoch,
            monotonic_ms() + NUWAX_POST_END_RESPONSE_TIMEOUT_MS)) {
        ESP_LOGI(TAG,
                 "terminal recovery armed post-END response watchdog session=%s epoch=%lu",
                 completion.audio_session_id,
                 (unsigned long)completion.ws_epoch);
    }

    if (completion.quarantined) {
        if (listen_round_matches) {
            clear_last_listen_resume();
        }
        ESP_LOGE(TAG,
                 "terminal recovery quarantined stale listen by closing its bound WebSocket session=%s epoch=%lu current_epoch=%d failures=%lu age_ms=%lu",
                 completion.audio_session_id[0]
                     ? completion.audio_session_id
                     : "-",
                 (unsigned long)completion.ws_epoch,
                 current_epoch ? 1 : 0,
                 (unsigned long)completion.failures,
                 (unsigned long)completion.age_ms);
        if (current_epoch) {
            ESP_LOGE(TAG,
                     "terminal recovery quarantine did not close the current epoch; requesting transport-integrity close again epoch=%lu",
                     (unsigned long)completion.ws_epoch);
            (void)nuwax_ws_close_if_epoch(
                ws,
                completion.ws_epoch,
                NUWAX_WS_CLOSE_CAUSE_TRANSPORT_INTEGRITY);
        }
        if (bound_epoch) {
            return ESP_ERR_INVALID_STATE;
        }
    }
    return err;
}

/* Monitoring owns the shared RX channel for the entire capture session. Keep
 * its synchronous reader at the same real-time priority used by ordinary
 * conversation capture; otherwise the 120 ms shared-I2S DMA ring can be
 * overrun by UI, Wi-Fi, or control-plane work. Restore the caller priority
 * on every return so the control loop does not inherit an audio priority. */
static esp_err_t run_monitoring_audio_source(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_SD_SESSION_ENABLE
    if (s_monitoring_mode.sd_local) return nuwax_monitoring_mode_run(&s_monitoring_mode, ws);
#endif
    const UBaseType_t previous_priority = uxTaskPriorityGet(NULL);
    const bool raised = previous_priority < NUWAX_AUDIO_DSP_TASK_PRIORITY;
    if (raised) {
        vTaskPrioritySet(NULL, NUWAX_AUDIO_DSP_TASK_PRIORITY);
        ESP_LOGI(TAG,
                 "monitoring capture realtime priority raised previous=%u active=%u",
                 (unsigned)previous_priority,
                 (unsigned)NUWAX_AUDIO_DSP_TASK_PRIORITY);
    }

    const esp_err_t err = nuwax_monitoring_mode_run(&s_monitoring_mode, ws);

    if (raised) {
        vTaskPrioritySet(NULL, previous_priority);
        ESP_LOGI(TAG,
                 "monitoring capture realtime priority restored priority=%u",
                 (unsigned)previous_priority);
    }
    return err;
}

/* The meeting path also owns the shared RX channel for its full capture
 * session. Keep its synchronous reader above UI/decode work so the 120 ms
 * shared-I2S ring cannot overflow while the control loop is capturing. */
static esp_err_t run_meeting_audio_source(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_SD_SESSION_ENABLE
    if (s_meeting_mode.sd_local) return nuwax_meeting_mode_run(&s_meeting_mode, ws);
#endif
    const UBaseType_t previous_priority = uxTaskPriorityGet(NULL);
    const bool raised = previous_priority < NUWAX_AUDIO_DSP_TASK_PRIORITY;
    if (raised) {
        vTaskPrioritySet(NULL, NUWAX_AUDIO_DSP_TASK_PRIORITY);
        ESP_LOGI(TAG,
                 "meeting capture realtime priority raised previous=%u active=%u",
                 (unsigned)previous_priority,
                 (unsigned)NUWAX_AUDIO_DSP_TASK_PRIORITY);
    }

    const esp_err_t err = nuwax_meeting_mode_run(&s_meeting_mode, ws);

    if (raised) {
        vTaskPrioritySet(NULL, previous_priority);
        ESP_LOGI(TAG,
                 "meeting capture realtime priority restored priority=%u",
                 (unsigned)previous_priority);
    }
    return err;
}

static esp_err_t run_audio_source(nuwax_ws_client_t *ws) {
    app_task_watchdog_checkpoint();
#if CONFIG_NUWAX_OFFLINE_AUDIO_ENABLE
    /* A replay worker may have yielded while the normal audio wait loop was
     * already inside wait_for_mic_start_action(). Surface that edge to the
     * connection owner instead of sleeping indefinitely with ready archives. */
    const bool controller_ready = nuwax_meeting_mode_has_pending(&s_meeting_mode) ||
                                  nuwax_monitoring_mode_has_pending(&s_monitoring_mode);
    if (!controller_ready && nuwax_offline_audio_has_ready() &&
        !nuwax_offline_audio_storage_busy() &&
        !nuwax_offline_audio_replay_running() &&
        nuwax_offline_audio_replay_retry_pending()) {
        return ESP_ERR_NOT_FINISHED;
    }
    if ((nuwax_offline_audio_capture_running() && !controller_ready) ||
        (offline_mode_lease_pending() && !controller_ready)) {
        /* MIC ownership gates capture; a background FILE close does not.
         * A new mirror retries admission after the old writer has finished. */
        return ESP_ERR_NOT_FINISHED;
    }
#endif
    if (nuwax_audio_terminal_recovery_pending()) {
        const esp_err_t recovery_err = service_audio_terminal_recovery(ws);
        if (nuwax_audio_terminal_recovery_pending()) {
            return recovery_err == ESP_OK ? ESP_ERR_NOT_FINISHED
                                          : recovery_err;
        }
        if (recovery_err != ESP_OK) {
            return recovery_err;
        }
    }
    /* Finish the current exclusive owner before consuming a queued request for
     * the other mode. This makes cloud mode switches an ordered MIC handoff
     * instead of allowing two STARTING controllers to race for I2S RX. */
    if (nuwax_monitoring_mode_state(&s_monitoring_mode) !=
        NUWAX_MONITORING_STATE_DISABLED) {
        return run_monitoring_audio_source(ws);
    }
    if (nuwax_meeting_mode_state(&s_meeting_mode) !=
        NUWAX_MEETING_STATE_DISABLED) {
        return run_meeting_audio_source(ws);
    }
    if (nuwax_audio_uplink_sender_busy()) {
        /* A detached sender still owns its static TCB and may be finishing a
         * WebSocket call. Active exclusive modes above own their sender and
         * must keep running; only fence new pending/normal capture owners. */
        return ESP_ERR_NOT_FINISHED;
    }
    if (nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) {
        return run_monitoring_audio_source(ws);
    }
    if (nuwax_meeting_mode_has_pending(&s_meeting_mode)) {
        return run_meeting_audio_source(ws);
    }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    /* A sleeping device waits on the wake-word/control plane without
     * allocating a normal uplink session. Once the wait admits a wake or
     * touch action, stream_microphone_audio() sees the armed prelisten window
     * and proceeds with the ordinary capture initialization. */
    if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
        const esp_err_t wait_err = wait_for_mic_start_action(ws);
        if (wait_err != ESP_OK) {
            return wait_err;
        }
    }
    return stream_microphone_audio(ws);
#else
    nuwax_touch_point_t point = {0};
    ESP_RETURN_ON_ERROR(wait_for_start_action(ws, &point), TAG, "touch trigger wait failed");
    if (point.touched) {
        ESP_RETURN_ON_ERROR(nuwax_session_send_touch_event(ws, &point, "press"), TAG, "touch event send failed");
    }
    return send_synthetic_audio_burst(ws);
#endif
}

static esp_err_t send_cloud_text_request(nuwax_ws_client_t *ws) {
#if CONFIG_NUWAX_CLOUD_TEXT_REQUEST_ENABLE
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
    static bool s_logged_skip = false;
    if (!s_logged_skip) {
        ESP_LOGI(TAG, "Skipping default cloud text_request in I2S microphone mode");
        s_logged_skip = true;
    }
    (void)ws;
    return ESP_OK;
#else
    char request_id[40];
    snprintf(request_id, sizeof(request_id), "cloud_%lu", (unsigned long)++s_cloud_text_request_seq);
    ESP_LOGI(TAG, "Sending cloud text_request id=%s text=%s", request_id, CONFIG_NUWAX_CLOUD_TEXT_REQUEST_TEXT);
    return nuwax_session_send_text_request(ws, request_id, CONFIG_NUWAX_CLOUD_TEXT_REQUEST_TEXT);
#endif
#else
    (void)ws;
    return ESP_OK;
#endif
}

static void wait_for_cloud_updates(nuwax_ws_client_t *ws, uint32_t wait_ms) {
    const int64_t started_ms = now_ms_i64();
    while (nuwax_ws_is_connected(ws) &&
           (uint32_t)(now_ms_i64() - started_ms) < wait_ms) {
        app_task_watchdog_checkpoint();
        /* Return to the normal MIC owner immediately once sleeping, or when a
         * detector hit is queued. The old 2500 ms settle loop could outlive the
         * 2000 ms wake-event lease even though the detector was already ready.
         * Leave the event queued for its existing epoch/age/owner validation. */
        if (conversation_state_current() == NUWAX_APP_STATE_SLEEPING) {
            return;
        }
#if CONFIG_NUWAX_WAKE_WORD_ENABLE
        if (s_wake_word_events && uxQueueMessagesWaiting(s_wake_word_events) > 0U) {
            return;
        }
#endif
        if (nuwax_audio_terminal_recovery_pending()) {
            (void)service_audio_terminal_recovery(ws);
        }
        drain_session_commands(ws);
        if (drain_shell_actions_preserving_listen_control(ws)) {
            /* Leave START/STOP_LISTEN at the queue head for
             * wait_for_mic_start_action/poll_mic_stop_action. Returning to the
             * outer audio loop prevents the short cloud-settle window from
             * consuming a valid head/screen touch wake. */
            return;
        }
#if CONFIG_NUWAX_AUDIO_SOURCE_I2S_MIC
        complete_during_playback_wake_stop();
        if (exclusive_audio_mode_blocks_normal_audio() ||
            s_prelisten.pending || s_prelisten.capture_active) {
            if (exclusive_audio_mode_blocks_normal_audio() &&
                !nuwax_meeting_mode_has_pending(&s_meeting_mode) &&
                !nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) {
                /* A storage/reprovision fence is not a request to run MIC. */
                service_exclusive_audio_sleep_reconcile();
                (void)service_application_keepalive(ws, "audio_owner_wait");
                conversation_owner_wait_ms(20U);
                continue;
            }
            esp_err_t listen_err = run_audio_source(ws);
            if (listen_err != ESP_OK) {
                if (!nuwax_ws_is_connected(ws)) {
                    ESP_LOGI(TAG,
                             "background listen ended with WebSocket disconnect: %s",
                             esp_err_to_name(listen_err));
                    return;
                }
                ESP_LOGW(TAG,
                         "background listen stopped during cloud wait: %s",
                         esp_err_to_name(listen_err));
            }
            service_pending_ws_reconnect_audio_recovery(ws);
            continue;
        }
#endif
        /* A playback wake hit is delivered through the detector event queue,
         * so keep the cloud-settle loop at the audio frame cadence while the
         * dedicated detector owns the microphone.  The normal idle path keeps
         * the longer slice to avoid unnecessary wakeups. */
        const uint32_t wait_slice_ms =
            wake_detector_request_is_playback()
                ? (uint32_t)CONFIG_NUWAX_VOICE_FRAME_DURATION_MS
                : 100U;
        conversation_owner_wait_ms(wait_slice_ms);
    }
}

static bool mcp_set_emotion(const char *emotion, void *ctx) {
    (void)ctx;
    return apply_semantic_emotion_name(emotion, "mcp");
}

static void handle_mcp_message(nuwax_ws_client_t *ws, const char *payload_json) {
    char ssid[33] = {0};
    char ip[16] = {0};
    nuwax_wifi_get_status(ssid, sizeof(ssid), ip, sizeof(ip));

    nuwax_mcp_device_status_t status = {
        .state = nuwax_app_state_name(conversation_state_current()),
        .ssid = ssid,
        .ip = ip,
        .free_heap = esp_get_free_heap_size(),
        .min_free_heap = esp_get_minimum_free_heap_size(),
    };
    nuwax_mcp_callbacks_t callbacks = {
        .set_emotion = mcp_set_emotion,
        .servo_head_shake = NULL,
        .ctx = NULL,
        .capability_flags = NUWAX_MCP_CALLBACK_CAP_NONE,
    };
    esp_err_t err = nuwax_mcp_handle_message(ws, payload_json, &status, &callbacks);
    if (err != ESP_OK) {
        ESP_LOGW(TAG, "MCP handle failed: %s", esp_err_to_name(err));
    }
}

static void handle_session_event(const nuwax_session_command_t *command,
                                 uint32_t event_ws_epoch) {
    if (!command || !command->has_event) {
        return;
    }
    if (command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_BEGIN ||
        command->event == NUWAX_SESSION_EVENT_NOTIFY_PLAYBACK_END) {
        handle_notification_event(command);
        return;
    }
    if (is_normal_audio_event(command->event) &&
        nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        if (command->event == NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
            notification_rx_barrier_reject_normal_epoch(
                active_ws_epoch_snapshot(),
                command->turn_id,
                command->playback_id,
                "notification_owner_active");
        }
        ESP_LOGI(TAG,
                 "cloud conversation event isolated by notification owner event=%d turn=%s playback=%s",
                 (int)command->event,
                 command->turn_id[0] ? command->turn_id : "-",
                 command->playback_id[0] ? command->playback_id : "-");
        return;
    }
    if (is_normal_audio_event(command->event) &&
        sleep_lifecycle_blocks_normal_cloud_audio()) {
        if (command->event == NUWAX_SESSION_EVENT_PLAYBACK_BEGIN) {
            notification_rx_barrier_reject_normal_epoch(
                active_ws_epoch_snapshot(),
                command->turn_id,
                command->playback_id,
                "sleep_transaction_active");
        }
        ESP_LOGI(TAG,
                 "stale cloud conversation event ignored while sleeping event=%d turn=%s playback=%s",
                 (int)command->event,
                 command->turn_id[0] ? command->turn_id : "-",
                 command->playback_id[0] ? command->playback_id : "-");
        return;
    }
    const bool audio_input_event =
                           command->event == NUWAX_SESSION_EVENT_AUDIO_PROGRESS ||
                           command->event == NUWAX_SESSION_EVENT_ASR_PARTIAL ||
                           command->event == NUWAX_SESSION_EVENT_ASR_FINAL ||
                           command->event == NUWAX_SESSION_EVENT_ASR_RESULT;
    if (audio_input_event &&
        !nuwax_listen_resume_state_event_matches(
            &s_listen_resume,
            nuwax_awake_session_state_generation(&s_awake_session),
            command->audio_session_id)) {
        ESP_LOGI(TAG,
                 "stale ASR event ignored event=%d audio_session=%s awake_generation=%lu bound_generation=%lu bound_audio_session=%s",
                 (int)command->event,
                 command->audio_session_id[0] ? command->audio_session_id : "-",
                 (unsigned long)nuwax_awake_session_state_generation(
                     &s_awake_session),
                 (unsigned long)s_listen_resume.awake_generation,
                 s_listen_resume.audio_session_id[0]
                     ? s_listen_resume.audio_session_id
                     : "-");
        return;
    }
    if (audio_input_event) {
        if (command->event == NUWAX_SESSION_EVENT_ASR_RESULT) {
            nuwax_listen_resume_state_disarm_post_end_asr(
                &s_listen_resume);
            s_consecutive_post_end_response_timeouts = 0U;
        } else {
            nuwax_listen_resume_state_refresh_post_end_asr(
                &s_listen_resume,
                monotonic_ms() +
                    NUWAX_POST_END_RESPONSE_TIMEOUT_MS);
        }
    }
    if (audio_input_event &&
        nuwax_head_touch_agent_intent_audio_matches(
            &s_head_touch_agent_intent,
            command->audio_session_id)) {
        const bool no_speech_result =
            command->event == NUWAX_SESSION_EVENT_ASR_RESULT &&
            !command->ok && is_no_speech_asr_error(command->error);
        const bool user_speech_event =
            command->event == NUWAX_SESSION_EVENT_ASR_PARTIAL ||
            command->event == NUWAX_SESSION_EVENT_ASR_FINAL ||
            (command->event == NUWAX_SESSION_EVENT_ASR_RESULT &&
             !no_speech_result);
        if (user_speech_event) {
            ESP_LOGI(TAG,
                     "head touch agent yielded to matching cloud speech event token=%lu event=%d session=%s",
                     (unsigned long)s_head_touch_agent_intent.token,
                     (int)command->event,
                     command->audio_session_id);
            clear_head_touch_agent_intent("matching_cloud_speech_won");
        } else if (no_speech_result) {
            ESP_LOGI(TAG,
                     "matching no-speech result retained head touch agent token=%lu session=%s",
                     (unsigned long)s_head_touch_agent_intent.token,
                     command->audio_session_id);
            return;
        }
    }
    switch (command->event) {
        case NUWAX_SESSION_EVENT_AUDIO_PROGRESS:
            note_conversation_cloud_progress(command->event);
            break;
        case NUWAX_SESSION_EVENT_ASR_PARTIAL:
            note_conversation_cloud_progress(command->event);
            pause_awake_waiting("asr_partial");
            metrics_mark_asr_partial();
            nuwax_listen_resume_state_set_short_audio(&s_listen_resume, false);
            ESP_LOGI(TAG,
                     "ASR PARTIAL seq=%d at_ms=%d text_len=%u",
                     command->sequence,
                     command->at_ms,
                     (unsigned)strlen(command->text));
            set_conversation_status_guarded("VOICE", "LISTENING", command->text, true);
            break;
        case NUWAX_SESSION_EVENT_ASR_FINAL:
            note_conversation_cloud_progress(command->event);
            pause_awake_waiting("asr_final");
            metrics_mark_asr_final();
            nuwax_listen_resume_state_set_short_audio(&s_listen_resume, false);
            ESP_LOGI(TAG,
                     "ASR FINAL seq=%d at_ms=%d text_len=%u",
                     command->sequence,
                     command->at_ms,
                     (unsigned)strlen(command->text));
            set_conversation_status_guarded("VOICE", "FINAL", command->text, true);
            break;
        case NUWAX_SESSION_EVENT_ASR_RESULT:
            note_conversation_cloud_progress(command->event);
            pause_awake_waiting("asr_result");
            if (!command->ok &&
                nuwax_listen_resume_state_has_short_audio(&s_listen_resume) &&
                is_no_speech_asr_error(command->error)) {
                ESP_LOGI(TAG,
                         "ASR no-speech ignored for filtered short auto-followup audio; resume listening");
                nuwax_listen_resume_state_set_short_audio(&s_listen_resume, false);
                if (!resume_prelisten_after_no_speech()) {
                    enter_sleeping_conversation_state("short_audio_no_speech");
                }
                break;
            }
            metrics_mark_asr_result(command->ok);
            ESP_LOGI(TAG,
                     "ASR RESULT ok=%d provider=%s text_len=%u error=%s",
                     command->ok ? 1 : 0,
                     command->provider[0] ? command->provider : "-",
                     (unsigned)strlen(command->text),
                     command->error);
            if (command->ok) {
                if (command->turn_id[0] == '\0') {
                    ESP_LOGE(TAG,
                             "ASR result missing required turn_id audio_session=%s; dropping result while retaining WebSocket",
                             command->audio_session_id[0]
                                 ? command->audio_session_id
                                 : "-");
                    clear_last_listen_resume();
                    if (!resume_awake_conversation_after_inactivity(
                            "asr_result_missing_turn_id")) {
                        enter_sleeping_conversation_state(
                            "asr_result_missing_turn_id");
                    }
                    break;
                }
                if (!begin_active_turn_guard(NULL,
                                             command->turn_id,
                                             NUWAX_CONVERSATION_TEXT_TIMEOUT_MS,
                                             "asr_result")) {
                    ESP_LOGE(TAG,
                             "ASR result could not establish an owned cloud turn; retaining WebSocket");
                    if (!resume_awake_conversation_after_inactivity(
                            "asr_result_turn_guard_failed")) {
                        enter_sleeping_conversation_state(
                            "asr_result_turn_guard_failed");
                    }
                    break;
                }
                if (!begin_conversation_visual_round(
                        NUWAX_VISUAL_ROUND_NORMAL,
                        NULL,
                        "asr_result")) {
                    clear_active_turn_guard("asr_visual_round_failed");
                    if (!resume_awake_conversation_after_inactivity(
                            "asr_visual_round_failed")) {
                        enter_sleeping_conversation_state(
                            "asr_visual_round_failed");
                    }
                    break;
                }
                clear_last_listen_resume();
                (void)enter_cloud_waiting_question("asr_result");
                set_conversation_status_guarded("VOICE TEXT", "THINKING", command->text, true);
            } else {
                if (is_no_speech_asr_error(command->error)) {
                    if (resume_prelisten_after_no_speech()) {
                        break;
                    }
                    ESP_LOGI(TAG, "ASR no-speech ignored; entering sleep");
                    enter_sleeping_conversation_state("asr_no_speech");
                    break;
                }
                clear_last_listen_resume();
                set_conversation_status_guarded("ASR ERROR", "ERROR", command->error[0] ? command->error : "ASR failed", true);
                const bool listening_published =
                    publish_listening_after_current_asr_failure("asr_error");
                if (!listening_published) {
                    break;
                }
                if (!resume_awake_conversation_after_inactivity("asr_error")) {
                    enter_sleeping_conversation_state("awake_idle_timeout");
                }
            }
            break;
        case NUWAX_SESSION_EVENT_TEXT_RESPONSE: {
            bool turn_bootstrapped = false;
            if (!ensure_active_turn_guard_for_cloud_output(
                    command, "text_response", &turn_bootstrapped) ||
                !active_turn_event_matches(
                    command,
                    (1UL << NUWAX_TURN_PHASE_WAIT_TEXT) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS_RETRY) |
                        (1UL << NUWAX_TURN_PHASE_PLAYING),
                    "text_response")) {
                if (turn_bootstrapped) {
                    clear_active_turn_guard(
                        "text_response_bootstrap_match_failed");
                }
                break;
            }
            const bool capture_will_stop =
                turn_bootstrapped &&
                atomic_load_explicit(
                    &s_conversation_capture_runtime_active,
                    memory_order_acquire);
            if (turn_bootstrapped) {
                note_conversation_cloud_turn_bootstrap(command->event);
            }
            const bool visual_matches = visual_round_command_matches(command);
            const nuwax_visual_round_kind_t visual_kind =
                visual_matches ? s_visual_round.kind
                               : NUWAX_VISUAL_ROUND_NONE;
            const bool matching_interaction_intent =
                s_head_touch_agent_intent.state ==
                    NUWAX_HEAD_TOUCH_AGENT_STATE_SENT &&
                command->request_id[0] != '\0' &&
                strcmp(command->request_id,
                       s_head_touch_agent_intent.request_id) == 0;
            const bool interaction_reply =
                visual_kind == NUWAX_VISUAL_ROUND_HEAD_TOUCH ||
                visual_kind == NUWAX_VISUAL_ROUND_SHAKE ||
                matching_interaction_intent;
            if (matching_interaction_intent) {
                /* The text result is only metadata. Keep the special owner
                 * until its generation-bound physical playback terminal. */
                ESP_LOGI(TAG,
                         "matching interaction text response retained visual owner kind=%s request=%s",
                         visual_round_kind_name(visual_kind),
                         command->request_id);
            } else if (turn_bootstrapped &&
                       s_head_touch_agent_intent.state !=
                           NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE) {
                clear_head_touch_agent_intent(
                    "cloud_user_turn_bootstrapped");
            }
            clear_last_listen_resume();
            s_consecutive_post_end_response_timeouts = 0U;
            if (s_turn_guard.turn_id[0]) {
                strlcpy(s_active_turn_id,
                        s_turn_guard.turn_id,
                        sizeof(s_active_turn_id));
            }
            pause_awake_waiting("text_response");
            metrics_mark_text_response();
            wake_greeting_metrics_mark_text_response(command->request_id, command->ok, command->tts_pending);
            ESP_LOGI(TAG,
                     "TEXT RESPONSE ok=%d request=%s emotion=%s text_len=%u error=%s",
                     command->ok ? 1 : 0,
                     command->request_id,
                     command->emotion[0] ? command->emotion : "-",
                     (unsigned)strlen(command->text),
                     command->error);
            if (command->ok) {
                const nuwax_turn_phase_t phase_before_text =
                    s_turn_guard.phase;
                if (command->emotion[0] != '\0') {
                    if (visual_kind == NUWAX_VISUAL_ROUND_NORMAL &&
                        nuwax_conversation_visual_round_hold_emotion(
                            &s_visual_round, command->emotion)) {
                        ESP_LOGI(TAG,
                                 "cloud emotion held until first PCM emotion=%s request=%s",
                                 command->emotion,
                                 command->request_id[0]
                                     ? command->request_id
                                     : "-");
                    } else if (visual_kind ==
                                   NUWAX_VISUAL_ROUND_WAKE_GREETING ||
                               interaction_reply) {
                        ESP_LOGI(TAG,
                                 "cloud emotion suppressed by visual owner kind=%s emotion=%s request=%s",
                                 visual_round_kind_name(visual_kind),
                                 command->emotion,
                                 command->request_id[0]
                                     ? command->request_id
                                     : "-");
                    } else {
                        apply_semantic_emotion_name(command->emotion,
                                                    "text_response");
                    }
                }
#if CONFIG_NUWAX_SPEAKER_ENABLE
                if (nuwax_speaker_playback_has_pending() || command->tts_pending) {
                    if (visual_kind == NUWAX_VISUAL_ROUND_NORMAL ||
                        visual_kind == NUWAX_VISUAL_ROUND_NONE) {
                        (void)enter_cloud_waiting_question(
                            "text_response_tts");
                    }
                    if (command->tts_pending &&
                        phase_before_text != NUWAX_TURN_PHASE_PLAYING) {
                        nuwax_speaker_playback_prepare_for_tts("text_response");
                    }
                    if (phase_before_text == NUWAX_TURN_PHASE_WAIT_TEXT) {
                        (void)set_active_turn_phase(
                            NUWAX_TURN_PHASE_WAIT_TTS,
                            NUWAX_CONVERSATION_TTS_TIMEOUT_MS);
                    }
                    /* TTS metadata is not physical playback. The speaker
                     * owner publishes SPEAKING only after the first I2S
                     * write for this generation succeeds. */
                    set_conversation_status_guarded(
                        "NUWAX",
                        visual_kind == NUWAX_VISUAL_ROUND_WAKE_GREETING
                            ? "WAKE_REPLY"
                            : interaction_reply ? "WAIT_REPLY" : "THINKING",
                        command->text,
                        true);
                } else {
                    set_conversation_status_guarded("NUWAX", "ANSWER", command->text, true);
                    clear_active_turn_guard("text_response_without_tts");
                    if (!schedule_auto_followup_after_cloud_output(
                            capture_will_stop,
                            "text_response_without_tts")) {
                        set_state(NUWAX_APP_STATE_IDLE);
                    }
                }
#else
                set_conversation_status_guarded("NUWAX", "ANSWER", command->text, true);
                clear_active_turn_guard("text_response_without_speaker");
                if (!schedule_auto_followup_after_cloud_output(
                        capture_will_stop,
                        "text_response_without_speaker")) {
                    set_state(NUWAX_APP_STATE_IDLE);
                }
#endif
            } else {
                clear_active_turn_guard("text_response_error");
                set_conversation_status_guarded("CLOUD ERROR",
                                                "ERROR",
                                                command->error[0] ? command->error : "text response failed",
                                                true);
                if (!schedule_auto_followup_after_cloud_output(
                        capture_will_stop,
                        "text_response_error")) {
                    set_state(NUWAX_APP_STATE_ERROR);
                }
            }
            break;
        }
        case NUWAX_SESSION_EVENT_TTS_SKIP:
            if (!command->ok ||
                strcmp(command->error, "voice_broadcast_disabled") != 0) {
                ESP_LOGW(TAG,
                         "invalid TTS skip ignored ok=%d request=%s turn=%s reason=%s",
                         command->ok ? 1 : 0,
                         command->request_id[0] ? command->request_id : "-",
                         command->turn_id[0] ? command->turn_id : "-",
                         command->error[0] ? command->error : "-");
                break;
            }
            const uint32_t tts_skip_awake_generation =
                nuwax_awake_session_state_generation(&s_awake_session);
            const bool turn_guard_owns_tts_skip =
                nuwax_turn_guard_accepts_tts_skip(
                    &s_turn_guard,
                    tts_skip_awake_generation,
                    command->request_id,
                    command->turn_id);
            bool direct_post_end_owns_tts_skip =
                !s_turn_guard.active && !s_sleep_transaction.active &&
                nuwax_listen_resume_state_can_bootstrap_cloud_turn(
                    &s_listen_resume,
                    tts_skip_awake_generation,
                    event_ws_epoch,
                    false);
#if CONFIG_NUWAX_SPEAKER_ENABLE
            direct_post_end_owns_tts_skip =
                direct_post_end_owns_tts_skip &&
                !s_playback_terminal_guard.active;
#endif
            if ((!turn_guard_owns_tts_skip &&
                 !direct_post_end_owns_tts_skip) ||
                (turn_guard_owns_tts_skip &&
                 !nuwax_turn_guard_bind_ids(&s_turn_guard,
                                            command->request_id,
                                            command->turn_id,
                                            NULL))) {
                ESP_LOGI(TAG,
                         "stale or unowned TTS skip ignored phase=%s request=%s/%s turn=%s/%s event_epoch=%lu bound_epoch=%lu post_end=%d",
                         nuwax_turn_phase_name(s_turn_guard.phase),
                         command->request_id[0] ? command->request_id : "-",
                         s_turn_guard.request_id[0]
                             ? s_turn_guard.request_id
                             : "-",
                         command->turn_id[0] ? command->turn_id : "-",
                         s_turn_guard.turn_id[0] ? s_turn_guard.turn_id : "-",
                         (unsigned long)event_ws_epoch,
                         (unsigned long)nuwax_listen_resume_state_ws_epoch(
                             &s_listen_resume),
                         nuwax_listen_resume_state_is_waiting_post_end_asr(
                             &s_listen_resume)
                             ? 1
                             : 0);
                break;
            }
            nuwax_tts_skip_prebound_emotion_t prebound_emotion = {0};
            const bool has_prebound_emotion =
                take_tts_skip_prebound_emotion(
                    command,
                    event_ws_epoch,
                    tts_skip_awake_generation,
                    direct_post_end_owns_tts_skip,
                    &prebound_emotion);
            pause_awake_waiting("tts_skip");
            s_natural_playback_touch_protection_deadline_ms = 0U;
            ESP_LOGI(TAG,
                     "TTS skipped for current turn source=%s request=%s turn=%s reason=%s epoch=%lu; resuming conversation without playback",
                     direct_post_end_owns_tts_skip ? "direct_post_end"
                                                   : "turn_guard",
                     s_turn_guard.request_id[0]
                         ? s_turn_guard.request_id
                         : "-",
                     s_turn_guard.turn_id[0] ? s_turn_guard.turn_id : "-",
                     command->error,
                     (unsigned long)event_ws_epoch);
            if (s_head_touch_agent_intent.state !=
                    NUWAX_HEAD_TOUCH_AGENT_STATE_IDLE &&
                s_turn_guard.request_id[0] != '\0' &&
                strcmp(s_turn_guard.request_id,
                       s_head_touch_agent_intent.request_id) == 0) {
                clear_head_touch_agent_intent("tts_skip");
            }
            const bool tts_skip_capture_will_stop =
                atomic_load_explicit(&s_conversation_capture_runtime_active,
                                     memory_order_acquire);
            clear_last_listen_resume();
            s_consecutive_post_end_response_timeouts = 0U;
            clear_active_turn_guard("tts_skip");
            arm_tts_skip_emotion_window(event_ws_epoch,
                                        tts_skip_awake_generation);
            arm_tts_skip_followup(tts_skip_capture_will_stop);
            set_conversation_status_guarded(
                "VOICE", "WAIT_REPLY", "emotion", true);
            ESP_LOGI(TAG,
                     "TTS skip waiting for cloud emotion before new listening round");
            if (has_prebound_emotion) {
                uint32_t lease_ms = prebound_emotion.has_duration_ms
                                        ? prebound_emotion.duration_ms
                                        : NUWAX_TTS_SKIP_EMOTION_DEFAULT_LEASE_MS;
                if (lease_ms < NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS) {
                    lease_ms = NUWAX_TTS_SKIP_EMOTION_DISPLAY_HOLD_MS;
                }
                const bool accepted = apply_semantic_emotion_name_leased(
                    prebound_emotion.emotion,
                    "device_command_tts_skip",
                    lease_ms);
                if (accepted) {
                    ESP_LOGI(TAG,
                             "prebound cloud emotion accepted for tts_skip emotion=%s turn=%s lease_ms=%lu",
                             prebound_emotion.emotion,
                             prebound_emotion.turn_id,
                             (unsigned long)lease_ms);
                    note_tts_skip_emotion_accepted();
                } else {
                    ESP_LOGW(TAG,
                             "prebound cloud emotion could not be published for tts_skip emotion=%s turn=%s",
                             prebound_emotion.emotion,
                             prebound_emotion.turn_id);
                }
            }
            break;
        case NUWAX_SESSION_EVENT_TTS_RESULT:
            if (!active_turn_event_matches(
                    command,
                    (1UL << NUWAX_TURN_PHASE_WAIT_TEXT) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS_RETRY) |
                        (1UL << NUWAX_TURN_PHASE_PLAYING),
                    "tts_result")) {
                break;
            }
            pause_awake_waiting("tts_result");
            ESP_LOGI(TAG,
                     "TTS EVENT ok=%d provider=%s playback=%s frames=%d playback_start=%d playback_end=%d error=%s",
                     command->ok ? 1 : 0,
                     command->provider[0] ? command->provider : "-",
                     command->playback_id[0] ? command->playback_id : "-",
                     command->tts_frames,
                     command->playback_start ? 1 : 0,
                     command->playback_end ? 1 : 0,
                     command->error);
            if (command->ok) {
                /* tts_result is synthesis metadata only. playback_begin/end
                 * own the logical lifecycle and binary START/END own stream
                 * framing. Treating these legacy summary flags as terminal
                 * can end a batch before playback_begin is even delivered. */
                if (s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TEXT) {
                    (void)set_active_turn_phase(
                        NUWAX_TURN_PHASE_WAIT_TTS,
                        NUWAX_CONVERSATION_TTS_TIMEOUT_MS);
                } else if (s_turn_guard.phase == NUWAX_TURN_PHASE_WAIT_TTS) {
                    (void)set_active_turn_phase(
                        NUWAX_TURN_PHASE_WAIT_TTS,
                        NUWAX_CONVERSATION_TTS_TIMEOUT_MS);
                }
                break;
            }
            if (!command->ok) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
                bool playback_error_held = false;
                if (s_playback_terminal_guard.active &&
                    s_playback_terminal_guard.speaker_generation != 0U) {
                    const uint32_t now_ms = monotonic_ms();
                    playback_error_held =
                        nuwax_playback_terminal_guard_mark_fault(
                            &s_playback_terminal_guard,
                            active_ws_epoch_snapshot(),
                            s_playback_terminal_guard.speaker_generation,
                            now_ms,
                            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
                    if (playback_error_held) {
                        (void)nuwax_playback_terminal_guard_mark_logical_end(
                            &s_playback_terminal_guard,
                            active_ws_epoch_snapshot(),
                            s_playback_terminal_guard.turn_id,
                            s_playback_terminal_guard.playback_id,
                            false);
                        (void)set_active_turn_phase(
                            NUWAX_TURN_PHASE_DRAINING,
                            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
                        s_speaker_fault_recovery_epoch =
                            s_playback_terminal_guard.connection_epoch;
                        s_speaker_fault_recovery_generation =
                            s_playback_terminal_guard.speaker_generation;
                        (void)nuwax_speaker_playback_request_cancel_generation(
                            s_speaker_fault_recovery_generation,
                            "tts_error",
                            0U);
                        ESP_LOGW(TAG,
                                 "TTS error joined playback terminal barrier; holding listen until physical stop generation=%lu",
                                 (unsigned long)s_speaker_fault_recovery_generation);
                    }
                }
                if (playback_error_held) {
                    set_conversation_status_guarded("TTS ERROR",
                                                    "DRAINING",
                                                    command->error[0]
                                                        ? command->error
                                                        : "tts failed",
                                                    true);
                    break;
                }
#endif
                if (arm_metadata_playback_retry(command,
                                                 "tts_result_error")) {
#if CONFIG_NUWAX_SPEAKER_ENABLE
                    (void)nuwax_speaker_playback_abort_metadata_only_session(
                        command->turn_id,
                        command->playback_id,
                        "tts_result_error_retry");
#endif
                    break;
                }
                clear_active_turn_guard("tts_error");
                set_conversation_status_guarded("TTS ERROR",
                                                "LISTENING",
                                                command->error[0] ? command->error : "tts failed",
                                                true);
                if (!schedule_auto_followup_after_playback()) {
                    set_state(NUWAX_APP_STATE_IDLE);
                }
            }
            break;
        case NUWAX_SESSION_EVENT_PLAYBACK_BEGIN: {
            if (command->rx_playback_rejected) {
                if (event_ws_epoch == active_ws_epoch_snapshot() &&
                    nuwax_turn_guard_accepts_rx_rejection(
                        &s_turn_guard,
                        nuwax_awake_session_state_generation(&s_awake_session),
                        command->request_id, command->turn_id,
                        command->playback_id)) {
                    ESP_LOGW(TAG,
                             "owned playback RX rejected; ending unstarted round request=%s turn=%s playback=%s reason=rx_stream_quarantined",
                             command->request_id, command->turn_id,
                             command->playback_id);
                    clear_last_listen_resume();
                    wake_greeting_metrics_cancel("rx_stream_quarantined");
                    clear_active_turn_guard("rx_stream_quarantined");
                    if (!schedule_auto_followup_after_playback()) {
                        set_state(NUWAX_APP_STATE_IDLE);
                    }
                }
                /* Never bootstrap, admit binary, or cancel a playing owner.
                 * Existing END/epoch/timeout logic retains drain ownership. */
                break;
            }
            s_natural_playback_touch_protection_deadline_ms = 0U;
            bool turn_bootstrapped = false;
            if (!ensure_active_turn_guard_for_cloud_output(
                    command, "playback_begin", &turn_bootstrapped) ||
                !active_turn_event_matches(
                    command,
                    (1UL << NUWAX_TURN_PHASE_WAIT_TEXT) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS_RETRY) |
                    (1UL << NUWAX_TURN_PHASE_PLAYING),
                    "playback_begin")) {
                if (turn_bootstrapped) {
                    clear_active_turn_guard(
                        "playback_begin_bootstrap_match_failed");
                }
                notification_rx_barrier_reject_normal_epoch(
                    active_ws_epoch_snapshot(),
                    command->turn_id,
                    command->playback_id,
                    "normal_playback_begin_stale");
                break;
            }
            if (!notification_rx_barrier_admit_normal_epoch(
                    active_ws_epoch_snapshot(),
                    command->turn_id,
                    command->playback_id)) {
                ESP_LOGI(TAG,
                         "normal playback BEGIN was superseded before RX commit turn=%s playback=%s; selected cloud audio owner retained",
                         command->turn_id,
                         command->playback_id);
                if (turn_bootstrapped) {
                    clear_active_turn_guard(
                        "normal_playback_begin_superseded");
                }
                break;
            }
            if (turn_bootstrapped) {
                note_conversation_cloud_turn_bootstrap(command->event);
                clear_last_listen_resume();
                s_consecutive_post_end_response_timeouts = 0U;
            }
            (void)set_active_turn_phase(
                NUWAX_TURN_PHASE_PLAYING,
                NUWAX_CONVERSATION_PLAYBACK_INGRESS_IDLE_TIMEOUT_MS);
            pause_awake_waiting("playback_begin");
            ESP_LOGI(TAG,
                     "PLAYBACK BEGIN turn=%s playback=%s frames=%d bytes=%d sample_rate=%d channels=%d",
                     command->turn_id[0] ? command->turn_id : "-",
                     command->playback_id[0] ? command->playback_id : "-",
                     command->tts_frames,
                     command->playback_bytes,
                     command->playback_sample_rate,
                     command->playback_channels);
#if CONFIG_NUWAX_SPEAKER_ENABLE
            nuwax_speaker_playback_note_playback_begin(command->turn_id,
                                                       command->playback_id,
                                                       (uint32_t)command->tts_frames,
                                                       (uint32_t)command->playback_bytes);
            if (s_turn_guard.speaker_generation != 0U) {
                (void)authorize_speaker_generation_for_active_turn(
                    s_turn_guard.speaker_generation,
                    "playback_begin");
            }
#endif
            request_during_playback_capture("playback_begin", true);
            break;
        }
        case NUWAX_SESSION_EVENT_PLAYBACK_END:
            if (!active_turn_event_matches(
                    command,
                    (1UL << NUWAX_TURN_PHASE_PLAYING) |
                        (1UL << NUWAX_TURN_PHASE_WAIT_TTS_RETRY) |
                        (1UL << NUWAX_TURN_PHASE_DRAINING),
                    "playback_end")) {
                break;
            }
            ESP_LOGI(TAG,
                     "PLAYBACK END turn=%s playback=%s reason=%s frames=%d bytes=%d",
                     command->turn_id[0] ? command->turn_id : "-",
                     command->playback_id[0] ? command->playback_id : "-",
                     command->playback_reason[0] ? command->playback_reason : "-",
                     command->tts_frames,
                     command->playback_bytes);
#if CONFIG_NUWAX_SPEAKER_ENABLE
            if (!join_cloud_playback_logical_end(command,
                                                 "cloud_playback_end")) {
                break;
            }
#endif
            break;
        case NUWAX_SESSION_EVENT_CANCEL_TURN_ACK: {
            const uint32_t connection_epoch = active_ws_epoch_snapshot();
            if (nuwax_head_touch_agent_intent_apply_cancel_ack(
                    &s_head_touch_agent_intent,
                    connection_epoch,
                    command->request_id,
                    command->turn_id,
                    command->ok)) {
                ESP_LOGI(TAG,
                         "matching interaction cloud-wait cancel_turn_ack received epoch=%lu request=%s turn=%s ok=%d",
                         (unsigned long)connection_epoch,
                         command->request_id[0] ? command->request_id : "-",
                         command->turn_id[0] ? command->turn_id : "-",
                         command->ok ? 1 : 0);
                break;
            }
#if CONFIG_NUWAX_SPEAKER_ENABLE
            if (nuwax_touch_cancel_recovery_mark_ack(
                    &s_touch_cancel_recovery,
                    connection_epoch,
                    command->request_id,
                    command->turn_id,
                    command->playback_id,
                    command->ok)) {
                if (s_head_touch_agent_intent.source ==
                        NUWAX_HEAD_TOUCH_AGENT_SOURCE_PLAYBACK &&
                    s_head_touch_agent_intent.ws_epoch == connection_epoch &&
                    s_head_touch_agent_intent.speaker_generation ==
                        s_touch_cancel_recovery.speaker_generation) {
                    (void)nuwax_head_touch_agent_intent_mark_cancel_ack(
                        &s_head_touch_agent_intent,
                        command->ok);
                }
                ESP_LOGI(TAG,
                         "matching touch cancel_turn_ack received epoch=%lu generation=%lu request=%s turn=%s playback=%s ok=%d; local recovery remains bound to physical stop",
                         (unsigned long)connection_epoch,
                         (unsigned long)s_touch_cancel_recovery
                             .speaker_generation,
                         command->request_id[0]
                             ? command->request_id
                             : "-",
                         command->turn_id[0] ? command->turn_id : "-",
                         command->playback_id[0]
                             ? command->playback_id
                             : "-",
                         command->ok ? 1 : 0);
                break;
            }
            const nuwax_playback_cancel_ack_result_t ack_result =
                nuwax_playback_terminal_guard_apply_cancel_ack(
                    &s_playback_terminal_guard,
                    connection_epoch,
                    command->request_id,
                    command->turn_id,
                    command->playback_id,
                    command->ok);
            if (ack_result == NUWAX_PLAYBACK_CANCEL_ACK_UNMATCHED) {
                ESP_LOGI(TAG,
                         "stale cancel_turn_ack ignored epoch=%lu request=%s turn=%s playback=%s",
                         (unsigned long)connection_epoch,
                         command->request_id[0] ? command->request_id : "-",
                         command->turn_id[0] ? command->turn_id : "-",
                         command->playback_id[0]
                             ? command->playback_id
                             : "-");
                break;
            }
            if (ack_result == NUWAX_PLAYBACK_CANCEL_ACK_REJECTED) {
                ESP_LOGW(TAG,
                         "matching cancel_turn_ack rejected epoch=%lu request=%s turn=%s; old playback remains quarantined and WebSocket is retained",
                         (unsigned long)connection_epoch,
                         command->request_id[0] ? command->request_id : "-",
                         command->turn_id);
                break;
            }
            ESP_LOGI(TAG,
                     "matching cancel_turn_ack joined terminal barrier epoch=%lu generation=%lu request=%s turn=%s physical_done=%d",
                     (unsigned long)connection_epoch,
                     (unsigned long)s_playback_terminal_guard
                         .speaker_generation,
                     command->request_id[0] ? command->request_id : "-",
                     command->turn_id,
                     s_playback_terminal_guard.physical_done ? 1 : 0);
            (void)finalize_playback_terminal_if_ready(
                "cloud_cancel_turn_ack");
#endif
            break;
        }
        case NUWAX_SESSION_EVENT_NONE:
        default:
            break;
    }
}

static void session_dispatch_set_active_turn_id(void *ctx, const char *turn_id) {
    (void)ctx;
    strlcpy(s_active_turn_id, turn_id, sizeof(s_active_turn_id));
}

static bool session_dispatch_queue_wifi_connect(void *ctx,
                                                const char *ssid,
                                                const char *password,
                                                const char *request_id) {
    (void)ctx;
    wifi_connect_request_t request = {0};
    strlcpy(request.ssid, ssid, sizeof(request.ssid));
    strlcpy(request.password, password, sizeof(request.password));
    strlcpy(request.request_id, request_id, sizeof(request.request_id));
    request.use_saved_index = false;
    request.saved_index = -1;
    if (!s_wifi_connect_requests || xQueueSend(s_wifi_connect_requests, &request, 0) != pdTRUE) {
        return false;
    }
    nuwax_app_shell_set_wifi_connecting(ssid);
    return true;
}

static bool session_dispatch_request_wifi_scan(void *ctx,
                                               uint32_t ws_epoch,
                                               const char *request_id) {
    (void)ctx;
    return request_wifi_scan(ws_epoch, request_id);
}

static bool session_dispatch_request_ble_reprovision(void *ctx) {
    (void)ctx;
    return queue_ble_reprovision_request("remote_command");
}

#if CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE
static void p3_softref_ab_fast_task(void *arg) {
    (void)arg;
    p3_softref_ab_request_t request = {0};
    while (true) {
        if (!s_p3_softref_ab_requests ||
            xQueueReceive(s_p3_softref_ab_requests, &request, portMAX_DELAY) != pdTRUE) {
            continue;
        }
        const uint32_t active_epoch = active_ws_epoch_snapshot();
        if (request.ws_connection_epoch == 0U ||
            request.ws_connection_epoch != active_epoch) {
            ESP_LOGI(TAG,
                     "stale P3 softref request ignored request=%s event_epoch=%lu active_epoch=%lu",
                     request.request_id,
                     (unsigned long)request.ws_connection_epoch,
                     (unsigned long)active_epoch);
            memset(&request, 0, sizeof(request));
            continue;
        }

        bool ready = false;
        ESP_LOGW(TAG,
                 "P3-0S fast A/B start request=%s duration_ms=%lu delay_samples=%lu",
                 request.request_id,
                 (unsigned long)request.duration_ms,
                 (unsigned long)request.delay_samples);
        esp_err_t err = run_p3_softref_ab_manual(request.duration_ms,
                                                request.delay_samples,
                                                &ready);
        ESP_LOGW(TAG,
                 "P3-0S fast A/B done request=%s err=%s ready=%d",
                 request.request_id,
                 esp_err_to_name(err),
                 ready ? 1 : 0);
        memset(&request, 0, sizeof(request));
    }
}
#endif

#if CONFIG_NUWAX_P5_DURING_PLAYBACK_CANDIDATE_ENABLE
static void p5_during_playback_candidate_fast_task(void *arg) {
    (void)arg;
    p5_during_playback_candidate_request_t request = {0};
    while (true) {
        if (!s_p5_during_playback_candidate_requests ||
            xQueueReceive(s_p5_during_playback_candidate_requests, &request, portMAX_DELAY) != pdTRUE) {
            continue;
        }

        uint32_t active_epoch = 0U;
        nuwax_ws_client_t *ws = active_ws_snapshot(&active_epoch);
        if (!ws || request.ws_connection_epoch == 0U ||
            request.ws_connection_epoch != active_epoch) {
            ESP_LOGI(TAG,
                     "stale P5 candidate request ignored request=%s event_epoch=%lu active_epoch=%lu",
                     request.request_id,
                     (unsigned long)request.ws_connection_epoch,
                     (unsigned long)active_epoch);
            memset(&request, 0, sizeof(request));
            continue;
        }

        const uint32_t started_ms = monotonic_ms();
        bool candidate = false;
        bool cancel_sent = false;
        bool passed = false;
        esp_err_t err = ESP_ERR_INVALID_STATE;
        ESP_LOGW(TAG,
                 "P5-3 fast candidate start mode=%s request=%s audio_session_id=%s duration_ms=%lu delay_samples=%lu",
                 request.mode,
                 request.request_id,
                 request.audio_session_id[0] ? request.audio_session_id : "-",
                 (unsigned long)request.duration_ms,
                 (unsigned long)request.delay_samples);

        if (!ws || !nuwax_ws_is_connected(ws)) {
            ESP_LOGW(TAG,
                     "P5-3 fast candidate rejected: ws unavailable request=%s",
                     request.request_id);
        } else {
            err = run_p5_during_playback_candidate_manual(ws,
                                                          request.ws_connection_epoch,
                                                          request.mode,
                                                          request.request_id,
                                                          request.audio_session_id,
                                                          request.duration_ms,
                                                          request.delay_samples,
                                                          &candidate,
                                                          &cancel_sent,
                                                          &passed);
        }

        /* P6-GRAYCONFIRM-003-2A: gray_confirm ack 表示命令执行完成,不需要 passed=true */
        const bool gray_confirm_mode = strcmp(request.mode, "gray_confirm") == 0;
        const bool gray_cancel_mode  = strcmp(request.mode, "gray_cancel") == 0;
        const bool ack_ok = err == ESP_OK &&
                            (gray_confirm_mode ||
                             passed ||
                             (gray_cancel_mode && cancel_sent));
        char message[192];
        snprintf(message,
                 sizeof(message),
                 "err=%s mode=%s passed=%d candidate=%d cancel_sent=%d duration_ms=%lu delay_samples=%lu audio_session_id=%s",
                 esp_err_to_name(err),
                 request.mode,
                 passed ? 1 : 0,
                 candidate ? 1 : 0,
                 cancel_sent ? 1 : 0,
                 (unsigned long)request.duration_ms,
                 (unsigned long)request.delay_samples,
                 request.audio_session_id[0] ? request.audio_session_id : "-");

        ws = active_ws_snapshot(&active_epoch);
        if (ws && active_epoch == request.ws_connection_epoch &&
            nuwax_ws_is_connected(ws)) {
            ESP_ERROR_CHECK_WITHOUT_ABORT(
                nuwax_session_send_command_ack_until_if_epoch(
                    ws,
                    request.request_id,
                    "p5_during_playback_candidate",
                    ack_ok,
                    message,
                    esp_timer_get_time() +
                        NUWAX_ASYNC_WS_CONTROL_SEND_TIMEOUT_US,
                    request.ws_connection_epoch));
        }

        ESP_LOGW(TAG,
                 "P5-3 fast candidate done request=%s err=%s candidate=%d cancel_sent=%d passed=%d ack_ok=%d elapsed_ms=%lu",
                 request.request_id,
                 esp_err_to_name(err),
                 candidate ? 1 : 0,
                 cancel_sent ? 1 : 0,
                 passed ? 1 : 0,
                 ack_ok ? 1 : 0,
                 (unsigned long)(monotonic_ms() - started_ms));
        memset(&request, 0, sizeof(request));
    }
}
#endif

static void session_dispatch_cancel_auto_followup_capture(void *ctx, const char *reason) {
    (void)ctx;
    cancel_auto_followup_capture(reason);
}

static nuwax_sleep_request_result_t
session_dispatch_request_sleep_transaction(void *ctx,
                                           nuwax_ws_client_t *ws,
                                           const char *request_id,
                                           const char *command,
                                           const char *turn_id) {
    (void)ctx;
    if (nuwax_notification_blocks_conversation(
            &s_notification_transaction)) {
        ESP_LOGW(TAG,
                 "sleep command rejected while notification transaction owns audio request=%s notify=%s",
                 request_id ? request_id : "-",
                 s_notification_transaction.notify_id[0]
                     ? s_notification_transaction.notify_id
                     : "-");
        return NUWAX_SLEEP_REQUEST_BUSY;
    }
    if (nuwax_meeting_mode_has_pending(&s_meeting_mode) ||
        nuwax_monitoring_mode_has_pending(&s_monitoring_mode)) {
        ESP_LOGW(TAG,
                 "sleep command rejected while exclusive audio mode owns lifecycle request=%s meeting=%d monitoring=%d",
                 request_id ? request_id : "-",
                 (int)nuwax_meeting_mode_state(&s_meeting_mode),
                 (int)nuwax_monitoring_mode_state(&s_monitoring_mode));
        return NUWAX_SLEEP_REQUEST_BUSY_EXCLUSIVE;
    }
    return request_remote_sleep_transaction(ws,
                                            request_id,
                                            command,
                                            turn_id);
}

static bool session_dispatch_speaker_has_pending(void *ctx) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    return nuwax_speaker_playback_has_pending();
#else
    return false;
#endif
}

static bool session_dispatch_speaker_playback_matches(void *ctx,
                                                      const char *turn_id,
                                                      const char *playback_id) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    const char *expected_turn = turn_id ? turn_id : "";
    const char *expected_playback = playback_id ? playback_id : "";
    if (expected_turn[0] == '\0' && expected_playback[0] == '\0') {
        return true;
    }
    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    if (expected_turn[0] != '\0' &&
        (stats.active_turn_id[0] == '\0' ||
         strcmp(expected_turn, stats.active_turn_id) != 0)) {
        return false;
    }
    if (expected_playback[0] != '\0' &&
        (stats.active_playback_id[0] == '\0' ||
         strcmp(expected_playback, stats.active_playback_id) != 0)) {
        return false;
    }
#endif
    return true;
}

static bool session_dispatch_active_turn_matches_playback(
    void *ctx,
    const char *turn_id,
    const char *playback_id) {
    (void)ctx;
    if (!s_turn_guard.active) {
        return true;
    }
    return nuwax_turn_guard_matches(
        &s_turn_guard,
        nuwax_awake_session_state_generation(&s_awake_session),
        NULL,
        turn_id,
        playback_id);
}

static nuwax_session_playback_stop_result_t
session_dispatch_speaker_cancel_matching_playback(
    void *ctx,
    const char *turn_id,
    const char *playback_id,
    const char *reason) {
    (void)ctx;
#if CONFIG_NUWAX_SPEAKER_ENABLE
    if (!session_dispatch_speaker_playback_matches(NULL,
                                                   turn_id,
                                                   playback_id)) {
        return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
    }
    if (nuwax_speaker_playback_abort_metadata_only_session(
            turn_id,
            playback_id,
            reason ? reason : "scoped_stop_playback_metadata_only")) {
        (void)update_normal_downlink_admission(false);
        ESP_LOGI(TAG,
                 "scoped stop_playback closed metadata-only session turn=%s playback=%s; late binary admission disabled",
                 turn_id ? turn_id : "-",
                 playback_id ? playback_id : "-");
        return NUWAX_SESSION_PLAYBACK_STOP_CANCEL_ARMED;
    }
    nuwax_speaker_playback_stats_t stats = {0};
    nuwax_speaker_playback_get_stats(&stats);
    uint32_t generation = 0U;
    uint32_t generation_epoch = 0U;
    if (stats.playback_active || stats.playback_session_active ||
        stats.stop_in_progress) {
        generation = stats.playback_generation;
        generation_epoch = stats.playback_connection_epoch;
        if (generation_epoch == 0U &&
            generation == stats.submitted_generation) {
            generation_epoch = stats.submitted_connection_epoch;
        }
    }
    if (generation == 0U &&
        (stats.start_gate_pending || stats.start_gate_authorized)) {
        generation = stats.start_gate_generation;
        generation_epoch = stats.start_gate_connection_epoch;
    }
    if (generation == 0U && stats.rx_stream_active) {
        generation = stats.submitted_generation;
        generation_epoch = stats.submitted_connection_epoch;
    }
    if (generation == 0U) {
        return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
    }
    const uint32_t active_epoch = active_ws_epoch_snapshot();
    if (active_epoch == 0U || generation_epoch != active_epoch) {
        ESP_LOGW(TAG,
                 "scoped stop_playback rejected stale speaker epoch active=%lu speaker=%lu generation=%lu turn=%s playback=%s",
                 (unsigned long)active_epoch,
                 (unsigned long)generation_epoch,
                 (unsigned long)generation,
                 turn_id ? turn_id : "-",
                 playback_id ? playback_id : "-");
        return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
    }
    const bool preserve_natural_drain =
        (!reason || strcmp(reason, "stale_stop_playback") != 0) &&
        nuwax_playback_terminal_guard_natural_drain_matches(
            &s_playback_terminal_guard,
            active_epoch,
            generation,
            turn_id,
            playback_id);
    nuwax_speaker_cancel_request_result_t cancel = {0};
    if (!nuwax_speaker_playback_request_scoped_stop_generation_ex(
            active_epoch,
            generation,
            preserve_natural_drain,
            reason ? reason : "scoped_stop_playback",
            15U,
            &cancel)) {
        return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
    }
    if (cancel.status ==
        NUWAX_SPEAKER_CANCEL_REQUEST_NATURAL_DRAINING) {
        ESP_LOGI(TAG,
                 "scoped stop_playback acknowledged during natural drain epoch=%lu generation=%lu turn=%s playback=%s queued=%lu played=%lu",
                 (unsigned long)active_epoch,
                 (unsigned long)generation,
                 turn_id ? turn_id : "-",
                 playback_id ? playback_id : "-",
                 (unsigned long)stats.queued_frames,
                 (unsigned long)stats.played_frames);
        return NUWAX_SESSION_PLAYBACK_STOP_NATURAL_DRAINING;
    }
    const uint32_t connection_epoch =
        cancel.connection_epoch != 0U
            ? cancel.connection_epoch
            : active_ws_epoch_snapshot();
    if (s_playback_terminal_guard.active &&
        !nuwax_playback_terminal_guard_mark_committed_stop(
            &s_playback_terminal_guard,
            connection_epoch,
            generation,
            turn_id,
            playback_id)) {
        ESP_LOGE(TAG,
                 "scoped stop_playback could not bind terminal guard epoch=%lu generation=%lu turn=%s playback=%s",
                 (unsigned long)connection_epoch,
                 (unsigned long)generation,
                 turn_id ? turn_id : "-",
                 playback_id ? playback_id : "-");
        nuwax_ws_client_t *ws = active_ws_snapshot(NULL);
        if (ws) {
            (void)nuwax_ws_request_close_if_epoch(ws, connection_epoch);
        }
        return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
    }
    if (cancel.status == NUWAX_SPEAKER_CANCEL_REQUEST_COMPLETED &&
        cancel.completed_stop_result == ESP_OK &&
        s_playback_terminal_guard.active) {
        (void)nuwax_playback_terminal_guard_mark_physical_done(
            &s_playback_terminal_guard,
            connection_epoch,
            generation,
            false,
            monotonic_ms(),
            NUWAX_PLAYBACK_TERMINAL_WAIT_TIMEOUT_MS);
        (void)finalize_playback_terminal_if_ready(
            "scoped_stop_completed_before_dispatch");
    }
    return NUWAX_SESSION_PLAYBACK_STOP_CANCEL_ARMED;
#else
    (void)turn_id;
    (void)playback_id;
    (void)reason;
    return NUWAX_SESSION_PLAYBACK_STOP_REJECTED;
#endif
}

