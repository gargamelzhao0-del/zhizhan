                 "P3-0H hardref AEC A/B running without active speaker playback; expect ready=0 unless slot2 carries recent playback energy");
    }
#endif
    nuwax_p3_softref_aec_ab_result_t result = {0};
    esp_err_t err = nuwax_p3_hardref_aec_ab_run(duration_ms, &result);
