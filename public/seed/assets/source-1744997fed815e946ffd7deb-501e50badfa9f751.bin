static bool ui_ready_snapshot(void) {
    return atomic_load_explicit(&s_ui_ready, memory_order_acquire);
}

static void ui_ready_store(bool ready) {
    const bool previous = atomic_exchange_explicit(
        &s_ui_ready, ready, memory_order_acq_rel);
    if (previous != ready) {
        atomic_fetch_add_explicit(&s_ui_lifecycle_generation,
                                  1U,
                                  memory_order_release);
    }
}

static nuwax_ws_client_t *active_ws_snapshot(uint32_t *out_epoch) {
    for (;;) {
        const uint32_t epoch_before = (uint32_t)atomic_load_explicit(
            &s_active_ws_epoch, memory_order_acquire);
        nuwax_ws_client_t *ws = atomic_load_explicit(
            &s_active_ws, memory_order_acquire);
        const uint32_t epoch_after = (uint32_t)atomic_load_explicit(
            &s_active_ws_epoch, memory_order_acquire);
        if (epoch_before != epoch_after) {
            continue;
        }
        if (out_epoch) {
            *out_epoch = epoch_before;
        }
        if (!ws || epoch_before == 0U ||
            nuwax_ws_connection_epoch(ws) != epoch_before) {
            return NULL;
        }
        return ws;
    }
}

static uint32_t active_ws_epoch_snapshot(void) {
    uint32_t epoch = 0U;
    (void)active_ws_snapshot(&epoch);
    return epoch;
}

static void notify_conversation_owner(void) {
    TaskHandle_t owner = atomic_load_explicit(
        &s_conversation_owner_task, memory_order_acquire);
    if (owner) {
        xTaskNotifyGive(owner);
    }
}

static void power_key_event_listener(void *ctx,
                                     nuwax_power_key_event_t event) {
    (void)ctx;
    if ((unsigned)event > (unsigned)NUWAX_POWER_KEY_EVENT_LONG_RELEASE) {
        return;
    }
    atomic_fetch_or_explicit(
        &s_power_key_events,
        1U << (unsigned)event,
        memory_order_release);
    notify_conversation_owner();
}

static void conversation_owner_wait_ms(uint32_t timeout_ms) {
    TickType_t wait_ticks = pdMS_TO_TICKS(timeout_ms);
    if (wait_ticks == 0U) {
        wait_ticks = 1U;
    }
    (void)ulTaskNotifyTake(pdTRUE, wait_ticks);
}

static void notify_ui_owner(void) {
    TaskHandle_t owner = atomic_load_explicit(
        &s_ui_owner_task, memory_order_acquire);
    if (owner) {
        xTaskNotifyGive(owner);
    }
}

static void ui_owner_wait_ms(uint32_t timeout_ms) {
    TickType_t wait_ticks = pdMS_TO_TICKS(timeout_ms);
    if (wait_ticks == 0U) {
        wait_ticks = 1U;
    }
    (void)ulTaskNotifyTake(pdTRUE, wait_ticks);
}

static void publish_active_ws(nuwax_ws_client_t *ws) {
    const uint32_t epoch = nuwax_ws_connection_epoch(ws);
    if (!ws || epoch == 0U) {
        ESP_LOGE(TAG, "refusing to publish WebSocket without connection epoch");
        return;
    }
    atomic_store_explicit(&s_active_ws, ws, memory_order_release);
    atomic_store_explicit(&s_active_ws_epoch, epoch, memory_order_release);
}

static void unpublish_active_ws(void) {
    atomic_store_explicit(&s_active_ws_epoch, 0U, memory_order_release);
    atomic_store_explicit(&s_active_ws, NULL, memory_order_release);
}

