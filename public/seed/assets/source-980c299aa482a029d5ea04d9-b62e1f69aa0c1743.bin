# Miaopan 2.0 normal business firmware with battery UI and application OTA.
# Production routing. The SD test overlay may explicitly override these.
# CONFIG_NUWAX_TEST_PANEL_ENABLE is not set
# CONFIG_NUWAX_TEST_NETWORK_ENABLE is not set
# CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_TEST_ENABLE is not set
CONFIG_NUWAX_OFFLINE_AUDIO_REPLAY_FORMAL_ENABLE=y
# This overlay deliberately disables the isolated hardware/AEC diagnostics
# that stop before Wi-Fi and WebSocket startup.
# CONFIG_NUWAX_P1_HW_DIAG_MODE is not set
# CONFIG_NUWAX_P2_AUDIO_SMOKE_MODE is not set
# CONFIG_NUWAX_HW_ACCEPTANCE_MODE is not set
# CONFIG_NUWAX_P3_HARDREF_AEC_AB_ENABLE is not set
# CONFIG_NUWAX_P3_SOFTREF_AB_SKIP_TOUCH_RUNTIME is not set
# CONFIG_NUWAX_P3_SOFTWARE_REF_AEC_AB_ENABLE is not set
# CONFIG_NUWAX_P3_AFE_MR_PROTOTYPE_ENABLE is not set
# CONFIG_NUWAX_P3_REF_TDM_REFERENCE_STYLE is not set
# CONFIG_NUWAX_P3_VENDOR_V2_AUDIO_PROFILE is not set
# CONFIG_NUWAX_P3_VENDOR_V2_CLOCK_ALIGNED_TX is not set

CONFIG_NUWAX_BATTERY_SERVICE_ENABLE=y
CONFIG_NUWAX_OTA_ENABLE=y
CONFIG_NUWAX_OTA_MIN_BATTERY_PERCENT=5
CONFIG_NUWAX_OTA_TOTAL_TIMEOUT_MS=2100000
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Product firmware reserves 2688 KiB for the pinned ESP-SR model and boots
# from two 4224 KiB application OTA slots. This N16R8 layout must be installed
# by a full flash before app-only OTA is used; the generic partitions.csv
# places a factory app at 0x20000, which is the model partition here.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.customwake.csv"

# Product wake-word path: MultiNet7 runs the custom Mandarin command and the
# matching model is packed into the model partition image during every build.
CONFIG_NUWAX_WAKE_WORD_ENABLE=y
# CONFIG_NUWAX_WAKE_WORD_BACKEND_WAKENET is not set
CONFIG_NUWAX_WAKE_WORD_BACKEND_MULTINET=y
CONFIG_NUWAX_CUSTOM_WAKE_WORD_COMMAND="xiao zhu xiao zhu"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_DISPLAY="小珠小珠"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_LANGUAGE="cn"
CONFIG_NUWAX_CUSTOM_WAKE_WORD_DURATION_MS=3000
CONFIG_NUWAX_CUSTOM_WAKE_WORD_THRESHOLD_PERCENT=10
CONFIG_NUWAX_CONVERSATION_AWAKE_IDLE_TIMEOUT_MS=60000
CONFIG_NUWAX_VOICE_FRAME_DURATION_MS=20
CONFIG_NUWAX_PROVISION_RUNTIME_REBOOT_ENABLE=y
CONFIG_NUWAX_ADAPTIVE_ENDPOINT_MODE_ACTIVE=y
CONFIG_NUWAX_SPEECH_CONFIRMATION_MODE_LEGACY=y
CONFIG_NUWAX_SHORT_SPEECH_POLICY_MODE_ACTIVE=y
CONFIG_MODEL_IN_FLASH=y
# CONFIG_SR_MN_CN_NONE is not set
CONFIG_SR_MN_CN_MULTINET7_QUANT=y

# TLS needs a 16 KiB receive record plus certificate, ECDHE and PRF working
# memory. The product audio/display stack leaves too little contiguous internal
# RAM for a public HTTPS handshake, while several MiB of PSRAM remain available.
# Keep the OTA controller stack internal, but place mbedTLS objects in PSRAM.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC is not set
# CONFIG_MBEDTLS_COMPILER_OPTIMIZATION_SIZE is not set
CONFIG_MBEDTLS_COMPILER_OPTIMIZATION_PERF=y

# Cloudflare and modern CDNs negotiate ChaCha20-Poly1305 when it is available.
# Its software path avoids the internal-DMA allocation that made hardware AES
# unreliable on this memory-constrained product build.
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y

# PSA hardware SHA contexts bypass that allocator and require internal DMA
# memory. OTA TLS setup failed with PSA_ERROR_INSUFFICIENT_MEMORY despite
# plentiful PSRAM, so keep transcript and image hashing on the software path.
# MPI remains accelerated because it is used during the handshake and has
# completed reliably. Hardware AES is disabled because its per-record DMA
# descriptor allocation failed once TLS buffers consumed the internal heap.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
CONFIG_MBEDTLS_HARDWARE_MPI=y
# CONFIG_MBEDTLS_HARDWARE_AES is not set

# Cloudflare currently serves a chain ending in a cross-signed GTS Root R4.
# Keep full certificate and hostname validation while allowing IDF to build
# the alternate chain to the self-signed GTS Root R4 in its trusted bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Keep ESP-IDF's default X25519/P-256 ECDHE support. The generic
# MBEDTLS_ERR_SSL_HW_ACCEL_FAILED result also represents PSA allocation errors,
# so curve selection must not be used as a substitute for fixing memory.

# Normal conversation audio path. Keep the software reference for playback
# diagnostics, but leave live AEC disabled until its internal/DMA reservation
# can be proven stable under Wi-Fi, WebSocket and long TTS load.
CONFIG_NUWAX_SPEAKER_ENABLE=y
# Keep the development-only URL music test out of OTA/product firmware.
# CONFIG_NUWAX_MUSIC_URL_TEST_ENABLE is not set
CONFIG_NUWAX_P3_SOFTWARE_REF_ENABLE=y
CONFIG_NUWAX_LIVE_AEC_ENABLE=n
CONFIG_NUWAX_LIVE_AEC_FILTER_LENGTH=4
# CONFIG_NUWAX_LIVE_AEC_MODE_HIGH_PERF is not set
CONFIG_NUWAX_LIVE_AEC_MODE_LOW_COST=y
# Keep correlation scans and the float NLMS rescue model out of the 20 ms
# product capture path. The calibrated software-reference delay and bounded
# scalar rescue remain enabled.
# CONFIG_NUWAX_LIVE_AEC_SHADOW_DELAY_ENABLE is not set
# CONFIG_NUWAX_LIVE_AEC_DYNAMIC_FIR_DELAY_ENABLE is not set
# CONFIG_NUWAX_LIVE_AEC_ADAPTIVE_REF_ENABLE is not set
CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_ENABLE=y
# CONFIG_NUWAX_LIVE_AEC_HUMAN_RESCUE_FIR_ENABLE is not set
CONFIG_NUWAX_VOICE_UPLINK_QUEUE_DEPTH=64
CONFIG_NUWAX_VOICE_UPLINK_REALTIME_MAX_AGE_MS=1000
CONFIG_NUWAX_RT_CAPTURE_QUEUE_DEPTH=12
CONFIG_NUWAX_RT_CAPTURE_MAX_DECISION_AGE_MS=60
CONFIG_NUWAX_BARGE_END_TO_END_MAX_FRAME_AGE_MS=100
CONFIG_NUWAX_SPEAKER_BUFFER_BYTES=393216
CONFIG_NUWAX_SPEAKER_BACKPRESSURE_POLL_MS=20
CONFIG_NUWAX_SPEAKER_STREAM_STALL_WARN_MS=12000
CONFIG_NUWAX_SPEAKER_STREAM_STALL_TIMEOUT_MS=60000
CONFIG_NUWAX_SPEAKER_REBUFFER_STALL_TIMEOUT_MS=15000

# BLE is used only as a one-connection provisioning peripheral. Keep the
# connectable advertiser, GATT server and Secure Connections, and remove roles,
# test features and sample services that the provisioning protocol never uses.
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
# CONFIG_BT_NIMBLE_ROLE_CENTRAL is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# CONFIG_BT_NIMBLE_ROLE_OBSERVER is not set
# CONFIG_BT_NIMBLE_GATT_CLIENT is not set
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_CCCDS=4
CONFIG_BT_NIMBLE_ATT_MAX_PREP_ENTRIES=8
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=1
# CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT is not set
# CONFIG_BT_NIMBLE_DTM_MODE_TEST is not set
# CONFIG_BT_NIMBLE_PROX_SERVICE is not set
# CONFIG_BT_NIMBLE_ANS_SERVICE is not set
# CONFIG_BT_NIMBLE_CTS_SERVICE is not set
# CONFIG_BT_NIMBLE_HTP_SERVICE is not set
# CONFIG_BT_NIMBLE_IPSS_SERVICE is not set
# CONFIG_BT_NIMBLE_TPS_SERVICE is not set
# CONFIG_BT_NIMBLE_IAS_SERVICE is not set
# CONFIG_BT_NIMBLE_LLS_SERVICE is not set
# CONFIG_BT_NIMBLE_SPS_SERVICE is not set
# CONFIG_BT_NIMBLE_HR_SERVICE is not set
# CONFIG_BT_NIMBLE_BAS_SERVICE is not set
# CONFIG_BT_NIMBLE_DIS_SERVICE is not set
CONFIG_BT_CTRL_BLE_MAX_ACT=2
# CONFIG_BT_CTRL_BLE_SCAN is not set
# CONFIG_BT_CTRL_DTM_ENABLE is not set

# Keep the provisioning memory floor identical in OTA/product builds. The
# six-entry pools match the six-frame BA window and leave enough internal DMA
# memory for BLE provisioning after display/AEC allocation.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16

# The default 5760-byte TCP receive window magnifies long CDN round trips.
# Double it conservatively; the matching ten-entry mailbox follows ESP-IDF's
# receive-window/MSS + 2 recommendation without a risky 32 KiB allocation.
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10

CONFIG_NUWAX_OTA_IO_BUFFER_BYTES=4096

# Product UI does not use LVGL sample applications.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_CJSON_NESTING_LIMIT=32
